}

"""
Mutation operations for managing metadata items, their content, relationships, permissions, templates, and workflow states
"""
type MetadataMutation {
  """
  Create a new metadata item, optionally placing it in a collection with attributes and marking it as ready
  """
  add(collectionItemAttributes: JSON, metadata: MetadataInput!, setReady: Boolean): Metadata!
  """Assign a category to a metadata item"""
  addCategory(categoryId: UUID!, metadataId: UUID!): Boolean!
  """
  Create a new data metadata item from a template, optionally within a parent collection
  """
  addData(parentCollectionId: UUID, setReady: Boolean, templateId: UUID!, templateVersion: Int!): Metadata
  """
  Create a new document metadata item from a template within a parent collection
  """
  addDocument(parentCollectionId: UUID!, setReady: Boolean, templateId: UUID!, templateVersion: Int!): Metadata
  """
  Create a new guide metadata item from a template, optionally within a parent collection
  """
  addGuide(parentCollectionId: UUID, setReady: Boolean, templateId: UUID!, templateVersion: Int!): Metadata
  """Add a step to a guide from a template step definition"""
  addGuideStep(metadataId: UUID!, metadataVersion: Int!, sort: Int!, templateStepId: Long!): GuideStep!
  """Add a module to a guide step from a template module definition"""
  addGuideStepModule(metadataId: UUID!, metadataVersion: Int!, sort: Int!, stepId: Long!, templateModuleId: Long!): GuideStepModule!
  """Create a language variant of an existing metadata item"""
  addLanguageVariant(id: UUID!, languageTag: String!, setReady: Boolean, version: Int!): Metadata!
  """Add an access permission to a metadata item"""
  addPermission(permission: PermissionInput!): Permission!
  """Create a relationship between two metadata items"""
  addRelationship(relationship: MetadataRelationshipInput!): MetadataRelationship!
  """
  Add supplementary content to a metadata item (files, assets, processed outputs)
  """
  addSupplementary(supplementary: MetadataSupplementaryInput!): MetadataSupplementary!
  """
  Assign a trait to a metadata item, enabling its associated behaviors and workflows
  """
  addTrait(metadataId: UUID!, traitId: String!): Boolean!
  """Access AI-powered mutation operations for metadata items"""
  ai: MetadataAIMutation!
  """
  Clear the data collaboration state (e.g. Yjs CRDT data) for a metadata item at a specific version
  """
  clearDataCollaboration(metadataId: UUID!, metadataVersion: Int!): Boolean!
  """
  Clear the document collaboration state (e.g. Yjs CRDT data) for a metadata item at a specific version
  """
  clearDocumentCollaboration(metadataId: UUID!, metadataVersion: Int!): Boolean!
  """
  Access collection template mutation operations for a specific metadata item and version
  """
  collectionTemplate(metadataId: UUID!, metadataVersion: Int!): CollectionTemplateMutation!
  """Access comment operations for metadata items."""
  comments: CommentsMutation!
  """
  Access data template mutation operations for a specific metadata item and version
  """
  dataTemplate(metadataId: UUID!, metadataVersion: Int!): DataTemplateMutation!
  """
  Soft-delete a metadata item (can be restored or permanently deleted later)
  """
  delete(metadataId: UUID!): Boolean!
  """Soft-delete multiple metadata items in a single operation"""
  deleteAll(metadataIds: [UUID!]!): Int!
  """Remove a category assignment from a metadata item"""
  deleteCategory(categoryId: UUID!, metadataId: UUID!): Boolean!
  """Delete the binary/file content associated with a metadata item"""
  deleteContent(metadataId: UUID!): Boolean!
  """Delete the guide content from a metadata item"""
  deleteGuide(metadataId: UUID!, metadataVersion: Int!): Boolean!
  """Delete a step from a guide"""
  deleteGuideStep(metadataId: UUID!, metadataVersion: Int!, stepId: Long!): Boolean!
  """Delete a module from a guide step"""
  deleteGuideStepModule(metadataId: UUID!, metadataVersion: Int!, moduleId: Long!, stepId: Long!): Boolean!
  """
  Delete processed media for a metadata item, removing it from the external provider
  """
  deleteMedia(id: UUID!): Boolean!
  """
  Delete processed media for multiple metadata items in a single operation. Items that do not exist or lack permission are silently skipped. Returns the number of items successfully deleted.
  """
  deleteMediaAll(metadataIds: [UUID!]!): Int!
  """Remove an access permission from a metadata item"""
  deletePermission(permission: PermissionInput!): Permission!
  """Delete a relationship between two metadata items"""
  deleteRelationship(id1: UUID!, id2: UUID!, relationship: String!): Boolean!
  """Delete a supplementary content item"""
  deleteSupplementary(id: UUID!): Boolean!
  """Remove a trait assignment from a metadata item"""
  deleteTrait(metadataId: UUID!, traitId: String!): Boolean!
  """
  Detach a supplementary item from its metadata without deleting the content
  """
  detachSupplementary(id: UUID!): Boolean!
  """
  Access document template mutation operations for a specific metadata item and version
  """
  documentTemplate(metadataId: UUID!, metadataVersion: Int!): DocumentTemplateMutation!
  """Update an existing metadata item with new values"""
  edit(id: UUID!, metadata: MetadataInput!): Metadata!
  """Update an existing relationship between metadata items"""
  editRelationship(relationship: MetadataRelationshipInput!): Boolean!
  """
  Access guide mutation operations for a specific metadata item and version
  """
  guide(metadataId: UUID!, metadataVersion: Int!): GuideMutation!
  """
  Access guide template mutation operations for a specific metadata item and version
  """
  guideTemplate(metadataId: UUID!, metadataVersion: Int!): GuideTemplateMutation!
  """
  Create a metadata item and import its content by downloading from an external URL. The download runs asynchronously as a background job with progress events on the import progress channel.
  """
  importUrl(collectionItemAttributes: JSON, headers: JSON, metadata: MetadataInput!, ready: Boolean, url: String!): Metadata!
  """
  Merge attributes into a metadata item's existing attributes (existing keys are preserved unless overwritten)
  """
  mergeMetadataAttributes(attributes: JSON!, id: UUID!): Boolean!
  """
  Merge attributes into a metadata relationship (existing keys are preserved unless overwritten)
  """
  mergeMetadataRelationshipAttributes(attributes: JSON!, metadata1Id: UUID!, metadata2Id: UUID!, relationship: String!): Boolean!
  """Permanently delete a metadata item (cannot be undone)"""
  permanentlyDelete(metadataId: UUID!): Boolean!
  """
  Trigger video processing (e.g. Mux upload) for a metadata item with video content. Optional processing options override global defaults.
  """
  processMedia(id: UUID!, options: MediaProcessingOptionsInput): Boolean!
  """
  Trigger video processing for multiple metadata items in a single operation. Items that do not exist or lack permission are silently skipped. Returns the number of items successfully submitted for processing.
  """
  processMediaAll(metadataIds: [UUID!]!): Int!
  """
  Reprocess Bible content for a metadata item, regenerating derived data. If no ID is provided, reprocesses all Bible content.
  """
  reprocessBible(metadataId: UUID, metadataVersion: Int): Boolean!
  """Replace all category assignments on a metadata item"""
  setCategories(categoryIds: [UUID!]!, metadataId: UUID!): Boolean!
  """Set the start date for a calendar-based guide"""
  setGuideStartDate(date: DateTime!, metadataId: UUID!, metadataVersion: Int!): Metadata
  """Lock or unlock a metadata item from modifications"""
  setLocked(id: UUID!, locked: Boolean!, version: Int!): Metadata!
  """
  Update the thumbnail time offset for a processed media asset. The thumbnail URL is rebuilt using the new offset without re-processing.
  """
  setMediaThumbnailOffset(id: UUID!, offsetSeconds: Float!): Boolean!
  """Replace all custom attributes on a metadata item"""
  setMetadataAttributes(attributes: JSON!, id: UUID!): Boolean!
  """Set or update the Bible content associated with a metadata item"""
  setMetadataBible(bible: BibleInput!, id: UUID!, version: Int!): Boolean!
  """Select the enabled default Bible variant for a metadata item version."""
  setMetadataBibleDefaultVariant(id: UUID!, variant: String!, version: Int!): Boolean!
  """
  Enable or disable a Bible variant. The default variant cannot be disabled.
  """
  setMetadataBibleVariantEnabled(enabled: Boolean!, id: UUID!, variant: String!, version: Int!): Boolean!
  """
  Enable or disable end-user threaded replies on a metadata item (requires comments to be enabled).
  """
  setMetadataCommentRepliesEnabled(enabled: Boolean!, id: UUID!): Boolean!
  """
  Enable or disable end-user comments on a metadata item. Disabling comments also disables replies.
  """
  setMetadataCommentsEnabled(enabled: Boolean!, id: UUID!): Boolean!
  """Upload file content for a metadata item using a multipart file upload"""
  setMetadataContents(contentType: String, file: Upload!, id: UUID!): Boolean!
  """Set or update the structured document content of a metadata item"""
  setMetadataDocument(collaborationSync: CollaborationSyncMode, document: DocumentInput!, id: UUID!, version: Int!): Boolean!
  """Set content for a metadata item using a JSON payload"""
  setMetadataJsonContents(content: JSON!, contentType: String, id: UUID!): Boolean!
  """
  Set the document content of a metadata item from a markdown string. The markdown is parsed into a TipTap document server-side.
  """
  setMetadataMarkdown(collaborationSync: CollaborationSyncMode, id: UUID!, markdown: String!, title: String!, version: Int!): Boolean!
  """Update the display name of a metadata item"""
  setMetadataName(id: UUID!, name: String!): Metadata!
  """Mark a metadata item as not ready (reverses setMetadataReady)"""
  setMetadataNotReady(id: UUID!): Boolean!
  """Replace all parent collection associations for a metadata item"""
  setMetadataParentCollections(collections: [MetadataParentCollectionInput!]!, id: UUID!): Boolean!
  """Mark a metadata item as ready for publishing and workflow processing"""
  setMetadataReady(id: UUID!): Boolean!
  """
  Mark multiple metadata items as ready in a single operation, skipping items the caller lacks permission to edit
  """
  setMetadataReadyAll(metadataIds: [UUID!]!): Int!
  """Enable or disable recommendation eligibility for a metadata item"""
  setMetadataRecommendable(id: UUID!, recommendable: Boolean!): Boolean!
  """Replace all relationships for a metadata item with the provided set"""
  setMetadataRelationships(id: UUID!, relationships: [MetadataRelationshipInput!]!): Boolean
  """Enable or disable search indexing for a metadata item"""
  setMetadataSearchable(id: UUID!, searchable: Boolean!): Boolean!
  """
  Set or update the URL-friendly slug for a metadata item. Returns the final slug value.
  """
  setMetadataSlug(id: UUID!, slug: String!): String!
  """
  Enable or disable automatic synchronization of variant collections when the parent changes
  """
  setMetadataSyncVariantCollections(id: UUID!, syncVariants: Boolean!): Boolean!
  """
  Enable or disable automatic synchronization of variant relationships when the parent changes
  """
  setMetadataSyncVariantRelationships(id: UUID!, syncVariants: Boolean!): Boolean!
  """Replace all system-managed attributes on a metadata item"""
  setMetadataSystemAttributes(attributes: JSON!, id: UUID!): Boolean!
  """Set content for a metadata item using a plain text payload"""
  setMetadataTextContents(content: String!, contentType: String, id: UUID!): Boolean!
  """
  Mark a metadata item's content as uploaded with its content type and size. Optionally mark it as ready.
  """
  setMetadataUploaded(contentType: String, id: UUID!, len: Int!, ready: Boolean): Boolean!
  """
  Set or clear the parent metadata item ID (used for variant relationships)
  """
  setParentId(id: UUID!, parentId: UUID): Metadata!
  """Set whether a metadata item is publicly accessible"""
  setPublic(id: UUID!, public: Boolean!): Metadata!
  """
  Set public, public content, and public supplementary flags for multiple metadata items in a single operation, skipping items the caller lacks permission to edit
  """
  setPublicAll(metadataIds: [UUID!]!, public: Boolean!, publicContent: Boolean!, publicSupplementary: Boolean!, recommendable: Boolean, searchable: Boolean!): Int!
  """Set whether the binary/file content is publicly accessible"""
  setPublicContent(id: UUID!, public: Boolean!): Metadata!
  """Set whether supplementary files are publicly accessible"""
  setPublicSupplementary(id: UUID!, public: Boolean!): Metadata!
  """
  Set recommendation eligibility for multiple metadata items, skipping items the caller lacks permission to edit
  """
  setRecommendableAll(metadataIds: [UUID!]!, recommendable: Boolean!): Int!
  """
  Upload file content for a supplementary item using a multipart file upload
  """
  setSupplementaryContents(contentType: String!, file: Upload!, supplementaryId: UUID!): Boolean!
  """Set text content for a supplementary item"""
  setSupplementaryTextContents(content: String!, contentType: String!, supplementaryId: UUID!): Boolean!
  """
  Mark a supplementary item's content as uploaded with its content type and size
  """
  setSupplementaryUploaded(contentType: String!, len: Int!, supplementaryId: UUID!): Boolean!
  """
  Assign a template to a metadata item, defining its structure and behavior
  """
  setTemplate(id: UUID!, templateId: UUID!, templateVersion: Int!, version: Int!): Metadata!
  """Transition a metadata item to a new workflow state"""
  setWorkflowState(state: MetadataWorkflowState!): Boolean!
  """Mark a workflow state transition as complete with a status message"""
  setWorkflowStateComplete(state: MetadataWorkflowCompleteState!): Boolean!
  """
  Update video quality and/or resolution tier settings stored for a processed media asset. The new settings take effect on the next re-upload to the provider.
  """
  updateMediaSettings(id: UUID!, options: MediaProcessingOptionsInput!): Boolean!
}

"""
Input for associating a metadata item with a parent collection, including relationship attributes
"""
input MetadataParentCollectionInput {
  """Attributes to set on the parent-child relationship"""
  attributes: JSON!
  """ID of the parent collection"""
  id: UUID!
}

"""
An association between a metadata item and a user profile, defining the role or relationship
"""
type MetadataProfile {
  """The associated user profile"""
  profile: Profile
  """
  The type of relationship between the profile and metadata item (e.g. 'author', 'editor', 'reviewer')
  """
  relationship: String!
}

"""Input for associating a user profile with a metadata item"""
input MetadataProfileInput {
  """ID of the user profile to associate"""
  profileId: UUID!
  """The type of relationship (e.g. 'author', 'editor', 'reviewer')"""
  relationship: String!
}

"""
A directional relationship between two metadata items, with an optional set of custom attributes
"""
type MetadataRelationship {
  """Custom attributes on this relationship"""
  attributes: JSON
  """Unique identifier of the related metadata item"""
  id: UUID!
  """The related metadata item"""
  metadata: Metadata!
  """
  The type of relationship (e.g. 'thumbnail', 'related', 'translation', 'audio')
  """
  relationship: String!
}

"""
Input for creating or updating a relationship between two metadata items
"""
input MetadataRelationshipInput {
  """Custom attributes to set on the relationship"""
  attributes: JSON
  """ID of the first metadata item in the relationship"""
  id1: UUID!
  """ID of the second metadata item in the relationship"""
  id2: UUID!
  """
  The type of relationship (e.g. 'thumbnail', 'related', 'translation', 'audio')
  """
  relationship: String
}

"""
External source information for a metadata item that was imported from another system
"""
type MetadataSource {
  """ID of the source system in Bosca"""
  id: UUID
  """Identifier of the item within the external source system"""
  identifier: String
  """The source system definition"""
  source: Source
  """Current status of the source content lifecycle"""
  status: SourceStatus
  """URL of the item in the external source system"""
  url: String
}

"""
Input for specifying the external source of a metadata item during creation or update
"""
input MetadataSourceInput {
  """ID of the source system in Bosca"""
  id: String
  """Identifier of the item within the external source system"""
  identifier: String
  """URL of the item in the external source system"""
  sourceUrl: String
}

"""
A supplementary content item attached to a metadata item, such as a thumbnail, transcript, processed output, or any additional file
"""
type MetadataSupplementary {
  """Custom attributes associated with this supplementary item"""
  attributes: JSON
  """Content details including type, size, and access URLs"""
  content: MetadataSupplementaryContent!
  """Timestamp when this supplementary item was created"""
  created: DateTime!
  """Unique identifier for this supplementary item"""
  id: UUID!
  """
  Unique key within the metadata item (e.g. 'thumbnail', 'transcript', 'mp3')
  """
  key: String!
  """ID of the parent metadata item this supplementary belongs to"""
  metadataId: UUID!
  """Timestamp when this supplementary item was last modified"""
  modified: DateTime!
  """Display name of the supplementary item"""
  name: String!
  """Storage plan ID for content storage"""
  planId: UUID
  """External source information if this supplementary was imported"""
  source: MetadataSupplementarySource
  """Timestamp when content was uploaded, null if not yet uploaded"""
  uploaded: DateTime
}

"""
Content details for a metadata supplementary item, including its type, size, and access URLs
"""
type MetadataSupplementaryContent {
  """The content parsed as JSON (if the content type supports JSON parsing)"""
  json: JSON!
  """Content length in bytes"""
  length: Int
  """
  The content as plain text (if the content type supports text extraction)
  """
  text: String!
  """MIME content type (e.g. 'image/png', 'audio/mpeg', 'text/plain')"""
  type: String!
  """
  Pre-signed URLs for uploading and downloading the supplementary content
  """
  urls: MetadataSupplementaryContentUrls!
}

"""Pre-signed URLs for accessing metadata supplementary content"""
type MetadataSupplementaryContentUrls {
  """Pre-signed URL for downloading the supplementary content"""
  download: SignedUrl!
  """Pre-signed URL for uploading new supplementary content"""
  upload: SignedUrl!
}

"""Input for adding supplementary content to a metadata item"""
input MetadataSupplementaryInput {
  """Custom attributes to set on the supplementary item"""
  attributes: JSON
  """
  Size of the content in bytes (used for pre-signed upload URL generation)
  """
  contentLength: Int
  """MIME content type of the supplementary content"""
  contentType: String!
  """
  Unique key within the metadata item (e.g. 'thumbnail', 'transcript', 'mp3')
  """
  key: String!
  """ID of the parent metadata item this supplementary belongs to"""
  metadataId: UUID!
  """Display name of the supplementary item"""
  name: String!
  """Storage plan ID for content storage"""
  planId: UUID!
  """Optional source system ID if imported from an external source"""
  sourceId: String
  """Optional identifier from the external source system"""
  sourceIdentifier: String
}

"""Source information for an imported supplementary content item"""
type MetadataSupplementarySource {
  """ID of the source system in Bosca"""
  id: UUID!
  """Identifier of the item within the external source system"""
  identifier: String
}

"""
The classification of a metadata item, indicating whether it is a primary item or a language/content variant
"""
enum MetadataType {
  """
  A standard metadata item that serves as the primary version of the content
  """
  STANDARD
  """
  A variant of another metadata item, typically a language-specific translation or alternate version
  """
  VARIANT
}

"""
Current workflow state information for a metadata item, including pending operations and processing status
"""
type MetadataWorkflow {
  """
  Currently active (incomplete) jobs for this metadata item, including pending, running, and scheduled jobs
  """
  activeJobs: [ContentJobHistory!]!
  """ID of the workflow to run when this metadata item is deleted"""
  deleteWorkflow: String
  """
  Description of what is currently pending, if anything (e.g. a workflow step awaiting completion)
  """
  pending: String
  """Number of currently running workflow steps"""
  running: Int!
  """Current workflow state ID (e.g. 'draft', 'processing', 'published')"""
  state: String!
  """Timestamp when the current state became valid"""
  stateValid: DateTime
}

"""Input for marking a metadata workflow state transition as complete"""
input MetadataWorkflowCompleteState {
  """ID of the metadata item whose workflow transition is completing"""
  metadataId: UUID!
  """Completion status message (e.g. 'success', 'failed')"""
  status: String!
}

"""Input for setting the initial workflow state of a metadata item"""
input MetadataWorkflowInput {
  """ID of the workflow to run when this metadata item is deleted"""
  deleteWorkflowId: String
  """Initial workflow state ID (e.g. 'draft', 'pending')"""
  state: String!
}

"""Input for transitioning a metadata item to a new workflow state"""
input MetadataWorkflowState {
  """
  If true, transition immediately without waiting for the current workflow to complete
  """
  immediate: Boolean!
  """ID of the metadata item to transition"""
  metadataId: UUID!
  """Target workflow state ID to transition to"""
  stateId: String!
  """Status message for the transition (e.g. 'approved', 'rejected')"""
  status: String!
}

"""
An AI/ML model configuration registered in the system for use with prompts and AI workflows
"""
type Model {
  """Model-specific configuration (API endpoints, parameters, etc.)"""
  configuration: JSON!
  """Description of the model and its capabilities"""
  description: String!
  """Unique identifier for this model"""
  id: UUID!
  """Unique key for referencing this model (e.g. 'gpt-4', 'claude-3')"""
  key: String!
  """Display name of the model"""
  name: String!
  """The type/provider of the model (e.g. 'openai', 'anthropic', 'ollama')"""
  type: String!
}

"""Input for creating or updating a model configuration"""
input ModelInput {
  """Model-specific configuration"""
  configuration: JSON!
  """Description of the model and its capabilities"""
  description: String!
  """Unique key for referencing this model"""
  key: String!
  """Display name of the model"""
  name: String!
  """The type/provider of the model"""
  type: String!
}

"""Query operations for browsing registered AI models"""
type Models {
  """List all registered models"""
  all: [Model!]!
  """Get a specific model by ID"""
  model(id: UUID!): Model
}

"""Mutation operations for managing AI model configurations"""
type ModelsMutation {
  """Register a new model"""
  add(model: ModelInput!): Model
  """Delete a model by ID"""
  delete(id: UUID!): Boolean!
  """Update an existing model configuration"""
  edit(id: UUID!, model: ModelInput!): Model
}

"""
A monetary amount with fixed scale-4 decimal precision, serialized as a decimal string
(e.g. "19.9900"). Mirrors the module's Kotlin Money value type.
"""
scalar Money

input MoveWorkOpsTaskInput {
  fieldMapping: JSON
  """
  Map<sourceStatusId, targetStatusId>. Encoded as JSON because
  GraphQL doesn't natively support map shapes.
  """
  statusMapping: JSON!
  targetProjectId: UUID!
}

"""
The root mutation type for the Bosca API. All write operations are accessed through the namespaced fields below.
"""
type Mutation {
  """Access mutation operations for AGENT_PROJECT repository management."""
  agentRepo: AgentRepoMutation!
  """Access mutation operations for managing agent tools"""
  agentTools: AgentToolsMutation!
  """Access mutation operations for managing AI agents"""
  agents: AgentsMutation!
  """Access AI-domain mutations (including AGENT_PROJECT Git backfill)."""
  ai: AiMutation!
  """Access analytics mutation operations"""
  analytics: AnalyticsMutation!
  """
  Access artifact registry mutation operations for managing namespaces, versions, and tags.
  """
  artifactsAdmin: ArtifactsAdminMutation!
  """
  Access backup mutation operations for creating backups and restoring from them.
  """
  backups: BackupsMutation!
  """Access calendar mutation operations."""
  calendars: CalendarsMutation!
  """
  Access campaign mutation operations for creating, scheduling, and sending campaigns.
  """
  campaigns: CampaignsMutation!
  """Access mutation operations for chat channels and messages"""
  chat: ChatMutation!
  """Access mutation operations for managing chat sessions"""
  chatSessions: ChatSessionsMutation!
  """
  Clear all server-side caches (local Caffeine cache, Redis/NATS cache). Returns true if the caches were successfully cleared.
  """
  clearCache: Boolean!
  """
  Clear the CDN edge cache, forcing content to be re-fetched from the origin. Returns true if the CDN cache was successfully invalidated.
  """
  clearCdnCache: Boolean!
  """
  Force-release all distributed locks held by jobs across all queues, allowing stuck jobs to be re-acquired by workers. Returns true if the operation completed successfully.
  """
  clearJobLocks: Boolean!
  """
  Bridge and federation administration mutations grouped under a single namespace.
  """
  collaboration: CollaborationMutation!
  communications: CommunicationsMutations!
  """
  Access mutation operations for community groups, channels, messages, activities, and prayers
  """
  community: CommunityMutation!
  """
  Access configuration mutation operations for managing application settings in the key-value store.
  """
  configurations: ConfigurationsMutation!
  """
  Access content management mutation operations for collections, metadata, workflows, models, and related content entities.
  """
  content: ContentMutation!
  """
  Access device mutation operations for registration, check-in, push token management, and deletion.
  """
  devices: DevicesMutation!
  """The ecommerce domain mutation namespace."""
  ecom: EcomMutation!
  exclusionLayers: ExclusionLayersMutation!
  experiments: ExperimentsMutation!
  """
  Expire all pending jobs in the job queue, marking them for re-processing. Returns true if jobs were successfully expired.
  """
  expireAllJobs: Boolean!
  featureFlags: FeatureFlagsMutation!
  """The feeds domain mutation namespace."""
  feeds: FeedsMutation!
  """
  Access form schema mutation operations for creating, updating, and deleting form definitions
  """
  formSchemasMutation: FormSchemasMutation!
  """
  Access form submission mutations for submitting, updating status, and deleting form submissions.
  """
  forms: FormsMutation!
  gateway: GatewayMutations!
  """Git repository mutations."""
  git: GitMutation!
  """Access job management mutations"""
  jobs: JobsMutation!
  """Entry point for language mutations."""
  languages: LanguagesMutation!
  """Entry point for localization mutations"""
  localization: LocalizationMutation!
  """Access mutation operations for managing MCP server registrations"""
  mcpServers: McpServersMutation!
  """
  Access Meilisearch admin mutation operations for managing indexes, settings, embedders, nodes, replication, and federation.
  """
  meilisearchAdmin: MeilisearchAdminMutation!
  """Access AI model mutations"""
  models: ModelsMutation!
  """
  Access NATS admin mutation operations for modifying KeyValue entries and stream messages.
  """
  natsAdmin: NatsAdminMutation!
  """
  Access organization mutation operations for managing organizations, memberships, domains, and signup configurations.
  """
  organizations: OrganizationsMutation!
  """Access package management mutations"""
  packages: PackagesMutation!
  """
  Access persisted query mutation operations for registering and managing pre-registered GraphQL queries.
  """
  persistedQueries: PersistedQueriesMutation!
  """Access pipeline mutations."""
  pipelines: PipelinesMutation!
  """
  Access PostgreSQL admin mutation operations for canceling queries, terminating backends, and running maintenance.
  """
  postgresAdmin: PostgresAdminMutation!
  """
  Access profile mutation operations for managing user profiles, attributes, collections, and relationships.
  """
  profiles: ProfilesMutation!
  """Access prompt template mutations"""
  prompts: PromptsMutation!
  """
  Access recommendation mutations for user preferences and admin management.
  """
  recommendation: RecommendationMutation!
  """
  Access the job scheduler mutation operations for creating, editing, deleting, and triggering scheduled jobs.
  """
  scheduler: SchedulerMutation!
  scripts: ScriptsMutation!
  """
  Access security mutation operations for managing principals, groups, permissions, and authentication.
  """
  security: SecurityMutation!
  """
  Access audience segmentation mutation operations for managing segments and membership.
  """
  segments: SegmentsMutation!
  """Access workflow state mutations"""
  states: WorkflowStatesMutation!
  """
  Access storage system mutation operations for managing search, supplementary, and vector storage configurations.
  """
  storageSystems: StorageSystemsMutation!
  """Access time event mutation operations"""
  timeEvents: TimeEventMutation!
  """Access workflow transition mutations"""
  transitions: TransitionsMutation!
  workOps: WorkOpsMutations!
}

"""
Query operations for introspecting the NATS server's operational state.
"""
type NatsAdmin {
  """Retrieve active route connections between servers in the NATS cluster."""
  clusterRoutes: NatsRoutes!
  """
  Retrieve active client connections with optional pagination and sorting.
  """
  connections(
    """Maximum number of connections to return."""
    limit: Int
    """Zero-based offset for pagination."""
    offset: Int
    """Field to sort connections by (e.g. 'cid', 'bytes_to', 'msgs_to')."""
    sortBy: String
  ): NatsConnections!
  """Retrieve all consumers for a specific JetStream stream."""
  jetStreamConsumers(
    """The name of the stream to query consumers for."""
    streamName: String!
  ): [JetStreamConsumerDetail!]!
  """
  Retrieve JetStream overview statistics including stream and consumer counts.
  """
  jetStreamInfo: JetStreamInfo!
  """Retrieve details for all JetStream streams."""
  jetStreamStreams: [JetStreamStreamDetail!]!
  """
  Browse entries in a KeyValue store bucket with optional key and value filtering.
  """
  keyValueEntries(
    """The name of the KV bucket to browse."""
    bucket: String!
    """Optional glob pattern to filter keys (e.g. 'prefix.*')."""
    keyFilter: String
    """Optional substring to search for within entry values."""
    valueSearch: String
  ): [NatsKeyValueEntry!]!
  """List all KeyValue store buckets, optionally filtered by bucket name."""
  keyValueStores: [NatsKeyValueStore!]!
  """
  Retrieve general server information including version, uptime, and throughput statistics.
  """
  serverInfo: NatsServerInfo!
  """
  Read messages from a JetStream stream with optional filtering by subject, sequence range, and payload content.
  """
  streamMessages(
    """Search for this substring within message payloads."""
    dataSearch: String
    """Read messages starting from this sequence number (inclusive)."""
    fromSeq: Long
    """Maximum number of messages to return (default 50)."""
    limit: Int
    """The name of the stream to read from."""
    streamName: String!
    """
    Filter messages by subject (supports NATS wildcards: * for single token, > for remaining).
    """
    subjectFilter: String
    """Read messages up to this sequence number (inclusive)."""
    toSeq: Long
  ): [NatsStreamMessage!]!
  """Retrieve subscription routing statistics."""
  subscriptionsInfo: NatsSubscriptionsInfo!
}

"""
Mutation operations for modifying NATS KeyValue store entries and JetStream stream messages.
"""
type NatsAdminMutation {
  """Delete a key-value entry from the specified bucket."""
  deleteKeyValueEntry(
    """The name of the KV bucket."""
    bucket: String!
    """The key to delete."""
    key: String!
  ): Boolean!
  """Delete a single message from a JetStream stream by sequence number."""
  deleteStreamMessage(
    """The sequence number of the message to delete."""
    sequence: Long!
    """The name of the stream containing the message."""
    streamName: String!
  ): Boolean!
  """
  Permanently remove all tombstoned (deleted/purged) entries from a KeyValue store bucket, reclaiming storage.
  """
  purgeKeyValueDeletes(
    """The name of the KV bucket to compact."""
    bucket: String!
  ): Boolean!
  """
  Purge all messages from a JetStream stream, preserving configuration and consumers.
  """
  purgeStream(
    """The name of the stream to purge."""
    streamName: String!
  ): Boolean!
  """
  Remove all KeyValue tombstone messages (DEL/PURGE markers) from a stream, reclaiming storage while preserving live entries. Returns the number of tombstones removed.
  """
  purgeStreamDeletes(
    """The name of the stream to purge tombstones from."""
    streamName: String!
  ): Int!
  """
  Create or update a key-value entry in the specified bucket. Returns the entry with its new revision.
  """
  putKeyValueEntry(
    """The name of the KV bucket."""
    bucket: String!
    """The key to create or update."""
    key: String!
    """The string value to store."""
    value: String!
  ): NatsKeyValueEntry!
}

"""Details about an active client connection to the NATS server."""
type NatsConnection {
  """The server-assigned connection identifier."""
  cid: Long!
  """Human-readable duration since the last message was exchanged."""
  idle: String!
  """Total bytes received from this client."""
  inBytes: Long!
  """Total messages received from this client."""
  inMsgs: Long!
  """The IP address of the connected client."""
  ip: String!
  """The kind of connection (e.g. Client, Leafnode, Route)."""
  kind: String
  """The programming language of the client library."""
  lang: String
  """When the last message was exchanged on this connection."""
  lastActivity: String
  """The optional name provided by the client when connecting."""
  name: String
  """Total bytes sent to this client."""
  outBytes: Long!
  """Total messages sent to this client."""
  outMsgs: Long!
  """Bytes waiting to be sent to the client."""
  pendingBytes: Long!
  """The TCP port of the connected client."""
  port: Int!
  """The round-trip time to the client."""
  rtt: String
  """When the connection was established."""
  start: String
  """The number of active subscriptions on this connection."""
  subscriptions: Int!
  """The connection type (e.g. nats, mqtt, websocket)."""
  type: String
  """Human-readable duration since the connection was established."""
  uptime: String!
  """The version of the client library."""
  version: String
}

"""A paginated list of active connections to the NATS server."""
type NatsConnections {
  """The connections in this page of results."""
  connections: [NatsConnection!]!
  """The maximum number of connections per page."""
  limit: Int!
  """The number of connections in this response."""
  numConnections: Int!
  """The current pagination offset."""
  offset: Int!
  """The total number of active connections."""
  total: Int!
}

"""A key-value pair from a NATS message header."""
type NatsHeader {
  """The header key."""
  key: String!
  """The header values."""
  values: [String!]!
}

"""A single entry in a NATS KeyValue store."""
type NatsKeyValueEntry {
  """When this entry was created or last updated."""
  created: String!
  """The key of this entry."""
  key: String!
  """The operation type (PUT, DELETE, PURGE)."""
  operation: String!
  """The revision number of this entry."""
  revision: Long!
  """The string value of this entry, null if deleted."""
  value: String
}

"""Metadata about a NATS KeyValue store bucket."""
type NatsKeyValueStore {
  """The name of the KV bucket."""
  bucket: String!
  """The total bytes stored in this bucket."""
  bytes: Long!
  """The number of entries in this bucket."""
  entryCount: Long!
  """The maximum number of history entries per key."""
  history: Long!
  """The maximum bytes allowed in this bucket."""
  maxBytes: Long!
  """The maximum value size allowed in this bucket."""
  maxValueSize: Long!
  """The TTL for entries in milliseconds, 0 if no TTL."""
  ttl: Long!
}

"""
A single route connection between two servers in a NATS cluster, representing the inter-server communication link.
"""
type NatsRoute {
  """Whether this server initiated the route connection."""
  didSolicit: Boolean!
  """Total bytes received from the remote server."""
  inBytes: Long!
  """Total messages received from the remote server."""
  inMsgs: Long!
  """The IP address of the remote server."""
  ip: String!
  """
  Whether this route was explicitly configured (as opposed to discovered via gossip).
  """
  isConfigured: Boolean!
  """Total bytes sent to the remote server."""
  outBytes: Long!
  """Total messages sent to the remote server."""
  outMsgs: Long!
  """Bytes waiting to be sent to the remote server."""
  pendingSize: Long!
  """The route port of the remote server."""
  port: Int!
  """The unique identifier of the remote server."""
  remoteId: String!
  """The human-readable name of the remote server."""
  remoteName: String!
  """The server-assigned route identifier."""
  rid: Long!
  """The number of subscriptions routed to the remote server."""
  subscriptions: Int!
}

"""
Active route connections between servers in a NATS cluster, as reported by the `/routez` monitoring endpoint.
"""
type NatsRoutes {
  """The number of active route connections to other cluster members."""
  numRoutes: Int!
  """The route connections to other servers in the cluster."""
  routes: [NatsRoute!]!
}

"""
General information about the NATS server including version, uptime, connection counts, and resource usage.
"""
type NatsServerInfo {
  """The number of currently active client connections."""
  connections: Int!
  """Server process CPU usage as a percentage."""
  cpu: Float!
  """The hostname the server is listening on."""
  host: String!
  """Total bytes received by the server."""
  inBytes: Long!
  """Total number of messages received by the server."""
  inMsgs: Long!
  """
  JetStream configuration and runtime statistics, null if JetStream is disabled.
  """
  jetstream: JetStreamServerConfig
  """Maximum number of client connections allowed."""
  maxConnections: Int!
  """Maximum allowed message payload size in bytes."""
  maxPayload: Int!
  """Server process memory usage in bytes."""
  mem: Long!
  """Total bytes sent by the server."""
  outBytes: Long!
  """Total number of messages sent by the server."""
  outMsgs: Long!
  """The port the server is listening on for client connections."""
  port: Int!
  """The unique identifier of the NATS server instance."""
  serverId: String!
  """The human-readable name of the NATS server."""
  serverName: String!
  """The number of slow consumers detected by the server."""
  slowConsumers: Long!
  """The number of active subscriptions across all connections."""
  subscriptions: Long!
  """The total number of client connections since the server started."""
  totalConnections: Long!
  """Human-readable duration since the server started."""
  uptime: String!
  """The NATS server software version."""
  version: String!
}

"""A message stored in a NATS JetStream stream."""
type NatsStreamMessage {
  """The message payload as a UTF-8 string."""
  data: String
  """The message headers."""
  headers: [NatsHeader!]!
  """The sequence number within the stream."""
  sequence: Long!
  """The NATS subject this message was published to."""
  subject: String!
  """When this message was stored."""
  timestamp: String!
}

"""Subscription routing statistics from the NATS server."""
type NatsSubscriptionsInfo {
  """The average message fanout across all subscriptions."""
  avgFanout: Float!
  """The subscription cache hit rate as a ratio from 0.0 to 1.0."""
  cacheHitRate: Float!
  """The maximum message fanout across all subscriptions."""
  maxFanout: Int!
  """The number of entries in the subscription cache."""
  numCache: Long!
  """The total number of subscription inserts since server start."""
  numInserts: Long!
  """The total number of subscription match lookups since server start."""
  numMatches: Long!
  """The total number of subscription removals since server start."""
  numRemoves: Long!
  """The total number of active subscriptions."""
  numSubscriptions: Long!
}

"""The delivery channel used to send campaigns to segment audiences."""
enum NotificationChannel {
  """An in-app banner displayed to users matching the segment."""
  BANNER
  """An email blast sent to the segment audience."""
  EMAIL
  """A push notification delivered to mobile devices of segment members."""
  PUSH
}

"""
Per-user notification preference for a specific channel and notification
type. Non-optional types always deliver and cannot be opted out.
"""
type NotificationPreference {
  channel: DeliveryChannel!
  optedOut: Boolean!
  profileId: UUID!
  type: String!
  updatedAt: DateTime!
}

"""
A channel-scoped route from a Bosca notification type to a preference owned by
an external provider. Unmapped preference cells remain stored in Bosca.
"""
type NotificationPreferenceMapping {
  channel: DeliveryChannel!
  externalId: String!
  provider: String!
  type: String!
}

"""
Per-profile notification settings: quiet hours for push delivery.
Times are HH:MM in the profile's local time; timeZone is an IANA zone id.
"""
type NotificationSettings {
  dndEndLocal: String
  dndStartLocal: String
  profileId: UUID!
  timeZone: String
  updatedAt: DateTime!
}

"""Tracks the lifecycle of a campaign from draft through delivery."""
enum NotificationStatus {
  """
  The campaign is currently active and being displayed (used for banners).
  """
  ACTIVE
  """The campaign was cancelled before delivery completed."""
  CANCELLED
  """The campaign is being authored and has not been scheduled."""
  DRAFT
  """The campaign delivery failed."""
  FAILED
  """The campaign has been scheduled for future delivery."""
  SCHEDULED
  """The campaign is currently being dispatched to the audience."""
  SENDING
  """The campaign has been fully delivered."""
  SENT
}

"""
An admin-definable notification type — the unit users opt in or out of, per
delivery channel. The key is the immutable contract sending code references.
Non-optional types always deliver and cannot be opted out. System types are
seeded, cannot be deleted, and their optional flag cannot be changed. Hidden
types remain available to administrators and sending code but are omitted from
user preference controls. For optional types, the channel-specific defaults
apply until a user explicitly changes the corresponding preference.
"""
type NotificationType {
  defaultEmailEnabled: Boolean!
  defaultPushEnabled: Boolean!
  description: String
  displayOrder: Int!
  hidden: Boolean!
  key: String!
  name: String!
  optional: Boolean!
  system: Boolean!
  updatedAt: DateTime!
}

"""
Input for editing or creating an override on a single occurrence of a recurring master.
"""
input OccurrenceInput {
  """Whether the occurrence spans full days."""
  allDay: Boolean
  """Optional long-form description."""
  description: String
  """Replacement end."""
  endsAt: DateTime!
  """Optional location text."""
  location: String
  """Replacement start (may differ from the original recurrence id)."""
  startsAt: DateTime!
  """The replacement title."""
  title: String!
}

"""Sort direction for ordering results"""
enum Order {
  """Sort from lowest to highest (A-Z, 0-9, oldest first)"""
  ASCENDING
  """Sort from highest to lowest (Z-A, 9-0, newest first)"""
  DESCENDING
}

"""
Defines how results are sorted, including support for sorting by nested attribute paths
"""
type Ordering {
  """The field name to sort by"""
  field: String
  """
  Whether this ordering applies to item attributes or relationship attributes
  """
  location: AttributeLocation
  """Sort direction (ascending or descending)"""
  order: Order
  """JSON path segments for sorting by nested attribute values"""
  path: [String!]
  """The data type of the field, used for correct comparison"""
  type: AttributeType
}

"""Input for specifying sort order on query results"""
input OrderingInput {
  """The field name to sort by"""
  field: String
  """
  Whether this ordering applies to item attributes or relationship attributes
  """
  location: AttributeLocation
  """Sort direction (ascending or descending)"""
  order: Order
  """JSON path segments for sorting by nested attribute values"""
  path: [String!]
  """The data type of the field, used for correct comparison"""
  type: AttributeType
}

"""
An organization that groups users (principals) together. Organizations support domain-based auto-join, email invitations, token-based invites, and permission management.
"""
type Organization {
  """
  Custom attributes stored as JSON for the organization (e.g. branding, settings).
  """
  attributes: JSON!
  """The timestamp when this organization was created."""
  created: DateTime!
  """
  The email domains associated with this organization for domain-based signup. Null if the current user lacks permission to view domains.
  """
  domains: [OrganizationDomain!]
  """The unique identifier of the organization."""
  id: UUID!
  """
  The list of principals who have manager-level access to this organization.
  """
  managers: [Principal!]!
  """The total number of members in this organization."""
  memberCount: Long!
  """A paginated list of principals who are members of this organization."""
  members(
    """The maximum number of members to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [Principal!]!
  """The timestamp when this organization was last modified."""
  modified: DateTime!
  """The display name of the organization."""
  name: String!
  """
  The permission rules configured for this organization. Null if the current user lacks permission.
  """
  permissions: [OrganizationPermission!]
  """
  The profile associated with this organization, containing extended profile information.
  """
  profile: Profile!
  """
  The email-based signup invitations configured for this organization. Null if the current user lacks permission.
  """
  signupEmails: [OrganizationSignupEmail!]
  """
  The token-based invitations configured for this organization. Null if the current user lacks permission.
  """
  signupTokens: [OrganizationSignupToken!]
  """
  System-managed attributes stored as JSON. Null if the current user does not have permission to view system attributes.
  """
  systemAttributes: JSON
  """
  The visibility level that controls who can discover and view this organization.
  """
  visibility: ProfileVisibility!
}

"""
An email domain associated with an organization, used for domain-based membership rules such as auto-join on signup.
"""
type OrganizationDomain {
  """
  Whether users with matching email domains are automatically added to the organization upon signup.
  """
  autoJoin: Boolean!
  """
  The email domain (e.g. 'example.com') associated with this organization.
  """
  domain: String!
  """
  The security group that users will be added to when they join via this domain.
  """
  group: Group!
  """
  The signup group type that determines the role of users who join via this domain.
  """
  type: OrganizationSignupGroupType
}

"""
Input for configuring an email domain associated with an organization, enabling domain-based auto-join and default group assignment.
"""
input OrganizationDomainInput {
  """
  Whether users with matching email domains are automatically added to the organization upon signup.
  """
  autoJoin: Boolean!
  """
  The UUID of the default group to assign to users who join via this domain. If null, the group is determined by the type field.
  """
  defaultGroupId: UUID
  """
  The email domain (e.g. 'example.com') to associate with the organization.
  """
  domain: String!
  """
  The signup group type that determines the role of users who join via this domain.
  """
  type: OrganizationSignupGroupType
}

"""
Input for creating or updating an organization, including its metadata, visibility, and signup configuration.
"""
input OrganizationInput {
  """
  Custom attributes stored as JSON for the organization (e.g. branding, settings).
  """
  attributes: JSON!
  """
  The list of email domains associated with the organization for domain-based signup rules.
  """
  domains: [OrganizationDomainInput!]!
  """
  The UUID of the organization. Null when creating a new organization; required when editing an existing one.
  """
  id: UUID
  """The display name of the organization."""
  name: String!
  """The list of email-based signup invitations for specific users."""
  signupEmails: [OrganizationSignupEmailInput!]!
  """
  The list of token-based invitation configurations for the organization.
  """
  signupTokens: [OrganizationSignupTokenInput!]!
  """
  A URL-friendly slug identifier for the organization. Used in URLs and as a human-readable identifier.
  """
  slug: String
  """
  System-managed attributes stored as JSON. These are typically managed by the platform rather than end users.
  """
  systemAttributes: JSON!
  """
  The visibility level that controls who can discover and view this organization.
  """
  visibility: ProfileVisibility!
}

"""
A permission rule that grants a specific action to a group within an organization, scoped by the organization signup group type.
"""
type OrganizationPermission {
  """The permission action granted to the group (e.g. read, write, manage)."""
  action: PermissionAction!
  """The security group that is granted this permission."""
  group: Group!
  """
  The signup group type this permission applies to (e.g. ADMINISTRATORS or USERS).
  """
  groupType: OrganizationSignupGroupType!
}

"""
An email-based signup invitation for a specific user to join an organization.
"""
type OrganizationSignupEmail {
  """The email address of the user invited to join the organization."""
  email: String!
  """
  The security group that the invited user will be added to upon joining.
  """
  group: Group!
  """
  The signup group type that determines the role assigned to the invited user.
  """
  type: OrganizationSignupGroupType
}

"""
Input for configuring an email-based signup invitation for a specific user to join an organization.
"""
input OrganizationSignupEmailInput {
  """The email address of the user being invited to join the organization."""
  email: String!
  """
  The signup group type that determines the role assigned to the invited user upon joining.
  """
  type: OrganizationSignupGroupType
}

"""
The role type assigned to members who join an organization through a signup mechanism (domain auto-join, email invitation, or token-based invite).
"""
enum OrganizationSignupGroupType {
  """
  Members are added to the administrators group with full management privileges.
  """
  ADMINISTRATORS
  """The group type has not been specified or is not recognized."""
  UNKNOWN
  """Members are added to the regular users group with standard access."""
  USERS
}

"""
A token-based invitation that can be shared to allow users to join an organization. The token string is used in invitation URLs.
"""
type OrganizationSignupToken {
  """
  The security group that users will be added to when they join using this token.
  """
  group: Group!
  """
  The unique token string used in invitation URLs. Null if the token has not yet been generated.
  """
  token: String
  """
  The signup group type that determines the role assigned to users joining via this token.
  """
  type: OrganizationSignupGroupType
}

"""
Input for creating a token-based invitation link that allows users to join an organization.
"""
input OrganizationSignupTokenInput {
  """
  The signup group type that determines the role assigned to users who join via this token.
  """
  type: OrganizationSignupGroupType
}

"""
Query operations for retrieving organizations. Supports listing all organizations, looking up by ID, and finding organizations by signup token or email.
"""
type Organizations {
  """
  Retrieve a paginated list of all organizations the current user has access to.
  """
  all(
    """The maximum number of organizations to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [Organization!]!
  """
  Find an organization by a signup email address. Returns null if no organization has an invitation for this email.
  """
  findByEmail(
    """The email address to search for in organization signup invitations."""
    email: String!
  ): Organization
  """
  Find an organization by a signup token. Returns null if no organization matches the token.
  """
  findByToken(
    """The signup token string to search for."""
    token: String!
  ): Organization
  """Retrieve a single organization by its unique identifier."""
  organization(
    """The UUID of the organization to retrieve."""
    id: UUID!
  ): Organization!
}

"""
Mutation operations for managing organizations, including CRUD operations, domain management, signup tokens, email invitations, and membership.
"""
type OrganizationsMutation {
  """
  Create a new organization with the specified settings and an associated profile.
  """
  add(
    """
    The organization configuration including name, attributes, visibility, and signup settings.
    """
    organization: OrganizationInput!
    """The profile to create and associate with the new organization."""
    profile: ProfileInput!
  ): Organization
  """
  Add a principal as a member of an organization. Returns true if the member was successfully added.
  """
  addMember(
    """The UUID of the organization to add the member to."""
    id: UUID!
    """The UUID of the principal to add as a member."""
    principalId: UUID!
  ): Boolean!
  """Add an email domain to an organization for domain-based signup rules."""
  addOrganizationDomain(
    """The domain configuration to add."""
    domain: OrganizationDomainInput!
    """The UUID of the organization to add the domain to."""
    id: UUID!
  ): Organization
  """
  Add an email-based signup invitation to an organization, allowing a specific user to join.
  """
  addSignupEmailToken(
    """The UUID of the organization to add the email invitation to."""
    id: UUID!
    """
    The email invitation configuration specifying the email address and group type.
    """
    token: OrganizationSignupEmailInput!
  ): Organization
  """
  Create a new token-based invitation for an organization. The generated token can be shared to allow users to join.
  """
  addSignupToken(
    """The UUID of the organization to create the signup token for."""
    id: UUID!
    """
    The token configuration specifying the group type for users who join via this token.
    """
    token: OrganizationSignupTokenInput!
  ): Organization
  """
  Permanently delete an organization by its unique identifier. Returns true if the deletion was successful.
  """
  delete(
    """The UUID of the organization to delete."""
    id: UUID!
  ): Boolean!
  """Delete an email-based signup invitation from an organization."""
  deleteSignupEmailToken(
    """The UUID of the organization to delete the email invitation from."""
    id: UUID!
    """The token string associated with the email invitation to delete."""
    token: String!
  ): Organization
  """
  Delete a token-based invitation from an organization, invalidating the token.
  """
  deleteSignupToken(
    """The UUID of the organization to delete the signup token from."""
    id: UUID!
    """The token string to delete."""
    token: String!
  ): Organization
  """Update an existing organization's settings and its associated profile."""
  edit(
    """
    The updated organization configuration. The id field must be set to identify the organization to edit.
    """
    organization: OrganizationInput!
    """The updated profile information for the organization."""
    profile: ProfileInput!
  ): Organization
  """
  Remove a principal from an organization's membership. Returns true if the member was successfully removed.
  """
  removeMember(
    """The UUID of the organization to remove the member from."""
    id: UUID!
    """The UUID of the principal to remove from membership."""
    principalId: UUID!
  ): Boolean!
  """Remove an email domain from an organization."""
  removeOrganizationDomain(
    """The domain string to remove (e.g. 'example.com')."""
    domain: String!
    """The UUID of the organization to remove the domain from."""
    id: UUID!
  ): Organization
}

"""
A package available for installation, containing versioned installers for setting up default content, models, and configurations
"""
type PackageInstallation {
  """Unique key identifying this package (e.g. 'com.bosca.default')"""
  key: String!
  """Human-readable name of the package"""
  name: String!
  """Available versions of this package"""
  versions: [PackageInstallationVersion!]!
}

"""Record of a past package installation event"""
type PackageInstallationHistory {
  """Timestamp when the installation occurred"""
  created: DateTime!
  """Unique ID of this installation record"""
  id: UUID!
  """Package key that was installed"""
  key: String!
  """Version that was installed"""
  version: String!
}

"""
A specific version of a package, listing its installers and which ones have already been installed
"""
type PackageInstallationVersion {
  """Installers from this version that have already been run"""
  installed: [InstalledPackage!]!
  """All installers available in this version"""
  installers: [InstalledPackage!]!
  """Semantic version string (e.g. '1.0.0')"""
  version: String!
}

"""Query operations for browsing and inspecting available packages"""
type Packages {
  """
  List all available packages with their versions and installation status
  """
  all: [PackageInstallation!]!
  """History of all package installations"""
  history: [PackageInstallationHistory!]!
}

"""
Mutation operations for installing packages and their individual installers
"""
type PackagesMutation {
  """Install all installers for a specific package version"""
  install(key: String!, version: String!): Boolean!
  """Install a single named installer from a package version"""
  installInstaller(installerName: String!, installerVersion: String!, key: String!, version: String!): Boolean!
}

"""
A registered WebAuthn passkey credential for passwordless authentication
"""
type Passkey {
  """ISO-8601 timestamp when this passkey was registered"""
  createdAt: String!
  """Base64url-encoded credential ID assigned by the authenticator"""
  credentialId: String!
  """
  ISO-8601 timestamp of the most recent authentication using this passkey, null if never used
  """
  lastUsedAt: String
  """
  Human-readable label for identifying this passkey (e.g. 'MacBook Pro Touch ID')
  """
  name: String!
  """
  Transport hints reported by the authenticator (e.g. 'internal', 'usb', 'ble', 'nfc')
  """
  transports: [String!]!
}

"""Query operations for WebAuthn passkeys"""
type Passkeys {
  """List all registered passkeys for a specific principal (admin only)"""
  all(principalId: UUID!): [Passkey!]!
  """List all registered passkeys for the current principal"""
  current: [Passkey!]!
}

"""Mutation operations for managing WebAuthn passkeys"""
type PasskeysMutation {
  """
  Remove a registered passkey by its credential ID. Cannot remove the last credential on the account.
  """
  delete(credentialId: String!): Boolean!
}

"""
A payment record: a charge, a refund (linked to its original via parentId), a void, or a
refund-to-account-credit. Provider evidence is tokens/ids only — never a card PAN.
"""
type Payment {
  amount: Money!
  complete: Boolean!
  confirmed: Boolean!
  created: DateTime!
  """
  ISO-4217 currency this payment moved (the store's; refunds inherit the original's).
  """
  currency: String!
  id: UUID!
  modified: DateTime!
  nonRefundableAmount: Money!
  note: String
  """The original payment this row refunds, if any."""
  parentId: UUID
  providerStatus: String
  providerTransactionId: String
  refundReason: String
  refunded: DateTime
  refundedAmount: Money!
  transactionType: TransactionType!
  type: PaymentType!
  voided: DateTime
  voidedReason: String
}

"""Refund/void operations on one payment. Admin."""
type PaymentMutation {
  """Refund (part of) the payment to the original method."""
  refund(amount: Money!, reason: String): Payment!
  """Refund (part of) the payment to the account's store credit (atomic)."""
  refundToAccountCredit(amount: Money!, reason: String): Payment!
  """Void an uncaptured payment."""
  void(reason: String): Payment!
}

"""
A configured payment gateway. Behavior is a DI-registered PaymentProvider implementation selected by
providerKey; this row carries its settings.
"""
type PaymentProvider {
  company: Company!
  """
  Provider settings. May hold secrets — admin-permission-gated, never on storefront paths.
  """
  configuration: ProviderConfiguration!
  id: UUID!
  name: String!
  """DI key of the provider implementation (e.g. stripe, test)."""
  providerKey: String!
}

"""How a payment was tendered."""
enum PaymentType {
  ACCOUNT_CREDIT
  CASH
  CHECK
  COMPANY_CREDIT
  CREDIT_CARD
}

"""Payment administration. Admin."""
type PaymentsMutation {
  """Operations on an existing payment."""
  payment(id: UUID!): PaymentMutation!
}

"""Percentage off the cart's discountable amount."""
type PercentOffCartRule {
  percent: Float!
  type: String!
}

"""Percentage off a subscription renewal."""
type PercentOffSubscriptionRule {
  percent: Float!
  type: String!
}

"""
A permission granted to a security group, representing a specific action allowance
"""
type Permission {
  """The permitted action (e.g. VIEW, EDIT, DELETE)"""
  action: PermissionAction!
  """The security group that holds this permission"""
  group: Group!
  """ID of the security group that holds this permission"""
  groupId: UUID!
}

"""
An action that can be granted or denied through permissions on entities
"""
enum PermissionAction {
  """Permission to permanently remove an entity"""
  DELETE
  """Permission to modify an entity's content or attributes"""
  EDIT
  """
  Permission to execute or trigger an entity (e.g. run a workflow or job)
  """
  EXECUTE
  """Permission to act on behalf of another principal"""
  IMPERSONATE
  """Permission to list or enumerate child entities"""
  LIST
  """
  Permission to manage an entity's configuration, permissions, and lifecycle
  """
  MANAGE
  """Permission to read or view an entity's content"""
  VIEW
}

"""
Input for granting or revoking a permission, specifying the action, target entity, and security group
"""
input PermissionInput {
  """The permission action to grant or revoke (e.g. VIEW, EDIT, DELETE)"""
  action: PermissionAction!
  """The ID of the entity the permission applies to"""
  entityId: String!
  """The ID of the security group being granted or denied this permission"""
  groupId: String!
}

"""Query operations for retrieving persisted GraphQL queries"""
type PersistedQueries {
  """List all registered persisted queries"""
  all: [PersistedQuery!]!
  """Look up a persisted query by its SHA-256 hash"""
  query(sha256: String!): PersistedQuery
}

"""
Mutation operations for managing persisted GraphQL queries, which allow clients to send a hash instead of the full query text
"""
type PersistedQueriesMutation {
  """Register a new persisted query for an application"""
  add(application: String!, query: String!, sha256: String!): Boolean!
  """Register multiple persisted queries for an application in bulk"""
  addAll(application: String!, queries: [PersistedQueryInput!]!): Boolean!
  """Remove a persisted query by its SHA-256 hash"""
  delete(application: String!, sha256: String!): Boolean!
  """Remove all persisted queries for all applications"""
  deleteAll: Boolean!
}

"""
A persisted GraphQL query, identified by its SHA-256 hash for efficient client-server communication
"""
type PersistedQuery {
  """The application this query belongs to"""
  application: String!
  """The full GraphQL query text"""
  query: String!
  """SHA-256 hash of the query, used as a unique identifier"""
  sha256: String!
}

"""Input for registering a persisted query"""
input PersistedQueryInput {
  """The full GraphQL query text"""
  query: String!
  """SHA-256 hash of the query"""
  sha256: String!
}

"""
An admin-configured Personalization Signal definition — how to derive a keyed, typed personalization value from a profile attribute (or segment) for the recommender.
"""
type PersonalizationSignalDefinition {
  """When this definition was created."""
  created: DateTime!
  """Whether the definition is active."""
  enabled: Boolean!
  """JSONata producing the signal's value."""
  expression: String!
  """The unique identifier of the definition."""
  id: UUID!
  """Stable signal identifier / feature + cohort membership name."""
  key: String!
  """When this definition was last modified."""
  modified: DateTime!
  """Ranking/weight among signals."""
  priority: Int!
  """The ProfileAttributeType id or segment id this signal derives from."""
  sourceId: String!
  """
  Whether this signal derives from a profile attribute type or a segment.
  """
  sourceType: PersonalizationSignalSourceType!
  """Whether each distinct generated value becomes a cohort membership."""
  useAsCohort: Boolean!
  """Whether it feeds the model's user tower."""
  useAsFeature: Boolean!
  """How the produced value is interpreted."""
  valueType: PersonalizationSignalValueType!
}

"""Input for creating or updating a Personalization Signal definition."""
input PersonalizationSignalDefinitionInput {
  """Whether the definition is active."""
  enabled: Boolean
  """
  JSONata producing the signal's value from the attribute (value + confidence/verified/…); a null result excludes it.
  """
  expression: String!
  """
  Stable signal identifier / feature + cohort membership name (e.g. age_band, gender). Unique.
  """
  key: String!
  """Ranking/weight among signals; higher is stronger."""
  priority: Int
  """
  The ProfileAttributeType id (ATTRIBUTE) or segment id (SEGMENT) this signal derives from.
  """
  sourceId: String!
  """
  Whether this signal derives from a profile attribute type or a segment.
  """
  sourceType: PersonalizationSignalSourceType!
  """
  Create a "people like you" cohort membership for every distinct generated value (must be CATEGORICAL/BOOLEAN).
  """
  useAsCohort: Boolean
  """Feed the model's user tower."""
  useAsFeature: Boolean
  """How the produced value is interpreted."""
  valueType: PersonalizationSignalValueType!
}

"""Where a Personalization Signal sources its raw value from."""
enum PersonalizationSignalSourceType {
  """A profile attribute type — sourceId is a ProfileAttributeType id."""
  ATTRIBUTE
  """A segment — sourceId is a segment id."""
  SEGMENT
}

"""
How a Personalization Signal's computed value is interpreted (trainer encoding + cohort treatment). The JSONata expression must produce a value matching this type.
"""
enum PersonalizationSignalValueType {
  """A boolean — a binary feature; usable as a cohort membership."""
  BOOLEAN
  """
  A single string label (e.g. "25-34", "female") — embedded; usable as a cohort membership.
  """
  CATEGORICAL
  """An array of string labels — multi-hot; feature-only."""
  MULTI_CATEGORICAL
  """
  A number — bucketized/normalized; feature-only unless the expression buckets it to a label.
  """
  NUMERIC
}

"""Query operations for Personalization Signal definitions (admin only)."""
type PersonalizationSignals {
  """
  Retrieve a paginated list of all Personalization Signal definitions, highest priority first.
  """
  all(
    """The maximum number of definitions to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [PersonalizationSignalDefinition!]!
  """Retrieve a single definition by its identifier."""
  signal(
    """The UUID of the definition to retrieve."""
    id: UUID!
  ): PersonalizationSignalDefinition
}

"""
Mutation operations for Personalization Signal definitions (admin only).
"""
type PersonalizationSignalsMutation {
  """
  Create a definition. Validates key uniqueness, JSONata parseability, and the cohort/valueType rule.
  """
  add(
    """The definition to create."""
    signal: PersonalizationSignalDefinitionInput!
  ): PersonalizationSignalDefinition!
  """Delete a definition."""
  delete(
    """The UUID of the definition to delete."""
    id: UUID!
  ): Boolean!
  """Update an existing definition (same validation as add)."""
  edit(
    """The UUID of the definition to update."""
    id: UUID!
    """The updated definition."""
    signal: PersonalizationSignalDefinitionInput!
  ): PersonalizationSignalDefinition!
}

"""A currently running query from pg_stat_activity."""
type PgActiveQuery {
  """The application name connected to this backend."""
  applicationName: String
  """Time when the server process was started."""
  backendStart: String
  """The type of backend (client backend, autovacuum worker, etc.)."""
  backendType: String
  """The IP address of the client connected to this backend."""
  clientAddr: String
  """The name of the database this backend is connected to."""
  databaseName: String
  """The process ID of the backend."""
  pid: Int!
  """The text of the currently or most recently executing query."""
  query: String
  """Duration in seconds that the current query has been running."""
  queryDurationSeconds: Float
  """Time when the currently active query was started."""
  queryStart: String
  """
  The current state of the backend (active, idle, idle in transaction, etc.).
  """
  state: String
  """Time when the current state was entered."""
  stateChange: String
  """The name of the user logged into this backend."""
  userName: String
  """The specific wait event the backend is waiting for."""
  waitEvent: String
  """Whether this backend is currently waiting on a lock."""
  waitEventType: String
  """Time when the current transaction was started."""
  xactStart: String
}

"""
A blocking relationship between two backends where one process holds a lock preventing another from proceeding.
"""
type PgBlockingChain {
  """How long the blocked backend has been waiting in seconds."""
  blockedDurationSeconds: Float
  """The process ID of the blocked backend."""
  blockedPid: Int!
  """The query being executed by the blocked backend."""
  blockedQuery: String
  """The current state of the blocked backend."""
  blockedState: String
  """The user name of the blocked backend."""
  blockedUser: String
  """The process ID of the blocking backend."""
  blockingPid: Int!
  """The query being executed by the blocking backend."""
  blockingQuery: String
  """The current state of the blocking backend."""
  blockingState: String
  """The user name of the blocking backend."""
  blockingUser: String
}

"""
Database routing configuration from PgBouncer's SHOW DATABASES command.
"""
type PgBouncerDatabase {
  """The number of connections currently established."""
  currentConnections: Int!
  """The actual PostgreSQL database name connected to."""
  database: String!
  """Whether this database is currently disabled."""
  disabled: Boolean!
  """The user PgBouncer forces connections as, if configured."""
  forceUser: String
  """The physical PostgreSQL host this database routes to."""
  host: String
  """The maximum number of connections allowed for this database."""
  maxConnections: Int!
  """The minimum pool size maintained for this database."""
  minPoolSize: Int!
  """The logical database name exposed by PgBouncer."""
  name: String!
  """Whether this database is currently paused."""
  paused: Boolean!
  """The pool mode for this database (session, transaction, or statement)."""
  poolMode: String
  """The default pool size for this database."""
  poolSize: Int!
  """The port of the physical PostgreSQL host."""
  port: Int!
  """The number of reserve connections for this database."""
  reservePool: Int!
}

"""
Aggregated throughput and latency statistics from PgBouncer's SHOW STATS command.
"""
type PgBouncerDatabaseStats {
  """Average number of queries per second in the last stats period."""
  avgQueryCount: Long!
  """Average query duration in microseconds."""
  avgQueryTime: Long!
  """Average received bytes per second."""
  avgRecv: Long!
  """Average sent bytes per second."""
  avgSent: Long!
  """Average time a client spent waiting for a server in microseconds."""
  avgWaitTime: Long!
  """Average number of transactions per second in the last stats period."""
  avgXactCount: Long!
  """Average transaction duration in microseconds."""
  avgXactTime: Long!
  """The database name."""
  database: String!
  """Total number of SQL queries pooled by PgBouncer."""
  totalQueryCount: Long!
  """
  Total time spent by PgBouncer when actively querying PostgreSQL in microseconds.
  """
  totalQueryTime: Long!
  """Total volume of network traffic received from clients in bytes."""
  totalReceived: Long!
  """Total volume of network traffic sent to clients in bytes."""
  totalSent: Long!
  """Time spent by clients waiting for a server connection in microseconds."""
  totalWaitTime: Long!
  """Total number of SQL transactions pooled by PgBouncer."""
  totalXactCount: Long!
  """
  Total time spent by PgBouncer when connected to PostgreSQL in transactions in microseconds.
  """
  totalXactTime: Long!
}

"""
Composite view of PgBouncer status combining pool, stats, and database routing information.
"""
type PgBouncerInfo {
  """Whether PgBouncer is reachable and responding to admin commands."""
  available: Boolean!
  """Database routing configuration showing logical-to-physical mappings."""
  databases: [PgBouncerDatabase!]!
  """Connection pool utilization per database/user pair."""
  pools: [PgBouncerPoolStats!]!
  """Aggregated throughput and latency statistics per database."""
  stats: [PgBouncerDatabaseStats!]!
  """The PgBouncer version string."""
  version: String
}

"""
Connection pool utilization from PgBouncer's SHOW POOLS command per database/user pair.
"""
type PgBouncerPoolStats {
  """Number of active client connections using a server connection."""
  clActive: Int!
  """Number of active client cancel requests being processed."""
  clActiveCancelReq: Int!
  """Number of client connections that have sent a cancel request."""
  clCancelReq: Int!
  """Number of client connections waiting for a server connection."""
  clWaiting: Int!
  """The database name this pool serves."""
  database: String!
  """Maximum wait time in seconds for a client in this pool."""
  maxwait: Long!
  """Maximum wait time in microseconds for a client in this pool."""
  maxwaitUs: Long!
  """The pool mode for this pool (session, transaction, or statement)."""
  poolMode: String!
  """Number of server connections actively processing a client request."""
  svActive: Int!
  """Number of server connections processing a cancel request."""
  svActiveCancel: Int!
  """Number of server connections being canceled."""
  svBeingCanceled: Int!
  """Number of server connections idle and ready for use."""
  svIdle: Int!
  """Number of server connections currently logging in to PostgreSQL."""
  svLogin: Int!
  """Number of server connections currently running a reset or check query."""
  svTested: Int!
  """
  Number of server connections used but not idle for more than server_check_delay.
  """
  svUsed: Int!
  """The user name this pool authenticates as."""
  user: String!
}

"""
Background writer and checkpoint statistics from pg_stat_bgwriter for monitoring checkpoint behavior and buffer management.
"""
type PgCheckpointStats {
  """Number of buffers allocated."""
  buffersAlloc: Long!
  """Number of buffers written directly by a backend."""
  buffersBackend: Long!
  """Number of times a backend had to execute its own fsync call."""
  buffersBackendFsync: Long!
  """Number of buffers written during checkpoints."""
  buffersCheckpoint: Long!
  """Number of buffers written by the background writer."""
  buffersClean: Long!
  """Number of requested checkpoints that have been performed."""
  checkpointsRequestedCount: Long!
  """Number of scheduled checkpoints that have been performed."""
  checkpointsTimedCount: Long!
  """
  Number of times the background writer stopped a cleaning scan because it had written too many buffers.
  """
  maxwrittenClean: Long!
  """Time at which these statistics were last reset."""
  statsReset: String
}

"""
Connection pool statistics for the application's database connection pools.
"""
type PgConnectionPoolStats {
  """The number of currently active (checked out) connections."""
  activeConnections: Int!
  """The number of connections that have been created."""
  createdConnections: Int!
  """Whether there are connections available in the pool."""
  hasAvailableConnections: Boolean!
  """The maximum number of connections allowed in this pool."""
  maxConnections: Int!
  """The name of the connection pool."""
  poolName: String!
}

"""
Overall database statistics from pg_stat_database for the connected database.
"""
type PgDatabaseStats {
  """Number of times disk blocks were found in the buffer cache."""
  blksHit: Long!
  """Number of disk blocks read in this database."""
  blksRead: Long!
  """Buffer cache hit ratio as a percentage (0-100)."""
  cacheHitRatio: Float!
  """Number of queries canceled due to conflicts in this database."""
  conflicts: Long!
  """The name of the database."""
  databaseName: String!
  """Total size of the database in bytes."""
  databaseSize: Long!
  """Number of deadlocks detected in this database."""
  deadlocks: Long!
  """Number of backends currently connected to this database."""
  numBackends: Int!
  """Time at which database statistics were last reset."""
  statsReset: String
  """Total amount of data written to temporary files in bytes."""
  tempBytes: Long!
  """Number of temporary files created by queries in this database."""
  tempFiles: Long!
  """Number of rows deleted by queries in this database."""
  tupDeleted: Long!
  """Number of rows fetched by queries in this database."""
  tupFetched: Long!
  """Number of rows inserted by queries in this database."""
  tupInserted: Long!
  """Number of rows returned by queries in this database."""
  tupReturned: Long!
  """Number of rows updated by queries in this database."""
  tupUpdated: Long!
  """Number of transactions committed in this database."""
  xactCommit: Long!
  """Number of transactions rolled back in this database."""
  xactRollback: Long!
}

"""Metadata about an installed PostgreSQL extension."""
type PgExtension {
  """The default version available for installation."""
  defaultVersion: String
  """A brief description of what the extension provides."""
  description: String
  """The currently installed version of the extension."""
  installedVersion: String!
  """The name of the extension."""
  name: String!
}

"""Index-level statistics from pg_stat_user_indexes."""
type PgIndexStats {
  """Number of index scans initiated on this index."""
  idxScan: Long!
  """
  Number of live table rows fetched by simple index scans using this index.
  """
  idxTupFetch: Long!
  """Number of index entries returned by scans on this index."""
  idxTupRead: Long!
  """The index definition (CREATE INDEX statement)."""
  indexDef: String
  """The name of the index."""
  indexName: String!
  """Size of the index in bytes."""
  indexSize: Long!
  """The schema containing the index."""
  schemaName: String!
  """The name of the table this index belongs to."""
  tableName: String!
}

"""
A candidate table or index that may benefit from an index, based on sequential scan analysis.
"""
type PgIndexSuggestion {
  """Number of index scans on this table."""
  idxScan: Long!
  """A human-readable description of why an index may help."""
  reason: String!
  """The schema containing the table."""
  schemaName: String!
  """Number of sequential scans on this table."""
  seqScan: Long!
  """Number of rows read via sequential scans."""
  seqTupRead: Long!
  """The table that may benefit from an index."""
  tableName: String!
  """Total size of the table in bytes."""
  tableSize: Long!
}

"""Lock information from pg_locks joined with pg_stat_activity."""
type PgLockInfo {
  """The name of the database in which the locked object exists."""
  databaseName: String
  """How long this lock has been held or waited for, in seconds."""
  durationSeconds: Float
  """
  Whether the lock has been granted (true) or is being waited for (false).
  """
  granted: Boolean!
  """The type of lockable object (relation, transactionid, tuple, etc.)."""
  lockType: String!
  """
  The lock mode held or desired (AccessShareLock, RowExclusiveLock, etc.).
  """
  mode: String!
  """The process ID holding or waiting for the lock."""
  pid: Int!
  """
  The query being executed by the process holding or waiting for the lock.
  """
  query: String
  """The name of the locked relation, if applicable."""
  relationName: String
  """The current state of the backend holding the lock."""
  state: String
}

"""
A long-running transaction, particularly idle-in-transaction sessions that hold locks and prevent autovacuum.
"""
type PgLongTransaction {
  """The application name connected to this backend."""
  applicationName: String
  """The name of the database this backend is connected to."""
  databaseName: String
  """The text of the most recently executed query in this transaction."""
  lastQuery: String
  """The process ID of the backend."""
  pid: Int!
  """
  The current state of the backend (active, idle, idle in transaction, etc.).
  """
  state: String
  """The name of the user logged into this backend."""
  userName: String
  """The specific wait event the backend is waiting for."""
  waitEvent: String
  """The type of event the backend is currently waiting for."""
  waitEventType: String
  """Duration in seconds that the current transaction has been open."""
  xactDurationSeconds: Float
  """Time when the current transaction was started."""
  xactStartTime: String
}

"""
Size information for a database object (table, index, or materialized view).
"""
type PgObjectSize {
  """Size of indexes on this table in bytes (only for tables)."""
  indexSize: Long
  """The name of the object."""
  objectName: String!
  """The type of object (table, index, materialized view)."""
  objectType: String!
  """The schema containing the object."""
  schemaName: String!
  """Size of the table data alone in bytes (only for tables)."""
  tableSize: Long
  """Total size of the object including indexes and TOAST data in bytes."""
  totalSize: Long!
}

"""Replication slot information from pg_replication_slots."""
type PgReplicationSlot {
  """Whether the slot is currently active."""
  active: Boolean!
  """The WAL position this slot has been confirmed flushed up to."""
  confirmedFlushLsn: String
  """The name of the database this slot is associated with."""
  databaseName: String
  """The amount of WAL retained by this slot in bytes."""
  retainedWalBytes: Long
  """The name of the replication slot."""
  slotName: String!
  """The type of the slot: physical or logical."""
  slotType: String!
}

"""
Streaming replication state for a connected standby from pg_stat_replication.
"""
type PgReplicationStatus {
  """The application name of the connected standby."""
  applicationName: String
  """The IP address of the connected standby."""
  clientAddr: String
  """Flush lag in seconds behind the primary."""
  flushLagSeconds: Float
  """The last WAL position flushed to disk by this standby."""
  flushLsn: String
  """The process ID of the WAL sender process."""
  pid: Int!
  """Replay lag in seconds behind the primary."""
  replayLagSeconds: Float
  """The last WAL position replayed (applied) by this standby."""
  replayLsn: String
  """The last WAL position sent on this connection."""
  sentLsn: String
  """
  The current replication state (startup, catchup, streaming, backup, stopping).
  """
  state: String
  """Priority of this standby for synchronous replication."""
  syncPriority: Int
  """Synchronous replication state (async, sync, potential, quorum)."""
  syncState: String
  """The user name of the replication connection."""
  userName: String
  """Write lag in seconds behind the primary."""
  writeLagSeconds: Float
  """The last WAL position written to disk by this standby."""
  writeLsn: String
}

"""
Sequence utilization information showing how close a sequence is to its maximum value.
"""
type PgSequenceUsage {
  """The current (last issued) value of the sequence."""
  currentValue: Long!
  """The data type of the sequence (smallint, integer, bigint)."""
  dataType: String!
  """The maximum value the sequence can reach before exhaustion."""
  maxValue: Long!
  """The percentage of the sequence range that has been consumed (0-100)."""
  percentUsed: Float!
  """The schema containing the sequence."""
  schemaName: String!
  """The name of the sequence."""
  sequenceName: String!
}

"""PostgreSQL server configuration settings from pg_settings."""
type PgSetting {
  """The category of the parameter."""
  category: String!
  """
  The context in which the parameter can be changed (postmaster, sighup, superuser, user).
  """
  context: String!
  """The list of allowed values for enum parameters."""
  enumVals: [String!]
  """The maximum allowed value, if applicable."""
  maxVal: String
  """The minimum allowed value, if applicable."""
  minVal: String
  """The name of the configuration parameter."""
  name: String!
  """Whether the value requires a server restart to take effect."""
  pendingRestart: Boolean!
  """The current value of the parameter."""
  setting: String!
  """A short description of the parameter."""
  shortDesc: String!
  """The source of the current value (default, configuration file, etc.)."""
  source: String!
  """The unit of the parameter value, if applicable."""
  unit: String
  """The data type of the parameter (bool, integer, real, string, enum)."""
  vartype: String!
}

"""
A slow query captured from pg_stat_statements (requires pg_stat_statements extension).
"""
type PgSlowQuery {
  """Total number of times this query has been executed."""
  calls: Long!
  """Cache hit ratio for this query as a percentage (0-100)."""
  hitRatio: Float!
  """Maximum execution time in milliseconds."""
  maxTimeMs: Float!
  """Mean execution time per call in milliseconds."""
  meanTimeMs: Float!
  """Minimum execution time in milliseconds."""
  minTimeMs: Float!
  """The query text with parameters replaced by placeholders."""
  query: String!
  """Total number of rows retrieved or affected by this query."""
  rows: Long!
  """Number of shared buffer cache hits by this query."""
  sharedBlksHit: Long!
  """Number of shared buffer cache reads by this query."""
  sharedBlksRead: Long!
  """Standard deviation of execution time in milliseconds."""
  stddevTimeMs: Float!
  """Total time spent executing this query in milliseconds."""
  totalTimeMs: Float!
}

"""Table I/O statistics from pg_statio_user_tables."""
type PgTableIOStats {
  """Cache hit ratio for this table as a percentage (0-100)."""
  cacheHitRatio: Float!
  """Number of buffer cache hits for this table."""
  heapBlksHit: Long!
  """Number of disk blocks read from this table."""
  heapBlksRead: Long!
  """Number of buffer cache hits for indexes on this table."""
  idxBlksHit: Long!
  """Number of disk blocks read from all indexes on this table."""
  idxBlksRead: Long!
  """The schema containing this table."""
  schemaName: String!
  """The name of the table."""
  tableName: String!
  """Number of buffer cache hits for this table's TOAST table."""
  toastBlksHit: Long!
  """Number of disk blocks read from this table's TOAST table."""
  toastBlksRead: Long!
}

"""Table-level statistics from pg_stat_user_tables."""
type PgTableStats {
  """Number of times this table has been manually analyzed."""
  analyzeCount: Long!
  """Number of times this table has been analyzed by autovacuum."""
  autoanalyzeCount: Long!
  """Number of times this table has been vacuumed by autovacuum."""
  autovacuumCount: Long!
  """Ratio of dead tuples to live tuples as a percentage."""
  bloatRatio: Float!
  """Number of index scans initiated on this table."""
  idxScan: Long!
  """Number of live rows fetched by index scans."""
  idxTupFetch: Long!
  """Size of indexes on this table in bytes."""
  indexSize: Long!
  """Last time this table was manually analyzed."""
  lastAnalyze: String
  """Last time this table was analyzed by autovacuum."""
  lastAutoanalyze: String
  """Last time this table was vacuumed by autovacuum."""
  lastAutovacuum: String
  """Last time this table was manually vacuumed."""
  lastVacuum: String
  """Estimated number of dead rows."""
  nDeadTup: Long!
  """Estimated number of live rows."""
  nLiveTup: Long!
  """Number of rows deleted."""
  nTupDel: Long!
  """Number of rows HOT updated (no separate index entry needed)."""
  nTupHotUpd: Long!
  """Number of rows inserted."""
  nTupIns: Long!
  """Number of rows updated (includes HOT updates)."""
  nTupUpd: Long!
  """The schema containing this table."""
  schemaName: String!
  """Number of sequential scans initiated on this table."""
  seqScan: Long!
  """Number of live rows fetched by sequential scans."""
  seqTupRead: Long!
  """The name of the table."""
  tableName: String!
  """Size of the table data alone in bytes."""
  tableSize: Long!
  """Total size of the table including indexes and TOAST in bytes."""
  totalSize: Long!
  """Number of times this table has been manually vacuumed."""
  vacuumCount: Long!
}

"""Database vacuum and maintenance progress information."""
type PgVacuumProgress {
  """The name of the database being vacuumed."""
  databaseName: String
  """The number of heap blocks scanned so far."""
  heapBlksScanned: Long!
  """The total number of heap blocks in the table."""
  heapBlksTotal: Long!
  """The number of heap blocks vacuumed so far."""
  heapBlksVacuumed: Long!
  """The number of dead tuples that can be removed."""
  numDeadTuples: Long!
  """The current phase of the vacuum operation."""
  phase: String!
  """The process ID of the vacuum worker."""
  pid: Int!
  """The schema of the table being vacuumed."""
  schemaName: String
  """The name of the table being vacuumed."""
  tableName: String
}

"""
Write-Ahead Log generation and I/O statistics from pg_stat_wal for monitoring WAL throughput and tuning.
"""
type PgWalStats {
  """Time at which WAL statistics were last reset."""
  statsReset: String
  """
  Number of times WAL data was written to disk because WAL buffers became full.
  """
  walBuffersFull: Long!
  """Total amount of WAL generated in bytes."""
  walBytes: Long!
  """Total number of WAL full page images generated."""
  walFpi: Long!
  """Total number of WAL records generated."""
  walRecords: Long!
  """
  Total number of times WAL files were synced to disk via issue_xlog_fsync request.
  """
  walSync: Long!
  """Total time spent syncing WAL files to disk in milliseconds."""
  walSyncTime: Float!
  """
  Total number of times WAL buffers were written out to disk via XLogWrite request.
  """
  walWrite: Long!
  """Total time spent writing WAL buffers to disk in milliseconds."""
  walWriteTime: Float!
}

"""
A stored, reusable pipeline — a graph of typed nodes that triggers/analytics run.
"""
type Pipeline {
  """
  Fully-qualified type the pipeline's Input node accepts (consumers filter by this).
  """
  acceptedInputType: String!
  """When true, the pipeline is callable via its REST endpoint."""
  api: Boolean!
  description: String!
  """
  Repository-relative path of the pipeline's YAML file (e.g. pipelines/notify-slack.yaml), when linked.
  """
  gitPath: String
  """
  The PIPELINE_PROJECT Git repository this pipeline is serialized to, when linked.
  """
  gitRepositoryId: UUID
  """The node/edge graph — drives the Vue Flow editor and the executor."""
  graph: JSON!
  """
  Whether the graph has an Output node. Without one, a Run Pipeline caller receives no output and its downstream nodes are skipped.
  """
  hasOutput: Boolean!
  id: UUID!
  """
  The typed fields of a declared object-shape input (acceptedType = "SHAPE"); empty otherwise.
  """
  inputFields: [PipelineShapeField!]!
  """
  Declared input shape for JSON-input pipelines (JSON Schema subset), or null when unconstrained or event-typed.
  """
  inputSchema: JSON
  """
  Stable URL handle for the REST endpoint (POST/GET /api/v1/p/{key}); empty when not endpoint-exposed.
  """
  key: String!
  """
  Last Git sync error for this pipeline, or null when the last sync succeeded.
  """
  lastSyncError: String
  """
  Max durable runs in flight at once; null = unlimited. Excess triggers are shed.
  """
  maxConcurrentRuns: Int
  """
  Max durable runs started per rolling minute; null = unlimited. Excess triggers are shed.
  """
  maxRunsPerMinute: Int
  name: String!
  """
  The typed fields of a declared object-shape output (outputType = "SHAPE"); empty otherwise.
  """
  outputFields: [PipelineShapeField!]!
  """Declared output shape (JSON Schema subset), or null when undeclared."""
  outputSchema: JSON
  """
  Declared output type — "JSON" or a fully-qualified type name; null when undeclared or there is no Output node.
  """
  outputType: String
  """
  Group permission grants on this pipeline. Empty unless the caller can MANAGE it.
  """
  permissions: [Permission!]!
  """
  When true (and api is on), the endpoint is callable without an EXECUTE grant.
  """
  public: Boolean!
  """
  Cron expression to run this pipeline on a schedule, or null when not scheduled.
  """
  schedule: String
  """
  Free-form categorization labels — the UI groups and filters pipelines by these.
  """
  tags: [String!]!
  """
  When true, the pipeline runs automatically whenever its accepted event fires.
  """
  triggered: Boolean!
  """Optimistic-locking version."""
  version: Int!
}

"""A node a run is parked on, resolved from the run's graph snapshot."""
type PipelineAwaitingNode {
  """The node's display name (falls back to its id)."""
  name: String!
  nodeId: String!
  """
  The run actually parked on this node — a drilled-through row carries its CHILD run's id (what resolveGate/provideInput must target).
  """
  runId: UUID
  """
  The node-type key (e.g. gate.approval, release.buildWait) — gate.approval and waitForInput mean a human is being waited on.
  """
  type: String!
}

"""
Entry in a Git backfill request: which pipeline to serialize and where to write it in the repo.
"""
input PipelineBackfillEntryInput {
  """The target path in the repository (e.g. pipelines/notify-slack.yaml)."""
  gitPath: String!
  """The unique identifier of the pipeline to serialize."""
  pipelineId: UUID!
}

"""
Result of a pipeline dry run: per-node trace, no side effects executed.
"""
type PipelineDryRun {
  """
  Keyed by node id → what the action node WOULD have done (job/email/script details).
  """
  actions: JSON!
  """Top-level error message when the run aborted, or null on success."""
  error: String
  """Keyed by node id → error message, when the run aborted at that node."""
  errors: JSON!
  """
  Keyed by node id → that node's output (encoded via its carried serializer).
  """
  outputs: JSON!
  """
  Keyed by node id → reason the node was skipped (e.g. its branch wasn't taken).
  """
  skipped: JSON!
}

"""
One finished pipeline execution recorded in run history (the append-only audit; distinct from PipelineRunState, the live durable run).
"""
type PipelineHistoryRun {
  durationMs: Long
  errorMessage: String
  """The event that fired the run."""
  eventName: String!
  finishedAt: DateTime
  """Id of this history entry (not the run — see runId)."""
  id: UUID!
  """Terminal outcome: OK, FAILED, or CANCELLED."""
  outcome: PipelineRunStatus!
  pipelineId: UUID!
  """Name of the pipeline that ran."""
  pipelineName: String!
  """
  The durable run this history entry came from (open its per-node timeline via Query.pipelines.run); null for inline manual/API runs.
  """
  runId: UUID
  startedAt: DateTime!
}

"""Input for creating or updating a pipeline."""
input PipelineInput {
  acceptedInputType: String!
  """Expose the pipeline as a REST endpoint (POST/GET /api/v1/p/{key})."""
  api: Boolean
  description: String
  """The node/edge graph."""
  graph: JSON!
  """Omit to create; provide the id to update."""
  id: UUID
  """Stable URL handle for the REST endpoint; required when api is true."""
  key: String
  """Max durable runs in flight at once; null/≤0 = unlimited."""
  maxConcurrentRuns: Int
  """Max durable runs started per rolling minute; null/≤0 = unlimited."""
  maxRunsPerMinute: Int
  name: String!
  """Make the REST endpoint callable without an EXECUTE grant."""
  public: Boolean
  """
  Cron expression to run this pipeline on a schedule; null/blank = not scheduled.
  """
  schedule: String
  """Free-form categorization labels; omit to leave untagged."""
  tags: [String!]
  """Run automatically when the accepted event fires."""
  triggered: Boolean
  """Required when updating (optimistic locking)."""
  version: Int
}

"""
A reusable, named object shape — a first-class type an Input/Output references by name (as "shape:<name>").
"""
type PipelineNamedShape {
  """The shape's typed fields."""
  fields: [PipelineShapeField!]!
  """Unique shape name, e.g. ReleaseBundle."""
  name: String!
}

"""Editor-palette grouping for a node type."""
enum PipelineNodeCategory {
  ACTION
  COMBINE
  FETCH
  INPUT
  OUTPUT
  ROUTE
  TRANSFORM
}

"""
One event in a run's per-node execution timeline — a node may have several (e.g. suspended then ok).
"""
type PipelineNodeExecution {
  """finished − started, in milliseconds."""
  durationMs: Long!
  """Failure message when status is FAILED."""
  error: String
  finishedAt: DateTime!
  """Id of the node that executed."""
  nodeId: String!
  """
  Size-bounded JSON snapshot of the node's output, or null when none/skipped/capped.
  """
  output: JSON
  """
  The output port the value left on (routing/error), or null for the implicit output.
  """
  port: String
  startedAt: DateTime!
  status: PipelineNodeExecutionStatus!
}

"""Outcome of a single node execution within a run."""
enum PipelineNodeExecutionStatus {
  FAILED
  OK
  SKIPPED
  SUSPENDED
}

"""
One field of a typed slot's object — its name, a coarse type label, and (for object/list-of-object fields) its own nested fields, for the Type Browser's recursive introspection.
"""
type PipelineNodeFieldDescriptor {
  """
  The field type's own fields when it is an object (or a list of objects); null for a leaf, a cycle, or past the walk depth.
  """
  fields: [PipelineNodeFieldDescriptor!]
  """Field name as it appears in the object's JSON."""
  name: String!
  """
  Coarse, UI-friendly type label (String, Int, Boolean, Enum, List<...>, Map, or a short type name).
  """
  type: String!
}

"""
One typed input port of a node type — the constraints the editor and engine enforce on what may be wired into it.
"""
type PipelineNodeInputSlot {
  """
  Short human description of what this slot expects, shown in the editor; null = none.
  """
  description: String
  """Accepted value kind."""
  kind: PipelineSlotKind!
  """Port name; the edge's target port matches a value to this slot."""
  name: String!
  """Whether a value must be wired into this slot."""
  required: Boolean!
  """
  JSON-Schema-subset shape the value must satisfy, validated even when the upstream output kind is unknown; null = none.
  """
  schema: JSON
  """
  The expected object type's fields, for the editor's hover introspection; null when the slot isn't a specific object.
  """
  structure: [PipelineNodeFieldDescriptor!]
  """
  Fully-qualified serial name an OBJECT value must carry (a specific object); null = any object.
  """
  type: String
  """Display label for the palette."""
  typeLabel: String!
}

"""
Aggregate execution metrics for one node across a pipeline's runs (over OK+FAILED completions).
"""
type PipelineNodeMetrics {
  """Number of completions (OK + FAILED)."""
  executions: Long!
  """failures / executions, 0..1."""
  failureRate: Float!
  """How many completions were FAILED."""
  failures: Long!
  """Id of the node."""
  nodeId: String!
  """Median completion duration in milliseconds."""
  p50DurationMs: Float!
  """95th-percentile completion duration in milliseconds."""
  p95DurationMs: Float!
}

"""
One named output port of a node type — a wireable handle; error ports route recoverable failures to a downstream branch.
"""
type PipelineNodeOutputSlot {
  """Short human description of what the port emits; null = none."""
  description: String
  """
  Whether this is an error port — an emitted-but-unwired error port fails the run instead of reporting success.
  """
  error: Boolean!
  """Value kind emitted on this port."""
  kind: PipelineSlotKind!
  """Port name; an edge's sourcePort matches a value emitted on this port."""
  name: String!
  """
  The emitted object type's fields, for the editor's hover introspection; null when the port isn't a specific object.
  """
  structure: [PipelineNodeFieldDescriptor!]
  """
  Fully-qualified serial name an OBJECT port emits (a specific object), matched against a downstream slot's type; null = any object.
  """
  type: String
  """
  Human display label for the emitted value, shown in the inspector's Produces section; null = use the port name.
  """
  typeLabel: String
}

"""
One choice of an ENUM setting, or a literal extra prepended to a REFERENCE picker.
"""
type PipelineNodeSettingOption {
  """Label shown to the builder; falls back to the value when null."""
  label: String
  """Value stored in the node's settings."""
  value: String!
}

"""
One editable setting of a node type — the editor renders the control named by 'control' and writes its value into the node's settings under 'name'.
"""
type PipelineNodeSettingSlot {
  """The editor control to render."""
  control: PipelineSettingControl!
  """
  The node's own default, string-encoded — drives omit-on-default, the new-node seed, and the placeholder; null = none.
  """
  default: String
  """Hint shown under the field; null = none."""
  description: String
  """Sub-fields of a GROUP_LIST row."""
  fields: [PipelineNodeSettingSlot!]!
  """Optional section header to group the field under; null = no header."""
  group: String
  """Singular row label for a GROUP_LIST (e.g. 'Case'); null = generic."""
  itemLabel: String
  """Field label; null lets the editor humanize the name."""
  label: String
  """
  A CODE control's language ('jsonata' enables the live preview); null = none.
  """
  language: String
  """Render the field monospace."""
  mono: Boolean!
  """Settings key written into the node's graph JSON."""
  name: String!
  """
  Choices for an ENUM, or literal extras prepended to a REFERENCE picker.
  """
  options: [PipelineNodeSettingOption!]!
  """Placeholder text; null = none."""
  placeholder: String
  """
  The server list a REFERENCE control picks from; null = not a reference.
  """
  reference: PipelineSettingReference
  """Whether a value must be provided."""
  required: Boolean!
  """Mask a TEXT control as a password."""
  secret: Boolean!
  """The value visibleWhenSetting must equal for this field to show."""
  visibleWhenEquals: String
  """
  Show this field only when the named setting's effective value equals visibleWhenEquals; null = always.
  """
  visibleWhenSetting: String
}

"""
A registered pipeline node type — one palette entry in the pipeline editor.
"""
type PipelineNodeType {
  """Functional kind (drawn as the node's chrome)."""
  category: PipelineNodeCategory!
  """
  One-sentence tooltip describing what the node does; empty when the node declares none.
  """
  description: String!
  """
  Top-level organizational group for the palette and node browser (e.g. 'WorkOps'); null = unannotated — clients fall back to bucketing by category.
  """
  group: String
  """
  Typed input slots (ports) this node accepts; empty when the node imposes no per-slot constraints.
  """
  inputs: [PipelineNodeInputSlot!]!
  """
  Stable node-type key — the polymorphic 'type' discriminator used in the graph JSON.
  """
  key: String!
  """Human-friendly palette label."""
  label: String!
  """
  The node's output ports. A single output is one slot ('out', drawn as the anonymous handle); empty is a single implicit output of unknown kind; 2+ (or an error port) are named, wireable ports.
  """
  outputs: [PipelineNodeOutputSlot!]!
  """
  The node's editable settings, in display order — each names a settings key and the control the editor renders for it. Empty = the node has no configuration. Renders the node's whole form, data-driven.
  """
  settings: [PipelineNodeSettingSlot!]!
  """
  Second-level grouping under group (e.g. 'Releases'); null = directly under group.
  """
  subgroup: String
}

"""Result of a PIPELINE_PROJECT Git sync operation."""
type PipelineRepoSyncResult {
  """The last commit SHA produced, if any."""
  commitSha: String
  """
  Other error message, if any. Set when the operation failed for non-validation reasons.
  """
  errorMessage: String
  """Whether the operation succeeded."""
  ok: Boolean!
  """
  Validation errors, if any. Non-empty only when the operation failed validation.
  """
  validationErrors: [PipelineRepoValidationError!]
}

"""
A single validation error attributed to a file path in a PIPELINE_PROJECT repo.
"""
type PipelineRepoValidationError {
  """Human-readable validation error message."""
  message: String!
  """The repository-relative path of the file that failed validation."""
  path: String!
}

"""Result of a manual pipeline run."""
type PipelineRunResult {
  """
  Error message when the run failed (including input-schema violations), or null.
  """
  error: String
  """
  True unless the run terminally failed (a still-suspended run started fine).
  """
  ok: Boolean!
  """
  The value that reached the Output node (encoded to JSON), or null when the pipeline has none / hasn't finished.
  """
  output: JSON
  """
  The durable run's id — use it to track a run that suspended (status SUSPENDED).
  """
  runId: UUID!
  """
  OK (finished), FAILED/CANCELLED (terminal failure), or SUSPENDED (parked past the brief on-demand block).
  """
  status: PipelineRunStatus!
}

"""
The live, durable state of an in-flight pipeline run (distinct from the append-only run history above).
"""
type PipelineRunState {
  """
  Ids of the nodes this run is currently parked on (awaiting out-of-band work).
  """
  awaitingNodeIds: [String!]!
  """
  The parked nodes resolved from the graph snapshot — the type tells a HUMAN wait (gate.approval / waitForInput) from external work (a build, a health check).
  """
  awaitingNodes: [PipelineAwaitingNode!]!
  """
  The child runs the given For Each / Run Pipeline node spawned under this run, in item order — empty until the node has started fanning out.
  """
  childRuns(nodeId: String!): [PipelineRunState!]!
  """Ids of the nodes that have already completed (the checkpoint)."""
  completedNodeIds: [String!]!
  createdAt: DateTime!
  """Set when the run failed or was cancelled."""
  error: String
  """The event that triggered the run."""
  eventName: String!
  id: UUID!
  """
  For a run a For Each spawned: the 0-based index of the item it processes; null for a Run Pipeline child or a top-level run.
  """
  itemIndex: Int
  """Last state change — for a suspended run, how long it has been waiting."""
  modifiedAt: DateTime!
  """The per-node execution timeline for this run, in execution order."""
  nodes: [PipelineNodeExecution!]!
  pipelineId: UUID!
  status: PipelineRunStatus!
  """
  The step-oriented progress view: one row per Status node and per human wait, recursing into fan-out children (per-item rows) — never engine plumbing nodes.
  """
  steps: [PipelineRunStep!]!
}

"""Lifecycle status of a durable pipeline run."""
enum PipelineRunStatus {
  CANCELLED
  FAILED
  OK
  RUNNING
  SUSPENDED
}

"""
One row of a run's step-oriented progress view: an authored Status milestone or a human wait.
"""
type PipelineRunStep {
  """
  The artifact type of the channel this row belongs to (from the upstream artifact select), or null for channel-agnostic rows.
  """
  channelType: String
  """Child-pipeline nesting depth; 0 = the run's own graph."""
  depth: Int!
  """For fan-out children: which item this row belongs to."""
  item: String
  """STATUS (an authored milestone) or HUMAN (an approval / input wait)."""
  kind: PipelineRunStepKind!
  nodeId: String!
  """
  The run this row's node belongs to — a nested row carries its CHILD run's id (what Approve resolves against); null on pre-run plan rows.
  """
  runId: UUID
  status: PipelineRunStepStatus!
  title: String!
  """
  The node-type key (status, gate.approval, waitForInput) — which controls a WAITING row offers.
  """
  type: String
}

enum PipelineRunStepKind {
  HUMAN
  STATUS
}

enum PipelineRunStepStatus {
  DONE
  FAILED
  PENDING
  RUNNING
  WAITING
}

"""
A live status change for a durable run, streamed over the `pipelineRun`
subscription. Run-level when `nodeId` is null (`runStatus` is set); node-level otherwise
(`nodeStatus` / `port` / `error` describe the node).
"""
type PipelineRunUpdate {
  """When the change occurred."""
  at: DateTime!
  """Failure message when a node or the run failed."""
  error: String
  """The node whose status changed; null for a run-level transition."""
  nodeId: String
  """
  The node's outcome on a node-level update; null for a run-level transition.
  """
  nodeStatus: PipelineNodeExecutionStatus
  """
  The output port the node's value left on (routing / error), when applicable.
  """
  port: String
  """The run this update belongs to."""
  runId: UUID!
  """
  The run's new status on a run-level transition; null for a node-level event.
  """
  runStatus: PipelineRunStatus
}

"""
A named node secret — metadata only; the value is AES/GCM-encrypted at rest and never returned.
"""
type PipelineSecret {
  createdAt: DateTime!
  modifiedAt: DateTime!
  name: String!
}

"""The editor control a node setting renders as."""
enum PipelineSettingControl {
  BOOLEAN
  CODE
  CONDITION
  ENUM
  GROUP_LIST
  INTEGER
  LIST
  NUMBER
  REFERENCE
  SCHEMA
  TEXT
  TEXTAREA
}

"""The server-loaded list a REFERENCE setting picks from."""
enum PipelineSettingReference {
  ATTRIBUTE_TYPE
  ENVIRONMENT_TYPE
  EVENT
  GIT_ARTIFACT
  GIT_PIPELINE
  JOB
  MESSAGE_PROJECT
  MESSAGE_TEMPLATE
  NOTIFICATION_TYPE
  PIPELINE
  SCRIPT
  SEARCH_INDEX
  SECRET
  SEGMENT
  TYPE
}

"""
One field of an author-declared object shape (a pipeline's Input/Output contract) — its name and a type label.
"""
type PipelineShapeField {
  """Field name as it appears in the object."""
  name: String!
  """
  Type label — a catalogued type (optionally []-suffixed for a list), "JSON", or a primitive.
  """
  type: String!
}

"""The value kind a node port accepts/emits; ANY = dynamic/unknown."""
enum PipelineSlotKind {
  ANY
  ARRAY
  BOOLEAN
  INTEGER
  NUMBER
  OBJECT
  STRING
  UUID
}

"""Pipeline query operations."""
type Pipelines {
  """In-flight durable runs (running or suspended), newest activity first."""
  activeRuns(limit: Int = 50, offset: Int = 0): [PipelineRunState!]!
  """All pipelines."""
  all: [Pipeline!]!
  """Run history across every pipeline, newest first."""
  allRuns(limit: Int = 50, offset: Int = 0): [PipelineHistoryRun!]!
  """
  Pipelines whose stored graph no longer decodes (renamed/removed node types, corrupt data) — absent from `all` and unopenable, surfaced here so they can be deleted.
  """
  broken: [BrokenPipeline!]!
  """
  The dead-letter queue: runs that terminally FAILED, newest first — triage + replay.
  """
  deadLetter(limit: Int = 50, offset: Int = 0): [PipelineRunState!]!
  """
  Per-node execution metrics for a pipeline across its run history — busiest node first.
  """
  nodeMetrics(pipelineId: UUID!): [PipelineNodeMetrics!]!
  """
  Every node type registered across loaded modules — drives the editor palette.
  """
  nodeTypes: [PipelineNodeType!]!
  """A pipeline by id, or null if not found."""
  pipeline(id: UUID!): Pipeline
  """
  A single durable run's live state + (via its nodes field) per-node timeline, by run id; in-flight or finished.
  """
  run(runId: UUID!): PipelineRunState
  """Run history for a pipeline, newest first."""
  runs(limit: Int = 50, offset: Int = 0, pipelineId: UUID!): [PipelineHistoryRun!]!
  """Node secrets' metadata (names + timestamps; never values)."""
  secrets: [PipelineSecret!]!
  """
  Reusable named object shapes — first-class types an Input/Output can reference (as "shape:<name>").
  """
  shapes: [PipelineNamedShape!]!
  """
  The step plan of the triggered pipeline(s) accepting this event — all PENDING; what a dashboard shows before any run exists.
  """
  stepsForTrigger(eventName: String!): [PipelineRunStep!]!
  """
  Every catalogued concrete value type and its domain interfaces/base types — drives Cast targets.
  """
  types: [String!]!
}

"""Pipeline mutation operations."""
type PipelinesMutation {
  """
  Grant a group an action (e.g. EXECUTE) on a pipeline — gates its non-public REST endpoint.
  """
  addPermission(permission: PermissionInput!): Boolean!
  """
  Bulk-export pipelines to a PIPELINE_PROJECT Git repository. Each entry is linked to its
  target gitPath and then pushed; the operation commits one YAML file per entry. Entries
  that fail do not stop the others.
  """
  backfill(
    """Commit author email (shown in Git history)."""
    authorEmail: String!
    """Commit author name (shown in Git history)."""
    authorName: String!
    """The pipelines to serialize and commit."""
    entries: [PipelineBackfillEntryInput!]!
    """The target PIPELINE_PROJECT repository."""
    repositoryId: UUID!
  ): PipelineRepoSyncResult!
  """
  Cancel an in-flight (running or suspended) durable run; a later resume for it is ignored.
  """
  cancelRun(runId: UUID!): Boolean!
  """
  Clone a pipeline: a full copy of the graph, named '… (copy)', created inactive.
  """
  clone(id: UUID!): Pipeline!
  """Soft-delete a pipeline by id."""
  delete(id: UUID!): Boolean!
  """Revoke a previously granted group action on a pipeline."""
  deletePermission(permission: PermissionInput!): Boolean!
  """
  Remove a terminal run (e.g. a dead-lettered failure) from the queue and run views by soft-deleting it. False when the run is missing or still in-flight (cancel it first).
  """
  deleteRun(runId: UUID!): Boolean!
  """Delete a node secret by name."""
  deleteSecret(name: String!): Boolean!
  """Delete a named object shape by name."""
  deleteShape(name: String!): Boolean!
  """
  Dry-run a pipeline: traverse the graph, execute NO actions. The payload is decoded as the
  typed event (eventType, defaulting to the pipeline's accepted type) — or validated against
  the input schema and passed through for JSON-input pipelines, where eventType is omitted.
  """
  dryRun(eventType: String, id: UUID!, payload: JSON!): PipelineDryRun!
  """
  Supply the value a Wait for Input node is parked on and resume the run with it as that node's output. Authorized by the pipeline's EXECUTE permission. Approvals, forms, and chosen options all use this.
  """
  provideInput(input: JSON!, nodeId: String!, runId: UUID!): Boolean!
  """
  Decide an Approval Gate: approved resumes the run with the gate's inbound value flowing on unchanged; rejected fails the run at the gate (with the note).
  """
  resolveGate(approved: Boolean!, nodeId: String!, note: String, runId: UUID!): Boolean!
  """
  Restart a dead-lettered (failed) run: re-run from its seed input against the current pipeline. Null if the source run is gone.
  """
  restartRun(runId: UUID!): PipelineRunState
  """
  Run a pipeline now, inline, FOR REAL — action nodes execute their side effects. The payload
  is the pipeline's input (validated against the input schema for JSON-input pipelines, or
  decoded as the accepted event type). Runs under the caller's principal and is recorded in
  run history as a "manual" run.
  """
  run(id: UUID!, payload: JSON!): PipelineRunResult!
  """
  Create or update a pipeline (optimistic-locked by version). When the pipeline is
  Git-linked and authorName/authorEmail are provided, the saved pipeline is serialized
  to its YAML file and committed (best-effort — a push failure is recorded as
  lastSyncError on the pipeline but does not fail the save).
  """
  save(
    """
    Commit author email for the Git push (only used when the pipeline is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the pipeline is Git-linked).
    """
    authorName: String
    input: PipelineInput!
  ): Pipeline!
  """
  Create or replace a reusable named object shape from its typed fields (a JSON array of { name, type }).
  """
  saveShape(fields: JSON!, name: String!): PipelineNamedShape!
  """
  Create or replace a node secret; the value is encrypted at rest and never returned.
  """
  setSecret(name: String!, value: String!): PipelineSecret!
}

"""Subscription-plan-specific behavior."""
union PlanConfiguration = StandardPlanConfiguration

"""Creates a subscription plan group."""
input PlanGroupInput {
  description: String = ""
  key: String!
  name: String!
  paymentRetries: Int! = 3
  storeId: UUID!
}

"""
Creates a subscription plan. configuration is the polymorphic PlanConfiguration as JSON.
"""
input PlanInput {
  configuration: JSON
  description: String = ""
  interval: Int!
  intervalUnit: IntervalUnit!
  key: String!
  name: String!
  planGroupId: UUID!
  price: Money!
  storeId: UUID!
}

"""Whether a plan accepts new subscriptions."""
enum PlanStatus {
  ACTIVE
  DELETED
  INACTIVE
}

"""Subscription plan administration. Admin."""
type PlansMutation {
  """Create a plan group."""
  addGroup(input: PlanGroupInput!): SubscriptionPlanGroup!
  """Create a plan within a group."""
  addPlan(input: PlanInput!): SubscriptionPlan!
}

"""The operating system or runtime environment of a registered device."""
enum PlatformType {
  """Android mobile device."""
  ANDROID
  """Desktop application."""
  DESKTOP
  """Apple iOS mobile device."""
  IOS
  """Web browser."""
  WEB
}

"""CLDR plural category for plural translation rows"""
enum PluralCategory {
  FEW
  MANY
  ONE
  OTHER
  TWO
  ZERO
}

"""
Query operations for introspecting the PostgreSQL database's operational state.
"""
type PostgresAdmin {
  """Retrieve currently active queries running on the database."""
  activeQueries(
    """Minimum duration in seconds to filter queries by (default: show all)."""
    minDurationSeconds: Float
  ): [PgActiveQuery!]!
  """
  Retrieve tables with the highest bloat ratios (dead tuples relative to live tuples).
  """
  bloatedTables(
    """Minimum bloat ratio percentage to include (default: 10)."""
    minBloatPercent: Float
  ): [PgTableStats!]!
  """
  Retrieve blocking query chains showing which backends are blocking other backends.
  """
  blockingChains: [PgBlockingChain!]!
  """
  Retrieve background writer and checkpoint statistics for monitoring I/O behavior.
  """
  checkpointStats: PgCheckpointStats!
  """Retrieve application connection pool statistics."""
  connectionPoolStats: [PgConnectionPoolStats!]!
  """
  Retrieve the largest database objects ranked by total size for storage analysis.
  """
  databaseSizeBreakdown(
    """Maximum number of objects to return (default: 50)."""
    limit: Int
  ): [PgObjectSize!]!
  """
  Retrieve overall database statistics including transaction counts, I/O, and cache performance.
  """
  databaseStats: PgDatabaseStats!
  """Retrieve per-index statistics including scan counts and sizes."""
  indexStats(
    """Filter to a specific schema (default: all non-system schemas)."""
    schemaName: String
  ): [PgIndexStats!]!
  """
  Identify tables that could benefit from additional indexes based on sequential scan patterns.
  """
  indexSuggestions(
    """Minimum number of sequential scans to consider (default: 50)."""
    minSeqScans: Long
  ): [PgIndexSuggestion!]!
  """Retrieve all installed PostgreSQL extensions with version information."""
  installedExtensions: [PgExtension!]!
  """Whether this PostgreSQL server is running as a standby replica."""
  isInRecovery: Boolean!
  """
  Retrieve current lock information including blocked and blocking queries.
  """
  locks: [PgLockInfo!]!
  """
  Retrieve long-running transactions, particularly idle-in-transaction sessions holding locks.
  """
  longRunningTransactions(
    """Minimum transaction duration in seconds to include (default: 60)."""
    minDurationSeconds: Float
  ): [PgLongTransaction!]!
  """
  Retrieve PgBouncer connection pooler status. Returns available=false when PgBouncer is not in the connection path.
  """
  pgBouncerInfo: PgBouncerInfo!
  """Retrieve replication slot information."""
  replicationSlots: [PgReplicationSlot!]!
  """
  Retrieve streaming replication status for all connected standby servers.
  """
  replicationStatus: [PgReplicationStatus!]!
  """
  Retrieve sequence utilization information to detect sequences approaching exhaustion.
  """
  sequenceUsage(
    """Minimum percentage used to include (default: 0, show all)."""
    minPercentUsed: Float
  ): [PgSequenceUsage!]!
  """Retrieve the PostgreSQL server version string."""
  serverVersion: String!
  """Retrieve important PostgreSQL server configuration settings."""
  settings(
    """Filter settings by category or name pattern."""
    filter: String
  ): [PgSetting!]!
  """
  Retrieve the slowest queries by total execution time (requires pg_stat_statements extension).
  """
  slowQueries(
    """Maximum number of slow queries to return (default 20)."""
    limit: Int
    """Order by total time or mean time (default: total)."""
    orderBy: String
  ): [PgSlowQuery!]!
  """Retrieve per-table I/O statistics showing disk reads vs cache hits."""
  tableIOStats(
    """Filter to a specific schema (default: all non-system schemas)."""
    schemaName: String
  ): [PgTableIOStats!]!
  """
  Retrieve per-table statistics including row counts, scan types, and maintenance history.
  """
  tableStats(
    """Filter to a specific schema (default: all non-system schemas)."""
    schemaName: String
  ): [PgTableStats!]!
  """
  Retrieve unused or redundant indexes that may be candidates for removal.
  """
  unusedIndexes(
    """Minimum table size in bytes to consider (default: 0)."""
    minTableSize: Long
  ): [PgIndexStats!]!
  """Retrieve the server uptime as a human-readable string."""
  uptime: String!
  """Retrieve currently running vacuum operations and their progress."""
  vacuumProgress: [PgVacuumProgress!]!
  """
  Retrieve Write-Ahead Log statistics for monitoring WAL generation throughput and buffer efficiency.
  """
  walStats: PgWalStats!
}

"""Mutation operations for PostgreSQL database administration."""
type PostgresAdminMutation {
  """Run ANALYZE on a specific table to update query planner statistics."""
  analyzeTable(
    """The schema containing the table."""
    schemaName: String!
    """The name of the table to analyze."""
    tableName: String!
  ): Boolean!
  """
  Cancel a running query by backend process ID. Returns true if the cancel signal was sent.
  """
  cancelQuery(
    """The process ID of the backend to cancel."""
    pid: Int!
  ): Boolean!
  """
  Rebuild an index to reclaim bloated space and restore optimal performance.
  """
  reindex(
    """The name of the index to rebuild."""
    indexName: String!
    """The schema containing the index."""
    schemaName: String!
  ): Boolean!
  """
  Reset the pg_stat_statements statistics counters (requires pg_stat_statements extension).
  """
  resetStatStatements: Boolean!
  """
  Terminate a backend process by process ID. Returns true if the terminate signal was sent.
  """
  terminateBackend(
    """The process ID of the backend to terminate."""
    pid: Int!
  ): Boolean!
  """Run VACUUM on a specific table to reclaim storage from dead tuples."""
  vacuumTable(
    """
    Whether to perform a VACUUM FULL (rewrites entire table, requires exclusive lock). Default: false.
    """
    full: Boolean
    """The schema containing the table."""
    schemaName: String!
    """The name of the table to vacuum."""
    tableName: String!
  ): Boolean!
}

"""A record of a user who has prayed for a prayer request"""
type PrayedByEntry {
  """Timestamp when the user marked this prayer as prayed"""
  prayedAt: DateTime!
  """The full user profile of the person who prayed"""
  profile: Profile!
  """ID of the user who prayed"""
  profileId: UUID!
}

"""
A prayer request submitted by a community member, with lifecycle tracking and moderation support
"""
type Prayer {
  """Anniversary milestones posted for this prayer"""
  anniversaries: [PrayerAnniversary!]!
  """
  Timestamp when this prayer was marked as answered, null if not yet answered
  """
  answeredAt: DateTime
  """Custom attributes associated with this prayer as a JSON object"""
  attributes: JSON
  """Number of comments on this prayer"""
  commentCount: Int!
  """Top-level comments on this prayer, ordered by newest first"""
  comments(limit: Int, offset: Int): [PrayerComment!]!
  """Structured content of the prayer request as a JSON object"""
  content: JSON!
  """Timestamp when this prayer was created"""
  created: DateTime!
  """Unique identifier for this prayer request"""
  id: UUID!
  """
  Timestamp of the most recent activity (create, prayed, liked, commented, status change)
  """
  lastActivityAt: DateTime!
  """Number of users who have liked this prayer"""
  likeCount: Int!
  """Whether the current authenticated user has liked this prayer"""
  likedByMe: Boolean!
  """Paginated list of users who have liked this prayer (face pile)"""
  likes(limit: Int, offset: Int): [PrayerLike!]!
  """Timestamp when this prayer was last modified"""
  modified: DateTime!
  """Paginated list of users who have prayed for this request"""
  prayedBy(limit: Int, offset: Int): [PrayedByEntry!]!
  """Whether the current authenticated user has prayed for this request"""
  prayedByMe: Boolean!
  """Number of users who have marked this prayer as prayed"""
  prayerActionCount: Int!
  """The full user profile of the prayer submitter"""
  profile: Profile!
  """ID of the user profile that submitted this prayer"""
  profileId: UUID!
  """Profiles this prayer has been shared with (visible to owner only)"""
  shares: [PrayerShare!]!
  """Current lifecycle status of this prayer request"""
  status: PrayerStatus!
  """Whether anniversary cards are suppressed for this prayer"""
  suppressAnniversaries: Boolean!
  """Display title of the prayer request"""
  title: String!
}

"""A milestone anniversary for an answered prayer (Praise & Celebration)"""
type PrayerAnniversary {
  """The milestone label (e.g. 3_months, 1_year, 2_years)"""
  milestone: String!
  """Timestamp when this anniversary was posted"""
  postedAt: DateTime!
  """The original prayer"""
  prayer: Prayer
  """ID of the prayer this anniversary belongs to"""
  prayerId: UUID!
}

"""A comment on a prayer request, supporting threaded replies"""
type PrayerComment {
  """Custom attributes associated with this comment as a JSON object"""
  attributes: JSON
  """The comment text content"""
  content: String!
  """Timestamp when this comment was created"""
  created: DateTime!
  """Unique identifier for this comment"""
  id: Long!
  """ID of the parent comment if this is a reply, null for top-level"""
  parentId: Long
  """ID of the prayer this comment belongs to"""
  prayerId: UUID!
  """The full user profile of the commenter"""
  profile: Profile!
  """ID of the user who wrote this comment"""
  profileId: UUID!
  """Replies to this comment, ordered oldest first"""
  replies(limit: Int, offset: Int): [PrayerComment!]!
}

"""A record of a user who has liked a prayer request"""
type PrayerLike {
  """Timestamp when the user liked this prayer"""
  likedAt: DateTime!
  """The full user profile of the person who liked"""
  profile: Profile!
  """ID of the user who liked"""
  profileId: UUID!
}

"""A record of a prayer being shared with a specific profile"""
type PrayerShare {
  """The full user profile of the person"""
  profile: Profile!
  """ID of the profile this prayer was shared with"""
  profileId: UUID!
  """Timestamp when the prayer was shared"""
  sharedAt: DateTime!
}

"""The lifecycle status of a prayer request"""
enum PrayerStatus {
  """The prayer is currently active and visible to group members"""
  ACTIVE
  """The prayer has been marked as answered"""
  ANSWERED
  """The prayer has been blocked by a moderator"""
  BLOCKED
  """The prayer was cancelled by the submitter"""
  CANCELLED
  """The prayer is pending initial review or action"""
  PENDING
  """The prayer is awaiting moderator approval before becoming visible"""
  PENDING_APPROVAL
}

"""Paginated container for listing prayer requests with a total count"""
type Prayers {
  """The prayer requests for the current page"""
  prayers: [Prayer!]!
  """Total number of prayer requests matching the filter"""
  total: Long!
}

"""
A real-time event payload delivered when a user's presence status changes
"""
type PresenceUpdateEvent {
  """ID of the user profile whose presence changed"""
  profileId: UUID!
  """The new presence status (e.g. 'online', 'away', 'offline')"""
  status: String!
}

"""
A principal represents an authenticated user account in the system. Principals have credentials for login, belong to security groups for authorization, and own one or more user profiles.
"""
type Principal {
  """
  Whether this principal is an anonymous (unauthenticated guest) identity rather than a registered account
  """
  anonymous: Boolean!
  """
  Principal attributes, visible only to the principal or a system administrator
  """
  attributes: JSON
  """Timestamp of when this principal was created"""
  created: DateTime!
  """List of authentication credentials associated with this principal"""
  credentials: [PrincipalCredential!]!
  """
  When this principal was soft-deleted by an administrator, or null if active. A soft-deleted principal is blocked from authenticating until restored, and is excluded from listings unless includeDeleted is set.
  """
  deletedAt: DateTime
  """
  Security groups this principal belongs to, determining their permissions
  """
  groups: [Group!]!
  """Unique identifier for this principal"""
  id: UUID!
  """
  Timestamp of the principal's most recent login, null if never logged in
  """
  lastLogin: DateTime
  """
  Successful interactive authentications for this principal, newest first. Visible only to the principal or a system administrator.
  """
  loginHistory(limit: Int! = 25, offset: Long! = 0): [PrincipalLogin!]!
  """Timestamp of when this principal was last modified"""
  modified: DateTime!
  """ID of the primary user profile for this principal, null if not set"""
  primaryProfileId: UUID
  """User profiles owned by this principal"""
  profiles: [Profile!]!
  """Whether this principal's email or identity has been verified"""
  verified: Boolean!
}

"""
An authentication credential associated with a principal, used for login
"""
type PrincipalCredential {
  """The login identifier (e.g. email address or username)"""
  identifier: String!
  """
  The last originator: the client/app of the most recent login using this credential; null when none
  """
  lastOriginator: String
  """
  The original originator: the client/app the credential was first created from; null when none
  """
  originator: String
  """OAuth provider key, or null for non-OAuth credentials"""
  provider: String
  """The type of credential (OAuth2, password, or scrypt password)"""
  type: CredentialType!
}

"""One successful interactive authentication for a principal."""
type PrincipalLogin {
  """When the authentication succeeded."""
  created: DateTime!
  """
  Whether this history entry represents the login making the current request.
  """
  current: Boolean!
  """Stable identifier for this history entry."""
  id: Long!
  """The authentication proof that minted the login."""
  method: String!
  """When this login was explicitly revoked."""
  revokedAt: DateTime
}

"""
Mutation operations for managing the current principal's credentials and profile settings
"""
type PrincipalMutation {
  """
  Remove the primary profile association from a principal. If principalId is omitted, applies to the current principal.
  """
  clearPrimaryProfile(principalId: UUID): Boolean!
  """
  Add or update a login identifier with a password for the current principal
  """
  identifier(identifier: String!, password: String!): Boolean!
  """
  Change the current principal's password. Provide identifier to target a specific credential.
  """
  password(identifier: String, newPassword: String!, oldPassword: String!): Boolean!
  """
  Revoke one of the current principal's recorded sign-ins without affecting any other login.
  """
  revokeLogin(loginId: Long!): Boolean!
  """
  Set the primary profile for a principal. If principalId is omitted, applies to the current principal.
  """
  setPrimaryProfile(principalId: UUID, profileId: UUID!): Boolean!
}

"""Query operations for listing and accessing principals (user accounts)"""
type Principals {
  """
  Paginated list of all principals in the system. Soft-deleted principals are excluded unless includeDeleted is true.
  """
  all(includeDeleted: Boolean! = false, limit: Int!, offset: Long!): [Principal!]!
  """The currently authenticated principal"""
  current: Principal!
  """
  Retrieve a specific principal by their unique identifier. Returns null if not found.
  """
  principal(id: UUID!): Principal
}

"""
The commerce identity of a thing that can be sold. Name, description, and all merchandising content
live on the linked content Metadata document — this row carries only commerce facts. Pricing lives
on CatalogProduct entries.
"""
type Product {
  company: Company!
  """Type-specific behavior configuration (sealed ProductConfiguration)."""
  configuration: ProductConfiguration!
  created: DateTime!
  height: Float!
  id: UUID!
  """Inventory across fulfillment centers. Admin."""
  inventory: [Inventory!]!
  length: Float!
  manufacturer: Manufacturer!
  """The manufacturer's SKU, unique per manufacturer."""
  manufacturerSku: String!
  """
  The backing content document, resolved at the PINNED version. The pin advances automatically when
  a new version of the document is published through the content workflow — drafts never appear here.
  """
  metadata: Metadata!
  """
  The pinned content version currently live on storefronts (advances on content publish).
  """
  metadataVersion: Int!
  modified: DateTime!
  type: ProductType!
  """
  Shipping weight; intrinsic to the product (used by shipping-rate calculation).
  """
  weight: Float!
  """
  Shipping dimensions (unitless; 0 = unknown). Used by the packer to box for density.
  """
  width: Float!
}

"""Type-specific product behavior."""
union ProductConfiguration = ClothingProductConfiguration | StandardProductConfiguration | SubscriptionProductConfiguration

"""
Creates or edits a product. title/description seed the backing content Metadata document on create;
afterwards content is edited and published through the content module, and the product's pinned
version follows the publish automatically.
"""
input ProductInput {
  companyId: UUID!
  """
  Type-specific behavior configuration (sealed ProductConfiguration; SubscriptionProductConfiguration for SUBSCRIPTION products).
  """
  configuration: JSON = null
  """Initial description for the backing content document."""
  description: String = null
  height: Float! = 0
  length: Float! = 0
  manufacturerId: UUID!
  """The manufacturer's SKU, unique per manufacturer."""
  manufacturerSku: String!
  """Title for the backing content document."""
  title: String!
  type: ProductType!
  """Shipping weight; intrinsic to the product."""
  weight: Float! = 1
  """
  Shipping dimensions (unitless; 0 = unknown). Used by the packer to box for density.
  """
  width: Float! = 0
}

"""
Mutations scoped to one product. Admin. There is deliberately no publish-content mutation here:
publishing happens in the content module's own workflow, and the product's pinned metadataVersion
follows the publish automatically (audited).
"""
type ProductMutation {
  """Soft-delete the product and unpublish its content Metadata together."""
  delete: Boolean!
  """Edit the product's commerce fields and configuration."""
  edit(input: ProductInput!): Product!
}

"""
What kind of thing a product is, which drives fulfillment behavior: PHYSICAL ships from inventory,
VIRTUAL/SERVICE need no fulfillment, SHIPPING is the synthetic line item carrying shipping charges,
PROMOTION is a synthetic discount-bearing item, SUBSCRIPTION creates a recurring purchase at
checkout (its SubscriptionProductConfiguration binds a plan group).
"""
enum ProductType {
  PHYSICAL
  PROMOTION
  SERVICE
  SHIPPING
  SUBSCRIPTION
  VIRTUAL
}

"""Product creates and per-product operations. Admin."""
type ProductsMutation {
  """
  Create a product and its backing content Metadata document (pinned at version 1).
  """
  add(input: ProductInput!): Product!
  """Operations on an existing product."""
  product(id: UUID!): ProductMutation!
}

"""
A user profile containing identity information, attributes, bookmarks, content marks, guide progress, ratings, and organization memberships.
"""
type Profile {
  """
  The list of typed attributes associated with this profile, such as interests, demographics, or preferences.
  """
  attributes: [ProfileAttribute!]!
  """
  The bookmarks saved by this profile, referencing collections or metadata items.
  """
  bookmarks: ProfileBookmarks!
  """Access the user's chat channel memberships"""
  chat: ProfileChat
  """
  The personal collection associated with this profile, if one has been created.
  """
  collection: Collection
  """Access the user's community memberships including groups and channels"""
  community: ProfileCommunity
  """The timestamp when this profile was created."""
  created: DateTime!
  """
  When this profile was soft-deleted by an administrator, or null if active. A soft-deleted profile is excluded from the search index on its next reindex.
  """
  deletedAt: DateTime
  """
  The guide progress and history for this profile, tracking completion of guided content.
  """
  guides: ProfileGuides!
  """The unique identifier of the profile."""
  id: UUID!
  """
  Pending relationship requests sent to this profile. Only callers who manage this profile may view them.
  """
  incomingRelationshipRequests(limit: Int, offset: Long, type: String): [ProfileRelationshipRequest!]!
  """
  Whether this is the primary profile for the associated principal. A principal can have multiple profiles but only one primary.
  """
  isPrimary: Boolean!
  """
  The timestamp of the last login by the principal associated with this profile.
  """
  lastLogin: DateTime
  """
  The marks (highlights and annotations) created by this profile on content items.
  """
  marks: ProfileMarks!
  """The list of metadata comment IDs that this profile has liked."""
  metadataCommentLikeIds: [Long!]!
  """The timestamp when this profile was last modified."""
  modified: DateTime!
  """The display name of the profile."""
  name: String!
  """The list of organizations this profile is a member of."""
  organizations: [Organization!]!
  """
  Pending relationship requests sent by this profile. Only callers who manage this profile may view them.
  """
  outgoingRelationshipRequests(limit: Int, offset: Long, type: String): [ProfileRelationshipRequest!]!
  """
  The principal (authenticated user identity) associated with this profile. Null if the profile is not linked to a principal.
  """
  principal: Principal
  """The ratings given by this profile to content items."""
  ratings: ProfileRatings!
  """
  Relationships originating from this profile, optionally filtered and paginated.
  """
  relationships(
    """
    The maximum number of relationships to return. If null, returns all remaining relationships.
    """
    limit: Int
    """
    The zero-based relationship offset. If null, starts at the first relationship.
    """
    offset: Long
    """
    The relationship type to filter by (e.g. 'friend', 'follower'). If null, returns all relationship types.
    """
    type: String
  ): [ProfileRelationship!]!
  """
  Whether this profile may appear in profile search. Visibility rules still apply.
  """
  searchable: Boolean!
  """A URL-friendly slug identifier for the profile."""
  slug: String
  """Third-party integration extension data for this profile."""
  thirdparty: ThirdPartyExtension
  """
  The type classification of this profile (GENERIC, ORGANIZATION, or CHILD).
  """
  type: ProfileType!
  """
  The visibility level that controls who can discover and view this profile.
  """
  visibility: ProfileVisibility!
}

"""
A typed attribute associated with a profile, storing structured data such as interests, demographics, or preferences with confidence scoring and visibility controls.
"""
type ProfileAttribute {
  """
  The attribute value stored as JSON. The structure depends on the attribute type.
  """
  attributes: JSON
  """
  A confidence score (0-100) indicating how reliable or accurate this attribute value is.
  """
  confidence: Int!
  """The date and time when this attribute was created."""
  created: DateTime!
  """
  The date and time when this attribute expires and should no longer be considered valid.
  """
  expires: DateTime
  """The unique identifier of this profile attribute instance."""
  id: UUID!
  """
  The metadata item linked to this attribute, if any. Provides additional context or content.
  """
  metadata: Metadata
  """
  The priority of this attribute relative to other attributes of the same type. Higher values take precedence.
  """
  priority: Int!
  """
  The source system or process that provided this attribute value (e.g. 'user-input', 'ai-inference', 'import').
  """
  source: String!
  """
  The resolved attribute type definition containing the name, description, and configuration of this attribute's type.
  """
  type: ProfileAttributeType!
  """
  The identifier of the attribute type that defines the schema and semantics of this attribute.
  """
  typeId: String!
  """
  How control was proven once verified (e.g. 'email', 'google'), or null if not yet verified.
  """
  verificationSource: String
  """
  Whether control of this attribute's value (e.g. an email address) has been proven. Server-set only.
  """
  verified: Boolean!
  """The visibility level that controls who can see this attribute."""
  visibility: ProfileVisibility!
}

"""
Input for creating or updating a profile attribute, which stores typed key-value data associated with a profile.
"""
input ProfileAttributeInput {
  """
  The attribute value stored as JSON. The structure depends on the attribute type.
  """
  attributes: JSON
  """
  A confidence score (0-100) indicating how reliable or accurate this attribute value is.
  """
  confidence: Int!
  """
  The date and time when this attribute expires and should no longer be considered valid.
  """
  expiration: DateTime
  """
  The UUID of an existing attribute to update. Null when creating a new attribute.
  """
  id: UUID
  """
  The UUID of a metadata item linked to this attribute, providing additional context or content.
  """
  metadataId: UUID
  """
  The UUID of a supplementary metadata item associated with this attribute.
  """
  metadataSupplementary: UUID
  """
  The priority of this attribute relative to other attributes of the same type. Higher values take precedence.
  """
  priority: Int!
  """
  The source system or process that provided this attribute value (e.g. 'user-input', 'ai-inference', 'import').
  """
  source: String!
  """
  The identifier of the attribute type that defines the schema and semantics of this attribute.
  """
  typeId: String!
  """The visibility level that controls who can see this attribute."""
  visibility: ProfileVisibility!
}

"""
A type definition for profile attributes, defining the schema, name, and access controls for a category of profile attributes.
"""
type ProfileAttributeType {
  """
  A description of what this attribute type represents and how it should be used.
  """
  description: String!
  """
  The resolved form schema linked to this attribute type, providing JSON Schema validation and UI Schema for rendering.
  """
  formSchema: FormSchema
  """
  The UUID of the form schema linked to this attribute type, used to render a structured form for data entry.
  """
  formSchemaId: UUID
  """
  The unique string identifier for this attribute type (e.g. 'interests', 'demographics').
  """
  id: String!
  """The human-readable display name of this attribute type."""
  name: String!
  """
  Whether this attribute type is protected from modification by regular users. Protected types can only be managed by administrators.
  """
  protected: Boolean!
  """The default visibility level for attributes of this type."""
  visibility: ProfileVisibility!
}

"""
Input for creating or updating a profile attribute type definition, which defines the schema for a category of profile attributes.
"""
input ProfileAttributeTypeInput {
  """
  A description of what this attribute type represents and how it should be used.
  """
  description: String!
  """
  The UUID of a form schema to link to this attribute type, providing structured form rendering for data entry.
  """
  formSchemaId: UUID
  """
  The unique string identifier for this attribute type (e.g. 'interests', 'demographics').
  """
  id: String!
  """The human-readable display name of this attribute type."""
  name: String!
  """
  Whether this attribute type is protected from modification by regular users. Protected types can only be managed by administrators.
  """
  protected: Boolean!
  """The default visibility level for attributes of this type."""
  visibility: ProfileVisibility!
}

"""
Container for querying all available profile attribute type definitions.
"""
type ProfileAttributeTypes {
  """Retrieve all registered profile attribute type definitions."""
  all: [ProfileAttributeType!]!
}

"""
A bookmark saved by a profile, referencing a collection or metadata item for quick access.
"""
type ProfileBookmark {
  """
  Custom attributes stored as JSON associated with this bookmark (e.g. notes, tags).
  """
  attributes: JSON
  """The bookmarked collection, if this bookmark references a collection."""
  collection: Collection
  """The timestamp when this bookmark was created."""
  created: DateTime!
  """The unique integer identifier of this bookmark."""
  id: Int!
  """
  The bookmarked metadata item, if this bookmark references a metadata item.
  """
  metadata: Metadata
}

"""
Container for querying a profile's bookmarks, supporting lookup by content reference and paginated listing.
"""
type ProfileBookmarks {
  """
  Retrieve a specific bookmark by the referenced collection or metadata item.
  """
  bookmark(
    """The UUID of the bookmarked collection to look up."""
    collectionId: UUID
    """The UUID of the bookmarked metadata item to look up."""
    metadataId: UUID
    """The version of the bookmarked metadata item."""
    metadataVersion: Int
  ): ProfileBookmark
  """Retrieve a paginated list of all bookmarks for this profile."""
  bookmarks(
    """The maximum number of bookmarks to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
  ): [ProfileBookmark!]!
  """The total number of bookmarks for this profile."""
  count: Int!
}

"""A profile's chat memberships, providing access to their channels"""
type ProfileChat {
  """List of chat channels the user is a member of"""
  channels: [ChatChannel!]!
  """Pending invitations addressed to this profile"""
  incomingInvitations(limit: Int, offset: Long): [ChatChannelInvitation!]!
  """Pending invitations sent by this profile"""
  outgoingInvitations(limit: Int, offset: Long): [ChatChannelInvitation!]!
}

"""
A user profile's community memberships, providing access to their groups and channels
"""
type ProfileCommunity {
  """List of chat channels the user is a member of"""
  channels: [ChatChannel!]!
  """List of community groups the user belongs to"""
  groups: [CommunityGroup!]!
  """
  Aggregated prayer feed across the user's community groups, optionally filtered by group and/or status
  """
  prayers(groupIds: [UUID!], limit: Int, offset: Int, status: [PrayerStatus!]): Prayers!
  """Prayers that have been explicitly shared with this user"""
  sharedPrayers(limit: Int, offset: Int): Prayers!
}

"""
Container for querying a profile's guide completion history, including past completions and per-guide history.
"""
type ProfileGuideHistories {
  """
  Retrieve a paginated list of all guide completion history entries for this profile.
  """
  all(
    """The maximum number of history entries to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [ProfileGuideHistory!]!
  """The total number of guide completion history entries for this profile."""
  count: Int!
  """
  Retrieve the completion history for a specific guide by its identifier and version.
  """
  history(
    """The string identifier of the guide to retrieve history for."""
    id: String!
    """The maximum number of history entries to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
    """The version of the guide to retrieve history for."""
    version: Int!
  ): [ProfileGuideHistory!]!
  """
  The total number of completion history entries for a specific guide and version.
  """
  historyCount(
    """The string identifier of the guide."""
    id: String!
    """The version of the guide."""
    version: Int!
  ): Int!
}

"""
A record of a profile's completion of a guide, including the completion timestamp and any associated attributes.
"""
type ProfileGuideHistory {
  """
  Custom attributes stored as JSON associated with this guide completion (e.g. score, answers).
  """
  attributes: JSON!
  """
  The timestamp when the guide was completed. Null if the guide was started but not yet completed.
  """
  completed: DateTime
  """The metadata item representing the guide that was completed."""
  metadata: Metadata!
}

"""
The current progress of a profile through a guided content experience, tracking completed steps and overall percentage.
"""
type ProfileGuideProgress {
  """
  Custom attributes stored as JSON associated with the current progress (e.g. answers, state data).
  """
  attributes: JSON!
  """The list of step IDs that the profile has completed in this guide."""
  completedStepIds: [Long!]!
  """The guide structure for the exact version this progression started."""
  guide: Guide
  """
  All marks the profile has placed on any of the guide's step metadata items, enabling bulk retrieval of per-step annotations (e.g. video watch progress) in a single query.
  """
  marks: [ProfileMark!]!
  """The metadata item representing the guide being progressed through."""
  metadata: Metadata
  """The timestamp when the progress was last updated."""
  modified: DateTime!
  """
  The ID of the next step the profile should complete. Null if all steps are completed.
  """
  nextStepId: Long
  """The completion percentage of the guide (0.0 to 100.0)."""
  percentage: Float!
  """The timestamp when the profile started this guide."""
  started: DateTime!
  """The guide version this progression started."""
  version: Int!
}

"""
Container for querying a profile's active guide progressions, supporting listing and per-guide lookup.
"""
type ProfileGuideProgressions {
  """
  Retrieve a paginated list of all active guide progressions for this profile.
  """
  all(
    """The maximum number of progressions to return."""
    limit: Int!
    """
    Limit progressions to one guide metadata item while retaining all matching versions.
    """
    metadataId: UUID
    """The zero-based offset for pagination."""
    offset: Long!
  ): [ProfileGuideProgress!]!
  """The total number of active guide progressions for this profile."""
  count(
    """
    Limit the count to one guide metadata item while retaining all matching versions.
    """
    metadataId: UUID
  ): Long!
  """
  Retrieve the current progress for a specific guide by its metadata UUID and version.
  """
  progress(
    """The UUID of the guide's metadata item."""
    id: UUID!
    """The version of the guide."""
    version: Int!
  ): ProfileGuideProgress
}

"""
Container for accessing a profile's guide-related data, including completion history and active progressions.
"""
type ProfileGuides {
  """The guide completion history for this profile."""
  history: ProfileGuideHistories!
  """The active guide progressions for this profile."""
  progressions: ProfileGuideProgressions!
}

"""
Input for creating or updating a user profile with a name, URL slug, attributes, and visibility setting.
"""
input ProfileInput {
  """The list of profile attributes to set on the profile."""
  attributes: [ProfileAttributeInput!]!
  """The display name of the profile."""
  name: String!
  """
  Whether this profile may appear in profile search. If omitted while editing, the current setting is preserved.
  """
  searchable: Boolean
  """
  A URL-friendly slug identifier for the profile. Used in URLs and as a human-readable identifier.
  """
  slug: String
  """
  The visibility level that controls who can discover and view this profile.
  """
  visibility: ProfileVisibility!
}

"""
A mark (highlight or annotation) created by a profile on a content item, used to save notable passages or add notes.
"""
type ProfileMark {
  """
  Custom attributes stored as JSON associated with this mark (e.g. highlighted text, notes, color).
  """
  attributes: JSON
  """The collection containing the marked content, if applicable."""
  collection: Collection
  """The timestamp when this mark was created."""
  created: DateTime!
  """The unique integer identifier of this mark."""
  id: Int!
  """The metadata item that was marked, if applicable."""
  metadata: Metadata
}

"""
Container for querying a profile's marks (highlights and annotations) on content items, supporting filtering and pagination.
"""
type ProfileMarks {
  """Retrieve a paginated list of all marks for this profile."""
  all(
    """The maximum number of marks to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
  ): [ProfileMark!]!
  """The total number of marks created by this profile."""
  count: Long!
  """
  Retrieve marks filtered by a specific collection or metadata item, with pagination.
  """
  mark(
    """The UUID of the collection to filter marks by."""
    collectionId: UUID
    """The maximum number of marks to return."""
    limit: Int!
    """The UUID of the metadata item to filter marks by."""
    metadataId: UUID
    """The version of the metadata item to filter marks by."""
    metadataVersion: Int
    """The zero-based offset for pagination."""
    offset: Long!
  ): [ProfileMark!]!
  """The total number of marks for a specific collection or metadata item."""
  markCount(
    """The UUID of the collection to count marks for."""
    collectionId: UUID
    """The UUID of the metadata item to count marks for."""
    metadataId: UUID
    """The version of the metadata item to count marks for."""
    metadataVersion: Int
  ): Long!
}

"""
Mutation operations for managing a specific profile's bookmarks, marks, guide progress, ratings, and third-party integrations.
"""
type ProfileMutation {
  """
  Add a bookmark to save a reference to a collection or metadata item. Returns true if the bookmark was created successfully.
  """
  addBookmark(
    """Custom attributes stored as JSON to associate with the bookmark."""
    attributes: JSON
    """The UUID of the collection to bookmark."""
    collectionId: UUID
    """The UUID of the metadata item to bookmark."""
    metadataId: UUID
    """
    The UUID of the profile to add the bookmark to. If null, uses the current user's profile.
    """
    profileId: UUID
    """The version of the metadata item to bookmark."""
    version: Int
  ): Boolean!
  """
  Add a mark (highlight or annotation) on a collection or metadata item. Returns true if the mark was created successfully.
  """
  addMark(
    """
    Custom attributes stored as JSON to associate with the mark (e.g. highlighted text, notes).
    """
    attributes: JSON
    """The UUID of the collection to mark."""
    collectionId: UUID
    """The UUID of the metadata item to mark."""
    metadataId: UUID
    """
    The UUID of the profile to add the mark to. If null, uses the current user's profile.
    """
    profileId: UUID
    """The version of the metadata item to mark."""
    version: Int
  ): Boolean!
  """
  Record progress on a guide step. Returns the updated guide progress, or null if the step could not be recorded.
  """
  addProgress(
    """
    Custom attributes stored as JSON to associate with this progress update (e.g. answers, state data).
    """
    attributes: JSON!
    """The UUID of the guide's metadata item."""
    metadataId: UUID!
    """The version of the guide's metadata item."""
    metadataVersion: Int!
    """
    The UUID of the profile to record progress for. If null, uses the current user's profile.
    """
    profileId: UUID
    """The ID of the step that was completed."""
    stepId: Long!
  ): ProfileGuideProgress
  """
  Add a rating to a collection or metadata item. Returns true if the rating was recorded successfully.
  """
  addRating(
    """The UUID of the collection to rate."""
    collectionId: UUID
    """The UUID of the metadata item to rate."""
    metadataId: UUID
    """
    The UUID of the profile to add the rating for. If null, uses the current user's profile.
    """
    profileId: UUID
    """The rating value to assign (typically 1-5)."""
    rating: Int!
    """The version of the metadata item to rate."""
    version: Int
  ): Boolean!
  """
  Delete a profile attribute by its UUID. Returns true if the attribute was successfully deleted.
  """
  deleteAttribute(
    """The UUID of the profile attribute to delete."""
    attributeId: UUID!
  ): Boolean!
  """
  Delete a bookmark by the referenced collection or metadata item. Returns true if the bookmark was successfully deleted.
  """
  deleteBookmark(
    """The UUID of the bookmarked collection."""
    collectionId: UUID
    """The UUID of the bookmarked metadata item."""
    metadataId: UUID
    """
    The UUID of the profile to delete the bookmark from. If null, uses the current user's profile.
    """
    profileId: UUID
    """The version of the bookmarked metadata item."""
    version: Int
  ): Boolean!
  """
  Delete a mark by its unique integer ID. Returns true if the mark was successfully deleted.
  """
  deleteMark(
    """The unique integer ID of the mark to delete."""
    id: Long!
  ): Boolean!
  """
  Remove the current user's progress from a guide, allowing them to withdraw from a guide they previously started. Returns true if the progress was successfully deleted.
  """
  deleteProgress(
    """The UUID of the guide's metadata item."""
    metadataId: UUID!
    """The version of the guide's metadata item."""
    metadataVersion: Int!
    """
    The UUID of the profile to remove progress for. If null, uses the current user's profile.
    """
    profileId: UUID
  ): Boolean!
  """
  Begin (or re-send) verification of a profile attribute (e.g. email) through the generic verification framework: mints a one-time token and delivers the attribute type's challenge to the value being proven. A no-op when the attribute is missing, valueless, or already verified. Returns true once the request has been accepted (delivery is asynchronous).
  """
  requestAttributeVerification(
    """
    The UUID of the profile whose attribute should be verified. If null, uses the current user's profile.
    """
    profileId: UUID
    """The attribute type to verify, e.g. "bosca.profiles.email"."""
    typeId: String!
  ): Boolean!
  """
  Mutation operations for synchronizing with third-party external systems.
  """
  thirdparty: ThirdPartyExtensionMutation
}

"""A rating given by a profile to a content item."""
type ProfileRating {
  """The timestamp when this rating was created."""
  created: DateTime!
  """The unique integer identifier of this rating."""
  id: Int!
  """The rating value (typically 1-5)."""
  rating: Int!
}

"""
Container for querying a profile's ratings on content items, supporting per-item lookup and paginated listing.
"""
type ProfileRatings {
  """The total number of ratings for this profile."""
  count: Long!
  """Retrieve a specific rating for a collection or metadata item."""
  rating(
    """The UUID of the rated collection."""
    collectionId: UUID
    """The UUID of the rated metadata item."""
    metadataId: UUID
    """The version of the rated metadata item."""
    metadataVersion: Int
    """
    The UUID of the profile that made the rating. If null, uses the current user's profile.
    """
    profileId: UUID
  ): ProfileRating
  """Retrieve a paginated list of all ratings for this profile."""
  ratings(
    """The maximum number of ratings to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
    """
    The UUID of the profile to retrieve ratings for. If null, uses the current user's profile.
    """
    profileId: UUID
  ): [ProfileRating!]!
}

"""
A directional relationship from a profile to another profile, representing a connection or association of a specific type (e.g. 'friend', 'follower', 'mentor').
"""
type ProfileRelationship {
  """Custom attributes stored as JSON associated with this relationship."""
  attributes: JSON
  """The profile this relationship links to."""
  profile: Profile!
  """The type of relationship (e.g. 'friend', 'follower', 'mentor')."""
  type: String!
}

"""
A request to establish a directional relationship. Approval creates the actual relationship.
"""
type ProfileRelationshipRequest {
  attributes: JSON
  created: DateTime!
  id: UUID!
  modified: DateTime!
  requester: Profile!
  status: ProfileRelationshipRequestStatus!
  target: Profile!
  type: String!
}

enum ProfileRelationshipRequestStatus {
  APPROVED
  CANCELLED
  DECLINED
  PENDING
}

"""
The classification of a profile, determining its purpose and behavior within the platform.
"""
enum ProfileType {
  """
  A child profile created under a parent profile, typically used for managed or dependent accounts.
  """
  CHILD
  """A standard user profile with full capabilities."""
  GENERIC
  """
  A profile that represents an organization rather than an individual user.
  """
  ORGANIZATION
}

"""
Controls who can discover and view a profile or organization. Visibility levels range from private (USER) to platform-wide (SYSTEM).
"""
enum ProfileVisibility {
  """Visible only to the profile owner's direct friends/connections."""
  FRIENDS
  """
  Visible to the profile owner's friends and their friends (two degrees of separation).
  """
  FRIENDS_OF_FRIENDS
  """Visible to all authenticated users of the platform."""
  PUBLIC
  """
  Visible system-wide, including to internal platform services and administrative processes.
  """
  SYSTEM
  """
  Visible only to the profile owner themselves. The most restrictive visibility level.
  """
  USER
}

"""Query operations for retrieving profiles and attribute types."""
type Profiles {
  """
  Retrieve a paginated list of all profiles the current user has access to.
  """
  all(
    """The maximum number of profiles to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [Profile!]!
  """Access the registry of profile attribute type definitions."""
  attributeTypes: ProfileAttributeTypes!
  """
  Retrieve a paginated list of profiles whose linked principal is a member of the named security group. Used by the collaboration UI to surface every reachable mention target for a group such as 'messaging'.
  """
  byGroup(
    """The maximum number of profiles to return."""
    limit: Int!
    """
    The unique name of the security group to filter profiles by (e.g. 'messaging').
    """
    name: String!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [Profile!]!
  """
  Retrieve the profiles associated with the currently authenticated user. Returns null if no user is authenticated.
  """
  current: [Profile!]
  """Search for profiles by a specific attribute type and value."""
  findProfiles(
    """The attribute key or path to match against."""
    attribute: String!
    """The maximum number of profiles to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
    """The attribute type ID to search within."""
    typeId: String!
    """
    The attribute value to match. If null, matches any value for the given attribute.
    """
    value: String
  ): [Profile!]!
  """
  Retrieve a single profile by its unique identifier. Returns null if the profile does not exist or is not accessible.
  """
  profile(
    """The UUID of the profile to retrieve."""
    id: UUID!
  ): Profile
  """Access Studio persona query operations."""
  studioPersonas: StudioPersonas!
}

"""
Mutation operations for managing profiles, attribute types, collections, and relationships at the administrative level.
"""
type ProfilesMutation {
  """
  Create a new profile. By default, the profile is linked to the currently authenticated user. Set linkToPrincipal to false to create a standalone profile.
  """
  add(
    """
    When false, the profile is created without linking to any principal. Defaults to true.
    """
    linkToPrincipal: Boolean
    """The profile configuration including name, attributes, and visibility."""
    profile: ProfileInput!
  ): Profile
  """
  Register a new profile attribute type definition. Returns true if the type was successfully created.
  """
  addAttributeType(
    """The attribute type definition to register."""
    attribute: ProfileAttributeTypeInput!
  ): Boolean!
  """
  Add one or more attributes to a specific profile. Attributes of a protected type may only be set by administrators; a non-administrator write that includes one fails the whole call. Returns true if the attributes were successfully added.
  """
  addAttributes(
    """The list of attribute values to add to the profile."""
    attributes: [ProfileAttributeInput!]!
    """The UUID of the profile to add attributes to."""
    id: UUID!
  ): Boolean!
  """
  Create a new child profile under the currently authenticated user's primary profile.
  """
  addChild(
    """
    The child profile configuration including name, attributes, and visibility.
    """
    profile: ProfileInput!
  ): Profile
  """
  Create a personal collection for a profile. Returns the newly created collection.
  """
  addCollection(
    """The UUID of the profile to create a collection for."""
    profileId: UUID!
  ): Collection
  """
  Create an approved relationship directly. This operation is restricted to administrators and system services.
  """
  addRelationship(
    """Custom attributes stored as JSON to associate with the relationship."""
    attributes: JSON
    """The UUID of the profile the relationship originates from."""
    sourceProfileId: UUID!
    """The UUID of the profile the relationship links to."""
    targetProfileId: UUID!
    """
    The type of relationship to create (e.g. 'friend', 'follower', 'mentor').
    """
    type: String!
  ): Boolean!
  """
  Approve an incoming pending relationship request and create its relationship.
  """
  approveRelationshipRequest(requestId: UUID!): ProfileRelationshipRequest!
  """Cancel an outgoing pending relationship request."""
  cancelRelationshipRequest(requestId: UUID!): ProfileRelationshipRequest!
  """
  Remove the association between a profile and its owning principal. If the profile is the principal's primary profile, that reference is also cleared. Admin-only operation.
  """
  clearPrincipal(
    """The UUID of the profile to unlink from its principal."""
    id: UUID!
  ): Profile
  """Decline an incoming pending relationship request."""
  declineRelationshipRequest(requestId: UUID!): ProfileRelationshipRequest!
  """
  Permanently delete a profile. The profile MUST already be soft-deleted via markDeleted; this two-stage requirement guards against accidental one-click destruction. Admin-only operation.
  """
  delete(
    """The UUID of the profile to permanently delete."""
    id: UUID!
  ): Boolean!
  """
  Delete a specific attribute from a profile. Returns true if the attribute was successfully deleted.
  """
  deleteAttribute(
    """The UUID of the attribute to delete."""
    attributeId: UUID!
    """
    The UUID of the profile to delete the attribute from. If null, uses the current user's profile.
    """
    id: UUID
  ): Boolean!
  """
  Delete a profile attribute type definition. Returns true if the type was successfully deleted.
  """
  deleteAttributeType(
    """The string identifier of the attribute type to delete."""
    attributeId: String!
  ): Boolean!
  """
  Update an existing profile's name, attributes, and visibility settings.
  """
  edit(
    """
    The UUID of the profile to edit. If null, edits the current user's primary profile.
    """
    id: UUID
    """The updated profile configuration."""
    profile: ProfileInput!
  ): Profile
  """
  Update an existing profile attribute type definition. Returns true if the type was successfully updated.
  """
  editAttributeType(
    """The updated attribute type definition."""
    attribute: ProfileAttributeTypeInput!
  ): Boolean!
  """
  Mark a profile deleted — the reversible staging step before permanent deletion. The profile is excluded from the search index on its next reindex. Admin-only operation.
  """
  markDeleted(
    """The UUID of the profile to mark deleted."""
    id: UUID!
  ): Profile!
  """
  Access mutation operations scoped to the current user's profile (bookmarks, marks, progress, ratings).
  """
  profile: ProfileMutation!
  """
  Remove a relationship between two profiles. Returns true if the relationship was successfully removed.
  """
  removeRelationship(
    """The UUID of the profile the relationship originates from."""
    sourceProfileId: UUID!
    """The UUID of the profile the relationship links to."""
    targetProfileId: UUID!
    """The type of relationship to remove."""
    type: String!
  ): Boolean!
  """
  Request a relationship from a profile the caller manages to a visible target profile.
  """
  requestRelationship(attributes: JSON, requesterProfileId: UUID!, targetProfileId: UUID!, type: String!): ProfileRelationshipRequest!
  """Reverse markDeleted, restoring the profile. Admin-only operation."""
  restore(
    """The UUID of the profile to restore."""
    id: UUID!
  ): Profile!
  """
  Link a security principal to a profile, establishing ownership. Admin-only operation.
  """
  setPrincipal(
    """The UUID of the profile to link."""
    id: UUID!
    """The UUID of the security principal to assign as owner."""
    principalId: UUID!
  ): Profile
  """Access Studio persona mutation operations."""
  studioPersonas: StudioPersonasMutation!
}

input PromoteWorkOpsReleaseInput {
  allowDowngrade: Boolean! = false
  environment: String!
  """
  Values for the promotion trigger's declared inputs, keyed without the inputs. prefix.
  """
  inputs: JSON
}

"""A store promotion, keyed (store, code), active within its window."""
type Promotion {
  code: String!
  created: DateTime!
  ends: DateTime!
  """The window over which the per-account limit is counted."""
  frequencyLimit: FrequencyLimit!
  id: UUID!
  modified: DateTime!
  name: String!
  """Per-account redemption cap over the frequency window; 0 = unlimited."""
  perAccountLimit: Long!
  """The promotion's behavior (polymorphic)."""
  rule: Rule!
  starts: DateTime!
  store: Store!
  type: PromotionType!
}

"""
Creates or edits a promotion. `rule` is the polymorphic rule as JSON with a `type` discriminator,
e.g. { "type": "cartPercentOff", "percent": 10.0 } or { "type": "cartAmountOff", "amount": "5.0000" }.
"""
input PromotionInput {
  code: String!
  ends: DateTime!
  """The window over which the per-account limit is counted."""
  frequencyLimit: FrequencyLimit! = FOREVER
  name: String!
  """Per-account redemption cap over the frequency window; 0 = unlimited."""
  perAccountLimit: Long! = 0
  """Redemption cap; null = unlimited."""
  quantity: Long = null
  rule: JSON!
  starts: DateTime!
  storeId: UUID!
  type: PromotionType!
}

"""Mutations on one promotion. Admin."""
type PromotionMutation {
  """Soft-delete the promotion."""
  delete: Boolean!
  """Edit the promotion's definition."""
  edit(input: PromotionInput!): Promotion!
}

"""Whether a promotion applies to carts or to subscription renewals."""
enum PromotionType {
  CART
  SUBSCRIPTION
}

"""Promotion administration. Admin."""
type PromotionsMutation {
  """Create a promotion (with an optional redemption cap)."""
  add(input: PromotionInput!): Promotion!
  """Operations on an existing promotion."""
  promotion(id: UUID!): PromotionMutation!
}

"""
An AI prompt template with system and user prompt components, used for AI-powered content workflows
"""
type Prompt {
  """Description of what this prompt does"""
  description: String!
  """
  If set, the path in the Git repository where this prompt's `.md` file lives.
  """
  gitPath: String
  """If set, the AGENT_PROJECT Git repository this prompt is linked to."""
  gitRepositoryId: UUID
  """Unique identifier for this prompt"""
  id: UUID!
  """
  The expected input content type (e.g. 'text/plain', 'application/json')
  """
  inputType: String!
  """Unique key for referencing this prompt (e.g. 'summarize', 'translate')"""
  key: String!
  """
  Last sync error message, if the most recent pull/push failed. `null` when sync succeeded.
  """
  lastSyncError: String
  """Display name of the prompt"""
  name: String!
  """The expected output content type"""
  outputType: String!
  """Optional JSON schema for structured output validation"""
  schema: JSON
  """The system-level instruction for the AI model"""
  systemPrompt: String!
  """
  The user-level prompt template, may contain placeholders for dynamic content
  """
  userPrompt: String!
}

"""Input for creating or updating a prompt template"""
input PromptInput {
  """Description of what this prompt does"""
  description: String!
  """The expected input content type"""
  inputType: String!
  """Unique key for referencing this prompt"""
  key: String!
  """Display name of the prompt"""
  name: String!
  """The expected output content type"""
  outputType: String!
  """Optional JSON schema for structured output validation"""
  schema: JSON
  """The system-level instruction for the AI model"""
  systemPrompt: String!
  """The user-level prompt template"""
  userPrompt: String!
}

"""Query operations for browsing prompt templates"""
type Prompts {
  """List all registered prompts"""
  all: [Prompt!]!
  """Get a specific prompt by ID"""
  prompt(id: UUID!): Prompt
}

"""Mutation operations for managing prompt templates"""
type PromptsMutation {
  """Create a new prompt template"""
  add(prompt: PromptInput!): Prompt
  """Delete a prompt by ID"""
  delete(id: UUID!): Boolean!
  """
  Update an existing prompt template. If the prompt is linked to an AGENT_PROJECT
  repository and both `authorName` and `authorEmail` are provided, the new state
  is also pushed to Git as a commit attributed to the editor. The push is
  best-effort — failures are logged and recorded as `lastSyncError` on the row.
  """
  edit(
    """
    Commit author email for the Git push (only used when the prompt is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the prompt is Git-linked).
    """
    authorName: String
    id: UUID!
    prompt: PromptInput!
  ): Prompt
}

"""
Payment/shipping provider settings (admin-gated; may hold gateway secrets).
"""
union ProviderConfiguration = EmptyProviderConfiguration | KeyValueProviderConfiguration

"""One entry in a KeyValueProviderConfiguration."""
type ProviderConfigurationValue {
  key: String!
  value: String!
}

"""Registers a payment provider configuration."""
input ProviderInput {
  companyId: UUID!
  configuration: JSON = null
  name: String!
  """DI key of the provider implementation."""
  providerKey: String!
}

"""Payment/shipping provider registration. Admin."""
type ProvidersMutation {
  """
  Register a payment provider configuration; behavior binds via DI provider key.
  """
  addPayment(input: ProviderInput!): PaymentProvider!
  """
  Register a shipping provider configuration; behavior binds via DI provider key.
  """
  addShipping(input: ShippingProviderInput!): ShippingProvider!
  """Soft-delete a payment provider. Ensure no store still binds it first."""
  deletePayment(id: UUID!): Boolean!
  """
  Soft-delete a shipping provider. Ensure no store/fulfillment center still binds it first.
  """
  deleteShipping(id: UUID!): Boolean!
  """
  Edit a payment provider. Omit `configuration` to keep the existing settings (never read back).
  """
  editPayment(id: UUID!, input: ProviderInput!): PaymentProvider!
  """
  Edit a shipping provider. Omit `configuration` to keep the existing settings.
  """
  editShipping(id: UUID!, input: ShippingProviderInput!): ShippingProvider!
}

"""The service that issued and accepts a push token."""
enum PushProvider {
  """Apple Push Notification service."""
  APNS
  """Firebase Cloud Messaging."""
  FCM
}

"""A push notification token registered on a device."""
type PushToken {
  """When this push token was registered."""
  created: DateTime!
  """The service that issued this token."""
  provider: PushProvider!
  """The raw device token string used by the push notification service."""
  token: String!
}

"""Per-order quantity bounds for a catalog entry."""
type QuantityRequirements {
  max: Int
  min: Int
  type: String!
}

"""
The root query type for the Bosca API. All read operations are accessed through the namespaced fields below.
"""
type Query {
  """Access query operations for agent tools"""
  agentTools: AgentTools!
  """Access query operations for AI agents"""
  agents: Agents!
  """
  Access AI-domain queries (agents, tools, MCP servers, models, prompts).
  """
  ai: Ai!
  """
  Access the analytics domain for queries, dashboards, and visualizations
  """
  analytics: Analytics!
  """
  Access artifact registry administration for managing namespaces, repositories, versions, and tags.
  """
  artifactsAdmin: ArtifactsAdmin!
  """
  Access backup query operations for listing and inspecting backup records.
  """
  backups: Backups!
  """Access calendar query operations."""
  calendars: Calendars!
  """
  Access campaign query operations for banners, email blasts, and push notifications.
  """
  campaigns: Campaigns!
  """Access chat features including channels and messages"""
  chat: Chat!
  """
  Access query operations for chat sessions belonging to the authenticated user
  """
  chatSessions: ChatSessions!
  """Bridge and federation administration grouped under a single namespace."""
  collaboration: Collaboration!
  communications: CommunicationsQueries!
  """Access community features including groups, channels, and activities"""
  community: Community!
  """
  Access application configuration key-value store for reading platform settings and feature flags.
  """
  configurations: Configurations!
  """
  Access content management operations for collections, metadata, workflows, models, and related content entities.
  """
  content: Content!
  """Access device registration and push token management operations."""
  devices: Devices!
  """The ecommerce domain query namespace."""
  ecom: Ecom!
  """Access event-related queries, including the platform Event Catalog."""
  events: Events!
  exclusionLayers: ExclusionLayers!
  experiments: Experiments!
  featureFlags: FeatureFlags!
  """The feeds domain query namespace."""
  feeds: Feeds!
  """
  Access form schema definitions for building and rendering dynamic forms
  """
  formSchemas: FormSchemas!
  gateway: GatewayNamespace!
  """Git repository operations."""
  git: Git!
  """Access the list of supported languages for content localization."""
  languages: Languages!
  """Entry point for localization queries"""
  localization: Localization!
  """Access query operations for MCP server registrations"""
  mcpServers: McpServers!
  """
  Access Meilisearch server monitoring and administration operations for managing indexes, settings, tasks, nodes, and federation.
  """
  meilisearchAdmin: MeilisearchAdmin!
  """Access AI model queries"""
  models: Models!
  """
  Access NATS server monitoring and introspection operations for viewing server status, connections, JetStream details, and health.
  """
  natsAdmin: NatsAdmin!
  """
  Access organization query operations for retrieving organizations, memberships, and signup configurations.
  """
  organizations: Organizations!
  """Access package management queries"""
  packages: Packages!
  """
  Access persisted query operations for managing pre-registered GraphQL queries.
  """
  persistedQueries: PersistedQueries!
  """Access pipeline queries."""
  pipelines: Pipelines!
  """
  Access PostgreSQL database monitoring and introspection operations for viewing database health, performance, and configuration.
  """
  postgresAdmin: PostgresAdmin!
  """
  Access profile query operations for retrieving user profiles, attributes, and relationships.
  """
  profiles: Profiles!
  """Access prompt template queries"""
  prompts: Prompts!
  """
  Access the recommendation system for personalized content discovery and admin management.
  """
  recommendation: Recommendation!
  """
  Access the job scheduler query operations for listing jobs, viewing history, and discovering available job definitions.
  """
  scheduler: Scheduler!
  scripts: Scripts!
  """
  Access full-text and semantic search operations across collections, metadata, and profiles.
  """
  search: Search!
  """
  Access security operations for managing principals, groups, permissions, and authentication.
  """
  security: Security!
  """
  Access audience segmentation operations for managing segments and evaluating audiences.
  """
  segments: Segments!
  """Access server information and health status."""
  server: Server!
  """Access workflow state queries"""
  states: WorkflowStates!
  """
  Access storage system query operations for retrieving search, supplementary, and vector storage configurations.
  """
  storageSystems: StorageSystems!
  """
  Retrieve a single time event type by its string ID; returns null if not found
  """
  timeEventType(id: String!): TimeEventType
  """Retrieve all registered time event type definitions"""
  timeEventTypes: [TimeEventType!]!
  """Access workflow transition queries"""
  transitions: Transitions!
  workOps: WorkOps!
}

"""Data type for a query parameter value"""
enum QueryParameterType {
  """An ordered list of values; use arrayType to specify the element type"""
  ARRAY
  """True or false boolean value"""
  BOOLEAN
  """Calendar date without time (e.g. 2024-01-15)"""
  DATE
  """Combined date and time (e.g. 2024-01-15T09:30:00Z)"""
  DATETIME
  """Floating-point decimal number"""
  FLOAT
  """Whole number (32-bit signed integer)"""
  INTEGER
  """
  No value / void — used when a parameter placeholder is needed but carries no data
  """
  NONE
  """A nested JSON object"""
  OBJECT
  """UTF-8 text string"""
  STRING
  """Time of day without date (e.g. 09:30:00)"""
  TIME
}

"""
A recipient delivery status with identity resolved through the profile service.
"""
type RecipientDeliveryStatus {
  delivery: DeliveryStatus!
  recipientEmail: String
  recipientName: String
}

"""
Unified query entry point for the recommendation system. Provides personalized content feeds, semantic similarity, trending content, and admin operations for strategies, placements, and contexts.
"""
type Recommendation {
  """
  Behavioral co-engagement for a source content item — "people who engaged with this also engaged with…" (from CO_ENGAGEMENT strategies), distinct from `similar`'s content similarity. Supplying profileId personalizes (re-ranks for that viewer and drops their dismissals); omit it for the global set.
  """
  coEngaged(
    """The saved recommendation context type to apply. Omit to use `default`."""
    contextType: String
    """
    The BCP 47 content language to return. Omit to use the profile's preferred locale when personalized, then English.
    """
    languageTag: String
    """The maximum number of co-engaged items to return."""
    limit: Int!
    """The UUID of the source content item being viewed."""
    metadataId: UUID!
    """
    The viewing profile to personalize for. Omit to personalize for the authenticated user (or the global set if anonymous).
    """
    profileId: UUID
  ): [RecommendationResult!]!
  """
  Access saved recommendation context management operations (admin only).
  """
  contexts: RecommendationContexts!
  """
  The authenticated user's personalized feed ("For you"), retrieved and ranked live from the trained model. Defaults to the caller's own profile; supplying an explicit profileId is allowed only for its owner or an admin/service account.
  """
  forYou(
    """The saved recommendation context type to apply. Omit to use `default`."""
    contextType: String
    """
    The BCP 47 content language to return. Omit to use the profile's preferred locale, then English.
    """
    languageTag: String
    """The maximum number of recommendations to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
    """
    The profile whose feed to retrieve. Omit to use the authenticated user's profile; an explicit id is permitted only for its owner or an admin/service account.
    """
    profileId: UUID
  ): [RecommendationResult!]!
  """
  Access Personalization Signal definitions — the config for how profile attributes/segments personalize recommendations (admin only).
  """
  personalizationSignals: PersonalizationSignals!
  """Retrieve recommendations for a specific display placement."""
  placement(
    """The saved recommendation context type to apply. Omit to use `default`."""
    contextType: String
    """
    The BCP 47 content language to return. Omit to use the profile's preferred locale when personalized, then English.
    """
    languageTag: String
    """The maximum number of recommendations to return."""
    limit: Int!
    """The slug identifying the display location."""
    placementSlug: String!
    """
    The profile to personalize for. Omit to use the authenticated user's profile (or the anonymous set).
    """
    profileId: UUID
  ): [RecommendationResult!]!
  """Access recommendation placement management operations (admin only)."""
  placements: RecommendationPlacements!
  """
  Recommendations ranked by the selected context model using the source item and optional profile. Falls back to the matching content-similarity model when personalization is unavailable. Sources are computed only when selected.
  """
  recommended(
    """The saved recommendation context type to apply. Omit to use `default`."""
    contextType: String
    """
    The BCP 47 content language to return. Omit to use the profile's preferred locale when personalized, then English.
    """
    languageTag: String
    """The maximum number of items to return."""
    limit: Int!
    """The UUID of the content item being viewed."""
    metadataId: UUID!
    """
    The viewing profile to personalize for. Omit to personalize for the authenticated user (or population-level ranking if anonymous).
    """
    profileId: UUID
  ): [RecommendationResult!]!
  """
  Retrieve similar metadata using the selected context model, including its weighted content features and direct collection memberships.
  """
  similar(
    """The saved recommendation context type to apply. Omit to use `default`."""
    contextType: String
    """The BCP 47 content language to return. Omit to use English."""
    languageTag: String
    """The maximum number of similar items to return."""
    limit: Int!
    """The UUID of the content to find similar items for."""
    metadataId: UUID!
  ): [RecommendationResult!]!
  """Access recommendation strategy management operations (admin only)."""
  strategies: RecommendationStrategies!
  """
  Retrieve globally trending content based on recent interaction velocity.
  """
  trending(
    """The saved recommendation context type to apply. Omit to use `default`."""
    contextType: String
    """The BCP 47 content language to return. Omit to use English."""
    languageTag: String
    """The maximum number of trending items to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [RecommendationResult!]!
}

"""
The saved collection eligibility rules attached to a recommendation context.
"""
type RecommendationCollectionFilter {
  """The `attributes.type` deny-list used when the allow-list is empty."""
  excludedAttributeTypes: [String!]!
  """
  The canonical collection-type deny-list used when the allow-list is empty.
  """
  excludedTypes: [String!]!
  """The complete `attributes.type` allow-list when non-empty."""
  includedAttributeTypes: [String!]!
  """The complete canonical collection-type allow-list when non-empty."""
  includedTypes: [String!]!
}

"""
Collection eligibility rules for a recommendation context. Each configured facet must match.
"""
input RecommendationCollectionFilterInput {
  """
  Collection `attributes.type` values omitted when no attribute-type include-list is supplied.
  """
  excludedAttributeTypes: [String!]! = []
  """
  Canonical collection types omitted when no type include-list is supplied.
  """
  excludedTypes: [String!]! = []
  """
  When non-empty, only collections whose `attributes.type` exactly matches one of these values is assigned.
  """
  includedAttributeTypes: [String!]! = []
  """
  When non-empty, only collections whose canonical type matches one of these values are assigned.
  """
  includedTypes: [String!]! = []
}

"""The saved content-shape rules attached to a recommendation context."""
type RecommendationContentFilter {
  collections: RecommendationCollectionFilter
  metadata: RecommendationMetadataFilter!
}

"""
Content-shape rules for a recommendation context. A null collection filter excludes collections.
"""
input RecommendationContentFilterInput {
  collections: RecommendationCollectionFilterInput = {excludedAttributeTypes: [], excludedTypes: [], includedAttributeTypes: [], includedTypes: []}
  metadata: RecommendationMetadataFilterInput! = {excludedAttributeTypes: [], excludedContentTypePrefixes: ["image/", "video/", "audio/", "font/", "model/", "application/octet-stream"], includedAttributeTypes: [], includedContentTypePrefixes: []}
}

"""
A named recommendation-use context backed by cached content classifications and model candidate facets.
"""
type RecommendationContext {
  activeModelVersion: Long
  contentFilter: RecommendationContentFilter!
  created: DateTime!
  description: String!
  id: UUID!
  modified: DateTime!
  name: String!
  requestedModelVersion: Long
  revision: Long!
  selectionRevision: Long!
  type: String!
  weights: RecommendationWeights!
}

"""
Input for defining a named recommendation-use context and its content classification rules.
"""
input RecommendationContextInput {
  """
  Rules used to assign this context to metadata and collections when content is saved or reclassified.
  """
  contentFilter: RecommendationContentFilterInput! = {collections: {excludedAttributeTypes: [], excludedTypes: [], includedAttributeTypes: [], includedTypes: []}, metadata: {excludedAttributeTypes: [], excludedContentTypePrefixes: ["image/", "video/", "audio/", "font/", "model/", "application/octet-stream"], includedAttributeTypes: [], includedContentTypePrefixes: []}}
  """A description of where this context is used."""
  description: String
  """The administrator-facing context name."""
  name: String!
  """
  The type value used to select this context in recommendation requests, such as `default` or `image_picker`.
  """
  type: String!
  """Importance settings captured by the next trained model."""
  weights: RecommendationWeightsInput! = {coEngagement: 1, cohortCoEngagement: 1, content: 1, defaultTypePreference: 0.5, learnedNeighbor: 1, personalization: 1, rating: 1, similarity: {categories: 0.2, collections: 0.2, labels: 0.2, language: 0.2, mime: 0.2, semantic: 0.2, type: 0.2}, typePreferences: []}
}

type RecommendationContextModel {
  completed: DateTime
  contentModelName: String!
  """
  Context captured when this generation was queued; independent of later edits.
  """
  context: RecommendationContext!
  contextId: UUID!
  created: DateTime!
  exported: Boolean!
  failure: String
  personalized: Boolean!
  personalizedModelName: String!
  pinned: Boolean!
  revision: Long!
  selectionRevision: Long!
  started: DateTime
  status: RecommendationTrainingStatus!
  version: Long!
}

"""Admin operations for saved recommendation contexts."""
type RecommendationContexts {
  """Retrieve every saved recommendation context."""
  all: [RecommendationContext!]!
  """Retrieve a context by identifier."""
  context(id: UUID!): RecommendationContext
  """Retrieve a context by the type value used in requests."""
  contextByType(type: String!): RecommendationContext
  """Recent training history plus protected active and pinned versions."""
  models(contextId: UUID!): [RecommendationContextModel!]!
  """Exact exported versions needed by serving or awaiting load validation."""
  servingModels: [RecommendationContextModel!]!
}

"""
Administrator context mutations and artifact-authorized training export reports.
"""
type RecommendationContextsMutation {
  """Request activation of a retained model after it loads."""
  activateModel(contextId: UUID!, version: Long!): RecommendationContextModel!
  """
  Save a new context without queuing content reclassification or model training.
  """
  add(context: RecommendationContextInput!): RecommendationContext!
  """Delete a context without queuing content reclassification."""
  delete(id: UUID!): Boolean!
  """
  Delete terminal model history and queue artifact removal. Active, requested, and in-flight models cannot be deleted.
  """
  deleteModel(contextId: UUID!, version: Long!): Boolean!
  """
  Save context changes without queuing content reclassification or model training.
  """
  edit(context: RecommendationContextInput!, id: UUID!): RecommendationContext!
  """
  Trainer callback after validation and upload. Requires administrator access or artifact push permission for the exact reported model exports.
  """
  modelExported(personalized: Boolean!, version: Long!): Boolean!
  pinModel(contextId: UUID!, pinned: Boolean!, version: Long!): RecommendationContextModel!
  """
  Recompute content assignments for all saved contexts without starting model training. Requires administrator access.
  """
  recompute: Boolean!
  """
  Train a new model using this context's saved settings. Requires administrator access.
  """
  trainModel(contextId: UUID!): RecommendationContextModel!
}

"""
A user's feedback gesture on a recommended item (routed to a profile rating, or a dismissal for HIDE).
"""
enum RecommendationFeedback {
  """Strong positive — more like this."""
  BOOST
  """Positive interest — I care about this."""
  CARE
  """Remove from the feed (dismissal, not a rating)."""
  HIDE
  """Negative — less like this."""
  LOWER
}

"""
The saved metadata eligibility rules attached to a recommendation context.
"""
type RecommendationMetadataFilter {
  """The `attributes.type` deny-list used when the allow-list is empty."""
  excludedAttributeTypes: [String!]!
  """The content-type deny-list used when the allow-list is empty."""
  excludedContentTypePrefixes: [String!]!
  """The complete `attributes.type` allow-list when non-empty."""
  includedAttributeTypes: [String!]!
  """The complete content-type allow-list when non-empty."""
  includedContentTypePrefixes: [String!]!
}

"""
Metadata eligibility rules for a recommendation context. Each configured facet must match.
"""
input RecommendationMetadataFilterInput {
  """
  Metadata `attributes.type` values omitted when no attribute-type include-list is supplied.
  """
  excludedAttributeTypes: [String!]! = []
  """
  Content-type prefixes omitted when no include-list is supplied. The defaults remove raw assets from ordinary app/site recommendations.
  """
  excludedContentTypePrefixes: [String!]! = ["image/", "video/", "audio/", "font/", "model/", "application/octet-stream"]
  """
  When non-empty, only metadata whose `attributes.type` exactly matches one of these values is assigned.
  """
  includedAttributeTypes: [String!]! = []
  """
  When non-empty, only metadata whose content type starts with one of these prefixes is assigned to the context.
  """
  includedContentTypePrefixes: [String!]! = []
}

"""
Unified mutation entry point for the recommendation system. Provides user preference operations and admin management for strategies, placements, and contexts.
"""
type RecommendationMutation {
  """Access saved recommendation context mutation operations (admin only)."""
  contexts: RecommendationContextsMutation!
  """
  Dismiss a content item so it will not appear in future recommendations for this profile. Provide either metadataId or collectionId.
  """
  dismiss(
    """The UUID of the collection to dismiss."""
    collectionId: UUID
    """The UUID of the metadata item to dismiss."""
    metadataId: UUID
    """The UUID of the profile."""
    profileId: UUID!
  ): Boolean!
  """
  Record a feedback gesture on a content item, routed to the right primitive (rating, or dismissal for HIDE). Provide either metadataId or collectionId.
  """
  feedback(
    """The UUID of the collection, or null when targeting a metadata item."""
    collectionId: UUID
    """The feedback gesture."""
    gesture: RecommendationFeedback!
    """The UUID of the metadata item, or null when targeting a collection."""
    metadataId: UUID
    """The version of the metadata item (optional)."""
    metadataVersion: Int
    """The UUID of the profile giving feedback."""
    profileId: UUID!
  ): Boolean!
  """Manage Personalization Signal definitions (admin only)."""
  personalizationSignals: PersonalizationSignalsMutation!
  """Access recommendation placement mutation operations (admin only)."""
  placements: RecommendationPlacementsMutation!
  """Access recommendation strategy mutation operations (admin only)."""
  strategies: RecommendationStrategiesMutation!
  """
  Undo a previous dismissal, allowing the content item to appear in recommendations again.
  """
  undismiss(
    """The UUID of the collection to un-dismiss."""
    collectionId: UUID
    """The UUID of the metadata item to un-dismiss."""
    metadataId: UUID
    """The UUID of the profile."""
    profileId: UUID!
  ): Boolean!
}

"""
A named location within the application where recommendations are displayed.
"""
type RecommendationPlacement {
  """Placement-specific display configuration as JSON."""
  configuration: JSON
  """The timestamp when this placement was created."""
  created: DateTime!
  """A description of where this placement appears."""
  description: String!
  """The unique identifier of the placement."""
  id: UUID!
  """Maximum number of items to display in this placement."""
  maxItems: Int!
  """The timestamp when this placement was last modified."""
  modified: DateTime!
  """The display name of the placement."""
  name: String!
  """The URL-friendly unique identifier for this placement."""
  slug: String!
  """
  The strategies that contribute recommendations to this placement, ordered by priority.
  """
  strategies: [RecommendationStrategy!]!
}

"""Input for creating or updating a recommendation placement."""
input RecommendationPlacementInput {
  """Placement-specific display configuration as JSON."""
  configuration: JSON
  """A description of where this placement appears in the application."""
  description: String
  """Maximum number of recommendation items to display in this placement."""
  maxItems: Int
  """The display name of the placement."""
  name: String!
  """
  A URL-friendly unique identifier for this placement (e.g., home_feed, article_sidebar).
  """
  slug: String!
}

"""Query operations for managing recommendation placements (admin only)."""
type RecommendationPlacements {
  """Retrieve all recommendation placements."""
  all: [RecommendationPlacement!]!
  """Retrieve a single placement by its identifier."""
  placement(
    """The UUID of the placement to retrieve."""
    id: UUID!
  ): RecommendationPlacement
  """Retrieve a single placement by its URL-friendly slug."""
  placementBySlug(
    """The unique slug identifying the placement."""
    slug: String!
  ): RecommendationPlacement
}

"""
Mutation operations for managing recommendation placements (admin only).
"""
type RecommendationPlacementsMutation {
  """Create a new recommendation placement with strategy associations."""
  add(
    """The placement definition."""
    placement: RecommendationPlacementInput!
    """The strategy UUIDs to associate with this placement."""
    strategyIds: [UUID!]!
  ): RecommendationPlacement!
  """Delete a placement and its strategy associations."""
  delete(
    """The UUID of the placement to delete."""
    id: UUID!
  ): Boolean!
  """Update an existing placement and its strategy associations."""
  edit(
    """The UUID of the placement to update."""
    id: UUID!
    """The updated placement definition."""
    placement: RecommendationPlacementInput!
    """The updated strategy UUIDs for this placement."""
    strategyIds: [UUID!]!
  ): RecommendationPlacement!
}

"""
A content recommendation candidate. Each recommendation points to either a metadata item or a collection.
"""
type RecommendationResult {
  """The recommended collection, resolved from collectionId."""
  collection: Collection
  """
  The UUID of the recommended collection, if this is a collection recommendation.
  """
  collectionId: UUID
  """
  The concrete base or variant language selected for this collection recommendation.
  """
  collectionLanguageTag: String
  """Additional context about the recommendation scoring factors."""
  context: JSON
  """The timestamp when this recommendation was generated."""
  created: DateTime!
  """When this recommendation expires and should no longer be served."""
  expiresAt: DateTime
  """
  True when this is a read-time fallback — content similar to the profile's activity, or trending, surfaced because no actual personalized recommendation was available — rather than a genuine personalized/ML recommendation.
  """
  fallback: Boolean!
  """The unique identifier of the recommendation."""
  id: UUID!
  """The recommended metadata item, resolved from metadataId."""
  metadata: Metadata
  """
  The UUID of the recommended metadata item, if this is a metadata recommendation.
  """
  metadataId: UUID
  """A human-readable explanation of why this content was recommended."""
  reason: String
  """The relevance score for this recommendation (higher is more relevant)."""
  score: Float!
  """
  The candidate-generation and model-ranking signals that contributed to this result.
  """
  sources: [RecommendationSource!]!
  """The strategy that produced this recommendation."""
  strategy: RecommendationStrategy
}

"""Saved similarity weights, normalized within their group in the model."""
type RecommendationSimilarityWeights {
  categories: Float!
  collections: Float!
  labels: Float!
  language: Float!
  mime: Float!
  semantic: Float!
  type: Float!
}

"""
Editable similarity weights, normalized within their group in the model.
"""
input RecommendationSimilarityWeightsInput {
  categories: Float! = 0.2
  collections: Float! = 0.2
  labels: Float! = 0.2
  language: Float! = 0.2
  mime: Float! = 0.2
  semantic: Float! = 0.2
  type: Float! = 0.2
}

"""
A candidate-generation or model-ranking signal that contributed to a recommendation result.
"""
enum RecommendationSource {
  """Item-to-item co-engagement conditioned on a viewer cohort."""
  COHORT_CO_ENGAGEMENT
  """Similarity from the independently served item-to-item content model."""
  CONTENT_MODEL
  """Whole-audience item-to-item co-engagement."""
  CO_ENGAGEMENT
  """Retrieval or ranking from the personalized TensorFlow model."""
  PERSONALIZED_MODEL
  """Globally trending content from an evaluated trending strategy."""
  TRENDING
}

"""Query operations for managing recommendation strategies (admin only)."""
type RecommendationStrategies {
  """Retrieve a paginated list of all recommendation strategies."""
  all(
    """The maximum number of strategies to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [RecommendationStrategy!]!
  """Retrieve a single strategy by its identifier."""
  strategy(
    """The UUID of the strategy to retrieve."""
    id: UUID!
  ): RecommendationStrategy
}

"""
Mutation operations for managing recommendation strategies (admin only).
"""
type RecommendationStrategiesMutation {
  """Create a new recommendation strategy."""
  add(
    """The strategy definition."""
    strategy: RecommendationStrategyInput!
  ): RecommendationStrategy!
  """
  Enqueue a durable semantic-data backfill. By default only missing embeddings are filled; set overwriteExisting to refresh all ready, recommendable content. A model training run starts afterward when any embeddings changed.
  """
  backfillSemanticData(
    """
    Whether to recompute existing embeddings in addition to filling missing ones.
    """
    overwriteExisting: Boolean! = false
  ): Boolean!
  """Delete a strategy and all its generated recommendations."""
  delete(
    """The UUID of the strategy to delete."""
    id: UUID!
  ): Boolean!
  """Update an existing strategy."""
  edit(
    """The UUID of the strategy to update."""
    id: UUID!
    """The updated strategy definition."""
    strategy: RecommendationStrategyInput!
  ): RecommendationStrategy!
  """
  Manually trigger evaluation of a strategy, generating fresh recommendations.
  """
  evaluate(
    """The UUID of the strategy to evaluate."""
    strategyId: UUID!
  ): RecommendationStrategy!
  """
  One-click setup of the built-in ML-vs-heuristic A/B test: a feature flag with a 50/50 split, an experiment, and its conversion goals. Created dormant (review and start it from the experiments UI). Idempotent — returns the existing experiment if already set up.
  """
  provisionEngineExperiment: EngineExperimentProvisioning!
  """
  One-click setup of the model-vs-model online A/B test: routes traffic 50/50 between two TF Serving model versions and measures which wins on real engagement. Idempotent — re-points the test to the requested version pair. Created dormant.
  """
  provisionModelExperiment(
    """The candidate/challenger model version to test against it."""
    challengerVersion: Long!
    """The current/champion model version."""
    championVersion: Long!
  ): EngineExperimentProvisioning!
  """
  Enqueue a TFRS model training run now. The recommendations runner picks it up and calls the trainer service; training then runs in the background (it can take minutes to hours). Optionally override the trainer's defaults (e.g. epochs, lookbackDays, embeddingDim) as a JSON object. Returns true once the run is enqueued.
  """
  trainModel(
    """
    Optional JSON object of trainer config overrides; null uses the trainer's defaults.
    """
    configuration: JSON
  ): Boolean!
}

"""
A recommendation strategy that controls how content is selected and ranked for user profiles.
"""
type RecommendationStrategy {
  """The UUID of the analytics query used for recommendation generation."""
  analyticsQueryId: UUID
  """Strategy-specific configuration parameters as JSON."""
  configuration: JSON
  """The timestamp when this strategy was created."""
  created: DateTime!
  """A description of how this strategy generates recommendations."""
  description: String!
  """
  The cron expression from the linked scheduled job, resolved at query time.
  """
  evaluationSchedule: String
  """The unique identifier of the strategy."""
  id: UUID!
  """The timestamp of the last strategy evaluation."""
  lastEvaluated: DateTime
  """Maximum number of candidates this strategy produces per evaluation."""
  maxRecommendations: Int!
  """The timestamp when this strategy was last modified."""
  modified: DateTime!
  """The display name of the strategy."""
  name: String!
  """
  Priority for ordering when multiple strategies contribute to a placement.
  """
  priority: Int!
  """
  The UUID of the scheduler job driving automatic evaluation. Null when no schedule is set.
  """
  scheduledJobId: UUID
  """The lifecycle status of the strategy."""
  status: RecommendationStrategyStatus!
  """The algorithm type used to generate recommendations."""
  type: RecommendationStrategyType!
}

"""Input for creating or updating a recommendation strategy."""
input RecommendationStrategyInput {
  """
  The UUID of an analytics query whose results drive recommendation generation.
  """
  analyticsQueryId: UUID
  """
  Strategy-specific configuration parameters as JSON (e.g., decay rate, similarity threshold, lookback days).
  """
  configuration: JSON
  """A description of how this strategy generates recommendations."""
  description: String
  """
  A cron expression for automatic periodic evaluation. Set to null to disable scheduled evaluation.
  """
  evaluationSchedule: String
  """
  Maximum number of recommendations this strategy should produce per profile.
  """
  maxRecommendations: Int
  """The display name of the strategy."""
  name: String!
  """
  Priority for ordering when multiple strategies contribute to a placement. Higher values are evaluated first.
  """
  priority: Int
  """The lifecycle status of the strategy."""
  status: RecommendationStrategyStatus
  """The algorithm type used to generate recommendations."""
  type: RecommendationStrategyType!
}

"""Lifecycle status of a recommendation strategy."""
enum RecommendationStrategyStatus {
  """The strategy is live and actively generating recommendations."""
  ACTIVE
  """The strategy is retired and no longer produces recommendations."""
  ARCHIVED
  """
  The strategy is being configured and does not yet produce recommendations.
  """
  DRAFT
  """The strategy was previously active but has been temporarily suspended."""
  PAUSED
}

"""
Defines the algorithm a strategy uses for candidate generation. Personalization (the learned ranker, dismissals, rating re-ranking) is applied at read time, so strategies carry no per-profile targeting.
"""
enum RecommendationStrategyType {
  """
  "People like you" item-to-item recommendations — co-occurrence conditioned on all of the viewer's cohort memberships (derived from their personalization signals), served anchored on a source item and folded into `recommended`.
  """
  COHORT_CO_ENGAGEMENT
  """
  Item-to-item recommendations ("you liked X, here's related Z") from a co-occurrence analytics query, served anchored on a source item rather than a profile feed.
  """
  CO_ENGAGEMENT
  """
  Personalized recommendations from a trained TensorFlow Recommenders model served via TF Serving, retrieved and ranked live per request.
  """
  PERSONALIZED
  """
  Content with the highest recent interaction velocity across all users. Materialized on a schedule as a global pool.
  """
  TRENDING
}

enum RecommendationTrainingStatus {
  COMPLETED
  FAILED
  QUEUED
  RUNNING
}

"""Preference for an exact trimmed, lowercase attributes.type value."""
type RecommendationTypePreference {
  type: String!
  weight: Float!
}

"""Preference for an exact trimmed, lowercase attributes.type value."""
input RecommendationTypePreferenceInput {
  type: String!
  weight: Float!
}

"""
Saved context importance; zero disables contribution, never eligibility.
"""
type RecommendationWeights {
  coEngagement: Float!
  cohortCoEngagement: Float!
  content: Float!
  defaultTypePreference: Float!
  learnedNeighbor: Float!
  personalization: Float!
  rating: Float!
  similarity: RecommendationSimilarityWeights!
  typePreferences: [RecommendationTypePreference!]!
}

"""
Editable context importance; zero disables contribution, never eligibility.
"""
input RecommendationWeightsInput {
  coEngagement: Float! = 1
  cohortCoEngagement: Float! = 1
  content: Float! = 1
  defaultTypePreference: Float! = 0.5
  learnedNeighbor: Float! = 1
  personalization: Float! = 1
  rating: Float! = 1
  similarity: RecommendationSimilarityWeightsInput! = {categories: 0.2, collections: 0.2, labels: 0.2, language: 0.2, mime: 0.2, semantic: 0.2, type: 0.2}
  typePreferences: [RecommendationTypePreferenceInput!]! = []
}

input RecordWorkOpsCompatibilityResultInput {
  breakingChangesDetected: Boolean
  consumerProjectId: UUID!
  consumerVersionId: UUID!
  pipelineRunId: UUID
  providerProjectId: UUID!
  providerVersionId: UUID!
  resultUrl: String
  status: WorkOpsCompatibilityStatus!
  testSuite: String!
}

"""
Input for a USFM reference, used to identify books, chapters, and verses
"""
input ReferenceInput {
  """USFM reference string (e.g. 'GEN', 'GEN.1', 'GEN.1.1')"""
  usfm: String!
}

"""
One line in a batch item refund: refund `quantity` units of cart item `itemId` (partial allowed).
"""
input RefundItemInput {
  itemId: UUID!
  quantity: Int!
}

"""
Where a refund is returned: the original payment method, account store credit, or a check.
"""
enum RefundTender {
  ACCOUNT_CREDIT
  CHECK
  ORIGINAL
}

"""Input for registering a new federation peer"""
input RegisterFederationPeerInput {
  """Base URL of the peer's federation REST API"""
  apiUrl: String!
  """Human-readable name for the peer"""
  name: String!
  """NATS connection URL used by the leaf-node bridge"""
  natsUrl: String!
  """
  Shared secret used to authenticate handshake and control-plane requests. Stored encrypted via the configuration service.
  """
  sharedSecret: String!
}

input RegisterWorkOpsApiSurfaceReportInput {
  analyzerTool: String!
  artifactPublicationId: UUID
  breakingChangeLevel: WorkOpsBreakingChangeLevel!
  changes: JSON!
  previousVersionId: UUID!
  projectId: UUID!
  reportUrl: String
  versionId: UUID!
}

input RegisterWorkOpsArtifactInput {
  artifactType: WorkOpsArtifactType!
  checksumSha256: String
  coordinates: String!
  externalUrl: String
  projectId: UUID!
  repositoryUrl: String
  versionId: UUID!
}

"""Requests a return/RMA against a paid order."""
input ReturnInput {
  cartId: UUID!
  """A check number when tender is CHECK."""
  checkNumber: String
  lines: [ReturnLineInput!]!
  reason: String
  """
  How the eventual refund is issued. Defaults to the original payment method.
  """
  tender: RefundTender! = ORIGINAL
}

"""
One requested return line: the order's cart item and the quantity coming back.
"""
input ReturnLineInput {
  itemId: UUID!
  quantity: Int!
}

"""
A return / RMA lifecycle: REQUESTED → APPROVED → RECEIVED → REFUNDED; REJECTED is the admin off-ramp
from REQUESTED/APPROVED. Restock + refund happen at the REFUNDED step (the cart's item-refund path).
"""
enum ReturnStatus {
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
  REQUESTED
}

"""The full return/RMA lifecycle. Admin."""
type ReturnsMutation {
  """Approve a requested return (REQUESTED → APPROVED)."""
  approve(id: UUID!): EcomReturn!
  """Mark the returned goods physically received (APPROVED → RECEIVED)."""
  receive(id: UUID!): EcomReturn!
  """Restock the lines and issue the refund (RECEIVED → REFUNDED)."""
  refund(id: UUID!): EcomReturn!
  """Reject a return with a reason (REQUESTED/APPROVED → REJECTED)."""
  reject(id: UUID!, reason: String): EcomReturn!
  """Open a return request for an order's lines (REQUESTED)."""
  request(input: ReturnInput!): EcomReturn!
}

"""Controller configuration attached to an experiment."""
type RolloutPolicy {
  guardrailMinRegressionPercent: Float!
  guardrailThreshold: Float!
  haltOnGuardrail: Boolean!
  incrementPercent: Float
  minConfidence: Float!
  mode: RolloutPolicyMode!
  steps: [RolloutStep!]
  treatmentVariationKey: String!
}

"""
Audit row for one rollout controller action. Written on every
controller wake, including held decisions, so operators can trace
exactly why (or why not) a rollout changed.
"""
enum RolloutPolicyAction {
  ADVANCED
  COMPLETED
  HALTED
  HELD
}

type RolloutPolicyEvent {
  action: RolloutPolicyAction!
  created: DateTime!
  experimentId: UUID!
  id: UUID!
  """
  Weights after the controller's write. Equal to oldWeights for HELD events.
  """
  newWeights: JSON!
  """Weights as they were before the controller's write."""
  oldWeights: JSON!
  reason: String!
}

"""Controller configuration attached to an experiment."""
input RolloutPolicyInput {
  """
  Default 0.5. Minimum negative lift percent for a guardrail regression to trip HALT.
  """
  guardrailMinRegressionPercent: Float
  """Default 0.95. Minimum confidence to trip a guardrail HALT."""
  guardrailThreshold: Float
  """
  Default true. When false, HALT verdicts produce held audit events but no flag edit.
  """
  haltOnGuardrail: Boolean
  """Percentage-point increase per SHIP verdict for ADAPTIVE_CONTINUOUS."""
  incrementPercent: Float
  """Default 0.95. Minimum confidence / P(beats control) to auto-advance."""
  minConfidence: Float
  mode: RolloutPolicyMode!
  """Step list for SCHEDULED_STEPS and ADAPTIVE_STEPS."""
  steps: [RolloutStepInput!]
  """
  Variation key the controller ramps toward. Must be served by the attached rule's rollout.
  """
  treatmentVariationKey: String!
}

"""
Progressive-delivery controller configuration. When attached to an
experiment, the RolloutPolicyJob reads each fresh analysis report and
mutates the attached rule's weights — advancing on SHIP, holding on
KEEP_RUNNING / INCONCLUSIVE, halting on HALT. See specs/experiments-v2/.
"""
enum RolloutPolicyMode {
  """
  Data-driven continuous ramp. Each SHIP verdict adds incrementPercent to treatment weight.
  """
  ADAPTIVE_CONTINUOUS
  """
  Data-driven step list. Advance one step per SHIP verdict; hold otherwise.
  """
  ADAPTIVE_STEPS
  """
  No automated advance. Guardrail HALT still applies when haltOnGuardrail=true.
  """
  MANUAL
  """
  Time-driven step list. Each step waits afterDuration, then applies regardless of verdict (HALT excepted).
  """
  SCHEDULED_STEPS
}

"""One stop on a scheduled or adaptive step list."""
type RolloutStep {
  afterDuration: String
  weightPercent: Int!
}

"""One stop on a scheduled or adaptive step list."""
input RolloutStepInput {
  """ISO-8601 duration (e.g. 'P1D'). Required for SCHEDULED_STEPS mode."""
  afterDuration: String
  weightPercent: Int!
}

"""
A promotion rule (polymorphic). Read via inline fragments; each member also carries its `type`
discriminator. Subscription rule members join this union alongside the cart rules.
"""
union Rule = AmountOffCartRule | AmountOffSubscriptionRule | BuyOneGetOneRule | FreeShippingCartRule | PercentOffCartRule | PercentOffSubscriptionRule

"""
A scheduled job definition that configures recurring or on-demand background task execution using cron expressions. Jobs reference a job definition by name and pass parameters to it.
"""
type ScheduledJob {
  """
  Whether multiple instances of this job are allowed to run concurrently. If false, overlapping runs are skipped.
  """
  allowConcurrent: Boolean!
  """
  Whether the scheduler should execute missed runs that occurred while the scheduler was down (catch-up execution).
  """
  catchUp: Boolean!
  """The timestamp when this scheduled job was created."""
  createdAt: DateTime!
  """The UUID of the principal who created this scheduled job."""
  createdBy: UUID!
  """
  The cron expression defining the schedule (e.g. '0 0 * * *' for daily at midnight). Null if the job is only triggered manually or by events.
  """
  cronExpression: String
  """An optional description of what this scheduled job does."""
  description: String
  """
  Whether this scheduled job is enabled and will be executed on its schedule.
  """
  enabled: Boolean!
  """
  The principal whose permissions this job executes with; distinct from createdBy.
  """
  executionPrincipalId: UUID
  """
  Retrieve a paginated and filtered list of execution history entries for this scheduled job.
  """
  history(
    """The maximum number of history entries to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
    """Filter history entries by trigger source (SCHEDULER or EVENT)."""
    source: JobHistorySource
    """Filter history entries by execution status."""
    status: ExecutionStatus
  ): [JobHistory!]!
  """
  Count the execution history entries for this scheduled job, optionally filtered by status and source.
  """
  historyCount(
    """Filter the count by trigger source."""
    source: JobHistorySource
    """Filter the count by execution status."""
    status: ExecutionStatus
  ): Long!
  """The unique identifier of this scheduled job."""
  id: UUID!
  """
  The name of the job definition to execute. Must match a registered JobDefinition name in the system.
  """
  jobName: String!
  """
  The parameters passed to the job definition on each execution, stored as JSON.
  """
  jobParameters: JSON!
  """
  The timestamp of the last execution of this scheduled job. Null if the job has never been executed.
  """
  lastRunAt: DateTime
  """
  The maximum number of missed runs to catch up on when the scheduler restarts. Prevents excessive catch-up execution.
  """
  maxCatchUp: Int!
  """A human-readable name for this scheduled job."""
  name: String!
  """
  The timestamp of the next planned execution based on the cron expression. Null if the job is disabled or has no cron expression.
  """
  nextRunAt: DateTime
  """The principal who assigned the execution identity."""
  principalAssignedBy: UUID
  """The assigned principal or administrator who confirmed the identity."""
  principalConfirmedBy: UUID
  """The durable assignment/consent state for the execution principal."""
  principalState: ScheduledJobPrincipalState!
  """The timestamp when this scheduled job was last updated."""
  updatedAt: DateTime!
}

"""Input for creating or updating a scheduled job definition."""
input ScheduledJobInput {
  """
  Whether multiple instances of this job are allowed to run concurrently. Defaults to false if not specified.
  """
  allowConcurrent: Boolean
  """
  Whether the scheduler should catch up on missed runs. Defaults to false if not specified.
  """
  catchUp: Boolean
  """
  The cron expression defining the schedule (e.g. '0 0 * * *' for daily at midnight). Null for manually-triggered-only jobs.
  """
  cronExpression: String
  """An optional description of what this scheduled job does."""
  description: String
  """
  Whether this scheduled job should be enabled upon creation. Defaults to false if not specified.
  """
  enabled: Boolean
  """
  The name of the job definition to execute. Must match a registered JobDefinition name in the system.
  """
  jobName: String!
  """
  The parameters to pass to the job definition on each execution, stored as JSON.
  """
  jobParameters: JSON!
  """
  The maximum number of missed runs to catch up on. Defaults to a system-defined limit if not specified.
  """
  maxCatchUp: Int
  """A human-readable name for this scheduled job."""
  name: String!
  """
  Whether the job must have a confirmed execution principal before it can be enabled.
  """
  requiresPrincipal: Boolean
}

"""
Whether and how a scheduled job's execution principal has been assigned.
"""
enum ScheduledJobPrincipalState {
  ACTIVE
  NEEDS_PRINCIPAL
  NOT_REQUIRED
  PENDING_CONFIRMATION
}

"""
Query operations for the job scheduler, including listing scheduled jobs, viewing execution history, and discovering available job definitions.
"""
type Scheduler {
  """
  Retrieve all registered job definitions that can be used when creating scheduled jobs.
  """
  availableJobDefinitions: [JobDefinitionInfo!]!
  """
  Retrieve a paginated list of execution history entries across all scheduled jobs, optionally filtered by status and source.
  """
  history(
    """The maximum number of history entries to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
    """Filter history entries by trigger source."""
    source: JobHistorySource
    """Filter history entries by execution status."""
    status: ExecutionStatus
  ): [JobHistory!]!
  """
  Count the total execution history entries across all scheduled jobs, optionally filtered by status and source.
  """
  historyCount(
    """Filter the count by trigger source."""
    source: JobHistorySource
    """Filter the count by execution status."""
    status: ExecutionStatus
  ): Long!
  """
  Retrieve a single scheduled job by its unique identifier. Returns null if the job does not exist.
  """
  job(
    """The UUID of the scheduled job to retrieve."""
    id: UUID!
  ): ScheduledJob
  """
  Retrieve a paginated list of scheduled jobs, optionally filtered by enabled status.
  """
  jobs(
    """
    Filter jobs by enabled status. If null, returns both enabled and disabled jobs.
    """
    enabled: Boolean
    """The maximum number of jobs to return."""
    limit: Int
    """The zero-based offset for pagination."""
    offset: Long
  ): [ScheduledJob!]!
  """Validate a cron expression and preview upcoming execution times."""
  validateCronExpression(
    """The cron expression to validate (e.g. '0 0 * * *', '*/5 * * * *')."""
    expression: String!
  ): CronValidationResult!
}

"""
Mutation operations for managing scheduled jobs, including CRUD operations and manual triggering.
"""
type SchedulerMutation {
  """
  Administrator assignment of an execution principal; activates immediately with the admin as confirmer.
  """
  assignExecutionPrincipal(id: UUID!, principalId: UUID!): ScheduledJob!
  """
  Cancel a pending or running job execution. Marks the execution as cancelled and records the cancellation time.
  """
  cancel(
    """The UUID of the job history entry to cancel."""
    id: UUID!
  ): JobHistory!
  """
  Clears and parks a principal-required job. Requires administrator access.
  """
  clearExecutionPrincipal(id: UUID!): ScheduledJob!
  """
  Confirms a pending assignment. The assigned principal or an administrator may confirm.
  """
  confirmExecutionPrincipal(id: UUID!): ScheduledJob!
  """Create a new scheduled job with the specified configuration."""
  create(
    """The scheduled job configuration to create."""
    input: ScheduledJobInput!
  ): ScheduledJob!
  """
  Delete a scheduled job by its unique identifier. Returns true if the deletion was successful.
  """
  delete(
    """The UUID of the scheduled job to delete."""
    id: UUID!
  ): Boolean!
  """
  Disable a scheduled job, preventing it from executing on its defined schedule. The job can still be triggered manually.
  """
  disable(
    """The UUID of the scheduled job to disable."""
    id: UUID!
  ): ScheduledJob!
  """Update an existing scheduled job's configuration."""
  edit(
    """The UUID of the scheduled job to update."""
    id: UUID!
    """The updated scheduled job configuration."""
    input: ScheduledJobInput!
  ): ScheduledJob!
  """
  Enable a previously disabled scheduled job, allowing it to execute on its defined schedule.
  """
  enable(
    """The UUID of the scheduled job to enable."""
    id: UUID!
  ): ScheduledJob!
  """
  Manually trigger an immediate execution of a scheduled job, regardless of its cron schedule or enabled status.
  """
  trigger(
    """The UUID of the scheduled job to trigger."""
    id: UUID!
  ): JobHistory!
}

type Script {
  configuration: JSON
  created: DateTime
  deletedAt: DateTime
  description: String!
  enabled: Boolean!
  id: UUID!
  inputSchema: JSON
  key: String!
  modified: DateTime
  name: String!
  outputSchema: JSON
  permissions: [Permission!]!
  public: Boolean!
  source: String!
  type: ScriptType!
  version: Int!
}

input ScriptInput {
  configuration: JSON
  description: String
  inputSchema: JSON
  key: String!
  name: String!
  outputSchema: JSON
  public: Boolean
  source: String!
  type: ScriptType!
}

enum ScriptType {
  API
  EPHEMERAL
  GENERAL
  TOOL
  TRIGGER
}

type Scripts {
  all(includeDeleted: Boolean, type: ScriptType): [Script!]!
  script(id: UUID!): Script
  scriptByKey(key: String!): Script
}

type ScriptsMutation {
  addPermission(permission: PermissionInput!): Boolean!
  addScript(script: ScriptInput!, sourceRef: SourceRefInput): Script!
  deletePermission(permission: PermissionInput!): Boolean!
  deleteScript(id: UUID!): Boolean!
  disableScript(id: UUID!): Boolean!
  editScript(id: UUID!, script: ScriptInput!, sourceRef: SourceRefInput): Script!
  enableScript(id: UUID!): Boolean!
  executeScript(id: UUID!, input: JSON): JSON
}

"""
Entry point for search operations. Provides full-text and semantic search across collections, metadata, and profiles, as well as administrative search configuration tools.
"""
type Search {
  """
  Access administrative search configuration operations for previewing indexed content.
  """
  configuration: SearchConfiguration
  """
  Execute a search query and return matching documents with faceted aggregations.
  """
  search(
    """
    The search query parameters including text, filters, facets, and optional semantic search settings.
    """
    query: SearchQuery
  ): SearchResult
}

"""
Administrative operations for previewing how content appears in the search index. Useful for debugging indexing issues.
"""
type SearchConfiguration {
  """
  Preview the search index representation of a collection by its UUID. Returns the indexed document as JSON.
  """
  previewCollection(
    """The UUID of the collection to preview."""
    id: UUID!
  ): JSON
  """
  Preview the search index representation of a metadata item by its UUID. Returns the indexed document as JSON.
  """
  previewMetadata(
    """The UUID of the metadata item to preview."""
    id: UUID!
  ): JSON
  """
  Preview the search index representation of a profile by its UUID. Returns the indexed document as JSON.
  """
  previewProfile(
    """The UUID of the profile to preview."""
    id: UUID!
  ): JSON
}

"""
A document returned from a search query. Each search document may resolve to a collection, metadata item, or profile depending on the type of content that matched.
"""
type SearchDocument {
  """
  The collection that matched the search query, if the result is a collection.
  """
  collection: Collection
  """
  The metadata item that matched the search query, if the result is a content item.
  """
  metadata: Metadata
  """
  The profile that matched the search query, if the result is a user profile.
  """
  profile: Profile
}

"""
Input for executing a search query across content. Supports full-text search, faceted filtering, sorting, and optional semantic/vector search.
"""
input SearchQuery {
  """
  The name of the embedder to use for semantic search. Required when using vector-based search or a non-zero semanticRatio.
  """
  embedder: String
  """
  The list of field names to compute faceted aggregations for (e.g. ['category', 'author']). Returns counts for each unique value.
  """
  facets: [String!]
  """
  The list of filter expressions to apply to narrow search results (e.g. ['category = news', 'published > 2024-01-01']).
  """
  filter: [String!]
  """The maximum number of search results to return per page."""
  limit: Int
  """The zero-based offset for paginating through search results."""
  offset: Int
  """The search query text to match against indexed content."""
  query: String!
  """
  Whether to include the vector embeddings in the search results. Useful for debugging or downstream processing.
  """
  retrieveVectors: Boolean
  """
  The ratio between semantic (vector) and keyword search results, from 0.0 (pure keyword) to 1.0 (pure semantic). Requires an embedder to be specified.
  """
  semanticRatio: Float
  """
  The list of sort expressions to order results by (e.g. ['created:desc', 'name:asc']).
  """
  sort: [String!]
  """
  The UUID of the storage system to search within. If null, the default search storage system is used.
  """
  storageSystemId: String
  """
  The name of the storage system to search within. Alternative to storageSystemId for lookup by name.
  """
  storageSystemName: String
  """
  A pre-computed vector embedding to use for similarity search. Alternative to text-based semantic search.
  """
  vector: [Float!]
}

"""
The result of a search query, containing the matched documents, estimated total hit count, and faceted aggregations.
"""
type SearchResult {
  """The list of documents matching the search query, ordered by relevance."""
  documents: [SearchDocument!]!
  """
  The estimated total number of documents matching the query across all pages. Useful for pagination.
  """
  estimatedHits: Int!
  """
  The faceted aggregations computed for the search results, allowing users to filter by categories.
  """
  facets: [SearchResultFacet!]!
}

"""
A single facet value returned from a search query, representing a filterable category and the number of matching documents.
"""
type SearchResultFacet {
  """The number of documents matching this facet value."""
  count: Int!
  """
  The field name that this facet belongs to (e.g. 'category', 'author', 'type').
  """
  field: String!
  """The specific value within the facet field (e.g. 'news', 'tutorial')."""
  value: String!
}

"""
Root query type for security features, providing access to groups, login, and principal management
"""
type Security {
  """List of all available permission action names"""
  actions: [String!]!
  """
  Access admin-only account administration queries (e.g. finding duplicate accounts to merge)
  """
  admin: AdminQuery!
  """
  Access API token queries for managing long-lived programmatic access tokens
  """
  apiTokens: ApiTokens!
  """Access security group queries for listing and searching groups"""
  groups: Groups!
  """Access login queries for password-based authentication"""
  login: Login!
  """Access passkey queries for listing registered WebAuthn credentials"""
  passkeys: Passkeys!
  """The currently authenticated principal"""
  principal: Principal
  """Access principal queries for listing and retrieving user accounts"""
  principals: Principals!
  """
  Enabled third-party providers available for sign-in and account linking
  """
  thirdPartyProviders: [ThirdPartyType!]! @deprecated(reason: "No longer supported")
}

"""
Root mutation type for security features, providing access to authentication, authorization, group management, and signup
"""
type SecurityMutation {
  """
  Add a principal to a security group, granting them the group's permissions
  """
  addPrincipalGroup(groupId: UUID!, principalId: UUID!): Boolean!
  """
  Access admin-only account administration mutations (duplicate-account merge)
  """
  admin: AdminMutation!
  """
  Access API token mutations for creating, revoking, and managing long-lived programmatic access tokens
  """
  apiTokens: ApiTokensMutation!
  """
  Connect an additional third-party (OAuth) login to the currently authenticated account
  """
  connectThirdParty(token: String!, type: ThirdPartyType!): Boolean!
  """
  Remove a specific credential from a principal. Used to disconnect OAuth providers or remove password credentials. Cannot remove the last credential.
  """
  deleteCredential(identifier: String!, principalId: UUID!, type: CredentialType!): Boolean!
  """Remove all expired refresh tokens"""
  expireRefreshTokens: Boolean!
  """
  Access mutation operations for creating, editing, and deleting security groups
  """
  groups: GroupsMutation!
  """
  Access account-linking mutations for completing a pending link after a sign-up collision
  """
  link: LinkMutation!
  """
  Access mutation operations for authentication, password recovery, and token refresh
  """
  login: LoginMutation!
  """Access passkey mutations for managing registered WebAuthn credentials"""
  passkeys: PasskeysMutation!
  """
  Set a new password using a verification token (typically from an email verification flow)
  """
  password(newPassword: String!, verificationToken: String!): Boolean!
  """
  Access mutation operations for managing the current principal's credentials and profile
  """
  principal: PrincipalMutation!
  """
  Remove a principal from a security group, revoking the group's permissions
  """
  removePrincipalGroup(groupId: UUID!, principalId: UUID!): Boolean!
  """
  Resend the email verification message for a principal that has not yet been verified
  """
  resendVerification(principalId: UUID!): Boolean!
  """
  Send a password reset email to a principal, initiating the forgot-password flow
  """
  sendPasswordReset(principalId: UUID!): Boolean!
  """
  Administratively set a new password for a principal, bypassing the old-password requirement
  """
  setPassword(password: String!, principalId: UUID!): Boolean!
  """Access mutation operations for user registration and account creation"""
  signup: SignupMutation!
}

"""
A named audience segment used to target groups of profiles for banners, email blasts, and push notifications.
"""
type Segment {
  """The UUID of the analytics query used for dynamic segment evaluation."""
  analyticsQueryId: UUID
  """Additional configuration stored as JSON for segment evaluation."""
  configuration: JSON
  """The timestamp when this segment was created."""
  created: DateTime!
  """A description of the segment's purpose and targeting criteria."""
  description: String!
  """
  The cron expression from the linked scheduled job, resolved at query time.
  """
  evaluationSchedule: String
  """The unique identifier of the segment."""
  id: UUID!
  """The timestamp of the last audience evaluation for dynamic segments."""
  lastEvaluated: DateTime
  """The current number of profiles that are members of this segment."""
  memberCount: Long!
  """The profile members of this segment, with pagination."""
  members(
    """The maximum number of members to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [SegmentMember!]!
  """The timestamp when this segment was last modified."""
  modified: DateTime!
  """The display name of the segment."""
  name: String!
  """
  The UUID of the scheduler job that drives automatic evaluation. Null when no schedule is set.
  """
  scheduledJobId: UUID
  """The lifecycle status of the segment."""
  status: SegmentStatus!
  """How the segment's audience membership is computed."""
  type: SegmentType!
}

"""Input for creating or updating a segment definition."""
input SegmentInput {
  """
  The UUID of an analytics query whose results define dynamic segment membership. Required for DYNAMIC segments.
  """
  analyticsQueryId: UUID
  """
  Additional configuration stored as JSON for segment evaluation (e.g., query parameters, filters).
  """
  configuration: JSON
  """A description of the segment's purpose and targeting criteria."""
  description: String
  """
  A cron expression for automatic periodic evaluation of a dynamic segment. Set to null to disable scheduled evaluation.
  """
  evaluationSchedule: String
  """The display name of the segment."""
  name: String!
  """The lifecycle status of the segment."""
  status: SegmentStatus
  """How the segment's audience membership is computed."""
  type: SegmentType!
}

"""Associates a profile with a segment, representing audience membership."""
type SegmentMember {
  """The timestamp when the profile was added to the segment."""
  addedAt: DateTime!
  """The profile associated with this membership."""
  profile: Profile
  """The UUID of the member profile."""
  profileId: UUID!
  """The UUID of the segment."""
  segmentId: UUID!
}

"""
Lifecycle status of a segment, controlling whether it is actively used for audience evaluation.
"""
enum SegmentStatus {
  """The segment is active and its audience is being evaluated."""
  ACTIVE
  """The segment is archived and no longer in use."""
  ARCHIVED
  """The segment is being drafted and is not yet active."""
  DRAFT
  """The segment was previously active but has been paused."""
  PAUSED
}

"""Determines how a segment's audience membership is computed."""
enum SegmentType {
  """
  Membership is computed at evaluation time by executing an analytics query via Trino.
  """
  DYNAMIC
  """
  Implicitly includes all users, including anonymous visitors. No explicit membership required.
  """
  EVERYONE
  """Membership is a manually curated list of profile IDs."""
  STATIC
}

"""Query operations for retrieving audience segments."""
type Segments {
  """Retrieve a paginated list of all segments."""
  all(
    """The maximum number of segments to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [Segment!]!
  """Retrieve a single segment by its identifier."""
  segment(
    """The UUID of the segment to retrieve."""
    id: UUID!
  ): Segment
  """Retrieve all segments that a specific profile belongs to."""
  segmentsByProfile(
    """The UUID of the profile."""
    profileId: UUID!
  ): [Segment!]!
}

"""Mutation operations for managing audience segments."""
type SegmentsMutation {
  """Create a new audience segment."""
  add(
    """The segment definition."""
    segment: SegmentInput!
  ): Segment!
  """Add profiles to a static segment's membership."""
  addMembers(
    """The profile UUIDs to add as members."""
    profileIds: [UUID!]!
    """The UUID of the segment."""
    segmentId: UUID!
  ): Boolean!
  """Delete a segment and all associated membership data."""
  delete(
    """The UUID of the segment to delete."""
    id: UUID!
  ): Boolean!
  """Update an existing segment."""
  edit(
    """The UUID of the segment to update."""
    id: UUID!
    """The updated segment definition."""
    segment: SegmentInput!
  ): Segment!
  """
  Evaluate a dynamic segment by executing its analytics query and refreshing membership.
  """
  evaluate(
    """The UUID of the dynamic segment to evaluate."""
    segmentId: UUID!
  ): Segment!
  """
  Execute an analytics query and append the resulting profile IDs to a static segment's membership. Duplicates are silently ignored. The query must return rows containing a profile_id column.
  """
  populateFromQuery(
    """
    The UUID of the analytics query to execute. The query must return a profile_id column.
    """
    analyticsQueryId: UUID!
    """The UUID of the static segment to populate."""
    segmentId: UUID!
  ): Segment!
  """
  Execute an analytics query and remove the resulting profile IDs from a static segment's membership. Profile IDs not currently in the segment are silently ignored.
  """
  removeFromQuery(
    """
    The UUID of the analytics query to execute. The query must return a profile_id column.
    """
    analyticsQueryId: UUID!
    """The UUID of the static segment to remove members from."""
    segmentId: UUID!
  ): Segment!
  """
  Remove all profiles from a static segment that are also members of another segment. This performs a set subtraction: target segment minus source segment.
  """
  removeFromSegment(
    """
    The UUID of the segment whose members should be removed from the target segment.
    """
    removeSegmentId: UUID!
    """The UUID of the static segment to remove members from."""
    segmentId: UUID!
  ): Segment!
  """Remove profiles from a segment's membership."""
  removeMembers(
    """The profile UUIDs to remove."""
    profileIds: [UUID!]!
    """The UUID of the segment."""
    segmentId: UUID!
  ): Boolean!
  """
  Run a pipeline once for every member of a segment. The segment's audience is fanned out into one durable pipeline run per profile, each receiving a JSON input of the shape { segmentId, profileId }. The runs are started asynchronously by a background job under the caller's identity; returns true once the job has been enqueued.
  """
  runPipeline(
    """The UUID of the pipeline to execute for each segment member."""
    pipelineId: UUID!
    """The UUID of the segment whose members the pipeline should run for."""
    segmentId: UUID!
  ): Boolean!
}

"""Server information and health status"""
type Server {
  """Active feature flags for this server deployment."""
  features: ServerFeatures!
  """
  Current server time, useful for clock synchronization and health checks
  """
  now: DateTime!
}

"""
Server-level feature flags indicating which optional modules are active in this deployment.
"""
type ServerFeatures {
  """Whether the server is running an in-process analytics event processor."""
  analyticsProcessor: Boolean!
  """
  Whether the chat and collaboration modules are enabled (requires NATS).
  """
  chat: Boolean!
  """
  Whether the comments module (metadata comments + moderation) is enabled.
  """
  comments: Boolean!
  """Whether the community module is enabled."""
  community: Boolean!
  """
  Whether the ecommerce module (catalogs, carts, payments, subscriptions) is enabled.
  """
  ecommerce: Boolean!
  """Whether the GraphQL introspection endpoint is exposed."""
  introspection: Boolean!
  """
  Whether the Work Ops module (task/project/portfolio management) is enabled.
  """
  workops: Boolean!
}

"""Sets (upserts) a cart's billing or shipping address."""
input SetCartAddressInput {
  address1: String!
  address2: String = null
  city: String!
  country: String!
  email: String = null
  firstName: String!
  lastName: String!
  note: String = null
  phone: String!
  state: String!
  type: AddressType!
  zip: String!
}

"""Operations on one shipment. Admin."""
type ShipmentMutation {
  """
  Poll the carrier for the latest tracking reading and apply it (advances status, never backwards).
  """
  refreshTracking: EcomShipment!
  """
  Re-run the packer with the company's current containers and rebuild this awaiting shipment's parcels.
  """
  repack: EcomShipment!
  """
  Mark the shipment shipped: draw down its inventory, set carrier/tracking, and advance the order toward COMPLETE.
  """
  ship(carrier: String, tracking: String): EcomShipment!
}

"""
A shipment's single lifecycle: we set AWAITING then SHIPPED; the carrier advances IN_TRANSIT →
OUT_FOR_DELIVERY → DELIVERED via tracking. RETURNED/FAILURE are carrier terminal off-ramps; CANCELLED
is an admin override.
"""
enum ShipmentStatus {
  AWAITING
  CANCELLED
  DELIVERED
  FAILURE
  IN_TRANSIT
  OUT_FOR_DELIVERY
  RETURNED
  SHIPPED
  UNABLE_TO_PACKAGE
}

"""
The offered shipping rates and the customer's selection, on a SHIPPING line.
"""
type ShippingCartConfiguration {
  options: [ShippingRate!]!
  selected: ShippingRate
  type: String!
}

"""
A configured shipping-rate source. Behavior is a DI-registered ShippingProvider implementation
selected by providerKey.
"""
type ShippingProvider {
  company: Company!
  """Provider settings. Admin-permission-gated."""
  configuration: ProviderConfiguration!
  id: UUID!
  """Business key, unique across the module."""
  key: String!
  name: String!
  """DI key of the provider implementation (e.g. shippo, fixed-rate)."""
  providerKey: String!
}

"""Registers a shipping provider configuration."""
input ShippingProviderInput {
  companyId: UUID!
  configuration: JSON = null
  """Business key, unique across the module."""
  key: String!
  name: String!
  """DI key of the provider implementation."""
  providerKey: String!
}

"""A quoted shipping rate option."""
type ShippingRate {
  amount: Money!
  carrier: String!
  """Carrier's delivery-time description, if provided."""
  durationTerms: String
  serviceLevel: String!
  """Opaque token identifying this rate; pass to setShipping to select it."""
  token: String!
}

"""
A pre-signed URL for uploading or downloading content, with optional required headers
"""
type SignedUrl {
  """HTTP headers that must be included when making requests to this URL"""
  headers: [SignedUrlHeader!]!
  """The pre-signed URL for upload or download"""
  url: String!
}

"""An HTTP header name-value pair required for signed URL requests"""
type SignedUrlHeader {
  """Header name (e.g. 'Content-Type', 'x-amz-content-sha256')"""
  name: String!
  """Header value"""
  value: String!
}

"""
Mutation operations for user registration, including password-based signup, third-party OAuth signup, and email verification
"""
type SignupMutation {
  """
  Register a new user with an identifier (email), password, and initial profile. Optional languageTag sets the preferred language.
  """
  password(identifier: String!, languageTag: String, password: String!, profile: ProfileInput!): Principal! @deprecated(reason: "Use passwordV2, which returns a SignupResult that can carry an account-link challenge when the email already belongs to a verified account; this field throws an error in that case.")
  """
  Register a new user with an identifier (email), password, and initial profile. Returns a SignupResult that is a link challenge when the email already belongs to a verified account, so the client can complete the link instead of failing. The optional originator identifies the originating client/app; it is stamped on the new credential and echoed back.
  """
  passwordV2(identifier: String!, languageTag: String, originator: String, password: String!, profile: ProfileInput!): SignupResult!
  """
  Verify a new account's email address using the verification token sent during password signup
  """
  passwordVerify(verificationToken: String!): Boolean! @deprecated(reason: "Use passwordVerifyV2, which returns a SignupResult that can carry an account-link challenge when the proven email already belongs to a verified account; this field throws an error in that case.")
  """
  Verify a new account's email address using the verification token sent during password signup. Returns a SignupResult that is a link challenge when the proven email already belongs to a verified account, so the client can complete the link instead of failing.
  """
  passwordVerifyV2(verificationToken: String!): SignupResult!
  """Resend the email verification message for a pending signup"""
  resendPasswordVerification(identifier: String!): Boolean!
  """
  Register or sign in using a third-party OAuth provider (Google, Facebook, or Apple). Returns tokens and principal information.
  """
  thirdparty(languageTag: String, token: String!, type: ThirdPartyType!): LoginResponse! @deprecated(reason: "Use thirdpartyV2, which returns a SignupResult that can carry an account-link challenge when the verified email already belongs to a different account; this field throws an error in that case.")
  """
  Register or sign in using a third-party OAuth provider (Google, Facebook, or Apple). Returns a SignupResult that is a link challenge when the verified email already belongs to a different account. The optional originator identifies the originating client/app; it is stamped on a newly-created credential and echoed back.
  """
  thirdpartyV2(languageTag: String, originator: String, token: String!, type: ThirdPartyType!): SignupResult!
}

"""
The outcome of a sign-up. Exactly one field is non-null: principal (password sign-up succeeded), loginResponse (third-party sign-up succeeded), or linkChallenge (the email already has a verified account — drive the link challenge).
"""
type SignupResult {
  """
  Present when the email already belongs to an existing verified account; complete the link with security.link.*.
  """
  linkChallenge: LinkChallenge
  """The account and tokens, when a third-party sign-up succeeded."""
  loginResponse: LoginResponse
  """The newly-created account, when a password sign-up succeeded."""
  principal: Principal
}

"""
Input for providing a signup token that grants access to a specific context (e.g. an organization)
"""
input SignupTokenInput {
  """The token string value"""
  token: String!
  """The type of signup token being provided"""
  type: SignupTokenType!
}

"""The context type that a signup token grants access to"""
enum SignupTokenType {
  """
  A token that grants access to join a specific organization during signup
  """
  ORGANIZATION
}

"""A selected variant (e.g. clothing size) on a product line."""
type SizeCartItemConfiguration {
  size: String!
  type: String!
}

"""
An external content source that can be used to import or sync content into Bosca
"""
type Source {
  """Source-specific configuration (connection details, API keys, etc.)"""
  configuration: JSON!
  """Description of what this source provides"""
  description: String!
  """Unique identifier for this source"""
  id: UUID!
  """Display name of the source"""
  name: String!
}

"""Input for creating or updating a content source"""
input SourceInput {
  """Source-specific configuration"""
  configuration: JSON!
  """Description of what this source provides"""
  description: String!
  """Display name for the source"""
  name: String!
}

"""Mutation operations for managing content sources"""
type SourceMutation {
  """Register a new content source"""
  add(source: SourceInput!): Source!
  """Delete a content source"""
  delete(id: UUID!): Boolean
  """Update an existing content source"""
  edit(id: UUID!, source: SourceInput!): Source!
}

"""Links an entity to a file in a git repository."""
input SourceRefInput {
  """Path to the file in the repository."""
  path: String!
  """Branch, tag, or commit SHA to track. Defaults to 'main'."""
  ref: String! = "main"
  """The repository containing the file."""
  repositoryId: UUID!
}

"""Tracks the lifecycle of content sourced from an external URL"""
enum SourceStatus {
  """Content remains at the source URL and is fetched on demand"""
  EXTERNAL
  """Download from the source URL failed"""
  FAILED
  """Content has been downloaded and stored locally"""
  IMPORTED
  """Content is being downloaded from the source URL"""
  IMPORTING
  """Import has been queued but not yet started"""
  PENDING
}

"""Query operations for browsing content sources"""
type Sources {
  """List all registered content sources"""
  all: [Source!]!
  """Get a specific source by ID"""
  source(id: UUID!): Source
}

type StandardPlanConfiguration {
  type: String!
}

"""A plain product with no type-specific configuration."""
type StandardProductConfiguration {
  type: String!
}

input StartWorkOpsPatchReleaseInput {
  """
  The affected projects from the source release to include in the roll-forward patch.
  """
  projectIds: [UUID!]!
}

input StartWorkOpsSprintInput {
  committedTaskIds: [UUID!]! = []
  endDate: DateTime
  expectedVersion: Long!
  sprintId: UUID!
  startDate: DateTime
}

"""
A storage system configuration that defines an external service for indexing, storing, or embedding content. Storage systems integrate with search engines, file stores, and vector databases.
"""
type StorageSystem {
  """
  The connection and behavior configuration for this storage system, stored as JSON. Structure depends on the system type.
  """
  configuration: JSON
  """A description of this storage system's purpose and configuration."""
  description: String!
  """The unique identifier of this storage system."""
  id: UUID!
  """
  The list of AI models associated with this storage system, used for tasks such as generating embeddings or processing content.
  """
  models: [StorageSystemModel!]!
  """The human-readable name of this storage system."""
  name: String!
  """
  The type category of this storage system (SEARCH, SUPPLEMENTARY, or VECTOR).
  """
  type: StorageSystemType!
}

"""Input for creating or updating a storage system configuration."""
input StorageSystemInput {
  """
  The connection and behavior configuration stored as JSON. Structure depends on the system type.
  """
  configuration: JSON
  """A description of this storage system's purpose and configuration."""
  description: String!
  """The list of AI model associations for this storage system."""
  models: [StorageSystemModelInput!]!
  """The human-readable name of this storage system."""
  name: String!
  """
  The type category of this storage system (SEARCH, SUPPLEMENTARY, or VECTOR).
  """
  type: StorageSystemType!
}

"""
An AI model association for a storage system, defining which model is used for content processing and how it is configured.
"""
type StorageSystemModel {
  """
  The model-specific configuration stored as JSON, such as embedding dimensions, tokenizer settings, or processing parameters.
  """
  configuration: JSON!
  """
  The resolved AI model entity. Null if the model has been deleted or is not accessible.
  """
  model: Model
  """The UUID of the AI model used by this storage system."""
  modelId: UUID!
}

"""Input for associating an AI model with a storage system."""
input StorageSystemModelInput {
  """
  The model-specific configuration stored as JSON, such as embedding dimensions or processing parameters.
  """
  configuration: JSON!
  """The UUID of the AI model to associate with the storage system."""
  modelId: UUID!
}

"""
The category of a storage system, indicating its primary purpose for content processing and retrieval.
"""
enum StorageSystemType {
  """
  A full-text search index (e.g. Meilisearch) used for keyword and faceted search across content.
  """
  SEARCH
  """
  A supplementary file storage system used for storing additional files associated with content (e.g. thumbnails, attachments).
  """
  SUPPLEMENTARY
  """
  A vector embedding store used for semantic search and similarity queries powered by AI models.
  """
  VECTOR
}

"""Query operations for retrieving storage system configurations."""
type StorageSystems {
  """Retrieve all registered storage systems."""
  all: [StorageSystem!]!
  """
  Retrieve a single storage system by its unique identifier. Returns null if the system does not exist.
  """
  storageSystem(
    """The UUID of the storage system to retrieve."""
    id: UUID!
  ): StorageSystem
}

"""
Mutation operations for managing storage systems and triggering reindexing operations.
"""
type StorageSystemsMutation {
  """Create a new storage system with the specified configuration."""
  add(
    """The storage system configuration to create."""
    storageSystem: StorageSystemInput!
  ): StorageSystem
  """
  Delete a storage system by its unique identifier. Returns true if the deletion was successful.
  """
  delete(
    """The UUID of the storage system to delete."""
    id: UUID!
  ): Boolean!
  """Update an existing storage system's configuration."""
  edit(
    """The UUID of the storage system to update."""
    id: UUID!
    """The updated storage system configuration."""
    storageSystem: StorageSystemInput!
  ): StorageSystem
  """
  Trigger a reindex operation to rebuild search indexes or vector embeddings. Can target specific content types and storage systems.
  """
  reindex(
    """
    The number of items to process per batch during reindexing. Controls memory usage and throughput.
    """
    batchSize: Int
    """Whether to reindex collections."""
    collections: Boolean
    """
    Whether to delete existing index data before reindexing. Useful for a clean rebuild.
    """
    deleteFirst: Boolean
    """Whether to reindex metadata (content items)."""
    metadata: Boolean
    """Whether to reindex profiles."""
    profiles: Boolean
    """
    The name of the specific storage system to reindex. If null, reindexes all storage systems.
    """
    storageName: String
  ): Boolean
}

"""
A selling context: binds a company, the catalog it sells, the default payment provider, the shipping
line product, and cart expiration policy. Carts, payments, plans, and promotions are all
store-scoped.
"""
type Store {
  """
  How long carts live without activity before the expiration sweep reclaims them.
  """
  cartExpirationSeconds: Int!
  catalog: Catalog!
  company: Company!
  id: UUID!
  """
  Unique storefront key (slug) — replaces the legacy minion instance binding.
  """
  identifier: String!
  name: String!
  """Default provider used to settle payments in this store."""
  paymentProvider: PaymentProvider
  """The catalog entry used to add shipping as a cart line."""
  shippingCatalogProduct: CatalogProduct!
  type: StoreType!
}

"""Creates or edits a store."""
input StoreInput {
  """Cart lifetime (seconds) before the expiration sweep reclaims it."""
  cartExpirationSeconds: Int! = 86400
  catalogId: UUID!
  companyId: UUID!
  """Unique storefront key (slug)."""
  identifier: String!
  name: String!
  """Default payment provider for the store."""
  paymentProviderId: UUID!
  """The catalog entry used to add shipping as a cart line."""
  shippingCatalogProductId: UUID!
  type: StoreType!
}

"""Mutations scoped to one store. Admin."""
type StoreMutation {
  """Edit the store's bindings and cart policy."""
  edit(input: StoreInput!): Store!
}

"""
Whether a store is an online (VIRTUAL) or in-person (PHYSICAL) selling context.
"""
enum StoreType {
  PHYSICAL
  VIRTUAL
}

"""Store creates and per-store operations. Admin."""
type StoresMutation {
  """
  Create a store (selling context binding a catalog, payment provider, and cart policy).
  """
  add(input: StoreInput!): Store!
  """Operations on an existing store."""
  store(id: UUID!): StoreMutation!
}

"""
A named bundle of Studio subsystem access that can be assigned to user profiles.
"""
type StudioPersona {
  """The timestamp when this persona was created."""
  created: DateTime!
  """A description of what this persona grants access to."""
  description: String
  """Whether this persona is currently active and can be assigned."""
  enabled: Boolean!
  """The unique identifier of this persona."""
  id: UUID!
  """The timestamp when this persona was last modified."""
  modified: DateTime!
  """The display name of this persona."""
  name: String!
  """
  The list of Studio subsystem identifiers this persona grants access to.
  """
  subsystemIds: [String!]!
}

"""Input for creating or updating a Studio persona definition."""
input StudioPersonaInput {
  """A description of what this persona grants access to."""
  description: String
  """Whether the persona is active."""
  enabled: Boolean
  """The UUID of an existing persona to update. Null when creating."""
  id: UUID
  """The display name of the persona."""
  name: String!
  """
  The list of Studio subsystem identifiers this persona grants access to.
  """
  subsystemIds: [String!]!
}

"""Query operations for Studio persona management."""
type StudioPersonas {
  """Retrieve all persona definitions. Requires administrator access."""
  all: [StudioPersona!]!
  """Retrieve all personas assigned to a profile."""
  byProfile(
    """The UUID of the profile to look up personas for."""
    profileId: UUID!
  ): [StudioPersona!]!
  """
  Retrieve a single persona by its unique identifier. Requires administrator access.
  """
  persona(
    """The UUID of the persona to retrieve."""
    id: UUID!
  ): StudioPersona
}

"""
Mutation operations for Studio persona management and profile assignment.
"""
type StudioPersonasMutation {
  """Assign a persona to a profile. Requires administrator access."""
  assignToProfile(
    """The UUID of the persona to assign."""
    personaId: UUID!
    """The UUID of the profile to assign the persona to."""
    profileId: UUID!
  ): Boolean!
  """Create a new persona definition. Requires administrator access."""
  create(
    """The persona definition to create."""
    input: StudioPersonaInput!
  ): StudioPersona!
  """
  Delete a persona definition and all its profile assignments. Requires administrator access.
  """
  delete(
    """The UUID of the persona to delete."""
    id: UUID!
  ): Boolean!
  """
  Remove a persona assignment from a profile. Requires administrator access.
  """
  removeFromProfile(
    """The UUID of the persona to remove."""
    personaId: UUID!
    """The UUID of the profile to remove the persona from."""
    profileId: UUID!
  ): Boolean!
  """Update an existing persona definition. Requires administrator access."""
  update(
    """The persona definition to update. The id field must be set."""
    input: StudioPersonaInput!
  ): StudioPersona!
}

"""
Input for defining a rendering style applied to scripture components, controlling text appearance and layout
"""
input StyleInput {
  """Text alignment (e.g. 'left', 'center', 'right', 'justify')"""
  align: String
  """CSS font weight (e.g. 'bold', 'normal', '700')"""
  fontWeight: String
  """Unique identifier for this style, used to reference it from components"""
  id: String!
  """
  Whether this style is applied to a verse reference element (e.g. verse number)
  """
  reference: Boolean!
  """Text indentation specification for poetry or block quotes"""
  textIndent: TextIndentInput
}

"""Input for submitting a review."""
input SubmitGitReviewInput {
  body: String
  pullRequestId: UUID!
  status: GitReviewStatus!
}

"""
Payment supplied at cart submission. The fields used depend on `type`: CREDIT_CARD uses `token` (a
single-use client token, e.g. Stripe) OR `creditCard` (a raw PAN, e.g. BluePay); CHECK uses
checkNumber; COMPANY_CREDIT uses companyCreditNumber; ACCOUNT_CREDIT draws the cart account's
balance; CASH needs none.
"""
input SubmitPaymentInput {
  """
  Amount this payment covers; omit for the full remaining due. A cart can take several payments (split tender), each ≤ the remaining due.
  """
  amount: Money = null
  """Check number, for CHECK payments."""
  checkNumber: String = null
  """Redeemable company-credit number, for COMPANY_CREDIT payments."""
  companyCreditNumber: String = null
  """
  Raw card for PAN-processing gateways when no token is supplied. Transient — never stored.
  """
  creditCard: CreditCardInput = null
  email: String = null
  """Store a reusable payment method for later renewals."""
  save: Boolean = false
  token: String = null
  type: PaymentType = CREDIT_CARD
}

type SubmittedForm {
  id: UUID!
  type: FormSchemaType!
}

"""
Subscribes an account to a plan. saved is an optional reusable payment method (JSON).
"""
input SubscribeInput {
  accountId: UUID!
  planId: UUID!
  saved: JSON
  storeId: UUID!
}

"""
The root subscription type for the Bosca API. Provides real-time event streams for content changes via WebSocket connections.
"""
type Subscription {
  """
  Subscribe to new messages in a chat session, receiving each message as it is added to the history
  """
  aiChatHistory(
    """The unique identifier of the chat session to subscribe to"""
    sessionId: UUID!
  ): ChatHistoryMessage!
  """
  Subscribe to processing state changes for a chat session (true when the dispatcher starts working, false when it finishes)
  """
  aiChatProcessing(
    """The unique identifier of the chat session to monitor"""
    sessionId: UUID!
  ): Boolean!
  """
  Subscribe to status changes for a chat session (e.g., streaming started, completed, or failed)
  """
  aiChatStatus(
    """The unique identifier of the chat session to monitor"""
    sessionId: UUID!
  ): ChatSessionStatus!
  """Subscribe to real-time chat message events in a specific channel"""
  chatMessage(channelId: UUID!): ChatMessageEvent!
  """
  Subscribe to real-time events for collection changes (create, update, delete). API tokens require the read-only `collections:view` scope.
  """
  collection: CollectionEvent!
  """Subscribe to real-time feature flag update events."""
  flagUpdated: FlagUpdated!
  """
  Streams pipeline status changes after verifying VIEW access to the selected repository.
  """
  gitPipelineEvents(repositoryId: UUID!): GitPipelineStatusEvent!
  """
  Streams pull-request activity after verifying VIEW access to the selected repository.
  """
  gitPullRequestEvents(repositoryId: UUID!): GitPullRequestActivityEvent!
  """
  Stream currently-active sessions — the retained snapshot first, then live heartbeats as they arrive. Omit appId for every application, or pass one to filter to a single app. Omit appVersion for all versions, or pass one to filter to a single version.
  """
  liveSessions(appId: String, appVersion: String): LiveSession!
  """
  Subscribe to real-time events for metadata item and content changes (create, update, delete). API tokens require the read-only `content:view` scope.
  """
  metadata: MetadataEvent!
  """Subscribe to real-time presence update events in a specific channel"""
  onPresenceUpdate(channelId: UUID!): PresenceUpdateEvent!
  """
  Subscribe to real-time reaction add/remove events in a specific channel
  """
  onReaction(channelId: UUID!): MessageReactionEvent!
  """Subscribe to real-time typing indicator events in a specific channel"""
  onUserTyping(channelId: UUID!): UserTypingEvent!
  """Live run + per-node status changes for a durable run. Admin-gated."""
  pipelineRun(runId: UUID!): PipelineRunUpdate!
  pipelineStepLogs(repositoryId: UUID!, stepId: UUID!): GitPipelineLogLine!
  """
  Subscribe to time event change notifications for a specific metadata item. Emits an event whenever the item's timeline events are modified by a background process. API tokens require the read-only `content:view` scope.
  """
  timeEventChanged(metadataId: UUID!): TimeEventChangedEvent!
  """
  Subscribe to upload progress events for a specific metadata item during the server-side storage transfer phase. API tokens require the read-only `content:view` scope.
  """
  uploadProgress(metadataId: UUID!): UploadProgressEvent!
}

"""
The concrete plan chosen within the product's plan group, on a SUBSCRIPTION line.
"""
type SubscriptionCartItemConfiguration {
  planId: UUID!
  type: String!
}

"""Mutations on one subscription. Admin."""
type SubscriptionMutation {
  """Cancel the subscription."""
  cancel: EcomSubscription!
  """
  Schedule a plan change effective at the next renewal; returns the pending successor.
  """
  changePlan(planId: UUID!): EcomSubscription!
}

"""A subscription plan within a group."""
type SubscriptionPlan {
  """Plan-specific behavior (polymorphic)."""
  configuration: PlanConfiguration!
  created: DateTime!
  description: String!
  expires: DateTime
  group: SubscriptionPlanGroup!
  id: UUID!
  interval: Int!
  intervalUnit: IntervalUnit!
  key: String!
  modified: DateTime!
  name: String!
  price: Money!
  status: PlanStatus!
}

"""
A family of subscription plans; an account may hold one live subscription per group.
"""
type SubscriptionPlanGroup {
  created: DateTime!
  description: String!
  id: UUID!
  key: String!
  modified: DateTime!
  name: String!
  """Renewal payment attempts before a subscription goes UNPAID."""
  paymentRetries: Int!
}

"""
A SUBSCRIPTION product bound to a plan group; checkout creates a recurring purchase.
"""
type SubscriptionProductConfiguration {
  planGroupId: UUID!
  type: String!
}

"""Subscription lifecycle states."""
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  DELETED
  EXPIRED
  INACTIVE
  PAST_DUE
  PENDING
  TRIALING
  UNPAID
}

"""Direct subscribe + per-subscription operations. Admin."""
type SubscriptionsMutation {
  """Subscribe an account to a plan directly (admin path)."""
  subscribe(input: SubscribeInput!): EcomSubscription!
  """Operations on an existing subscription."""
  subscription(id: UUID!): SubscriptionMutation!
}

"""
A resolved identifier object for a supplementary content item, containing the IDs needed to locate and access the supplementary within its parent metadata item
"""
type SupplementaryIdObject {
  """ID of the parent metadata item that owns this supplementary content"""
  contentId: UUID!
  """Unique identifier for this supplementary item"""
  id: UUID!
  """
  Key that identifies this supplementary within its parent (e.g. 'thumbnail', 'transcript', 'mp3')
  """
  key: String!
  """
  Storage plan ID associated with this supplementary content, null if using the default plan
  """
  planId: UUID
}

"""Summary of a sync operation against an external provider"""
type SyncResult {
  """Human-readable error messages for items that could not be synchronized"""
  errors: [String!]!
  """Source strings added to the provider during this sync"""
  stringsAdded: Int!
  """Source strings updated on the provider during this sync"""
  stringsUpdated: Int!
  """Translations added in Bosca during this sync"""
  translationsAdded: Int!
  """Translations updated in Bosca during this sync"""
  translationsUpdated: Int!
}

"""
A read-only event projected from another module. These do not live in the
calendar table and are intended for admin-only timeline views.
"""
type SyntheticEvent {
  """True when the underlying job or action has finished executing."""
  completed: Boolean!
  """Optional human-readable detail (channel, description, etc.)."""
  description: String!
  """Exclusive end of the event."""
  endsAt: DateTime!
  """
  Identifier of the source row (for example a campaign UUID or a scheduled-job UUID).
  """
  id: UUID!
  """Where this event was projected from."""
  source: SyntheticEventSource!
  """Inclusive start of the event."""
  startsAt: DateTime!
  """Display title sourced from the underlying record's name."""
  title: String!
}

"""Origin of a synthesized event projected from another module."""
enum SyntheticEventSource {
  """A scheduled or active campaign from the segmentation module."""
  CAMPAIGN
  """An upcoming scheduler job execution."""
  SCHEDULED_JOB
  """
  A metadata item with a deferred workflow transition (scheduled publish or advertise).
  """
  SCHEDULED_PUBLISH
}

"""
Per-jurisdiction tax breakdown for one line; `taxes` is the line total.
"""
type Tax {
  city: Money!
  country: Money!
  district: Money!
  state: Money!
  taxes: Money!
}

"""
A single attribute definition within a template, describing a field's schema, data type, UI presentation, and associated automation
"""
type TemplateAttribute {
  """
  Optional JSON configuration for the attribute, used to customize behavior or provide additional settings
  """
  configuration: JSON
  """
  Human-readable description of the attribute's purpose, displayed in editors and documentation
  """
  description: String!
  """
  Unique identifier key for this attribute within the template, used to reference it in metadata and queries
  """
  key: String!
  """
  Whether this attribute accepts multiple values (true) or a single value (false)
  """
  list: Boolean!
  """
  Where this attribute is stored — on the item itself or on a relationship between items
  """
  location: AttributeLocation!
  """Display name for the attribute, shown in the UI"""
  name: String!
  """
  Optional key referencing a supplementary data source that provides additional context or options for this attribute
  """
  supplementaryKey: String
  """
  Optional list of tools associated with this attribute that can execute queries and return results
  """
  tools: [TemplateTool!]
  """
  The data type of the attribute value (e.g., STRING, INT, COLLECTION), used for validation and serialization
  """
  type: AttributeType!
  """
  The UI widget type to use when rendering this attribute in a form or editor (e.g., INPUT, TEXTAREA, IMAGE)
  """
  ui: AttributeUiType!
  """
  Optional list of workflows associated with this attribute that can be triggered on attribute changes
  """
  workflows: [TemplateWorkflow!]
}

"""
Input for creating or updating a template attribute definition within a template
"""
input TemplateAttributeInput {
  """
  Optional JSON configuration for customizing the attribute's behavior or providing additional settings
  """
  configuration: JSON
  """Human-readable description of the attribute's purpose"""
  description: String!
  """Unique identifier key for this attribute within the template"""
  key: String!
  """
  Whether this attribute accepts multiple values (true) or a single value (false)
  """
  list: Boolean!
  """
  Where this attribute is stored — on the item itself or on a relationship. Defaults to ITEM if not specified
  """
  location: AttributeLocation
  """Display name for the attribute, shown in the UI"""
  name: String!
  """
  Optional key referencing a supplementary data source for this attribute
  """
  supplementaryKey: String
  """Optional list of inline tool definitions for this attribute"""
  tools: [TemplateToolInput!]
  """
  The data type of the attribute value, used for validation and serialization
  """
  type: AttributeType!
  """
  The UI widget type to use when rendering this attribute in a form or editor
  """
  ui: AttributeUiType!
  """Optional list of workflow associations for this attribute"""
  workflows: [TemplateWorkflowInput!]
}

"""
A reusable tool definition that can be referenced by template attributes. Tools execute queries and extract results via a path expression, enabling dynamic data lookups within attribute editors.
"""
type TemplateAttributeTool {
  """Optional JSON configuration for additional tool settings or parameters"""
  configuration: JSON
  """Optional human-readable description of what this tool does"""
  description: String
  """Unique identifier for this tool"""
  id: UUID!
  """Unique key used to reference this tool programmatically"""
  key: String!
  """Display name for the tool, shown in the UI"""
  name: String!
  """
  The query string to execute when the tool is invoked (e.g., a GraphQL query or search expression)
  """
  query: String!
  """
  Optional path expression used to extract the relevant result from the query response (e.g., a JSON path)
  """
  resultPath: String
}

"""
Input for creating or updating a reusable template attribute tool definition
"""
input TemplateAttributeToolInput {
  """Optional JSON configuration for additional tool settings or parameters"""
  configuration: JSON
  """Optional human-readable description of what this tool does"""
  description: String
  """Unique key used to reference this tool programmatically"""
  key: String!
  """Display name for the tool, shown in the UI"""
  name: String!
  """The query string to execute when the tool is invoked"""
  query: String!
  """
  Optional path expression to extract the relevant result from the query response
  """
  resultPath: String
}

"""
Query operations for listing and retrieving reusable template attribute tools
"""
type TemplateAttributeTools {
  """Retrieve all template attribute tools"""
  all: [TemplateAttributeTool!]!
  """Retrieve a specific template attribute tool by its unique ID"""
  get(
    """The unique identifier of the tool to retrieve"""
    id: UUID!
  ): TemplateAttributeTool
}

"""Mutation operations for managing reusable template attribute tools"""
type TemplateAttributeToolsMutation {
  """Create a new template attribute tool and return the created tool"""
  add(
    """The tool definition to create"""
    tool: TemplateAttributeToolInput!
  ): TemplateAttributeTool!
  """
  Delete a template attribute tool by its ID. Returns true if the tool was deleted.
  """
  delete(
    """The unique identifier of the tool to delete"""
    id: UUID!
  ): Boolean
  """Update an existing template attribute tool and return the updated tool"""
  edit(
    """The unique identifier of the tool to update"""
    id: UUID!
    """The updated tool definition"""
    tool: TemplateAttributeToolInput!
  ): TemplateAttributeTool!
}

"""
A tool definition inline within a template attribute, used to execute a query and extract results for the attribute
"""
type TemplateTool {
  """Optional human-readable description of what the tool does"""
  description: String
  """Optional unique identifier for this tool instance"""
  id: UUID
  """Display name for the tool"""
  name: String!
  """
  The query string to execute when the tool is invoked (e.g., a GraphQL query or search expression)
  """
  query: String!
  """
  A path expression used to extract the relevant result from the query response (e.g., a JSON path)
  """
  resultPath: String!
}

"""
Input for creating or updating an inline tool within a template attribute
"""
input TemplateToolInput {
  """Optional human-readable description of what the tool does"""
  description: String
  """
  Optional existing tool ID — if provided, references an existing tool; if null, creates a new inline tool
  """
  id: UUID
  """Display name for the tool"""
  name: String
  """The query string to execute when the tool is invoked"""
  query: String
  """
  A path expression to extract the relevant result from the query response
  """
  resultPath: String
}

"""
A workflow association within a template attribute, controlling whether the workflow runs automatically on attribute changes
"""
type TemplateWorkflow {
  """
  Whether this workflow should automatically run when the attribute value changes, without manual triggering
  """
  autoRun: Boolean!
}

"""Input for associating a workflow with a template attribute"""
input TemplateWorkflowInput {
  """
  Whether the workflow should automatically execute when the attribute value changes
  """
  autoRun: Boolean!
  """The unique identifier of the workflow to associate with this attribute"""
  workflowId: String!
}

"""Input specifying text indentation with a numeric size and CSS unit"""
input TextIndentInput {
  """Numeric indentation size"""
  size: Float!
  """CSS unit for the indentation (e.g. 'em', 'px', 'rem')"""
  unit: String!
}

"""
Input for a text component within a scripture rendering, containing the text content and optional styling
"""
input TextInput {
  """Optional style to apply to this text component"""
  style: StyleInput
  """The text content to render"""
  text: String!
}

"""
Third-party integration extension data associated with a profile, containing external system context and synchronization state.
"""
type ThirdPartyExtension {
  """
  The third-party integration context stored as JSON, containing data from external systems.
  """
  context: JSON
}

"""
Mutation operations for synchronizing profile data with third-party external systems.
"""
type ThirdPartyExtensionMutation {
  """
  Synchronize a specific profile's data with connected third-party systems. Returns true if synchronization was initiated successfully.
  """
  sync(
    """The UUID of the profile to synchronize."""
    profileId: UUID!
  ): Boolean!
  """
  Synchronize all profiles' data with connected third-party systems. Returns true if synchronization was initiated successfully.
  """
  syncAll: Boolean!
}

"""
Supported third-party OAuth providers for social login and account linking
"""
enum ThirdPartyType {
  """Apple Sign In authentication provider"""
  APPLE
  """Facebook OAuth authentication provider"""
  FACEBOOK
  """Google OAuth 2.0 authentication provider"""
  GOOGLE
}

"""
A time-based marker on a media content timeline, representing an event or annotation at a specific millisecond offset within audio or video content
"""
type TimeEvent {
  """
  Optional JSON attributes carrying additional data specific to this event's type (validated against the type's schema if defined)
  """
  attributes: JSON
  """Timestamp when this time event was created"""
  created: DateTime!
  """
  Computed duration in milliseconds (endOffsetMs - startOffsetMs); null if endOffsetMs is not set
  """
  durationMs: Long
  """
  Optional end position of this event on the media timeline, in milliseconds from the beginning; null for point-in-time events
  """
  endOffsetMs: Long
  """Unique identifier for this time event"""
  id: UUID!
  """The ID of the metadata (media content) that this time event belongs to"""
  metadataId: UUID!
  """
  Metadata relationships associated with this time event, optionally filtered by relationship type
  """
  metadataRelationships(filter: [String!]): [TimeEventMetadataRelationship!]!
  """The version of the metadata that this time event is associated with"""
  metadataVersion: Int!
  """Timestamp when this time event was last modified"""
  modified: DateTime!
  """
  Sort order for display when multiple events share the same offset (lower values appear first)
  """
  sort: Int!
  """
  Start position of this event on the media timeline, in milliseconds from the beginning
  """
  startOffsetMs: Long!
  """The type classification of this time event"""
  type: TimeEventType!
}

"""
Real-time event emitted when time events on a metadata item's timeline are created, updated, or deleted in bulk (e.g. by a PDF import job)
"""
type TimeEventChangedEvent {
  """The number of time events that were created or affected"""
  eventCount: Int!
  """The UUID of the metadata item whose timeline was modified"""
  metadataId: UUID!
  """The version of the metadata item whose timeline was modified"""
  metadataVersion: Int!
}

"""Filter criteria for querying time events on a media timeline"""
input TimeEventFilter {
  """
  Only return events that are active at this exact millisecond offset (startOffsetMs <= atOffsetMs and endOffsetMs >= atOffsetMs or endOffsetMs is null)
  """
  atOffsetMs: Long
  """Only return events that end at or before this millisecond offset"""
  endBeforeMs: Long
  """Only return events that start at or after this millisecond offset"""
  startAfterMs: Long
  """Only return events whose type ID is in this list"""
  types: [String!]
}

"""Input for creating or updating a time event on a media timeline"""
input TimeEventInput {
  """
  Optional JSON attributes carrying additional data specific to this event's type
  """
  attributes: JSON
  """
  Optional end position of this event on the media timeline, in milliseconds from the beginning; omit for point-in-time events
  """
  endOffsetMs: Long
  """
  Sort order for display when multiple events share the same offset (lower values appear first)
  """
  sort: Int
  """
  Start position of this event on the media timeline, in milliseconds from the beginning
  """
  startOffsetMs: Long!
  """The time event type ID classifying this event"""
  type: String!
}

"""
A typed relationship between a time event and a metadata item, allowing time events to reference multiple metadata items under different relationship semantics
"""
type TimeEventMetadataRelationship {
  """
  Optional JSON attributes providing additional context about this relationship
  """
  attributes: JSON
  """The related metadata item, resolved from metadataId"""
  metadata: Metadata!
  """The ID of the related metadata item"""
  metadataId: UUID!
  """Optional version of the related metadata item"""
  metadataVersion: Int
  """The type of relationship (e.g. 'slide', 'resource', 'reference')"""
  relationship: String!
  """The ID of the time event that owns this relationship"""
  timeEventId: UUID!
}

"""
Input for creating or updating a relationship between a time event and a metadata item
"""
input TimeEventMetadataRelationshipInput {
  """
  Optional JSON attributes providing additional context about this relationship
  """
  attributes: JSON
  """The ID of the metadata item to link"""
  metadataId: UUID!
  """Optional version of the metadata item to link"""
  metadataVersion: Int
  """The type of relationship (e.g. 'slide', 'resource', 'reference')"""
  relationship: String!
}

"""
Mutation operations for managing time event types and time events on media content timelines
"""
type TimeEventMutation {
  """Create a new time event on a specific metadata item's timeline"""
  add(metadataId: UUID!, metadataVersion: Int!, timeEvent: TimeEventInput!): TimeEvent!
  """Add a metadata relationship to a time event"""
  addMetadataRelationship(relationship: TimeEventMetadataRelationshipInput!, timeEventId: UUID!): TimeEventMetadataRelationship!
  """Create a new time event type definition (admin only)"""
  addType(type: TimeEventTypeInput!): TimeEventType!
  """
  Add an attribute definition to a time event type at the specified sort position (admin only)
  """
  addTypeAttribute(attribute: TemplateAttributeInput!, sort: Int!, typeId: String!): TimeEventType!
  """Delete a time event by its unique ID"""
  delete(id: UUID!): Boolean!
  """
  Delete multiple time events by their unique IDs and return the number actually deleted
  """
  deleteAll(ids: [UUID!]!): Int!
  """Remove a metadata relationship from a time event"""
  deleteMetadataRelationship(metadataId: UUID!, relationship: String!, timeEventId: UUID!): Boolean!
  """
  Delete all time events of a specific type from a metadata item's timeline
  """
  deleteTimeEventsByType(metadataId: UUID!, metadataVersion: Int!, type: String!): Boolean!
  """Delete a time event type definition by its string ID (admin only)"""
  deleteType(id: String!): Boolean!
  """
  Remove an attribute definition from a time event type by key (admin only)
  """
  deleteTypeAttribute(key: String!, typeId: String!): TimeEventType!
  """Update an existing time event"""
  edit(id: UUID!, timeEvent: TimeEventInput!): TimeEvent!
  """Update the attributes on an existing time event metadata relationship"""
  editMetadataRelationshipAttributes(attributes: JSON!, metadataId: UUID!, relationship: String!, timeEventId: UUID!): Boolean!
  """Update an existing time event type definition (admin only)"""
  editType(id: String!, type: TimeEventTypeInput!): TimeEventType!
  """
  Import a PDF file as timeline events on a media item. Each PDF page is rendered as an image, uploaded as metadata, and linked to a new time event via a metadata relationship. Processing happens asynchronously via a background job.
  """
  importPdfAsTimelineEvents(
    """
    The total duration of the target media in milliseconds, used to distribute events evenly
    """
    durationMs: Long!
    """The time event type ID to use for the created events"""
    eventTypeId: String!
    """The metadata ID of the uploaded PDF file to process"""
    pdfMetadataId: UUID!
    """
    The relationship type string for linking page images to events (e.g. 'slide', 'page')
    """
    relationship: String!
    """The metadata ID of the media item to create timeline events on"""
    targetMetadataId: UUID!
    """The version of the target metadata item"""
    targetMetadataVersion: Int!
  ): Boolean!
  """
  Replace all metadata relationships on a time event with the provided list
  """
  setMetadataRelationships(relationships: [TimeEventMetadataRelationshipInput!]!, timeEventId: UUID!): [TimeEventMetadataRelationship!]!
  """
  Replace all time events on a metadata item's timeline with the provided list (batch upsert)
  """
  setTimeEvents(metadataId: UUID!, metadataVersion: Int!, timeEvents: [TimeEventInput!]!): [TimeEvent!]!
  """Replace all attribute definitions on a time event type (admin only)"""
  setTypeAttributes(attributes: [TemplateAttributeInput!]!, typeId: String!): TimeEventType!
}

"""
A classification for time events, defining what kind of marker it represents (e.g. chapter, annotation, cue point) and its validation schema
"""
type TimeEventType {
  """
  Attribute definitions that describe the fields available on events of this type, following the same model as data template attributes
  """
