"""
Update input. Required `expectedVersion` is the optimistic-lock token —
mismatch surfaces as `OPTIMISTIC_LOCK_FAILED`.
"""
input UpdateWorkOpsTaskInput {
  assigneeProfileId: UUID
  """
  Set to true to clear the assignee. Takes precedence over assigneeProfileId.
  """
  clearAssignee: Boolean
  """Set to true to clear the due date. Takes precedence over dueDate."""
  clearDueDate: Boolean
  """
  Set to true to clear the original estimate. Takes precedence over originalEstimateSeconds.
  """
  clearOriginalEstimate: Boolean
  """
  Set to true to remove the parent task. Takes precedence over parentTaskId.
  """
  clearParentTask: Boolean
  """
  Set to true to clear the remaining estimate. Takes precedence over remainingEstimateSeconds.
  """
  clearRemainingEstimate: Boolean
  """
  Set to true to remove the task from its sprint. Takes precedence over sprintId.
  """
  clearSprintId: Boolean
  """Set to true to clear the start date. Takes precedence over startDate."""
  clearStartDate: Boolean
  descriptionMarkdown: String
  dueDate: DateTime
  expectedVersion: Long!
  originalEstimateSeconds: Long
  """Parent task UUID for subtask hierarchy."""
  parentTaskId: UUID
  priorityId: UUID
  remainingEstimateSeconds: Long
  """Assign the task to a sprint."""
  sprintId: UUID
  startDate: DateTime
  summary: String
  taskTypeId: UUID
}

input UpdateWorkOpsTaskLinkTypeInput {
  category: WorkOpsLinkCategory!
  expectedVersion: Long!
  inwardLabel: String!
  name: String!
  outwardLabel: String!
}

input UpdateWorkOpsTaskTypeInput {
  colorHex: String!
  description: String
  expectedVersion: Long!
  hierarchyLevel: WorkOpsTaskHierarchyLevel!
  iconKey: String!
  name: String!
}

"""File upload scalar for multipart form data"""
scalar Upload

"""
Real-time progress event emitted during the server-side storage phase of a file upload.
"""
type UploadProgressEvent {
  """The number of bytes written to storage so far."""
  bytesUploaded: Long!
  """The UUID of the metadata item being uploaded."""
  metadataId: UUID!
  """The total number of bytes to be written."""
  totalBytes: Long!
}

"""
A real-time event payload delivered when a user starts or stops typing in a chat channel
"""
type UserTypingEvent {
  """ID of the chat channel where the typing event occurred"""
  channelId: UUID!
  """
  Whether the user is currently typing (true) or has stopped typing (false)
  """
  isTyping: Boolean!
  """The user profile that is typing or stopped typing"""
  profile: Profile!
  """ID of the user profile that is typing or stopped typing"""
  profileId: UUID!
}

"""Current assignment count for one variation of a feature flag."""
type VariationAssignmentCount {
  """How many installations are currently assigned to this variation."""
  assignmentCount: Long!
  """The variation users are currently bucketed into."""
  variationKey: String!
}

"""
Input marking the end boundary of a verse range within a scripture component
"""
input VerseEndInput {
  """USFM reference identifying the ending verse"""
  reference: ReferenceInput!
}

"""
Input marking the start boundary of a verse range within a scripture component
"""
input VerseStartInput {
  """USFM reference identifying the starting verse"""
  reference: ReferenceInput!
}

"""The weight unit a company stores its product/container weights in."""
enum WeightUnit {
  KILOGRAMS
  POUNDS
}

"""
Single entry point for all Work Ops queries. Subsystems hang off
this type rather than polluting the root Query with 15+ fields.
"""
type WorkOps {
  attachments: WorkOpsAttachmentQuery!
  automation: WorkOpsAutomationQuery!
  boards: WorkOpsBoards!
  components: WorkOpsComponents!
  crossProject: WorkOpsCrossProjectQuery!
  labels: WorkOpsLabels!
  links: WorkOpsTaskLinks!
  milestones: WorkOpsMilestones!
  multiRepo: WorkOpsMultiRepoQuery!
  notifications: WorkOpsNotificationsQuery!
  portfolios: WorkOpsPortfolios!
  programs: WorkOpsPrograms!
  projects: WorkOpsProjects!
  requirementComments: WorkOpsRequirementComments!
  requirements: WorkOpsRequirements!
  savedFilters: WorkOpsSavedFilters!
  sla: WorkOpsSlaQuery!
  specComments: WorkOpsSpecComments!
  specs: WorkOpsSpecs!
  sprints: WorkOpsSprints!
  statuses: WorkOpsStatuses!
  taskComments: WorkOpsTaskComments!
  tasks: WorkOpsTasks!
  versions: WorkOpsVersions!
  workflows: WorkOpsWorkflows!
  worklogs: WorkOpsWorklogQuery!
}

type WorkOpsApiSurfaceReport {
  analyzedAt: DateTime!
  analyzerTool: String!
