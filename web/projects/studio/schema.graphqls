  GIT_SYNC
  WORKOPS
}

type WorkOpsSpecs {
  byOwner(limit: Int! = 50, offset: Long! = 0, ownerProfileId: UUID!): [WorkOpsSpec!]!
  byProgram(limit: Int! = 50, offset: Long! = 0, programId: UUID!): [WorkOpsSpec!]!
  byProject(limit: Int! = 50, offset: Long! = 0, projectId: UUID!): [WorkOpsSpec!]!
  """Child specs of a parent spec, ordered by sortOrder."""
  children(limit: Int! = 50, offset: Long! = 0, parentSpecId: UUID!): [WorkOpsSpec!]!
  spec(id: UUID!): WorkOpsSpec
  specByKey(key: String!): WorkOpsSpec
}

type WorkOpsSpecsMutation {
  addContext(input: CreateWorkOpsSpecContextInput!, specId: UUID!): WorkOpsSpecContext!
  create(input: CreateWorkOpsSpecInput!): WorkOpsSpec!
  """
  Generate tasks from the spec's requirements. Returns the generation record with task IDs.
  """
  generateTasks(agentSessionId: UUID, metadataVersion: Int!, source: WorkOpsGenerationSource!, specId: UUID!): WorkOpsSpecTaskGeneration!
  """
  Pull the spec's content from its linked git repository at a specific commit.
  """
  pullFromGit(commitSha: String!, specId: UUID!): WorkOpsSpec
  """
  Push the spec's current content to its linked git repository. Returns the commit SHA, or null if no git binding.
  """
  pushToGit(authorEmail: String!, authorName: String!, content: String!, specId: UUID!): String
  removeContext(contextId: UUID!, specId: UUID!): Boolean!
  restore(expectedVersion: Long!, id: UUID!): WorkOpsSpec!
  softDelete(expectedVersion: Long!, id: UUID!): WorkOpsSpec!
  """
  Transition the spec through its workflow. The only permitted path for a status change.
  """
  transition(expectedVersion: Long!, id: UUID!, resolutionId: UUID, transitionId: UUID!): WorkOpsSpec!
  update(id: UUID!, input: UpdateWorkOpsSpecInput!): WorkOpsSpec!
}

"""
One iteration of work bound to a board. Closing a sprint with
unfinished tasks requires a destination per task — no work is
silently orphaned.
"""
type WorkOpsSprint {
  """WorkOpsTasks added after start; used for scope-creep reporting."""
  addedDuringSprintTaskIds: [UUID!]!
  board: WorkOpsBoard!
  boardId: UUID!
  """Snapshot of the tasks committed at sprint start."""
  committedTaskIds: [UUID!]!
  completeDate: DateTime
  createdAt: DateTime!
  endDate: DateTime
  goal: String
  id: UUID!
  modifiedAt: DateTime!
  name: String!
  startDate: DateTime
  state: WorkOpsSprintState!
  velocityPoints: Float
  version: Long!
}

"""
Lifecycle of a WorkOpsSprint. At most one sprint per board may sit in
ACTIVE at any time (R8) — enforced both at the database layer (a
partial unique index on `board_id where state = 'active'`) and at
the service layer (so the typed `SprintAlreadyActiveException`
surfaces before the SQL would).
"""
enum WorkOpsSprintState {
  ACTIVE
  CLOSED
  FUTURE
}

type WorkOpsSprints {
  byBoard(boardId: UUID!, limit: Int! = 50, offset: Long! = 0): [WorkOpsSprint!]!
  sprint(id: UUID!): WorkOpsSprint
}

type WorkOpsSprintsMutation {
  close(input: CloseWorkOpsSprintInput!): WorkOpsSprint!
  create(input: CreateWorkOpsSprintInput!): WorkOpsSprint!
  start(input: StartWorkOpsSprintInput!): WorkOpsSprint!
}

type WorkOpsStatus {
  category: WorkOpsStatusCategory!
  colorHex: String!
  description: String
  id: UUID!
  name: String!
  version: Long!
}

enum WorkOpsStatusCategory {
  CANCELLED
  DONE
  IN_PROGRESS
  TODO
}

type WorkOpsStatuses {
  """
  Read all statuses (Phase 2 reference data; Phase 7 ships full workflow CRUD).
  """
  all: [WorkOpsStatus!]!
  status(id: UUID!): WorkOpsStatus
}

"""Admin CRUD for statuses (R4 reference data)."""
type WorkOpsStatusesMutation {
  create(input: CreateWorkOpsStatusInput!): WorkOpsStatus!
  delete(id: UUID!): Boolean!
  update(id: UUID!, input: UpdateWorkOpsStatusInput!): WorkOpsStatus!
}

"""
How a board groups rows. `PROJECT` is the cross-project swimlane
strategy from R30; `QUERY` is Phase 6 (saved-filter swimlanes).
Phase 5 supports `NONE`, `ASSIGNEE`, `EPIC`, `PRIORITY`, `PROJECT`.
"""
enum WorkOpsSwimlaneStrategy {
  ASSIGNEE
  EPIC
  NONE
  PRIORITY
  PROJECT
  QUERY
}

"""
A unit of work. Phase 2 ships the core lifecycle; Phase 3+ extends
with workflow transitions, links, comments, custom fields, etc.
"""
type WorkOpsTask {
  """
  Projects beyond the primary that this task spans. The primary
  project is always available via `project`; these are additional
  projects the task affects.
  """
  affectedProjects: [WorkOpsProject!]!
  affectsVersionIds: [UUID!]!
  """Resolved assignee profile, if assigned."""
  assignee: Profile
  assigneeProfileId: UUID
  collectionId: UUID
  """
  Threaded comments on this task (R6). Replies are not included
  in the top-level page; fetch them via [WorkOpsTaskComment.replies] or
  `workOpsTaskComments.repliesFor`.
  """
  comments(limit: Long! = 50, offset: Long! = 0): [WorkOpsTaskComment!]!
  componentIds: [UUID!]!
  contentItemId: UUID
  createdAt: DateTime!
  createdByPrincipalId: UUID!
  """Raw custom-field values bypassing the hidden filter — manager only."""
  customFieldValuesRaw: JSON!
  """
  Custom-field values for this task with hidden fields filtered
  out per the project's TaskFieldConfigurationScheme (R5). A
  manager-level read is `task.customFieldValuesRaw`.
  """
  customFields: JSON!
  deletedAt: DateTime
  descriptionHtml: String
  descriptionMarkdown: String
  dueDate: DateTime
  """Rollup: count of direct children in this epic."""
  epicChildCount: Int!
  """Rollup: count of direct children in a done-category status."""
  epicChildDoneCount: Int!
  """
  Phase 3+ enforces epic semantics; in Phase 2 this is just a stored reference.
  """
  epicTask: WorkOpsTask
  """Rollup: total original-estimate seconds across epic children."""
  epicTotalEstimateSeconds: Long!
  """Rollup: total remaining-estimate seconds across epic children."""
  epicTotalRemainingSeconds: Long!
  """Rollup: total time-spent seconds across epic children."""
  epicTotalSpentSeconds: Long!
  fixVersionIds: [UUID!]!
  """
  Append-only audit history (R17). Returns the chronologically newest
  entries first. Each entry is one logical change carrying one or
  more WorkOpsFieldChange records.
  """
  history(limit: Int! = 50, offset: Long! = 0): [WorkOpsTaskHistoryEntry!]!
  id: UUID!
  """Auto-incrementing handle of the form `{PROJECT_KEY}-{N}`."""
  key: String!
  labelIds: [UUID!]!
  """
  Inbound + outbound link rows where this task is the source or
  target. The link type and the other endpoint resolve through
  DataLoaders on the [WorkOpsTaskLink] type.
  """
  links: [WorkOpsTaskLink!]!
  """Optional metadata document for rich content editing."""
  metadataId: UUID
  milestone: WorkOpsMilestone
  milestoneId: UUID
  modifiedAt: DateTime!
  modifiedByPrincipalId: UUID!
  originalEstimateSeconds: Long
  """
  Phase 3+ enforces hierarchy semantics; in Phase 2 this is just a stored reference.
  """
  parentTask: WorkOpsTask
  """Per-entity permission rows. Requires MANAGE."""
  permissions: [EntityPermission!]!
  priority: WorkOpsPriority!
  project: WorkOpsProject!
  remainingEstimateSeconds: Long
  """Resolved reporter profile."""
  reporter: Profile!
  reporterProfileId: UUID!
  """The requirement that auto-created this task, if any."""
  requirement: WorkOpsRequirement
  resolution: WorkOpsResolution
  resolutionAt: DateTime
  slaDueAt: DateTime
  sprintId: UUID
  startDate: DateTime
  status: WorkOpsStatus!
  summary: String!
  taskType: WorkOpsTaskType!
  timeSpentSeconds: Long!
  """
  Transitions reachable from the task's current state in its
  project's workflow (R4). The `currentOnly` flag toggles between
  "what can I do right now" and "every transition the workflow
  defines" — UIs render the latter as the workflow inspector.
  """
  transitions(currentOnly: Boolean! = true): [WorkOpsWorkflowTransition!]!
  """Optimistic-locking version. Required on every update."""
  version: Long!
  voteCount: Int!
  watcherProfileIds: [UUID!]!
}

type WorkOpsTaskAffectedProject {
  addedAt: DateTime!
  projectId: UUID!
  taskId: UUID!
}

"""
One comment on a task. Mirrors the metadata-comment shape — reuses
CommentStatus and ProfileVisibility from the public schema's
content / profile graphqls files.
"""
type WorkOpsTaskComment {
  content: String!
  created: DateTime!
  deleted: Boolean!
  id: Long!
  impersonatorId: UUID
  likes: Int!
  modified: DateTime!
  parentId: Long
  """Resolved profile for the comment author."""
  profile: Profile
  profileId: UUID!
  """Threaded replies (R6); newest first."""
  replies(limit: Long! = 50, offset: Long! = 0): [WorkOpsTaskComment!]!
  status: CommentStatus!
  taskId: UUID!
  visibility: ProfileVisibility!
}

input WorkOpsTaskCommentInput {
  attributes: JSON
  content: String!
  parentId: Long
  systemAttributes: JSON
  visibility: ProfileVisibility! = USER
}

type WorkOpsTaskComments {
  comment(commentId: Long!, taskId: UUID!): WorkOpsTaskComment
  countForTask(taskId: UUID!): Long!
  """
  Visibility filtering: anonymous viewers see only public+approved; the author sees their own pending comments; managers see all non-blocked.
  """
  forTask(limit: Long! = 50, offset: Long! = 0, taskId: UUID!): [WorkOpsTaskComment!]!
  repliesFor(limit: Long! = 50, offset: Long! = 0, parentId: Long!, taskId: UUID!): [WorkOpsTaskComment!]!
}

type WorkOpsTaskCommentsMutation {
  """Add a comment (or reply when parentId is set)."""
  add(input: WorkOpsTaskCommentInput!, taskId: UUID!): WorkOpsTaskComment!
  """Soft-delete a comment regardless of author (admin path)."""
  delete(commentId: Long!, taskId: UUID!): Boolean!
  """Like a comment; returns the new likes count, -1 on missing comment."""
  like(commentId: Long!, taskId: UUID!): Int!
  """Moderator action: flip a comment's status."""
  setStatus(commentId: Long!, status: CommentStatus!, taskId: UUID!): Boolean!
  """Unlike a comment; returns the new likes count, -1 on missing comment."""
  unlike(commentId: Long!, taskId: UUID!): Int!
}

"""
Where in the parent / child hierarchy a task type sits. The numeric
ordering is significant: parents must be at a strictly higher level
than children (R7).
"""
enum WorkOpsTaskHierarchyLevel {
  EPIC
  INITIATIVE
  STANDARD
  SUBTASK
}

"""
One immutable record of "who changed what when" on a task.
Multi-field updates produce ONE entry with multiple FieldChanges
(R17), not one entry per field.
"""
type WorkOpsTaskHistoryEntry {
  changedAt: DateTime!
  changedByPrincipalId: UUID!
  changedByProfileId: UUID
  changes: [WorkOpsFieldChange!]!
  id: UUID!
  taskId: UUID!
}

"""
A directed link from `sourceTask` to `targetTask` of a given
[WorkOpsTaskLinkType] (R7). The unique constraint
`(source, target, link_type)` makes `linkTasks` idempotent.
"""
type WorkOpsTaskLink {
  createdAt: DateTime!
  createdByPrincipalId: UUID!
  id: UUID!
  linkType: WorkOpsTaskLinkType!
  sourceTask: WorkOpsTask
  targetTask: WorkOpsTask
}

input WorkOpsTaskLinkInput {
  linkTypeId: UUID!
  sourceTaskId: UUID!
  targetTaskId: UUID!
}

"""Defines a kind of link an admin can attach between two tasks."""
type WorkOpsTaskLinkType {
  category: WorkOpsLinkCategory!
  id: UUID!
  """Rendered on the target task's UI (e.g. "is blocked by")."""
  inwardLabel: String!
  """Alias for inwardLabel."""
  inwardName: String!
  name: String!
  """Rendered on the source task's UI (e.g. "blocks")."""
  outwardLabel: String!
  """Alias for outwardLabel."""
  outwardName: String!
  version: Long!
}

"""Admin CRUD for task link types (R7 reference data)."""
type WorkOpsTaskLinkTypesMutation {
  create(input: CreateWorkOpsTaskLinkTypeInput!): WorkOpsTaskLinkType!
  delete(id: UUID!): Boolean!
  update(id: UUID!, input: UpdateWorkOpsTaskLinkTypeInput!): WorkOpsTaskLinkType!
}

type WorkOpsTaskLinks {
  """Inbound + outbound links touching the given task."""
  forTask(taskId: UUID!): [WorkOpsTaskLink!]!
  """Read every seeded link type (R7)."""
  linkTypes: [WorkOpsTaskLinkType!]!
}

type WorkOpsTaskLinksMutation {
  """
  Create a link. Idempotent: re-linking the same triple returns the existing row.
  """
  link(input: WorkOpsTaskLinkInput!): WorkOpsTaskLink!
  """Remove a link by id."""
  unlink(linkId: UUID!): Boolean!
}

"""
A task search hit + the free-text fragments the planner peeled off.
Phase 6 includes those fragments so Phase 23 can light up the
Meilisearch leg without re-parsing the query.
"""
type WorkOpsTaskSearchResult {
  """Free-text fragments extracted from `~` operators against TEXT fields."""
  freeTextTerms: [String!]!
  rows: [WorkOpsTask!]!
}

"""
Configurable type label for a task — Bug, Story, WorkOpsTask, Epic, Sub-task,
plus organization-specific extensions (R3).
"""
type WorkOpsTaskType {
  colorHex: String!
  description: String
  hierarchyLevel: WorkOpsTaskHierarchyLevel!
  iconKey: String!
  id: UUID!
  name: String!
  version: Long!
}

"""
The set of task types a project may use plus a default for new tasks
(R3). Phase 2 seeds the canonical "Default WorkOpsTask Type Scheme".
"""
type WorkOpsTaskTypeScheme {
  """Convenience resolver — the default type row."""
  defaultTaskType: WorkOpsTaskType!
  """Type assigned when createTask omits taskTypeId."""
  defaultTaskTypeId: UUID!
  description: String
  id: UUID!
  name: String!
  """Ordered list of permitted task type ids."""
  taskTypeIds: [UUID!]!
  """Convenience resolver — every type in `taskTypeIds`."""
  taskTypes: [WorkOpsTaskType!]!
  version: Long!
}

"""Admin CRUD for task types (R3 reference data)."""
type WorkOpsTaskTypesMutation {
  create(input: CreateWorkOpsTaskTypeInput!): WorkOpsTaskType!
  delete(id: UUID!): Boolean!
  update(id: UUID!, input: UpdateWorkOpsTaskTypeInput!): WorkOpsTaskType!
}

type WorkOpsTaskWatcher {
  addedAt: DateTime!
  profileId: UUID!
  taskId: UUID!
}

type WorkOpsTasks {
  """
  Tasks that list the given project as an affected project, regardless of their primary project.
  """
  byAffectedProject(limit: Int! = 50, offset: Long! = 0, projectId: UUID!): [WorkOpsTask!]!
  """Paginated list of tasks in a project (newest-modified first)."""
  byProject(limit: Int! = 50, offset: Long! = 0, projectId: UUID!): [WorkOpsTask!]!
  """Read all priorities (R2 reference data)."""
  priorities: [WorkOpsPriority!]!
  """Read all resolutions (R9 reference data)."""
  resolutions: [WorkOpsResolution!]!
  """Fetch a task by id."""
  task(id: UUID!): WorkOpsTask
  """Fetch a task by its public {PROJECT_KEY}-{N} handle."""
  taskByKey(key: String!): WorkOpsTask
  """Read all task type schemes (R3)."""
  taskTypeSchemes: [WorkOpsTaskTypeScheme!]!
  """Read all task types (R3 — admin reference data)."""
  taskTypes: [WorkOpsTaskType!]!
}

type WorkOpsTasksMutation {
  """Associate an additional project with this task."""
  addAffectedProject(id: UUID!, projectId: UUID!): Boolean!
  addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  create(input: CreateWorkOpsTaskInput!): WorkOpsTask!
  """Create a metadata document for this task. Fails if one already exists."""
  createDocument(expectedVersion: Long!, id: UUID!): WorkOpsTask!
  """Remove an affected project association from this task."""
  removeAffectedProject(id: UUID!, projectId: UUID!): Boolean!
  removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  restore(expectedVersion: Long!, id: UUID!): WorkOpsTask!
  softDelete(expectedVersion: Long!, id: UUID!): WorkOpsTask!
  """
  The single permitted path for a status change (R4). Resolves the
  project's effective workflow, evaluates the transition's
  conditions and validators, applies post-functions and the status
  flip atomically, and writes one history entry covering the bundle.
  """
  transition(comment: String, expectedVersion: Long!, id: UUID!, resolutionId: UUID, transitionId: UUID!): WorkOpsTask!
  update(id: UUID!, input: UpdateWorkOpsTaskInput!): WorkOpsTask!
}

type WorkOpsTimeAggregate {
  doneCount: Long!
  taskCount: Long!
  totalEstimateSeconds: Long!
  totalRemainingSeconds: Long!
  totalSpentSeconds: Long!
}

"""
A project release / version. Sequence number drives the per-project
sort order; the service mints the next available value on create.
"""
type WorkOpsVersion {
  archived: Boolean!
  description: String
  id: UUID!
  name: String!
  project: WorkOpsProject!
  projectId: UUID!
  releaseDate: DateTime
  released: Boolean!
  sequenceNumber: Int!
  startDate: DateTime
  version: Long!
}

type WorkOpsVersionReleaseNotes {
  generatedAt: DateTime
  id: UUID!
  manuallyEdited: Boolean!
  sourceLocale: String!
  variants: JSON!
  versionId: UUID!
  workOpsVersion: WorkOpsVersion!
}

type WorkOpsVersions {
  byProject(projectId: UUID!): [WorkOpsVersion!]!
  version(id: UUID!): WorkOpsVersion
}

type WorkOpsVersionsMutation {
  create(input: CreateWorkOpsVersionInput!): WorkOpsVersion!
  """
  Rejected with `VERSION_IN_USE` while any task still references this version.
  """
  delete(id: UUID!): Boolean!
  """Mark released + stamp release date if absent."""
  release(expectedVersion: Long!, id: UUID!): WorkOpsVersion!
}

"""
R15 — worklogs, durations, and epic rollups. Durations enter as
the YouTrack/Jira shorthand `1w 2d 3h 30m` and round-trip back
out the same way through `WorkOpsWorkLog.timeSpentShort`.
"""
type WorkOpsWorkLog {
  comment: String
  createdAt: DateTime!
  id: UUID!
  modifiedAt: DateTime!
  profileId: UUID!
  startedAt: DateTime!
  taskId: UUID!
  timeSpentSeconds: Long!
  timeSpentShort: String!
  visibility: WorklogVisibility!
}

input WorkOpsWorkLogInput {
  comment: String
  estimateAdjustment: String
  startedAt: DateTime!
  timeSpent: String!
  visibility: WorklogVisibility!
}

"""
A reusable state-machine definition. The `default` workflow for a
project is bound via [WorkOpsWorkflowScheme]; per-task-type overrides let
two task types in the same project use different state machines.
"""
type WorkOpsWorkflow {
  description: String
  id: UUID!
  initialStateId: UUID
  name: String!
  states: [WorkOpsWorkflowState!]!
  transitions: [WorkOpsWorkflowTransition!]!
  version: Long!
}

"""
The mapping between projects and the workflow that runs their tasks.
The `perTaskTypeWorkflowIds` JSON object keys task-type UUIDs to
workflow UUIDs.
"""
type WorkOpsWorkflowScheme {
  defaultWorkflowId: UUID!
  description: String
  id: UUID!
  name: String!
  perTaskTypeWorkflowIds: JSON!
  version: Long!
}

"""
One reachable state in a [WorkOpsWorkflow]. Phase 8 wires the optional
`slaPolicyId` against `core-calendar` working calendars.
"""
type WorkOpsWorkflowState {
  displayOrder: Int!
  id: UUID!
  """Convenience accessor — delegates to the underlying status name."""
  name: String!
  slaPolicyId: UUID
  status: WorkOpsStatus!
  statusId: UUID!
  workflowId: UUID!
}

"""
One edge in the workflow's state machine. `fromStateIds` is
`["*"]` for wildcard transitions reachable from every state.
"""
type WorkOpsWorkflowTransition {
  """Opaque JSON list of Conditions; admin tooling decodes."""
  conditions: JSON!
  description: String
  """First resolved from-state, or null for wildcard transitions."""
  fromState: WorkOpsWorkflowState
  fromStateIds: [String!]!
  """
  Resolved workflow states this transition can originate from (excludes wildcard entries).
  """
  fromStates: [WorkOpsWorkflowState!]!
  id: UUID!
  name: String!
  """Opaque JSON list of PostFunctions; admin tooling decodes."""
  postFunctions: JSON!
  screenId: UUID
  """Resolved workflow state the transition moves the task into."""
  toState: WorkOpsWorkflowState!
  toStateId: UUID!
  """Opaque JSON list of Validators; admin tooling decodes."""
  validators: JSON!
  workflowId: UUID!
}

"""Read-only namespace over Phase 3 workflow definitions."""
type WorkOpsWorkflows {
  all: [WorkOpsWorkflow!]!
  scheme(id: UUID!): WorkOpsWorkflowScheme
  schemes: [WorkOpsWorkflowScheme!]!
  workflow(id: UUID!): WorkOpsWorkflow
}

"""
R13 — SLA policies, goals, working calendars, and the per-task
state the tick job mutates. Calendars hold weekly hours and
holidays as JSON; the evaluator interprets them with the calendar's
time zone.
"""
type WorkOpsWorkingCalendar {
  description: String
  """`[YYYY-MM-DD, ...]` — dates excluded from working hours."""
  holidays: JSON!
  id: UUID!
  name: String!
  timeZone: String!
  version: Long!
  """
  `Map<DayOfWeek, [{startLocal, endLocal}]>` — keys are uppercase
  English day names. `endLocal` of `24:00` means end-of-day.
  """
  weeklyHours: JSON!
}

input WorkOpsWorkingCalendarInput {
  description: String
  holidays: JSON!
  name: String!
  timeZone: String!
  weeklyHours: JSON!
}

type WorkOpsWorklogMutation {
  deleteWorklog(id: UUID!): Boolean!
  logWork(input: WorkOpsWorkLogInput!, taskId: UUID!): WorkOpsWorkLog!
  updateWorklog(id: UUID!, input: WorkOpsWorkLogInput!): WorkOpsWorkLog!
}

type WorkOpsWorklogQuery {
  forTask(limit: Int!, offset: Long!, taskId: UUID!): [WorkOpsWorkLog!]!
  worklog(id: UUID!): WorkOpsWorkLog
}

"""
A state in the content workflow lifecycle, defining what happens when content enters or exits this state
"""
type WorkflowState {
  """State-specific configuration"""
  configuration: JSON
  """Human-readable description of this state"""
  description: String!
  """Unique string identifier for this state (e.g. 'draft', 'published')"""
  id: String!
  """Name of the background job to execute in this state"""
  jobName: String
  """Display name of this state"""
  name: String!
  """The lifecycle phase this state belongs to"""
  type: WorkflowStateType!
}

"""Input for creating or updating a workflow state"""
input WorkflowStateInput {
  """State-specific configuration"""
  configuration: JSON!
  """Human-readable description of this state"""
  description: String!
  """Unique string identifier for this state"""
  id: String!
  """Name of the background job to execute in this state"""
  jobName: String
  """Display name of this state"""
  name: String!
  """The lifecycle phase this state belongs to"""
  type: WorkflowStateType!
}

"""The lifecycle phase of a workflow state"""
enum WorkflowStateType {
  """Content is advertised/promoted to users"""
  ADVERTISED
  """Content is awaiting approval from a reviewer"""
  APPROVAL
  """Content has been approved by a reviewer"""
  APPROVED
  """Content is in draft/editing phase"""
  DRAFT
  """A workflow processing step has failed"""
  FAILURE
  """Content is pending initial processing"""
  PENDING
  """Content is being actively processed by a workflow"""
  PROCESSING
  """Content is published and visible to end users"""
  PUBLISHED
}

"""Query operations for browsing workflow states"""
type WorkflowStates {
  """List all defined workflow states"""
  all: [WorkflowState!]!
  """Get a specific workflow state by ID"""
  state(id: String!): WorkflowState
}

"""Mutation operations for managing workflow states"""
type WorkflowStatesMutation {
  """Create a new workflow state"""
  add(state: WorkflowStateInput!): WorkflowState
  """Delete a workflow state by ID"""
  delete(id: String!): Boolean!
  """Update an existing workflow state"""
  edit(state: WorkflowStateInput!): WorkflowState
}

enum WorklogVisibility {
  ALL
  PROFILES
  ROLE
}