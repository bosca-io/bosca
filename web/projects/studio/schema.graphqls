The navigation and progress tracking mode for a guide, determining how users move through the steps
"""
enum GuideType {
  """
  Calendar-based guide where steps are assigned to specific dates (e.g. Advent calendar, reading plan)
  """
  CALENDAR
  """Calendar-based guide with completion progress tracking per step"""
  CALENDAR_PROGRESS
  """
  Linear sequential guide where steps are completed in order (e.g. course, tutorial)
  """
  LINEAR
  """Linear sequential guide with completion progress tracking per step"""
  LINEAR_PROGRESS
}

"""Global queries for content guides."""
type Guides {
  """Access progression data for a guide."""
  progress(
    """The UUID of the guide metadata item."""
    id: UUID!
  ): GuideProgress!
}

"""In-app-purchase redemption operations. Ecom administrator only."""
type IapMutation {
  """
  Verify an app-store receipt and grant/extend the entitlement, once per store transaction.
  """
  redeem(input: IapRedeemInput!): IapRedemptionResult!
}

"""The app store a purchase receipt comes from."""
enum IapPlatform {
  ANDROID
  IOS
}

"""A verified in-app purchase to redeem into a subscription entitlement."""
input IapRedeemInput {
  accountId: UUID!
  """The Android app package name (Google only)."""
  packageName: String = null
  planId: UUID!
  platform: IapPlatform!
  """The store product id (required for Google; ignored by Apple)."""
  productId: String = null
  storeId: UUID!
  """The store-issued receipt / purchase token."""
  token: String!
}

"""The result of redeeming an in-app-purchase receipt."""
type IapRedemptionResult {
  status: IapRedemptionStatus!
  """The granted/extended subscription, when present."""
  subscription: EcomSubscription
  """The store transaction id that was redeemed, when available."""
  transactionId: String
}

"""The outcome of redeeming an in-app-purchase receipt."""
enum IapRedemptionStatus {
  ALREADY_REDEEMED
  GRANTED
  INVALID
  NOT_FOUND
  VERIFICATION_UNAVAILABLE
}

"""An individual installer within a package version"""
type InstalledPackage {
  """Name of the installer (e.g. 'default-models', 'default-prompts')"""
  name: String!
  """Version of the installer"""
  version: String!
}

"""Billing cadence unit."""
enum IntervalUnit {
  DAYS
  HOURS
  MINUTES
  MONTHS
  SECONDS
  YEARS
}

"""
Stock of one product at one fulfillment center. Reservation state machine:
available → inCart (held by a cart) → pending (paid) → shipped (quantity decrements).
"""
type Inventory {
  """Sellable right now: quantity − pending − inCart."""
  available: Int!
  fulfillmentCenter: FulfillmentCenter!
  id: UUID!
  """Units currently held by open carts."""
  inCart: Int!
  """Units paid for and awaiting shipment."""
  pending: Int!
  product: Product!
  """Total units on hand."""
  quantity: Int!
  sku: String!
}

"""Creates an inventory row for a product at a fulfillment center."""
input InventoryInput {
  fulfillmentCenterId: UUID!
  productId: UUID!
  quantity: Int!
  sku: String!
}

"""Operations on one inventory row. Admin."""
type InventoryMutation {
  """Set the on-hand quantity (cannot drop below pending)."""
  adjust(quantity: Int!): Inventory!
  """
  Ship pending units: both pending and on-hand quantity decrement (cannot exceed pending).
  """
  ship(quantity: Int!): Inventory!
}

"""Arbitrary JSON object"""
scalar JSON

