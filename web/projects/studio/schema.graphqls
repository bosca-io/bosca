"""The type of credential used to authenticate a principal"""
enum CredentialType {
  """Long-lived API token for programmatic access"""
  API_TOKEN
  """OAuth 2.0 token-based credential from a third-party provider"""
  OAUTH2
  """
  WebAuthn passkey credential for passwordless biometric/security-key authentication
  """
  PASSKEY
  """
  Standard password credential using the platform's default hashing algorithm
  """
  PASSWORD
  """
  Password credential using the scrypt key derivation function (used for imported accounts)
  """
  PASSWORD_SCRYPT
}

"""
Raw card details for PAN-processing gateways (e.g. BluePay) when no `token` is supplied. Transient —
handed to the gateway for the charge and NEVER stored or logged (the Payment row keeps provider
tokens/ids only). Token gateways (e.g. Stripe) take `token` instead, or tokenize this.
"""
input CreditCardInput {
  cvv: String!
  expirationMonth: Int!
  expirationYear: Int!
  name: String!
  number: String!
  type: CreditCardType = UNKNOWN
}

"""Card brand (best-effort; the gateway re-derives it from the number)."""
enum CreditCardType {
  AMERICAN_EXPRESS
  DISCOVER
  MASTERCARD
  UNKNOWN
  VISA
}

"""
The result of validating a cron expression, including whether it is valid and a preview of upcoming execution times.
"""
type CronValidationResult {
  """
  A description of the validation error, if the expression is invalid. Null if the expression is valid.
  """
  error: String
  """
  A preview list of the next upcoming execution timestamps based on the cron expression. Empty if the expression is invalid.
  """
  nextRuns: [DateTime!]!
  """Whether the cron expression is syntactically valid."""
  valid: Boolean!
}

type CupedCovariate {
  elementId: String
  elementType: String
  eventType: EventType
  lookbackWindow: String!
  pagePath: String
}

"""
CUPED covariate configuration. When set on an EVENT_COUNT goal,
the aggregator runs a second per-user pre-period query matching
the same filter shape and uses OLS to subtract the part of the
post-period outcome that the pre-period value already explained.
Sample sizes typically drop 30-50% on correlated metrics.
"""
input CupedCovariateInput {
  elementId: String
  elementType: String
  eventType: EventType
  """ISO-8601 duration, default 'P14D'."""
  lookbackWindow: String
  pagePath: String
}

"""
A shopper within a company, backed by a profile. Auth resolves principal -> profile -> customer;
principal ids are never stored here. A customer can belong to several billing accounts.
"""
type Customer {
  """All accounts this customer belongs to."""
  accounts: [Account!]!
  company: Company!
  created: DateTime!
  """The account used by default for new carts/orders."""
  defaultAccount: Account
  """Module-specific extension data."""
  extras: CustomerExtras!
  id: UUID!
  modified: DateTime!
  """The backing profile in the profiles domain."""
  profile: Profile!
}

"""Customer extension data."""
union CustomerExtras = EmptyCustomerExtras

"""Creates a customer in a company."""
input CustomerInput {
  companyId: UUID!
  extras: JSON = null
  """The backing profile; defaults to the caller's profile."""
  profileId: UUID = null
}

"""Mutations scoped to one customer."""
type CustomerMutation {
  """Soft-delete the customer."""
  delete: Boolean!
  """Replace the customer's extras blob."""
  edit(extras: JSON!): Customer!
  """
  Set which of the customer's accounts is the default for new carts/orders.
  """
  setDefaultAccount(accountId: UUID!): Customer!
}

"""Customer creates and per-customer operations."""
type CustomersMutation {
  """
  Create a customer in a company, linked to a profile (the caller's by default).
  """
  add(input: CustomerInput!): Customer!
  """Operations on an existing customer."""
  customer(id: UUID!): CustomerMutation!
}

