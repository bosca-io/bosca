schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

"""
The billing entity: carts, payments, subscriptions, and credit hang off an account, not a customer.
Several customers may share one account (household, business team).
"""
type Account {
  """Saved billing/shipping addresses."""
  addresses: [AccountAddress!]!
  company: Company!
  created: DateTime!
  """
  Stored credit balance, spendable as ACCOUNT_CREDIT payments. Changes are audited.
  """
  credit: Money!
  """Customers attached to this account."""
  customers: [Customer!]!
  """Module-specific extension data."""
  extras: AccountExtras!
  id: UUID!
  modified: DateTime!
  type: AccountType!
}

"""A saved address on an account."""
type AccountAddress {
  address1: String!
  address2: String
  city: String!
  """ISO 3166-1 alpha-2 country code."""
  country: String!
  id: UUID!
  note: String
  phone: String!
  """Preferred address for its type — used to prefill carts."""
  preferred: Boolean!
  state: String!
  type: AddressType!
  zip: String!
}

"""A saved address on an account."""
input AccountAddressInput {
  address1: String!
  address2: String = null
  city: String!
  """ISO 3166-1 alpha-2 country code."""
  country: String!
  note: String = null
  phone: String!
  """Make this the preferred address for its type."""
  preferred: Boolean! = false
  state: String!
  type: AddressType!
  zip: String!
}

"""Billing-account extension data."""
union AccountExtras = EmptyAccountExtras

"""Creates or edits a billing account."""
input AccountInput {
  companyId: UUID!
  """Customers to attach to the account."""
  customerIds: [UUID!]! = []
  extras: JSON = null
  type: AccountType!
}

"""Mutations scoped to one billing account."""
type AccountMutation {
  """Add a billing or shipping address to the account."""
  addAddress(input: AccountAddressInput!): AccountAddress!
  """Add credit to the account balance (audited, row-locked). Admin."""
  addCredit(amount: Money!, note: String = null): Account!
  """Soft-delete the account."""
  delete: Boolean!
  """Edit the account."""
  edit(input: AccountInput!): Account!
}

"""
Billing account classification; BUSINESS accounts may branch billing logic.
"""
enum AccountType {
  BUSINESS
  CONSUMER
}

"""Billing-account creates and per-account operations."""
type AccountsMutation {
  """Operations on an existing account."""
  account(id: UUID!): AccountMutation!
  """Create a billing account in a company, optionally attaching customers."""
  add(input: AccountInput!): Account!
}

"""Adds a line to a cart."""
input AddCartItemInput {
  catalogProductId: UUID!
  """Line-type-specific configuration (e.g. a subscription plan selection)."""
  configuration: JSON = null
  """Parent line id for a dependent line."""
  parentId: UUID = null
  quantity: Int!
}

"""Input for adding a review comment anchored to a diff line."""
input AddGitReviewCommentInput {
  commitSha: String!
  content: String!
  filePath: String!
  newLineNumber: Int
  oldLineNumber: Int
  pullRequestId: UUID!
  reviewId: UUID!
}

"""Address role: where the bill goes vs. where the goods go."""
enum AddressType {
  BILLING
  SHIPPING
}

"""
Admin-only account administration mutations. Nothing here is automatic or self-serve.
"""
type AdminMutation {
  """
  Permanently delete a principal and everything the database cascades from it (credentials, group memberships, emails, tokens, and the principal's linked profiles). The principal MUST already be soft-deleted via markPrincipalDeleted; this two-stage requirement guards against accidental one-click destruction.
  """
  deletePrincipal(id: UUID!): Boolean!
  """
  Mark a principal deleted — the reversible staging step before permanent deletion. Revokes the principal's sessions and blocks it from authenticating until restorePrincipal is called.
  """
  markPrincipalDeleted(id: UUID!): Principal!
  """
  Merge the duplicate principal into the survivor: the survivor keeps everything, the duplicate is retired.
  """
  mergePrincipals(duplicateId: UUID!, survivorId: UUID!): Principal!
  """Reverse markPrincipalDeleted, re-enabling the account."""
  restorePrincipal(id: UUID!): Principal!
}

"""Admin-only read side of account administration."""
type AdminQuery {
  """
  List groups of verified principals that share an email address — i.e. duplicate accounts to merge.
  """
  duplicateAccounts: [DuplicatedAccountIds!]!
}

"""
An AI agent that combines a model, prompt, tools, and optional sub-agents to perform AI-powered workflows. Agents can be composed hierarchically through sub-agents.
"""
type Agent {
  """
  Optional JSON configuration for additional agent settings such as temperature, max tokens, or custom parameters
  """
  configuration: JSON
  """Human-readable description of this agent's purpose and capabilities"""
  description: String!
  """
  If set, the path in the Git repository where this agent's `.md` file lives.
  """
  gitPath: String
  """If set, the AGENT_PROJECT Git repository this agent is linked to."""
  gitRepositoryId: UUID
  """Unique identifier for this agent"""
  id: UUID!
  """Unique key used to reference this agent programmatically"""
  key: String!
  """
  Last sync error message, if the most recent pull/push failed. `null` when sync succeeded.
  """
  lastSyncError: String
  """The unique identifier of the AI model this agent uses for inference"""
  modelId: UUID!
  """Display name for the agent"""
  name: String!
  """
  The unique identifier of the prompt (system instructions) this agent uses
  """
  promptId: UUID!
  """
  Ordered list of sub-agents that this agent can delegate tasks to, enabling hierarchical agent composition
  """
  subAgents: [Agent!]!
  """
  List of tools available to this agent for performing specific capabilities
  """
  tools: [AgentTool!]!
}

"""The file-backed entity types in an AGENT_PROJECT repository."""
enum AgentEntityType {
  """An AI agent definition (agents/<key>.md)."""
  AGENT
  """An agent resource definition (resources/<key>.md)."""
  AGENT_RESOURCE
  """An agent tool definition (tools/<key>.md)."""
  AGENT_TOOL
  """An MCP server registration (mcp-servers/<key>.md)."""
  MCP_SERVER
  """A prompt definition (prompts/<key>.md)."""
  PROMPT
}

"""Input for creating or updating an AI agent definition"""
input AgentInput {
  """
  Optional JSON configuration for additional agent settings such as temperature, max tokens, or custom parameters
  """
  configuration: JSON
  """Human-readable description of this agent's purpose and capabilities"""
  description: String!
  """Unique key used to reference this agent programmatically"""
  key: String!
  """
  The unique identifier of the AI model this agent should use for inference
  """
  modelId: UUID!
  """Display name for the agent"""
  name: String!
  """
  The unique identifier of the prompt (system instructions) this agent should use
  """
  promptId: UUID!
}

"""
Entry in a backfill request: which DB row to serialize and where to write it in the repo.
"""
input AgentRepoBackfillEntry {
  """The unique identifier of the DB row to serialize."""
  entityId: UUID!
  """The type of entity to backfill."""
  entityType: AgentEntityType!
  """The target path in the repository (e.g. agents/research-assistant.md)."""
  gitPath: String!
}

"""Result of an AGENT_PROJECT bulk-export (backfill) operation."""
type AgentRepoBackfillResult {
  """The last commit SHA produced, if any."""
  commitSha: String
  """
  Other error message, if any. Set when the operation failed for non-validation reasons.
  """
  errorMessage: String
  """Whether the backfill succeeded."""
  ok: Boolean!
  """
  Validation errors, if any. Non-empty only when the operation failed validation.
  """
  validationErrors: [AgentRepoValidationError!]
}

"""Mutation operations for AGENT_PROJECT Git repository management."""
type AgentRepoMutation {
  """
  Bulk-export the specified DB rows to the given AGENT_PROJECT Git repository. Each
  entry is linked to its target gitPath and then pushed; the operation commits one
  file per entry. Validates each file before committing — on validation failure, no
  files are committed for the failing entry, but other entries proceed.

  Requires `agent.manager` group or admin.
  """
  backfill(
    """Commit author email (shown in Git history)."""
    authorEmail: String!
    """Commit author name (shown in Git history)."""
    authorName: String!
    """The entities to serialize and commit."""
    entries: [AgentRepoBackfillEntry!]!
    """The target AGENT_PROJECT repository."""
    repositoryId: UUID!
  ): AgentRepoBackfillResult!
}

"""
A single validation error attributed to a file path in an AGENT_PROJECT repo.
"""
type AgentRepoValidationError {
  """Human-readable validation error message."""
  message: String!
  """The repository-relative path of the file that failed validation."""
  path: String!
}

"""
A resource the Bosca MCP server can offer to MCP clients (MCP `resources` requests).
Exactly one implementation variant is set (staticText, metadataId,
documentMetadataId [+ documentVersion], contentMetadataId, scriptId, or
graphqlOperation [+ transforms]); the application layer enforces the XOR.
"""
type AgentResource {
  """Optional JSON configuration for additional resource settings"""
  configuration: JSON
  """
  Metadata id whose file/blob content is returned (contentMetadataId impl variant).
  """
  contentMetadataId: UUID
  """Human-readable description of what this resource provides"""
  description: String!
  """
  Metadata id whose document body is returned (documentMetadataId impl variant).
  """
  documentMetadataId: UUID
  """
  Optional document version to return; defaults to the active version (paired with documentMetadataId).
  """
  documentVersion: Int
  """
  If set, the path in the Git repository where this resource's `.md` file lives.
  """
  gitPath: String
  """If set, the AGENT_PROJECT Git repository this resource is linked to."""
  gitRepositoryId: UUID
  """
  Optional JSONPath-style mapping of MCP arguments to the operation's GraphQL variables.
  """
  graphqlInputTransform: String
  """
  Pinned GraphQL operation text whose output is returned (graphqlOperation impl variant).
  """
  graphqlOperation: String
  """
  Optional JSONPath-style mapping of the GraphQL response to the resource's output.
  """
  graphqlOutputTransform: String
  """Unique identifier for this resource"""
  id: UUID!
  """Unique key used to reference this resource programmatically"""
  key: String!
  """
  Last sync error message, if the most recent pull/push failed. `null` when sync succeeded.
  """
  lastSyncError: String
  """
  Metadata id whose object is returned as JSON (metadataId impl variant).
  """
  metadataId: UUID
  """Display name for the resource"""
  name: String!
  """Script id whose output is returned (scriptId impl variant)."""
  scriptId: UUID
  """Inline static content (staticText impl variant)."""
  staticText: String
}

"""
Input for creating or updating an agent resource. Exactly one implementation variant should be set.
"""
input AgentResourceInput {
  """Optional JSON configuration for additional resource settings"""
  configuration: JSON
  """
  Metadata id whose file/blob content is returned (contentMetadataId impl variant).
  """
  contentMetadataId: UUID
  """Human-readable description of what this resource provides"""
  description: String!
  """
  Metadata id whose document body is returned (documentMetadataId impl variant).
  """
  documentMetadataId: UUID
  """Optional document version (paired with documentMetadataId)."""
  documentVersion: Int
  """
  Optional JSONPath-style mapping of MCP arguments to the operation's GraphQL variables.
  """
  graphqlInputTransform: String
  """Pinned GraphQL operation text (graphqlOperation impl variant)."""
  graphqlOperation: String
  """
  Optional JSONPath-style mapping of the GraphQL response to the resource's output.
  """
  graphqlOutputTransform: String
  """Unique key used to reference this resource programmatically"""
  key: String!
  """
  Metadata id whose object is returned as JSON (metadataId impl variant).
  """
  metadataId: UUID
  """Display name for the resource"""
  name: String!
  """Script id whose output is returned (scriptId impl variant)."""
  scriptId: UUID
  """Inline static content (staticText impl variant)."""
  staticText: String
}

"""Query operations for listing and retrieving agent resources"""
type AgentResources {
  """Retrieve all agent resources"""
  all: [AgentResource!]!
  """Retrieve a specific agent resource by its unique ID"""
  resource(
    """The unique identifier of the resource to retrieve"""
    id: UUID!
  ): AgentResource
}

"""Mutation operations for managing agent resources"""
type AgentResourcesMutation {
  """Create a new agent resource definition"""
  add(
    """The resource definition to create"""
    resource: AgentResourceInput!
  ): AgentResource
  """
  Delete an agent resource by its ID. Returns true if the resource was deleted.
  """
  delete(
    """The unique identifier of the resource to delete"""
    id: UUID!
  ): Boolean!
  """Update an existing agent resource definition"""
  edit(
    """The unique identifier of the resource to update"""
    id: UUID!
    """The updated resource definition"""
    resource: AgentResourceInput!
  ): AgentResource
}

"""
A tool that can be attached to an AI agent, providing the agent with a specific capability such as search, data retrieval, or content manipulation
"""
type AgentTool {
  """Optional agent this tool invokes (agent-as-tool impl variant)."""
  agentId: UUID
  """
  Optional JSON configuration for additional tool settings, parameters, or connection details
  """
  configuration: JSON
  """
  Human-readable description of what this tool does, used to help the AI agent understand when and how to use it
  """
  description: String!
  """
  If set, the path in the Git repository where this tool's `.md` file lives.
  """
  gitPath: String
  """If set, the AGENT_PROJECT Git repository this tool is linked to."""
  gitRepositoryId: UUID
  """
  Optional JSONPath-style mapping of MCP arguments to the operation's GraphQL variables.
  """
  graphqlInputTransform: String
  """
  Optional pinned GraphQL operation text this tool executes (graphqlOperation impl variant).
  """
  graphqlOperation: String
  """
  Optional JSONPath-style mapping of the GraphQL response to the tool's output.
  """
  graphqlOutputTransform: String
  """Unique identifier for this tool"""
  id: UUID!
  """Unique key used to reference this tool programmatically"""
  key: String!
  """
  Last sync error message, if the most recent pull/push failed. `null` when sync succeeded.
  """
  lastSyncError: String
  """
  Optional reference to an MCP server that provides this tool's capabilities
  """
  mcpServerId: UUID
  """
  Optional model this tool runs the rendered prompt through (prompt+model impl variant; paired with promptId).
  """
  modelId: UUID
  """Display name for the tool, shown in the UI and in agent tool listings"""
  name: String!
  """
  Optional prompt this tool renders (prompt+model impl variant; paired with modelId).
  """
  promptId: UUID
  """Optional reference to a script that implements this tool's behavior"""
  scriptId: UUID
}

"""Input for creating or updating an agent tool definition"""
input AgentToolInput {
  """Optional agent id (agent-as-tool impl variant)."""
  agentId: UUID
  """
  Optional JSON configuration for additional tool settings, parameters, or connection details
  """
  configuration: JSON
  """
  Human-readable description of what this tool does, used to help the AI agent understand when and how to use it
  """
  description: String!
  """
  Optional JSONPath-style mapping of MCP arguments to the operation's GraphQL variables.
  """
  graphqlInputTransform: String
  """
  Optional pinned GraphQL operation text (graphqlOperation impl variant).
  """
  graphqlOperation: String
  """
  Optional JSONPath-style mapping of the GraphQL response to the tool's output.
  """
  graphqlOutputTransform: String
  """Unique key used to reference this tool programmatically"""
  key: String!
  """
  Optional reference to an MCP server that provides this tool's capabilities
  """
  mcpServerId: UUID
  """Optional model id (prompt+model impl variant; paired with promptId)."""
  modelId: UUID
  """Display name for the tool"""
  name: String!
  """Optional prompt id (prompt+model impl variant; paired with modelId)."""
  promptId: UUID
  """Optional reference to a script that implements this tool's behavior"""
  scriptId: UUID
}

"""Query operations for listing and retrieving agent tools"""
type AgentTools {
  """Retrieve all available agent tools"""
  all: [AgentTool!]!
  """Retrieve a specific agent tool by its unique ID"""
  tool(
    """The unique identifier of the tool to retrieve"""
    id: UUID!
  ): AgentTool
}

"""Mutation operations for managing agent tools"""
type AgentToolsMutation {
  """Create a new agent tool definition"""
  add(
    """The tool definition to create"""
    tool: AgentToolInput!
  ): AgentTool
  """Delete an agent tool by its ID. Returns true if the tool was deleted."""
  delete(
    """The unique identifier of the tool to delete"""
    id: UUID!
  ): Boolean!
  """
  Update an existing agent tool definition. If the tool is linked to an
  AGENT_PROJECT repository and both `authorName` and `authorEmail` are provided,
  the new state is also pushed to Git as a commit attributed to the editor.
  """
  edit(
    """
    Commit author email for the Git push (only used when the tool is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the tool is Git-linked).
    """
    authorName: String
    """The unique identifier of the tool to update"""
    id: UUID!
    """The updated tool definition"""
    tool: AgentToolInput!
  ): AgentTool
}

"""Query operations for listing and retrieving AI agents"""
type Agents {
  """Retrieve a specific agent by its unique ID"""
  agent(
    """The unique identifier of the agent to retrieve"""
    id: UUID!
  ): Agent
  """Retrieve a specific agent by its unique key"""
  agentByKey(
    """The unique programmatic key of the agent to retrieve"""
    key: String!
  ): Agent
  """Retrieve all available agents"""
  all: [Agent!]!
}

"""
Mutation operations for managing AI agents, including sub-agent and tool associations.

For every mutation that mutates an agent's serialized state (edit, addSubAgent,
removeSubAgent, setSubAgents, addTool, removeTool, setTools): if the agent is linked
to an AGENT_PROJECT repository and both `authorName` and `authorEmail` are provided,
the new state is also pushed to Git as a commit attributed to the editor. The push is
best-effort — failures are logged and recorded as `lastSyncError` on the row but do
not roll back the DB write.
"""
type AgentsMutation {
  """Create a new AI agent definition"""
  add(
    """The agent definition to create"""
    agent: AgentInput!
  ): Agent
  """
  Add a sub-agent to a parent agent at a specific position. Triggers a Git push if linked + author args provided.
  """
  addSubAgent(
    """The unique identifier of the parent agent"""
    agentId: UUID!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The position in the sub-agent execution order (0-based)"""
    ordinal: Int!
    """The unique identifier of the sub-agent to add"""
    subAgentId: UUID!
  ): Boolean!
  """
  Add a tool to an agent's available tool set. Triggers a Git push if linked + author args provided.
  """
  addTool(
    """The unique identifier of the agent"""
    agentId: UUID!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The unique identifier of the tool to add"""
    toolId: UUID!
  ): Boolean!
  """Delete an agent by its ID. Returns true if the agent was deleted."""
  delete(
    """The unique identifier of the agent to delete"""
    id: UUID!
  ): Boolean!
  """
  Update an existing AI agent definition. Triggers a Git push if linked + author args provided.
  """
  edit(
    """The updated agent definition"""
    agent: AgentInput!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The unique identifier of the agent to update"""
    id: UUID!
  ): Agent
  """
  Remove a sub-agent from a parent agent. Triggers a Git push if linked + author args provided.
  """
  removeSubAgent(
    """The unique identifier of the parent agent"""
    agentId: UUID!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The unique identifier of the sub-agent to remove"""
    subAgentId: UUID!
  ): Boolean!
  """
  Remove a tool from an agent's available tool set. Triggers a Git push if linked + author args provided.
  """
  removeTool(
    """The unique identifier of the agent"""
    agentId: UUID!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The unique identifier of the tool to remove"""
    toolId: UUID!
  ): Boolean!
  """
  Replace the entire list of sub-agents for a parent agent. Triggers a Git push if linked + author args provided.
  """
  setSubAgents(
    """The unique identifier of the parent agent"""
    agentId: UUID!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The ordered list of sub-agent IDs to set"""
    subAgentIds: [UUID!]!
  ): Boolean!
  """
  Replace the entire list of tools for an agent. Triggers a Git push if linked + author args provided.
  """
  setTools(
    """The unique identifier of the agent"""
    agentId: UUID!
    """
    Commit author email for the Git push (only used when the agent is Git-linked).
    """
    authorEmail: String
    """
    Commit author name for the Git push (only used when the agent is Git-linked).
    """
    authorName: String
    """The list of tool IDs to set as the agent's available tools"""
    toolIds: [UUID!]!
  ): Boolean!
}

"""
Top-level read namespace for the AI domain: agents, tools, MCP servers, models, prompts.
"""
type Ai {
  """Agent-resource CRUD (Bosca-MCP-exposable resources)."""
  agentResources: AgentResources!
  """Agent-tool CRUD."""
  agentTools: AgentTools!
  """Agent CRUD + sub-agent / tool join lookups."""
  agents: Agents!
  """
  MCP namespace: inbound external-server registrations (`servers`) and the outbound Bosca MCP surface (`bosca`).
  """
  mcp: AiMcp!
  """AI model definitions."""
  models: Models!
  """Prompt template CRUD."""
  prompts: Prompts!
}

"""
Structured LLM commentary attached to an AnalysisReport on top of the
deterministic verdict. Strictly additive — the deterministic summary and
recommendation on the parent report remain the authoritative product
surface, and this payload only appears after the analyzer's
verdict-acknowledgement check has passed.
"""
type AiInsights {
  """
  1–3 sentences describing observations spanning multiple conversion goals. When there is only one goal, the analyzer says so briefly.
  """
  crossGoalPatterns: String!
  """
  One or two concrete next experiments to consider, grounded in the observed data.
  """
  followUpExperiments: [String!]!
  """
  1–3 sentences reconciling the observed result against the operator's hypothesis.
  """
  hypothesisAssessment: String!
  """
  Common bucketing/tracking failure modes to investigate first. Populated only when the deterministic verdict is SRM_FAILED.
  """
  srmRootCauseHints: String
}

"""
The `ai.mcp` namespace. `servers` is inbound — registrations for external MCP servers Bosca
consumes; `bosca` is outbound — Bosca acting as an MCP server, exposing its own tools/resources.
"""
type AiMcp {
  """Inbound: registrations for external MCP servers Bosca consumes."""
  servers: McpServers!
}

"""The `ai.mcp` mutation namespace."""
type AiMcpMutation {
  """Inbound: manage registrations for external MCP servers Bosca consumes."""
  servers: McpServersMutation!
}

"""
Top-level write namespace for the AI domain. Also exposes `agentRepo` for AGENT_PROJECT Git management.
"""
type AiMutation {
  """AGENT_PROJECT repository operations (link, push, backfill)."""
  agentRepo: AgentRepoMutation!
  """Agent-resource CRUD (Bosca-MCP-exposable resources)."""
  agentResources: AgentResourcesMutation!
  """Agent-tool CRUD."""
  agentTools: AgentToolsMutation!
  """Agent CRUD + sub-agent / tool wiring."""
  agents: AgentsMutation!
  """
  MCP namespace: manage inbound external-server registrations and the outbound Bosca MCP surface.
  """
  mcp: AiMcpMutation!
  """AI model CRUD."""
  models: ModelsMutation!
  """Prompt template CRUD."""
  prompts: PromptsMutation!
}

"""A fixed amount off the cart."""
type AmountOffCartRule {
  amount: Money!
  type: String!
}

"""A fixed amount off a subscription renewal."""
type AmountOffSubscriptionRule {
  amount: Money!
  type: String!
}

"""
Statistical method used to compute per-variation confidence.

FREQUENTIST (the default) applies chi-squared for UNIQUE_CONVERSION
goals and Welch's t for EVENT_COUNT, with Bonferroni correction
across the goal × (variations - 1) family.

BAYESIAN replaces the per-variation confidence with a posterior
`probabilityBeatsControl` (and an `expectedLoss` regret metric).
No Bonferroni correction is applied — Bayesian posteriors have no
family-wise error rate to control. Bayesian verdicts are
interpretable at any sample size, so peeking at results does not
inflate false-positive rates.
"""
enum AnalysisMethod {
  BAYESIAN
  FREQUENTIST
}

"""
An automated analysis report for an experiment.

`summary` and `recommendation` are the deterministic prose written by the
statistical pipeline (chi-squared / Welch's t / Bonferroni) and are the
authoritative product surface for the verdict. `details` is the structured
per-goal/per-variation breakdown the admin UI uses to render tables.

`aiInsights` is an OPTIONAL structured commentary payload written by the
LLM analyzer on top of the deterministic result. It is strictly additive
and labeled as AI in the UI: the analysis job never replaces
summary/recommendation with AI output, and the analyzer rejects any LLM
response whose internal verdict-acknowledgement guardrail does not match
the deterministic verdict, so the AI section can never silently
contradict the deterministic decision. Null when no AI analyzer is wired
or when the verifier rejected the response.
"""
type AnalysisReport {
  aiInsights: AiInsights
  confidence: Float
  created: DateTime!
  details: JSON!
  experimentId: UUID!
  id: UUID!
  recommendation: String!
  summary: String!
}

"""Root analytics query type providing access to all analytics features"""
type Analytics {
  """
  Access distributed counter telemetry (active sessions, API response-code rates).
  """
  counters: AnalyticsCounters!
  """Access analytics dashboard queries"""
  dashboards: AnalyticsDashboards!
  """Access the error tracking subsystem (groups, status, AI analysis)"""
  errors: AnalyticsErrors!
  """Access analytics query operations"""
  queries: AnalyticsQueries!
  """
  Access analytics script bindings (scripts that run inline over analytics events)
  """
  scriptBindings: AnalyticsScriptBindings!
  """Access analytics visualization queries"""
  visualizations: AnalyticsVisualizations!
}

"""
A distributed counter (active sessions, API response-code rates, …) read as a typed window aggregate or a per-bucket time series.
"""
type AnalyticsCounter {
  """
  The counter identifier — the key prefix before the trailing time bucket (e.g. `sessions.mobile`, `http.bosca.5xx`).
  """
  id: ID!
  """
  How the counter aggregates over its window: GAUGE reads the peak bucket, COUNTER sums the buckets.
  """
  type: AnalyticsCounterType!
  """
  Aggregate over the last `window` buckets — GAUGE returns the max, COUNTER the sum. Omit `window` to use the counter's default lookback.
  """
  value(window: Int): Long!
  """
  Per-bucket time series over the last `window` buckets (oldest → newest, zero-filled), for graphing. Omit `window` to use the counter's default lookback.
  """
  values(window: Int): [AnalyticsCounterValue!]!
}

"""
How an AnalyticsCounter aggregates its per-bucket samples over a window. Intrinsic to the counter — the caller does not choose it.
"""
enum AnalyticsCounterType {
  """
  A monotonic tally; the window value is the sum of the window's buckets (e.g. API response codes).
  """
  COUNTER
  """
  A level that rises and falls; the window value is the peak bucket (e.g. active sessions).
  """
  GAUGE
}

"""
A single point in a counter's time series: the value accumulated in one bucket, stamped at the bucket's start (UTC). Empty buckets report 0 so the series is dense and directly graphable.
"""
type AnalyticsCounterValue {
  """Start of the bucket this value covers (UTC)."""
  time: DateTime!
  """The counter's value for this bucket."""
  value: Long!
}

"""
Read access to the platform's distributed counters (session and API health telemetry).
"""
type AnalyticsCounters {
  """
  Look up a counter by id, resolving its type from the built-in counter registry. Errors if the id matches no known counter family.
  """
  byId(id: ID!): AnalyticsCounter!
}

"""
A dashboard that groups multiple analytics visualizations together with shared parameters and access control
"""
type AnalyticsDashboard {
  """
  Optional JSON configuration for dashboard-level layout, theming, or behavior settings
  """
  configuration: JSON
  """Human-readable description of what this dashboard shows"""
  description: String!
  """Unique identifier for this dashboard"""
  id: UUID!
  """Unique string key used to reference this dashboard programmatically"""
  key: String!
  """Human-readable display name for this dashboard"""
  name: String!
  """
  User-facing parameters that act as shared filters across the dashboard's visualizations
  """
  parameters: [AnalyticsDashboardParameter!]
  """Access control permissions assigned to this dashboard"""
  permissions: [Permission!]!
  """Ordered list of visualization instances displayed on this dashboard"""
  visualizations: [AnalyticsVisualizationInstance!]!
}

"""Input for creating or updating an analytics dashboard"""
input AnalyticsDashboardInput {
  """
  Optional JSON configuration for dashboard-level layout, theming, or behavior settings
  """
  configuration: JSON
  """Human-readable description of what this dashboard shows"""
  description: String!
  """
  Existing dashboard ID for updates; omit or null when creating a new dashboard
  """
  id: UUID
  """Unique string key used to reference this dashboard programmatically"""
  key: String!
  """Human-readable display name for this dashboard"""
  name: String!
  """User-facing parameter definitions for shared filters"""
  parameters: [AnalyticsQueryParameterInput!]
  """Ordered list of visualization instances to display on this dashboard"""
  visualizations: [AnalyticsVisualizationInstanceInput!]!
}

"""
A parameter definition for an analytics dashboard, controlling user-facing filter inputs
"""
type AnalyticsDashboardParameter {
  """
  When type is ARRAY, specifies the data type of elements within the array
  """
  arrayType: QueryParameterType
  """Default value used when the user does not provide an explicit value"""
  defaultValue: JSON
  """Human-readable description of what this parameter controls"""
  description: String!
  """Human-readable display name for this dashboard parameter"""
  name: String!
  """
  Unique parameter identifier used to bind this parameter to visualization queries
  """
  parameter: String!
  """
  Whether the user must supply this parameter before the dashboard can render
  """
  required: Boolean
  """The data type of this parameter's value"""
  type: QueryParameterType!
}

"""Query operations for retrieving analytics dashboards"""
type AnalyticsDashboards {
  """Retrieve all analytics dashboards the current user has access to"""
  all: [AnalyticsDashboard!]!
  """Retrieve a single dashboard by its unique ID"""
  byId(id: UUID!): AnalyticsDashboard!
  """
  Look up a dashboard by its unique string key; returns null if not found
  """
  byKey(key: String!): AnalyticsDashboard
}

"""
Mutation operations for managing analytics dashboards and their contents
"""
type AnalyticsDashboardsMutation {
  """Create a new analytics dashboard"""
  add(dashboard: AnalyticsDashboardInput!): AnalyticsDashboard!
  """Grant a permission on a dashboard"""
  addPermission(permission: PermissionInput!): Permission!
  """
  Add a visualization instance to a dashboard, returning the new instance's ID
  """
  addVisualization(configuration: JSON, dashboardId: UUID!, visualizationId: UUID!): UUID!
  """Delete an analytics dashboard by its unique ID"""
  delete(id: UUID!): Boolean!
  """Revoke a permission from a dashboard"""
  deletePermission(permission: PermissionInput!): Permission!
  """Update an existing analytics dashboard"""
  edit(dashboard: AnalyticsDashboardInput!): AnalyticsDashboard!
  """Remove a visualization instance from a dashboard by its instance ID"""
  removeVisualization(id: UUID!): Boolean!
}

"""
Typed device snapshot used by `evaluate` / `evaluateAll`. See the
Kotlin `bosca.analytics.model.Device` class and `Device.attributeValue`
for the canonical field set, alias table, and rules around adding new
keys. Distinct from the `DeviceInput` declared by the `devices`
framework module.
"""
input AnalyticsDevice {
  installationId: String
  manufacturer: String
  model: String
  platform: String
  primaryLocale: String
  systemName: String
  timezone: String
  type: String
  version: String
}

"""Query operations for the error tracking subsystem."""
type AnalyticsErrors {
  """
  Retrieve a single error group by its fingerprint, or null if none exists
  """
  group(fingerprint: String!): ErrorGroup
  """
  Retrieve a paginated, filtered list of error groups for the admin error tracking UI
  """
  groups(filter: ErrorGroupFilter, limit: Int, offset: Long): ErrorGroupConnection!
}

"""Mutation operations for the error tracking subsystem."""
type AnalyticsErrorsMutation {
  """
  Run AI root-cause analysis against an error group and cache the result on the group row
  """
  analyze(fingerprint: String!): ErrorGroup!
  """Assign or unassign the operator responsible for an error group"""
  assign(assigneeId: UUID, fingerprint: String!): ErrorGroup!
  """Set the lifecycle status of an error group (open, resolved, ignored)"""
  setStatus(fingerprint: String!, status: ErrorGroupStatus!): ErrorGroup!
}

"""Mutation operations for the analytics domain"""
type AnalyticsMutation {
  """Access analytics dashboard mutations"""
  dashboards: AnalyticsDashboardsMutation!
  """Access mutation operations for error tracking"""
  errors: AnalyticsErrorsMutation!
  """Access analytics query mutations"""
  queries: AnalyticsQueriesMutation!
  """Access mutation operations for analytics script bindings"""
  scriptBindings: AnalyticsScriptBindingsMutation!
  """Access analytics visualization mutations"""
  visualizations: AnalyticsVisualizationsMutation!
}

"""Query operations for managing and executing analytics queries"""
type AnalyticsQueries {
  """Retrieve all analytics query definitions"""
  all: [AnalyticsQuery!]!
  """
  Execute an analytics query identified by its UUID, passing the given parameter values, and return the results
  """
  execute(parameters: [AnalyticsQueryExecutionParameterInput!]!, queryId: UUID!): AnalyticsQueryResponse!
  """
  Execute an analytics query identified by its string key, passing the given parameter values, and return the results
  """
  executeByKey(key: String!, parameters: [AnalyticsQueryExecutionParameterInput!]!): AnalyticsQueryResponse!
  """Retrieve a single analytics query by its unique ID"""
  queryById(id: UUID!): AnalyticsQuery!
  """
  Look up an analytics query by its unique string key; returns null if not found
  """
  queryByKey(key: String!): AnalyticsQuery
}

"""
Mutation operations for creating, updating, and deleting analytics query definitions
"""
type AnalyticsQueriesMutation {
  """Create a new analytics query definition"""
  add(query: AnalyticsQueryInput!, sourceRef: SourceRefInput): AnalyticsQuery!
  """Grant a permission on a query"""
  addPermission(permission: PermissionInput!): Permission!
  """Delete an analytics query definition by its unique ID"""
  delete(id: UUID!): Boolean!
  """Revoke a permission from a query"""
  deletePermission(permission: PermissionInput!): Permission!
  """
  Update an existing analytics query definition. When authorName and authorEmail are supplied and the query has a linked git file, the updated SQL and parameters are also pushed to git as part of the response.
  """
  edit(authorEmail: String, authorName: String, query: AnalyticsQueryInput!, sourceRef: SourceRefInput): AnalyticsQuery!
  """
  One-shot backfill: commit every git-backed analytics query in the given repository to its linked file, regenerating the @bosca-query metadata block. Returns the number of queries that produced a commit.
  """
  pushAllToGit(authorEmail: String!, authorName: String!, repositoryId: UUID!): Int!
  """
  Commit the query's current SQL back to its linked git file. Returns the new commit SHA, or null when the query has no source ref.
  """
  pushToGit(authorEmail: String!, authorName: String!, queryId: UUID!): String
  """
  Refresh the cached results for a query on demand: re-executes every cached parameter combination in the background and replaces the cached records. Returns true when the refresh was enqueued, false when the query does not cache results.
  """
  refresh(queryId: UUID!): Boolean!
}

"""
A saved analytics query definition that can be executed with parameters to retrieve analytics data
"""
type AnalyticsQuery {
  """
  The output columns this query returns, probed without fetching rows. Empty if undeterminable. Lets clients filter queries by the shape a consumer requires (e.g. a recommendation strategy needing metadata_id/collection_id).
  """
  columns: [AnalyticsQueryColumn!]!
  """
  Optional JSON configuration controlling query behavior, formatting, or execution options
  """
  configuration: JSON
  """Human-readable description of what this query does"""
  description: String!
  """Unique identifier for this analytics query"""
  id: UUID!
  """Unique string key used to reference this query programmatically"""
  key: String!
  """Human-readable display name for this query"""
  name: String!
  """Ordered list of parameters that this query accepts for execution"""
  parameters: [AnalyticsQueryParameter!]!
  """Access control permissions assigned to this query"""
  permissions: [Permission!]!
  """
  The raw query string to execute (e.g. SQL or domain-specific query language)
  """
  query: String
  """
  When set, results are cached and refreshed in the background on this interval (in seconds). When null, every execution runs against the analytics store directly.
  """
  refreshIntervalSeconds: Int
}

"""
Describes a single output column of an analytics query, derived from its result-set metadata.
"""
type AnalyticsQueryColumn {
  """The output column name, as returned by the query (e.g. metadata_id)"""
  name: String!
  """
  Whether the column may contain nulls (best-effort, from result-set metadata)
  """
  nullable: Boolean!
  """The SQL type name of the column (e.g. varchar, bigint, double)"""
  typeName: String!
}

"""A named parameter value to pass when executing an analytics query"""
input AnalyticsQueryExecutionParameterInput {
  """The parameter identifier matching a parameter defined on the query"""
  parameter: String
  """The value to bind to the parameter, as a JSON-compatible value"""
  value: JSON
}

"""Input for creating or updating an analytics query definition"""
input AnalyticsQueryInput {
  """
  Optional JSON configuration controlling query behavior, formatting, or execution options
  """
  configuration: JSON
  """Human-readable description of what this query does"""
  description: String!
  """Existing query ID for updates; omit or null when creating a new query"""
  id: UUID
  """Unique string key used to reference this query programmatically"""
  key: String!
  """Human-readable display name for this query"""
  name: String!
  """Ordered list of parameter definitions that this query accepts"""
  parameters: [AnalyticsQueryParameterInput!]!
  """
  The raw query string to execute (e.g. SQL or domain-specific query language)
  """
  query: String!
  """
  When set, results are cached and refreshed in the background on this interval (in seconds). When null or omitted, results are never cached.
  """
  refreshIntervalSeconds: Int
}

"""
A parameter definition for an analytics query, describing its name, type, and constraints
"""
type AnalyticsQueryParameter {
  """
  When type is ARRAY, specifies the data type of elements within the array
  """
  arrayType: QueryParameterType!
  """
  Default value used when no explicit value is provided at execution time
  """
  defaultValue: JSON
  """Human-readable description of what this parameter controls"""
  description: String!
  """Human-readable display name for this parameter"""
  name: String!
  """
  Unique parameter identifier used as the placeholder name in the query string
  """
  parameter: String!
  """Whether this parameter must be supplied when executing the query"""
  required: Boolean!
  """Sort order for display purposes (lower values appear first)"""
  sort: Int!
  """The data type of this parameter's value"""
  type: QueryParameterType!
}

"""Input for creating or updating an analytics query parameter definition"""
input AnalyticsQueryParameterInput {
  """
  When type is ARRAY, specifies the data type of elements within the array
  """
  arrayType: QueryParameterType
  """
  Default value used when no explicit value is provided at execution time
  """
  defaultValue: JSON
  """Human-readable description of what this parameter controls"""
  description: String!
  """Human-readable display name for this parameter"""
  name: String!
  """
  Unique parameter identifier used as the placeholder name in the query string
  """
  parameter: String!
  """Whether this parameter must be supplied when executing the query"""
  required: Boolean
  """The data type of this parameter's value"""
  type: QueryParameterType!
}

"""
The result of executing an analytics query, containing the returned data rows
"""
type AnalyticsQueryResponse {
  """
  Whether the records were served from the query result cache instead of being computed for this request
  """
  cached: Boolean!
  """
  Array of result records, where each record is a JSON object representing one row of data
  """
  records: [JSON!]!
  """
  When the records were last computed by the analytics store; null for uncached executions, where the records are always current
  """
  refreshedAt: DateTime
  """
  Whether cached records are older than the query's configured refresh interval and are awaiting refresh
  """
  stale: Boolean!
}

"""
Binds a stored script to analytics events so every event batch flows through the script inline in
the processor's transform chain, bypassing the durable pipeline run machinery (and its bookkeeping).
The script receives the whole batch and filters it itself — there is no event-type routing.
"""
type AnalyticsScriptBinding {
  """Row creation timestamp"""
  created: DateTime!
  """When false the binding is skipped entirely"""
  enabled: Boolean!
  """Unique identifier for this binding"""
  id: UUID!
  """Row last-modified timestamp"""
  modified: DateTime!
  """
  Execution order; lower ordinals run first and (for transforms) their output feeds higher ordinals
  """
  ordinal: Int!
  """The scripting-module script this binding runs over every batch"""
  scriptId: UUID!
  """
  When true the script's returned batch replaces the events flowing through (pass through / filter); when false the script runs for side effects only and its output is ignored
  """
  transform: Boolean!
}

"""Query operations for analytics script bindings."""
type AnalyticsScriptBindings {
  """All bindings (enabled and disabled), in execution order"""
  all: [AnalyticsScriptBinding!]!
  """A single binding by id, or null if none exists"""
  binding(id: UUID!): AnalyticsScriptBinding
}

"""Mutation operations for analytics script bindings."""
type AnalyticsScriptBindingsMutation {
  """
  Bind a script to run over every analytics event batch (transform defaults to true — the script's output replaces the batch)
  """
  add(enabled: Boolean, ordinal: Int, scriptId: UUID!, transform: Boolean): AnalyticsScriptBinding!
  """Delete a binding by id"""
  delete(id: UUID!): Boolean!
  """Replace the mutable fields of an existing binding"""
  update(enabled: Boolean, id: UUID!, ordinal: Int, scriptId: UUID!, transform: Boolean): AnalyticsScriptBinding!
}

"""
A reusable visualization definition that specifies how to render analytics query results
"""
type AnalyticsVisualization {
  """
  Optional JSON configuration for chart options, styling, axis labels, color schemes, and other rendering settings
  """
  configuration: JSON
  """Human-readable description of what this visualization shows"""
  description: String!
  """Unique identifier for this visualization"""
  id: UUID!
  """
  Unique string key used to reference this visualization programmatically
  """
  key: String!
  """Human-readable display name for this visualization"""
  name: String!
  """Access control permissions assigned to this visualization"""
  permissions: [Permission!]!
  """
  The ID of the analytics query whose results this visualization renders; null for non-data visualizations like DATEPICKER or LABEL
  """
  queryId: UUID
  """The chart or display type used to render this visualization"""
  type: AnalyticsVisualizationType!
}

"""Input for creating or updating an analytics visualization definition"""
input AnalyticsVisualizationInput {
  """
  Optional JSON configuration for chart options, styling, axis labels, color schemes, and other rendering settings
  """
  configuration: JSON
  """Human-readable description of what this visualization shows"""
  description: String!
  """
  Existing visualization ID for updates; omit or null when creating a new visualization
  """
  id: UUID
  """
  Unique string key used to reference this visualization programmatically
  """
  key: String!
  """Human-readable display name for this visualization"""
  name: String!
  """
  The ID of the analytics query whose results this visualization renders; null for non-data visualizations
  """
  queryId: UUID
  """The chart or display type used to render this visualization"""
  type: AnalyticsVisualizationType!
}

"""
A placed instance of a visualization within a dashboard, with optional per-instance configuration overrides
"""
type AnalyticsVisualizationInstance {
  """
  Optional JSON configuration overriding or extending the visualization's default configuration for this dashboard placement
  """
  configuration: JSON
  """Unique identifier for this visualization instance within the dashboard"""
  id: UUID!
  """The visualization definition that this instance renders"""
  visualization: AnalyticsVisualization!
}

"""Input for placing a visualization instance on a dashboard"""
input AnalyticsVisualizationInstanceInput {
  """
  Optional JSON configuration overriding or extending the visualization's default configuration for this placement
  """
  configuration: JSON
  """The ID of the visualization definition to place on the dashboard"""
  visualizationId: UUID!
}

"""The chart or display type used to render an analytics visualization"""
enum AnalyticsVisualizationType {
  """A bar chart with vertical or horizontal bars"""
  BAR
  """A bubble chart plotting data points as circles with variable size"""
  BUBBLE
  """
  A date picker control used as an interactive filter input on dashboards
  """
  DATEPICKER
  """A doughnut chart — a pie chart with a hollow center"""
  DOUGHNUT
  """
  A geographic point/marker map plotting one point per row at its latitude/longitude, optionally colored by a series column
  """
  GEO_POINT_MAP
  """A text label display for static or dynamic text content"""
  LABEL
  """A line chart showing data trends over a continuous axis"""
  LINE
  """
  A live, streaming point map fed by the liveSessions subscription (by configured appId) rather than a query; has no queryId
  """
  LIVE_SESSIONS_MAP
  """A single numeric value display (e.g. KPI card, counter)"""
  NUMBER
  """A pie chart showing proportional segments of a whole"""
  PIE
  """A scatter plot showing individual data points on two axes"""
  SCATTER
  """A tabular data grid displaying rows and columns"""
  TABLE
  """A geographic map visualization using TopoJSON boundary data"""
  TOPO_JSON_MAP
}

"""Query operations for retrieving analytics visualization definitions"""
type AnalyticsVisualizations {
  """Retrieve all analytics visualization definitions"""
  all: [AnalyticsVisualization!]!
  """Retrieve a single visualization by its unique ID"""
  byId(id: UUID!): AnalyticsVisualization!
  """
  Look up a visualization by its unique string key; returns null if not found
  """
  byKey(key: String!): AnalyticsVisualization
}

"""Mutation operations for managing analytics visualization definitions"""
type AnalyticsVisualizationsMutation {
  """Create a new analytics visualization definition"""
  add(visualization: AnalyticsVisualizationInput!): AnalyticsVisualization!
  """Grant a permission on a visualization"""
  addPermission(permission: PermissionInput!): Permission!
  """Delete an analytics visualization definition by its unique ID"""
  delete(id: UUID!): Boolean!
  """Revoke a permission from a visualization"""
  deletePermission(permission: PermissionInput!): Permission!
  """Update an existing analytics visualization definition"""
  edit(visualization: AnalyticsVisualizationInput!): AnalyticsVisualization!
}

"""
A long-lived API token credential for programmatic access. The raw token value is only available at creation time.
"""
type ApiToken {
  """Whether this token is currently usable (not revoked and not expired)"""
  active: Boolean!
  """
  Subset of the principal's groups this token may act under. Null means all groups.
  """
  allowedGroups: [UUID!]
  """Optional description of this token's purpose"""
  description: String
  """When this token expires. Null means it never expires."""
  expiresAt: DateTime
  """Credential ID in the principal_credentials table"""
  id: Long!
  """When this token was last used for authentication"""
  lastUsedAt: DateTime
  """IP address of the most recent authentication using this token"""
  lastUsedIp: String
  """Human-readable name for identifying this token"""
  name: String!
  """ID of the principal this token authenticates as"""
  principalId: UUID!
  """When this token was revoked. Null means it is still active."""
  revokedAt: DateTime
  """
  List of scopes restricting this token's permissions. Null means unrestricted.
  """
  scopes: [String!]
  """First 12 characters of the raw token, for identification in the UI"""
  tokenPrefix: String!
}

"""
Response returned when creating a new API token. Contains the raw token value which is only shown once.
"""
type ApiTokenCreationResponse {
  """The created token metadata"""
  apiToken: ApiToken!
  """
  The raw token value. Store this securely — it cannot be retrieved again.
  """
  rawToken: String!
}

"""Input for creating a new API token"""
input ApiTokenInput {
  """
  Group IDs to restrict this token to. Must be a subset of the principal's groups. Omit for all groups.
  """
  allowedGroups: [UUID!]
  """Optional description of this token's intended use"""
  description: String
  """When this token should expire. Omit for no expiration."""
  expiresAt: DateTime
  """Human-readable name for the token (e.g. 'CI Deploy Token')"""
  name: String!
  """
  Scopes to restrict this token's permissions. Omit for unrestricted access.
  """
  scopes: [String!]
}

"""Describes an available API token scope"""
type ApiTokenScopeInfo {
  """Human-readable description of what this scope permits"""
  description: String!
  """The scope identifier (e.g. 'content:view')"""
  name: String!
}

"""Query operations for API tokens"""
type ApiTokens {
  """List all available scope values"""
  availableScopes: [ApiTokenScopeInfo!]!
  """
  List all API tokens for a specific principal. Allowed for the principal themselves; listing another principal's tokens requires admin.
  """
  forPrincipal(limit: Int!, offset: Long!, principalId: UUID!): [ApiToken!]!
  """List all API tokens for the current principal"""
  my(limit: Int!, offset: Long!): [ApiToken!]!
  """Retrieve a specific API token by credential ID"""
  token(id: Long!): ApiToken
}

"""Mutation operations for managing API tokens"""
type ApiTokensMutation {
  """
  Create a new API token for the current principal. The raw token is only returned in this response.
  """
  create(input: ApiTokenInput!): ApiTokenCreationResponse!
  """
  Create a new API token for a specific principal. Allowed for the principal themselves (equivalent to create); minting a token for another principal requires admin.
  """
  createForPrincipal(input: ApiTokenInput!, principalId: UUID!): ApiTokenCreationResponse!
  """Permanently delete a revoked token record"""
  delete(id: Long!): Boolean!
  """Update a token's name, description, or scopes"""
  edit(description: String, id: Long!, name: String, scopes: [String!]): ApiToken!
  """
  Revoke an API token immediately. The token can no longer be used for authentication.
  """
  revoke(id: Long!): Boolean!
  """Revoke all API tokens for the current principal"""
  revokeAll: Boolean!
  """
  Revoke all API tokens for a specific principal. Allowed for the principal themselves (equivalent to revokeAll); revoking another principal's tokens requires admin.
  """
  revokeAllForPrincipal(principalId: UUID!): Boolean!
}

"""An artifact namespace that groups repositories for access control"""
type ArtifactNamespaceInfo {
  """When this namespace was created"""
  created: DateTime
  """Unique identifier"""
  id: UUID!
  """Namespace name (e.g. 'library', 'com.acme', '@scope')"""
  name: String!
  """Permission grants on this namespace. Requires admin."""
  permissions: [Permission!]!
  """Whether anonymous pull access is allowed"""
  public: Boolean!
  """
  Repositories within this namespace, optionally filtered by type; unpaged when limit is omitted
  """
  repositories(limit: Int, offset: Long, type: ArtifactRegistryType): [ArtifactRepoInfo!]!
  """
  Number of repositories within this namespace, optionally filtered by type
  """
  repositoryCount(type: ArtifactRegistryType): Long!
}

"""The registry protocol an artifact repository serves"""
enum ArtifactRegistryType {
  """Docker / OCI container images"""
  docker
  """Helm chart packages"""
  helm
  """Maven / Gradle JVM artifacts"""
  maven
  """Machine learning model artifacts (one tar archive per version)"""
  ml
  """npm JavaScript packages"""
  npm
  """Raw file artifacts (binaries, archives, etc.)"""
  raw
}

"""An artifact repository within a namespace"""
type ArtifactRepoInfo {
  """When this repository was created"""
  created: DateTime
  """Unique identifier"""
  id: UUID!
  """When this repository was last modified"""
  modified: DateTime
  """Repository name"""
  name: String!
  """The owning namespace"""
  namespace: ArtifactNamespaceInfo
  """ID of the owning namespace"""
  namespaceId: UUID!
  """Number of tags in this repository"""
  tagCount: Long!
  """
  Tags in this repository (Docker only), ordered by name (defaults to the first 100)
  """
  tags(limit: Int, offset: Long): [ArtifactTagInfo!]!
  """Registry protocol type"""
  type: String!
  """Number of versions in this repository"""
  versionCount: Long!
  """Versions in this repository, newest first (defaults to the first 100)"""
  versions(limit: Int, offset: Long): [ArtifactVersionInfo!]!
}

"""A GHCR image path; each published source tag is preserved."""
type ArtifactSyncDestination {
  created: DateTime
  enabled: Boolean!
  id: UUID!
  key: String!
  modified: DateTime
  remoteRepository: String!
  repositoryId: UUID!
  tokenSecretName: String!
  username: String!
  version: Long!
}

"""A mutable tag pointing to a specific manifest digest (Docker)"""
type ArtifactTagInfo {
  """When this tag was created"""
  created: DateTime
  """Unique identifier"""
  id: UUID!
  """Digest of the manifest this tag points to"""
  manifestDigest: String!
  """When this tag was last updated"""
  modified: DateTime
  """Tag name (e.g. 'latest', 'v1.0')"""
  name: String!
  """ID of the owning repository"""
  repositoryId: UUID!
}

"""Association between a version and a blob with a specific role"""
type ArtifactVersionBlobInfo {
  """Content digest (e.g. sha256:abcdef...)"""
  digest: String!
  """Original filename, if applicable"""
  filename: String
  """MIME type of the blob content"""
  mediaType: String
  """
  Role of this blob within the version (manifest, layer, tarball, jar, etc.)
  """
  role: String!
  """Size of the blob in bytes"""
  size: Long
}

"""A versioned release of an artifact"""
type ArtifactVersionInfo {
  """Blobs associated with this version"""
  blobs: [ArtifactVersionBlobInfo!]!
  """When this version was created"""
  created: DateTime
  """Unique identifier"""
  id: UUID!
  """
  Protocol-specific metadata (package.json, POM coords, manifest media type, etc.)
  """
  metadata: JSON
  """ID of the owning repository"""
  repositoryId: UUID!
  """Version string (semver, digest, etc.)"""
  version: String!
}

"""Administrative queries for artifact registry management"""
type ArtifactsAdmin {
  """Get a specific namespace by ID"""
  namespace(id: UUID!): ArtifactNamespaceInfo
  """List all artifact namespaces"""
  namespaces: [ArtifactNamespaceInfo!]!
  """List repositories, optionally filtered by type"""
  repositories(limit: Int, namespaceId: UUID, offset: Long, type: ArtifactRegistryType): [ArtifactRepoInfo!]!
  """Get a specific repository by ID"""
  repository(id: UUID!): ArtifactRepoInfo
  """List tags for a repository"""
  tags(last: String, limit: Int, repositoryId: UUID!): [ArtifactTagInfo!]!
  """List versions for a repository"""
  versions(repositoryId: UUID!): [ArtifactVersionInfo!]!
}

"""Administrative mutations for artifact registry management"""
type ArtifactsAdminMutation {
  """Grant a permission action to a group on a namespace. Requires admin."""
  addPermission(permission: PermissionInput!): Boolean!
  """Create a new namespace"""
  createNamespace(name: String!, public: Boolean): ArtifactNamespaceInfo!
  """Create a repository within a namespace"""
  createRepository(name: String!, namespaceId: UUID!, type: ArtifactRegistryType!): ArtifactRepoInfo!
  """Delete a namespace and all its repositories (admin only)"""
  deleteNamespace(id: UUID!): Boolean!
  """Delete a repository and all its versions, tags, and blobs"""
  deleteRepository(id: UUID!): Boolean!
  """
  Delete a GHCR sync destination and its sync records with optimistic locking, preserving source and remote images. Requires admin.
  """
  deleteSyncDestination(id: UUID!, version: Long!): Boolean!
  """Delete a tag from a repository"""
  deleteTag(name: String!, repositoryId: UUID!): Boolean!
  """Delete a specific version and its blob associations"""
  deleteVersion(id: UUID!): Boolean!
  """
  Queue a current Docker tag for one enabled GHCR destination under the caller's identity. Returns the durable pipeline run ID. Requires admin.
  """
  pushImage(destinationId: UUID!, tagName: String!): UUID!
  """
  Revoke a permission action from a group on a namespace. Requires admin.
  """
  removePermission(permission: PermissionInput!): Boolean!
  """Set a tag to point at a manifest digest"""
  setTag(manifestDigest: String!, name: String!, repositoryId: UUID!): ArtifactTagInfo!
  """Update a namespace's public (anonymous pull) visibility"""
  updateNamespace(id: UUID!, public: Boolean!): ArtifactNamespaceInfo!
  """
  Update destination configuration with optimistic locking. Changing the image path clears its previous sync records. Requires admin.
  """
  updateSyncDestination(enabled: Boolean!, id: UUID!, key: String, remoteRepository: String, tokenSecretName: String, username: String, version: Long!): ArtifactSyncDestination!
}

"""
Records the assignment of a user or device to a variation within an experiment.
"""
type Assignment {
  assignedAt: DateTime!
  experimentId: UUID!
  id: UUID!
  installationId: String
  principalId: UUID
  """The variation key this user was bucketed into."""
  variationKey: String!
}

"""
Where an attribute is applied — on the item itself or on a relationship between items
"""
enum AttributeLocation {
  """Attribute is stored directly on the item (metadata or collection)"""
  ITEM
  """
  Attribute is stored on the relationship between a collection and its child items
  """
  RELATIONSHIP
}

"""
The data type of an attribute value, used for validation and serialization
"""
enum AttributeType {
  """Reference to a collection by ID"""
  COLLECTION
  """Date value (no time component)"""
  DATE
  """Date and time value with timezone"""
  DATETIME
  """Date and time value with timezone"""
  DATE_TIME
  """Floating-point number"""
  FLOAT
  """Integer number"""
  INT
  """Reference to a metadata item by ID"""
  METADATA
  """Reference to a user profile by ID"""
  PROFILE
  """Free-form text string"""
  STRING
}

"""
The UI widget type to use when rendering an attribute in a form or editor
"""
enum AttributeUiType {
  """Collection picker widget"""
  COLLECTION
  """File upload widget"""
  FILE
  """Image upload/preview widget"""
  IMAGE
  """Single-line text input"""
  INPUT
  """Metadata item picker widget"""
  METADATA
  """Profile/user picker widget"""
  PROFILE
  """Multi-line text area"""
  TEXTAREA
}

"""
Filter for selecting specific attribute keys from a JSON attributes object, with support for nested filtering
"""
input AttributesFilterInput {
  """List of top-level attribute keys to include in the result"""
  attributes: [String!]!
  """
  Optional nested filter to apply to child attributes within the selected keys
  """
  childAttributes: AttributesFilterInput
}

"""Tracks the status, result, and metadata of a backup operation."""
type Backup {
  """Timestamp when the backup was initiated."""
  created: DateTime!
  """Error message if the backup failed, null on success."""
  error: String
  """Unique identifier for this backup operation."""
  id: UUID!
  """Whether binary files from object storage are included in this backup."""
  includeFiles: Boolean!
  """
  Metadata item identifier for downloading the backup archive through the standard content API.
  """
  metadataId: UUID
  """Timestamp of the most recent status update."""
  modified: DateTime!
  """
  Object storage path of the completed backup archive, null until the backup finishes.
  """
  path: String
  """Current status of the backup: pending, running, completed, or failed."""
  status: String!
}

"""Query operations for listing and inspecting backup records."""
type Backups {
  """Get a specific backup by its identifier."""
  backup(id: UUID!): Backup
  """List all backups ordered by creation date descending, with pagination."""
  list(limit: Int! = 20, offset: Int! = 0): [Backup!]!
}

"""Mutation operations for creating backups and restoring from them."""
type BackupsMutation {
  """
  Initiate a new backup of all system data. Returns the backup tracking record immediately; the actual backup runs asynchronously.
  """
  create(includeFiles: Boolean! = true): Backup!
  """Delete a backup tracking record and optionally its archive."""
  delete(id: UUID!): Boolean!
  """
  Register an already-uploaded metadata item as an imported backup archive.
  """
  importBackup(metadataId: UUID!): Backup!
  """
  Initiate a restore from a previously completed backup archive. The restore runs asynchronously.
  """
  restore(backupId: UUID!, conflictStrategy: ConflictStrategy! = SKIP): Boolean!
}

"""
Lightweight projection of a banner campaign for weighted random selection. Clients cache this list per placement and perform weighted random selection to pick a banner, then fetch full campaign details separately.
"""
type BannerWeight {
  """The unique identifier of the banner campaign."""
  id: UUID!
  """
  Relative probability weight for random selection. Not a priority — weights of 10, 10, and 80 yield selection probabilities of 10%, 10%, and 80%.
  """
  weight: Int!
}

type BayesianPrior {
  betaPriorAlpha: Float!
  betaPriorBeta: Float!
  normalPriorMean: Float
  normalPriorVariance: Float
}

"""
Configurable prior distributions for Bayesian analysis. Null on
the parent experiment means "use sane defaults" (uniform Beta(1,1)
and a flat Normal on event-count means), so operators do not have
to configure anything to get reasonable Bayesian output.
"""
input BayesianPriorInput {
  """Beta prior alpha. Default 1.0 (uniform)."""
  betaPriorAlpha: Float
  """Beta prior beta. Default 1.0 (uniform)."""
  betaPriorBeta: Float
  """Normal prior mean for EVENT_COUNT goals. Null = improper flat prior."""
  normalPriorMean: Float
  """
  Normal prior variance for EVENT_COUNT goals. Null = improper flat prior.
  """
  normalPriorVariance: Float
}

"""Input for initiating a workflow state transition on a content item"""
input BeginTransitionInput {
  """
  ID of the collection to transition (mutually exclusive with metadataId)
  """
  collectionId: UUID
  """BCP 47 language tag for language-specific transitions"""
  languageTag: String
  """
  ID of the metadata item to transition (mutually exclusive with collectionId)
  """
  metadataId: UUID
  """Whether to restart the transition if it has already been attempted"""
  restart: Boolean
  """The target state ID to transition to"""
  stateId: String!
  """Timestamp when this state becomes valid"""
  stateValid: DateTime
  """Current status string for the transition"""
  status: String!
  """Optional supplementary ID related to this transition"""
  supplementaryId: String
  """Version of the metadata item to transition"""
  version: Int
}

"""
A Bible translation or version available in the system, containing books, chapters, and verses with rendering metadata for scripture display
"""
type Bible {
  """
  Short abbreviation of the Bible translation in English (e.g. 'ESV', 'NIV')
  """
  abbreviation: String!
  """Short abbreviation of the Bible translation in its native language"""
  abbreviationLocal: String!
  """Look up a specific book by its USFM reference (e.g. 'GEN' for Genesis)"""
  book(usfm: String!): BibleBook
  """All books contained in this Bible translation"""
  books: [BibleBook!]!
  """
  Look up a specific chapter by its USFM reference (e.g. 'GEN.1' for Genesis chapter 1)
  """
  chapter(usfm: String!): BibleChapter
  """
  Whether this is the default variant when multiple variants exist for the same Bible translation
  """
  defaultVariant: Boolean!
  """Human-readable description of this Bible translation"""
  description: String!
  """Whether this variant is available to ordinary metadata viewers"""
  enabled: Boolean!
  """
  Search for scripture by a human-readable reference string (e.g. 'Genesis 1:1' or 'John 3:16-18'). Returns matching books, chapters, and verse ranges.
  """
  find(human: String!): [FindBibleResult!]!
  """Languages available for this Bible translation"""
  languages: [BibleLanguage!]!
  """
  Display name of the Bible translation in English (e.g. 'English Standard Version')
  """
  name: String!
  """Display name of the Bible translation in its native language"""
  nameLocal: String!
  """
  JSON object defining the rendering styles for scripture display (e.g. verse numbers, red letter, poetry indentation)
  """
  styles: JSON!
  """
  Unique identifier for this Bible within the external Bible API or system
  """
  systemId: String!
  """
  Variant identifier distinguishing different editions or formats of the same Bible (e.g. 'reader', 'study')
  """
  variant: String!
  """
  Variants stored for the same metadata version. Disabled variants require edit access and includeDisabled: true.
  """
  variants(includeDisabled: Boolean): [Bible!]!
}

"""A book within a Bible translation, such as Genesis or Matthew"""
type BibleBook {
  """Standard abbreviation for the book (e.g. 'Gen', 'Matt')"""
  abbreviation: String!
  """All chapters contained in this book"""
  chapters: [BibleChapter!]!
  """Full name of the book (e.g. 'The Book of Genesis')"""
  nameLong: String!
  """Short name of the book (e.g. 'Genesis')"""
  nameShort: String!
  """USFM reference identifying this book"""
  reference: BibleReference!
}

"""
A chapter within a Bible book, containing the rendered component tree and verse references
"""
type BibleChapter {
  """
  JSON component tree representing the rendered chapter content, including verses, paragraphs, poetry, and styling
  """
  component: JSON!
  """USFM reference identifying this chapter (e.g. 'GEN.1')"""
  reference: BibleReference!
  """References to all verses contained in this chapter"""
  verses: [BibleReference!]!
}

"""
Input for creating or importing a complete Bible translation, including all books, chapters, languages, and styles
"""
input BibleInput {
  """Short abbreviation in English (e.g. 'ESV', 'NIV')"""
  abbreviation: String!
  """Short abbreviation in the native language"""
  abbreviationLocal: String!
  """All books to include in this Bible"""
  books: [BookInput!]!
  """Whether this should be the default variant for this translation"""
  defaultVariant: Boolean!
  """Human-readable description of the Bible translation"""
  description: String!
  """Languages available for this Bible translation"""
  languages: [BibleLanguageInput!]!
  """Display name in English"""
  name: String!
  """Display name in the native language"""
  nameLocal: String!
  """Rendering styles for scripture display"""
  styles: [StyleInput!]!
  """Unique identifier within the external Bible API or system"""
  systemId: String!
  """Variant identifier for this edition or format"""
  variant: String!
}

"""
A language associated with a Bible translation, including script and directionality information for rendering
"""
type BibleLanguage {
  """ISO 639 language code (e.g. 'eng', 'spa', 'heb')"""
  iso: String!
  """Language name in English (e.g. 'English', 'Spanish')"""
  name: String!
  """Language name in its native form (e.g. 'Espanol')"""
  nameLocal: String!
  """Name of the writing script (e.g. 'Latin', 'Hebrew', 'Arabic')"""
  script: String!
  """ISO 15924 script code (e.g. 'Latn', 'Hebr', 'Arab')"""
  scriptCode: String!
  """
  Text direction of the script: 'LTR' for left-to-right or 'RTL' for right-to-left
  """
  scriptDirection: String!
}

"""Input for specifying a language associated with a Bible translation"""
input BibleLanguageInput {
  """ISO 639 language code (e.g. 'eng', 'spa')"""
  iso: String!
  """Language name in English"""
  name: String!
  """Language name in its native form"""
  nameLocal: String!
  """Name of the writing script (e.g. 'Latin', 'Hebrew')"""
  script: String!
  """ISO 15924 script code (e.g. 'Latn', 'Hebr')"""
  scriptCode: String!
  """Text direction: 'LTR' or 'RTL'"""
  scriptDirection: String!
}

"""
A reference to a specific location in a Bible, providing both human-readable and machine-readable formats
"""
type BibleReference {
  """Full human-readable reference string (e.g. 'Genesis 1:1')"""
  human: String!
  """Short human-readable reference string (e.g. 'Gen 1:1')"""
  humanShort: String!
  """
  USFM (Unified Standard Format Markers) reference identifier (e.g. 'GEN.1.1')
  """
  usfm: String!
}

"""
A project the BML Message Server currently hosts: the active (latest published)
version, the registry pin when one is set (what sends actually render), and the active
version's template keys.
"""
type BmlMessageHostedProject {
  activeVersion: String!
  pinnedVersion: String
  project: String!
  templates: [BmlMessageTemplateInfo!]!
}

"""
A registered BML message project: pin/rollback control over which published artifact
version sends render (null pin = the message server's active/latest version).
"""
type BmlMessageProject {
  created: DateTime!
  description: String
  key: String!
  modified: DateTime!
  """
  When set, sends render THIS published version instead of the active one.
  """
  pinnedVersion: String
  """
  Provenance: the git repository (by id) containing the project's message units.
  """
  repositoryId: UUID
}

"""
One template of a hosted project. samplePayload is the payload skeleton derived from the
template's declared payload serializer — the preview pre-fills it so authors see the structure;
null when the template takes no payload. payloadSchema is the same serializer projected as a
JSON-Schema subset (type/properties/required/items/enum) — the machine-readable contract
authoring surfaces (e.g. the pipeline node inspector) render per field.
"""
type BmlMessageTemplateInfo {
  key: String!
  payloadSchema: JSON
  samplePayload: JSON
  """Whether this BML message unit provides email output."""
  supportsEmail: Boolean!
  """
  Whether this BML message unit provides push output from the same payload and project version.
  """
  supportsPush: Boolean!
}

"""
The resolved message template and parameters captured for a delivery render attempt.
"""
type BmlMessageTemplateRender {
  """The template payload supplied by the communication."""
  parameters: JSON
  project: String!
  templateKey: String!
  """The concrete published artifact version returned by the renderer."""
  version: String
}

"""
Input for creating a book within a Bible, including its chapters and reference
"""
input BookInput {
  """Standard abbreviation for the book (e.g. 'Gen', 'Matt')"""
  abbreviation: String!
  """Chapters contained in this book"""
  chapters: [ChapterInput!]!
  """Full name of the book (e.g. 'The Book of Genesis')"""
  nameLong: String!
  """Short name of the book (e.g. 'Genesis')"""
  nameShort: String!
  """USFM reference identifying this book"""
  reference: ReferenceInput!
}

"""
Input for a line break component within a scripture rendering, with optional styling
"""
input BreakInput {
  """Optional style to apply to this break"""
  style: StyleInput
}

"""Root query type for bridge administration"""
type Bridge {
  """Active bridge bindings for a chat channel"""
  bindings(channelId: UUID!): [BridgeBinding!]!
  """
  All identity mappings recorded for a particular external workspace, ordered by display name
  """
  identities(platform: BridgePlatform!, workspaceId: String!): [BridgeIdentityMapping!]!
}

"""
A binding that links a Bosca chat channel to a channel on an external messaging platform for bidirectional message synchronization
"""
type BridgeBinding {
  """Whether this binding is currently active and routing messages"""
  active: Boolean!
  """ID of the Bosca chat channel this binding mirrors"""
  channelId: UUID!
  """Timestamp when this binding was created"""
  createdAt: DateTime
  """
  External channel identifier on the target platform (e.g. a Slack channel id)
  """
  externalChannelId: String!
  """Unique identifier for this binding"""
  id: UUID!
  """External platform this binding delivers to and receives from"""
  platform: BridgePlatform!
  """
  Optional webhook URL used for outbound delivery when bot tokens are not configured
  """
  webhookUrl: String
  """External workspace identifier (e.g. Slack team id, Teams tenant id)"""
  workspaceId: String!
}

"""
A persistent mapping between an external messaging-platform user and a Bosca profile, used to attribute inbound bridged messages to the right local user instead of a placeholder sender
"""
type BridgeIdentityMapping {
  """
  Display name as known on the external platform; rendered in the admin UI when the local profile lookup fails
  """
  displayName: String!
  """Email address recorded for the external user, when available"""
  email: String
  """
  External user identifier on the target platform (e.g. a Slack user id like U01234567)
  """
  externalUserId: String!
  """Unique identifier for this mapping"""
  id: UUID!
  """External platform this mapping applies to"""
  platform: BridgePlatform!
  """
  Bosca profile this external user is mapped to, or null when the mapping has been removed but the row is being preserved for audit
  """
  profileId: UUID
  """External workspace identifier (e.g. Slack team id)"""
  workspaceId: String!
}

"""
Mutation operations for managing bridge bindings to external messaging platforms
"""
type BridgeMutation {
  """
  Create a new bridge binding linking a Bosca channel to an external platform channel
  """
  createBinding(input: CreateBridgeBindingInput!): BridgeBinding!
  """Deactivate an existing bridge binding, halting message synchronization"""
  deactivateBinding(id: UUID!): Boolean!
  """
  Delete a previously recorded identity mapping. Inbound messages from the external user will fall back to the placeholder sender until re-mapped.
  """
  deleteIdentity(id: UUID!): Boolean!
  """
  Create or update an identity mapping between an external platform user and a Bosca profile
  """
  mapIdentity(input: MapBridgeIdentityInput!): BridgeIdentityMapping!
  """
  Set or rotate the encrypted bot token for a binding. Pass an empty string or null to clear it.
  """
  setBotToken(id: UUID!, token: String): Boolean!
}

"""The external messaging platform a bridge binding targets"""
enum BridgePlatform {
  """Slack via the Web API and Events API"""
  SLACK
  """Microsoft Teams via the Bot Framework"""
  TEAMS
}

"""
A stored pipeline whose graph no longer decodes against the loaded node types — surfaced so it can be deleted.
"""
type BrokenPipeline {
  """Why the graph failed to decode."""
  error: String!
  id: UUID!
  """The pipeline's endpoint key (may be empty)."""
  key: String!
  name: String!
}

"""Per line, for every (buy + get) units, `getQuantity` are free."""
type BuyOneGetOneRule {
  buyQuantity: Int!
  getQuantity: Int!
  type: String!
}

"""
Display-time properties of a calendar that hangs off a parent Metadata
record (contentType `bosca/v-calendar`). Permissions on the calendar and its
events are inherited from the parent metadata, so visibility and edit access
fall out of the existing metadata permission model.
"""
type Calendar {
  """Hex color used to render this calendar's events."""
  color: String!
  """When this calendar row was created."""
  created: DateTime!
  """Optional description shown in the admin UI."""
  description: String!
  """
  Concrete event occurrences on this calendar that overlap the half-open
  range [from, to). Recurring masters are expanded according to RFC 5545,
  with EXDATEs and overrides applied.
  """
  events(
    """Inclusive lower bound."""
    from: DateTime!
    """Exclusive upper bound."""
    to: DateTime!
  ): [EventOccurrence!]!
  """
  The owning metadata record. The metadata's name is used as the calendar name.
  """
  metadata: Metadata!
  """
  The metadata's UUID. Convenience access without traversing into metadata.
  """
  metadataId: UUID!
  """When this calendar row was last modified."""
  modified: DateTime!
  """The metadata version this calendar is bound to."""
  version: Int!
}

"""
A stored event row. Recurring masters expose their recurrence rule via [rrule];
overrides expose their target via [originalEventId] and [recurrenceId].
"""
type CalendarEvent {
  """Whether the event spans full days."""
  allDay: Boolean!
  """Metadata and collection items linked to this event."""
  attachments: [EventAttachment!]!
  """The owning calendar."""
  calendar: Calendar!
  """When the event was created."""
  created: DateTime!
  """Long-form description; empty string when not set."""
  description: String!
  """Exclusive end of the event (template end for recurring masters)."""
  endsAt: DateTime!
  """
  ISO-8601 timestamps excluded from the master's expansion. Null/empty on non-masters.
  """
  exdates: [DateTime!]!
  """The unique identifier of the stored row."""
  id: UUID!
  """Optional location text; empty string when not set."""
  location: String!
  """When the event was last modified."""
  modified: DateTime!
  """If this row is an override of a recurring master, the master's id."""
  originalEventId: UUID
  """Principals participating in this event."""
  participants: [EventParticipant!]!
  """
  If this row is an override, the original start time of the occurrence being replaced.
  """
  recurrenceId: DateTime
  """
  Bare RRULE body (without the `RRULE:` prefix). Null on single events and overrides.
  """
  rrule: String
  """Inclusive start of the event (template start for recurring masters)."""
  startsAt: DateTime!
  """The event title."""
  title: String!
}

"""
Input for creating or updating a stored event row (single event or recurring master).
"""
input CalendarEventInput {
  """
  Whether the event spans full days; ignores the time-of-day in starts/ends.
  """
  allDay: Boolean
  """Optional long-form description."""
  description: String
  """Exclusive end (template end when [rrule] is set)."""
  endsAt: DateTime!
  """Optional location text."""
  location: String
  """The UUID of the parent metadata."""
  metadataId: UUID!
  """
  Bare RRULE body, e.g. `FREQ=WEEKLY;BYDAY=MO`. Null creates or updates a
  non-recurring event; setting it on an existing single promotes it to a
  recurring master.
  """
  rrule: String
  """Inclusive start (template start when [rrule] is set)."""
  startsAt: DateTime!
  """The event title."""
  title: String!
  """The metadata version."""
  version: Int!
}

"""Input for editing the display properties of an existing calendar."""
input CalendarInput {
  """Hex color used to render the calendar's events."""
  color: String!
  """Optional description; empty string clears it."""
  description: String
}

"""Identifies a specific calendar by its parent metadata id and version."""
input CalendarRef {
  """The UUID of the parent metadata."""
  metadataId: UUID!
  """The metadata version."""
  version: Int!
}

"""Query operations for calendars and events."""
type Calendars {
  """Every calendar whose parent metadata the caller can VIEW."""
  all: [Calendar!]!
  """Look up the calendar attached to a specific metadata version."""
  calendar(ref: CalendarRef!): Calendar
  """
  Look up a single stored event by id; null when not found or not visible to the caller.
  """
  event(id: UUID!): CalendarEvent
  """
  Aggregate occurrences across multiple calendars in a single round trip.
  Calendars whose parent metadata the caller cannot VIEW are silently skipped.
  """
  occurrences(
    """Calendars to include in the query."""
    calendars: [CalendarRef!]!
    """Inclusive lower bound."""
    from: DateTime!
    """Exclusive upper bound."""
    to: DateTime!
  ): [EventOccurrence!]!
  """
  Admin-only: scheduled and active campaigns projected as a read-only timeline.
  """
  scheduledContentEvents(from: DateTime!, to: DateTime!): [SyntheticEvent!]!
  """
  Admin-only: upcoming scheduler job executions projected as a read-only timeline.
  """
  scheduledJobEvents(from: DateTime!, to: DateTime!): [SyntheticEvent!]!
  """
  Admin-only: metadata items with deferred workflow transitions (scheduled publishes).
  """
  scheduledPublishEvents(from: DateTime!, to: DateTime!): [SyntheticEvent!]!
}

"""
Mutation operations for calendars and events. Recurring-event scope is
surfaced as distinct mutations rather than a flag, so the API is explicit
about whether you're touching one occurrence, the tail of a series, or the
whole series.
"""
type CalendarsMutation {
  """Link a metadata item or collection to a calendar event."""
  addAttachment(input: EventAttachmentInput!): EventAttachment!
  """
  Create the calendar row for an existing metadata. Idempotent. Requires EDIT.
  """
  addCalendar(calendar: CalendarInput!, ref: CalendarRef!): Calendar!
  """Create a new event. Set `event.rrule` to make it a recurring master."""
  addEvent(event: CalendarEventInput!): CalendarEvent!
  """Add or update a participant on a calendar event."""
  addParticipant(input: EventParticipantInput!): EventParticipant!
  """
  Cancel a single occurrence: deletes any override at [recurrenceId] and
  adds the time to the master's EXDATE list.
  """
  cancelOccurrence(masterId: UUID!, recurrenceId: DateTime!): Boolean!
  """Delete a stored event row. Cascades to overrides if [id] is a master."""
  deleteEvent(id: UUID!): Boolean!
  """
  Update the color or description of an existing calendar. Requires EDIT.
  """
  editCalendar(calendar: CalendarInput!, ref: CalendarRef!): Calendar!
  """
  Update a master or single event (applies to every occurrence of a master).
  """
  editEvent(event: CalendarEventInput!, id: UUID!): CalendarEvent!
  """
  Edit a single occurrence of a recurring master. Creates or updates an
  override row at [recurrenceId]; subsequent reads return the override
  instead of the master's expansion at that time.
  """
  editOccurrence(masterId: UUID!, occurrence: OccurrenceInput!, recurrenceId: DateTime!): CalendarEvent!
  """
  End a recurring series at [recurrenceId] without a successor master,
  trimming any overrides or EXDATEs in the deleted tail.
  """
  endSeriesAt(masterId: UUID!, recurrenceId: DateTime!): CalendarEvent!
  """Remove an attachment link from a calendar event."""
  removeAttachment(id: UUID!): Boolean!
  """Remove a participant from a calendar event."""
  removeParticipant(eventId: UUID!, profileId: UUID!): Boolean!
  """
  Split a recurring series at [recurrenceId]. The original master gets an
  UNTIL bound just before [recurrenceId]; a new master is created at
  [recurrenceId] using [event] for its properties (rrule defaults to the
  original if omitted). Used by 'this and following' edits.
  """
  splitSeriesAt(event: CalendarEventInput!, masterId: UUID!, recurrenceId: DateTime!): CalendarEvent!
}

"""A campaign targeted at the audience of one or more segments."""
type Campaign {
  """The delivery channel for this campaign."""
  channel: NotificationChannel!
  """Channel-specific content payload as JSON."""
  content: JSON
  """The timestamp when this campaign was created."""
  created: DateTime!
  """When the campaign should stop being active. Null means no expiration."""
  endedAt: DateTime
  """The unique identifier of the campaign."""
  id: UUID!
  """The timestamp when this campaign was last modified."""
  modified: DateTime!
  """The display name of the campaign."""
  name: String!
  """
  The UI placement slot where this banner should appear (e.g. top, hero, sidebar). Null means no specific placement.
  """
  placement: String
  """When the campaign is scheduled for delivery."""
  scheduledAt: DateTime
  """The segments whose audiences receive this campaign."""
  segments: [Segment!]!
  """When the campaign was sent."""
  sentAt: DateTime
  """The number of profiles the campaign was delivered to."""
  sentCount: Long!
  """The lifecycle status of the campaign."""
  status: NotificationStatus!
  """
  Relative probability weight for random selection. Weights of 10, 10, and 80 yield selection probabilities of 10%, 10%, and 80%.
  """
  weight: Int!
}

"""Input for creating or updating a campaign."""
input CampaignInput {
  """The delivery channel for this campaign."""
  channel: NotificationChannel!
  """
  Channel-specific content payload as JSON (e.g., email subject/body, banner text, push title/body).
  """
  content: JSON
  """When the campaign should stop being active. Null means no expiration."""
  endedAt: DateTime
  """The display name of the campaign."""
  name: String!
  """
  The UI placement slot where this banner should appear (e.g. top, hero, sidebar).
  """
  placement: String
  """When the campaign should be delivered. Null for immediate delivery."""
  scheduledAt: DateTime
  """
  The UUIDs of the segments whose audiences should receive this campaign.
  """
  segmentIds: [UUID!]!
  """
  Relative probability weight for random selection. Weights of 10, 10, and 80 yield selection probabilities of 10%, 10%, and 80%. Defaults to 0.
  """
  weight: Int
}

"""Query operations for retrieving campaigns."""
type Campaigns {
  """
  Select a single active banner for a specific placement using weighted random selection. Returns banners matching segment membership or EVERYONE segments when profileId is provided; returns only EVERYONE-targeted banners when profileId is omitted.
  """
  activeBanner(
    """The placement slot to filter by (e.g. top, hero, sidebar)."""
    placement: String!
    """The UUID of the profile. Omit for anonymous users."""
    profileId: UUID
  ): Campaign
  """
  Retrieve the IDs and weights of all active banners for a specific placement. Clients can cache this list per placement/profile and perform weighted random selection client-side, then fetch full campaign details via the campaign query.
  """
  activeBannerWeights(
    """The placement slot to filter by (e.g. top, hero, sidebar)."""
    placement: String!
    """The UUID of the profile. Omit for anonymous users."""
    profileId: UUID
  ): [BannerWeight!]!
  """
  Retrieve active banner campaigns targeting a specific profile or, when profileId is omitted, only banners targeting EVERYONE segments. Optionally filter by placement.
  """
  activeBanners(
    """
    The placement slot to filter by. Omit to return banners for all placements.
    """
    placement: String
    """
    The UUID of the profile to check for active banners. Omit for anonymous users.
    """
    profileId: UUID
  ): [Campaign!]!
  """Retrieve a paginated list of all campaigns."""
  all(
    """The maximum number of campaigns to return."""
    limit: Int!
    """The zero-based offset for pagination."""
    offset: Long!
  ): [Campaign!]!
  """Retrieve a single campaign by its identifier."""
  campaign(
    """The UUID of the campaign to retrieve."""
    id: UUID!
  ): Campaign
}

"""Mutation operations for managing campaigns."""
type CampaignsMutation {
  """Create a new campaign linked to segments."""
  add(
    """The campaign specification."""
    campaign: CampaignInput!
  ): Campaign!
  """Cancel a scheduled or active campaign, preventing further delivery."""
  cancel(
    """The UUID of the campaign to cancel."""
    id: UUID!
  ): Campaign!
  """Delete a campaign."""
  delete(
    """The UUID of the campaign to delete."""
    id: UUID!
  ): Boolean!
  """Update an existing draft campaign."""
  edit(
    """The updated campaign specification."""
    campaign: CampaignInput!
    """The UUID of the campaign to update."""
    id: UUID!
  ): Campaign!
  """
  Reactivate a cancelled banner campaign, returning it to active display.
  """
  reactivate(
    """The UUID of the campaign to reactivate."""
    id: UUID!
  ): Campaign!
  """Dispatch a campaign to its segment audience."""
  send(
    """The UUID of the campaign to send."""
    id: UUID!
  ): Campaign!
  """
  Send a test delivery of this campaign to the members of a specific segment without changing the campaign status.
  """
  sendTest(
    """The UUID of the campaign to test."""
    id: UUID!
    """The UUID of the segment whose members will receive the test delivery."""
    segmentId: UUID!
  ): Boolean!
}

"""
A shopping cart: the selling document carts/payments/subscriptions hang off. Loaded and saved as a
single row; totals are denormalized and recomputed on every change.
"""
type Cart {
  account: Account
  """Billing/shipping addresses set on the cart."""
  addresses: [CartAddress!]!
  """
  Whether billing mirrors the shipping address (no separate billing address is kept when true).
  """
  billingSameAsShipping: Boolean!
  company: Company!
  created: DateTime!
  """ISO-4217 currency of this cart's amounts (the store's currency)."""
  currency: String!
  customer: Customer
  discounts: Money!
  """Amount still owed (salesTotal − paid − pending; never below zero)."""
  due: Money!
  """When the cart is reclaimed by the expiration sweep if left OPEN."""
  expires: DateTime!
  id: UUID!
  items: [CartItem!]!
  modified: DateTime!
  paid: Money!
  """
  Payments recorded against the cart (charges, refunds, voids), oldest first.
  """
  payments(limit: Int! = 50, offset: Int! = 0): [Payment!]!
  """Amount paid but not yet confirmed (e.g. a check awaiting clearing)."""
  pendingPaid: Money!
  """Total unit count across lines."""
  quantity: Int!
  """
  Amount owed back to the buyer when payments exceed the (reduced) sales total.
  """
  refundDue: Money!
  retailSubtotal: Money!
  retailTotal: Money!
  salesSubtotal: Money!
  salesTotal: Money!
  shipping: Money!
  """Lifecycle flags currently set on the cart."""
  status: [CartStatusFlag!]!
  store: Store!
  tax: Money!
}

"""A billing or shipping address on a cart (one per type)."""
type CartAddress {
  address1: String!
  address2: String
  city: String!
  country: String!
  email: String
  firstName: String!
  id: UUID!
  lastName: String!
  note: String
  phone: String!
  state: String!
  type: AddressType!
  """Whether a provider confirmed the address."""
  validated: Boolean!
  zip: String!
}

"""
Opens a cart in a store. The buyer is identified by account and/or customer (both optional).
"""
input CartInput {
  accountId: UUID = null
  customerId: UUID = null
  storeId: UUID!
}

"""One line in a cart."""
type CartItem {
  """Catalog price snapshotted at add-time."""
  baseRetailPrice: Money!
  catalogProduct: CatalogProduct!
  """Line-type-specific configuration (e.g. a chosen subscription plan)."""
  configuration: CartItemConfiguration!
  discounts: Money!
  expires: DateTime
  id: UUID!
  paid: Money!
  """
  Parent line id for a dependent line (e.g. a shipping line tied to a product).
  """
  parentId: UUID
  quantity: Int!
  retailPrice: Money!
  retailSubtotal: Money!
  """Price after discounts (refined by the pricing pipeline)."""
  salesPrice: Money!
  salesSubtotal: Money!
  status: [CartStatusFlag!]!
  taxes: Tax!
  type: ProductType!
}

"""Line-type-specific configuration on a cart line."""
union CartItemConfiguration = EmptyCartItemConfiguration | ShippingCartConfiguration | SizeCartItemConfiguration | SubscriptionCartItemConfiguration

"""Operations on one cart. Owner or ecom administrator only."""
type CartMutation {
  """Add a line; reserves inventory if the product is stocked."""
  addItem(input: AddCartItemInput!): Cart!
  """
  Apply a promotion code to the cart (requires the cart to have an account).
  """
  applyCode(code: String!): Cart!
  """
  Mark an order cancelled (a status override; refund money separately). Ecom administrator only.
  """
  cancel: Cart!
  """
  Mark a paid order complete (admin override that finalizes fulfillment). Ecom administrator only.
  """
  complete: Cart!
  """
  Confirm a CHECK payment has cleared: settles it from pending into paid. Ecom administrator only.
  """
  confirmCheck(checkNumber: String, paymentId: UUID!): Cart!
  """
  Refund one or more (partial) line items on a paid order to a tender: reduces/removes each line,
  restocks inventory, and refunds the resulting amount against the cart's payments. Ecom
  administrator only.
  """
  refundItems(checkNumber: String, items: [RefundItemInput!]!, reason: String, tender: RefundTender! = ORIGINAL): Cart!
  """Remove the cart's address of the given type."""
  removeAddress(type: AddressType!): Cart!
  """Remove a previously-applied promotion code from the cart."""
  removeCode(code: String!): Cart!
  """Remove a line, releasing its inventory holds."""
  removeItem(itemId: UUID!): Cart!
  """Set (upsert) the cart's billing or shipping address."""
  setAddress(input: SetCartAddressInput!): CartAddress!
  """
  Set whether billing mirrors shipping (drops a separate billing address when true).
  """
  setBillingSameAsShipping(value: Boolean!): Cart!
  """
  Override a line's unit retail/sales price (post-sale correction). Ecom administrator only.
  """
  setItemPrice(itemId: UUID!, retailPrice: Money!, salesPrice: Money!): Cart!
  """
  Lock or unlock the cart against further edits. Ecom administrator only.
  """
  setLocked(locked: Boolean!): Cart!
  """
  Select a quoted shipping rate (by its token) and set it as the cart's shipping line.
  """
  setShipping(token: String!): Cart!
  """
  Submit the cart for checkout: commit holds, optionally take payment, and advance the lifecycle.
  """
  submit(payment: SubmitPaymentInput): CartSubmitResult!
  """Change a line's quantity, re-reserving inventory to match."""
  updateItem(itemId: UUID!, quantity: Int!): Cart!
}

"""A cart lifecycle flag; a cart/line holds a set of these at once."""
enum CartStatusFlag {
  CANCELLED
  COMPLETE
  EXPIRED
  LOCKED
  OPEN
  PAID
  PAYMENT_DUE
  PAYMENT_FAILED
  PAYMENT_PENDING
  PENDING
  PREPARING
  REFUNDED
  REFUND_DUE
  REFUND_FAILED
  REFUND_PENDING
  RETURNED
  RETURNING
  SHIPPED
  SHIPPING
  VOID_FAILED
}

"""The outcome of submitting a cart, including any subscriptions created."""
type CartSubmitResult {
  cart: Cart!
  """Payments taken at checkout (empty when paying later)."""
  payments: [Payment!]!
  """Subscriptions created from SUBSCRIPTION lines."""
  subscriptions: [EcomSubscription!]!
}

"""Cart creation and the per-cart accessor."""
type CartsMutation {
  """Operations on an existing cart."""
  cart(id: UUID!): CartMutation!
  """Open a cart in a store."""
  create(input: CartInput!): Cart!
}

"""
A priceable grouping of products. A store sells exactly one catalog; the same product can appear in
many catalogs at different prices via CatalogProduct.
"""
type Catalog {
  company: Company!
  created: DateTime!
  """
  ISO-4217 currency this catalog (price book) is priced in; stores selling it inherit it.
  """
  currency: String!
  id: UUID!
  """Business key, unique per company."""
  key: String!
  modified: DateTime!
  name: String!
  """The catalog's sellable entries (same filters as Ecom.catalogProducts)."""
  products(activeOnly: Boolean! = true, limit: Int! = 25, offset: Int! = 0, type: ProductType = null): [CatalogProduct!]!
}

"""Creates or edits a catalog."""
input CatalogInput {
  companyId: UUID!
  """ISO-4217 currency this catalog is priced in. Defaults to USD."""
  currency: String! = "USD"
  """Business key, unique per company."""
  key: String!
  name: String!
}

"""Mutations scoped to one catalog. Admin."""
type CatalogMutation {
  """Edit the catalog's key/name."""
  edit(input: CatalogInput!): Catalog!
}

"""
A sellable entry: a product placed in a catalog at a price, within an availability window. This is
what carts reference and what storefronts list.
"""
type CatalogProduct {
  catalog: Catalog!
  """End of the availability window."""
  ends: DateTime!
  """
  Polymorphic extension data (sealed CatalogProductExtras, e.g. quantity limits).
  """
  extras: CatalogProductExtras!
  id: UUID!
  """
  The product's backing content document, at the product's pinned version (convenience for product { metadata }).
  """
  metadata: Metadata!
  """
  The retail price for this catalog (for SUBSCRIPTION entries: the signup/first-period charge). Changes are audited; carts snapshot it at add-time.
  """
  price: Money!
  product: Product!
  """Promotion codes pre-associated with this entry."""
  promotions: [String!]!
  """Start of the availability window."""
  starts: DateTime!
  taxable: Boolean!
  type: ProductType!
}

"""Per-catalog-entry extension data."""
union CatalogProductExtras = EmptyCatalogProductExtras | QuantityRequirements

"""Places a product in a catalog as a sellable entry, or edits one."""
input CatalogProductInput {
  catalogId: UUID!
  """Availability window end; defaults to the module's far-future default."""
  ends: DateTime = null
  extras: JSON = null
  """
  The retail price (for SUBSCRIPTION entries: the signup/first-period charge).
  """
  price: Money!
  productId: UUID!
  """Availability window start; defaults to now."""
  starts: DateTime = null
  taxable: Boolean! = true
}

"""Mutations scoped to one catalog entry. Admin."""
type CatalogProductMutation {
  """Soft-delete the catalog entry."""
  delete: Boolean!
  """
  Edit price, availability window, taxable/weight, or extras. Price changes are audited.
  """
  edit(input: CatalogProductInput!): CatalogProduct!
}

"""Catalog-entry creates and per-entry operations. Admin."""
type CatalogProductsMutation {
  """Place a product in a catalog as a sellable, priced entry."""
  add(input: CatalogProductInput!): CatalogProduct!
  """Operations on an existing catalog entry."""
  catalogProduct(id: UUID!): CatalogProductMutation!
}

"""Catalog creates and per-catalog operations. Admin."""
type CatalogsMutation {
  """Create a catalog (a priceable grouping of products) in a company."""
  add(input: CatalogInput!): Catalog!
  """Operations on an existing catalog."""
  catalog(id: UUID!): CatalogMutation!
}

"""Query operations for browsing content categories"""
type Categories {
  """List all available categories"""
  all: [Category!]!
}

"""A category for organizing and classifying content items"""
type Category {
  """Unique identifier for this category"""
  id: UUID!
  """Display name of the category"""
  name: String!
}

"""Input for creating or updating a category"""
input CategoryInput {
  """Display name for the category"""
  name: String!
}

"""Mutation operations for managing content categories"""
type CategoryMutation {
  """Create a new category"""
  add(category: CategoryInput!): Category!
  """Delete a category by ID"""
  delete(id: UUID!): Boolean!
  """Update an existing category"""
  edit(category: CategoryInput!, id: UUID!): Category!
}

"""Input for creating a chapter within a Bible book"""
input ChapterInput {
  """JSON component tree representing the rendered chapter content"""
  component: JSON!
  """USFM reference identifying this chapter"""
  reference: ReferenceInput!
}

"""Root query type for chat features"""
type Chat {
  """Retrieve a single chat channel by its unique identifier"""
  channel(id: UUID!): ChatChannel
  """Retrieve the chat channel scoped to a specific domain object"""
  objectChannel(objectId: UUID!, objectType: ChatObjectType!): ChatChannel
}

"""
A chat channel for real-time messaging, supporting direct messages, group conversations, and public discussions
"""
type ChatChannel {
  """Custom attributes associated with this channel as a JSON object"""
  attributes: JSON
  """
  The parent community group this channel belongs to, null for standalone channels
  """
  group: CommunityGroup
  """Unique identifier for this chat channel"""
  id: UUID!
  """List of all members in this chat channel"""
  members: [ChatChannelMember!]!
  """
  Paginated list of messages in this channel, filterable by sequence number range
  """
  messages(after: Long, before: Long, limit: Int): [ChatMessage!]!
  """Display name of the chat channel"""
  name: String!
  """The unique identifier of the domain object this channel is scoped to"""
  objectId: UUID
  """
  The type of domain object this channel is scoped to, null for standalone channels
  """
  objectType: ChatObjectType
  """The type of this channel (direct, group, or public)"""
  type: ChatChannelType!
}

"""
A durable invitation from one profile for another profile to join a chat channel
"""
type ChatChannelInvitation {
  """The channel the recipient is invited to join"""
  channel: ChatChannel
  """When the invitation was created"""
  created: DateTime!
  """Unique identifier for the invitation"""
  id: UUID!
  """The profile that received the invitation"""
  invitee: Profile!
  """The profile that sent the invitation"""
  inviter: Profile!
  """When the invitation was last changed"""
  modified: DateTime!
  """The role assigned when the invitation is accepted"""
  role: String!
  """Current invitation lifecycle state"""
  status: ChatChannelInvitationStatus!
}

"""Lifecycle state of an invitation to join a chat channel"""
enum ChatChannelInvitationStatus {
  ACCEPTED
  CANCELLED
  DECLINED
  PENDING
}

"""
A membership record linking a user profile to a chat channel, including their role and read-tracking state
"""
type ChatChannelMember {
  """
  Custom attributes associated with this channel membership as a JSON object
  """
  attributes: JSON
  """ID of the chat channel this membership belongs to"""
  channelId: UUID!
  """
  Sequence number of the last message read by this member, null if never read. Sourced from the chat-read-state NATS KV bucket — not the membership row — so unread badges update at NATS speed.
  """
  lastReadSequence: Long
  """The full user profile of the member"""
  profile: Profile!
  """ID of the member's user profile"""
  profileId: UUID!
  """
  The member's role within this channel (e.g. 'admin', 'member', 'moderator')
  """
  role: String!
}

"""
The type of chat channel, defining its participant model and visibility
"""
enum ChatChannelType {
  """A private one-on-one conversation between two users"""
  DIRECT
  """A group conversation visible only to its members"""
  GROUP
  """A channel open to all eligible members"""
  PUBLIC
}

"""A single message within a chat session's conversation history"""
type ChatHistoryMessage {
  """
  The author of this message — typically 'user' for human messages or the agent key for AI responses
  """
  author: String!
  """Timestamp when this message was created"""
  created: DateTime!
  """
  The message content as a JSON event object, containing the message text, role, and any structured data or tool calls
  """
  event: JSON
  """Unique identifier for this message"""
  id: UUID!
  """The unique identifier of the chat session this message belongs to"""
  sessionId: UUID!
}

"""
A single chat message within a channel, containing one or more content blocks, optional threading, and reactions
"""
type ChatMessage {
  """Custom attributes associated with this message as a JSON object"""
  attributes: JSON
  """
  Client-generated UUID for deduplication of messages sent from the same device
  """
  clientId: UUID
  """The content blocks that make up this message (text, media, references)"""
  content: [MessageContent!]!
  """
  Whether this event is a tombstone for a message that was permanently deleted
  """
  deleted: Boolean!
  """
  Sequence number of the parent message if this is a threaded reply, null for top-level messages
  """
  parentSequence: Long
  """List of emoji reactions on this message"""
  reactions: [MessageReaction!]!
  """The full user profile of the message sender"""
  sender: Profile
  """ID of the user profile that sent this message"""
  senderId: UUID!
  """
  The monotonically increasing sequence number of this message within its channel, used for ordering and pagination
  """
  sequence: Long!
  """Timestamp when this message was sent"""
  timestamp: DateTime!
}

"""
A real-time event payload delivered when a new message is sent or updated in a chat channel
"""
type ChatMessageEvent {
  """ID of the chat channel where the message event occurred"""
  channelId: UUID!
  """The chat message that was sent or updated"""
  message: ChatMessage!
}

"""A complete chat message sent by a user to the AI agent"""
input ChatMessageInput {
  """The ordered list of content parts that make up this message"""
  parts: [ChatMessagePartInput!]!
  """The role of the message author (e.g., 'user', 'assistant')"""
  role: String!
}

"""
A single part of a chat message, representing one content block (e.g., a text segment)
"""
input ChatMessagePartInput {
  """The text content of this message part"""
  text: String!
  """The content type of this message part (e.g., 'text')"""
  type: String!
}

"""Mutation operations for managing chat channels and messages"""
type ChatMutation {
  """Accept a pending channel invitation and join its channel"""
  acceptChannelInvitation(invitationId: UUID!): ChatChannelInvitation!
  """
  Add an emoji reaction from the authenticated profile to a message identified by channel + sequence. No-op if already present.
  """
  addReaction(channelId: UUID!, emoji: String!, sequence: Long!): Boolean!
  """Cancel an invitation previously sent by a profile"""
  cancelChannelInvitation(invitationId: UUID!): ChatChannelInvitation!
  """Create a new standalone chat channel"""
  createChannel(attributes: JSON, name: String!, type: ChatChannelType!): ChatChannel!
  """Decline a pending channel invitation"""
  declineChannelInvitation(invitationId: UUID!): ChatChannelInvitation!
  """Permanently delete a message sent by the authenticated profile"""
  deleteMessage(channelId: UUID!, sequence: Long!): Boolean!
  """Create or retrieve a direct message channel with another profile"""
  initiateDM(profileId: UUID!): ChatChannel!
  """Invite a profile to join a channel"""
  inviteToChannel(channelId: UUID!, inviteeProfileId: UUID!): ChatChannelInvitation!
  """Leave a chat channel"""
  leaveChannel(channelId: UUID!): Boolean!
  """Create or retrieve a chat channel scoped to a domain object"""
  objectChannel(name: String!, objectId: UUID!, objectType: ChatObjectType!): ChatChannel!
  """Remove another member from a channel as a channel administrator"""
  removeChannelMember(channelId: UUID!, profileId: UUID!): Boolean!
  """
  Remove the authenticated profile's emoji reaction from a message identified by channel + sequence.
  """
  removeReaction(channelId: UUID!, emoji: String!, sequence: Long!): Boolean!
  """
  Send a message to a chat channel with one or more content blocks. Set parentSequence to reply within an existing thread.
  """
  sendMessage(attributes: JSON, channelId: UUID!, clientId: UUID!, content: [MessageContentInput!]!, parentSequence: Long): Boolean!
  """Broadcast a typing indicator event to other members of a chat channel"""
  sendTyping(channelId: UUID!, isTyping: Boolean!): Boolean!
  """Change an existing channel member's role to admin or member"""
  setChannelMemberRole(channelId: UUID!, profileId: UUID!, role: String!): Boolean!
  """Update the last-read sequence number for a user in a chat channel"""
  updateLastRead(channelId: UUID!, sequence: Long!): Boolean!
}

"""The type of domain object a chat channel can be scoped to"""
enum ChatObjectType {
  """A calendar event"""
  CALENDAR_EVENT
  """A content collection"""
  COLLECTION
  """An experiment configuration"""
  EXPERIMENT
  """A feature flag"""
  FEATURE_FLAG
  """A localization string or document key"""
  LOCALIZATION_KEY
  """A content metadata item"""
  METADATA
}

"""
A chat session representing a conversation between a user and an AI agent, containing the full message history
"""
type ChatSession {
  """The key identifying which AI agent is used for this chat session"""
  agentKey: String!
  """Metadata Attachments for this chat session"""
  attachments: [UUID!]!
  """Collection Attachments for this chat session"""
  collectionAttachments: [UUID!]!
  """Timestamp when this chat session was created"""
  created: DateTime!
  """Unique identifier for this chat session"""
  id: UUID!
  """
  The ordered list of messages in this chat session, representing the full conversation history
  """
  messages: [ChatHistoryMessage!]!
  """
  Timestamp when this chat session was last modified (e.g., new message added or title changed)
  """
  modified: DateTime!
  """The parent chat session when this session represents a nested thread"""
  parentSessionId: UUID
  """
  The unique identifier of the user (principal) who owns this chat session
  """
  principalId: UUID!
  """
  Whether the dispatcher is actively working on this session (encompasses the entire lifecycle from request receipt through streaming to completion)
  """
  processing: Boolean!
  """The current processing status of this chat session"""
  status: ChatSessionStatus!
  """The display title for this chat session, shown in session listings"""
  title: String!
}

"""Input for creating a new chat session"""
input ChatSessionInput {
  """
  The key identifying which AI agent should be used for this chat session
  """
  agentKey: String!
  """
  Optional display title for the chat session. If not provided, a default title may be generated.
  """
  title: String
}

"""The current processing status of a chat session"""
enum ChatSessionStatus {
  """The AI agent has finished generating a response"""
  COMPLETED
  """The AI agent encountered an error while generating a response"""
  FAILED
  """The AI agent is actively generating a response"""
  STREAMING
}

"""
Query operations for listing and retrieving chat sessions belonging to the authenticated user
"""
type ChatSessions {
  """Count of active chat sessions for all users"""
  active: Int!
  """Retrieve all chat sessions for the authenticated user"""
  all: [ChatSession!]!
  """Retrieve a specific chat session by its unique ID"""
  session(
    """The unique identifier of the chat session to retrieve"""
    id: UUID!
  ): ChatSession
}

"""Mutation operations for managing chat sessions"""
type ChatSessionsMutation {
  """
  Attach a metadata item to a chat session, making it available as context for the AI agent
  """
  addAttachment(
    """The unique identifier of the chat session"""
    id: UUID!
    """The unique identifier of the metadata item to attach"""
    metadataId: UUID!
  ): ChatSession!
  """
  Attach a collection to a chat session, making its contents available as context for the AI agent
  """
  addCollectionAttachment(
    """The unique identifier of the collection to attach"""
    collectionId: UUID!
    """The unique identifier of the chat session"""
    id: UUID!
  ): ChatSession!
  """Create a new chat session with a specified AI agent"""
  create(
    """The chat session definition to create"""
    session: ChatSessionInput!
  ): ChatSession!
  """
  Delete a chat session and all its messages. Returns true if the session was deleted.
  """
  delete(
    """The unique identifier of the chat session to delete"""
    id: UUID!
  ): Boolean!
  """Remove a metadata attachment from a chat session"""
  removeAttachment(
    """The unique identifier of the chat session"""
    id: UUID!
    """The unique identifier of the metadata item to detach"""
    metadataId: UUID!
  ): ChatSession!
  """Remove a collection attachment from a chat session"""
  removeCollectionAttachment(
    """The unique identifier of the collection to detach"""
    collectionId: UUID!
    """The unique identifier of the chat session"""
    id: UUID!
  ): ChatSession!
  """
  Send a message to the AI agent in a chat session and begin generating a response
  """
  send(
    """The message to send to the AI agent"""
    message: ChatMessageInput!
    """The unique identifier of the chat session to send the message to"""
    sessionId: UUID!
  ): Boolean
  """Update the display title of an existing chat session"""
  updateTitle(
    """The unique identifier of the chat session to update"""
    id: UUID!
    """The new title for the chat session"""
    title: String!
  ): ChatSession!
}

input CloseWorkOpsSprintInput {
  destinations: [WorkOpsCloseSprintDestination!]! = []
  expectedVersion: Long!
  sprintId: UUID!
  velocityPoints: Float
}

"""A product offered in a set of sizes."""
type ClothingProductConfiguration {
  sizes: [String!]!
  type: String!
}

"""
Root query type for the collaboration namespace, grouping bridge and federation administration so they don't clutter the top-level Query.
"""
type Collaboration {
  """Access bridge administration queries (bindings, identity mappings)"""
  bridge: Bridge!
  """Access federation administration queries (peers, channel links)"""
  federation: Federation!
}

"""
Root mutation type for the collaboration namespace, mirroring [Collaboration] for write operations.
"""
type CollaborationMutation {
  """Access bridge administration mutations"""
  bridge: BridgeMutation!
  """Access federation administration mutations"""
  federation: FederationMutation!
}

"""
Controls how the collaboration CRDT row is synchronized when document content is set programmatically
"""
enum CollaborationSyncMode {
  """Merge the new document content into the existing CRDT state"""
  MERGE
  """No collaboration sync — the CRDT row is left unchanged"""
  NONE
  """Reset the CRDT row to match the new document content"""
  RESET
}

"""
A collection is a hierarchical container for organizing metadata items, other collections, and supplementary content
"""
type Collection {
  """Custom attributes on this collection, optionally filtered"""
  attributes(filter: AttributesFilterInput): JSON
  """Categories assigned to this collection"""
  categories: [Category!]!
  """Paginated list of child collections"""
  collections(languageTag: String, limit: Int!, offset: Long!, state: String): [Collection!]!
  """Count of child collections"""
  collectionsCount(languageTag: String, state: String): Int!
  """Timestamp when this collection was created"""
  created: DateTime!
  """Whether this collection has been soft-deleted"""
  deleted: Boolean!
  """Description of the collection"""
  description: String
  """
  Entity tag for cache validation. Set addHeader to true to include as HTTP response header.
  """
  etag(addHeader: Boolean!): String
  """
  Paginated list of all metadata items within this collection and its sub-collections
  """
  expandedMetadata(languageTag: String, limit: Int!, offset: Long!, state: String): [Metadata!]!
  """
  Count of all metadata items within this collection and its sub-collections
  """
  expandedMetadataCount(languageTag: String, state: String): Int!
  """Unique identifier for this collection"""
  id: UUID!
  """Attributes set on child items within this collection"""
  itemAttributes: JSON
  """
  Paginated list of all child items (both collections and metadata). A language resolution context matches mapped metadata source tags to languageTag.
  """
  items(contentTypes: [String!], languageResolutionContext: String, languageTag: String, limit: Int!, offset: Long!, state: String): [CollectionItem!]!
  """
  Count of all child items. A language resolution context matches mapped metadata source tags to languageTag.
  """
  itemsCount(contentTypes: [String!], languageResolutionContext: String, languageTag: String, state: String): Int!
  """Whether child items are locked from modification"""
  itemsLocked: Boolean!
  """Freeform labels for tagging"""
  labels: [String!]!
  """Primary BCP 47 language tag for this collection"""
  languageTag: String!
  """Get a specific language variant of this collection"""
  languageVariant(languageTag: String): CollectionLanguageVariant
  """List of language tags for available language variants"""
  languageVariants: [String!]
  """Whether this collection is locked from modification"""
  locked: Boolean!
  """Paginated list of direct child metadata items"""
  metadata(contentTypes: [String!], languageTag: String, limit: Int!, offset: Long!, state: String): [Metadata!]!
  """Count of direct child metadata items"""
  metadataCount(contentTypes: [String!], languageTag: String, state: String): Int!
  """
  Metadata relationships associated with this collection (e.g. thumbnail, banner)
  """
  metadataRelationships: [CollectionMetadataRelationship!]!
  """Timestamp when this collection was last modified"""
  modified: DateTime!
  """Display name of the collection"""
  name: String!
  """Sort ordering configuration for child items"""
  ordering: [Ordering!]
  """Paginated list of parent collections that contain this collection"""
  parentCollections(languageTag: String, limit: Int!, offset: Long!): [Collection!]!
  """Access permissions defined on this collection"""
  permissions: [Permission!]!
  """Whether this collection is publicly accessible"""
  public: Boolean!
  """Whether the child item list is publicly visible"""
  publicList: Boolean!
  """Whether supplementary files are publicly accessible"""
  publicSupplementary: Boolean!
  """Timestamp when this collection became ready, null if not yet ready"""
  ready: DateTime
  """Whether this collection may be returned as a recommendation"""
  recommendable: Boolean!
  """Whether this collection is indexed for search"""
  searchable: Boolean!
  """URL-friendly slug for this collection"""
  slug: String
  """
  Supplementary content attached to this collection (files, assets, etc.)
  """
  supplementary(key: String, planId: UUID): [CollectionSupplementary!]!
  """System-managed attributes (not user-editable)"""
  systemAttributes: JSON
  """
  The template metadata item that defines the structure of this collection
  """
  templateMetadata: Metadata
  """IDs of traits assigned to this collection"""
  traitIds: [String!]!
  """Traits assigned to this collection"""
  traits: [Trait!]!
  """The organizational type of this collection"""
  type: CollectionType!
  """Current workflow state information"""
  workflow: CollectionWorkflow!
}

"""Input for creating a child collection within a parent"""
input CollectionChildInput {
  """Attributes to set on the parent-child relationship"""
  attributes: JSON
  """The child collection to create"""
  collection: CollectionInput!
}

"""
A real-time event emitted when a collection is created, updated, or deleted.
"""
type CollectionEvent {
  """The UUID of the collection that was affected."""
  id: UUID!
  """The language variant affected by the event, when applicable."""
  languageTag: String
  """
  The type of event that occurred (e.g. 'created', 'updated', 'deleted').
  """
  type: String
}

"""Input for creating or updating a collection"""
input CollectionInput {
  """Custom attributes for the collection"""
  attributes: JSON
  """IDs of categories to assign to the collection"""
  categoryIds: [String!]
  """The organizational type of the collection"""
  collectionType: CollectionType
  """Child collections to create inline"""
  collections: [CollectionChildInput!]
  """Description of the collection"""
  description: String
  """Whether child items are locked from modification"""
  itemsLocked: Boolean
  """Freeform labels for tagging the collection"""
  labels: [String!]
  """Whether the collection itself is locked from modification"""
  locked: Boolean
  """Child metadata items to create inline"""
  metadata: [MetadataChildInput!]
  """Display name of the collection"""
  name: String!
  """Sort ordering for child items"""
  ordering: [OrderingInput!]
  """ID of the parent collection to place this under"""
  parentCollectionId: String
  """Whether this collection may be returned as a recommendation"""
  recommendable: Boolean
  """Whether this collection should be indexed for search"""
  searchable: Boolean
  """URL-friendly slug"""
  slug: String
  """Initial workflow state configuration"""
  state: CollectionWorkflowInput
  """ID of a metadata item serving as a template for this collection"""
  templateMetadataId: UUID
  """Version of the template metadata"""
  templateMetadataVersion: Int
  """IDs of traits to assign to this collection"""
  traitIds: [String!]
}

"""
A union of collection and metadata items, representing any child item within a collection
"""
union CollectionItem = Collection | Metadata

"""
A language-specific variant of a collection, containing localized content and settings
"""
type CollectionLanguageVariant {
  """Custom attributes for this language variant"""
  attributes: JSON
  """Localized description of the collection"""
  description: String
  """BCP 47 language tag (e.g. 'en', 'es-MX')"""
  languageTag: String!
  """Metadata relationships specific to this language variant"""
  metadataRelationships: [CollectionLanguageVariantMetadataRelationship!]!
  """Localized name of the collection"""
  name: String!
  """Whether this variant is publicly accessible"""
  public: Boolean!
  """Whether the list of child items in this variant is publicly visible"""
  publicList: Boolean!
  """Whether supplementary files in this variant are publicly accessible"""
  publicSupplementary: Boolean!
  """Timestamp when this variant became ready, null if not yet ready"""
  ready: DateTime
  """
  Whether this variant may be returned in recommendations for its language
  """
  recommendable: Boolean!
  """Whether this variant should be indexed for search"""
  searchable: Boolean!
  """URL-friendly slug for this variant"""
  slug: String
  """Current workflow state of this variant"""
  workflow: CollectionWorkflow!
}

"""Input for creating or updating a language variant of a collection"""
input CollectionLanguageVariantInput {
  """Custom attributes for this variant"""
  attributes: JSON
  """Localized description"""
  description: String
  """The collection ID this variant belongs to"""
  id: UUID!
  """BCP 47 language tag for the variant"""
  languageTag: String!
  """Localized name of the collection"""
  name: String!
  """Whether this variant is publicly accessible"""
  public: Boolean
  """Whether the list of child items is publicly visible"""
  publicList: Boolean
  """Whether supplementary files are publicly accessible"""
  publicSupplementary: Boolean
  """
  Whether this variant may be returned in recommendations for its language
  """
  recommendable: Boolean
  """Whether this variant should be indexed for search"""
  searchable: Boolean
}

"""
A metadata relationship within a specific language variant of a collection
"""
type CollectionLanguageVariantMetadataRelationship {
  """Custom attributes on this relationship"""
  attributes: JSON
  """The language tag this relationship belongs to"""
  languageTag: String
  """The related metadata item"""
  metadata: Metadata!
  """The type of relationship (e.g. 'thumbnail', 'banner')"""
  relationship: String
}

"""A relationship between a collection and a metadata item"""
type CollectionMetadataRelationship {
  """Custom attributes on this relationship"""
  attributes: JSON
  """The related metadata item"""
  metadata: Metadata!
  """The type of relationship (e.g. 'thumbnail', 'banner')"""
  relationship: String
}

"""Input for managing metadata relationships on a collection"""
input CollectionMetadataRelationshipInput {
  """Custom attributes on this relationship"""
  attributes: JSON
  """The collection ID"""
  id: UUID!
  """BCP 47 language tag for language-specific relationships"""
  languageTag: String
  """The related metadata item ID"""
  metadataId: UUID!
  """The type of relationship (e.g. 'thumbnail', 'banner')"""
  relationship: String
}

"""Mutation operations for managing collections and their contents"""
type CollectionMutation {
  """Create a new collection"""
  add(collection: CollectionInput!, collectionItemAttributes: JSON, setReady: Boolean): Collection!
  """Add an existing collection as a child of another collection"""
  addChildCollection(attributes: JSON, collectionId: UUID!, id: UUID!): Collection!
  """Add an existing metadata item as a child of a collection"""
  addChildMetadata(attributes: JSON, id: UUID!, metadataId: UUID!): Collection!
  """Add a new language variant to an existing collection"""
  addLanguageVariant(setReady: Boolean, variant: CollectionLanguageVariantInput): Collection!
  """Create a metadata relationship on a collection"""
  addMetadataRelationship(relationship: CollectionMetadataRelationshipInput!): ContentRelationship!
  """Add an access permission to a collection"""
  addPermission(permission: PermissionInput!): Permission!
  """Add supplementary content to a collection"""
  addSupplementary(supplementary: CollectionSupplementaryInput!): CollectionSupplementary!
  """
  Soft-delete a collection. Set recursive to true to delete all children.
  """
  delete(id: UUID!, recursive: Boolean): Boolean!
  """
  Soft-delete multiple collections in a single operation, skipping items the caller lacks permission to delete
  """
  deleteAll(collectionIds: [UUID!]!): Int!
  """Remove a language variant from a collection"""
  deleteLanguageVariant(id: UUID!, languageTag: String!): Collection!
  """Remove a metadata relationship from a collection"""
  deleteMetadataRelationship(id: UUID!, languageTag: String, metadataId: UUID!, relationship: String!): Boolean!
  """Remove an access permission from a collection"""
  deletePermission(permission: PermissionInput!): Permission!
  """Delete a supplementary item"""
  deleteSupplementary(id: UUID!): Boolean!
  """Update an existing collection"""
  edit(collection: CollectionInput!, id: UUID!): Collection!
  """Update an existing language variant"""
  editLanguageVariant(variant: CollectionLanguageVariantInput): Collection!
  """Update a metadata relationship"""
  editMetadataRelationship(relationship: CollectionMetadataRelationshipInput!): Boolean!
  """
  Merge attributes into a collection's existing attributes (existing keys preserved unless overwritten)
  """
  mergeCollectionAttributes(attributes: JSON!, id: UUID!): Boolean!
  """Merge attributes into a collection-item relationship"""
  mergeCollectionItemAttributes(attributes: JSON!, id: UUID!, itemId: UUID!): Boolean!
  """Merge attributes into a metadata-item relationship within a collection"""
  mergeMetadataItemAttributes(attributes: JSON!, id: UUID!, itemId: UUID!): Boolean!
  """Merge attributes into a metadata relationship"""
  mergeMetadataRelationshipAttributes(attributes: JSON!, collectionId: UUID!, languageTag: String, metadataId: UUID!, relationship: String!): Boolean!
  """Permanently delete a collection (cannot be undone)"""
  permanentlyDelete(collectionId: UUID!): Boolean!
  """Remove a child collection from a parent"""
  removeChildCollection(collectionId: UUID!, id: UUID!): Collection!
  """Remove a child metadata item from a collection"""
  removeChildMetadata(id: UUID!, metadataId: UUID!): Collection!
  """Replace all category assignments on a collection"""
  setCategories(categoryIds: [UUID!]!, id: UUID!): Boolean!
  """Set attributes on a child item within a collection"""
  setChildItemAttributes(attributes: JSON, childCollectionId: UUID, childMetadataId: UUID, id: UUID!): Collection!
  """Replace all custom attributes on a collection"""
  setCollectionAttributes(attributes: JSON!, id: UUID!): Boolean!
  """Set the sort ordering for a collection's child items"""
  setCollectionOrdering(id: UUID!, ordering: [OrderingInput!]): Boolean!
  """Set whether a collection may be returned as a recommendation"""
  setCollectionRecommendable(id: UUID!, languageTag: String, recommendable: Boolean!): Boolean!
  """Set whether a collection is indexed for search"""
  setCollectionSearchable(id: UUID!, languageTag: String, searchable: Boolean!): Boolean!
  """Set or update the URL slug for a collection"""
  setCollectionSlug(id: UUID!, languageTag: String, slug: String!): String!
  """Replace all system attributes on a collection"""
  setCollectionSystemAttributes(attributes: JSON!, id: UUID!): Boolean!
  """Lock or unlock a collection from modifications"""
  setLocked(id: UUID!, locked: Boolean!): Collection
  """Replace all metadata relationships for a collection"""
  setMetadataRelationships(id: UUID!, languageTag: String, relationships: [CollectionMetadataRelationshipInput!]!): Boolean!
  """Mark a collection as not ready"""
  setNotReady(id: UUID!, languageTag: String): Boolean!
  """
  Set the parent collections for a given collection, replacing existing parents
  """
  setParentCollections(collections: [CollectionParentCollectionInput!]!, id: UUID!): Boolean
  """Set whether a collection is publicly accessible"""
  setPublic(id: UUID!, languageTag: String, public: Boolean!): Collection!
  """
  Set public, public list, public supplementary, and searchable flags for multiple collections in a single operation, skipping items the caller lacks permission to edit
  """
  setPublicAll(collectionIds: [UUID!]!, public: Boolean!, publicList: Boolean!, publicSupplementary: Boolean!, recommendable: Boolean, searchable: Boolean!): Int!
  """Set whether a collection's child list is publicly visible"""
  setPublicList(id: UUID!, languageTag: String, public: Boolean!): Collection!
  """Set whether a collection's supplementary files are publicly accessible"""
  setPublicSupplementary(id: UUID!, languageTag: String, public: Boolean!): Collection!
  """Mark a collection as ready"""
  setReady(id: UUID!, languageTag: String): Boolean!
  """
  Mark multiple collections as ready in a single operation, skipping items the caller lacks permission to edit
  """
  setReadyAll(collectionIds: [UUID!]!): Int!
  """
  Set recommendation eligibility for multiple collections, skipping items the caller lacks permission to edit
  """
  setRecommendableAll(collectionIds: [UUID!]!, recommendable: Boolean!): Int!
  """Upload content for a supplementary item"""
  setSupplementaryContents(contentType: String!, file: Upload!, supplementaryId: UUID!): Boolean!
  """Set text content for a supplementary item"""
  setSupplementaryTextContents(content: String!, contentType: String!, supplementaryId: UUID!): Boolean!
  """Mark a supplementary item as uploaded with its content type and size"""
  setSupplementaryUploaded(contentType: String!, len: Int!, supplementaryId: UUID!): Boolean!
  """Assign a template to a collection"""
  setTemplate(collectionId: UUID!, templateId: UUID!, templateVersion: Int!): Boolean!
  """Transition a collection to a new workflow state"""
  setWorkflowState(state: CollectionWorkflowState!): Boolean!
  """
  Set the workflow state for multiple collections in a single operation, skipping items already in the target state or that the caller lacks permission to edit
  """
  setWorkflowStateAll(collectionIds: [UUID!]!, stateId: String!, status: String!): Int!
  """Mark a workflow state transition as complete"""
  setWorkflowStateComplete(state: CollectionWorkflowCompleteState!): Boolean!
  """Synchronize all language variants of a collection"""
  syncVariants(collectionId: UUID!): Boolean!
}

"""Input for associating a collection with a parent collection"""
input CollectionParentCollectionInput {
  """Attributes to set on the parent-child relationship"""
  attributes: JSON!
  """ID of the parent collection"""
  id: UUID!
}

"""
Supplementary content attached to a collection (files, assets, processed outputs, etc.)
"""
type CollectionSupplementary {
  """Custom attributes on this supplementary item"""
  attributes: JSON
  """The collection this supplementary belongs to"""
  collectionId: UUID!
  """Content details including type, size, and access URLs"""
  content: CollectionSupplementaryContent!
  """Timestamp when this supplementary was created"""
  created: DateTime!
  """Unique identifier for this supplementary item"""
  id: UUID!
  """Unique key within the collection (e.g. 'thumbnail', 'transcript')"""
  key: String!
  """Timestamp when this supplementary was last modified"""
  modified: DateTime!
  """Display name of the supplementary item"""
  name: String!
  """Storage plan ID"""
  planId: UUID
  """External source information if imported"""
  source: CollectionSupplementarySource
  """Timestamp when content was uploaded, null if not yet uploaded"""
  uploaded: DateTime
}

"""Content details for a collection supplementary item"""
type CollectionSupplementaryContent {
  """The content as parsed JSON (if applicable)"""
  json: JSON!
  """Content length in bytes"""
  length: Int
  """The content as plain text (if applicable)"""
  text: String!
  """MIME content type"""
  type: String!
  """Pre-signed URLs for uploading and downloading the content"""
  urls: CollectionSupplementaryContentUrls!
}

"""Pre-signed URLs for accessing collection supplementary content"""
type CollectionSupplementaryContentUrls {
  """Pre-signed URL for downloading the content"""
  download: SignedUrl!
  """Pre-signed URL for uploading new content"""
  upload: SignedUrl!
}

"""Input for adding supplementary content to a collection"""
input CollectionSupplementaryInput {
  """Custom attributes for the supplementary item"""
  attributes: JSON
  """The collection this supplementary belongs to"""
  collectionId: String!
  """Size of the content in bytes"""
  contentLength: Int
  """MIME type of the supplementary content"""
  contentType: String!
  """Unique key identifying this supplementary item within the collection"""
  key: String!
  """Display name of the supplementary item"""
  name: String!
  """Storage plan ID for content storage"""
  planId: UUID!
  """Optional source ID if imported from an external source"""
  sourceId: UUID
  """Optional identifier from the external source"""
  sourceIdentifier: String
}

"""Source information for imported supplementary content"""
type CollectionSupplementarySource {
  """ID of the source system"""
  id: UUID!
  """Identifier within the source system"""
  identifier: String
}

"""
A template that defines the structure and behavior of a collection, including its attributes and default configuration
"""
type CollectionTemplate {
  """Attribute definitions for collections using this template"""
  attributes: [TemplateAttribute!]!
  """Template-specific configuration"""
  configuration: JSON
  """
  Default attribute values applied to new collections using this template
  """
  defaultAttributes: JSON
  """Content type and attribute filters for this template"""
  filters: CollectionTemplateFilters
  """The metadata item that defines this template"""
  metadata: Metadata
  """Default ordering for child items"""
  ordering: [Ordering!]
}

"""
A single filter defined on a collection template, used to filter child items by content type or attributes
"""
type CollectionTemplateFilter {
  """The filter expression or query string"""
  filter: String!
  """Display name for this filter"""
  name: String!
}

"""Input for defining a single filter within a collection template"""
input CollectionTemplateFilterInput {
  """The filter expression or query string"""
  filter: String!
  """Display name for this filter"""
  name: String!
}

"""The set of filters defined on a collection template"""
type CollectionTemplateFilters {
  """List of filter definitions"""
  filters: [CollectionTemplateFilter!]!
}

"""Input for defining the set of filters on a collection template"""
input CollectionTemplateFiltersInput {
  """List of filter definitions"""
  filters: [CollectionTemplateFilterInput!]!
}

"""Input for creating or updating a collection template definition"""
input CollectionTemplateInput {
  """Attribute definitions for collections using this template"""
  attributes: [TemplateAttributeInput!]!
  """Template-specific configuration"""
  configuration: JSON
  """
  Default attribute values applied to new collections using this template
  """
  defaultAttributes: JSON
  """Content type and attribute filters for this template"""
  filters: CollectionTemplateFiltersInput
  """Default sort ordering for child items"""
  ordering: [OrderingInput!]
}

"""
Mutation operations for managing a collection template's attributes, configuration, filters, and ordering
"""
type CollectionTemplateMutation {
  """
  Add a new attribute definition to the collection template at the specified sort position
  """
  addAttribute(attribute: TemplateAttributeInput!, sort: Int!): Metadata
  """Delete an attribute definition from the collection template by key"""
  deleteAttribute(key: String!): Metadata
  """Replace all attribute definitions on the collection template"""
  setAttributes(attributes: [TemplateAttributeInput!]!): Metadata
  """Set the template-specific configuration"""
  setConfiguration(configuration: JSON!): Metadata
  """
  Set the default attribute values applied to new collections using this template
  """
  setDefaultAttributes(attributes: JSON!): Metadata
  """Replace all filter definitions on the collection template"""
  setFilters(filters: CollectionTemplateFiltersInput!): Metadata
  """
  Set the default sort ordering for child items in collections using this template
  """
  setOrdering(ordering: [OrderingInput!]!): Metadata
}

"""Query operations for browsing collection templates"""
type CollectionTemplates {
  """List all available collection templates"""
  all: [CollectionTemplate!]!
}

"""
The organizational type of a collection, determining its behavior and visibility
"""
enum CollectionType {
  """A folder-like container for organizing content hierarchically"""
  FOLDER
  """A queue that processes items in order"""
  QUEUE
  """The top-level root collection of the content tree"""
  ROOT
  """A standard collection for grouping related content"""
  STANDARD
  """A system-managed collection not directly visible to end users"""
  SYSTEM
}

"""Current workflow state information for a collection"""
type CollectionWorkflow {
  """
  Currently active (incomplete) jobs for this collection, including pending, running, and scheduled jobs
  """
  activeJobs: [ContentJobHistory!]!
  """ID of the workflow to run when the collection is deleted"""
  deleteWorkflow: String
  """Description of what is currently pending, if anything"""
  pending: String
  """Number of currently running workflow steps"""
  running: Int!
  """Current workflow state ID"""
  state: String!
  """Timestamp when the current state became valid"""
  stateValid: DateTime
}

"""Input for marking a workflow state transition as complete"""
input CollectionWorkflowCompleteState {
  """The collection ID"""
  collectionId: UUID!
  """Completion status message"""
  status: String!
}

"""Input for setting the initial workflow state of a collection"""
input CollectionWorkflowInput {
  """ID of the workflow to run when the collection is deleted"""
  deleteWorkflowId: String
  """Initial state ID"""
  state: String!
}

"""Input for transitioning a collection's workflow state"""
input CollectionWorkflowState {
  """The collection ID"""
  collectionId: UUID!
  """
  If true, transition immediately without waiting for workflow completion
  """
  immediate: Boolean!
  """Target state ID"""
  stateId: String!
  """Status message for the transition"""
  status: String!
}

"""Query operations for browsing and searching collections"""
type Collections {
  """Get a specific collection by ID"""
  collection(id: UUID!): Collection
  """Find collections matching the query criteria"""
  find(query: FindQueryInput!): [Collection!]!
  """
  Find collections by system criteria (bypasses normal permission checks)
  """
  findBySystem(query: FindQueryInput!): [Collection!]!
  """Count collections matching the query criteria"""
  findCount(query: FindQueryInput!): Int!
  """Get the root collection of the content tree"""
  root: Collection
  """Access collection template queries"""
  templates: CollectionTemplates
}

"""
A comment on metadata content with support for threaded replies, likes, and moderation
"""
type Comment {
  """Custom user-facing attributes"""
  attributes: JSON
  """The text content of the comment"""
  content: String!
  """When the comment was created"""
  created: DateTime!
  """Unique identifier"""
  id: Long!
  """Whether the current user has liked this comment"""
  likedByMe: Boolean!
  """Number of likes on this comment"""
  likes: Int!
  """The UUID of the metadata this comment belongs to"""
  metadataId: UUID
  """When the comment was last modified"""
  modified: DateTime!
  """Whether this comment is pinned to the top of its thread"""
  pinned: Boolean!
  """The profile that authored this comment"""
  profile: Profile
  """Threaded replies to this comment, as a page with total count"""
  replies(limit: Int!, offset: Int!): Comments!
  """The current moderation status of the comment"""
  status: CommentStatus!
  """Moderator-only system attributes"""
  systemAttributes: JSON
  """The version of the metadata"""
  version: Int
  """
  The visibility scope of the comment; only PUBLIC comments are shown to non-authors once approved
  """
  visibility: ProfileVisibility!
}

"""Input for creating a comment."""
input CommentInput {
  """Custom attributes to attach to the comment"""
  attributes: JSON
  """The text content of the comment"""
  content: String!
  """Optional profile id to post as (managers only, for impersonation)"""
  impersonateId: UUID
  """Optional parent comment id for a threaded reply"""
  parentId: Long
  """Moderator-only system attributes (managers only)"""
  systemAttributes: JSON
  """
  Optional; the server defaults a comment's visibility to the author's profile visibility.
  """
  visibility: ProfileVisibility
}

"""
Moderation status of a comment. A shared, always-loaded enum: the comments
module (social/comments) and the Work Ops comment types both reference it, so it
must exist independent of the optional `comments` feature flag. (Previously this
lived in a now-removed legacy content comment schema.)
"""
enum CommentStatus {
  """Comment has been approved and is visible"""
  APPROVED
  """Comment has been blocked by a moderator"""
  BLOCKED
  """Comment is pending initial (automated) moderation"""
  PENDING
  """Comment is awaiting manual moderator approval before becoming visible"""
  PENDING_APPROVAL
}

"""A page of comments plus the total count."""
type Comments {
  """The comments on this page, newest first."""
  comments: [Comment!]!
  """Total number of comments visible to the caller."""
  count: Int!
}

"""
Comment operations for a metadata item (the value of `MetadataMutation.comments`).
`setCommentStatus` is the approve/block moderation decision.
"""
type CommentsMutation {
  """
  Add a comment. Starts in PENDING status and is moderated asynchronously.
  """
  addComment(comment: CommentInput!, metadataId: UUID!, metadataVersion: Int!): Comment!
  """Like a comment. Returns the new likes count."""
  addCommentLike(commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Int!
  """
  Soft-delete a comment. Managers/SA can delete any; a user can delete only their own.
  """
  deleteComment(commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
  """Unlike a comment. Returns the new likes count."""
  deleteCommentLike(commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Int!
  """Merge system attributes into a comment (requires MANAGE)."""
  mergeCommentSystemAttributes(attributes: JSON!, commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
  """Replace all custom attributes on a comment (requires MANAGE)."""
  setCommentAttributes(attributes: JSON!, commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
  """
  Pin or unpin a comment so it floats to the top of its thread (requires MANAGE or SA).
  """
  setCommentPinned(commentId: Long!, metadataId: UUID!, metadataVersion: Int!, pinned: Boolean!): Boolean!
  """
  Set the moderation status of a comment — the approve/block decision (requires MANAGE or SA).
  """
  setCommentStatus(commentId: Long!, metadataId: UUID!, metadataVersion: Int!, status: CommentStatus!): Boolean!
  """Replace all system attributes on a comment (requires MANAGE)."""
  setCommentSystemAttributes(attributes: JSON!, commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
  """
  Set a comment's visibility scope — e.g. PUBLIC so an approved comment is shown to everyone. Managers/SA may set any comment; a user may set their own.
  """
  setCommentVisibility(commentId: Long!, metadataId: UUID!, metadataVersion: Int!, visibility: ProfileVisibility!): Boolean!
}

"""Input for committing a file to a repository."""
input CommitFileInput {
  authorEmail: String!
  authorName: String!
  branch: String! = "main"
  content: String!
  message: String!
  path: String!
  repositoryId: UUID!
}

"""Result of a file commit."""
type CommitFileResult {
  branch: String!
  commitSha: String!
  path: String!
}

type CommunicationsMutations {
  """
  Delete an external notification preference mapping. Requires the admin group.
  """
  deleteNotificationPreferenceMapping(channel: DeliveryChannel!, type: String!): Boolean!
  """Delete a non-system notification type. Requires the admin group."""
  deleteNotificationType(key: String!): Boolean!
  """
  Pin a BML message project's sends to a published artifact version, or clear the pin with
  null (back to the active/latest version) — data-driven rollback, no redeploy. Requires the
  admin group.
  """
  pinBmlMessageProjectVersion(projectKey: String!, version: String): BmlMessageProject!
  """Register or update a BML message project. Requires the admin group."""
  registerBmlMessageProject(description: String, projectKey: String!, repositoryId: UUID): BmlMessageProject!
  """Remove a BML message project registration. Requires the admin group."""
  removeBmlMessageProject(projectKey: String!): Boolean!
  """
  Set a user's opt-out for a channel + type on their behalf. Requires edit permission on the profile.
  """
  setNotificationPreference(channel: DeliveryChannel!, optedOut: Boolean!, profileId: UUID!, type: String!): NotificationPreference!
  """
  Create or replace the external mapping for one notification type and channel.
  The type must exist and be optional. Requires the admin group.
  """
  setNotificationPreferenceMapping(channel: DeliveryChannel!, externalId: String!, provider: String!, type: String!): NotificationPreferenceMapping!
  """
  Set a user's push quiet hours on their behalf. Provide timeZone (IANA id) and both
  HH:MM local times together, or all null to clear. Requires edit permission on the profile.
  """
  setNotificationSettings(dndEndLocal: String, dndStartLocal: String, profileId: UUID!, timeZone: String): NotificationSettings!
  """
  Create or update a notification type. The key is immutable once created; the
  optional flag of system types cannot be changed. Requires the admin group.
  """
  setNotificationType(defaultEmailEnabled: Boolean!, defaultPushEnabled: Boolean!, description: String, displayOrder: Int!, hidden: Boolean!, key: String!, name: String!, optional: Boolean!): NotificationType!
  """Process a one-click unsubscribe via token."""
  unsubscribe(token: String!): Boolean!
  """
  Set the current user's opt-out for a channel + type. Non-optional types cannot be opted out.
  """
  updateMyNotificationPreference(channel: DeliveryChannel!, optedOut: Boolean!, type: String!): NotificationPreference!
  """
  Set the current user's push quiet hours. Provide timeZone (IANA id) and both HH:MM
  local times together, or all null to clear.
  """
  updateMyQuietHours(dndEndLocal: String, dndStartLocal: String, timeZone: String): NotificationSettings!
  """
  Update a preference via an unsubscribe token, for the manage-preferences page
  reached from an email link. The channel defaults to EMAIL when absent (the original
  email-only contract). Returns false for an unknown token.
  """
  updateTokenNotificationPreference(channel: DeliveryChannel, optedOut: Boolean!, token: String!, type: String!): Boolean!
}

type CommunicationsQueries {
  """
  The message projects the BML Message Server hosts, for authoring dropdowns. Requires the editor group.
  """
  bmlMessageHostedProjects: [BmlMessageHostedProject!]!
  """Get a registered BML message project. Requires the admin group."""
  bmlMessageProject(projectKey: String!): BmlMessageProject
  """
  A hosted message project's published versions, newest first. Requires the editor group.
  """
  bmlMessageProjectVersions(project: String!): [String!]!
  """List registered BML message projects. Requires the admin group."""
  bmlMessageProjects: [BmlMessageProject!]!
  """Get delivery status for a specific message and recipient."""
  deliveryStatus(messageId: UUID!, recipientId: UUID!): DeliveryStatus
  """List aggregate delivery statuses across all recipients, newest first."""
  deliveryStatuses(limit: Int! = 50, offset: Long! = 0): DeliveryStatuses!
  """
  Render a BML message template's email channel through the production resolution + render path
  (the registry pin applies; version overrides it), minus send-only concerns: no click-tracking
  rewrite, no minted unsubscribe links. payload is the template payload as a JSON string.
  Requires the editor group.
  """
  emailPreview(locale: String, payload: String, project: String!, recipientEmail: String, recipientName: String, templateKey: String!, version: String): EmailPreview!
  """List delivery statuses for all recipients of a message."""
  messageStatuses(messageId: UUID!): [DeliveryStatus!]!
  """
  The current user's full channel × type preference matrix, with opted-in defaults for unset combinations.
  """
  myNotificationPreferences: [NotificationPreference!]!
  """The current user's notification settings (push quiet hours)."""
  myNotificationSettings: NotificationSettings
  """External notification preference mappings. Requires the admin group."""
  notificationPreferenceMappings: [NotificationPreferenceMapping!]!
  """
  Get a user's full notification preference matrix. Requires the admin group.
  """
  notificationPreferences(profileId: UUID!): [NotificationPreference!]!
  """Get a user's notification settings. Requires the admin group."""
  notificationSettings(profileId: UUID!): NotificationSettings
  """
  The notification type catalog, ordered for presentation. Public: the preference UIs need it to render.
  """
  notificationTypes: [NotificationType!]!
  """
  List raw delivery events for a recipient, newest first — includes gate decisions. Requires the admin group.
  """
  recipientEvents(limit: Int! = 50, offset: Long! = 0, recipientId: UUID!): [DeliveryEvent!]!
  """List delivery history for a recipient, newest first."""
  recipientHistory(limit: Int! = 50, offset: Long! = 0, recipientId: UUID!): [DeliveryStatus!]!
  """
  All-channel preferences for the profile an unsubscribe token belongs to,
  for the manage-preferences page reached from an email link. Null for an unknown token.
  """
  tokenNotificationPreferences(token: String!): [NotificationPreference!]
}

"""
Root query type for community features, providing access to groups and channels
"""
type Community {
  """Access paginated listing of all community groups"""
  all: CommunityGroups!
  """Retrieve a single community group by its unique identifier"""
  group(id: UUID!): CommunityGroup
}

"""
A scheduled or recurring activity within a community group, such as a meeting, event, study session, or service project
"""
type CommunityActivity {
  """
  Structured content for the activity as a JSON object (e.g. agenda, materials, links)
  """
  content: JSON
  """Human-readable description of the activity"""
  description: String!
  """ID of the community group this activity belongs to"""
  groupId: UUID!
  """Unique identifier for this activity"""
  id: UUID!
  """Display name of the activity"""
  name: String!
  """
  Scheduling information as a JSON object (e.g. recurrence rules, start/end times)
  """
  schedule: JSON
  """
  The type classification of this activity (e.g. 'meeting', 'event', 'study', 'service')
  """
  type: String!
}

"""
A community group that brings together members around a shared purpose such as family, small group study, or custom activities. Groups contain members, chat channels, activities, and prayer requests.
"""
type CommunityGroup {
  """
  List of activities (events, studies, service projects) within this group
  """
  activities: [CommunityActivity!]!
  """Custom attributes associated with this group as a JSON object"""
  attributes: JSON
  """List of chat channels associated with this group"""
  channels: [ChatChannel!]!
  """Human-readable description of the group's purpose"""
  description: String!
  """Unique identifier for this community group"""
  id: UUID!
  """List of all members belonging to this group"""
  members: [CommunityGroupMember!]!
  """Display name of the community group"""
  name: String!
  """
  Paginated list of prayer requests submitted to this group, optionally filtered by status
  """
  prayers(limit: Int, offset: Int, status: [PrayerStatus!]): Prayers!
  """List of active signup tokens that can be used to join this group"""
  signupTokens: [CommunityGroupSignupToken!]!
  """The type classification of this group (family, small group, or custom)"""
  type: CommunityGroupType!
  """
  The visibility level controlling who can discover and access this group
  """
  visibility: CommunityVisibility!
}

"""A membership record linking a user profile to a community group"""
type CommunityGroupMember {
  """ID of the community group this membership belongs to"""
  groupId: UUID!
  """The full user profile of the member"""
  profile: Profile!
  """ID of the member's user profile"""
  profileId: UUID!
}

"""
A time-limited token that allows a new user to join a community group without a direct invitation
"""
type CommunityGroupSignupToken {
  """Timestamp when this signup token was created"""
  created: DateTime!
  """Timestamp when this signup token expires and can no longer be used"""
  expires: DateTime!
  """ID of the community group this token grants access to"""
  groupId: UUID!
  """The unique token string used in the join URL or form"""
  token: String!
}

"""The type of community group, defining its purpose and default behavior"""
enum CommunityGroupType {
  """A custom group type with user-defined purpose and behavior"""
  CUSTOM
  """A family unit group for household or family members"""
  FAMILY
  """A small group for Bible study, support, or fellowship gatherings"""
  SMALL_GROUP
}

"""Paginated container for listing community groups with a total count"""
type CommunityGroups {
  """Paginated list of community groups"""
  groups(limit: Int!, offset: Long!): [CommunityGroup!]!
  """Total number of community groups available"""
  total: Long!
}

"""
Mutation operations for managing community groups, activities, prayers, and membership
"""
type CommunityMutation {
  """Generate a new time-limited signup token for a community group"""
  addCommunityGroupSignupToken(groupId: UUID!): CommunityGroupSignupToken!
  """Add a user profile as a member of a community group"""
  addMember(groupId: UUID!, profileId: UUID!): Boolean!
  """Grant a group permission on a community group"""
  addPermission(permission: PermissionInput!): EntityPermission!
  """Submit a new prayer request to a community group"""
  addPrayer(attributes: JSON, content: JSON!, groupId: UUID!, title: String!): Prayer!
  """Add a comment to a prayer request"""
  addPrayerComment(attributes: JSON, content: String!, parentId: Long, prayerId: UUID!): PrayerComment!
  """Create a new activity within a community group"""
  createActivity(content: JSON, description: String!, groupId: UUID!, name: String!, schedule: JSON, type: String!): CommunityActivity!
  """Create a new chat channel associated with a community group"""
  createChannel(attributes: JSON, groupId: UUID!, name: String!, type: ChatChannelType!): ChatChannel!
  """
  Create a new community group with the specified name, description, type, visibility, and optional attributes
  """
  createGroup(attributes: JSON, description: String!, name: String!, type: CommunityGroupType!, visibility: CommunityVisibility!): CommunityGroup!
  """Delete an existing signup token from a community group"""
  deleteCommunityGroupSignupToken(groupId: UUID!, token: String!): Boolean!
  """Remove a group permission from a community group"""
  deletePermission(permission: PermissionInput!): EntityPermission!
  """Delete a prayer request by its unique identifier"""
  deletePrayer(id: UUID!): Boolean!
  """Delete a comment from a prayer request (soft-delete)"""
  deletePrayerComment(commentId: Long!, prayerId: UUID!): Boolean!
  """Join a community group using a valid signup token"""
  join(token: String!): CommunityGroup!
  """Like a prayer request"""
  likePrayer(id: UUID!): Prayer!
  """Mark that the current user has prayed for a prayer request"""
  markPrayed(id: UUID!): Prayer!
  """Remove a user profile from a community group"""
  removeMember(groupId: UUID!, profileId: UUID!): Boolean!
  """
  Send a prayer reference to a chat channel as a PRAYER message content block
  """
  sendPrayerToChat(channelId: UUID!, clientId: UUID!, prayerId: UUID!): Boolean!
  """Share a prayer with a specific profile (owner-only)"""
  sharePrayer(id: UUID!, profileId: UUID!): Prayer!
  """Toggle anniversary suppression for a prayer (owner-only)"""
  suppressPrayerAnniversaries(id: UUID!, suppress: Boolean!): Prayer!
  """Remove the current user's like from a prayer request"""
  unlikePrayer(id: UUID!): Prayer!
  """Remove the current user's prayed mark from a prayer request"""
  unmarkPrayed(id: UUID!): Prayer!
  """Remove a prayer share from a specific profile (owner-only)"""
  unsharePrayer(id: UUID!, profileId: UUID!): Prayer!
  """
  Update an existing community activity. Only provided fields are modified.
  """
  updateActivity(content: JSON, description: String, id: UUID!, name: String, schedule: JSON, type: String): CommunityActivity!
  """Update an existing community group. Only provided fields are modified."""
  updateGroup(attributes: JSON, description: String, id: UUID!, name: String, type: CommunityGroupType, visibility: CommunityVisibility): CommunityGroup!
  """
  Update the lifecycle status of a prayer request. Owners may set ACTIVE, CANCELLED, or ANSWERED. Group moderators may set BLOCKED, ACTIVE, or PENDING_APPROVAL.
  """
  updatePrayerStatus(id: UUID!, status: PrayerStatus!): Prayer!
}

"""
The visibility level of a community group, controlling who can discover and access it
"""
enum CommunityVisibility {
  """
  Not discoverable through search or listings; accessible only via direct link or token
  """
  HIDDEN
  """
  Visible only to members; requires an invitation or signup token to join
  """
  PRIVATE
  """Visible to all users and discoverable through search and listings"""
  PUBLIC
}

"""Company creates and per-company operations."""
type CompaniesMutation {
  """
  Create a company. Also creates its organization + profile pair in the profiles domain.
  """
  add(input: CompanyInput!): Company!
  """Operations on an existing company."""
  company(id: UUID!): CompanyMutation!
}

"""
A seller/tenant. Identity (name, branding, membership) lives on the linked organization profile in
the profiles domain (created with the company); this row carries the commerce linkage. Everything
else in the module hangs off a company.
"""
type Company {
  created: DateTime!
  """Credit instruments issued by this company, paged."""
  credits(limit: Int! = 25, offset: Int! = 0): [CompanyCredit!]!
  id: UUID!
  """
  The unit this company's product/container dimensions are stored in. Defaults INCHES.
  """
  lengthUnit: LengthUnit!
  modified: DateTime!
  """
  The backing organization in the profiles domain (created with the company).
  """
  organization: Organization!
  """The organization's profile — the company's public identity."""
  profile: Profile!
  """
  The unit this company's product/container weights are stored in. Defaults POUNDS.
  """
  weightUnit: WeightUnit!
}

"""
A numbered credit instrument (gift/store credit) issued by a company, spendable as a COMPANY_CREDIT
payment. Balance changes are audited.
"""
type CompanyCredit {
  """The account this credit is bound to, if restricted to one."""
  account: Account
  """Remaining spendable balance."""
  balance: Money!
  company: Company!
  created: DateTime!
  description: String
  """When the credit stops being redeemable, if it expires."""
  expires: DateTime
  id: UUID!
  """The redeemable number (natural key)."""
  number: String!
  """Total spent from this credit so far."""
  paid: Money!
}

"""Issues a numbered company credit instrument."""
input CompanyCreditInput {
  """Restrict redemption to one account, if set."""
  accountId: UUID = null
  """Initial spendable balance."""
  balance: Money!
  description: String = null
  """Expiry, if the credit should lapse."""
  expires: DateTime = null
  """The redeemable number (unique). Generated server-side when omitted."""
  number: String = null
}

"""
Creates a company plus its organization + profile pair in the profiles domain.
"""
input CompanyInput {
  """Free-form attributes for the created organization."""
  attributes: JSON = null
  """The organization/company name."""
  name: String!
}

"""Mutations scoped to one company (the namespace field's id)."""
type CompanyMutation {
  """Issue a numbered company credit instrument (gift/store credit). Admin."""
  addCredit(input: CompanyCreditInput!): CompanyCredit!
  """Soft-delete an issued credit instrument. Admin."""
  deleteCredit(id: UUID!): Boolean!
  """
  Edit an issued credit's description/balance/account/expiry (number and spent total are immutable). Admin.
  """
  editCredit(id: UUID!, input: CompanyCreditInput!): CompanyCredit!
  """
  Set the units this company stores product/container dimensions and weights in. Admin.
  """
  setUnits(lengthUnit: LengthUnit!, weightUnit: WeightUnit!): Company!
}

"""
Input for a container component that groups child components in a scripture rendering layout
"""
input ComponentContainerInput {
  """Child components nested within this container"""
  components: [ComponentInput!]!
  """Optional style to apply to this container"""
  style: StyleInput
  """The layout type of this container (e.g. PARAGRAPH, SPAN, DIV)"""
  type: ContainerType!
}

"""
Input for a single component in the scripture rendering tree. Exactly one of the component type fields should be set.
"""
input ComponentInput {
  """A line break component"""
  break: BreakInput
  """A container grouping child components"""
  container: ComponentContainerInput
  """A verse end boundary marker"""
  end: VerseEndInput
  """A verse start boundary marker"""
  start: VerseStartInput
  """A text content component"""
  text: TextInput
}

"""
A configuration entry in the application's key-value store. Configurations hold platform settings, feature flags, and other runtime parameters with permission-based access control.
"""
type Configuration {
  """
  A human-readable description of what this configuration controls and how it is used.
  """
  description: String!
  """The unique internal identifier of this configuration entry."""
  id: String!
  """
  The unique key used to look up this configuration (e.g. 'app.feature.enabled', 'theme.primaryColor').
  """
  key: String!
  """
  The list of permissions that control which groups can read or modify this configuration.
  """
  permissions: [ConfigurationPermission!]!
  """
  Whether this configuration value is publicly accessible without authentication. Public configurations are available to unauthenticated clients.
  """
  public: Boolean!
  """
  The configuration value stored as JSON. Can hold any JSON-serializable data including strings, numbers, objects, or arrays.
  """
  value: JSON
}

"""
Input for creating or updating a configuration entry in the key-value store.
"""
input ConfigurationInput {
  """
  A human-readable description of what this configuration controls and how it is used.
  """
  description: String!
  """
  The unique key for this configuration (e.g. 'app.feature.enabled', 'theme.primaryColor'). Must be unique across all configurations.
  """
  key: String!
  """
  The list of permissions that control which groups can read or modify this configuration.
  """
  permissions: [PermissionInput!]!
  """
  Whether this configuration value should be publicly accessible without authentication.
  """
  public: Boolean!
  """
  The configuration value stored as JSON. Can hold any JSON-serializable data including strings, numbers, objects, or arrays.
  """
  value: JSON!
}

"""
A permission rule that grants a specific action to a security group for accessing a configuration entry.
"""
type ConfigurationPermission {
  """The permission action granted to the group (e.g. read, write)."""
  action: PermissionAction!
  """The security group that is granted this permission."""
  group: Group!
}

"""Query operations for retrieving application configuration entries."""
type Configurations {
  """
  Retrieve all configuration entries that the current user has permission to access.
  """
  all: [Configuration!]!
  """
  Retrieve a single configuration entry by its unique key. Returns null if the key does not exist or the user lacks permission.
  """
  configuration(
    """The unique key of the configuration to retrieve."""
    key: String!
  ): Configuration
}

"""Mutation operations for managing application configuration entries."""
type ConfigurationsMutation {
  """
  Delete a configuration entry by its key. Returns the key of the deleted configuration, or null if the key was not found.
  """
  deleteConfiguration(
    """The unique key of the configuration to delete."""
    key: String!
  ): String
  """
  Create or update a configuration entry. If a configuration with the given key already exists, it is updated; otherwise a new entry is created.
  """
  setConfiguration(
    """The configuration data to create or update."""
    configuration: ConfigurationInput!
  ): Configuration
}

"""
Determines how the restore process handles pre-existing records that conflict with data in the backup archive.
"""
enum ConflictStrategy {
  """Abort the entire restore if any conflicts are detected."""
  FAIL
  """Overwrite existing records with data from the backup archive."""
  OVERWRITE
  """Skip records that already exist, leaving the current data untouched."""
  SKIP
}

"""Creates or edits a shipping container (box type)."""
input ContainerInput {
  companyId: UUID!
  height: Float!
  length: Float!
  name: String!
  supportedHeight: Float!
  supportedLength: Float!
  supportedWeight: Float!
  supportedWidth: Float!
  weight: Float!
  width: Float!
}

"""Operations on one container. Admin."""
type ContainerMutation {
  """Soft-delete the container."""
  delete: Boolean!
  """Edit the container's name, dimensions, and capacity."""
  edit(input: ContainerInput!): EcomContainer!
}

"""
A custom renderer that can be used to display content within a document template container
"""
type ContainerRenderer {
  """Optional JSON configuration for the renderer"""
  configuration: JSON
  """
  Unique name identifying this renderer (e.g. 'scripture-block', 'media-embed')
  """
  name: String!
}

"""
Input for specifying a custom renderer for a document template container
"""
input ContainerRendererInput {
  """Optional JSON configuration for the renderer"""
  configuration: JSON
  """Unique name identifying this renderer"""
  name: String!
}

"""Layout type for a container component in the scripture rendering tree"""
enum ContainerType {
  """A vertical column layout"""
  COLUMN
  """A generic block-level division"""
  DIV
  """A paragraph block, typically used for prose scripture text"""
  PARAGRAPH
  """A horizontal row layout"""
  ROW
  """
  An inline span, used for inline elements like verse numbers or red-letter text
  """
  SPAN
  """A tabular layout for structured content"""
  TABLE
}

"""Container (box catalog) creates and per-container operations. Admin."""
type ContainersMutation {
  """Create a container (box type) in a company."""
  add(input: ContainerInput!): EcomContainer!
  """Operations on an existing container."""
  container(id: UUID!): ContainerMutation!
}

"""
The primary content query type providing access to all content management features — collections, metadata, categories, workflow states, and search
"""
type Content {
  """Access category queries"""
  categories: Categories!
  """
  Check which collection IDs the current user has the specified permission actions on. Returns the subset of IDs where all actions are allowed.
  """
  checkCollectionActions(actions: [PermissionAction!]!, ids: [UUID!]!): [UUID!]!
  """
  Check which metadata IDs the current user has the specified permission actions on. Returns the subset of IDs where all actions are allowed.
  """
  checkMetadataActions(actions: [PermissionAction!]!, ids: [UUID!]!): [UUID!]! @deprecated(reason: "No longer supported")
  """
  Get a collection by ID (deprecated: use collections.collection instead)
  """
  collection(id: UUID): Collection @deprecated(reason: "No longer supported")
  """
  Get a collection supplementary by ID (deprecated: use collection.supplementary instead)
  """
  collectionSupplementary(supplementaryId: UUID!): CollectionSupplementary @deprecated(reason: "No longer supported")
  """
  List all collection templates (deprecated: use collections.templates instead)
  """
  collectionTemplates: CollectionTemplates!
  """Access collection queries"""
  collections: Collections!
  """
  Metadata items that have comments, most-recent-comment first — the moderation landing list.
  """
  commentedMetadata(limit: Int!, offset: Int!): [Metadata!]!
  """Access data template queries"""
  dataTemplates: DataTemplates!
  """Get the JSON schema for document content validation"""
  documentContentSchema: JSON!
  """Access document template queries"""
  documentTemplates: DocumentTemplates!
  """
  Find collections matching criteria (deprecated: use collections.find instead)
  """
  findCollections(query: FindQueryInput!): [Collection!]! @deprecated(reason: "No longer supported")
  """
  Find collections by system criteria (deprecated: use collections.findBySystem instead)
  """
  findCollectionsBySystem(query: FindQueryInput!): [Collection!]! @deprecated(reason: "No longer supported")
  """
  Count collections matching criteria (deprecated: use collections.findCount instead)
  """
  findCollectionsCount(query: FindQueryInput!): Int!
  """Find metadata items matching the query criteria"""
  findMetadata(query: FindQueryInput!): [Metadata!]!
  """
  Find metadata items by system criteria (bypasses normal permission checks)
  """
  findMetadataBySystem(query: FindQueryInput!): [Metadata!]!
  """Count metadata items matching the query criteria"""
  findMetadataCount(query: FindQueryInput!): Int!
  """Access guide template queries"""
  guideTemplates: GuideTemplates! @deprecated(reason: "No longer supported")
  """Access global guide queries."""
  guides: Guides!
  """
  Run a comprehensive health check across all content, identifying issues that may require editorial attention such as broken relationships, unpublished dependencies, and workflow problems
  """
  healthCheck: ContentHealthCheck!
  """Get a specific metadata item by ID and optional version"""
  metadata(id: UUID!, version: Int): Metadata
  """Get a metadata supplementary item by its ID"""
  metadataSupplementary(supplementaryId: UUID!): MetadataSupplementary
  """
  Look up a content item (collection, metadata, or profile) by its URL slug
  """
  slug(slug: String!): ContentItem
  """Check whether a slug is available for use"""
  slugAvailable(slug: String!): Boolean!
  """Access content source queries"""
  sources: Sources!
  """Access workflow state queries"""
  states: WorkflowStates!
  """Access query operations for reusable template attribute tools"""
  templateAttributeTools: TemplateAttributeTools!
  """Access workflow transition queries"""
  transitions: Transitions!
}

"""
Comprehensive content health check results identifying issues across the content management system that may require editorial attention. All list fields support optional offset/limit pagination (default limit: 100).
"""
type ContentHealthCheck {
  """
  Metadata items that have been soft-deleted and may require permanent deletion or restoration
  """
  deletedItems: ContentHealthCheckCount!
  """Metadata items with jobs that failed during workflow processing"""
  failedJobItems(limit: Int, offset: Int): [ContentHealthCheckItem!]!
  """
  Published guide metadata items that contain steps referencing unpublished metadata
  """
  guidesWithUnpublishedSteps(limit: Int, offset: Int): [ContentHealthCheckItem!]!
  """
  Metadata items with no content uploaded (uploaded timestamp is null) and not in draft state
  """
  missingContent(limit: Int, offset: Int): [ContentHealthCheckItem!]!
  """
  Metadata items in a pending workflow state that have not been marked as ready for publishing
  """
  pendingNotReady(limit: Int, offset: Int): [ContentHealthCheckItem!]!
  """Published collection items that contain unpublished child metadata"""
  publishedCollectionsWithUnpublishedMetadata(limit: Int, offset: Int): [ContentHealthCheckItem!]!
  """
  Metadata items in a published state whose relationships reference unpublished metadata items
  """
  publishedWithUnpublishedRelationships(limit: Int, offset: Int): [ContentHealthCheckItem!]!
  """
  Metadata items with a future scheduled publish date that have not yet transitioned to published state
  """
  scheduledButNotPublished(limit: Int, offset: Int): [ContentHealthCheckItem!]!
}

"""A summary count for a specific category of content health issue"""
type ContentHealthCheckCount {
  """Total number of items affected by this health issue category"""
  count: Int!
}

"""
A single content health issue identified by the health check, representing a metadata or collection item that requires attention
"""
type ContentHealthCheckItem {
  """Unique identifier of the affected content item"""
  id: UUID!
  """Display name of the affected content item"""
  name: String!
  """
  Current workflow state of the item (e.g. 'draft', 'pending', 'published')
  """
  workflowState: String!
}

"""Mutation operations for resolving content health check issues"""
type ContentHealthCheckMutation {
  """
  Set public and public_content flags on all related metadata for a published item that currently lack public visibility
  """
  resolveUnpublishedRelationships(id: UUID!): Boolean!
}

"""
A union of all content types that can be resolved by slug — collections, metadata, or profiles
"""
union ContentItem = Collection | Metadata | Profile

"""
A single job execution record associated with a content item (metadata or collection)
"""
type ContentJobHistory {
  """
  The timestamp when this job execution completed, or null if still in progress
  """
  complete: DateTime
  """The timestamp when this job execution was created"""
  created: DateTime!
  """
  The timestamp until which this job's execution was delayed, or null if not delayed
  """
  delayedUntil: DateTime
  """
  A human-friendly label derived from the job name, suitable for display in admin UIs
  """
  displayName: String!
  """The unique identifier of this specific job execution"""
  jobId: UUID!
  """The name identifying the type of job that was executed"""
  jobName: String!
  """
  A status message describing the current or final state of the job execution
  """
  status: String!
  """Whether the job completed successfully"""
  success: Boolean!
}

"""Mutation operations for all content management features"""
type ContentMutation {
  """Access category mutations"""
  category: CategoryMutation!
  """Access collection mutations"""
  collection: CollectionMutation!
  """Access content health check mutations for resolving identified issues"""
  healthCheck: ContentHealthCheckMutation!
  """Access metadata mutations"""
  metadata: MetadataMutation!
  """Rebuild all storage system content indexes"""
  rebuildStorageSystemContent: Boolean!
  """Trigger an image resize operation"""
  resizeImage: Boolean!
  """Access content source mutations"""
  sources: SourceMutation!
  """Access workflow state mutations"""
  states: WorkflowStatesMutation!
  """
  Access mutation operations for managing reusable template attribute tools
  """
  templateAttributeTools: TemplateAttributeToolsMutation!
  """Access workflow transition mutations"""
  transitions: TransitionsMutation!
}

"""A union of all relationship types between content items"""
union ContentRelationship = CollectionLanguageVariantMetadataRelationship | CollectionMetadataRelationship | MetadataRelationship

"""Defines what analytics events count as conversions for an experiment."""
type ConversionGoal {
  created: DateTime!
  """
  CUPED covariate for variance reduction. Null when no adjustment is configured.
  """
  cupedCovariate: CupedCovariate
  elementId: String
  elementType: String
  """Filtered event type, or null when the goal counts events of any type."""
  eventType: EventType
  experimentId: UUID!
  id: UUID!
  """Analytics extra key used to select item interactions."""
  itemExtraKey: String
  """Exact scalar extra value, or null for key-presence matching."""
  itemExtraValue: String
  metricType: GoalMetricType!
  name: String!
  """
  Page path filter — when set, the goal only counts events with this page.path.
  """
  pagePath: String
  """
  Role in verdict logic. Drives how regressions on this goal influence the overall SHIP/HALT decision.
  """
  role: ConversionGoalRole!
}

"""Input for creating a conversion goal for an experiment."""
input ConversionGoalInput {
  """Optional CUPED covariate configuration for variance reduction."""
  cupedCovariate: CupedCovariateInput
  elementId: String
  elementType: String
  """Filters by event type. Null = match events of any type."""
  eventType: EventType
  """
  Select interactions whose element carries this analytics extra key and at least one content reference.
  """
  itemExtraKey: String
  """
  Optional exact, case-sensitive scalar value for itemExtraKey. Null means key presence.
  """
  itemExtraValue: String
  """Defaults to UNIQUE_CONVERSION if omitted."""
  metricType: GoalMetricType
  name: String!
  """
  Restricts the goal to events emitted on a specific page path. Null = match any page.
  """
  pagePath: String
  """Defaults to PRIMARY if omitted."""
  role: ConversionGoalRole
}

"""
Role a conversion goal plays in an experiment's verdict logic.

`PRIMARY` goals drive SHIP/DO_NOT_SHIP decisions — they are the metrics
the experiment is trying to move. `SECONDARY` goals inform the report
without halting a rollout; a significant regression on a secondary
downgrades an otherwise-SHIP verdict to INCONCLUSIVE but never to
DO_NOT_SHIP. `GUARDRAIL` goals are "must not break" safety metrics; a
significant regression on any guardrail produces HALT, which the rollout
controller interprets as "revert treatment to 0% and pause the
experiment". Guardrail HALT dominates every other signal except
SRM_FAILED.
"""
enum ConversionGoalRole {
  GUARDRAIL
  PRIMARY
  SECONDARY
}

