  artifactPublicationId: UUID
  environmentId: UUID!
  healthCheckUrl: String
  projectId: UUID!
  releaseId: UUID
  targetKind: WorkOpsDeployTargetKind = HELM
  versionId: UUID!
}

enum WorkOpsDeployTargetKind {
  APP_STORE
  GOOGLE_PLAY
  HELM
  HELM_VALUES
}

type WorkOpsEnvironment {
  autoPromote: Boolean!
  description: String
  displayOrder: Int!
  """Whether this is an on-demand preview environment (per-branch/PR)."""
  ephemeral: Boolean!
  id: UUID!
  """
  Program-unique stable identifier the release-pipeline YAML links to; immutable after create.
  """
  key: String!
  name: String!
  """
  Explicit environment grants, visible to program managers. Parent-program grants remain inherited.
  """
  permissions: [EntityPermission!]!
  programId: UUID!
  """Ids of the environments this one can be promoted from (many-to-many)."""
  promotionSourceIds: [UUID!]!
  requiresApproval: Boolean!
  """
  The specific channel within targetType (e.g. a Play track name), or null.
  """
  targetRef: String
  """External distribution channel this environment deploys to."""
  targetType: WorkOpsEnvironmentTargetType!
  """The resolved environment type."""
  type: WorkOpsEnvironmentType!
  """The global environment type this environment instantiates."""
  typeId: UUID!
  version: Long!
}

type WorkOpsEnvironmentDeployment {
  appBuildNumberAllocationId: UUID
  artifactPublicationId: UUID
  deployedAt: DateTime
  deployedByPrincipalId: UUID
  """The deployed version, resolved (name)."""
  deployedVersion: WorkOpsVersion
  environmentId: UUID!
  healthCheckStatus: WorkOpsHealthCheckStatus!
  healthCheckUrl: String
  id: UUID!
  lastHealthCheckAt: DateTime
  previousDeploymentId: UUID
  """
  The deployed project, resolved (name/key) so callers needn't render a raw UUID.
  """
  project: WorkOpsProject
  projectId: UUID!
  releaseId: UUID
  status: WorkOpsEnvironmentDeploymentStatus!
  """
  Stable deploy-adapter identity; current state is independent per target.
  """
  targetKind: WorkOpsDeployTargetKind!
  version: Long!
  versionId: UUID!
}

enum WorkOpsEnvironmentDeploymentStatus {
  DEPLOYED
  DEPLOYING
  FAILED
  PENDING
  ROLLED_BACK
}

type WorkOpsEnvironmentDrift {
  """
  The version currently deployed in the environment, resolved (name); null when nothing is deployed.
  """
  deployedVersion: WorkOpsVersion
  deployedVersionId: UUID
  driftType: WorkOpsEnvironmentDriftType!
  """The version this release would ship, resolved (name)."""
  expectedVersion: WorkOpsVersion
  expectedVersionId: UUID!
  """The project, resolved (name/key)."""
  project: WorkOpsProject
  projectId: UUID!
}

enum WorkOpsEnvironmentDriftType {
  NOT_DEPLOYED
  VERSION_MISMATCH
}

"""
The external distribution channel an environment deploys to; targetRef names the specific channel.
"""
enum WorkOpsEnvironmentTargetType {
  APP_STORE
  GENERIC
  PLAY_TRACK
  TESTFLIGHT
}

"""
A global, user-managed lifecycle stage (development / staging / production / preview / …). Pipelines reference a type by name; each program's environments instantiate one.
"""
type WorkOpsEnvironmentType {
  description: String
  displayOrder: Int!
  id: UUID!
  """Globally unique — the portable identifier pipelines reference."""
  name: String!
  version: Long!
}

"""
One field's change captured inside a WorkOpsTaskHistoryEntry. Old / new
values are opaque JSON elements so any field type round-trips.
"""
type WorkOpsFieldChange {
  """
  Canonical identifier for the field. Built-in columns use the column
  name (`status_id`, `summary`, …); Phase 4 custom fields use the
  `core-forms` field key.
  """
  fieldKey: String!
  """Alias for fieldKey."""
  fieldName: String!
  """Value before the change. Null = unset; explicit JSON null = was null."""
  fromValue: JSON
  """Alias for toValue."""
  newValue: JSON
  """Alias for fromValue."""
  oldValue: JSON
  """Value after the change."""
  toValue: JSON
}

enum WorkOpsGenerationSource {
  CLAUDE_CODE
  KIT
  MANUAL
}

enum WorkOpsHealthCheckStatus {
  DEGRADED
  HEALTHY
  UNHEALTHY
  UNKNOWN
}

"""
A free-form tag attachable to tasks. Names are stored lowercased
and kebab-case-validated at the service boundary.
"""
type WorkOpsLabel {
  colorHex: String
  id: UUID!
  name: String!
  portfolioId: UUID
  programId: UUID
  projectId: UUID
  scope: WorkOpsLabelScope!
  version: Long!
}

"""
The reach of a label in the hierarchy (R9). WorkOpsLabels at higher scope
are visible to tasks in the parent chain — a `PORTFOLIO` label can
be attached to any task in any project of any program in that
portfolio.
"""
enum WorkOpsLabelScope {
  GLOBAL
  PORTFOLIO
  PROGRAM
  PROJECT
}

type WorkOpsLabels {
  byPortfolio(portfolioId: UUID!): [WorkOpsLabel!]!
  byProgram(programId: UUID!): [WorkOpsLabel!]!
  byProject(projectId: UUID!): [WorkOpsLabel!]!
  global: [WorkOpsLabel!]!
  label(id: UUID!): WorkOpsLabel
}

type WorkOpsLabelsMutation {
  create(input: CreateWorkOpsLabelInput!): WorkOpsLabel!
  delete(id: UUID!): Boolean!
  update(colorHex: String, expectedVersion: Long!, id: UUID!, name: String!): WorkOpsLabel!
}

"""
Coarse classification driving link-graph rules. `BLOCKS` is the only
category subject to cycle detection; other categories permit cycles
(a `RELATES_TO` ring among related tasks is legitimate).
"""
enum WorkOpsLinkCategory {
  BLOCKS
  CAUSES
  CLONES
  CUSTOM
  DUPLICATES
  RELATES_TO
}

"""
A program-level cross-project commitment. WorkOpsTasks attach to a
milestone via `WorkOpsTask.milestoneId?` (column added in this phase's
migration). Phase 9's roadmap renders milestones as Gantt markers
across the program timeline.
"""
type WorkOpsMilestone {
  closedAt: DateTime
  description: String
  id: UUID!
  name: String!
  program: WorkOpsProgram!
  programId: UUID!
  state: WorkOpsMilestoneState!
  targetDate: DateTime
  version: Long!
}

enum WorkOpsMilestoneState {
  CLOSED
  OPEN
}

type WorkOpsMilestones {
  byProgram(programId: UUID!): [WorkOpsMilestone!]!
  milestone(id: UUID!): WorkOpsMilestone
}

type WorkOpsMilestonesMutation {
  """Advance the milestone state to CLOSED and stamp closedAt."""
  close(expectedVersion: Long!, id: UUID!): WorkOpsMilestone!
  create(input: CreateWorkOpsMilestoneInput!): WorkOpsMilestone!
}

type WorkOpsMultiRepoMutation {
  """
  Grants a group an action on the environment itself (approve/deploy gating).
  """
  addEnvironmentPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  addPipelineStage(externalUrl: String, pipelineRunId: UUID!, stageName: String!): WorkOpsPipelineStageRun!
  autoGenerateReleaseNotes(releaseId: UUID!): WorkOpsReleaseNotes!
  autoGenerateVersionReleaseNotes(releaseId: UUID!): [WorkOpsVersionReleaseNotes!]!
  completePipelineRun(expectedVersion: Long!, id: UUID!, status: String!): WorkOpsPipelineRun!
  completePipelineStage(stageId: UUID!, status: String!): WorkOpsPipelineStageRun!
  createEnvironment(input: CreateWorkOpsEnvironmentInput!): WorkOpsEnvironment!
  createEnvironmentType(description: String, displayOrder: Int, name: String!): WorkOpsEnvironmentType!
  createPipelineRun(input: CreateWorkOpsPipelineRunInput!): WorkOpsPipelineRun!
  """
  Generates a starter .bosca/deploy.yaml (one stanza per program environment, target from each environment's target type) and commits it to the repository's main branch. Never overwrites an existing file.
  """
  createProjectDeployConfig(authorEmail: String!, authorName: String!, projectId: UUID!, repositoryId: UUID!): WorkOpsDeployConfigFile!
  declareDependency(input: CreateWorkOpsDependencyDeclarationInput!): WorkOpsDependencyDeclaration!
  deleteEnvironment(id: UUID!): Boolean!
  """Fails while any environment still instantiates the type."""
  deleteEnvironmentType(id: UUID!): Boolean!
  deploy(input: WorkOpsDeployInput!): WorkOpsEnvironmentDeployment!
  editReleaseNotes(expectedVersion: Long!, releaseId: UUID!, sections: JSON!): WorkOpsReleaseNotes!
  editVersionReleaseNotes(releaseId: UUID!, variants: JSON!, versionId: UUID!): WorkOpsVersionReleaseNotes!
  generateReleaseNotes(releaseId: UUID!, sections: JSON!): WorkOpsReleaseNotes!
  markArtifactFailed(expectedVersion: Long!, id: UUID!): WorkOpsArtifactPublication!
  markArtifactPublished(expectedVersion: Long!, id: UUID!): WorkOpsArtifactPublication!
  markDeployed(deploymentId: UUID!, expectedVersion: Long!): WorkOpsEnvironmentDeployment!
  markProjectVersionDeployed(projectId: UUID!, releaseId: UUID!, versionId: UUID!): WorkOpsReleaseProjectVersion!
  markProjectVersionDeploying(projectId: UUID!, releaseId: UUID!, versionId: UUID!): WorkOpsReleaseProjectVersion!
  markProjectVersionRolledBack(projectId: UUID!, releaseId: UUID!, rollbackVersionId: UUID!, versionId: UUID!): WorkOpsReleaseProjectVersion!
  recordCompatibilityResult(input: RecordWorkOpsCompatibilityResultInput!): WorkOpsCompatibilityTestResult!
  registerApiSurfaceReport(input: RegisterWorkOpsApiSurfaceReportInput!): WorkOpsApiSurfaceReport!
  registerArtifact(input: RegisterWorkOpsArtifactInput!): WorkOpsArtifactPublication!
  removeDependency(id: UUID!): Boolean!
  removeEnvironmentPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  setDeploymentOrder(order: Int!, projectId: UUID!, releaseId: UUID!, versionId: UUID!): WorkOpsReleaseProjectVersion!
  updateDependencyStatus(expectedVersion: Long!, id: UUID!, status: String!): WorkOpsDependencyDeclaration!
  updateEnvironment(expectedVersion: Long!, id: UUID!, input: UpdateWorkOpsEnvironmentInput!): WorkOpsEnvironment!
  updateEnvironmentType(description: String, displayOrder: Int, expectedVersion: Long!, id: UUID!, name: String!): WorkOpsEnvironmentType!
  updateHealthCheck(deploymentId: UUID!, expectedVersion: Long!, status: String!): WorkOpsEnvironmentDeployment!
  updateResolvedVersion(expectedVersion: Long!, id: UUID!, status: String!, versionId: UUID): WorkOpsDependencyDeclaration!
  yankArtifact(expectedVersion: Long!, id: UUID!): WorkOpsArtifactPublication!
}

type WorkOpsMultiRepoQuery {
  apiSurfaceReports(versionId: UUID!): [WorkOpsApiSurfaceReport!]!
  artifact(id: UUID!): WorkOpsArtifactPublication
  artifacts(versionId: UUID!): [WorkOpsArtifactPublication!]!
  buildReadiness(projectId: UUID!): WorkOpsBuildReadiness!
  compatibilityResults(consumerProjectId: UUID!, consumerVersionId: UUID!): [WorkOpsCompatibilityTestResult!]!
  consumers(projectId: UUID!): [WorkOpsDependencyDeclaration!]!
  dependencies(projectId: UUID!): [WorkOpsDependencyDeclaration!]!
  dependency(id: UUID!): WorkOpsDependencyDeclaration
  """
  The release's projects that can ship to this environment's channel — store channels take only their platform artifact; generic environments take everything else.
  """
  environmentCompatibleProjects(environmentId: UUID!, releaseId: UUID!): [UUID!]!
  environmentDrift(environmentId: UUID!, releaseId: UUID!): [WorkOpsEnvironmentDrift!]!
  environmentState(environmentId: UUID!): [WorkOpsEnvironmentDeployment!]!
  """
  The global environment type catalog — what pipelines reference and environments instantiate.
  """
  environmentTypes: [WorkOpsEnvironmentType!]!
  environments(programId: UUID!): [WorkOpsEnvironment!]!
  pipelineRun(id: UUID!): WorkOpsPipelineRun
  pipelineRuns(projectId: UUID!): [WorkOpsPipelineRun!]!
  releaseNotes(releaseId: UUID!): WorkOpsReleaseNotes
  """
  Live store state plus release-scoped vitals/review history from analytics.
  """
  releaseStoreTelemetry(releaseId: UUID!): WorkOpsReleaseStoreTelemetry!
  """
  Localized, store-ready notes owned by each Version bundled in the Release.
  """
  versionReleaseNotes(releaseId: UUID!): [WorkOpsVersionReleaseNotes!]!
}

"""Single entry point for all Work Ops mutations."""
type WorkOpsMutations {
  attachments: WorkOpsAttachmentMutation!
  automation: WorkOpsAutomationMutation!
  boards: WorkOpsBoardsMutation!
  components: WorkOpsComponentsMutation!
  crossProject: WorkOpsCrossProjectMutation!
  labels: WorkOpsLabelsMutation!
  linkTypes: WorkOpsTaskLinkTypesMutation!
  links: WorkOpsTaskLinksMutation!
  milestones: WorkOpsMilestonesMutation!
  multiRepo: WorkOpsMultiRepoMutation!
  notifications: WorkOpsNotificationsMutation!
  portfolios: WorkOpsPortfoliosMutation!
  priorities: WorkOpsPrioritiesMutation!
  programs: WorkOpsProgramsMutation!
  projects: WorkOpsProjectsMutation!
  requirementComments: WorkOpsRequirementCommentsMutation!
  requirements: WorkOpsRequirementsMutation!
  resolutions: WorkOpsResolutionsMutation!
  savedFilters: WorkOpsSavedFiltersMutation!
  sla: WorkOpsSlaMutation!
  specComments: WorkOpsSpecCommentsMutation!
  specs: WorkOpsSpecsMutation!
  sprints: WorkOpsSprintsMutation!
  statuses: WorkOpsStatusesMutation!
  taskComments: WorkOpsTaskCommentsMutation!
  taskTypes: WorkOpsTaskTypesMutation!
  tasks: WorkOpsTasksMutation!
  versions: WorkOpsVersionsMutation!
  worklogs: WorkOpsWorklogMutation!
}

"""
R12 — notifications, watchers, preferences, and digest
subscriptions. The dispatcher writes IN_APP rows directly; the
remaining channels (EMAIL / WEBHOOK / SLACK) ride
`workops.notification_outbox`.
"""
type WorkOpsNotification {
  actorProfileId: UUID
  body: String!
  createdAt: DateTime!
  event: String!
  id: UUID!
  link: String
  profileId: UUID!
  projectId: UUID
  readAt: DateTime
  taskId: UUID
}

type WorkOpsNotificationPreference {
  dailyDigest: Boolean!
  dndEndLocal: String
  dndStartLocal: String
  """
  `Map<NotificationEvent, Set<NotificationChannel>>` shape.
  Empty channel set for an event means "deliver nothing". Missing
  entries fall back to the default (IN_APP and EMAIL).
  """
  eventChannels: JSON!
  mutedProjectIds: [UUID!]!
  mutedTaskIds: [UUID!]!
  profileId: UUID!
  version: Long!
  watchAuthored: Boolean!
  watchCommented: Boolean!
}

input WorkOpsNotificationPreferenceUpdateInput {
  dailyDigest: Boolean!
  dndEndLocal: String
  dndStartLocal: String
  """`Map<NotificationEvent, [NotificationChannel]>` JSON shape."""
  eventChannels: JSON!
  mutedProjectIds: [UUID!]!
  mutedTaskIds: [UUID!]!
  watchAuthored: Boolean!
  watchCommented: Boolean!
}

type WorkOpsNotificationScheme {
  description: String
  """
  `Map<NotificationEvent, List<NotificationRecipient>>` keyed by
  event-enum name. Recipients carry a discriminator `type`.
  """
  eventRecipients: JSON!
  id: UUID!
  name: String!
  version: Long!
}

type WorkOpsNotificationSubscription {
  cron: String!
  lastRunAt: DateTime
  profileId: UUID!
  savedFilterId: UUID!
  timeZone: String!
}

type WorkOpsNotificationsMutation {
  markAllRead: Boolean!
  markRead(id: UUID!): Boolean!
  subscribe(cron: String!, savedFilterId: UUID!, timeZone: String!): WorkOpsNotificationSubscription!
  unsubscribe(savedFilterId: UUID!): Boolean!
  unwatch(taskId: UUID!): Boolean!
  updatePreferences(input: WorkOpsNotificationPreferenceUpdateInput!): WorkOpsNotificationPreference!
  watch(taskId: UUID!): Boolean!
}

type WorkOpsNotificationsQuery {
  """
  The current principal's in-app inbox, newest first. Limit is
  coerced to [1, 200].
  """
  mine(limit: Int!, offset: Long!): [WorkOpsNotification!]!
  """
  The current principal's preferences. Returns null if the
  profile hasn't customized — in which case the default
  (IN_APP and EMAIL, watch own) applies.
  """
  myPreferences: WorkOpsNotificationPreference
  """Saved-filter subscriptions the principal has set up."""
  mySubscriptions: [WorkOpsNotificationSubscription!]!
  scheme(id: UUID!): WorkOpsNotificationScheme
  """Admin reads. Phase 7 keeps scheme management in the admin group."""
  schemes: [WorkOpsNotificationScheme!]!
  unread(limit: Int!, offset: Long!): [WorkOpsNotification!]!
  unreadCount: Long!
  """Watchers on a task — paged by added_at."""
  watchers(taskId: UUID!): [WorkOpsTaskWatcher!]!
}

type WorkOpsPipelineRun {
  completedAt: DateTime
  externalUrl: String
  id: UUID!
  pipelineId: String!
  pipelineName: String!
  projectId: UUID!
  stages: [WorkOpsPipelineStageRun!]!
  startedAt: DateTime!
  status: WorkOpsPipelineStatus!
  triggerRef: String
  triggerType: WorkOpsPipelineTriggerType!
  version: Long!
  versionId: UUID
}

type WorkOpsPipelineStageRun {
  completedAt: DateTime
  externalUrl: String
  id: UUID!
  pipelineRunId: UUID!
  stageName: String!
  startedAt: DateTime
  status: WorkOpsPipelineStatus!
}

enum WorkOpsPipelineStatus {
  CANCELLED
  FAILED
  PASSED
  PENDING
  RUNNING
  SKIPPED
}

enum WorkOpsPipelineTriggerType {
  MANUAL
  PR
  PUSH
  TAG
  WEBHOOK
}

"""
Top of Work Ops's three-level delivery hierarchy. A portfolio bundles
related programs and is the natural rollup boundary for OKRs (R19)
and capacity (R20).
"""
type WorkOpsPortfolio {
  """When set, the portfolio is read-only at the service layer."""
  archivedAt: DateTime
  createdAt: DateTime!
  description: String
  """Stable id for API and DataLoader use."""
  id: UUID!
  """Short uppercase code (2–10 chars), unique cluster-wide."""
  key: String!
  modifiedAt: DateTime!
  name: String!
  """Resolved owner profile."""
  owner: Profile
  """Profile id of the delivery leader who owns this portfolio."""
  ownerProfileId: UUID!
  """Per-entity permission rows. Requires MANAGE."""
  permissions: [EntityPermission!]!
  """Programs belonging to this portfolio."""
  programs(limit: Int! = 50, offset: Long! = 0): [WorkOpsProgram!]!
  """Optimistic-locking version. Required on every update."""
  version: Long!
}

"""Input shape for createPortfolio / updatePortfolio."""
input WorkOpsPortfolioInput {
  description: String
  key: String!
  name: String!
  ownerProfileId: UUID!
}

"""Query namespace for WorkOpsPortfolios."""
type WorkOpsPortfolios {
  """Paginated list of every portfolio."""
  all(limit: Int! = 50, offset: Long! = 0): [WorkOpsPortfolio!]!
  """Fetch a portfolio by id."""
  portfolio(id: UUID!): WorkOpsPortfolio
  """Fetch a portfolio by key — useful from CLIs and admin URLs."""
  portfolioByKey(key: String!): WorkOpsPortfolio
}

"""Mutation namespace for WorkOpsPortfolios."""
type WorkOpsPortfoliosMutation {
  addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  archive(expectedVersion: Long!, id: UUID!): WorkOpsPortfolio!
  create(input: WorkOpsPortfolioInput!): WorkOpsPortfolio!
  removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  unarchive(expectedVersion: Long!, id: UUID!): WorkOpsPortfolio!
  update(expectedVersion: Long!, id: UUID!, input: WorkOpsPortfolioInput!): WorkOpsPortfolio!
}

type WorkOpsPresignedUpload {
  confirmationToken: String!
  expiresAt: DateTime!
  storageObjectId: UUID!
  uploadUrl: String!
}

"""Admin CRUD for priorities (R2 reference data)."""
type WorkOpsPrioritiesMutation {
  create(input: CreateWorkOpsPriorityInput!): WorkOpsPriority!
  delete(id: UUID!): Boolean!
  update(id: UUID!, input: UpdateWorkOpsPriorityInput!): WorkOpsPriority!
}

"""Urgency / importance label attached to a task (R2)."""
type WorkOpsPriority {
  colorHex: String!
  description: String
  """
  Lower values sort first; the seeded scale runs Lowest (0) → Critical (5).
  """
  displayOrder: Int!
  iconKey: String!
  id: UUID!
  name: String!
  version: Long!
}

"""
Middle tier of the delivery hierarchy. A program belongs to exactly
one WorkOpsPortfolio and groups related projects under one delivery owner.
"""
type WorkOpsProgram {
  archivedAt: DateTime
  createdAt: DateTime!
  description: String
  id: UUID!
  """WorkOpsPortfolio-scoped uppercase code (2–10 chars)."""
  key: String!
  modifiedAt: DateTime!
  name: String!
  """Resolved owner profile."""
  owner: Profile
  """Profile id of the program owner."""
  ownerProfileId: UUID!
  """Per-entity permission rows. Requires MANAGE."""
  permissions: [EntityPermission!]!
  """Resolved WorkOpsPortfolio parent."""
  portfolio: WorkOpsPortfolio!
  """Projects belonging to this program."""
  projects(limit: Int! = 50, offset: Long! = 0): [WorkOpsProject!]!
  """Optional planned program start. Surfaces on the roadmap (R18)."""
  startDate: DateTime
  """Optional planned program end."""
  targetDate: DateTime
  version: Long!
}

input WorkOpsProgramInput {
  description: String
  key: String!
  name: String!
  ownerProfileId: UUID!
  portfolioId: UUID!
  startDate: DateTime
  targetDate: DateTime
}

type WorkOpsPrograms {
  """Every program, ordered by key."""
  all: [WorkOpsProgram!]!
  """Paginated list of every program in a portfolio."""
  byPortfolio(limit: Int! = 50, offset: Long! = 0, portfolioId: UUID!): [WorkOpsProgram!]!
  """Fetch a program by id."""
  program(id: UUID!): WorkOpsProgram
}

type WorkOpsProgramsMutation {
  addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  archive(expectedVersion: Long!, id: UUID!): WorkOpsProgram!
  create(input: WorkOpsProgramInput!): WorkOpsProgram!
  removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  unarchive(expectedVersion: Long!, id: UUID!): WorkOpsProgram!
  update(expectedVersion: Long!, id: UUID!, input: WorkOpsProgramInput!): WorkOpsProgram!
}

"""
Bottom tier of the delivery hierarchy. WorkOpsTasks live inside projects;
a project's `key` is the prefix of every task key it mints.
"""
type WorkOpsProject {
  """
  Analytics applications this project owns (the sessions.<appId> / error-group appId), for release health telemetry.
  """
  analyticsApplications: [WorkOpsProjectAnalyticsApplication!]!
  """
  Analytics services this project owns (the http.<service> name), for release health telemetry.
  """
  analyticsServices: [WorkOpsProjectAnalyticsService!]!
  archivedAt: DateTime
  createdAt: DateTime!
  """The active task-type scheme (R3) — null until Phase 2 seeds it."""
  defaultTaskTypeSchemeId: UUID
  """The active workflow scheme (R4) — null until Phase 3 lands."""
  defaultWorkflowSchemeId: UUID
  description: String
  id: UUID!
  """Globally unique uppercase code (2–10 chars). Prefix of every task key."""
  key: String!
  modifiedAt: DateTime!
  name: String!
  """Resolved owner profile."""
  owner: Profile
  """Profile id of the project owner."""
  ownerProfileId: UUID!
  """Per-entity permission rows. Requires MANAGE."""
  permissions: [EntityPermission!]!
  """Resolved WorkOpsProgram parent."""
  program: WorkOpsProgram!
  """
  Git repositories this project owns — the release relay reads them to tag/build the project.
  """
  repositories: [WorkOpsProjectRepository!]!
  """
  Form schema key used to render the task creation form for this project.
  """
  taskCreationFormSchemaKey: String!
  version: Long!
}

"""
An analytics application a project owns — the appId used in sessions.<appId> counters and error groups.
"""
type WorkOpsProjectAnalyticsApplication {
  applicationId: String!
  id: UUID!
  projectId: UUID!
}

"""
An analytics service a project owns — the service name used in http.<service> response-code counters.
"""
type WorkOpsProjectAnalyticsService {
  id: UUID!
  projectId: UUID!
  service: String!
}

input WorkOpsProjectInput {
  defaultTaskTypeSchemeId: UUID
  description: String
  key: String!
  name: String!
  ownerProfileId: UUID!
  programId: UUID!
  """Form schema key for task creation. Defaults to 'workops.create-task'."""
  taskCreationFormSchemaKey: String
}

"""
A git repository a project owns; repositoryId references a git-module Repository.
"""
type WorkOpsProjectRepository {
  id: UUID!
  projectId: UUID!
  repositoryId: UUID!
}

type WorkOpsProjects {
  """Every project, ordered by key."""
  all: [WorkOpsProject!]!
  """Paginated list of every project in a program."""
  byProgram(limit: Int! = 50, offset: Long! = 0, programId: UUID!): [WorkOpsProject!]!
  """Fetch a project by id."""
  project(id: UUID!): WorkOpsProject
  """Fetch a project by key — the form used in task keys."""
  projectByKey(key: String!): WorkOpsProject
}

type WorkOpsProjectsMutation {
  """
  Add an analytics application (appId) to a project. Idempotent. Requires MANAGE.
  """
  addAnalyticsApplication(applicationId: String!, projectId: UUID!): WorkOpsProjectAnalyticsApplication!
  """
  Add an analytics service (service name) to a project. Idempotent. Requires MANAGE.
  """
  addAnalyticsService(projectId: UUID!, service: String!): WorkOpsProjectAnalyticsService!
  addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  """
  Associate a git repository with a project. Idempotent. Requires MANAGE.
  """
  addProjectRepository(projectId: UUID!, repositoryId: UUID!): WorkOpsProjectRepository!
  archive(expectedVersion: Long!, id: UUID!): WorkOpsProject!
  create(input: WorkOpsProjectInput!): WorkOpsProject!
  """
  Move a project to another program. Requires MANAGE on the project and destination program.
  """
  move(expectedVersion: Long!, id: UUID!, programId: UUID!): WorkOpsProject!
  """
  Remove one of a project's analytics applications by id. Requires MANAGE.
  """
  removeAnalyticsApplication(id: UUID!, projectId: UUID!): Boolean!
  """Remove one of a project's analytics services by id. Requires MANAGE."""
  removeAnalyticsService(id: UUID!, projectId: UUID!): Boolean!
  removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  """
  Remove one of a project's associated repositories by id. Requires MANAGE.
  """
  removeProjectRepository(id: UUID!, projectId: UUID!): Boolean!
  unarchive(expectedVersion: Long!, id: UUID!): WorkOpsProject!
  update(expectedVersion: Long!, id: UUID!, input: WorkOpsProjectInput!): WorkOpsProject!
}

enum WorkOpsPublicationStatus {
  FAILED
  PENDING
  PUBLISHED
  YANKED
}

"""
R26 — program-scoped WorkOpsRelease bundles. Phase 16 introduces both
the bundle row and the `release_component_version` join.
"""
type WorkOpsRelease {
  description: String
  """
  The release's live view of which artifact/version is deployed in which environment (stamped by the relay's Deploy/Promote nodes).
  """
  environmentDeployments: [WorkOpsEnvironmentDeployment!]!
  id: UUID!
  name: String!
  ownerProfileId: UUID
  programId: UUID!
  releaseDate: DateTime
  releasedAt: DateTime
  version: Long!
}

"""
Exact action capabilities used to disable release controls before a forbidden request is sent.
"""
type WorkOpsReleaseActionAccess {
  canManage: Boolean!
  environments: [WorkOpsReleaseEnvironmentAccess!]!
  repositories: [WorkOpsReleaseRepositoryAccess!]!
}

"""
One native git-ci RELEASE or PROMOTION run correlated to a specific WorkOps release.
"""
type WorkOpsReleaseDeclaredArtifact {
  coordinate: String!
  environments: [String!]!
  namespace: String!
  projectId: UUID!
  type: WorkOpsArtifactType!
}

type WorkOpsReleaseEnvironmentAccess {
  canExecute: Boolean!
  key: String!
}

type WorkOpsReleaseNotes {
  generatedAt: DateTime!
  id: UUID!
  manuallyEdited: Boolean!
  releaseId: UUID!
  sections: JSON!
  version: Long!
}

type WorkOpsReleasePipelineInput {
  defaultValue: String
  description: String
  name: String!
  options: [String!]!
  required: Boolean!
  type: String!
}

"""
The exact native git-ci job plan selected from repository YAML without creating a run.
"""
type WorkOpsReleasePipelinePlan {
  environment: String
  inputs: [WorkOpsReleasePipelineInput!]!
  jobs: [WorkOpsReleasePipelinePlanJob!]!
  pipelineId: UUID!
  pipelineName: String!
  promotesFrom: String
  repositoryId: UUID!
  repositorySlug: String!
  """RELEASE or PROMOTION."""
  triggerType: String!
}

type WorkOpsReleasePipelinePlanJob {
  approvalRequired: Boolean!
  """
  Topological column: zero has no selected dependencies; larger values run later.
  """
  depth: Int!
  environment: String
  key: String!
  needs: [String!]!
  requirements: [String!]!
  steps: [WorkOpsReleasePipelinePlanStep!]!
}

type WorkOpsReleasePipelinePlanStep {
  """Built-in action name, or run for a repository-owned shell step."""
  action: String!
  name: String!
}

type WorkOpsReleaseProjectVersion {
  deployedAt: DateTime
  deployedByPrincipalId: UUID
  deploymentOrder: Int
  deploymentStatus: String!
  """
  The resolved project (name/key) — so clients render a name, not the projectId UUID.
  """
  project: WorkOpsProject
  projectId: UUID!
  releaseId: UUID!
  rollbackVersionId: UUID
  """
  The resolved version (name) — so clients render a name, not the versionId UUID.
  """
  version: WorkOpsVersion
  versionId: UUID!
}

type WorkOpsReleaseRepositoryAccess {
  canEdit: Boolean!
  repositoryId: UUID!
}

type WorkOpsReleaseRun {
  """Wall-clock duration in ms once finished, or null while in-flight."""
  durationMs: Int
  """When the run reached a terminal status, or null while in-flight."""
  finishedAt: DateTime
  runId: UUID!
  startedAt: DateTime!
  """Run status: QUEUED, RUNNING, SUCCESS, FAILURE, CANCELLED, or SKIPPED."""
  status: String!
}

type WorkOpsReleaseStoreCrashFeedback {
  comment: String
  createdAt: String
  deviceModel: String
  email: String
  id: String!
  osVersion: String
}

type WorkOpsReleaseStoreObservation {
  appVersion: String!
  applicationId: String!
  observedAt: DateTime!
  payload: JSON!
  store: String!
  telemetryType: String!
}

type WorkOpsReleaseStoreState {
  appVersion: String!
  applicationId: String!
  betaReviewState: String
  buildNumber: String
  buildProcessingState: String
  environmentId: UUID!
  environmentKey: String!
  phasedReleaseState: String
  projectId: UUID!
  releaseState: String
  reviewState: String
  rolloutPercentage: Float
  store: String!
  testFlightCrashFeedback: [WorkOpsReleaseStoreCrashFeedback!]!
  testFlightGroups: [String!]!
  track: String
  versionId: UUID!
}

type WorkOpsReleaseStoreTelemetry {
  """Historical observations emitted by scheduled pipelines into analytics."""
  observations: [WorkOpsReleaseStoreObservation!]!
  """Live vendor state, fetched on demand and never stored in WorkOps."""
  states: [WorkOpsReleaseStoreState!]!
}

type WorkOpsRequirement {
  assignee: Profile
  assigneeProfileId: UUID
  createdAt: DateTime!
  createdByPrincipalId: UUID!
  deletedAt: DateTime
  history(limit: Int! = 50, offset: Long! = 0): [WorkOpsRequirementHistoryEntry!]!
  id: UUID!
  key: String!
  labelIds: [UUID!]!
  metadataId: UUID!
  modifiedAt: DateTime!
  modifiedByPrincipalId: UUID!
  parentId: UUID!
  parentType: WorkOpsRequirementParent!
  priority: WorkOpsPriority!
  sortOrder: Int!
  status: WorkOpsStatus!
  """The linked task that manages this requirement's lifecycle state."""
  task: WorkOpsTask
  taskId: UUID
  version: Long!
}

