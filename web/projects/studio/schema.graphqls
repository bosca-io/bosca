  created: DateTime!
  """The unique identifier of the device."""
  id: UUID!
  """
  The Analytics-issued installation identifier, or null only for legacy records.
  """
  installationId: String
  """When the device last checked in with the server."""
  lastCheckIn: DateTime!
  """When the device registration was last modified."""
  modified: DateTime!
  """The platform type of the device."""
  platform: PlatformType!
  """Push notification tokens registered on this device."""
  pushTokens: [PushToken!]!
}

"""Input for registering a new device."""
input DeviceInput {
  """
  The installation identifier issued by the Analytics installation endpoint.
  """
  installationId: String!
  """The platform type of the device."""
  platform: PlatformType!
}

"""Query operations for retrieving device registrations."""
type Devices {
  """
  Retrieve all devices for a principal. Defaults to the authenticated principal.
  """
  devices(
    """
    The UUID of the principal whose devices to retrieve. Defaults to the current user.
    """
    principalId: UUID
  ): [Device!]!
  """Retrieve a single device by its identifier."""
  getById(
    """The UUID of the device to retrieve."""
    id: UUID!
  ): Device
}

"""Mutation operations for managing device registrations and push tokens."""
type DevicesMutation {
  """Register a push notification token on a device."""
  addPushToken(
    """The UUID of the device."""
    id: UUID!
    """The service that issued the token. Defaults to FCM for older clients."""
    provider: PushProvider! = FCM
    """The push token string from the device's notification service."""
    token: String!
  ): Boolean!
  """Record a check-in for a device, updating its last activity timestamp."""
  checkIn(
    """The UUID of the device to check in."""
    id: UUID!
  ): Device!
  """
  Record activity for an Analytics installation, including while it is signed out.
  """
  checkInInstallation(
    """The Analytics-issued installation identifier."""
    installationId: String!
  ): Boolean!
  """
  Clear the authenticated principal association without deleting the device or its push tokens.
  """
  clearPrincipal(
    """The UUID of the device whose principal association should be cleared."""
    id: UUID!
  ): Boolean!
  """Delete a device and all of its associated push tokens."""
  delete(
    """The UUID of the device to delete."""
    id: UUID!
  ): Boolean!
  """Register a new device for the authenticated principal."""
  register(
    """The device specification."""
    device: DeviceInput!
  ): Device!
  """Remove a push notification token from a device."""
  removePushToken(
    """The UUID of the device."""
    id: UUID!
    """The service that issued the token. Defaults to FCM for older clients."""
    provider: PushProvider! = FCM
    """The push token string to remove."""
    token: String!
  ): Boolean!
}

"""
Rich text document content associated with a metadata item, structured as a JSON document tree (e.g. ProseMirror/TipTap format)
"""
type Document {
  """
  JSON document tree representing the rich text content (e.g. ProseMirror/TipTap node structure).  This data is wrapped in a Content element (ex: { "document": ... }).
  """
  content: JSON!
  """
  The template that defines the schema, containers, and editing configuration for this document, if one is assigned
  """
  template: Metadata
  """Display title of the document"""
  title: String!
}

"""
Real-time collaboration state for document content, used for concurrent editing support
"""
type DocumentCollaboration {
  """
  Binary collaboration document content encoded as an array of byte values (e.g. Yjs or CRDT state)
  """
  content: [Int!]!
  """Timestamp when the collaboration state was first created"""
  created: DateTime!
  """Timestamp when the collaboration state was last modified"""
  modified: DateTime!
}

"""
Input for creating or updating a document metadata item with rich text content
"""
input DocumentInput {
  """JSON document tree representing the rich text content"""
  content: JSON!
  """ID of the template metadata item to use for this document"""
  templateMetadataId: UUID
  """Version of the template metadata item"""
  templateMetadataVersion: Int
  """Display title of the document"""
  title: String!
}

"""
A template that defines the schema, containers, tools, and default content for document metadata items
"""
type DocumentTemplate {
  """
  Attribute definitions specifying the fields available on documents using this template
  """
  attributes: [TemplateAttribute!]!
  """Template-specific configuration (e.g. editor settings, feature flags)"""
  configuration: JSON
  """
  Content containers that define the editable regions within the document
  """
  containers: [DocumentTemplateContainer!]!
  """
  Default JSON document tree content applied when creating new documents from this template
  """
  content: JSON!
  """
  Default attribute values applied when creating new documents from this template
  """
  defaultAttributes: JSON
  """The metadata item that represents this template"""
  metadata: Metadata
  """JSON schema used to validate document content structure"""
  schema: JSON
}

"""
A named container within a document template that defines an editable content region with its own tools, workflows, and rendering configuration
"""
type DocumentTemplateContainer {
  """Human-readable description of the container's purpose"""
  description: String!
  """Content type filters restricting what can be placed in this container"""
  filters: [String!]
  """Unique identifier for this container within the template"""
  id: String!
  """
  Display name of the container (e.g. 'Main Content', 'Sidebar', 'Scripture Reference')
  """
  name: String!
  """
  Custom renderers available for displaying content within this container
  """
  renderers: [ContainerRenderer!]
  """
  Key linking this container to a supplementary content item, enabling content from external sources
  """
  supplementaryKey: String
  """AI and automation tools available within this container"""
  tools: [TemplateTool!]
  """The content source type for this container"""
  type: DocumentTemplateContainerType!
  """Workflows that can be triggered from this container"""
  workflows: [TemplateWorkflow!]!
}

"""Input for defining a content container within a document template"""
input DocumentTemplateContainerInput {
  """The content source type for this container"""
  containerType: DocumentTemplateContainerType
  """Human-readable description of the container's purpose"""
  description: String!
  """Content type filters restricting what can be placed in this container"""
  filters: [String!]
  """Unique identifier for this container within the template"""
  id: String!
  """Display name of the container"""
  name: String!
  """Custom renderers available for this container"""
  renderers: [ContainerRendererInput!]
  """Key linking this container to a supplementary content item"""
  supplementaryKey: String
  """AI and automation tools available within this container"""
  tools: [TemplateToolInput!]
  """Workflows that can be triggered from this container"""
  workflows: [TemplateWorkflowInput!]!
}

"""
The content source type for a document template container, determining what kind of content it holds
"""
enum DocumentTemplateContainerType {
  """Container sourcing content from Bible scripture data"""
  BIBLE
  """
  Container sourcing content from another metadata item's attributes or content
  """
  METADATA
  """Standard rich text content container"""
  STANDARD
}

"""
Input for creating or updating a document template, defining its schema, containers, and defaults
"""
input DocumentTemplateInput {
  """
  Attribute definitions specifying the fields available on documents using this template
  """
  attributes: [TemplateAttributeInput!]!
  """Template-specific configuration (e.g. editor settings, feature flags)"""
  configuration: JSON
  """Content containers defining the editable regions within the document"""
  containers: [DocumentTemplateContainerInput!]
  """Default JSON document tree content applied when creating new documents"""
  content: JSON!
  """
  Default attribute values applied when creating new documents from this template
  """
  defaultAttributes: JSON
  """JSON schema used to validate document content structure"""
  schema: JSON
}

"""
Mutation operations for managing a document template's attributes, containers, configuration, and content
"""
type DocumentTemplateMutation {
  """
  Add a new attribute definition to the document template at the specified sort position
  """
  addAttribute(attribute: TemplateAttributeInput!, sort: Int!): Metadata
  """
  Add a new container to the document template at the specified sort position
  """
  addContainer(container: DocumentTemplateContainerInput!, sort: Int!): Metadata
  """Delete an attribute definition from the document template by key"""
  deleteAttribute(key: String!): Metadata
  """Delete a container from the document template by container ID"""
  deleteContainer(containerId: String!): Metadata
  """Replace all attribute definitions on the document template"""
  setAttributes(attributes: [TemplateAttributeInput!]!): Metadata
  """Set the template-specific configuration"""
  setConfiguration(configuration: JSON!): Metadata
  """Replace all containers on the document template"""
  setContainers(containers: [DocumentTemplateContainerInput!]!): Metadata
  """Set the default document content structure"""
  setContent(content: JSON!): Metadata
  """
  Set the default attribute values applied to new documents using this template
  """
  setDefaultAttributes(attributes: JSON!): Metadata
  """Set the JSON schema used to validate document content"""
  setSchema(schema: JSON!): Metadata
}

"""Query type for listing all available document templates"""
type DocumentTemplates {
  """All document templates available in the system"""
  all: [DocumentTemplate!]!
}

"""
A set of distinct principals that share the same verified email address (duplicate accounts).
"""
type DuplicatedAccountIds {
  """The shared verified email address."""
  email: String!
  """The distinct principals that own this email."""
  principals: [Principal!]!
}

"""
The ecommerce query namespace. All commerce reads live here — nothing is added to the global Query
root. Each domain area contributes its read fields to this type.
"""
type Ecom {
  """A billing account by id."""
  account(id: UUID!): Account
  """A page of a company's billing accounts, newest first. Admin."""
  accounts(companyId: UUID!, limit: Int! = 50, offset: Int! = 0): [Account!]!
  """
  The audit log, newest first. Every filter is optional (omit to match all). The log has no company
  column — scope by storeId (store-bound entries) and/or entityType/entityId. Admin (snapshots may
  contain PII).
  """
  audit(action: String = null, entityId: UUID = null, entityType: String = null, limit: Int! = 50, offset: Int! = 0, storeId: UUID = null): [EcomAudit!]!
  """
  A cart by id. Readable only by its owner (customer) or an ecom administrator.
  """
  cart(id: UUID!): Cart
  """A store's carts, newest first. Admin."""
  carts(limit: Int! = 50, offset: Int! = 0, storeId: UUID!): [Cart!]!
  """
  A store's carts filtered to those with a given status flag set, newest first. Admin.
  """
  cartsByStatus(limit: Int! = 50, offset: Int! = 0, status: CartStatusFlag!, storeId: UUID!): [Cart!]!
  """A catalog by id."""
  catalog(id: UUID!): Catalog
  """A catalog by its per-company business key."""
  catalogByKey(companyId: UUID!, key: String!): Catalog
  """A sellable catalog entry by id."""
  catalogProduct(id: UUID!): CatalogProduct
  """
  The primary storefront read path: a catalog's sellable entries, optionally filtered by product
  type. activeOnly limits to entries whose availability window (starts <= now < ends) is open.
  """
  catalogProducts(activeOnly: Boolean! = true, catalogId: UUID!, limit: Int! = 25, offset: Int! = 0, type: ProductType = null): [CatalogProduct!]!
  """Catalogs belonging to a company."""
  catalogs(companyId: UUID!): [Catalog!]!
  """All companies, paged. Admin surface."""
  companies(limit: Int! = 25, offset: Int! = 0): [Company!]!
  """A company (seller/tenant) by id."""
  company(id: UUID!): Company
  """A shipping container (box type) by id. Admin."""
  container(id: UUID!): EcomContainer
  """
  A company's shipping containers (the box catalog the packer fills). Admin.
  """
  containers(companyId: UUID!): [EcomContainer!]!
  """A customer by id."""
  customer(id: UUID!): Customer
  """A page of a company's customers, newest first. Admin (PII)."""
  customers(companyId: UUID!, limit: Int! = 50, offset: Int! = 0): [Customer!]!
  """
  A single return by id. Admin. (Named ecomReturn — `return` is reserved.)
  """
  ecomReturn(id: UUID!): EcomReturn
  """A fulfillment center by id. Admin."""
  fulfillmentCenter(id: UUID!): FulfillmentCenter
  """A company's fulfillment centers. Admin."""
  fulfillmentCenters(companyId: UUID!): [FulfillmentCenter!]!
  """Inventory rows for a product across fulfillment centers. Admin."""
  inventory(productId: UUID!): [Inventory!]!
  """A manufacturer by id."""
  manufacturer(id: UUID!): Manufacturer
  """Manufacturers belonging to a company, paged."""
  manufacturers(companyId: UUID!, limit: Int! = 25, offset: Int! = 0): [Manufacturer!]!
  """
  The caller's customer record in a company, resolved principal -> profile -> customer.
  """
  myCustomer(companyId: UUID!): Customer
  """Orders (paid carts) for a store, newest first. Admin."""
  orders(limit: Int! = 50, offset: Int! = 0, storeId: UUID!): [Cart!]!
  """A payment by id. Admin."""
  payment(id: UUID!): Payment
  """
  Registered payment provider implementation keys (valid ProviderInput.providerKey values). Admin.
  """
  paymentProviderKeys: [String!]!
  """
  A company's payment providers (each row's secret-bearing configuration stays admin-gated).
  """
  paymentProviders(companyId: UUID!): [PaymentProvider!]!
  """An account's payments (charges/refunds/voids), newest first. Admin."""
  payments(accountId: UUID!, limit: Int! = 50, offset: Int! = 0): [Payment!]!
  """A subscription plan by id. Admin."""
  plan(id: UUID!): SubscriptionPlan
  """A subscription plan group by id. Admin."""
  planGroup(id: UUID!): SubscriptionPlanGroup
  """A store's subscription plan groups. Admin."""
  planGroups(storeId: UUID!): [SubscriptionPlanGroup!]!
  """Every plan within a plan group. Admin."""
  plans(planGroupId: UUID!): [SubscriptionPlan!]!
  """A product by id."""
  product(id: UUID!): Product
  """
  Products belonging to a company, paged. Admin/catalog-management surface.
  """
  products(companyId: UUID!, limit: Int! = 25, offset: Int! = 0): [Product!]!
  """A promotion by id. Admin."""
  promotion(id: UUID!): Promotion
  """A page of a store's promotions, newest first. Admin."""
  promotions(limit: Int! = 50, offset: Int! = 0, storeId: UUID!): [Promotion!]!
  """A store's returns/RMAs, newest first. status null = all states. Admin."""
  returns(limit: Int! = 50, offset: Int! = 0, status: ReturnStatus, storeId: UUID!): [EcomReturn!]!
  """The returns against an order (cart), newest first. Admin."""
  returnsByCart(cartId: UUID!): [EcomReturn!]!
  """A single shipment by id. Admin."""
  shipment(id: UUID!): EcomShipment
  """The shipments fulfilling an order (cart). Admin."""
  shipments(cartId: UUID!): [EcomShipment!]!
  """
  A store's shipments, newest first — the fulfillment monitoring view. status null = all states. Admin.
  """
  shipmentsByStore(limit: Int! = 50, offset: Int! = 0, status: ShipmentStatus, storeId: UUID!): [EcomShipment!]!
  """
  Registered shipping provider implementation keys (valid ShippingProviderInput.providerKey values). Admin.
  """
  shippingProviderKeys: [String!]!
  """
  A company's shipping providers (configuration admin-gated, as with payments).
  """
  shippingProviders(companyId: UUID!): [ShippingProvider!]!
  """
  Shipping rate options for a cart (owner or admin). Quotes the company's shipping providers.
  """
  shippingRates(cartId: UUID!): [ShippingRate!]!
  """A store by id."""
  store(id: UUID!): Store
  """A store by its unique storefront identifier (slug)."""
  storeByIdentifier(identifier: String!): Store
  """Every store belonging to a company, ordered by name."""
  stores(companyId: UUID!): [Store!]!
  """A subscription by id. Admin."""
  subscription(id: UUID!): EcomSubscription
  """An account's subscriptions, newest first. Admin."""
  subscriptions(accountId: UUID!, limit: Int! = 50, offset: Int! = 0): [EcomSubscription!]!
}

"""
One entry in the append-only `ecom.audit` log: a structured (entityType, entityId, action) record
with actor attribution and before/after entity snapshots.
"""
type EcomAudit {
  action: String!
  """Entity snapshot after the change (null on delete)."""
  after: JSON
  """Entity snapshot before the change (null on create)."""
  before: JSON
  created: DateTime!
  """Optional context for action-only entries."""
  details: JSON
  entityId: UUID!
  entityType: String!
  id: UUID!
  """Acting principal, if attributed."""
  principalId: UUID
  """Acting profile, if attributed."""
  profileId: UUID
  """Store scope, for store-bound entries."""
  storeId: UUID
}

"""
A box type a company packs shipments into: outer dimensions + tare weight, and the inner capacity
(maximum packable dimensions + payload weight) the packer honors. Units are the company's own
consistent choice.
"""
type EcomContainer {
  companyId: UUID!
  created: DateTime!
  height: Float!
  id: UUID!
  length: Float!
  modified: DateTime!
  name: String!
  supportedHeight: Float!
  supportedLength: Float!
  """Maximum payload weight the container can carry."""
  supportedWeight: Float!
  """Inner capacity — maximum packable width."""
  supportedWidth: Float!
  """Tare (empty) weight of the container itself."""
  weight: Float!
  width: Float!
}

"""
The ecommerce mutation namespace, grouped per entity collection. Each collection namespace holds its
creates plus an id-scoped instance namespace (e.g. companies { add }, companies { company(id) { … } }).
"""
type EcomMutation {
  """Billing-account creates and per-account operations."""
  accounts: AccountsMutation!
  """Cart creation and per-cart operations."""
  carts: CartsMutation!
  """Catalog-entry creates and per-entry operations. Admin."""
  catalogProducts: CatalogProductsMutation!
  """Catalog creates and per-catalog operations. Admin."""
  catalogs: CatalogsMutation!
  """Company creates and per-company operations."""
  companies: CompaniesMutation!
  """Shipping-container (box catalog) administration. Admin."""
  containers: ContainersMutation!
  """Customer creates and per-customer operations."""
  customers: CustomersMutation!
  """Fulfillment-center and inventory administration. Admin."""
  fulfillment: FulfillmentMutation!
  """In-app-purchase redemption. Ecom administrator only."""
  iap: IapMutation!
  """Manufacturer creates. Admin."""
  manufacturers: ManufacturersMutation!
  """Payment administration (refund/void). Admin."""
  payments: PaymentsMutation!
  """Subscription plan group + plan administration. Admin."""
  plans: PlansMutation!
  """Product creates and per-product operations. Admin."""
  products: ProductsMutation!
  """Promotion administration. Admin."""
  promotions: PromotionsMutation!
  """Payment/shipping provider registration. Admin."""
  providers: ProvidersMutation!
  """Return / RMA operations."""
  returns: ReturnsMutation!
  """Store creates and per-store operations. Admin."""
  stores: StoresMutation!
  """Direct subscribe + per-subscription operations. Admin."""
  subscriptions: SubscriptionsMutation!
}

"""A return/RMA against a paid order (the cart is the order)."""
type EcomReturn {
  """The order (cart) this return is against."""
  cartId: UUID!
  """A check number when the refund tender is CHECK."""
  checkNumber: String
  companyId: UUID!
  created: DateTime!
  id: UUID!
  """The order lines (and quantities) being returned."""
  lines: [EcomReturnLine!]!
  modified: DateTime!
  """Why the buyer is returning; on rejection, the admin's reason."""
  reason: String
  """The amount refunded once REFUNDED (zero before that)."""
  refundedAmount: Money!
  status: ReturnStatus!
  storeId: UUID!
  """How the refund is issued once REFUNDED."""
  tender: RefundTender!
}

"""One returned order line: the cart item + quantity coming back."""
type EcomReturnLine {
  catalogProductId: UUID!
  itemId: UUID!
  quantity: Int!
}

"""
A per-fulfillment-center physical-fulfillment unit of a paid order (the cart is the order). Created
when the order is paid (its physical lines split per center) and shipped by an operator or a connector.
"""
type EcomShipment {
  """Carrier the shipment went out with, once shipped."""
  carrier: String
  """
  The carrier's own latest status wording (raw), set by tracking updates.
  """
  carrierStatus: String
  """The order (cart) this shipment fulfills."""
  cartId: UUID!
  companyId: UUID!
  created: DateTime!
  """When the carrier reported delivery, if it has."""
  delivered: DateTime
  fulfillmentCenter: FulfillmentCenter!
  """The fulfillment center this shipment dispatches from."""
  fulfillmentCenterId: UUID!
  id: UUID!
  """URL to the carrier label, when a real carrier produced one."""
  labelUrl: String
  modified: DateTime!
  """The boxes this shipment carries — each a packed container + its SKUs."""
  parcels: [EcomShipmentParcel!]!
  """When the shipment was dispatched."""
  shipped: DateTime
  status: ShipmentStatus!
  storeId: UUID!
  """Carrier tracking number, once shipped."""
  tracking: String
  """
  Items that fit no container (status UNABLE_TO_PACKAGE) — resolve by adding a fitting container, then re-pack.
  """
  unpacked: [EcomShipmentLine!]!
}

"""One SKU + quantity within a parcel."""
type EcomShipmentLine {
  catalogProductId: UUID!
  quantity: Int!
  sku: String!
}

"""
One packed box within a shipment: its container (box type) and the SKUs inside it.
"""
type EcomShipmentParcel {
  """
  The container (box type) this parcel was packed into; null = a loose box.
  """
  containerId: UUID
  lines: [EcomShipmentLine!]!
}

"""A recurring purchase. Price/interval are snapshotted at signup."""
type EcomSubscription {
  """The originating cart, when subscribed via checkout."""
  cartId: UUID
  created: DateTime!
  """ISO-4217 currency of this subscription's price (the store's)."""
  currency: String!
  expires: DateTime
  id: UUID!
  interval: Int!
  intervalUnit: IntervalUnit!
  modified: DateTime!
  paymentFailures: Int!
  plan: SubscriptionPlan!
  price: Money!
  renewals: Int!
  """Next billing instant."""
  renews: DateTime!
  status: SubscriptionStatus!
}

"""
A rendered email template preview: the resolved reference, the artifact version that
rendered, and every authored detail — subject, browser-viewable HTML (bml-inline images as
data: URIs), and the plain-text alternative.
"""
type EmailPreview {
  html: String!
  project: String!
  subject: String!
  templateKey: String!
  text: String!
  """
  The published artifact version that rendered (pin / override / active).
  """
  version: String!
}

type EmptyAccountExtras {
  type: String!
}

"""No line configuration."""
type EmptyCartItemConfiguration {
  type: String!
}

"""No extension data."""
type EmptyCatalogProductExtras {
  type: String!
}

type EmptyCustomerExtras {
  type: String!
}

type EmptyManufacturerExtras {
  type: String!
}

"""No configured settings."""
type EmptyProviderConfiguration {
  type: String!
}

"""Result of provisioning the recommendation-engine A/B test scaffold."""
type EngineExperimentProvisioning {
  """True if the scaffold was newly created; false if it already existed."""
  created: Boolean!
  """
  The experiment id — open it in the experiments UI to review and start the test.
  """
  experimentId: UUID!
  """The feature flag key driving the ML-vs-heuristic split."""
  flagKey: String!
}

"""A permission granted to a security group on a specific entity"""
type EntityPermission {
  """The permitted action on the entity (e.g. VIEW, EDIT, DELETE)"""
  action: PermissionAction!
  """The security group that holds this permission"""
  group: Group!
  """ID of the security group that holds this permission"""
  groupId: UUID!
}

"""
Aggregated state for a class of errors that share a fingerprint. One row exists per fingerprint per app and accumulates as error events flow through the analytics pipeline.
"""
type ErrorGroup {
  """
  Cached AI-generated root-cause analysis, populated on demand via the analyze mutation
  """
  aiSummary: String
  """When the cached AI summary was last refreshed"""
  aiSummaryAt: DateTime
  """Application identifier the error originated from"""
  appId: String!
  """
  Identifier of the operator who currently owns triage of this group, if any
  """
  assigneeId: UUID
  """Row creation timestamp"""
  created: DateTime!
  """Total number of error events seen for this fingerprint"""
  eventCount: Long!
  """True when the latest occurrence in the group reported itself as fatal"""
  fatal: Boolean!
  """
  Stable per-(app, error class, top stack frames) identifier assigned by the server-side fingerprint transform
  """
  fingerprint: String!
  """Earliest occurrence of this fingerprint observed across all batches"""
  firstSeen: DateTime!
  """Most recent occurrence of this fingerprint observed across all batches"""
  lastSeen: DateTime!
  """
  Latest representative message captured for this group; refreshed only when a resolved group regresses
  """
  message: String!
  """Row last-modified timestamp"""
  modified: DateTime!
  """
  Client identifier of a representative event for the latest sample (refreshed on regression)
  """
  sampleEventId: String
  """Stack trace captured from the latest representative event"""
  sampleStack: String
  """
  Lifecycle status — open is the default, resolved hides until regression, ignored hides permanently
  """
  status: ErrorGroupStatus!
  """
  Fully-qualified exception class name (or 'UnknownError' when not provided)
  """
  type: String!
}

"""A page of error groups along with the total matching count."""
type ErrorGroupConnection {
  """The error groups in the current page"""
  edges: [ErrorGroup!]!
  """Total number of groups matching the filter (across all pages)"""
  total: Long!
}

"""Filter input for narrowing the error group list view."""
input ErrorGroupFilter {
  """Restrict to a single application identifier"""
  appId: String
  """Restrict to fatal-only or non-fatal-only groups"""
  fatal: Boolean
  """Substring match against the group type or message (case-insensitive)"""
  search: String
  """Restrict by lifecycle status"""
  status: ErrorGroupStatus
}

"""Lifecycle state of an ErrorGroup."""
enum ErrorGroupStatus {
  """Group is muted permanently and excluded from default views and counts"""
  IGNORED
  """Group is currently active and visible in default views"""
  OPEN
  """
  Group has been triaged and resolved; will flip back to OPEN if a new occurrence arrives
  """
  RESOLVED
}

"""A link between a calendar event and a metadata item or collection."""
type EventAttachment {
  """The linked collection, if this is a collection attachment."""
  collectionId: UUID
  """When this attachment was linked."""
  created: DateTime!
  """The event this attachment belongs to."""
  eventId: UUID!
  """Unique identifier of this attachment link."""
  id: UUID!
  """The linked metadata item, if this is a metadata attachment."""
  metadataId: UUID
  """The relationship label (e.g. attachment, agenda, minutes)."""
  relationship: String!
}

"""Input for linking a metadata item or collection to a calendar event."""
input EventAttachmentInput {
  """The collection to link. Mutually exclusive with metadataId."""
  collectionId: UUID
  """The event to attach to."""
  eventId: UUID!
  """The metadata item to link. Mutually exclusive with collectionId."""
  metadataId: UUID
  """The relationship label."""
  relationship: String
}

"""
Read access to the platform Event Catalog — every @JobEvent available to triggers and automation rules.
"""
type EventCatalog {
  """The descriptor for a specific event fqdn, or null if not catalogued."""
  event(fqdn: String!): EventDescriptor
  """All catalogued events across loaded modules, ordered by fqdn."""
  events: [EventDescriptor!]!
}

"""
A catalogued platform event (@JobEvent) that triggers and automation rules can react to.
"""
type EventDescriptor {
  """Short explanation of when the event fires."""
  description: String!
  """
  Human-friendly event name for pickers; falls back to the event's simple class name.
  """
  displayName: String!
  """The filterable fields on the event payload."""
  fields: [EventField!]!
  """
  Fully-qualified event identifier (package.SimpleName); the key stored on trigger bindings and automation rules.
  """
  fqdn: String!
  """Simple names of the jobs enqueued when the event is dispatched."""
  jobNames: [String!]!
  """
  The pub/sub channel the event publishes to, or null if it does not publish.
  """
  pubsubChannel: String
}

"""
A filterable field on an event payload, used to build trigger filters and automation conditions.
"""
type EventField {
  """The field name as it appears in the serialized event payload."""
  name: String!
  """
  A coarse, UI-friendly type label (e.g. 'String', 'Long', 'Boolean'); a trailing '?' marks a nullable field.
  """
  type: String!
}

"""
A concrete instance of an event in a date range, ready to render. Combines
the underlying [event] row with the resolved start/end for this specific
occurrence.
"""
type EventOccurrence {
  """Actual end of this instance."""
  endsAt: DateTime!
  """
  The stored row this occurrence came from (master, single, or override).
  """
  event: CalendarEvent!
  """
  True when this row is an override and not a passive expansion of the master.
  """
  isException: Boolean!
  """
  True when the underlying row is a recurring master (or an override of one).
  """
  isRecurring: Boolean!
  """
  Master-defined start time this instance corresponds to. Null on non-recurring singles.
  """
  recurrenceId: DateTime
  """Actual start of this instance."""
  startsAt: DateTime!
}

"""A profile's participation in a calendar event."""
type EventParticipant {
  """When this participant was added."""
  created: DateTime!
  """The event this participant belongs to."""
  eventId: UUID!
  """The participating profile."""
  profileId: UUID!
  """Participant role (organizer, attendee, etc.)."""
  role: String!
  """RSVP status (needs-action, accepted, declined, tentative)."""
  status: String!
}

"""Input for adding or updating a participant on a calendar event."""
input EventParticipantInput {
  """The event to add the participant to."""
  eventId: UUID!
  """The profile to add."""
  profileId: UUID!
  """Participant role."""
  role: String
  """RSVP status."""
  status: String
}

"""
GraphQL-facing enum for analytics event types. Mirrors the wire-format
`bosca.analytics.model.EventType` enum (which uses lowercase `@SerialName`
for the SDK protocol) and gets mapped at the experimentation service
boundary so the wire-format enum can stay strict while the GraphQL schema
follows graphql-java's PascalCase enum coercion convention.
"""
enum EventType {
  Assignment
  Completion
  Error
  Impression
  Installation
  Interaction
  Session
}

"""Event-related query operations."""
type Events {
  """
  The platform Event Catalog of @JobEvents available to triggers and automation rules.
  """
  catalog: EventCatalog!
}

"""A mutual exclusion layer preventing conflicting experiment enrollment."""
type ExclusionLayer {
  created: DateTime!
  description: String!
  """
  Experiments attached to this layer, ordered by creation date descending. Defaults to first 100.
  """
  experiments(limit: Int! = 100, offset: Long! = 0): [Experiment!]!
  id: UUID!
  name: String!
}

"""Input for creating or updating a mutual exclusion layer."""
input ExclusionLayerInput {
  description: String
  name: String!
}

"""Query operations for exclusion layers."""
type ExclusionLayers {
  all: [ExclusionLayer!]!
  layer(id: UUID!): ExclusionLayer
}

"""Mutation operations for managing exclusion layers."""
type ExclusionLayersMutation {
  add(layer: ExclusionLayerInput!): ExclusionLayer!
  delete(id: UUID!): Boolean!
  edit(id: UUID!, layer: ExclusionLayerInput!): ExclusionLayer!
}

"""The current execution status of a scheduled job run."""
enum ExecutionStatus {
  """
  The job execution was cancelled by an administrator before it completed.
  """
  CANCELLED
  """The job has finished executing successfully."""
  COMPLETED
  """The job execution failed due to an error."""
  FAILED
  """The job is queued and waiting to be executed."""
  PENDING
  """The job is currently being executed."""
  RUNNING
  """
  The job execution was skipped (e.g. because a concurrent run was already in progress and concurrent execution is disabled).
  """
  SKIPPED
  """
  The job became stale — no status update was received within the expected execution window.
  """
  STALE
}

"""
An experiment is observation+stats attached to a single targeting rule on a feature flag. The variations being measured are the variations the attached rule's rollout splits across — experiments do not own values.
"""
type Experiment {
  """Statistical method used by the analyzer."""
  analysisMethod: AnalysisMethod!
  """
  Returns the current-definition analysis report first when one exists,
  followed by historical reports newest first. Pagination is applied in
  the database query. The server clamps `limit` to 100.
  """
  analysisReports(limit: Int! = 25, offset: Long! = 0): [AnalysisReport!]!
  """Configured Bayesian prior, null when defaults apply."""
  bayesianPrior: BayesianPrior
  """Explicit baseline variation used by every statistical comparison."""
  controlVariationKey: String!
  """
  Returns a page of conversion goals attached to the experiment,
  ordered by creation time. Pagination is applied in the database
  query. The server clamps `limit` to 100.
  """
  conversionGoals(limit: Int! = 50, offset: Long! = 0): [ConversionGoal!]!
  created: DateTime!
  description: String!
  endDate: DateTime
  exclusionLayer: ExclusionLayer
  featureFlag: FeatureFlag
  featureFlagId: UUID!
  hypothesis: String!
  id: UUID!
  modified: DateTime!
  name: String!
  """
  Returns a page of aggregated per-(variation, goal) experiment
  results. Pagination is applied in the database query. The server
  clamps `limit` to 200 because callers typically want every row
  but a misbehaving experiment with hundreds of variations should
  not fan out to an unbounded list.
  """
  results(limit: Int! = 100, offset: Long! = 0): [ExperimentResult!]!
  """
  Rollout policy attached to this experiment. Null when the experiment runs without progressive-delivery automation.
  """
  rolloutPolicy: RolloutPolicy
  """
  Audit trail of rollout controller decisions for this experiment,
  newest first. One row per controller wake — advances, holds,
  halts, completes. Pagination is applied in the database query.
  The server clamps `limit` to 100.
  """
  rolloutPolicyEvents(limit: Int! = 50, offset: Long! = 0): [RolloutPolicyEvent!]!
  startDate: DateTime
  status: ExperimentStatus!
  targetSampleSize: Long
  """
  Stable id of the targeting rule this experiment observes. Null means the default-variation path.
  """
  targetingRuleId: String
}

"""Input for creating or updating an experiment."""
input ExperimentInput {
  """Statistical method. Defaults to FREQUENTIST."""
  analysisMethod: AnalysisMethod
  """Bayesian prior overrides. Null = sane defaults."""
  bayesianPrior: BayesianPriorInput
  """
  Required baseline variation selected from the experiment's involved variations.
  """
  controlVariationKey: String!
  """Description of the experiment."""
  description: String
  """When the experiment should stop accepting traffic."""
  endDate: DateTime
  """UUID of an optional mutual exclusion layer."""
  exclusionLayerId: UUID
  """The UUID of the feature flag this experiment observes."""
  featureFlagId: UUID!
  """The hypothesis being tested."""
  hypothesis: String
  """Display name of the experiment."""
  name: String!
  """
  Rollout policy. When set, a controller job runs after every analysis to advance/halt/hold the rollout.
  """
  rolloutPolicy: RolloutPolicyInput
  """When the experiment should start accepting traffic."""
  startDate: DateTime
  """
  Target number of total assignments before the experiment is considered complete.
  """
  targetSampleSize: Long
  """
  Stable id of the targeting rule this experiment is attached to. Null means the experiment observes the flag's default-variation path.
  """
  targetingRuleId: String
}

"""
Aggregated metrics for a specific variation and conversion goal within an experiment.
"""
type ExperimentResult {
  """
  CUPED-adjusted per-user mean. Populated only when the goal has a cupedCovariate configuration.
  """
  adjustedMean: Float
  """
  CUPED-adjusted per-user variance. Strictly smaller than `variance` when the covariate explains any post-period variation.
  """
  adjustedVariance: Float
  """
  Statistical confidence (0.0 to 1.0) that the difference from control is real.
  """
  confidenceLevel: Float
  conversionRate: Float!
  conversions: Long!
  """
  Posterior E[max(0, control - this)] — expected regret from picking this variation. Bayesian runs only.
  """
  expectedLoss: Float
  experimentId: UUID!
  goal: ConversionGoal
  goalId: UUID!
  id: UUID!
  impressions: Long!
  """Percentage improvement over the control variation."""
  liftOverControl: Float
  """
  Per-user mean of matching events for EVENT_COUNT, or observed seconds for SESSION_DURATION.
  """
  mean: Float
  """Independent subject-level observations used by the statistic."""
  observationCount: Long!
  """
  Posterior P(this variation > control). Populated only for Bayesian runs on non-control rows.
  """
  probabilityBeatsControl: Float
  updatedAt: DateTime!
  """
  Unbiased sample variance of matching events per user or observed session seconds. Null for UNIQUE_CONVERSION.
  """
  variance: Float
  """
  The variation key these metrics apply to. Resolve against the parent flag's variations to display name/value.
  """
  variationKey: String!
}

"""Lifecycle status of an experiment."""
enum ExperimentStatus {
  ARCHIVED
  COMPLETED
  DRAFT
  PAUSED
  RUNNING
}

"""Query operations for experiments."""
type Experiments {
  all(limit: Int!, offset: Long!): [Experiment!]!
  byFlag(flagId: UUID!): [Experiment!]!
  experiment(id: UUID!): Experiment
}

"""Mutation operations for managing experiments."""
type ExperimentsMutation {
  add(experiment: ExperimentInput!): Experiment!
  addConversionGoal(experimentId: UUID!, goal: ConversionGoalInput!): ConversionGoal!
  """Aggregate impression and conversion metrics from analytics data."""
  aggregateResults(experimentId: UUID!): Boolean!
  """Trigger a statistical analysis of experiment results."""
  analyze(experimentId: UUID!): Boolean!
  delete(id: UUID!): Boolean!
  deleteConversionGoal(id: UUID!): Boolean!
  edit(experiment: ExperimentInput!, id: UUID!): Experiment!
  """
  Update an existing conversion goal in place. Preserves the goal id and any aggregated experiment_results rows keyed off it.
  """
  editConversionGoal(goal: ConversionGoalInput!, id: UUID!): ConversionGoal!
  setStatus(id: UUID!, status: ExperimentStatus!): Experiment!
}

"""Target file format for translation export"""
enum ExportFormat {
  """Android / Compose Multiplatform strings.xml"""
  ANDROID_XML
  """Flutter Application Resource Bundle"""
  ARB
  """iOS .strings file"""
  IOS_STRINGS
  """iOS .stringsdict plist for plural forms"""
  IOS_STRINGSDICT
  """Flat {key: value} JSON"""
  JSON_FLAT
  """Nuxt @nuxtjs/i18n nested JSON"""
  JSON_I18N
  """Nested JSON with dot-separated keys expanded"""
  JSON_NESTED
  """XLIFF 1.2 for CAT tool interoperability"""
  XLIFF
}

"""Input for an export operation"""
input ExportRequestInput {
  format: ExportFormat!
  languageTag: String!
  projectId: UUID!
  """
  Which translation states to include; defaults to [PUBLISHED] when omitted
  """
  statesFilter: [TranslationState!]
}

"""
Rendered export payload ready to be written to disk or streamed to the browser
"""
type ExportResult {
  """Serialized export body"""
  content: String!
  """MIME type appropriate for the format"""
  contentType: String!
  """
  Default filename (may include path segments, e.g. 'values-es/strings.xml')
  """
  fileName: String!
}

"""Filters results to a specific content extension type"""
enum ExtensionFilterType {
  """Only return items with a collection template extension"""
  COLLECTION_TEMPLATE
  """Only return items with a document extension"""
  DOCUMENT
  """Only return items with a document template extension"""
  DOCUMENT_TEMPLATE
  """Only return items with a guide extension"""
  GUIDE
  """Only return items with a guide template extension"""
  GUIDE_TEMPLATE
}

"""
A feature flag with a palette of variations and a list of targeting rules.
"""
type FeatureFlag {
  created: DateTime!
  """The variation key returned when no targeting rule matches."""
  defaultVariationKey: String!
  description: String!
  """
  Returns a page of experiments observing this flag's targeting
  rules, ordered by creation date descending. Pagination is applied
  in the database query. The server clamps `limit` to 100.
  """
  experiments(limit: Int! = 50, offset: Long! = 0): [Experiment!]!
  id: UUID!
  key: String!
  modified: DateTime!
  name: String!
  """
  Per-flag salt mixed into bucket-assignment hashes; regenerate to reshuffle.
  """
  salt: String!
  status: FlagStatus!
  """Ordered JSON array of TargetingRule objects."""
  targetingRules: JSON
  type: FlagType!
  """
  Current distribution of installations across the flag's variations.
  A principal may own an installation's assignment, but ownership does
  not add another row. An assignment changes only when evaluation selects
  a different variation. Historical assignment transitions are stored in
  analytics. Variations with no current assignments are absent.
  """
  variationAssignments: [VariationAssignmentCount!]!
  """JSON array of Variation objects defining this flag's value palette."""
  variations: JSON!
}

"""Input for creating or updating a feature flag."""
input FeatureFlagInput {
  """The variation key returned when no targeting rule matches."""
  defaultVariationKey: String!
  """Description of the flag's purpose."""
  description: String
  """
  Unique key used to reference this flag in code (e.g., 'new-checkout-flow').
  """
  key: String!
  """Display name of the flag."""
  name: String!
  """Initial lifecycle status. Defaults to DRAFT if omitted."""
  status: FlagStatus
  """Ordered JSON array of TargetingRule objects evaluated top-to-bottom."""
  targetingRules: JSON
  """The flag's value type — constrains the shape of variation values."""
  type: FlagType!
  """
  JSON array of Variation objects: [{key, name, description, value}, ...]
  """
  variations: JSON!
}

"""Query operations for feature flags."""
type FeatureFlags {
  all(limit: Int!, offset: Long!): [FeatureFlag!]!
  """Evaluate a single flag for the current user/device context."""
  evaluate(
    """
    Typed device snapshot used by DeviceAttribute targeting conditions. Mirrors the analytics SDK's Device class.
    """
    device: AnalyticsDevice
    flagKey: String!
    installationId: String!
  ): FlagEvaluation!
  """Evaluate all active flags for the current user/device context."""
  evaluateAll(device: AnalyticsDevice, installationId: String!): [FlagEvaluation!]!
  flag(id: UUID!): FeatureFlag
  flagByKey(key: String!): FeatureFlag
}

"""Mutation operations for managing feature flags."""
type FeatureFlagsMutation {
  add(flag: FeatureFlagInput!): FeatureFlag!
  delete(id: UUID!): Boolean!
  edit(flag: FeatureFlagInput!, id: UUID!): FeatureFlag!
  """Regenerate the per-flag salt to reshuffle bucket assignments."""
  regenerateSalt(id: UUID!): FeatureFlag!
  setStatus(id: UUID!, status: FlagStatus!): FeatureFlag!
}

"""Input for federating a local channel with a remote channel on a peer"""
input FederateChannelInput {
  """ID of the local Bosca chat channel to federate"""
  localChannelId: UUID!
  """ID of the federation peer to link with"""
  peerId: UUID!
  """ID of the remote channel on the peer side"""
  remoteChannelId: UUID!
  """Sync direction for this link. Defaults to bidirectional when omitted."""
  syncDirection: FederationSyncDirection
}

"""
Links a local chat channel to a remote channel on a federated peer, defining the direction of message relay
"""
type FederatedChannel {
  """ID of the local Bosca chat channel"""
  localChannelId: UUID!
  """The peer this link targets"""
  peer: FederationPeer
  """ID of the federation peer this link targets"""
  peerId: UUID!
  """ID of the remote channel on the peer side"""
  remoteChannelId: UUID!
  """Direction of message relay for this link"""
  syncDirection: FederationSyncDirection!
}

"""Root query type for federation administration"""
type Federation {
  """Federated channel links originating from a local channel"""
  channelLinks(localChannelId: UUID!): [FederatedChannel!]!
  """A specific peer by id"""
  peer(id: UUID!): FederationPeer
  """All active federation peers known to this instance"""
  peers: [FederationPeer!]!
}

"""Mutation operations for managing federation peers and channel links"""
type FederationMutation {
  """Deactivate a federation peer, halting message synchronization"""
  deactivatePeer(id: UUID!): Boolean!
  """
  Link a local channel with a remote channel on a peer for synchronization
  """
  federateChannel(input: FederateChannelInput!): Boolean!
  """
  Register a new federation peer with its connection details and shared secret
  """
  registerPeer(input: RegisterFederationPeerInput!): FederationPeer!
  """
  Set or rotate the shared secret used to authenticate handshake requests with a peer
  """
  setSharedSecret(id: UUID!, secret: String): Boolean!
  """Remove an existing federation link for a local channel"""
  unfederateChannel(localChannelId: UUID!, peerId: UUID!): Boolean!
}

"""
A remote Bosca instance that participates in federated chat. Peers communicate over NATS leaf nodes for transport and a REST API for handshake/control.
"""
type FederationPeer {
  """Whether this peer is currently active"""
  active: Boolean!
  """
  Base URL of the peer's federation REST API used for control-plane operations
  """
  apiUrl: String!
  """Timestamp when this peer was registered"""
  createdAt: DateTime
  """
  Channel-level federation links to this peer originating from local channels
  """
  federatedChannels: [FederatedChannel!]!
  """Unique identifier for this peer"""
  id: UUID!
  """Human-readable name for this peer"""
  name: String!
  """NATS connection URL used by the leaf-node bridge for message transport"""
  natsUrl: String!
}

"""
Direction in which a federated channel link relays messages between peers
"""
enum FederationSyncDirection {
  """Messages flow in both directions between the local and remote channel"""
  BIDIRECTIONAL
  """
  Only inbound messages from the peer are accepted into the local channel
  """
  INBOUND
  """Only outbound messages from the local channel are sent to the peer"""
  OUTBOUND
}

"""
A configured feed source: the content Source identity + its (secret-free) FeedConfiguration + operational fields.
"""
type FeedSource {
  """
  The secret-free FeedConfiguration (type, endpoint, cronInterval, ownership, enabled, url, auth descriptor) as JSON.
  """
  configuration: JSON!
  created: DateTime!
  """Description (from the content Source)."""
  description: String!
  """Whether scheduled fetching is enabled."""
  enabled: Boolean!
  """The content Source id."""
  id: UUID!
  modified: DateTime!
  """Display name (from the content Source)."""
  name: String!
  """The owning profile for a user-owned source; null for Bosca-managed."""
  ownerProfileId: UUID
  """Normalized canonical URL — the cross-source uniqueness key."""
  url: String!
}

"""Input to create or edit a feed source."""
input FeedSourceInput {
  """
  Write-only outbound auth secret; stored in ConfigurationService, never returned.
  """
  authSecret: String
  """
  Secret-free FeedConfiguration as JSON; the auth block holds only the descriptor (kind + non-secret fields).
  """
  configuration: JSON!
  """Description for the content Source."""
  description: String!
  """Display name for the content Source."""
  name: String!
}

"""Operations scoped to one feed source. Admin."""
type FeedSourceMutation {
  """Soft-delete the source and remove its auth secret."""
  delete: Boolean!
  """Disable scheduled fetching for the source."""
  disable: FeedSource!
  """
  Edit the source's configuration (and optionally rotate its auth secret).
  """
  edit(input: FeedSourceInput!): FeedSource!
  """Enable scheduled fetching for the source."""
  enable: FeedSource!
  """
  Fetch the source's feed immediately, bypassing its schedule. False if the source is missing.
  """
  fetch: Boolean!
}

"""
Feed source creates and the per-source instance accessor. Admin (managed sources).
"""
type FeedSourcesMutation {
  """
  Register a feed source: a content Source + its FeedConfiguration + optional auth secret.
  """
  add(input: FeedSourceInput!): FeedSource!
  """Operations on an existing feed source."""
  source(id: UUID!): FeedSourceMutation!
}

"""The authenticated caller's feed-source subscriptions."""
type FeedSubscriptionsMutation {
  """
  Subscribe the caller to a feed source; returns the subscribed source. Idempotent.
  """
  subscribe(sourceId: UUID!): FeedSource!
  """Unsubscribe the caller from a feed source; false if not subscribed."""
  unsubscribe(sourceId: UUID!): Boolean!
}

"""Operations on one of the caller's own feed sources (ownership-gated)."""
type FeedUserSourceMutation {
  """Delete the source."""
  delete: Boolean!
  """Disable scheduled fetching for the source."""
  disable: FeedSource!
  """Edit the source; ownership remains the caller."""
  edit(input: FeedSourceInput!): FeedSource!
  """Enable scheduled fetching for the source."""
  enable: FeedSource!
}

"""
Self-service feed source registration + the per-source instance accessor for the authenticated caller.
"""
type FeedUserSourcesMutation {
  """
  Register a feed source owned by the caller (ownership is forced to the caller's profile).
  """
  add(input: FeedSourceInput!): FeedSource!
  """Operate on one of the caller's own sources."""
  source(id: UUID!): FeedUserSourceMutation!
}

"""The feeds query namespace — feed source reads (admin surface)."""
type Feeds {
  """
  The authenticated caller's personalized feed ("For you"): the trained model's ranked recommendations, care-gated by the recommendations domain.
  """
  forYou(
    """The recommendation candidate context to select. Omit to use `default`."""
    contextType: String
    limit: Int! = 25
    offset: Int! = 0
  ): [Metadata!]!
  """
  Ingested content items for a feed source, newest-first. Admin read surface (the subscriber/personalized serving surface is a later phase).
  """
  items(limit: Int! = 25, offset: Int! = 0, sourceId: UUID!): [Metadata!]!
  """
  The authenticated caller's assembled feed ("Following"): items from their subscribed + owned sources, newest-first.
  """
  myFeed(limit: Int! = 25, offset: Int! = 0): [Metadata!]!
  """
  The authenticated caller's own (user-owned) feed sources, newest-first.
  """
  mySources(limit: Int! = 25, offset: Int! = 0): [FeedSource!]!
  """
  The feed sources the authenticated caller is subscribed to, newest-subscription-first.
  """
  mySubscriptions(limit: Int! = 25, offset: Int! = 0): [FeedSource!]!
  """
  Item-context recommendations for a given item: the recommendations domain's blend of behavioral co-engagement and content similarity, re-ranked for the caller.
  """
  recommended(
    """The recommendation candidate context to select. Omit to use `default`."""
    contextType: String
    limit: Int! = 10
    metadataId: UUID!
  ): [Metadata!]!
  """A feed source by its content Source id."""
  source(id: UUID!): FeedSource
  """All feed sources, paged."""
  sources(limit: Int! = 25, offset: Int! = 0): [FeedSource!]!
}

"""The feeds mutation namespace, grouped per entity collection."""
type FeedsMutation {
  """Self-service feed sources owned by the authenticated caller."""
  mySources: FeedUserSourcesMutation!
  """The authenticated caller's feed-source subscriptions."""
  mySubscriptions: FeedSubscriptionsMutation!
  """Feed source creates + the per-source instance namespace."""
  sources: FeedSourcesMutation!
}

"""A single key-value pair for matching against item attributes"""
input FindAttributeInput {
  """The attribute key to match on"""
  key: String!
  """The attribute value to match against"""
  value: String!
}

"""
A group of attribute conditions that must all match (AND logic within the group)
"""
input FindAttributesInput {
  """List of attribute key-value pairs that must all match"""
  attributes: [FindAttributeInput!]!
}

"""
A result from searching the Bible by a human-readable reference string, containing the matched book, chapter, and verse range
"""
type FindBibleResult {
  """The matched Bible book"""
  book: BibleBook!
  """The matched chapter, if the reference specifies a chapter"""
  chapter: BibleChapter
  """
  JSON component tree for the matched verse range, if the reference specifies verses
  """
  component: JSON
  """The resolved USFM reference for this result"""
  reference: BibleReference!
}

"""
Comprehensive query input for finding content items with filtering, pagination, and ordering
"""
input FindQueryInput {
  """
  Attribute filter groups — groups are combined with OR logic, conditions within a group use AND logic
  """
  attributes: [FindAttributesInput!]
  """Filter by category IDs"""
  categoryIds: [String!]
  """Filter by collection type (root, standard, folder, etc.)"""
  collectionType: CollectionType
  """Filter by MIME content types (e.g. 'image/png', 'application/pdf')"""
  contentTypes: [String!]
  """Filter by content extension type"""
  extensionFilter: ExtensionFilterType
  """Filter by BCP 47 language tags (e.g. 'en', 'es-MX')"""
  languageTags: [String!]
  """Maximum number of results to return"""
  limit: Int
  """Number of results to skip for pagination"""
  offset: Int
  """Sort order for results"""
  ordering: [OrderingInput!]
  """Filter by trait IDs"""
  traitIds: [String!]
}

"""
The resolved value of a feature flag for a specific user/device context.
"""
type FlagEvaluation {
  """
  True when targeting data or feature evaluation was unavailable. A
  non-blank variationKey carries the flag's valid declared default; a
  blank variationKey carries a null value and tells clients to use their
  authored fallback.
  """
  degraded: Boolean!
  """
  The experiment id if a running experiment was attached to the matched rule.
  """
  experimentId: UUID
  flagKey: String!
  """
  The variation's resolved value, or null when the flag is unavailable or invalid.
  """
  value: JSON
  """The variation key that was selected."""
  variationKey: String!
}

"""
Lifecycle status of a feature flag, controlling whether it is actively evaluated.
"""
enum FlagStatus {
  ARCHIVED
  DISABLED
  DRAFT
  ENABLED
}

"""
Categorizes feature flags by the type of value their variations resolve to.
"""
enum FlagType {
  """Variations are boolean true/false."""
  BOOLEAN
  """Variations are arbitrary JSON payloads."""
  JSON
  """Variations are numbers between 0 and 100."""
  PERCENTAGE
  """Variations are string values."""
  STRING
}

"""Categorizes the type of change that occurred to a feature flag."""
enum FlagUpdateAction {
  DELETED
  UPDATED
}

"""Event published when a feature flag is modified."""
type FlagUpdated {
  action: FlagUpdateAction!
  flagId: UUID!
  flagKey: String!
}

"""Input for forking a repository."""
input ForkGitRepositoryInput {
  """Optional name override for the fork."""
  name: String
  """The owner of the new fork."""
  newOwnerId: UUID!
  """Optional slug override for the fork."""
  slug: String
  """The source repository to fork."""
  sourceRepositoryId: UUID!
}

"""
A reusable form definition backed by JSON Schema for data validation and a companion UI Schema for layout and control configuration
"""
type FormSchema {
  """
  Operational configuration for notification recipients, email subjects, and other settings
  """
  configuration: JSON
  """When the form schema was created"""
  created: DateTime!
  """Description of the form's purpose"""
  description: String!
  """Unique identifier"""
  id: UUID!
  """
  Unique string key for component-level lookup (e.g. 'org-profile', 'newsletter-signup')
  """
  key: String!
  """When the form schema was last modified"""
  modified: DateTime!
  """Human-readable name for the form"""
  name: String!
  """Permission grants controlling access to this form schema"""
  permissions: [EntityPermission!]!
  """
  Profile mapping that defines how form field values create a profile for anonymous submissions
  """
  profileMapping: FormSchemaProfileMapping
  """Whether this form schema is publicly accessible without authentication"""
  public: Boolean!
  """Whether this form schema is in a published state"""
  published: Boolean!
  """JSON Schema (draft 2020-12) defining data types and validation rules"""
  schema: JSON!
  """Submissions received for this form schema"""
  submissions(limit: Int!, offset: Long!): [FormSubmission!]!
  """The intended usage pattern for this form schema"""
  type: FormSchemaType!
  """
  Bosca UI Schema defining layout tree, control types, and display elements
  """
  uiSchema: JSON!
  """Schema version, auto-incremented on each save"""
  version: Int!
}

"""Input for creating or updating a form schema (upserts by key)"""
input FormSchemaInput {
  """
  Operational configuration for notification recipients, email subjects, and other settings
  """
  configuration: JSON
  """Description of the form's purpose"""
  description: String
  """Unique string key"""
  key: String!
  """Human-readable name"""
  name: String!
  """
  Profile mapping that defines how form field values create a profile for anonymous submissions
  """
  profileMapping: FormSchemaProfileMappingInput
  """Whether this form schema is publicly accessible without authentication"""
  public: Boolean
  """JSON Schema defining data types and validation"""
  schema: JSON!
  """The intended usage pattern for this form schema"""
  type: FormSchemaType
  """UI Schema defining layout and controls"""
  uiSchema: JSON!
}

"""
Defines how submitted form field values are mapped to profile attributes when an anonymous user submits a public form
"""
type FormSchemaProfileMapping {
  """Attribute mappings from form fields to profile attribute types"""
  attributes: [FormSchemaProfileMappingAttribute!]!
  """The form field property name that provides the profile display name"""
  nameField: String!
  """
  The visibility level assigned to the created profile and its attributes
  """
  visibility: ProfileVisibility!
}

"""
Maps a single form field to a profile attribute type for anonymous submission profile creation
"""
type FormSchemaProfileMappingAttribute {
  """
  The key within the profile attribute's JSON value object (e.g. 'email')
  """
  attributeKey: String!
  """The form field property name whose value populates this attribute"""
  field: String!
  """The profile attribute type identifier (e.g. 'bosca.profiles.email')"""
  typeId: String!
}

"""Input for a single form-field-to-profile-attribute mapping"""
input FormSchemaProfileMappingAttributeInput {
  """
  The key within the profile attribute's JSON value object (e.g. 'email')
  """
  attributeKey: String!
  """The form field property name whose value populates this attribute"""
  field: String!
  """The profile attribute type identifier (e.g. 'bosca.profiles.email')"""
  typeId: String!
}

"""
Input for configuring how anonymous form submissions create profiles from form data
"""
input FormSchemaProfileMappingInput {
  """Attribute mappings from form fields to profile attribute types"""
  attributes: [FormSchemaProfileMappingAttributeInput!]!
  """The form field property name that provides the profile display name"""
  nameField: String!
  """
  The visibility level assigned to the created profile and its attributes
  """
  visibility: ProfileVisibility!
}

"""Categorizes a form schema by its intended usage pattern"""
enum FormSchemaType {
  """
  Forms used within the admin for structured data editing (profile attributes, settings)
  """
  INTERNAL
  """
  Forms that collect submissions from users (contact forms, signups, surveys)
  """
  SUBMISSION
  """
  Forms that create Work Ops tasks on submission — configuration carries project and field mappings
  """
  WORK_OPS
}

"""Queries for retrieving form schema definitions"""
type FormSchemas {
  """All form schemas in the system"""
  all: [FormSchema!]!
  """Look up a form schema by its unique identifier"""
  byId(id: UUID!): FormSchema
  """Look up a form schema by its unique key"""
  byKey(key: String!): FormSchema
  """All form schemas of a specific type"""
  byType(type: FormSchemaType!): [FormSchema!]!
}

"""Mutation operations for managing form schema definitions"""
type FormSchemasMutation {
  """Grant a permission on a form schema to a security group"""
  addPermission(permission: PermissionInput!): Permission!
  """Delete a form schema by its identifier"""
  delete(id: UUID!): Boolean!
  """Revoke a permission on a form schema from a security group"""
  deletePermission(permission: PermissionInput!): Permission!
  """Create or update a form schema (upserts by key)"""
  save(input: FormSchemaInput!): FormSchema!
  """
  Set the published state of a form schema, controlling public availability
  """
  setPublished(id: UUID!, published: Boolean!): FormSchema!
}

"""
A submitted form entry linked to a profile, containing the attribute values collected from the form
"""
type FormSubmission {
  """
  The submitted attribute values as key-value pairs matching the schema's property definitions
  """
  attributes: JSON!
  """Timestamp when the submission was received"""
  created: DateTime!
  """The form schema this submission was made against"""
  formSchema: FormSchema!
  """Unique identifier for this submission"""
  id: UUID!
  """Timestamp when the submission was last modified"""
  modified: DateTime!
  """The profile associated with this submission"""
  profile: Profile!
  """The current processing status of this submission"""
  status: FormSubmissionStatus!
}

"""
Input for submitting a form, including the form schema, attribute values, and optional profile for anonymous submissions. Exactly one of formSchemaId or formSchemaKey must be provided.
"""
input FormSubmissionInput {
  """The submitted attribute values as key-value pairs"""
  attributes: JSON!
  """
  The form schema UUID to submit against — mutually exclusive with formSchemaKey
  """
  formSchemaId: UUID
  """
  The form schema key to submit against — mutually exclusive with formSchemaId
  """
  formSchemaKey: String
  """
  Optional profile input for anonymous submissions — required when not authenticated
  """
  profile: ProfileInput
}

"""The processing lifecycle status of a form submission"""
enum FormSubmissionStatus {
  """Submission has been archived"""
  ARCHIVED
  """Submission received and awaiting processing"""
  PENDING
  """Submission has been fully processed through the configured pipeline"""
  PROCESSED
  """Submission was rejected via validation or manual review"""
  REJECTED
  """Submission was flagged as spam"""
  SPAM
}

"""Mutation operations for form submissions"""
type FormsMutation {
  """Delete a form submission by its identifier"""
  deleteSubmission(id: UUID!): Boolean!
  """Update the processing status of a form submission"""
  setSubmissionStatus(id: UUID!, status: FormSubmissionStatus!): FormSubmission!
  """
  Submit a form with attribute values, optionally including a new profile for anonymous submissions
  """
  submit(input: FormSubmissionInput!): SubmittedForm!
}

"""Zero the cart's shipping line(s)."""
type FreeShippingCartRule {
  type: String!
}

"""How often a promotion's per-account limit resets."""
enum FrequencyLimit {
  DAILY
  FOREVER
  MONTHLY
  WEEKLY
  YEARLY
}

"""A warehouse that holds inventory and hands off to a shipping provider."""
type FulfillmentCenter {
  address1: String!
  address2: String
  city: String!
  company: Company!
  """DI key of the inventory-sync connector ('manual' = no external sync)."""
  connectorKey: String!
  country: String!
  id: UUID!
  name: String!
  shippingProvider: ShippingProvider
  state: String!
  zip: String!
}

"""Creates a fulfillment center."""
input FulfillmentCenterInput {
  address1: String!
  address2: String
  city: String!
  companyId: UUID!
  """DI key of the inventory-sync connector ('manual' = no external sync)."""
  connectorKey: String!
  country: String!
  name: String!
  shippingProviderId: UUID!
  state: String!
  zip: String!
}

"""Fulfillment-center and inventory administration. Admin."""
type FulfillmentMutation {
  """Create a fulfillment center."""
  addCenter(input: FulfillmentCenterInput!): FulfillmentCenter!
  """Create an inventory row for a product at a fulfillment center."""
  addInventory(input: InventoryInput!): Inventory!
  """
  Edit a fulfillment center (name, connector, shipping provider, address).
  """
  editCenter(id: UUID!, input: FulfillmentCenterInput!): FulfillmentCenter!
  """Operations on an existing inventory row."""
  inventory(id: UUID!): InventoryMutation!
  """Operations on an existing shipment."""
  shipment(id: UUID!): ShipmentMutation!
}

type Gateway {
  connectTimeoutSecs: Int!
  createdAt: DateTime!
  enabled: Boolean!
  healthCheckIntervalSecs: Int!
  healthCheckPath: String
  healthStatus: GatewayHealthStatus!
  healthStatusChangedAt: DateTime!
  healthStatusReason: String
  id: UUID!
  modifiedAt: DateTime!
  name: String!
  permissions: [EntityPermission!]!
  poolIdleTimeoutSecs: Int!
  poolMaxIdle: Int!
  requestTimeoutSecs: Int!
  routes: [GatewayRoute!]!
  url: String!
  version: Long!
}

enum GatewayAuthMethod {
  BASIC
  JWT
  NONE
  OAUTH2
}

type GatewayConfig {
  routes: [GatewayRoute!]!
  services: [Gateway!]!
  version: String!
}

enum GatewayHealthStatus {
  DOWN
  UNKNOWN
  UP
}

input GatewayInput {
  connectTimeoutSecs: Int = 5
  healthCheckIntervalSecs: Int = 30
  healthCheckPath: String
  name: String!
  poolIdleTimeoutSecs: Int = 90
  poolMaxIdle: Int = 10
  requestTimeoutSecs: Int = 300
  url: String!
}

type GatewayMutations {
  routes: GatewayRoutesMutation!
  services: GatewayServicesMutation!
}

type GatewayNamespace {
  config: GatewayConfig!
  routes: GatewayRoutes!
  services: GatewayServices!
}

type GatewayRoute {
  authMethod: GatewayAuthMethod!
  createdAt: DateTime!
  enabled: Boolean!
  gateway: Gateway!
  gatewayId: UUID!
  """
  Host patterns this route accepts. Empty = match any host (no host
  filter applied). Each entry is a literal host or a leading-`*.`
  wildcard, e.g. `api.bosca.io` or `*.bosca.io`.
  """
  hosts: [String!]!
  id: UUID!
  injectHeaders: JSON!
  modifiedAt: DateTime!
  pathPattern: String!
  readGroups: [String!]!
  sortOrder: Int!
  stripPrefix: Boolean!
  version: Long!
  writeGroups: [String!]!
}

input GatewayRouteInput {
  authMethod: GatewayAuthMethod!
  gatewayId: UUID!
  hosts: [String!] = []
  injectHeaders: JSON
  pathPattern: String!
  readGroups: [String!] = []
  sortOrder: Int = 0
  stripPrefix: Boolean = false
  writeGroups: [String!] = []
}

type GatewayRoutes {
  all: [GatewayRoute!]!
  byGateway(gatewayId: UUID!): [GatewayRoute!]!
  route(id: UUID!): GatewayRoute
}

type GatewayRoutesMutation {
  create(input: GatewayRouteInput!): GatewayRoute!
  delete(expectedVersion: Long!, id: UUID!): GatewayRoute!
  toggleEnabled(enabled: Boolean!, expectedVersion: Long!, id: UUID!): GatewayRoute!
  update(expectedVersion: Long!, id: UUID!, input: GatewayRouteInput!): GatewayRoute!
}

type GatewayServices {
  all: [Gateway!]!
  gateway(id: UUID!): Gateway
  gatewayByName(name: String!): Gateway
}

type GatewayServicesMutation {
  addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  create(input: GatewayInput!): Gateway!
  delete(expectedVersion: Long!, id: UUID!): Gateway!
  removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
  toggleEnabled(enabled: Boolean!, expectedVersion: Long!, id: UUID!): Gateway!
  update(expectedVersion: Long!, id: UUID!, input: GatewayInput!): Gateway!
}

"""Queries for the git repository system."""
type Git {
  """
  Every pipeline across all repositories — the author-time picker for release relays.
  """
  allPipelines: [GitPipeline!]!
  """List pull requests across all repositories visible to the caller."""
  allPullRequests(authorId: UUID, limit: Int, offset: Long, status: GitPullRequestStatus): [GitPullRequest!]!
  """Per-line blame attribution for a file."""
  blame(path: String!, ref: String!, repositoryId: UUID!): [GitBlameLine!]!
  """Read a file's content at a ref."""
  blob(path: String!, ref: String!, repositoryId: UUID!): GitBlob
  """List branch protection rules for a repository."""
  branchProtectionRules(repositoryId: UUID!): [GitBranchProtectionRule!]!
  """List all branches with head SHA and ahead/behind counts."""
  branches(repositoryId: UUID!): [GitBranchInfo!]!
  """Get a single commit by SHA."""
  commit(repositoryId: UUID!, sha: String!): GitCommitInfo
  """List commit statuses for a specific commit."""
  commitStatuses(commitSha: String!, repositoryId: UUID!): [GitCommitStatus!]!
  """List commit history, optionally filtered to a path."""
  commits(limit: Int, offset: Long, path: String, ref: String, repositoryId: UUID!): [GitCommitInfo!]!
  """Compare two refs (branches, tags, or SHAs)."""
  compare(baseRef: String!, headRef: String!, repositoryId: UUID!): GitComparisonResult!
  """
  The artifacts a pipeline's definition declares it produces (parsed at the repo's default branch), for the Use Artifact picker. Coordinates are the raw `${{ }}` templates.
  """
  declaredArtifacts(pipelineId: UUID!): [GitArtifactDefinition!]!
  """
  The uses:verify-deployment gate's observation: the current deployment's health for an environment (probed once), or NONE when nothing is deployed. Agents poll this until HEALTHY or timeout.
  """
  jobDeploymentHealth(environmentKey: String!, jobId: UUID!, repository: String): String!
  """Permission grants for a repository. Requires MANAGE permission."""
  permissions(repositoryId: UUID!): [Permission!]!
  """
  List registered build agents. System admins see all agents; agent credentials see only themselves and their direct children.
  """
  pipelineAgents(status: GitAgentStatus): [GitPipelineAgent!]!
  """
  Manual input declarations read from the pipeline definition at the selected ref. Requires VIEW permission.
  """
  pipelineInputs(pipelineId: UUID!, ref: String!): [GitPipelineInputDefinition!]!
  """
  Get log output for a pipeline step. With tail: true, returns the last `limit` lines (offset is ignored). With beforeLine, returns the last `limit` lines whose line number is below it (offset and tail are ignored) — use this to page backwards, since stored line numbers can have gaps.
  """
  pipelineLogs(beforeLine: Int, limit: Int, offset: Int, stepId: UUID!, tail: Boolean): [GitPipelineLogLine!]!
  """Get a specific pipeline run."""
  pipelineRun(id: UUID!): GitPipelineRun
  """List pipeline runs for a repository."""
  pipelineRuns(limit: Int, offset: Long, repositoryId: UUID!): [GitPipelineRun!]!
  """
  List secrets for a repository (names only). Requires MANAGE permission.
  """
  pipelineSecrets(repositoryId: UUID!): [GitPipelineSecretInfo!]!
  """List pipelines for a repository."""
  pipelines(repositoryId: UUID!): [GitPipeline!]!
  """Look up a pull request by repository and number."""
  pullRequest(number: Int!, repositoryId: UUID!): GitPullRequest
  """
  List unresolved pull requests in the order they would be merged, with the requested pull request last.
  """
  pullRequestMergePlan(id: UUID!): [GitPullRequest!]!
  """List pull requests for a repository with optional filters."""
  pullRequests(authorId: UUID, limit: Int, offset: Long, repositoryId: UUID!, status: GitPullRequestStatus): [GitPullRequest!]!
  """Get the source ref for a query, if it's git-backed."""
  querySourceRef(queryId: UUID!): GitQuerySourceRef
  """List repositories, optionally filtered by owner and/or content type."""
  repositories(contentType: GitRepositoryContentType, includeArchived: Boolean, ownerId: UUID): [GitRepository!]!
  """Look up a repository by owner slug and repo slug."""
  repository(owner: String!, repo: String!): GitRepository
  """Look up a repository by its unique ID."""
  repositoryById(id: UUID!): GitRepository
  """Get the source ref for a script, if it's git-backed."""
  scriptSourceRef(scriptId: UUID!): GitScriptSourceRef
  """
  Search indexed code across repositories, optionally scoped by repository and language.
  """
  searchCode(language: String, limit: Int, offset: Int, query: String!, repositoryId: UUID): GitCodeSearchResponse!
  """Search file content matching a query."""
  searchContent(limit: Int, query: String!, ref: String, repositoryId: UUID!): [GitSearchResult!]!
  """Search file paths matching a query."""
  searchPaths(query: String!, ref: String, repositoryId: UUID!): [GitTreeEntry!]!
  """Search indexed repositories visible to the caller."""
  searchRepositories(archived: Boolean, limit: Int, offset: Int, query: String!, visibility: GitVisibility): GitRepositorySearchResponse!
  """List all source refs for a repository."""
  sourceRefs(repositoryId: UUID!): [GitScriptSourceRef!]!
  """Repository statistics."""
  stats(repositoryId: UUID!): GitRepoStats!
  """List all tags."""
  tags(repositoryId: UUID!): [GitTagInfo!]!
  """
  Get the current status of a job attempt assigned to this agent. A stale attempt is reported as cancelled.
  """
  targetedJobStatus(agentId: UUID!, attempt: Int, jobId: UUID!): GitPipelineRunStatus
  """List task references for a repository by task key."""
  taskCommitReferences(repositoryId: UUID!, taskKey: String!): [GitTaskCommitReference!]!
  """List task PR references for a repository by task key."""
  taskPullRequestReferences(repositoryId: UUID!, taskKey: String!): [GitTaskPullRequestReference!]!
  """List directory contents at a ref."""
  tree(path: String, ref: String, repositoryId: UUID!): [GitTreeEntry!]!
  """List delivery history for a webhook."""
  webhookDeliveries(limit: Int, offset: Long, webhookId: UUID!): [GitWebhookDelivery!]!
  """List webhooks for a repository. Requires MANAGE permission."""
  webhooks(repositoryId: UUID!): [GitWebhook!]!
}

"""Operating mode of a build agent."""
enum GitAgentMode {
  ORCHESTRATOR
  RUNNER
}

"""Current status of a build agent."""
enum GitAgentStatus {
  BUSY
  DRAINING
  OFFLINE
  ONLINE
}

"""Notification sink for resource management alerts."""
type GitAlertSink {
  type: String!
  url: String!
}

input GitAlertSinkInput {
  type: String!
  url: String!
}

"""A durable app build number allocated by uses:allocate-build-number."""
type GitAppBuildNumber {
  """Monotonic durable sequence; Android embeds this value directly."""
  number: Long!
  """
  True when a retry recovered an existing allocation for the same source identity.
  """
  reused: Boolean!
  """Platform-formatted value to embed in the app binary."""
  value: String!
}

type GitAppStoreReviewOutcome {
  approved: Boolean!
  complete: Boolean!
  state: String!
}

"""
An artifact a pipeline's job declares it produces — enough to resolve it in the registry (type + namespace + type-specific coordinate). The coordinate is the raw `${{ }}` template as authored.
"""
type GitArtifactDefinition {
  """
  Type-specific coordinate (repository + version in that type's form); may contain `${{ }}`.
  """
  coordinate: String!
  """Registry namespace the artifact is published to, e.g. bosca-maven."""
  namespace: String!
  """
  Registry type the coordinate resolves against: docker, helm, maven, npm, raw, ml.
  """
  type: String!
}

"""Per-line blame attribution."""
type GitBlameLine {
  authorEmail: String!
  authorName: String!
  commitSha: String!
  content: String!
  lineNumber: Int!
}

"""File content at a specific ref."""
type GitBlob {
  """UTF-8 content, null for binary or large files."""
  content: String
  isBinary: Boolean!
  mimeType: String
  sha: String!
  size: Long!
}

"""Branch with ahead/behind counts relative to default branch."""
type GitBranchInfo {
  ahead: Int!
  behind: Int!
  name: String!
  sha: String!
}

"""
A branch protection rule that enforces review requirements and push restrictions.
"""
type GitBranchProtectionRule {
  """Whether matching branches can be deleted."""
  allowDeletion: Boolean!
  """Whether force-pushes are permitted."""
  allowForcePush: Boolean!
  """
  When true, approvals are dismissed when new commits are pushed to the PR.
  """
  dismissStaleReviews: Boolean!
  """Unique identifier."""
  id: UUID!
  """Glob pattern matching branch names (e.g. main, release/*)."""
  pattern: String!
  """The repository this rule belongs to."""
  repositoryId: UUID!
  """When true, at least one approval must come from a code owner."""
  requireCodeOwnerReview: Boolean!
  """When true, only fast-forward or squash merges are allowed."""
  requireLinearHistory: Boolean!
  """
  When true, direct pushes are rejected; changes must come through a merged PR.
  """
  requirePullRequest: Boolean!
  """Named CI checks that must pass before merge."""
  requireStatusChecks: [String!]!
  """Minimum approving reviews before a PR can merge."""
  requiredApprovals: Int!
  """When set, only these profiles can push."""
  restrictPushAccess: [UUID!]
}

"""Input for creating or updating a branch protection rule."""
input GitBranchProtectionRuleInput {
  """Allow branch deletion."""
  allowDeletion: Boolean
  """Allow force push."""
  allowForcePush: Boolean
  """Dismiss approvals on new commits."""
  dismissStaleReviews: Boolean
  """Glob pattern matching branch names."""
  pattern: String!
  """Require code owner approval."""
  requireCodeOwnerReview: Boolean
  """Require linear history."""
  requireLinearHistory: Boolean
  """Require changes through PRs."""
  requirePullRequest: Boolean
  """Required CI status checks."""
  requireStatusChecks: [String!]
  """Minimum approving reviews."""
  requiredApprovals: Int
  """Restrict push to these profiles."""
  restrictPushAccess: [UUID!]
}

"""A page of indexed code-search results."""
type GitCodeSearchResponse {
  estimatedHits: Long!
  results: [GitCodeSearchResult!]!
}

"""A match from indexed code search across repositories."""
type GitCodeSearchResult {
  filePath: String!
  language: String!
  repositoryId: UUID!
  repositoryName: String!
  repositorySlug: String!
  snippet: String!
}

"""Commit metadata."""
type GitCommitInfo {
  authorDate: String!
  authorEmail: String!
  authorName: String!
  committerDate: String!
  committerEmail: String!
  committerName: String!
  message: String!
  parentShas: [String!]!
  sha: String!
}

"""A CI/CD status check on a specific commit."""
type GitCommitStatus {
  commitSha: String!
  """The status check name (e.g. 'ci/build', 'ci/test')."""
  context: String!
  created: DateTime!
  description: String
  id: UUID!
  repositoryId: UUID!
  state: GitCommitStatusState!
  targetUrl: String
}

"""State of a CI/CD commit status check."""
enum GitCommitStatusState {
  ERROR
  FAILURE
  PENDING
  SUCCESS
}

"""Structured comparison between two refs."""
type GitComparisonResult {
  baseRef: String!
  commits: [GitCommitInfo!]!
  deletions: Int!
  files: [GitDiffFile!]!
  filesChanged: Int!
  headRef: String!
  insertions: Int!
}

"""Result of the uses:tag action (createReleaseTag)."""
type GitCreateTagResult {
  """SHA of the tagged commit."""
  commitSha: String!
  """
  False when the tag already existed at the same commit — the idempotent no-op.
  """
  created: Boolean!
  """Fully-qualified tag ref, refs/tags/<tag>."""
  ref: String!
  tag: String!
  """
  SHA of the annotated-tag object (the pre-existing one on an idempotent no-op).
  """
  tagSha: String!
}

"""Classification of a file change within a diff."""
enum GitDiffChangeType {
  ADD
  COPY
  DELETE
  MODIFY
  RENAME
}

"""A file changed in a diff."""
type GitDiffFile {
  changeType: GitDiffChangeType!
  hunks: [GitDiffHunk!]!
  newPath: String
  oldPath: String
}

"""A contiguous region of changed lines."""
type GitDiffHunk {
  """A bounded page of diff lines."""
  lines(limit: Int = 2000, offset: Int = 0): [GitDiffLine!]!
  newCount: Int!
  newStart: Int!
  oldCount: Int!
  oldStart: Int!
  """Total number of lines in the hunk before pagination."""
  totalLineCount: Int!
}

"""A single line in a diff hunk."""
type GitDiffLine {
  content: String!
  newLineNumber: Int
  oldLineNumber: Int
  type: GitDiffLineType!
}

"""Classification of a line within a diff hunk."""
enum GitDiffLineType {
  ADD
  CONTEXT
  DELETE
}

"""
Determines how a pull request's source branch is integrated into the target.
"""
enum GitMergeStrategy {
  """Move the target branch pointer forward (only if no divergence)."""
  FAST_FORWARD
  """Create a merge commit combining both branches."""
  MERGE_COMMIT
  """Replay source commits on top of the target branch."""
  REBASE
  """Squash all source commits into a single commit on the target."""
  SQUASH
}

"""Mutations for the git repository system."""
type GitMutation {
  """
  Grant a permission action to a group on a repository. Requires MANAGE permission.
  """
  addPermission(permission: PermissionInput!): Boolean!
  """
  Grants a group an action on the secret itself (use = EXECUTE). Requires MANAGE permission.
  """
  addPipelineSecretPermission(action: PermissionAction!, groupId: UUID!, name: String!, repositoryId: UUID!): Boolean!
  """Add a pull request that must be merged before this pull request."""
  addPullRequestDependency(dependencyId: UUID!, id: UUID!): GitPullRequest!
  """Add a comment anchored to a specific diff line."""
  addReviewComment(input: AddGitReviewCommentInput!): GitReviewComment!
  """Record an agent heartbeat. Called periodically by CLI runners."""
  agentHeartbeat(agentId: UUID!): Boolean!
  """
  Allocates a durable Android versionCode or iOS CFBundleVersion for this job's source commit and version. Retries return the same allocation.
  """
  allocateBuildNumberFromJob(applicationId: String!, buildKey: String, jobId: UUID!, minimum: String, platform: String!, sourceVersion: String!): GitAppBuildNumber!
  """
  Reads the selected TestFlight beta or full App Store review state once; the agent polls this action.
  """
  appStoreReviewFromJob(environmentKey: String!, jobId: UUID!, mode: GitReleaseAppStoreReviewMode!, repository: String, target: String): GitAppStoreReviewOutcome!
  """
  Append log lines to a pipeline step. Called by CLI runners during execution.
  """
  appendPipelineLogs(jobId: UUID!, lines: [LogLineInput!]!, repositoryId: UUID!, runId: UUID!, stepId: UUID!): Boolean!
  """
  Approves an approval-gated job (approve-when-ready: dependencies and requirements must have cleared). An approved gate completes immediately.
  """
  approvePipelineJob(comment: String, jobId: UUID!): GitPipelineJob!
  """Archive a repository, preventing further pushes."""
  archiveRepository(id: UUID!): GitRepository!
  """
  Assigns a principal to a schedule. Self/admin assignments activate immediately; another person's assignment waits for confirmation. Requires MANAGE permission.
  """
  assignPipelineSchedule(principalId: UUID!, scheduleId: UUID!): ScheduledJob!
  """Assign a profile to a pull request."""
  assignPullRequest(id: UUID!, profileId: UUID!): GitPullRequest!
  """Create a backup bundle and return the storage path."""
  backupRepository(repositoryId: UUID!): String!
  """
  Cancel exactly one queued or running pipeline job. Requires EDIT permission.
  """
  cancelPipelineJob(jobId: UUID!): GitPipelineJob!
  """Cancel a running pipeline. Requires EDIT permission."""
  cancelPipelineRun(id: UUID!): GitPipelineRun!
  """
  Claim the requested job, or the next available job matching the agent's labels when jobId is omitted.
  """
  claimJob(agentId: UUID!, jobId: UUID, labels: [String!]!): GitPipelineJob
  """
  Clears a schedule assignment. The assigned principal or a repository manager may clear it.
  """
  clearPipelineScheduleAssignment(scheduleId: UUID!): ScheduledJob!
  """Close a pull request without merging."""
  closePullRequest(id: UUID!): GitPullRequest!
  """
  Commit a file to a repository branch. Creates or updates the file at the given path.
  """
  commitFile(input: CommitFileInput!): CommitFileResult!
  """
  Set the orchestrator's provider configuration (credentials, VM profiles, limits). Requires system admin.
  """
  configureOrchestrator(agentId: UUID!, config: GitOrchestratorConfigInput!): GitPipelineAgent!
  """
  Confirms a pending schedule assignment. The assigned principal or an administrator may confirm.
  """
  confirmPipelineScheduleAssignment(scheduleId: UUID!): ScheduledJob!
  """
  Create a branch from a source ref (branch name, tag name, or SHA). Requires EDIT permission.
  """
  createBranch(branchName: String!, repositoryId: UUID!, sourceRef: String!): GitBranchInfo!
  """Create a branch protection rule. Requires MANAGE permission."""
  createBranchProtectionRule(input: GitBranchProtectionRuleInput!, repositoryId: UUID!): GitBranchProtectionRule!
  """Create a pull request."""
  createPullRequest(input: CreateGitPullRequestInput!): GitPullRequest!
  """
  The uses:tag action — creates a release tag from a running job; the runs it triggers inherit this run's initiating principal. tag defaults to the run's release.version. Idempotent: same commit no-ops, a different commit fails.
  """
  createReleaseTag(jobId: UUID!, message: String, repository: String!, tag: String): GitCreateTagResult!
  """Create a new repository."""
  createRepository(input: CreateGitRepositoryInput!): GitRepository!
  """Create a webhook. Requires MANAGE permission."""
  createWebhook(input: GitWebhookInput!, repositoryId: UUID!): GitWebhook!
  """
  Decrypt secrets for a pipeline job. Called by CLI runners before step execution.
  """
  decryptPipelineSecrets(names: [String!]!, repositoryId: UUID!): [DecryptedSecret!]!
  """
  Delete a branch. Refuses the default branch and branches matching a protection rule. Fires BRANCH_DELETED webhooks. Requires EDIT permission.
  """
  deleteBranch(branchName: String!, repositoryId: UUID!): Boolean!
  """Delete a branch protection rule. Requires MANAGE permission."""
  deleteBranchProtectionRule(id: UUID!): Boolean!
  """Delete a file from a repository branch."""
  deleteFile(authorEmail: String!, authorName: String!, branch: String! = "main", path: String!, repositoryId: UUID!): CommitFileResult!
  """
  Permanently delete a terminal pipeline run and its logs and artifacts. Requires MANAGE permission.
  """
  deletePipelineRun(id: UUID!): Boolean!
  """Delete a pipeline secret. Requires MANAGE permission."""
  deletePipelineSecret(name: String!, repositoryId: UUID!): Boolean!
  """Soft-delete a repository. Data retained for 30 days."""
  deleteRepository(id: UUID!): GitRepository!
  """
  Delete a tag (name without the refs/tags/ prefix). Fires TAG_DELETED webhooks. Requires EDIT permission.
  """
  deleteTag(repositoryId: UUID!, tag: String!): Boolean!
  """Delete a webhook. Requires MANAGE permission."""
  deleteWebhook(id: UUID!): Boolean!
  """
  The uses:deploy action — deploys an environment per the target repository's .bosca/deploy.yaml; environment permission evaluated against the run's initiating principal. repository defaults to the job's own; overrides are step-level config-key overrides.
  """
  deployFromJob(environmentKey: String!, jobId: UUID!, overrides: JSON, repository: String, target: String): GitReleaseDeployOutcome!
  """
  Deregister a build agent. Requires system admin or agent self-deregister.
  """
  deregisterAgent(id: UUID!): Boolean!
  """Fork a repository into a new owner's namespace."""
  forkRepository(input: ForkGitRepositoryInput!): GitRepository!
  generateReleaseNotesFromJob(jobId: UUID!): Boolean!
  """
  Retrieve the orchestrator's provider configuration. Called by the CLI on startup.
  """
  getOrchestratorConfig(agentId: UUID!): GitOrchestratorConfig
  """Import a repository from an external clone URL."""
  importRepository(cloneUrl: String!, name: String!, ownerId: UUID!, slug: String!): GitRepository!
  """Mark a draft pull request as ready for review."""
  markPullRequestReady(id: UUID!): GitPullRequest!
  """
  The uses:mark-released action — stamps the run's workops release released; idempotent.
  """
  markReleasedFromJob(jobId: UUID!): Boolean!
  """Merge a pull request using the specified strategy."""
  mergePullRequest(id: UUID!, strategy: GitMergeStrategy!): GitPullRequest!
  """
  Merge every unresolved dependency in dependency-first order, then merge the requested pull request.
  """
  mergePullRequestWithDependencies(id: UUID!, strategy: GitMergeStrategy!): [GitPullRequest!]!
  """
  The uses:play-rollout action — advances a Google Play staged rollout to a store-neutral percentage (0–100) without re-uploading.
  """
  playRolloutFromJob(environmentKey: String!, jobId: UUID!, repository: String, rolloutPercentage: Float!, target: String): GitReleaseDeployOutcome!
  """Record a CI/CD commit status check."""
  recordCommitStatus(commitSha: String!, context: String!, description: String, repositoryId: UUID!, state: GitCommitStatusState!, targetUrl: String): GitCommitStatus!
  """Register a persistent build agent. Requires system admin."""
  registerAgent(labels: [String!]!, mode: GitAgentMode!, name: String!): GitPipelineAgentRegistration!
  """
  Register a transient agent scoped to a single job. Called by orchestrators.
  """
  registerEphemeralAgent(jobId: UUID!, labels: [String!]!, name: String!, parentAgentId: UUID!, timeoutMinutes: Int!): GitPipelineAgentRegistration!
  """
  Rejects an approval-gated job — the job fails with the rejection recorded.
  """
  rejectPipelineJob(comment: String, jobId: UUID!): GitPipelineJob!
  """
  Revoke a permission action from a group on a repository. Requires MANAGE permission.
  """
  removePermission(permission: PermissionInput!): Boolean!
  """Revokes a secret grant. Requires MANAGE permission."""
  removePipelineSecretPermission(action: PermissionAction!, groupId: UUID!, name: String!, repositoryId: UUID!): Boolean!
  """Remove a direct pull request dependency."""
  removePullRequestDependency(dependencyId: UUID!, id: UUID!): GitPullRequest!
  """Remove a query's git source ref."""
  removeQuerySourceRef(queryId: UUID!): Boolean!
  """Remove a script's git source ref, reverting to database-only source."""
  removeScriptSourceRef(scriptId: UUID!): Boolean!
  """
  Rename a repository's slug (the clone-URL path segment). Breaking for existing clones, which must be re-pointed at the new URL; physical storage is unaffected. Requires MANAGE permission.
  """
  renameRepository(id: UUID!, newSlug: String!): GitRepository!
  """Reopen a previously closed pull request."""
  reopenPullRequest(id: UUID!): GitPullRequest!
  """
  Report a commit status check. Called by CLI runners to update CI status.
  """
  reportCommitStatus(commitSha: String!, context: String!, description: String, jobId: UUID, repositoryId: UUID!, state: GitCommitStatusState!, targetUrl: String): Boolean!
  """
  Re-runs only a terminal run's FAILED/CANCELLED jobs — succeeded jobs keep their results; the run keeps its identity.
  """
  rerunFailedJobs(runId: UUID!): GitPipelineRun!
  """Re-run a pipeline at the same commit. Requires EDIT permission."""
  rerunPipeline(runId: UUID!): GitPipelineRun!
  """
  Re-run exactly one failed or cancelled pipeline job in its existing run. Requires EDIT permission.
  """
  rerunPipelineJob(jobId: UUID!): GitPipelineJob!
  """
  Resolves a running job's secrets for its agent: only what the pipeline declared (or the legacy repository set), honoring environment scopes, evaluated against the run's initiating principal.
  """
  resolveJobSecrets(jobId: UUID!): [DecryptedSecret!]!
  """Resolve all comments in a thread at the given file and line."""
  resolveReviewThread(filePath: String!, lineNumber: Int!, pullRequestId: UUID!): Boolean!
  """Restore a soft-deleted repository."""
  restoreRepository(id: UUID!): GitRepository!
  """
  The uses:rollback action — target-honest rollback (helm restores the revision AND reverts the ops-repo values). toRevision 0 = the previous revision.
  """
  rollbackFromJob(environmentKey: String!, jobId: UUID!, overrides: JSON, repository: String, target: String, toRevision: Int): GitReleaseDeployOutcome!
  """Run garbage collection on a repository. Requires MANAGE permission."""
  runGc(repositoryId: UUID!): Boolean!
  """
  Runs a queued requirement-waiting job anyway, or reopens a terminal requirement failure, while preserving same-run dependencies, conditions, and approvals. Requires EDIT permission.
  """
  runPipelineJobAnyway(jobId: UUID!, reason: String): GitPipelineJob!
  """
  Run garbage collection on a repository: compacts all packs into a single self-contained pack and updates the stored disk-size metric. Requires MANAGE permission. Use to repair repos whose RECEIVE packs were stored without thickening, or to reduce disk footprint after large deletes.
  """
  runRepositoryGc(id: UUID!): GitRepository!
  """
  Repair a repository by running GC with bitmap generation disabled and pack index v2. Requires MANAGE permission. Use when bitmaps have become corrupt or when standard GC fails on legacy thin-pack data.
  """
  runRepositoryRepair(id: UUID!): GitRepository!
  """
  Record the cloud provider instance ID for an agent (e.g., DigitalOcean droplet ID). Called by orchestrators after provisioning so the VM can be reconciled on restart.
  """
  setAgentInstanceId(agentId: UUID!, instanceId: String!): Boolean!
  """Set a pipeline secret. Requires MANAGE permission."""
  setPipelineSecret(environmentKey: String, name: String!, repositoryId: UUID!, value: String!): GitPipelineSecretInfo!
  """Link a query to a git file."""
  setQuerySourceRef(path: String!, queryId: UUID!, ref: String!, repositoryId: UUID!): GitQuerySourceRef!
  """
  Link a script to a git file. Git becomes source of truth for the script's source.
  """
  setScriptSourceRef(path: String!, ref: String!, repositoryId: UUID!, scriptId: UUID!): GitScriptSourceRef!
  """
  Runs one Play-vitals crash-rate gate. Continuous telemetry remains in the Pipelines engine.
  """
  storeHealthFromJob(environmentKey: String!, jobId: UUID!, maxCrashRate: Float!, repository: String, target: String, windowSeconds: Long!): GitStoreHealthOutcome!
  """Submit a review on a pull request."""
  submitReview(input: SubmitGitReviewInput!): GitReview!
  """Manually trigger sync for all source refs in a repository."""
  syncSourceRefs(repositoryId: UUID!): Int!
  """Transfer a repository to a new owner."""
  transferRepository(id: UUID!, newOwnerId: UUID!): GitRepository!
  """
  Manually trigger a pipeline run with its declared inputs. Requires EXECUTE permission.
  """
  triggerPipeline(inputs: [GitPipelineInputValueInput!], pipelineId: UUID!, ref: String!): GitPipelineRun!
  """Remove an assignee from a pull request."""
  unassignPullRequest(id: UUID!, profileId: UUID!): GitPullRequest!
  """Update a build agent's name and labels. Requires MANAGE permission."""
  updateAgent(id: UUID!, labels: [String!]!, name: String!): GitPipelineAgent!
  """Update a branch protection rule. Requires MANAGE permission."""
  updateBranchProtectionRule(id: UUID!, input: GitBranchProtectionRuleInput!): GitBranchProtectionRule!
  """
  Update a job's status and optional failure summary. Called by CLI runners after execution.
  """
  updateJobStatus(errorMessage: String, jobId: UUID!, status: GitPipelineRunStatus!): GitPipelineJob!
  """Update a pull request's title or description."""
  updatePullRequest(id: UUID!, input: UpdateGitPullRequestInput!): GitPullRequest!
  """Update mutable fields on a repository."""
  updateRepository(id: UUID!, input: UpdateGitRepositoryInput!): GitRepository!
  """
  Update a step's status, exit code, and failure summary. Called by CLI runners during execution.
  """
  updateStepStatus(errorMessage: String, exitCode: Int, status: GitPipelineRunStatus!, stepId: UUID!): Boolean!
  """Update a webhook. Requires MANAGE permission."""
  updateWebhook(id: UUID!, input: GitWebhookInput!): GitWebhook!
}

"""Server-side configuration for an orchestrator agent."""
type GitOrchestratorConfig {
  alertSinks: [GitAlertSink!]!
  credentials: GitProviderCredentials!
  defaults: GitVmDefaults!
  maxConcurrentVms: Int!
  maxJobTimeoutMinutes: Int!
  maxVmLifetimeMinutes: Int!
  provider: String!
  """
  Maps runner labels to VM profiles. Key is the label, value is the profile.
  """
  runnerProfiles: JSON!
}

"""Input for configuring an orchestrator agent."""
input GitOrchestratorConfigInput {
  alertSinks: [GitAlertSinkInput!]
  credentials: GitProviderCredentialsInput!
  defaults: GitVmDefaultsInput!
  maxConcurrentVms: Int
  maxJobTimeoutMinutes: Int
  maxVmLifetimeMinutes: Int
  provider: String!
  """
  Maps runner labels to VM profiles as JSON. Example: {"linux-8cpu": {"size": "s-8vcpu-16gb"}}
  """
  runnerProfiles: JSON
}

"""A CI/CD pipeline defined by a YAML file in the repository."""
type GitPipeline {
  created: DateTime!
  """Path to the YAML file (e.g., .bosca/pipelines/build.yaml)."""
  filePath: String!
  id: UUID!
  name: String!
  repositoryId: UUID!
  """Recent runs of this pipeline."""
  runs(limit: Int, offset: Long): [GitPipelineRun!]!
  """
  Server-owned execution assignments for this pipeline's default-branch schedule triggers.
  """
  schedules: [ScheduledJob!]!
  """Trigger types configured on this pipeline (from its YAML `on:` block)."""
  triggerTypes: [GitPipelineTriggerType!]!
  updated: DateTime!
}

"""A registered build agent."""
type GitPipelineAgent {
  created: DateTime!
  """The job this agent is currently executing, if any."""
  currentJob: GitPipelineJob
  """
  Whether this agent was created for a single job and will be destroyed after.
  """
  ephemeral: Boolean!
  expiresAt: DateTime
  id: UUID!
  """Hypervisor instance ID (e.g., DigitalOcean droplet ID)."""
  instanceId: String
  """The job this transient agent is scoped to."""
  jobId: UUID
  labels: [String!]!
  lastHeartbeat: DateTime
  mode: GitAgentMode!
  name: String!
  """The orchestrator agent that spawned this transient agent."""
  parentAgentId: UUID
  """Recent jobs assigned to this agent."""
  recentJobs(limit: Int): [GitPipelineJob!]!
  status: GitAgentStatus!
}

"""Returned when registering a new agent. Token is only shown once."""
type GitPipelineAgentRegistration {
  agent: GitPipelineAgent!
  """
  The agent token. Only returned at registration time — store it securely.
  """
  token: String!
}

"""A build artifact produced by a pipeline run."""
type GitPipelineArtifact {
  created: DateTime!
  id: UUID!
  name: String!
  pipelineRunId: UUID!
  repositoryId: UUID!
  runNumber: Int!
  sizeBytes: Long!
}

"""A named input accepted by the pipeline's manual trigger."""
type GitPipelineInputDefinition {
  """Default text applied when the input is omitted."""
  defaultValue: String
  description: String
  name: String!
  options: [String!]!
  required: Boolean!
  type: GitPipelineInputType!
}

enum GitPipelineInputType {
  BOOLEAN
  CHOICE
  NUMBER
  STRING
}

"""
A named input value, validated against the declaration at the run's commit.
"""
input GitPipelineInputValueInput {
  name: String!
  """
  Text representation of the declared string, boolean, number, or choice value.
  """
  value: String!
}

"""A job within a pipeline run."""
type GitPipelineJob {
  """The agent assigned to this job, if any."""
  agent: GitPipelineAgent
  agentId: UUID
  """The approver's comment."""
  approvalComment: String
  """
  Whether this job parks for human approval before dispatch (its own approval flag or its environment's policy).
  """
  approvalRequired: Boolean!
  """
  When the job was approved; an approval-required job dispatches only after this is set.
  """
  approvedAt: DateTime
  """Who approved the job."""
  approvedBy: UUID
  """
  Which execution attempt this is (1 = first run; incremented by re-run-failed).
  """
  attempt: Int!
  """
  True while the job is parked at its approval gate: queued, unapproved, every earlier gate cleared.
  """
  awaitingApproval: Boolean!
  """
  True while this queued job is waiting on unmet requirements — the 'waiting on requirements' state.
  """
  awaitingRequirements: Boolean!
  """
  The job's deferred if: condition (references needs.* or always()/failure()/cancelled()); evaluated when its dependencies settle. Null for ordinary jobs.
  """
  condition: String
  """
  When the deferred condition evaluated true — a deferred job dispatches only after this is set.
  """
  conditionSatisfiedAt: DateTime
  dependsOn: [String!]!
  """The environment KEY this job targets; null for ordinary jobs."""
  environment: String
  """
  Failure summary for job-level failures outside any step (disk check, secret decryption, dead agent, timeout).
  """
  errorMessage: String
  finished: DateTime
  id: UUID!
  matrixValues: JSON
  name: String!
  """
  Pipeline requirements gating dispatch: upstream pipeline runs that must SUCCEED first, correlation refs resolved at run creation.
  """
  pipelineRequirements: JSON
  pipelineRunId: UUID!
  """
  Artifact requirements gating dispatch: the declared list with coordinates resolved at run creation.
  """
  requirements: JSON
  """The optional explanation supplied with the requirement override."""
  requirementsBypassReason: String
  """When a user explicitly bypassed external requirements for this job."""
  requirementsBypassedAt: DateTime
  """The principal that explicitly bypassed external requirements."""
  requirementsBypassedBy: UUID
  """
  The earliest requirement-timeout expiry; a job still waiting past this fails, naming the unmet dependencies.
  """
  requirementsDeadline: DateTime
  """
  When the requirement checker verified every requirement (artifacts and pipelines); null while waiting (and for ungated jobs).
  """
  requirementsSatisfiedAt: DateTime
  runnerLabel: String!
  """
  The secret NAMES this job may resolve (declared by the pipeline); empty = the legacy repository set.
  """
  secretNames: [String!]!
  started: DateTime
  status: GitPipelineRunStatus!
  """Steps within this job."""
  steps: [GitPipelineStep!]!
  timeoutMinutes: Int
}

"""Log output from a pipeline step."""
type GitPipelineLogLine {
  content: String!
  lineNumber: Int!
  stream: String!
  timestamp: DateTime!
}

"""A single execution of a pipeline."""
type GitPipelineRun {
  """Build artifacts uploaded during this run."""
  artifacts: [GitPipelineArtifact!]!
  commitSha: String!
  concurrencyGroup: String
  created: DateTime!
  """Duration in seconds, null if not started."""
  durationSeconds: Long
  finished: DateTime
  id: UUID!
  """Jobs within this run."""
  jobs: [GitPipelineJob!]!
  """Per-pipeline auto-incrementing number."""
  number: Int!
  """
  The effective trigger parameters (dotted keys: release.*, promotion.*, inputs.*) the run was started with.
  """
  parameters: JSON!
  pipelineId: UUID!
  ref: String!
  repositoryId: UUID!
  started: DateTime
  status: GitPipelineRunStatus!
  triggerType: GitPipelineTriggerType!
  triggeredBy: UUID
}

"""State of a CI/CD pipeline run or job."""
enum GitPipelineRunStatus {
  CANCELLED
  FAILURE
  QUEUED
  RUNNING
  SKIPPED
  SUCCESS
}

"""
A secret available to pipelines (name only, value never exposed via API).
"""
type GitPipelineSecretInfo {
  created: DateTime!
  """
  When set, the secret resolves only for jobs bound to this environment key.
  """
  environmentKey: String
  id: UUID!
  name: String!
  updated: DateTime!
}

"""A repository-scoped real-time pipeline status event."""
type GitPipelineStatusEvent {
  pipelineId: UUID!
  pipelineRunId: UUID!
  repositoryId: UUID!
  status: GitPipelineRunStatus!
}

"""An individual step within a pipeline job."""
type GitPipelineStep {
  condition: String
  env: JSON!
  """
  Failure summary from the tail of the step's log output, set by the agent when the step fails.
  """
  errorMessage: String
  exitCode: Int
  finished: DateTime
  id: UUID!
  image: String
  name: String!
  ordinal: Int!
  pipelineJobId: UUID!
  run: String
  started: DateTime
  status: GitPipelineRunStatus!
  uses: String
  with: JSON!
  workingDirectory: String
}

"""What triggered a pipeline run."""
enum GitPipelineTriggerType {
  MANUAL
  PROMOTION
  PULL_REQUEST
  PUSH
  RELEASE
  SCHEDULE
  TAG
}

"""
Provider credential metadata. Actual API tokens are supplied via CLI local config.
"""
type GitProviderCredentials {
  selfDestructTokenScope: String
}

input GitProviderCredentialsInput {
  selfDestructTokenScope: String
}

"""A pull request within a repository."""
type GitPullRequest {
  """Profile IDs of users assigned to this PR."""
  assigneeIds: [UUID!]!
  """Resolved assignee profiles."""
  assignees: [Profile!]!
  """Profile ID of the PR author."""
  authorId: UUID!
  """Files with merge conflicts, if any."""
  conflictingFiles: [String!]!
  created: DateTime!
  """Pull requests that must be merged before this pull request."""
  dependencies: [GitPullRequest!]!
  """Pull requests that directly depend on this pull request."""
  dependents: [GitPullRequest!]!
  """Markdown description."""
  description: String
  """Structured diff between source and target branches."""
  diff: [GitDiffFile!]!
  id: UUID!
  """The SHA of the merge commit."""
  mergeSha: String
  """The strategy used when merged."""
  mergeStrategy: GitMergeStrategy
  """Whether the PR can be cleanly merged."""
  mergeable: Boolean!
  mergedAt: DateTime
  mergedBy: UUID
  """Per-repository auto-incrementing number (e.g. #42)."""
  number: Int!
  """The repository this PR belongs to."""
  repositoryId: UUID!
  """Reviews submitted on this PR."""
  reviews: [GitReview!]!
  sourceBranch: String!
  """Non-null for cross-fork PRs."""
  sourceRepositoryId: UUID
  status: GitPullRequestStatus!
  targetBranch: String!
  title: String!
  updated: DateTime!
}

enum GitPullRequestActivityAction {
  ASSIGNED
  CLOSED
  COMMENTED
  MERGED
  OPENED
  READY_FOR_REVIEW
  REOPENED
  REVIEWED
  SOURCE_UPDATED
  THREAD_RESOLVED
  UNASSIGNED
  UPDATED
}

"""A repository-scoped real-time pull-request activity event."""
type GitPullRequestActivityEvent {
  action: GitPullRequestActivityAction!
  actorId: UUID
  actorName: String
  assigneeId: UUID
  authorId: UUID!
  body: String
  filePath: String
  lineNumber: Int
  number: Int!
  pullRequestId: UUID!
  recipientIds: [UUID!]!
  repositoryId: UUID!
  repositoryName: String!
  reviewStatus: GitReviewStatus
  sourceBranch: String!
  targetBranch: String!
  taskKeys: [String!]!
  title: String!
}

"""Lifecycle state of a pull request."""
enum GitPullRequestStatus {
  CLOSED
  DRAFT
  MERGED
  OPEN
}

"""Links an analytics query to a git file."""
type GitQuerySourceRef {
  path: String!
  queryId: UUID!
  ref: String!
  repositoryId: UUID!
  resolvedCommit: String
}

enum GitReleaseAppStoreReviewMode {
  APP_STORE
  BETA
}

"""Result of the uses:deploy action (deployFromJob)."""
type GitReleaseDeployOutcome {
  """
  Target-native reference for humans (e.g. release@revision, a Play track).
  """
  reference: String!
  """The recorded deployment status."""
  status: String!
}

"""Repository-level statistics."""
type GitRepoStats {
  branchCount: Int!
  commitCount: Long!
  contributorCount: Int!
  diskSizeBytes: Long!
  tagCount: Int!
}

"""A Bosca-hosted git repository."""
type GitRepository {
  """Whether the repository is archived (read-only)."""
  archived: Boolean!
  """The fully-qualified HTTP clone URL for this repository."""
  cloneUrl: String!
  """Merge and commit policy configuration."""
  configuration: GitRepositoryConfiguration!
  """The intended content classification."""
  contentType: GitRepositoryContentType
  """When the repository was created."""
  created: DateTime!
  """The branch used as the default for PRs and browsing."""
  defaultBranch: String!
  """Whether the repository has been soft-deleted."""
  deleted: Boolean!
  """Optional description."""
  description: String
  """Total storage consumed in bytes."""
  diskSizeBytes: Long!
  """The repository this was forked from, if any."""
  forkedFromId: UUID
  """Unique identifier."""
  id: UUID!
  """Display name."""
  name: String!
  """The owner's profile or organization ID."""
  ownerId: UUID!
  """
  Permission grants on this repository. Only visible to users with MANAGE permission.
  """
  permissions: [Permission!]!
  """URL-safe identifier used in clone URLs. Immutable after creation."""
  slug: String!
  """When the repository was last updated."""
  updated: DateTime!
  """Access visibility level."""
  visibility: GitVisibility!
}

"""Configurable policies for merge behaviour and commit requirements."""
type GitRepositoryConfiguration {
  """Whether the source branch is deleted after a successful PR merge."""
  deleteBranchOnMerge: Boolean!
  """The merge strategies permitted when completing pull requests."""
