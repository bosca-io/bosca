  """Whether pushed commits must carry a valid GPG signature."""
  requireSignedCommits: Boolean!
  """Whether squash is pre-selected in the merge dialog."""
  squashByDefault: Boolean!
}

"""Classifies the intended content of a repository."""
enum GitRepositoryContentType {
  """
  Contains AI agent, tool, MCP server, and prompt definitions as Markdown files with YAML frontmatter.
  """
  AGENT_PROJECT
  """Contains analytic query definitions."""
  ANALYTIC_QUERY_PROJECT
  """Contains documentation files."""
  DOCUMENTATION
  """General-purpose repository."""
  GENERAL
  """Contains pipeline definitions as YAML files."""
  PIPELINE_PROJECT
  """Contains script source files for the scripting engine."""
