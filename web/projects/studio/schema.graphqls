  messageId: UUID!
  openedAt: DateTime
  recipientEmail: String
  recipientId: UUID!
  recipientName: String
  status: DeliveryStatusType!
  updatedAt: DateTime!
}

enum DeliveryStatusType {
  BOUNCED
  CLICKED
  DEFERRED
  DELIVERED
  DROPPED
  FAILED
  OPENED
  PENDING
  SENT
  SPAM_REPORT
  UNSUBSCRIBED
}

"""Recent aggregate delivery statuses and their total count."""
type DeliveryStatuses {
  statuses: [RecipientDeliveryStatus!]!
  total: Long!
}

"""
A registered client installation, optionally associated with the currently signed-in principal.
"""
type Device {
