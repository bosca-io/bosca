  namespace: String
  projectId: UUID!
  publishedAt: DateTime
  publishedByPrincipalId: UUID
  repositoryUrl: String
  status: WorkOpsPublicationStatus!
  version: Long!
  versionId: UUID!
}

enum WorkOpsArtifactType {
  ANDROID_AAR
  DOCKER
  GRAALVM_NATIVE
  HELM
  HELM_VALUES
  IOS_FRAMEWORK
  MAVEN
  NPM
  OTHER
  WASM
}

"""
R16 — attachments. Uploads round-trip through a presigned URL +
HMAC confirmation token; the storage object id is opaque to the
client.
"""
type WorkOpsAttachment {
  contentType: String!
  description: String
  filename: String!
  id: UUID!
  sizeBytes: Long!
  storageObjectId: UUID
  taskId: UUID!
  thumbnailStorageObjectId: UUID
  uploadedAt: DateTime!
  uploadedByProfileId: UUID!
}

type WorkOpsAttachmentMutation {
  confirmUpload(description: String, token: String!): WorkOpsAttachment!
  deleteAttachment(id: UUID!): Boolean!
  requestUpload(contentType: String!, filename: String!, sizeBytes: Long!, taskId: UUID!): WorkOpsPresignedUpload!
}

type WorkOpsAttachmentQuery {
  attachment(id: UUID!): WorkOpsAttachment
  forTask(taskId: UUID!): [WorkOpsAttachment!]!
}

type WorkOpsAutomationExecutionLog {
  durationMs: Long
  errorMessage: String
  finishedAt: DateTime
  id: UUID!
  outcome: String!
  ruleId: UUID!
  startedAt: DateTime!
  taskId: UUID
}

type WorkOpsAutomationMutation {
  create(input: WorkOpsAutomationRuleInput!): WorkOpsAutomationRule!
  delete(id: UUID!): Boolean!
  setEnabled(enabled: Boolean!, expectedVersion: Long!, id: UUID!): WorkOpsAutomationRule!
  update(expectedVersion: Long!, id: UUID!, input: WorkOpsAutomationRuleInput!): WorkOpsAutomationRule!
}

type WorkOpsAutomationQuery {
  executionLogs(limit: Int!, offset: Long!, ruleId: UUID!): [WorkOpsAutomationExecutionLog!]!
  rule(id: UUID!): WorkOpsAutomationRule
  rules(scope: String!, scopeId: UUID): [WorkOpsAutomationRule!]!
}

"""
R14 — automation rules. The trigger / conditions / actions ride
as JSON blobs over the wire because the underlying sealed
hierarchies have many variants — admins author them through
templates in the workops admin UI rather than raw GraphQL.
"""
type WorkOpsAutomationRule {
  """List of `Action` discriminated objects."""
  actions: JSON!
  """List of `Condition` discriminated objects."""
  conditions: JSON!
  description: String
  enabled: Boolean!
  executionLogRetentionDays: Int!
  failureMode: String!
  id: UUID!
  maxFiresPerTaskPerHour: Int!
  name: String!
  runAsProfileId: UUID!
  scope: String!
  scopeId: UUID
  """Discriminated `{ "type": "TaskCreated", ... }` blob."""
  trigger: JSON!
  version: Long!
}

input WorkOpsAutomationRuleInput {
  actions: JSON!
  conditions: JSON!
  description: String
  enabled: Boolean!
  executionLogRetentionDays: Int!
  failureMode: String!
  maxFiresPerTaskPerHour: Int!
  name: String!
  runAsProfileId: UUID!
  scope: String!
  scopeId: UUID
  trigger: JSON!
}

"""
A configurable view onto tasks from one or more projects. Scope
options (at most one parent; all null = multi-project board):
- projectId: single-project board
- programId: program-scoped board (all projects in program)
- portfolioId: portfolio-scoped board
- all null: standalone multi-project board (scope from `projects`)
"""
type WorkOpsBoard {
  columns: [WorkOpsBoardColumn!]!
  createdAt: DateTime!
  """Saved filter id."""
  filterId: UUID
  id: UUID!
  modifiedAt: DateTime!
  name: String!
  portfolio: WorkOpsPortfolio
  portfolioId: UUID
  program: WorkOpsProgram
  programId: UUID
  project: WorkOpsProject
  projectId: UUID
  """
  Explicit project membership (populated for all boards including single-project).
  """
  projects: [WorkOpsProject!]!
  sprints(limit: Int! = 50, offset: Long! = 0): [WorkOpsSprint!]!
  """Optional sub-filter for kanban swimlanes."""
  subFilterId: UUID
  swimlaneStrategy: WorkOpsSwimlaneStrategy!
  type: WorkOpsBoardType!
  version: Long!
}

"""
One column on a WorkOpsBoard. Columns collect tasks whose status is in
[statusIds]; dragging a card across columns issues the workflow
transition that lands the task in one of the target column's
statuses (R8 — boards never bypass the workflow).
"""
type WorkOpsBoardColumn {
  boardId: UUID!
  displayOrder: Int!
  id: UUID!
  name: String!
  statusIds: [UUID!]!
  statuses: [WorkOpsStatus!]!
  wipLimit: Int
}

enum WorkOpsBoardType {
  KANBAN
  SCRUM
}

type WorkOpsBoards {
  board(id: UUID!): WorkOpsBoard
  byPortfolio(portfolioId: UUID!): [WorkOpsBoard!]!
  byProgram(programId: UUID!): [WorkOpsBoard!]!
  byProject(projectId: UUID!): [WorkOpsBoard!]!
  """Find multi-project boards that include any of the given project IDs."""
  byProjects(projectIds: [UUID!]!): [WorkOpsBoard!]!
}

type WorkOpsBoardsMutation {
  addColumn(input: CreateWorkOpsBoardColumnInput!): WorkOpsBoardColumn!
  create(input: CreateWorkOpsBoardInput!): WorkOpsBoard!
  delete(boardId: UUID!): Boolean!
  deleteColumn(columnId: UUID!): Boolean!
  update(id: UUID!, input: UpdateWorkOpsBoardInput!): WorkOpsBoard!
  updateColumn(input: UpdateWorkOpsBoardColumnInput!): WorkOpsBoardColumn!
}

"""
A parser / validator failure carrying the byte-offset window of the
offending source span. The Excellence Bar non-negotiable requires
LLM-readable parser errors; the [start] / [end] bounds let an LLM
pick the exact characters to fix on retry.
"""
type WorkOpsBqlError {
  """Byte offset just past the last character of the offending span."""
  end: Int!
  """One-line 'did you mean' suggestion when the fix is unambiguous."""
  hint: String
  message: String!
  """Byte offset of the first character of the offending span (inclusive)."""
  start: Int!
}

"""
Result of `validateBql` — empty `errors` means the query parses and
validates against the field catalog cleanly.
"""
type WorkOpsBqlValidationResult {
  errors: [WorkOpsBqlError!]!
}

enum WorkOpsBreakingChangeLevel {
  DEPRECATION
  MAJOR_BREAKING
  MINOR_BREAKING
  NONE
}

type WorkOpsBuildBlocker {
  apiSurfaceReportId: UUID
  blockerType: WorkOpsBuildBlockerType!
  compatibilityTestId: UUID
  description: String!
  providerProjectId: UUID!
  providerVersionId: UUID
}

enum WorkOpsBuildBlockerType {
  COMPILE_CHECK_FAILED
  COMPILE_CHECK_PENDING
  INCOMPATIBLE_DEPENDENCY
  PROVIDER_ARTIFACTS_MISSING
}

type WorkOpsBuildReadiness {
  blockers: [WorkOpsBuildBlocker!]!
  ready: Boolean!
}

"""
Closing a sprint disposes of every still-open task. The
`destinations` map keys each (committed + added) task id to a
target sprint id (or null to drop to backlog). Missing entries
raise `SPRINT_CLOSE_UNFINISHED` with the missing ids enumerated.
"""
input WorkOpsCloseSprintDestination {
  """Target sprint id; null sends the task back to the project's backlog."""
  targetSprintId: UUID
  taskId: UUID!
}

enum WorkOpsCompatibilityStatus {
  FAILED
  PASSED
  PENDING
  SKIPPED
}

type WorkOpsCompatibilityTestResult {
  breakingChangesDetected: Boolean!
  consumerProjectId: UUID!
  consumerVersionId: UUID!
  id: UUID!
  pipelineRunId: UUID
  providerProjectId: UUID!
  providerVersionId: UUID!
  resultUrl: String
  status: WorkOpsCompatibilityStatus!
  testSuite: String!
  testedAt: DateTime!
  version: Long!
}

"""
A team / codebase ownership tag inside a project. Multiple
components per task are supported through `WorkOpsTask.componentIds`.
"""
type WorkOpsComponent {
  assigneeMode: WorkOpsComponentAssigneeMode!
  defaultAssigneeProfileId: UUID
  description: String
  id: UUID!
  leadProfileId: UUID
  name: String!
  project: WorkOpsProject!
  projectId: UUID!
  version: Long!
}

"""
How a component resolves a default assignee on tasks that don't
already have one (R9). The first component on the task is the one
whose mode is consulted.
"""
enum WorkOpsComponentAssigneeMode {
  COMPONENT_LEAD
  COMPONENT_LEAD_OR_PROJECT_DEFAULT
  PROJECT_DEFAULT
  UNASSIGNED
}

type WorkOpsComponents {
  byProject(projectId: UUID!): [WorkOpsComponent!]!
  component(id: UUID!): WorkOpsComponent
}

type WorkOpsComponentsMutation {
  create(input: CreateWorkOpsComponentInput!): WorkOpsComponent!
  delete(id: UUID!): Boolean!
}

type WorkOpsCrossProjectMutation {
  addAffectedProject(projectId: UUID!, taskId: UUID!): Boolean!
  bundleVersion(projectId: UUID!, releaseId: UUID!, versionId: UUID!): Boolean!
  createRelease(input: CreateWorkOpsReleaseInput!): WorkOpsRelease!
  """
  Soft-delete a release (recoverable — its row and bundle are retained, just hidden).
  """
  deleteRelease(id: UUID!): Boolean!
  """
  Start a release by creating native RELEASE runs from the bundled projects' pipeline YAML.
  """
  launchRelease(inputs: JSON, releaseId: UUID!): Boolean!
  markReleased(expectedVersion: Long!, releaseId: UUID!): WorkOpsRelease!
  moveTaskToProject(input: MoveWorkOpsTaskInput!, taskId: UUID!): UUID!
  """Promote a release through its pipeline-declared environment chain."""
  promoteRelease(input: PromoteWorkOpsReleaseInput!, releaseId: UUID!): Boolean!
  removeAffectedProject(projectId: UUID!, taskId: UUID!): Boolean!
  """
  Rolls a release ATTEMPT back so the same versions can be re-released: deletes the relay's git tags and the versions' artifact publications, and resets deployment statuses. Refused while a run is live or after the release is marked released. Store uploads are not withdrawn.
  """
  rollbackReleaseArtifacts(releaseId: UUID!): Boolean!
  """
  Roll back every current target in an environment that belongs to this release; revision 0 means previous.
  """
  rollbackReleaseEnvironment(environmentKey: String!, releaseId: UUID!, toRevision: Int! = 0): [String!]!
  """
  Create a roll-forward patch release containing only the affected projects.
  """
  startPatchRelease(input: StartWorkOpsPatchReleaseInput!, releaseId: UUID!): WorkOpsRelease!
  unbundleVersion(releaseId: UUID!, versionId: UUID!): Boolean!
  """
  Edit a release's details (name, description, planned date), optimistic-locked.
  """
  updateRelease(expectedVersion: Long!, id: UUID!, input: UpdateWorkOpsReleaseInput!): WorkOpsRelease!
}

type WorkOpsCrossProjectQuery {
  affectedProjects(taskId: UUID!): [WorkOpsTaskAffectedProject!]!
  release(id: UUID!): WorkOpsRelease
  releaseActionAccess(releaseId: UUID!): WorkOpsReleaseActionAccess
  """
  The artifact types the release's projects declare in CI — relay channels whose type no project declares will never fire, so UIs hide their plan steps.
  """
  releaseChannelArtifactTypes(releaseId: UUID!): [String!]!
  """
  Every artifact the release's projects declare in CI, coordinates resolved to each project's version — what this release WILL publish, before any build runs.
  """
  releaseDeclaredArtifacts(releaseId: UUID!): [WorkOpsReleaseDeclaredArtifact!]!
  """
  Exact dependency-ordered RELEASE and PROMOTION plans selected from attached repository YAML by git-ci.
  """
  releasePlans(releaseId: UUID!): [WorkOpsReleasePipelinePlan!]!
  """
  The launch-blocking dependency violations for the release right now (empty = ready to start) — the same list launchRelease refuses on.
  """
  releaseReadiness(releaseId: UUID!): [String!]!
  """
  The native git-ci RELEASE and PROMOTION runs correlated by their release.id parameter.
  """
  releaseRuns(releaseId: UUID!): [WorkOpsReleaseRun!]!
  releases(programId: UUID!): [WorkOpsRelease!]!
  versionsForRelease(releaseId: UUID!): [WorkOpsReleaseProjectVersion!]!
}

type WorkOpsDependencyDeclaration {
  artifactCoordinates: String
  consumerProjectId: UUID!
  consumerVersionId: UUID
  dependencyType: WorkOpsDependencyType!
  id: UUID!
  providerProjectId: UUID!
  providerVersionConstraint: String!
  resolvedProviderVersionId: UUID
  status: WorkOpsDependencyStatus!
  version: Long!
}

enum WorkOpsDependencyStatus {
  CURRENT
  INCOMPATIBLE
  OUTDATED
}

"""
V24 — Multi-repo support: dependency graph, artifact tracking,
CI/CD pipeline visibility, environment management, release gates,
compatibility testing, and release notes.
"""
enum WorkOpsDependencyType {
  BUILD
  CONTRACT
  RUNTIME
}

"""The starter .bosca/deploy.yaml committed by createProjectDeployConfig."""
type WorkOpsDeployConfigFile {
  branch: String!
  commitSha: String!
  """The generated file content, for display."""
  content: String!
  path: String!
  repositoryId: UUID!
}

input WorkOpsDeployInput {
