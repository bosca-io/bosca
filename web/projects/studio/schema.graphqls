  """Unix timestamp (seconds since epoch) when this token was issued"""
  issuedAt: Int!
  """
  The encoded JWT token string to include in the Authorization header as a Bearer token
  """
  token: String!
}

"""
A trait defines a set of behaviors and workflows that can be assigned to metadata items based on their content type
"""
