  """
  Size of the content in bytes (used for pre-signed upload URL generation)
  """
  contentLength: Long
  """
  MIME content type of the metadata item (e.g. 'image/png', 'application/pdf', 'text/html')
  """
  contentType: String!
  """
  Data template definition if this metadata item should serve as a data template
  """
  dataTemplate: DataTemplateInput
  """Structured document content to associate with this metadata item"""
  document: DocumentInput
  """
  Document template definition if this metadata item should serve as a document template
  """
  documentTemplate: DocumentTemplateInput
  """Guide content to associate with this metadata item"""
  guide: GuideInput
  """
  Guide template definition if this metadata item should serve as a guide template
  """
  guideTemplate: GuideTemplateInput
  """Freeform labels for tagging and categorizing"""
  labels: [String!]
  """
  BCP 47 language tag indicating the primary language of this content (e.g. 'en', 'es-MX')
  """
  languageTag: String!
  """Whether this metadata item should be locked from modification"""
  locked: Boolean
  """The classification type of this metadata item (standard or variant)"""
  metadataType: MetadataType
  """Display name of the metadata item"""
