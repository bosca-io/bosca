# Optional overrides; no .env file is required by Docker Compose.
# Public images: ghcr.io/bosca-io/<image>:<version>
# The defaults match the published application and image processor releases.
BOSCA_VERSION=0.0.28
BOSCA_IMAGEPROCESSOR_VERSION=0.0.26
BOSCA_IMAGE_REGISTRY=ghcr.io/bosca-io

# Browser origin. Keep this hostname consistent across Studio, auth, and signed URLs.
BOSCA_HOST=bosca.localhost
BOSCA_PORT=3000
BOSCA_GIT_PORT=8091
BOSCA_ARTIFACTS_PORT=8084

# Initial credentials apply only when a fresh database is installed.
INIT_ADMIN_PASSWORD=password
INIT_SA_PASSWORD=sa-password

# Optional integrations.
OPENAI_API_KEY=changeme
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAILER_TYPE=sendgrid
MAILER_FROM_EMAIL=noreply@example.com
# Optional read token for published BML message projects in the local Artifacts server.
# The message server uses its bundled bosca-messages project until one is published.
BML_MESSAGE_ARTIFACTS_TOKEN=
