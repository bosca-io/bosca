<component tag="workops-environment-types">
  <prop name="initial" type="bosca.workops.ui.WorkOpsEnvironmentTypesModel" required />
  <script server provides="model">bosca.workops.ui.WorkOpsEnvironmentTypesModel(initial.rows, initial.loaded, initial.offset, initial.targetId, initial.editing, initial.creating, initial.draft, initial.deleting, initial.resultId, initial.feedback)</script>
  <island name="environmentTypes" :key='"environment-types"'><page-shell class="workops-page" fill>
    <page-heading title="Environment types" subtitle="Global lifecycle stages used by program environments."><button-link href="/workops/releases/environments" size="md" icon="arrow-right">Program environments</button-link><button id="workops-environment-type-new" primary icon="plus" :disabled="!model.loaded" @click='model.open("")'>New environment type</button><icon-button size="md" icon="refresh" label="Refresh environment types" @click="model.retry(ctx)" />
        <if model.resultHref.isNotBlank()><button-link :href="model.resultHref" size="xs" icon="arrow-right" aria-label="Show the saved environment type">Saved type</button-link></if></page-heading>
    <div class="workops-content" data-workops-environment-types>

      <workops-feedback id="environment-types-0" :feedback="model.feedback" />
      <if !model.loaded><p role="status">Environment types have not been loaded. Refresh to try again.</p>
      <else-if model.pageRows.isNotEmpty()><card :padded="false"><table-scroll label="Environment types"><table><caption>Global environment types</caption><thead><tr><th scope="col">Order</th><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Actions</th></tr></thead><tbody><for row in model.pageRows><tr :id='"workops-environment-type-" + row.id' :data-workops-environment-type="row.id"><td>{ row.order }</td><td>{ row.name }</td><td>{ row.description }</td><td><form-actions align="start"><icon-button icon="edit" :label='"Edit " + row.name' @click="model.open(row.id)" /><icon-button icon="trash" :label='"Delete " + row.name' @click="model.beginDelete(row.id)" /></form-actions></td></tr></for></tbody></table></table-scroll></card><else><empty-state title="No environment types yet." /></if>
      <pagination :page="model.offset / 25 + 1" :previousHref="model.previousHref" :nextHref="model.nextHref" label="Environment type pages" />
      <dialog :title='if (model.creating) "New environment type" else "Edit environment type"' triggerLabel="Environment type" :showTrigger="false" :forceOpen="model.creating || model.editing != null" :completed="!model.creating && model.editing == null" returnFocus="#workops-environment-type-new" @dialogdismiss="model.cancel()">
        <form @submit="model.save(form.name, form.description, form.order, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert><if model.editing != null><help-text>If this type changed, cancel and refresh before editing it again.</help-text></if></if><if model.feedback.failed><form-actions align="start"><button icon="refresh" @click="model.reloadDraft(form.name, form.description, form.order, ctx)">Retry loading environment types</button></form-actions></if>
          <field label="Name"><input name="name" :value="model.draft.name" required /></field><field label="Display order"><input name="order" type="number" min="0" max="99" step="1" :value="model.draft.order" required /></field><field label="Description"><textarea name="description">{ model.draft.description }</textarea></field></form-body><form-actions bordered><button data-dialog-close @click="model.cancel()">Cancel</button><button primary type="submit">Save environment type</button></form-actions></form>
      </dialog>
      <dialog title="Delete environment type" triggerLabel="Delete environment type" :showTrigger="false" :forceOpen="model.deleting != null" :completed="model.deleting == null" returnFocus="#workops-environment-type-new" @dialogdismiss="model.cancelDelete()">
        <form @submit="model.delete(form.confirmed, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Delete { model.deleting?.name }?</p><p>A type used by a program environment must be kept until that environment selects another type.</p><checkbox name="confirmed" label="Confirm deletion" required /></form-body><form-actions bordered><button data-dialog-close @click="model.cancelDelete()">Cancel</button><button primary type="submit">Delete environment type</button></form-actions></form>
      </dialog>
    </div>
  </page-shell></island>
</component>
