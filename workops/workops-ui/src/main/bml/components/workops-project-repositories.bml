<component tag="workops-project-repositories">
  <prop name="initial" type="bosca.workops.ui.WorkOpsProjectRepositoriesModel" required />
  <script server provides="model">bosca.workops.ui.WorkOpsProjectRepositoriesModel(initial.projectId, initial.offset, initial.targetId, initial.rows, initial.choices, initial.loaded, initial.repositoryDraft, initial.authorNameDraft, initial.authorEmailDraft, initial.authorInitialized, initial.deleteTarget, initial.setupTarget, initial.generated, initial.resultId, initial.feedback)</script>
  <island name="projectRepositories" :key="initial.projectId"><div class="workops-content" data-workops-project-repositories>
    <section-heading title="Git repositories" subtitle="Repositories linked to this project"><if model.resultHref.isNotBlank()><button-link :href="model.resultHref" size="xs" icon="arrow-right">Show the attached repository</button-link></if></section-heading>
    <workops-feedback id="project-repositories-0" :feedback="model.feedback" />
    <card><form @submit="model.attach(form.repository, ctx)"><form-body><field label="Repository"><select name="repository" label="Repository" searchable required><option value="">Choose a repository</option><for choice in model.offeredChoices><option :value="choice.value" :selected="choice.value == model.repositoryDraft" :disabled="choice.disabled">{ choice.label }</option></for></select></field><form-actions align="start"><button type="submit" primary :disabled="!model.loaded">Attach repository</button><icon-button icon="refresh" label="Refresh repositories" id="workops-project-repositories-refresh" @click="model.retry(form.repository, ctx)" /></form-actions>
      <if !model.loaded><p role="status">Repository associations have not been loaded. Refresh to try again.</p>
      <else><table-scroll label="Project repositories"><table><caption>Project repositories</caption><thead><tr><th scope="col">Repository</th><th scope="col">Slug</th><th scope="col">Actions</th></tr></thead><tbody><for row in model.pageRows><tr :id='"workops-project-repository-" + row.id' :data-workops-project-repository="row.id"><td><if row.href.isNotBlank()><a :href="row.href">{ row.label }</a><else>{ row.label }</if><if row.archived><badge>Archived</badge></if></td><td>{ row.slug }</td><td><div class="workops-task-actions"><icon-button icon="settings" :label='"Create deploy config for " + row.label' @click="model.beginSetup(row.id, form.repository)" /><icon-button icon="trash" :label='"Remove association with " + row.label' @click="model.beginDelete(row.id, form.repository)" /></div></td></tr></for></tbody></table><if model.rows.isEmpty()><empty-state title="No repositories attached." compact /></if></table-scroll></if>
    </form-body></form><pagination :page="model.offset / 25 + 1" :previousHref="model.previousHref" :nextHref="model.nextHref" label="Project repository pages" /></card>
    <dialog title="Remove repository association" triggerLabel="Remove repository association" :showTrigger="false" :forceOpen="model.deleteTarget != null" :completed="model.deleteTarget == null" returnFocus="#workops-project-repositories-refresh" @dialogdismiss="model.cancelDelete()"><form @submit="model.delete(form.confirmed, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Remove { model.deleteTarget?.label } from this project? The Git repository is kept.</p><checkbox name="confirmed" label="Confirm removal" required /></form-body><form-actions bordered><button data-dialog-close @click="model.cancelDelete()">Cancel</button><button type="submit" primary>Remove association</button></form-actions></form></dialog>
    <dialog title="Create deploy config" triggerLabel="Create deploy config" :showTrigger="false" :forceOpen="model.setupTarget != null" :completed="model.setupTarget == null" returnFocus="#workops-project-repositories-refresh" @dialogdismiss="model.cancelSetup()"><form @submit="model.generate(form.authorName, form.authorEmail, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Create and commit a starter <code>.bosca/deploy.yaml</code> in { model.setupTarget?.label } from the program's environments. An existing file is kept.</p><field label="Commit author name"><input name="authorName" :value="model.authorNameDraft" required autocomplete="name" /></field><field label="Commit author email"><input name="authorEmail" type="email" :value="model.authorEmailDraft" required autocomplete="email" /></field></form-body><form-actions bordered><button data-dialog-close @click="model.cancelSetup()">Cancel</button><button type="submit" primary>Create and commit deploy config</button></form-actions></form></dialog>
    <dialog title="Committed deploy config" triggerLabel="Committed deploy config" :showTrigger="false" :forceOpen="model.generated != null" :completed="model.generated == null" returnFocus="#workops-project-repositories-refresh" @dialogdismiss="model.dismissGenerated()"><if model.generated != null><form-body padded><p>{ model.generated?.repositoryName } · { model.generated?.path } · { model.generated?.branch }</p><p>Complete the generated fields in the repository before the first release run.</p><source-view :content="model.generated?.content.orEmpty()" :path="model.generated?.path.orEmpty()" language="yaml" label="Committed deploy configuration" :preserveKey='"project-deploy-config-" + model.generated?.sha.orEmpty()' /><p>Commit <code>{ model.generated?.sha }</code></p></form-body><form-actions bordered><button data-dialog-close @click="model.dismissGenerated()">Done</button></form-actions></if></dialog>
  </div></island>
</component>
