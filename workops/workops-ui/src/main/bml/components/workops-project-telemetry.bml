<component tag="workops-project-telemetry">
  <prop name="initial" type="bosca.workops.ui.WorkOpsProjectTelemetryModel" required />
  <script server provides="model">bosca.workops.ui.WorkOpsProjectTelemetryModel(initial.projectId, initial.kind, initial.offset, initial.targetId, initial.otherOffset, initial.rows, initial.loaded, initial.draft, initial.deleteTarget, initial.resultId, initial.feedback)</script>
  <island name="projectTelemetry" :key='initial.projectId + "-" + initial.kind'><div :data-workops-project-telemetry="model.kind">
    <card :title="model.title"><form @submit="model.add(form.value, ctx)"><form-body><workops-feedback id="project-telemetry-0" :feedback="model.feedback" /><field :label="model.label"><input name="value" :value="model.draft" required /></field><form-actions align="start"><button :id='"workops-analytics-add-" + model.kind' type="submit" primary :disabled="!model.loaded">Add identifier</button><icon-button icon="refresh" label="Refresh identifiers" @click="model.retry(form.value, ctx)" /><if model.resultHref.isNotBlank()><button-link :href="model.resultHref" size="xs" icon="arrow-right">Show the added identifier</button-link></if></form-actions>
      <if !model.loaded><p role="status">Identifiers have not been loaded. Refresh to try again.</p><else><table-scroll :label="model.title"><table><caption class="sr-only">{ model.title }</caption><thead><tr><th scope="col">{ model.label }</th><th scope="col">Actions</th></tr></thead><tbody><for row in model.pageRows><tr :id='"workops-analytics-" + model.kind + "-" + row.id' :data-workops-project-identifier="row.id"><td><code>{ row.value }</code></td><td><icon-button icon="trash" :label='"Remove " + row.value' @click="model.beginDelete(row.id, form.value)" /></td></tr></for></tbody></table><if model.rows.isEmpty()><empty-state title="No identifiers configured." compact /></if></table-scroll></if>
    </form-body></form><pagination :page="model.offset / 25 + 1" :previousHref="model.previousHref" :nextHref="model.nextHref" :label='model.title + " pages"' /></card>
    <dialog title="Remove identifier" triggerLabel="Remove identifier" :showTrigger="false" :forceOpen="model.deleteTarget != null" :completed="model.deleteTarget == null" :returnFocus='"#workops-analytics-add-" + model.kind' @dialogdismiss="model.cancelDelete()"><form @submit="model.delete(form.confirmed, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Remove { model.deleteTarget?.value }?</p><checkbox name="confirmed" label="Confirm removal" required /></form-body><form-actions bordered><button data-dialog-close @click="model.cancelDelete()">Cancel</button><button type="submit" primary>Remove identifier</button></form-actions></form></dialog>
  </div></island>
</component>
