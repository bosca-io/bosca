<component tag="workops-project-catalog">
  <prop name="initial" type="bosca.workops.ui.WorkOpsProjectCatalogModel" required />
  <script server provides="model">bosca.workops.ui.WorkOpsProjectCatalogModel(initial.projectId, initial.kind, initial.offset, initial.targetId, initial.rows, initial.loaded, initial.creating, initial.nameDraft, initial.descriptionDraft, initial.modeDraft, initial.colorDraft, initial.deleteTarget, initial.releaseTarget, initial.resultId, initial.feedback, initial.delivery, initial.startDateDraft, initial.releaseDateDraft, initial.settings, initial.pageDirectory)</script>
  <island name="projectCatalog" :key='initial.projectId + "-" + initial.kind'>
    <if model.pageDirectory != null><page-heading :title='if (model.delivery) "Versions" else model.title' :trail='listOf(bosca.design.model.NavigationItem(model.pageDirectory?.selected?.name.orEmpty(), "/workops/projects/" + bosca.workops.ui.workOpsEncode(model.projectId), false))'  :subtitle='if (model.delivery) "Manage release versions for the selected project." else "Ownership areas for tasks within the selected project."'>
      <workops-project-choice :projects="requireNotNull(model.pageDirectory).projects" :projectId="model.projectId" :action='if (model.delivery) "/workops/releases/versions" else "/workops/settings/components"' />
      <button :id='"workops-project-new-" + model.kind' primary icon="plus" :disabled="!model.loaded" @click="model.open()">New { model.entityLabel }</button><icon-button icon="refresh" :label='"Refresh " + model.kind' @click="model.retry(ctx)" />
    <if model.resultHref.isNotBlank()><button-link :href="model.resultHref" size="xs" icon="arrow-right">Show the created { model.entityLabel }</button-link></if></page-heading></if>
    <div class="workops-content" data-workops-project-catalog :data-project-catalog-kind="model.kind">
      <if model.pageDirectory == null><section-heading :title="model.title"><button :id='"workops-project-new-" + model.kind' primary icon="plus" :disabled="!model.loaded" @click="model.open()">New { model.entityLabel }</button><icon-button icon="refresh" :label='"Refresh " + model.kind' @click="model.retry(ctx)" /><if model.resultHref.isNotBlank()><button-link :href="model.resultHref" size="xs" icon="arrow-right">Show the created { model.entityLabel }</button-link></if></section-heading></if>
      <workops-feedback id="project-catalog-0" :feedback="model.feedback" />

      <if !model.loaded><p role="status">This catalog has not been loaded. Refresh to try again.</p>
      <else-if model.pageRows.isNotEmpty()><card :padded="false"><table-scroll :label="model.title"><table><caption :class='if (model.pageDirectory == null) "sr-only" else ""'>{ model.title }</caption><thead><tr><th scope="col">Name</th><if model.kind != "labels"><th scope="col">Description</th></if><if model.kind == "versions"><th scope="col">State</th><if model.delivery><th scope="col">Start date</th></if><th scope="col">Release date</th><if model.delivery><th scope="col">Sequence</th></if><else-if model.kind == "components"><th scope="col">Assignee mode</th><else><th scope="col">Color</th></if><th scope="col">Actions</th></tr></thead><tbody><for row in model.pageRows><tr :id='"workops-project-" + model.kind + "-" + row.id' :data-workops-project-catalog-row="row.id"><td>{ row.name }</td><if model.kind != "labels"><td>{ row.description }</td></if><if model.kind == "versions"><td><badge :tone='if (row.released) "success" else "neutral"'>{ row.state }</badge></td><if model.delivery><td><if row.startDate.isNotBlank()><time :value="row.startDate" format="MMM d, yyyy" /><else>—</if></td></if><td><if row.date.isNotBlank()><time :value="row.date" format="MMM d, yyyy" /><else>—</if></td><if model.delivery><td>{ row.sequenceNumber }</td></if><else-if model.kind == "components"><td>{ row.modeLabel }</td><else><td><if row.color.isNotBlank()><badge :color="row.color">{ row.color }</badge><else>No color</if></td></if><td><form-actions align="start"><if model.kind == "versions"><if !row.released && (model.delivery || !row.archived)><icon-button icon="upload" :label='"Release " + row.name' @click="model.beginRelease(row.id)" /></if><if model.delivery><icon-button icon="trash" :label='"Delete " + row.name' @click="model.beginDelete(row.id)" /></if><else><icon-button icon="trash" :label='"Delete " + row.name' @click="model.beginDelete(row.id)" /></if></form-actions></td></tr></for></tbody></table></table-scroll></card><else><empty-state :title='"No " + model.kind + " yet."' compact /></if>
      <pagination :page="model.offset / 25 + 1" :previousHref="model.previousHref" :nextHref="model.nextHref" :label='model.title + " pages"' />
      <dialog :title='"New " + model.entityLabel' triggerLabel="New item" :showTrigger="false" :forceOpen="model.creating" :completed="!model.creating" :returnFocus='"#workops-project-new-" + model.kind' @dialogdismiss="model.cancelCreate()">
        <form class="modal-form" @submit="model.create(form.name, form.description, form.mode, form.color, form.startDate, form.releaseDate, ctx)"><form-body padded class="modal-fields"><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><if model.feedback.failed><form-actions align="start"><button icon="refresh" @click="model.reloadDraft(form.name, form.description, form.mode, form.color, form.startDate, form.releaseDate, ctx)">Retry loading catalog</button></form-actions></if>
          <field label="Name"><input name="name" :value="model.nameDraft" required /></field><if model.kind != "labels"><field label="Description"><input multiline name="description" :value="model.descriptionDraft" :rows="4" /></field><else><html:input type="hidden" name="description" value="" /></if><if model.kind == "components"><field label="Assignee mode"><select name="mode" label="Assignee mode"><for mode in model.modes><option :value="mode.value" :selected="mode.value == model.modeDraft">{ mode.label }</option></for></select></field><else><html:input type="hidden" name="mode" :value="model.modeDraft" /></if><if model.kind == "labels"><field label="Color"><input name="color" type="color" :value="model.colorDraft" /></field><else><html:input type="hidden" name="color" :value="model.colorDraft" /></if><if model.delivery><field label="Start date"><input name="startDate" type="date" :value="model.startDateDraft" /></field><field label="Release date"><input name="releaseDate" type="date" :value="model.releaseDateDraft" /></field><else><html:input type="hidden" name="startDate" value="" /><html:input type="hidden" name="releaseDate" value="" /></if></form-body><form-actions bordered class="modal-footer"><button data-dialog-close @click="model.cancelCreate()">Cancel</button><button type="submit" primary>Create { model.entityLabel }</button></form-actions></form>
      </dialog>
      <dialog :title='"Delete " + model.entityLabel' triggerLabel="Delete item" :showTrigger="false" :forceOpen="model.deleteTarget != null" :completed="model.deleteTarget == null" :returnFocus='"#workops-project-new-" + model.kind' @dialogdismiss="model.cancelDelete()">
        <form class="modal-form" @submit="model.delete(form.confirmed, ctx)"><form-body padded class="modal-fields"><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Delete { model.deleteTarget?.name }?</p><checkbox name="confirmed" label="Confirm deletion" required /></form-body><form-actions bordered class="modal-footer"><button data-dialog-close @click="model.cancelDelete()">Cancel</button><button type="submit" primary>Delete { model.entityLabel }</button></form-actions></form>
      </dialog>
      <dialog title="Release version" triggerLabel="Release version" :showTrigger="false" :forceOpen="model.releaseTarget != null" :completed="model.releaseTarget == null" :returnFocus='"#workops-project-new-" + model.kind' @dialogdismiss="model.cancelRelease()">
        <form class="modal-form" @submit="model.release(form.confirmed, ctx)"><form-body padded class="modal-fields"><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Mark { model.releaseTarget?.name } as released?</p><checkbox name="confirmed" label="Confirm release" required /></form-body><form-actions bordered class="modal-footer"><button data-dialog-close @click="model.cancelRelease()">Cancel</button><button type="submit" primary>Release version</button></form-actions></form>
      </dialog>
    </div>
  </island>
</component>
