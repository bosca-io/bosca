<component tag="workops-project-dependencies">
  <prop name="initial" type="bosca.workops.ui.WorkOpsProjectDependenciesModel" required />
  <script server provides="model">bosca.workops.ui.WorkOpsProjectDependenciesModel(initial.projectId, initial.offset, initial.consumersOffset, initial.targetId, initial.dependencies, initial.consumers, initial.projects, initial.loaded, initial.creating, initial.providerDraft, initial.typeDraft, initial.constraintDraft, initial.deleteTarget, initial.resultId, initial.feedback)</script>
  <island name="projectDependencies" :key="initial.projectId"><div class="workops-content" data-workops-project-dependencies>
    <section-heading title="Dependencies"><button id="workops-project-dependency-new" primary :disabled="!model.loaded" @click="model.open()">Declare dependency</button><icon-button icon="refresh" label="Refresh dependencies" @click="model.retry(ctx)" /><if model.resultHref.isNotBlank()><button-link :href="model.resultHref" size="xs" icon="arrow-right">Show the declared dependency</button-link></if></section-heading>
    <workops-feedback id="project-dependencies-0" :feedback="model.feedback" />
    <if !model.loaded><p role="status">Dependencies have not been loaded. Refresh to try again.</p>
    <else>
      <card :padded="false"><table-scroll label="Depends on"><table><caption>Depends on</caption><thead><tr><th scope="col">Provider project</th><th scope="col">Version constraint</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody><for row in model.pageRows><tr :id='"workops-dependency-" + row.id' :data-workops-dependency="row.id"><td>{ model.projectLabel(row.providerId) }</td><td><code>{ row.constraint }</code></td><td><badge>{ row.type }</badge></td><td><badge :tone="row.tone">{ row.status }</badge></td><td><icon-button icon="trash" :label='"Remove dependency on " + model.projectLabel(row.providerId)' @click="model.beginDelete(row.id)" /></td></tr></for></tbody></table><if model.dependencies.isEmpty()><empty-state title="No dependencies declared." compact /></if></table-scroll><pagination :page="model.offset / 25 + 1" :previousHref="model.previousHref" :nextHref="model.nextHref" label="Dependency pages" /></card>
      <card :padded="false"><table-scroll label="Depended on by"><table><caption>Depended on by</caption><thead><tr><th scope="col">Consumer project</th><th scope="col">Version constraint</th><th scope="col">Type</th><th scope="col">Status</th></tr></thead><tbody><for row in model.consumerRows><tr :data-workops-consumer="row.id"><td>{ model.projectLabel(row.consumerId) }</td><td><code>{ row.constraint }</code></td><td><badge>{ row.type }</badge></td><td><badge :tone="row.tone">{ row.status }</badge></td></tr></for></tbody></table><if model.consumers.isEmpty()><empty-state title="No projects depend on this project." compact /></if></table-scroll><pagination :page="model.consumersOffset / 25 + 1" :previousHref="model.previousConsumersHref" :nextHref="model.nextConsumersHref" label="Consumer pages" /></card>
    </if>
    <dialog title="Declare dependency" triggerLabel="Declare dependency" :showTrigger="false" :forceOpen="model.creating" :completed="!model.creating" returnFocus="#workops-project-dependency-new" @dialogdismiss="model.cancelCreate()"><form @submit="model.create(form.provider, form.type, form.constraint, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><if model.feedback.failed><form-actions align="start"><button icon="refresh" @click="model.reloadChoices(form.provider, form.type, form.constraint, ctx)">Retry loading dependency choices</button></form-actions></if>
          <field label="Provider project"><select name="provider" label="Provider project" searchable required><option value="">Choose a project</option><for provider in model.offeredProviders><option :value="provider.value" :selected="provider.value == model.providerDraft" :disabled="provider.disabled">{ provider.label }</option></for></select></field><field label="Type"><select name="type" label="Type"><for type in model.types><option :value="type.value" :selected="type.value == model.typeDraft">{ type.label }</option></for></select></field><field label="Version constraint" hint="Use * for any released version, a prefix such as 6.0.*, or match for this project's release version."><input name="constraint" :value="model.constraintDraft" /></field></form-body><form-actions bordered><button data-dialog-close @click="model.cancelCreate()">Cancel</button><button type="submit" primary>Declare dependency</button></form-actions></form></dialog>
    <dialog title="Remove dependency" triggerLabel="Remove dependency" :showTrigger="false" :forceOpen="model.deleteTarget != null" :completed="model.deleteTarget == null" returnFocus="#workops-project-dependency-new" @dialogdismiss="model.cancelDelete()"><form @submit="model.delete(form.confirmed, ctx)"><form-body padded><if model.feedback.failed><alert>{ model.feedback.message }</alert></if><p>Remove the dependency on { model.projectLabel(model.deleteTarget?.providerId.orEmpty()) }?</p><checkbox name="confirmed" label="Confirm removal" required /></form-body><form-actions bordered><button data-dialog-close @click="model.cancelDelete()">Cancel</button><button type="submit" primary>Remove dependency</button></form-actions></form></dialog>
  </div></island>
</component>
