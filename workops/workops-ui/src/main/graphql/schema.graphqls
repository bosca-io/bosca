    id: UUID! scope: String! scopeId: UUID name: String! description: String enabled: Boolean!
    trigger: JSON! conditions: JSON! actions: JSON! runAsProfileId: UUID! failureMode: String!
    executionLogRetentionDays: Int! maxFiresPerTaskPerHour: Int! version: Long!
