extend type WorkOpsStatus { description: String colorHex: String! version: Long! }
extend type WorkOpsPriority { description: String iconKey: String! version: Long! }
extend type WorkOpsResolution { description: String displayOrder: Int! version: Long! }
extend type WorkOpsTaskLinkType { category: WorkOpsLinkCategory! version: Long! }
extend type WorkOpsLabels { global: [WorkOpsLabel!]! }
