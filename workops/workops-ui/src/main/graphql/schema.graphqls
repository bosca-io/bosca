input CreateWorkOpsStatusInput { name: String! description: String category: WorkOpsStatusCategory! colorHex: String! }
input UpdateWorkOpsStatusInput { name: String! description: String category: WorkOpsStatusCategory! colorHex: String! expectedVersion: Long! }
type WorkOpsStatusesMutation { create(input: CreateWorkOpsStatusInput!): WorkOpsStatus! update(id: UUID!, input: UpdateWorkOpsStatusInput!): WorkOpsStatus! delete(id: UUID!): Boolean! }
input CreateWorkOpsPriorityInput { name: String! description: String iconKey: String! colorHex: String! displayOrder: Int! }
input UpdateWorkOpsPriorityInput { name: String! description: String iconKey: String! colorHex: String! displayOrder: Int! expectedVersion: Long! }
type WorkOpsPrioritiesMutation { create(input: CreateWorkOpsPriorityInput!): WorkOpsPriority! update(id: UUID!, input: UpdateWorkOpsPriorityInput!): WorkOpsPriority! delete(id: UUID!): Boolean! }
input CreateWorkOpsResolutionInput { name: String! description: String displayOrder: Int! }
input UpdateWorkOpsResolutionInput { name: String! description: String displayOrder: Int! expectedVersion: Long! }
type WorkOpsResolutionsMutation { create(input: CreateWorkOpsResolutionInput!): WorkOpsResolution! update(id: UUID!, input: UpdateWorkOpsResolutionInput!): WorkOpsResolution! delete(id: UUID!): Boolean! }
input CreateWorkOpsTaskLinkTypeInput { name: String! inwardLabel: String! outwardLabel: String! category: WorkOpsLinkCategory! }
input UpdateWorkOpsTaskLinkTypeInput { name: String! inwardLabel: String! outwardLabel: String! category: WorkOpsLinkCategory! expectedVersion: Long! }
type WorkOpsTaskLinkTypesMutation { create(input: CreateWorkOpsTaskLinkTypeInput!): WorkOpsTaskLinkType! update(id: UUID!, input: UpdateWorkOpsTaskLinkTypeInput!): WorkOpsTaskLinkType! delete(id: UUID!): Boolean! }

