"Tracks the status, result, and metadata of a backup operation."
type Backup {
    "Unique identifier for this backup operation."
    id: UUID!
    "Current status of the backup: pending, running, completed, or failed."
    status: String!
    "Object storage path of the completed backup archive, null until the backup finishes."
    path: String
    "Error message if the backup failed, null on success."
    error: String
    "Whether binary files from object storage are included in this backup."
    includeFiles: Boolean!
    "Metadata item identifier for downloading the backup archive through the standard content API."
    metadataId: UUID
    "Timestamp when the backup was initiated."
    created: DateTime!
    "Timestamp of the most recent status update."
    modified: DateTime!
}

"Determines how the restore process handles pre-existing records that conflict with data in the backup archive."
enum ConflictStrategy {
    "Skip records that already exist, leaving the current data untouched."
    SKIP
    "Overwrite existing records with data from the backup archive."
    OVERWRITE
    "Abort the entire restore if any conflicts are detected."
    FAIL
}

"Query operations for listing and inspecting backup records."
type Backups {
    "List all backups ordered by creation date descending, with pagination."
    list(offset: Int! = 0, limit: Int! = 20): [Backup!]!
    "Get a specific backup by its identifier."
    backup(id: UUID!): Backup
    "Inspect persisted object backup and restore runs. Requires backup administration access."
    objectRuns: ObjectBackupRuns!
    "Read native database request state and its observed stopped-writer recovery token."
    postgresRun(key: String!): PostgresBackupRun
    "List native database requests in one exact source/storage scope."
    postgresRuns(sourceId: String!, storageKey: String!, offset: Int! = 0, limit: Int! = 20): [PostgresBackupRun!]!
}

"The operation tracked by an object inventory run or checkpoint."
enum ObjectBackupOperation {
    BACKUP
    RESTORE
}

"The lifecycle and last recorded outcome of an object inventory run."
enum ObjectBackupRunStatus {
    PENDING
    RUNNING
    COMPLETED
    PARTIAL
    FAILED
    CANCELLED
}

"The current transfer state of one declared object revision."
enum ObjectBackupProgressStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
}

"Read-only administration queries for persisted object inventory runs."
type ObjectBackupRuns {
    "List one operation's runs in the selected source, destination and scope, newest first."
    list(operation: ObjectBackupOperation!, sourceId: String!, destinationId: String!, scope: String!, offset: Int! = 0, limit: Int! = 20): [ObjectBackupRun!]!
    "Read one run and its exact declared inventory."
    run(key: String!): ObjectBackupRun
    "Read the latest completed run separately from any newer partial attempt."
    lastSuccessful(operation: ObjectBackupOperation!, sourceId: String!, destinationId: String!, scope: String!): ObjectBackupRun
    "Read a saved storage address without credentials. Requires backup administration access."
    storage(key: String!): ObjectBackupStorage
    "Read the durable dispatch request for an exact run version."
    dispatch(key: String!, version: Long!): ObjectBackupDispatch
}

"A declared portable object inventory. Source capture and revision retention are caller responsibilities."
input ObjectBackupManifestInput {
    id: String!
    sourceId: String!
    scope: String!
    created: String!
    objects: [BackupObjectInput!]!
    version: Int!
    format: String!
}

"An exact source revision, full-payload SHA-256 digest and retained payload key."
input BackupObjectInput {
    store: String!
    key: String!
    revision: String!
    length: Long!
    sha256: String!
    payloadPath: String!
}

"Prepare, configure and dispatch declared inventory runs. Requires backup administration access."
type ObjectBackupRunsMutation {
    "Prepare a declared backup inventory. Repeating the same intent preserves its existing run and outcome."
    prepare(inventory: ObjectBackupManifestInput!, destinationId: String!): ObjectBackupRun!
    "Prepare a declared restore inventory and input manifest path. Input storage is verified during execution."
    prepareRestore(inventory: ObjectBackupManifestInput!, destinationId: String!, path: String!): ObjectBackupRun!
    "Bind selected application storage IDs to their configured addresses without opening stores."
    bindStorage(keys: [String!]!): [ObjectBackupStorage!]!
    "Fix the backup and logical source or restore target IDs before the first attempt."
    configureStorage(key: String!, backupKey: String!, stores: [ObjectBackupStoreMappingInput!]!): ObjectBackupRunStorage!
    "Queue an exact pending run version. Returns saved intent; execution is asynchronous."
    dispatch(key: String!, expectedVersion: Long!): ObjectBackupDispatch!
    "Return a failed, partial or cancelled run to pending. Dispatch the returned version separately."
    retry(key: String!, expectedVersion: Long!): ObjectBackupRun!
    "Cancel only an observed pending run version. Does not stop active writers."
    cancelPending(key: String!, expectedVersion: Long!, reason: String!): ObjectBackupRun!
}

"A declared logical store and its bound application storage ID."
input ObjectBackupStoreMappingInput {
    store: String!
    storageKey: String!
}

"A saved storage location. Runtime credentials are not exposed."
type ObjectBackupStorage {
    key: String!
    type: String!
    endpoint: String
    bucket: String
    region: String
    basePath: String
    created: DateTime!
}

"Immutable storage selection for one prepared run."
type ObjectBackupRunStorage {
    key: String!
    backupKey: String!
    stores: [ObjectBackupStoreMapping!]!
    created: DateTime!
}

"A saved mapping from a declared logical store to a bound storage ID."
type ObjectBackupStoreMapping {
    store: String!
    storageKey: String!
}

"Saved publication intent. The queue key remains stable for this exact run version."
type ObjectBackupDispatch {
    key: UUID!
    runKey: String!
    version: Long!
    created: DateTime!
}

"A fixed object inventory and its recorded execution state."
type ObjectBackupRun {
    key: String!
    sourceId: String!
    destinationId: String!
    scope: String!
    operation: ObjectBackupOperation!
    inventory: ObjectBackupManifest!
    "The output manifest path for a backup or input manifest path for a restore."
    path: String!
    status: ObjectBackupRunStatus!
    attempts: Int!
    error: String
    "Frozen totals from the most recent terminal outcome, null before an outcome is recorded."
    result: ObjectBackupRunSummary
    version: Long!
    created: DateTime!
    modified: DateTime!
    "Fixed storage selection, or null for a run that has not been configured."
    storage: ObjectBackupRunStorage
    "Current health of the run's exact shared checkpoints. May differ from its frozen result."
    summary: ObjectBackupRunSummary!
    "Read current checkpoint state in declared inventory order."
    items(offset: Int! = 0, limit: Int! = 20): [ObjectBackupProgress!]!
}

"A portable object inventory. Database recovery-point coverage is established separately."
type ObjectBackupManifest {
    id: String!
    sourceId: String!
    scope: String!
    created: String!
    version: Int!
    format: String!
    objects(offset: Int! = 0, limit: Int! = 20): [BackupObject!]!
}

"A selected source object and its verified retained payload."
type BackupObject {
    store: String!
    key: String!
    "Backup change identity from observed source metadata or a selected provider version."
    revision: String!
    length: Long!
    sha256: String!
    payloadPath: String!
}

"Current state of one operation-specific revision checkpoint."
type ObjectBackupProgress {
    key: String!
    sourceId: String!
    destinationId: String!
    scope: String!
    operation: ObjectBackupOperation!
    payload: BackupObject!
    status: ObjectBackupProgressStatus!
    attempts: Int!
    verifiedBytes: Long!
    "Last recorded full checksum check. Metadata-only checks preserve this time."
    verified: DateTime
    error: String
    version: Long!
    created: DateTime!
    modified: DateTime!
}

"Logical inventory totals. Shared payload references each contribute their declared length."
type ObjectBackupRunSummary {
    total: Long!
    pending: Long!
    running: Long!
    completed: Long!
    failed: Long!
    totalBytes: Long!
    verifiedBytes: Long!
}

"Mutation operations for creating backups and restoring from them."
type BackupsMutation {
    "Recover an exact execution token only after establishing that its process and writer stopped. Never expires/takes over a live writer."
    recoverPostgresRun(key: String!, expectedToken: String!): PostgresBackupRun!

    "Prepare, configure and dispatch object inventory runs. Requires backup administration access."
    objectRuns: ObjectBackupRunsMutation!
    "Initiate a new backup of all system data. Returns the backup tracking record immediately; the actual backup runs asynchronously."
    create(includeFiles: Boolean! = true): Backup!
    "Register an already-uploaded metadata item as an imported backup archive."
    importBackup(metadataId: UUID!): Backup!
    "Initiate a restore from a previously completed backup archive. The restore runs asynchronously."
    restore(backupId: UUID!, conflictStrategy: ConflictStrategy! = SKIP): Boolean!
    "Delete a backup tracking record and optionally its archive."
    delete(id: UUID!): Boolean!
}

extend type Query {
    "Access backup query operations for listing and inspecting backup records."
    backups: Backups!
}

extend type Mutation {
    "Access backup mutation operations for creating backups and restoring from them."
    backups: BackupsMutation!
}

"Lifecycle of a native database request; a failed attempt may retry at a new snapshot boundary."
enum PostgresBackupRunStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
    CANCELLED
}

"Native database request intent and its latest recorded attempt."
type PostgresBackupRun {
    key: String!
    sourceId: String!
    storageKey: String!
    prefix: String!
    status: PostgresBackupRunStatus!
    attempts: Int!
    writerToken: String
    error: String
    result: PostgresBackupReceipt
    version: Long!
    created: DateTime!
    modified: DateTime!
}

"A verified independently retained native database artifact selected by a completed request."
type PostgresBackupReceipt {
    key: String!
    storageKey: String!
    path: String!
    manifest: PostgresBackupManifest!
}

"Native database artifact provenance and byte identity, excluding object storage coverage."
type PostgresBackupManifest {
    id: String!
    sourceId: String!
    database: String!
    created: String!
    completed: String!
    snapshotId: String!
    snapshot: String!
    serverVersion: String!
    serverVersionNumber: Int!
    encoding: String!
    extensions: JSON!
    length: Long!
    sha256: String!
    payloadPath: String!
    version: Int!
    format: String!
    contentInventory: PostgresBackupContentInventory
}

"Reference evidence captured from the database view; this does not establish retained asset coverage."
type PostgresBackupContentInventory {
    count: Long!
    length: Long!
    sha256: String!
    path: String!
    version: Int!
}
