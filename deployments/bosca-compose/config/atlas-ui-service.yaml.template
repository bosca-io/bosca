  atlas-ui:
    <<: *service
    image: ${BOSCA_IMAGE_REGISTRY:-ghcr.io/bosca-io/bosca}/atlas-ui-server:${ATLAS_UI_VERSION:-${ATLAS_VERSION:?Set ATLAS_VERSION}}
    mem_limit: 512m
    environment:
      ATLAS_UI_HTTP_PORT: "8095"
      BML_GRAPHQL_ENDPOINT: http://atlas:8094/graphql
      BML_ARTIFACTS_ENDPOINT: "@@BML_ARTIFACTS_ENDPOINT@@"
      ATLAS_ARTIFACTS_URL: ${ARTIFACTS_URL:?Run install.sh first}
    ports:
      - "127.0.0.1:${ATLAS_UI_PORT:-8095}:8095"
    depends_on:
      atlas: {condition: service_healthy}
    healthcheck:
      test: [CMD, bash, -ec, "exec 3<>/dev/tcp/127.0.0.1/8095; printf 'GET /api/v1/ready HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3; read -r protocol status rest <&3; test \"$$status\" = 200"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
