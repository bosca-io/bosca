{
	auto_https off
}

:{$BOSCA_PORT} {
	@analytics path /api/v1/events /api/v1/events/* /api/v1/installation /api/v1/installation/*
	handle @analytics {
		reverse_proxy analytics-collector:8081
	}

	@api path /graphql /graphqlws /graphqlws/* /oauth2/* /api/v1/* /content/* /files/* /ci/*
	handle @api {
		reverse_proxy bosca-server:8080
	}

	@messageAssets path /bml-messages/assets/* /bml-messages/c/* /bml-messages/o/*
	handle @messageAssets {
		uri strip_prefix /bml-messages
		reverse_proxy bml-message-server:9093
	}

	handle /bml-messages/* {
		respond 404
	}

	handle {
		reverse_proxy studio:3000
	}
}

# Git transports use the dedicated backend; UI entry points go to Atlas.
:8091 {
	@gitUi path_regexp git_ui "^(/|/(login|welcome|404|500|compare|search|statuses|robots[.]txt|llms[.]txt|sitemap[.]xml|favicon[.]ico)/?|/auth/(signup|forgot|verify|reset-password|link/confirm)/?|/settings/github/?|/repositories(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}(/(settings|secrets|github))?)?/?|/(pulls|pipelines|ci-agents)(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?/?|/_bml/(libraries|js|css|i18n|identity|render|contract|action|deferred|reload|app[.]css|app[.]js)(/.*)?|/_git/(fonts|subscriptions)(/.*)?)$"
	route {
		redir @gitUi http://{host}:{$BOSCA_ATLAS_PORT:8094}{uri} 302
		reverse_proxy git-server:8091
	}
}

# The public Atlas port fronts the imported Git/artifact UIs and Atlas API.
:8094 {
	@atlasUi path_regexp atlas_ui "^(/|/(login|welcome|404|500|compare|search|statuses|robots[.]txt|llms[.]txt|sitemap[.]xml|favicon[.]ico)/?|/auth/(signup|forgot|verify|reset-password|link/confirm)/?|/settings/github/?|/repositories(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}(/(settings|secrets|github))?)?/?|/(pulls|pipelines|ci-agents)(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?/?|/_bml/(libraries|js|css|i18n|identity|render|contract|action|deferred|reload|app[.]css|app[.]js)(/.*)?|/_git/(fonts|subscriptions)(/.*)?|/favicon[.]svg|/artifacts/namespaces(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?/?|/artifacts/repositories(/([0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}|upload))?/?|/artifacts/settings/permissions/?|/artifacts/settings/repositories/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/?|/artifacts/runs/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/?|/_artifacts(/.*)?)$"
	@gitBackend path_regexp git_backend "^(/[^/]+/[^/]+[.]git(/.*)?|/[^/]+/[^/]+/raw(/.*)?|/ci(/.*)?|/api/webhooks(/.*)?)$"
	@registry path /v2 /v2/* /raw /raw/* /maven /maven/* /npm /npm/* /helm /helm/* /ml /ml/*
	route {
		reverse_proxy @atlasUi atlas-server:8095
		reverse_proxy @gitBackend git-server:8091
		reverse_proxy @registry artifacts-server:8084
		reverse_proxy atlas-server:8094
	}
}
