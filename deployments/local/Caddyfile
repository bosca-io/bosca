{
	auto_https off
}

:{$BOSCA_PORT} {
	@analytics path /api/v1/events /api/v1/events/* /api/v1/installation /api/v1/installation/*
	handle @analytics {
		reverse_proxy analytics-collector:8081
	}

	@api path /graphql /graphqlws /graphqlws/* /oauth2/* /api/v1/* /content/* /files/* /ci/*
	handle @api {
		reverse_proxy bosca-server:8080
	}

	@messageAssets path /bml-messages/assets/* /bml-messages/c/* /bml-messages/o/*
	handle @messageAssets {
		uri strip_prefix /bml-messages
		reverse_proxy bml-message-server:9093
	}

	handle /bml-messages/* {
		respond 404
	}

	handle {
		reverse_proxy studio:3000
	}
}

# The public Git port fronts both listeners in the Git server process.
:8091 {
	@gitUi path_regexp git_ui "^(/|/(login|welcome|404|500|compare|search|statuses|robots[.]txt|llms[.]txt|sitemap[.]xml|favicon[.]ico)/?|/auth/(signup|forgot|verify|reset-password|link/confirm)/?|/settings/github/?|/repositories(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}(/(settings|secrets|github))?)?/?|/(pulls|pipelines|ci-agents)(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?/?|/_bml/(js|css|i18n|identity|render|contract|action|deferred|reload|app[.]css|app[.]js)(/.*)?|/_git/(fonts|subscriptions)(/.*)?)$"
	route {
		reverse_proxy @gitUi git-server:8093
		reverse_proxy git-server:8091
	}
}
