<component tag="atlas-login-form">
  <div class="auth-flow">
    <atlas-auth-providers />
    <alert ref="error" hidden />
    <p ref="notice" class="auth-notice" role="status" hidden></p>
    <form ref="form" class="auth-form">
      <field label="Email">
        <input ref="identifier" name="identifier" type="text" autocomplete="username" required />
      </field>
      <field label="Password">
        <input
          ref="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </field>
      <a ref="forgot" href="/auth/forgot">Forgot password?</a>
      <button ref="submit" type="submit" class="auth-primary">Sign in</button>
    </form>
    <p class="auth-footer">
      New to Bosca?
      <a ref="signup" href="/auth/signup">Create an account</a>
    </p>
  </div>
  <script client scoped>
    const form = ctx.ref<HTMLFormElement>("form");
    const submit = ctx.ref<HTMLButtonElement>("submit");
    const error = ctx.ref<HTMLParagraphElement>("error");
    const notice = ctx.ref<HTMLParagraphElement>("notice");
    const value = (name: string) => ctx.ref<HTMLInputElement>(name)?.value ?? "";
    let mounted = true;
    let busy = false;

    ctx.onUnmount(() => {
      mounted = false;
    });

    function show(element: HTMLElement | null, message: string) {
      if (!mounted || !element) return;
      element.textContent = message;
      element.hidden = false;
    }

    async function run(
      action: () => Promise<void>,
      fallback: string,
      button = submit,
    ) {
      if (busy) return false;
      busy = true;
      const label = button?.textContent ?? "";
      if (button) {
        button.disabled = true;
        button.textContent = "Please wait…";
      }
      form?.setAttribute("aria-busy", "true");
      if (error) error.hidden = true;
      try {
        await action();
        return true;
      } catch (reason) {
        if (!mounted) return false;
        const message = atlasAuthFlow.failure(reason, fallback);
        if (message) show(error, message);
        return false;
      } finally {
        busy = false;
        if (mounted) {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
          form?.removeAttribute("aria-busy");
        }
      }
    }

    const signupLink = ctx.ref<HTMLAnchorElement>("signup");
    if (signupLink) signupLink.href = atlasAuthFlow.url("/auth/signup");
    const forgotLink = ctx.ref<HTMLAnchorElement>("forgot");
    if (forgotLink) forgotLink.href = atlasAuthFlow.url("/auth/forgot");

    if (form) {
      ctx.on<SubmitEvent>(form, "submit", (event) => {
        event.preventDefault();
        void run(
          () => atlasAuthFlow.signIn(value("identifier"), value("password")),
          "Something went wrong while signing you in. Please try again.",
        );
      });
    }

    if (atlasAuthFlow.params.has("accountVerified"))
      show(notice, "Email verified. Sign in to continue.");
    if (atlasAuthFlow.params.has("passwordReset"))
      show(notice, "Password reset. Sign in with your new password.");
    if (atlasAuthFlow.params.has("unauthorized"))
      show(
        notice,
        "Your session may have expired, or you may not have access to that page. Sign in to continue.",
      );
    void atlasAuthFlow.ready.then((failure) => {
      if (!mounted || atlasAuthFlow.redirecting) return;
      if (failure)
        show(
          error,
          atlasAuthFlow.failure(
            failure,
            "Sign-in could not be completed. Please try again.",
          ) ?? "",
        );
      else if (atlasAuth.isAuthenticated && !atlasAuthFlow.params.has("unauthorized"))
        atlasAuthFlow.finish();
    });
  </script>
</component>
