# =============================================================================
# bosca-server native image (GraalVM 25)
#
# The native binary is pre-built by CI using Gradle nativeCompile.
#
# Build context is server/ (as selected by scripts/release/build-image.sh).
# =============================================================================
FROM debian:bookworm-slim

COPY scripts/install-postgresql-client.sh /tmp/install-postgresql-client.sh
RUN sh /tmp/install-postgresql-client.sh && rm /tmp/install-postgresql-client.sh

ARG ARTIFACT_SHA
RUN mkdir /app
WORKDIR /app
#COPY bosca-server/build/native/nativeCompile/bosca-server /app/
COPY artifacts/${ARTIFACT_SHA}/bosca-server-native/bosca-server /app/bosca-server
RUN chmod +x ./bosca-server

EXPOSE 8080
ENTRYPOINT ["./bosca-server"]
