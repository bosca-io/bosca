#!/bin/sh

# Location of the Tailwind CLI binary relative to this script
TAILWIND="./tailwindcss"

# Download Tailwind CLI if it's not present
if [ ! -f "$TAILWIND" ]; then
  echo "tailwindcss not found, downloading..."
  # Detect OS/arch (simplified)
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
      URL="https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64"
      ;;
    Darwin-arm64)
      URL="https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-macos-arm64"
      ;;
    Darwin-x86_64)
      URL="https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-macos-x64"
      ;;
    *)
      echo "Unsupported platform, please download the Tailwind CLI manually."
      exit 1
      ;;
  esac

  curl -sSL "$URL" -o "$TAILWIND"
  chmod +x "$TAILWIND"
  echo "tailwindcss downloaded."
fi

./tailwindcss \
-i ./main.css \
-o ../resources/static/main.css \
-m \
--watch
