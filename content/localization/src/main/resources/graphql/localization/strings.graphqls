"A single translatable string key within a LocalizationProject"
type LocalizationString {
    "Unique identifier for this string"
    id: UUID!
    "The project this string belongs to"
    projectId: UUID!
    "Stable key used by consumers (e.g. 'items_count')"
    key: String!
    "Translator context (free-form description of intent)"
    context: String
    "Optional metadata ID providing visual context (screenshots/mockups as supplementary items)"
    metadataId: UUID
    "Declared ICU placeholders, as a JSON array of {name, type, example} objects"
    placeholders: JSON
    "Optional maximum length for translations (enforced in the admin UI)"
    maxLength: Int
    "Freeform tags for filtering and organization"
    tags: [String!]!
    "Whether this string has plural forms (translations live in pluralTranslations instead of translations)"
    plural: Boolean!
    "Timestamp when this string was created"
    created: DateTime!
    "Timestamp when this string was last modified"
    modified: DateTime!

    "Every translation for this string across all languages"
    translations: [LocalizationTranslation!]!
    "Plural category rows for a specific language (empty when plural is false)"
    pluralTranslations(languageTag: String!): [LocalizationPluralTranslation!]!
    "Metadata items attached for translator context (screenshots, mockups, reference files)"
    contextMetadata: [LocalizationStringMetadata!]!
}

"A metadata item attached to a localization string for translator context"
type LocalizationStringMetadata {
    "The string this metadata is attached to"
    stringId: UUID!
    "The metadata item ID"
    metadataId: UUID!
    "When this attachment was created"
    created: DateTime!
}

"Workflow state identifying where a translation is in the review lifecycle"
enum TranslationState {
    "Initial state for newly created or imported human translations"
    DRAFT
    "Produced by an AI pipeline; requires human review before publishing"
    AI_GENERATED
    "Submitted for human review"
    IN_REVIEW
    "Reviewed and approved; ready for publishing"
    APPROVED
    "Failed review; returned to draft for rework"
    REJECTED
    "Live; eligible for export"
    PUBLISHED
    "No longer active; soft-removed"
    ARCHIVED
}

"Identifies the source that produced a translation"
enum TranslationOrigin {
    "Entered directly by a human translator"
    HUMAN
    "Generated by an AI pipeline"
    AI
    "Loaded from a source file via the CLI or API"
    IMPORT
    "Pulled from an external sync platform such as Crowdin"
    SYNC
}

"CLDR plural category for plural translation rows"
enum PluralCategory {
    ZERO
    ONE
    TWO
    FEW
    MANY
    OTHER
}

"A translation of a non-plural string for a specific language"
type LocalizationTranslation {
    "Unique identifier"
    id: UUID!
    "The source string this translation belongs to"
    stringId: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "Translated text"
    text: String!
    "Current workflow state"
    state: TranslationState!
    "Provenance of this translation"
    origin: TranslationOrigin!
    "Optional detail describing origin (AI model name, Crowdin user, etc.)"
    originDetail: String
    "Principal ID of the reviewer, null when unreviewed"
    reviewedBy: UUID
    "Timestamp of the most recent review action"
    reviewedAt: DateTime
    "Principal ID of the creator, null for system/AI origins"
    createdBy: UUID
    "Timestamp when this translation was created"
    created: DateTime!
    "Timestamp when this translation was last modified"
    modified: DateTime!
    "Audit trail of every state or text change for this translation"
    history: [TranslationHistory!]!
}

"A single plural form of a translation (one row per CLDR category per language)"
type LocalizationPluralTranslation {
    "Unique identifier"
    id: UUID!
    "The source string this plural row belongs to"
    stringId: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "The CLDR plural category this row represents"
    pluralCategory: PluralCategory!
    "Translated text for this plural form"
    text: String!
    "Current workflow state"
    state: TranslationState!
    "Provenance"
    origin: TranslationOrigin!
    "Optional detail describing origin"
    originDetail: String
    "Principal ID of the reviewer, null when unreviewed"
    reviewedBy: UUID
    "Timestamp of the most recent review action"
    reviewedAt: DateTime
    "Principal ID of the creator"
    createdBy: UUID
    "Timestamp when this row was created"
    created: DateTime!
    "Timestamp when this row was last modified"
    modified: DateTime!
}

"Aggregate progress counters for a project+language pair"
type TranslationProgress {
    "Total translatable strings in the project"
    totalStrings: Int!
    "Strings that have any translation (regardless of state)"
    translatedStrings: Int!
    "Strings whose translation is approved or published"
    approvedStrings: Int!
    "Strings whose translation is published"
    publishedStrings: Int!
    "Strings whose current translation originated from AI"
    aiGeneratedStrings: Int!
    "Strings whose current translation originated from a human"
    humanTranslatedStrings: Int!
    "Translated strings as a percentage of total strings (0-100)"
    percentage: Float!
}

"Input for a declared ICU placeholder on a LocalizationString"
input LocalizationPlaceholderInput {
    "Placeholder identifier (e.g. 'count')"
    name: String!
    "Value type hint: string | number | date | time | currency"
    type: String
    "Optional sample value shown to translators"
    example: String
}

"Input for creating or editing a LocalizationString"
input LocalizationStringInput {
    "The project this string belongs to"
    projectId: UUID!
    "Stable key used by consumers"
    key: String!
    "Translator context"
    context: String
    "Optional metadata ID providing visual context"
    metadataId: UUID
    "Declared ICU placeholders"
    placeholders: [LocalizationPlaceholderInput!]
    "Optional maximum length for translations"
    maxLength: Int
    "Freeform tags"
    tags: [String!]
    "Whether this string has plural forms"
    plural: Boolean
}

"Input for upserting a non-plural translation"
input LocalizationTranslationInput {
    "The source string"
    stringId: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "Translated text"
    text: String!
    "Provenance of this translation (defaults to HUMAN)"
    origin: TranslationOrigin
    "Optional detail describing origin"
    originDetail: String
}

"Input for upserting a single plural translation row"
input LocalizationPluralTranslationInput {
    "The source string"
    stringId: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "CLDR plural category"
    pluralCategory: PluralCategory!
    "Translated text"
    text: String!
    "Provenance of this translation (defaults to HUMAN)"
    origin: TranslationOrigin
    "Optional detail describing origin"
    originDetail: String
}
