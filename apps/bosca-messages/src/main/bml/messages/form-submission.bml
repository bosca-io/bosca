{# 05 Form Submission — reviewer notification when a form submission is created
   (FormSubmissionCreated -> the forms notification job; upgrades its plain-text message).
   The panel is the submission record: form name, who it came from (name/email when known,
   Anonymous otherwise), display time, then the submitted fields as label/value rows — or the
   explicit empty state — and a full-width review CTA into Studio. Localized;
   field labels/values are payload data and render as sent. #}
<message key="form-submission">
  <script server provides="m">
    import bosca.messages.FormSubmission
    message.payload(FormSubmission.serializer())
  </script>
  <script server provides="assets">message.assetsUrl ?: error("BmlMessageContext.assetsUrl is required — emails cannot reference relative asset URLs")</script>
  <script server provides="submitter">m.submitterName ?: m.submitterEmail ?: t("form-submission.anonymous", "Anonymous")</script>
  <script server provides="submitterMeta">if (m.submitterName != null) m.submitterEmail.orEmpty() else ""</script>
  <script server provides="subject">m.subject?.takeIf { it.isNotBlank() } ?: t("form-submission.subject", "New submission: {formName}", "formName" to m.formName)</script>
  <script server provides="eyebrow">t("form-submission.eyebrow", "Forms")</script>
  <script server provides="headline">t("form-submission.headline", "New form submission")</script>
  <script server provides="cta">t("form-submission.cta", "Review submission")</script>
  <script server provides="preheader">t("form-submission.preheader", "{formName} received a new submission from {submitter}.", "formName" to m.formName, "submitter" to submitter)</script>
  <script server provides="reason">t("form-submission.reason", "You're receiving this because you're a reviewer for {formName} on {appName}.", "formName" to m.formName, "appName" to m.appName)</script>
  <email>
    <subject>{ subject }</subject>
    <bosca-shell :brand="m.appName" :logo="m.logoUrl" :logoOnly="m.logoOnly" title="{ m.appName } · Form Submission" :preheader="preheader" :assets="assets" :unsubscribe="message.unsubscribeUrl" :preferences="message.preferencesUrl" :reason="reason" :primaryColor="m.primaryColor">

      <bosca-heading :eyebrow="eyebrow" :headline="headline" :name="message.recipientName" :primaryColor="m.primaryColor" :accentColor="m.accentColor">
        <span t="form-submission.lede">{ m.formName } received a new submission from { submitter }.</span>
      </bosca-heading>

      <panel :accentColor="m.accentColor">
        <p class="em-metalabel" style="margin:0;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;letter-spacing:0.2em;font-weight:500;text-transform:uppercase;color:{ m.accentColor };"><span t="form-submission.meta-label">Submission</span>&nbsp;&nbsp;·&nbsp;&nbsp;{ m.submittedAt }</p>
        <p style="margin:8px 0 0;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-weight:600;font-size:17px;line-height:1.35;letter-spacing:-0.01em;color:{ m.primaryColor };">{ m.formName }</p>
        <p style="margin:4px 0 0;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:0.2px;color:#5a6072;"><span t="form-submission.from">From { submitter }</span><if submitterMeta.isNotBlank()>&nbsp;&nbsp;·&nbsp;&nbsp;{ submitterMeta }</if></p>
        <if m.fields.isNotEmpty()>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 0;border-top:1px solid #e5e8ee;">
            <for f in m.fields>
              <tr>
                <td width="130" valign="top" style="padding:10px 12px 10px 0;border-bottom:1px solid #e5e8ee;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;letter-spacing:0.14em;font-weight:500;text-transform:uppercase;color:#5a6072;">{ f.label }</td>
                <td valign="top" style="padding:10px 0;border-bottom:1px solid #e5e8ee;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:{ m.primaryColor };word-break:break-word;">{ f.value }</td>
              </tr>
            </for>
          </table>
        <else>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 0;border-top:1px solid #e5e8ee;">
            <tr>
              <td t="form-submission.empty" style="padding:12px 0 0;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#5a6072;">This submission carried no field values.</td>
            </tr>
          </table>
        </if>
        <cta-button wide :href="m.reviewUrl" :label="cta" :primaryColor="m.primaryColor"/>
      </panel>

    </bosca-shell>
  </email>
</message>
