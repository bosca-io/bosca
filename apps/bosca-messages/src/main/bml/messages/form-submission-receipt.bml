{# 06 Form Submission Receipt — confirmation to the submitter that their submission was
   received. The panel is the keepsake: form name + received time, with an optional echo of
   what they sent (the section hides when the payload carries no fields). The optional
   "what happens next" line comes from the form's configuration; no CTA — a receipt asks
   nothing further of the reader. Localized; nextSteps and field labels/values
   are payload data and render as sent. #}
<message key="form-submission-receipt">
  <script server provides="m">
    import bosca.messages.FormSubmissionReceipt
    message.payload(FormSubmissionReceipt.serializer())
  </script>
  <script server provides="assets">message.assetsUrl ?: error("BmlMessageContext.assetsUrl is required — emails cannot reference relative asset URLs")</script>
  <script server provides="subject">t("form-submission-receipt.subject", "Your {formName} submission was received", "formName" to m.formName)</script>
  <script server provides="eyebrow">t("form-submission-receipt.eyebrow", "Forms")</script>
  <script server provides="headline">t("form-submission-receipt.headline", "Submission received")</script>
  <script server provides="preheader">t("form-submission-receipt.preheader", "We received your {formName} submission.", "formName" to m.formName)</script>
  <script server provides="reason">t("form-submission-receipt.reason", "You're receiving this because you submitted {formName} on {appName}.", "formName" to m.formName, "appName" to m.appName)</script>
  <email>
    <subject>{ subject }</subject>
    <bosca-shell :brand="m.appName" :logo="m.logoUrl" :logoOnly="m.logoOnly" title="{ m.appName } · Submission Received" :preheader="preheader" :assets="assets" :unsubscribe="message.unsubscribeUrl" :preferences="message.preferencesUrl" :reason="reason" :primaryColor="m.primaryColor">

      <bosca-heading :eyebrow="eyebrow" :headline="headline" :name="message.recipientName" :primaryColor="m.primaryColor" :accentColor="m.accentColor">
        <span t="form-submission-receipt.lede">Your submission to { m.formName } was received.</span><if m.nextSteps.isNotBlank()> { m.nextSteps }</if>
      </bosca-heading>

      <panel :accentColor="m.accentColor">
        <p class="em-metalabel" style="margin:0;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;letter-spacing:0.2em;font-weight:500;text-transform:uppercase;color:{ m.accentColor };"><span t="form-submission-receipt.meta-label">Received</span>&nbsp;&nbsp;·&nbsp;&nbsp;{ m.submittedAt }</p>
        <p style="margin:8px 0 0;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-weight:600;font-size:17px;line-height:1.35;letter-spacing:-0.01em;color:{ m.primaryColor };">{ m.formName }</p>
        <if m.fields.isNotEmpty()>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 0;border-top:1px solid #e5e8ee;">
            <tr>
              <td colspan="2" style="padding:12px 0 2px;">
                <p t="form-submission-receipt.sent-label" style="margin:0;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;letter-spacing:0.18em;font-weight:500;text-transform:uppercase;color:#898fa1;">What you sent</p>
              </td>
            </tr>
            <for f in m.fields>
              <tr>
                <td width="130" valign="top" style="padding:10px 12px 10px 0;border-bottom:1px solid #e5e8ee;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;letter-spacing:0.14em;font-weight:500;text-transform:uppercase;color:#5a6072;">{ f.label }</td>
                <td valign="top" style="padding:10px 0;border-bottom:1px solid #e5e8ee;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:{ m.primaryColor };word-break:break-word;">{ f.value }</td>
              </tr>
            </for>
          </table>
        </if>
      </panel>

    </bosca-shell>
  </email>
</message>
