{# 03 Reset Password — account recovery (the BML successor to the legacy `forgot-password`
   template). One action: reset. The safe-to-ignore note makes the no-op path explicit — an
   unrequested reset email must never read as an alarm. Localized. #}
<message key="reset-password">
  <script server provides="m">
    import bosca.messages.ResetPassword
    message.payload(ResetPassword.serializer())
  </script>
  <script server provides="assets">message.assetsUrl ?: error("BmlMessageContext.assetsUrl is required — emails cannot reference relative asset URLs")</script>
  <script server provides="subject">t("reset-password.subject", "Reset your {appName} password", "appName" to m.appName)</script>
  <script server provides="eyebrow">t("reset-password.eyebrow", "Account recovery")</script>
  <script server provides="headline">t("reset-password.headline", "Reset your password")</script>
  <script server provides="cta">t("reset-password.cta", "Reset password")</script>
  <script server provides="preheader">t("reset-password.preheader", "Use the link inside to choose a new password.")</script>
  <script server provides="reason">t("reset-password.reason", "You're receiving this because a password reset was requested for your {appName} account.", "appName" to m.appName)</script>
  <email>
    <subject>{ subject }</subject>
    <bosca-shell :brand="m.appName" :logo="m.logoUrl" :logoOnly="m.logoOnly" title="{ m.appName } · Reset Password" :preheader="preheader" :assets="assets" :unsubscribe="message.unsubscribeUrl" :preferences="message.preferencesUrl" :reason="reason" :primaryColor="m.primaryColor">

      <bosca-heading :eyebrow="eyebrow" :headline="headline" :name="message.recipientName" :primaryColor="m.primaryColor" :accentColor="m.accentColor">
        <span t="reset-password.lede">We received a request to reset the password for your { m.appName } account. Use the button below to choose a new one.</span>
      </bosca-heading>

      <cta-button :href="m.resetUrl" :label="cta" :primaryColor="m.primaryColor"/>

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <if m.expiresIn.isNotBlank()>
          <tr>
            <td t="shared.expires" style="padding:22px 0 0;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#5a6072;">This link expires in { m.expiresIn }.</td>
          </tr>
        </if>
        <tr>
          <td t="reset-password.ignore" style="padding:8px 0 0;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#898fa1;">If you didn't request this, you can safely ignore this email — your password won't change.</td>
        </tr>
        <tr>
          <td style="padding:24px 0 0;">
            <p t="shared.paste-label" style="margin:0 0 5px;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;letter-spacing:0.18em;font-weight:500;text-transform:uppercase;color:#898fa1;">Or paste this link into your browser</p>
            <a :href="m.resetUrl" style="font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:12px;line-height:1.6;color:{ m.accentColor };word-break:break-all;">{ m.resetUrl }</a>
          </td>
        </tr>
      </table>

    </bosca-shell>
  </email>
</message>
