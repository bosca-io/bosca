{# The card heading every Bosca email opens with: the Geist Mono eyebrow in the text-safe brand
   green, a PLAIN headline, then the greeting line ("Hi Sarah,") when the recipient's name is
   known — never a name clause welded onto the headline — and the slotted lede paragraph. #}
<component tag="bosca-heading">
  <prop name="eyebrow" type="String" required/>
  <prop name="headline" type="String" required/>
  <prop name="name" type="String?"/>
  <prop name="primaryColor" type="String" default="#0e1019"/>
  <prop name="accentColor" type="String" default="#047a52"/>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td>
        <p style="margin:0 0 12px;font-family:'Geist Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.22em;font-weight:500;text-transform:uppercase;color:{ accentColor };">{ eyebrow }</p>
        <h1 class="em-h1" style="margin:0 0 18px;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-weight:600;font-size:23px;line-height:1.3;letter-spacing:-0.015em;color:{ primaryColor };">{ headline }</h1>
        <if name != null>
          <p t="shared.greeting" style="margin:0 0 10px;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#2a2e3a;">Hi { name },</p>
        </if>
        <p class="em-body" style="margin:0 0 26px;font-family:'Geist',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#2a2e3a;">
          <slot/>
        </p>
      </td>
    </tr>
  </table>
</component>
