# Registry that serves @bosca packages, as host and path, e.g. artifacts.example.com/npm.
@bosca:registry=https://${BOSCA_NPM_REGISTRY}/
//${BOSCA_NPM_REGISTRY}/:_authToken=${NPM_TOKEN}
# Keep registry hosts out of package-lock.json; integrity hashes still pin each package.
omit-lockfile-registry-resolved=true
