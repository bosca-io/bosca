<component tag="toast-message">
  <prop name="message" type="String?" required/>
  <prop name="failed" type="Boolean" required/>
  <prop name="id" type="Long" required/>
  <prop name="preserveKey" type="String" required/>
  <prop name="actionHref" type="String" default=""/>
  <prop name="actionLabel" type="String" default=""/>
  <prop name="actionSignOut" type="Boolean" default="false"/>

  <p data-toast :data-bml-preserve="preserveKey" :data-toast-tone='if (failed) "error" else "success"' :data-toast-id="id" :data-toast-message="message.orEmpty()" :data-toast-action-href="actionHref" :data-toast-action-label="actionLabel" :data-toast-action-sign-out="actionSignOut" hidden>{ message }</p>
  <script client scoped>
    import { toastMessage } from "@client/helpers/toast-message"
    toastMessage(ctx)
  </script>
</component>
