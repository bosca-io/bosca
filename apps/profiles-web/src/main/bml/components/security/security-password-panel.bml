<component tag="security-password-panel">
  <prop name="hasPassword" type="Boolean" required/>

  <section class="card section-card">
    <div class="section-heading">
      <div>
        <h2>{ if (hasPassword) "Change password" else "Password" }</h2>
        <p class="card-copy">{ if (hasPassword) "Changing your password signs out every existing login." else "This account currently signs in through a connected provider or passkey." }</p>
      </div>
    </div>
    <if hasPassword>
      <form class="form-grid password-form" ref="form">
        <label class="field full">
          <span>Current password</span>
          <input ref="current" type="password" autocomplete="current-password" required/>
        </label>
        <label class="field">
          <span>New password</span>
          <input ref="next" type="password" autocomplete="new-password" minlength="8" maxlength="128" required/>
        </label>
        <label class="field">
          <span>Confirm new password</span>
          <input ref="confirm" type="password" autocomplete="new-password" minlength="8" maxlength="128" required/>
        </label>
        <p class="status error full" ref="error" hidden></p>
        <div class="actions full"><button class="primary" ref="submit" type="submit">Change password</button></div>
      </form>
    <else>
      <p class="empty compact">No password credential is configured.</p>
    </if>

    <script client scoped>
      const form = ctx.ref<HTMLFormElement>("form")
      const current = ctx.ref<HTMLInputElement>("current")
      const next = ctx.ref<HTMLInputElement>("next")
      const confirm = ctx.ref<HTMLInputElement>("confirm")
      const submit = ctx.ref<HTMLButtonElement>("submit")
      const error = ctx.ref<HTMLParagraphElement>("error")
      if (form && current && next && confirm && submit && error) {
        ctx.on<SubmitEvent>(form, "submit", async (event) => {
          event.preventDefault()
          error.hidden = true
          if (next.value !== confirm.value) {
            error.textContent = "The new passwords do not match."
            error.hidden = false
            return
          }
          submit.disabled = true
          try {
            await auth.changePassword(next.value, current.value)
            auth.destroy()
            location.assign("/login?passwordChanged=true")
          } catch (reason) {
            error.textContent = reason instanceof Error ? reason.message : "Password change failed. Please try again."
            error.hidden = false
            submit.disabled = false
          }
        })
      }
    </script>
  </section>
</component>
