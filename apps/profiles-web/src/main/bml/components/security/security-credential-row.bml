<component tag="security-credential-row">
  <prop name="credential" type="bosca.profiles.web.CredentialRow" required/>
  <prop name="canUnlink" type="Boolean" required/>

  <div class="list-row">
    <div class="row-main">
      <div class="row-title">{ credential.label }</div>
      <div class="row-meta">{ credential.identifier }</div>
      <if credential.lastOriginator.isNotBlank()><div class="row-meta">Last used by { credential.lastOriginator }</div></if>
    </div>
    <div class="row-actions">
      <if canUnlink>
        <slot/>
      <else>
        <span class="row-meta">A password is required to unlink</span>
      </if>
    </div>
  </div>
</component>
