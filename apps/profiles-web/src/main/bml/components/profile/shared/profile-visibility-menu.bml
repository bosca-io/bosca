<component tag="profile-visibility-menu">
  <prop name="visibility" type="bosca.profiles.web.graphql.ProfileVisibility" required/>
    <details class="visibility-menu">
      <summary class="icon-trigger visibility-trigger" aria-label="Change visibility" title="Visibility">
        <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/>
          <circle cx="12" cy="12" r="2.75"/>
        </svg>
        <span class="visibility-current" data-visibility-label>
          <if visibility == bosca.profiles.web.graphql.ProfileVisibility.USER>
            User
          <else>
            <if visibility == bosca.profiles.web.graphql.ProfileVisibility.FRIENDS>
              Friends
            <else>
              <if visibility == bosca.profiles.web.graphql.ProfileVisibility.FRIENDS_OF_FRIENDS>
                Friends of Friends
              <else>
                Public
              </if>
            </if>
          </if>
        </span>
      </summary>
      <div class="visibility-popover">
        <label class="field visibility-popover-panel">
          <span>Visibility</span>
          <select name="visibility" ref="visibility">
            <option value="USER" :selected="visibility == bosca.profiles.web.graphql.ProfileVisibility.USER">User</option>
            <option value="FRIENDS" :selected="visibility == bosca.profiles.web.graphql.ProfileVisibility.FRIENDS">Friends</option>
            <option value="FRIENDS_OF_FRIENDS" :selected="visibility == bosca.profiles.web.graphql.ProfileVisibility.FRIENDS_OF_FRIENDS">Friends of Friends</option>
            <option value="PUBLIC" :selected="visibility == bosca.profiles.web.graphql.ProfileVisibility.PUBLIC">Public</option>
          </select>
        </label>
      </div>
    </details>
  <script client scoped>
    import { profileDisclosure } from "@client/helpers/profile-disclosure"
    profileDisclosure(ctx)
    const select = ctx.ref<HTMLSelectElement>("visibility")
    const sync = () => {
      const selected = select?.selectedOptions.item(0)?.textContent?.trim()
      const label = ctx.root.querySelector<HTMLElement>("[data-visibility-label]")
      if (label && selected) label.textContent = selected
      const trigger = ctx.root.querySelector("summary")
      if (trigger && selected) trigger.title = `Visibility: ${selected}`
    }
    if (select) ctx.on(select, "change", () => { sync(); (ctx.root as HTMLDetailsElement).open = false })
    sync()
  </script>
</component>
