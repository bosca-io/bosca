{# Manage preferences (/preferences?token=…): the per-channel notification matrix for the
   recipient the token identifies. Fully anonymous — the token minted into the email footer IS
   the credential. Declarative: every toggle and the unsubscribe-all form are island
   actions; the server runs the mutation and re-renders the matrix. No authored client script;
   the compiler emits the BML live-island runtime module. #}
<page route="/preferences">
  <script server provides="branding">
    bosca.notifications.web.branding()
  </script>
  <script server provides="page">
    bosca.notifications.web.preferences()
  </script>
  <script server provides="prefs">
    bosca.notifications.web.PreferencesModel(page.token, page.rows, page.invalid)
  </script>

  <site-layout title="Notification preferences" :brand="branding.name" :logo="branding.logoUrl" :footer="branding.footerText">
    <main class="wrap">
      <div class="card">
        <h1>Notification preferences</h1>
        <if page.invalid>
          <p class="status error">This link is invalid or has expired. Open a newer email from
          us and use its "Manage preferences" link.</p>
        <else>
          <p class="sub">Choose which notifications you'd like to receive, by email and by push.
          Essential account and security messages are always delivered.</p>
          <island name="prefs-matrix">
            <div class="matrix">
              <div class="row head">
                <span class="row-text"></span>
                <span class="col-label" id="email-channel">Email</span>
                <span class="col-label" id="push-channel">Push</span>
              </div>
              <for row in prefs.rows>
                <div class="row">
                  <span class="row-text">
                    <span class="row-name" :id='"preference-" + row.key'>{ row.name }</span>
                    <if row.description != "">
                      <span class="row-desc">{ row.description }</span>
                    </if>
                  </span>
                  <if !row.optional>
                    <span class="always" title="Always delivered — this notification cannot be turned off.">Always on</span>
                  <else>
                    <span class="switch-cell">
                      <switch label="Email" :checked="!row.emailOptedOut"
                        :aria-labelledby='"email-channel preference-" + row.key'
                        :name='"email-" + row.key' @change="prefs.toggleEmail(row.key)" />
                    </span>
                    <span class="switch-cell">
                      <switch label="Push" :checked="!row.pushOptedOut"
                        :aria-labelledby='"push-channel preference-" + row.key'
                        :name='"push-" + row.key' @change="prefs.togglePush(row.key)" />
                    </span>
                  </if>
                </div>
              </for>
            </div>
            <toast id="preference-outcome" :message='prefs.message ?: ""'
              :sequence="prefs.messageId" :tone='if (prefs.failed) "error" else "success"' />
            <form class="actions" @submit="prefs.unsubscribeAll()">
              <button type="submit">Unsubscribe from all optional email</button>
            </form>
          </island>
        </if>
      </div>
    </main>


  </site-layout>
</page>
