{# Manage preferences (/preferences?token=…): the per-channel notification matrix for the
   recipient the token identifies. Fully anonymous — the token minted into the email footer IS
   the credential. Declarative: every toggle and the unsubscribe-all button are @click island
   actions; the server runs the mutation and re-renders the matrix. No authored client script;
   the compiler emits the BML live-island runtime module. #}
<page route="/preferences">
  <script server provides="branding">
    bosca.notifications.web.branding()
  </script>
  <script server provides="page">
    bosca.notifications.web.preferences()
  </script>
  <script server provides="prefs">
    bosca.notifications.web.PreferencesModel(page.token, page.rows, page.invalid)
  </script>

  <site-layout title="Notification preferences" :brand="branding.name" :logo="branding.logoUrl" :footer="branding.footerText">
    <main class="wrap">
      <div class="card">
        <h1>Notification preferences</h1>
        <if page.invalid>
          <p class="status error">This link is invalid or has expired. Open a newer email from
          us and use its "Manage preferences" link.</p>
        <else>
          <p class="sub">Choose which notifications you'd like to receive, by email and by push.
          Essential account and security messages are always delivered.</p>
          <island name="prefs-matrix">
            <div class="matrix">
              <div class="row head">
                <span class="row-text"></span>
                <span class="col-label">Email</span>
                <span class="col-label">Push</span>
              </div>
              <for row in prefs.rows>
                <div class="row">
                  <span class="row-text">
                    <span class="row-name">{ row.name }</span>
                    <if row.description != "">
                      <span class="row-desc">{ row.description }</span>
                    </if>
                  </span>
                  <if !row.optional>
                    <span class="always" title="Always delivered — this notification cannot be turned off.">Always on</span>
                  <else>
                    <span class="switch-cell">
                      <if row.emailOptedOut>
                        <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Email notifications for { row.name }" @click="prefs.toggleEmail(row.key)" title="Turn this email back on">
                          <span class="switch-thumb" aria-hidden="true"></span>
                        </button>
                      <else>
                        <button class="switch on" type="button" role="switch" aria-checked="true" aria-label="Email notifications for { row.name }" @click="prefs.toggleEmail(row.key)" title="Turn this email off">
                          <span class="switch-thumb" aria-hidden="true"></span>
                        </button>
                      </if>
                    </span>
                    <span class="switch-cell">
                      <if row.pushOptedOut>
                        <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Push notifications for { row.name }" @click="prefs.togglePush(row.key)" title="Turn these push notifications back on">
                          <span class="switch-thumb" aria-hidden="true"></span>
                        </button>
                      <else>
                        <button class="switch on" type="button" role="switch" aria-checked="true" aria-label="Push notifications for { row.name }" @click="prefs.togglePush(row.key)" title="Turn these push notifications off">
                          <span class="switch-thumb" aria-hidden="true"></span>
                        </button>
                      </if>
                    </span>
                  </if>
                </div>
              </for>
            </div>
            <if prefs.message != null>
              <p class="{ prefs.statusClass }">{ prefs.message }</p>
            </if>
            <div class="actions">
              <button class="ghost" type="button" @click="prefs.unsubscribeAll()">Unsubscribe from all optional email</button>
            </div>
          </island>
        </if>
      </div>
    </main>

    {# This page's styles — the matrix rows, the channel columns, and the switches. #}
    <style>
      .matrix {
        border: 1px solid var(--hairline);
        border-radius: 10px;
        overflow: hidden;
      }

      .row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--hairline);
        background: var(--card);
      }

      .row:last-child {
        border-bottom: none;
      }

      .row.head {
        padding: 8px 16px;
        background: var(--panel);
      }

      .col-label {
        flex: none;
        width: 52px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .row-text {
        display: grid;
        gap: 2px;
        min-width: 0;
        flex: 1;
      }

      .row-name {
        font-weight: 500;
      }

      .row-desc {
        font-size: 13px;
        color: var(--muted);
      }

      .always {
        flex: none;
        width: 116px;
        text-align: center;
        font-size: 12px;
        color: var(--muted);
        border: 1px solid var(--hairline);
        border-radius: 999px;
        padding: 3px 0;
        background: var(--panel);
      }

      .switch-cell {
        display: flex;
        flex: none;
        width: 52px;
        justify-content: center;
      }

      .switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        flex: none;
        width: 46px;
        height: 26px;
        margin: 0;
        padding: 2px;
        border-radius: 999px;
        border: 1px solid #c9ced6;
        background: #dfe3e8;
        appearance: none;
        cursor: pointer;
        transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
      }

      .switch:hover {
        border-color: #aeb5bf;
        background: #d4d9df;
      }

      .switch.on {
        border-color: var(--accent);
        background: var(--accent);
      }

      .switch.on:hover {
        filter: brightness(0.94);
      }

      .switch:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }

      .switch-thumb {
        display: block;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: 0 1px 3px rgb(14 16 25 / 28%);
        transform: translateX(0);
        transition: transform 160ms ease;
      }

      .switch.on .switch-thumb {
        transform: translateX(20px);
      }

      .switch:active .switch-thumb {
        transform: scale(0.92);
      }

      .switch.on:active .switch-thumb {
        transform: translateX(20px) scale(0.92);
      }

      @media (prefers-reduced-motion: reduce) {
        .switch,
        .switch-thumb {
          transition: none;
        }
      }

      .actions {
        margin-top: 18px;
      }
    </style>
  </site-layout>
</page>
