<component tag="widget-controls">
  <prop name="id" type="String" required />
  <script server provides="widgets" scope="server-session">bosca.design.example.WidgetsState(id)</script>
  <card :title='"Widgets " + id'><island name="widgets" :key="id">
    <div class="widget-stack" :data-widgets="widgets.id">
      <form class="widget-stack" @submit="widgets.save(form.document, form.graph, form.layout)" :data-widget-form="widgets.id">
        <document-editor :id='"document-" + widgets.id' :label='"Document " + widgets.id' :document="widgets.sourceDocument" :value="widgets.document"
                         required :preserveKey='"document-" + widgets.id' />
        <flow-editor :id='"flow-" + widgets.id' :label='"Graph " + widgets.id' :value="widgets.graph"
                     :preserveKey='"flow-" + widgets.id' />
        <dashboard-grid :id='"grid-" + widgets.id' :label='"Dashboard " + widgets.id' :value="widgets.layout"
                        :preserveKey='"grid-" + widgets.id'>
          <dashboard-item itemId="chart" label="Visits">
            <chart :id='"chart-" + widgets.id' :label='"Visits " + widgets.id' :config="widgets.chart" />
          </dashboard-item>
          <dashboard-item itemId="notes" label="Notes">
            <field label="Dashboard note"><input name="note" value="Unsent note" /></field>
          </dashboard-item>
        </dashboard-grid>
        <div class="actions">
          <button type="submit" :data-widget-save="widgets.id">Save { widgets.saves }</button>
          <button type="reset">Reset drafts</button>
          <button @click="widgets.refresh()" :data-widget-refresh="widgets.id">Refresh { widgets.updates }</button>
        </div>
      </form>
      <if widgets.saves != 0>
        <details><summary>Saved values</summary><div class="widget-stack">
          <pre data-saved-document>{ widgets.document }</pre>
          <pre data-saved-graph>{ kotlinx.serialization.json.Json.encodeToString(bosca.design.model.FlowGraph.serializer(), widgets.graph) }</pre>
          <pre data-saved-layout>{ kotlinx.serialization.json.Json.encodeToString(kotlinx.serialization.builtins.ListSerializer(bosca.design.model.DashboardLayoutItem.serializer()), widgets.layout) }</pre>
        </div></details>
      </if>
    </div>
  </island></card>
</component>
