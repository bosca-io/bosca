<page route="/foundation">
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Foundation controls</title>
    </head>
    <body>
      <page-shell class="fixture-shell">
        <h1>Foundation controls</h1>
        <div class="themes">
          <div class="light" data-palette="light"><foundation-controls id="light" /></div>
          <div class="purple" data-palette="purple"><foundation-controls id="purple" /></div>
        </div>
      </page-shell>
    </body>
  </html>
</page>
