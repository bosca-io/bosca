<page route="/selection">
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Search and local views</title>
    </head>
    <body>
      <page-shell>
        <h1>Search and local views</h1>
        <div class="themes">
          <div class="light selection-theme" data-palette="light"><selection-controls id="light" /></div>
          <div class="purple selection-theme" data-palette="purple"><selection-controls id="purple" /></div>
        </div>
        <div class="selection-edge-cases">
          <search-input value="" label="Empty search" :autofocus="false" data-empty-search />
          <search-input value="Readonly value" label="Readonly search" :autofocus="false" readonly data-readonly-search />
          <segmented-control label="Empty choices" name="empty" :options="emptyList()" value="" data-empty-segments />
          <segmented-control label="Unmatched choice" name="unknown" :options='listOf("One", "Two")' value="unknown" data-unmatched-segments />
          <view-tabs label="Empty views" :tabs="emptyList()" selected="" data-empty-views />
          <segmented-control label="Hidden choices" name="hidden-choice" :options='listOf("One", "Two")' value="One" hidden data-hidden-segments />
          <view-tabs label="Hidden views" :tabs='listOf("One", "Two")' selected="One" hidden data-hidden-views />
          <view-tabs label="Unmatched view" :tabs='listOf("One", "Two")' selected="unknown" data-unmatched-views />
          <segmented-control label="Long choices" name="long" :options='listOf("Components with long descriptive labels", "Application-owned arrangements", "Overlays and layered content")' value="Components with long descriptive labels" data-long-segments />
          <view-tabs label="Long view names" :tabs='listOf("A deliberately long preview title", "Application-owned details and examples", "Complete authoring source")' selected="A deliberately long preview title" data-long-views />
        </div>
      </page-shell>
    </body>
  </html>
</page>
