<page route="/clipboard">
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Clipboard controls</title>
    </head>
    <body>
      <page-shell>
        <h1>Clipboard controls</h1>
        <div class="themes">
          <div class="light clipboard-theme" data-palette="light"><clipboard-controls id="light" /></div>
          <div class="purple clipboard-theme" data-palette="purple"><clipboard-controls id="purple" /></div>
        </div>
      </page-shell>
    </body>
  </html>
</page>
