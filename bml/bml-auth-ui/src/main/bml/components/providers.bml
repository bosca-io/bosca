<component tag="auth-providers">
  <a ref="google" class="provider-btn" href="/oauth2/google/login">
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="#4285f4"
        d="M21.6 12.23c0-.71-.06-1.39-.18-2.05H12v3.88h5.38a4.6 4.6 0 0 1-1.99 3.02v2.51h3.22c1.89-1.74 2.99-4.3 2.99-7.36Z"
      />
      <path
        fill="#34a853"
        d="M12 22c2.7 0 4.96-.9 6.61-2.41l-3.22-2.51c-.89.6-2.03.96-3.39.96-2.6 0-4.8-1.76-5.59-4.12H3.08v2.59A10 10 0 0 0 12 22Z"
      />
      <path
        fill="#fbbc05"
        d="M6.41 13.92a6 6 0 0 1 0-3.84V7.49H3.08a10 10 0 0 0 0 9.02l3.33-2.59Z"
      />
      <path
        fill="#ea4335"
        d="M12 5.96c1.47 0 2.79.51 3.83 1.51l2.87-2.87A9.61 9.61 0 0 0 12 2a10 10 0 0 0-8.92 5.49l3.33 2.59C7.2 7.72 9.4 5.96 12 5.96Z"
      />
    </svg>
    Continue with Google
  </a>
  <div class="auth-divider">or with email</div>
  <style scoped>
    .provider-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 40px;
      font-size: 13px;
      font-weight: 500;
      background: #ffffff0a;
      border: 1px solid #ffffff1a;
      border-radius: 10px;
      color: #cdd2e2;
    }
    .auth-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 18px;
      font-size: 11.5px;
      color: #969cb1;
    }
    .auth-divider::before,
    .auth-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #ffffff14;
    }
  </style>
  <script client scoped>
    const google = ctx.ref<HTMLAnchorElement>("google");
    if (google) google.href = boscaAuthFlow.googleUrl();
  </script>
</component>
