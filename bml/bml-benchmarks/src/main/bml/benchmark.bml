<page route="/benchmark" cache="shared" maxAge="60" staleWhileRevalidate="60">
  <script server provides="items">
    (1..24).map { "Item $it <&>" }
  </script>
  <html lang="en">
    <head><title>BML benchmark</title></head>
    <body>
      <main>
        <h1>Items</h1>
        <ul>
          <for item in items>
            <li data-kind="item">{ item }</li>
          </for>
        </ul>
      </main>
    </body>
  </html>
</page>
