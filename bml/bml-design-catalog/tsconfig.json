{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@bosca/bml": ["../bml-runtime/src/index.ts"]
    }
  },
  "include": ["build/generated/bml/ts/**/*.ts"]
}
