<component tag="search-views-example">
  <prop name="id" type="String" required />
  <script server provides="views" scope="server-session">bosca.design.catalog.CatalogViews(id)</script>
  <island name="views" :key="id">
    <div class="catalog-stack" :data-search-views="views.id">
      <if views.visible>
        <form @submit="views.search(form.q, form.category)" class="example-form" :data-views-form="views.id">
          <search-input :value="views.query" :disabled="views.disabled" :autofocus="false" label="Search catalog examples"
                        placeholder="Try layout or control…" maxlength="120" :data-views-query="views.id"
                        :preserveKey='"views-query-" + views.id' :aria-describedby='"views-hint-" + views.id' />
          <p class="example-note" :id='"views-hint-" + views.id'>Search these local catalog examples. Category choices supply a native form value.</p>
          <segmented-control label="Example category" name="category"
                             :options='listOf("All", "Controls", "Layout", "Overlays")'
                             :values='listOf("all", "control", "layout", "overlay")' :icons='listOf("list", "code", "folder", "boxes")'
                             :value="views.mode" :preserveKey='"views-category-" + views.id' :data-views-category="views.id" />
          <div class="example-actions"><button type="submit" primary :disabled="views.disabled" :data-views-submit="views.id">Search examples</button></div>
        </form>
        <div class="catalog-stack" :data-views-panels="views.id">
          <view-tabs label="Search example view" :tabs="views.tabs()" :selected="views.selected"
                     :data-bml-preserve='"views-tabs-" + views.id + "-" + views.revision' :data-views-tabs="views.id" />
          <for view in views.tabs()>
            <div role="tabpanel" tabindex="0" class="catalog-view-panel" :data-views-panel="views.id" :data-view="view" :hidden="views.selected != view"
                 :data-bml-preserve='"views-panel-" + views.id + "-" + view + if (view == "Preview") "-" + views.resultQuery + "-" + views.resultMode else ""'>
              <if view == "Preview">
                <if views.results().isEmpty()><empty-state icon="search" title="No matching examples" message="Try another query or choose All categories." />
                <else><ul class="catalog-result-list"><for choice in views.results()>
                  <li><a class="catalog-link" :href='"/components/" + (if (choice.label.endsWith("· layout")) "layout" else if (choice.label.endsWith("· overlay")) "overlays" else "controls") + "#ref-" + choice.value'>{ choice.label }</a></li>
                </for></ul></if>
              <else-if view == "Details"><p class="catalog-description">The application filters local examples when you submit. Editing a query or category keeps the previous results until the next accepted search.</p>
              <else-if view == "Source"><a class="catalog-link" href="/components/controls#ref-search-input">Read the complete authoring example</a>
              <else><p class="catalog-description">This alternate view belongs to the application. Changing the tab list changes its preservation key.</p>
              </if>
            </div>
          </for>
        </div>
      </if>
      <details data-example-states>
        <disclosure-heading>Example states</disclosure-heading>
        <div class="catalog-stack views-state-options">
          <switch label="Reject searches" :checked="views.rejectSearch" @change="views.toggleRejection" :data-views-reject="views.id" />
          <switch label="Disable search" :checked="views.disabled" @change="views.toggleDisabled" :data-views-disabled="views.id" />
          <switch label="Show controls" :checked="views.visible" @change="views.toggleVisible" :data-views-visible="views.id" />
          <div class="example-actions">
            <button @click="views.replace" :disabled="!views.visible" :data-views-replace="views.id">Replace controlled values</button>
            <button @click="views.changeTabs" :disabled="!views.visible" :data-views-list="views.id">Change tab list</button>
            <button @click="views.refresh" :data-views-refresh="views.id">Refresh example</button>
          </div>
          <p class="example-note">Refresh retains drafts and local choices. Turn rejection off to retry. Replace supplies a different query and view; changing the list remounts the tabs.</p>
        </div>
      </details>
      <toast :id='"views-notice-" + views.id' :message="views.notice" :sequence="views.noticeSequence"
             :tone="views.noticeTone" :data-views-toast="views.id" />
    </div>
  </island>
  <script client scoped>
    import { retainDisclosure } from "@client/catalog-disclosure";
    retainDisclosure(ctx);
    const connectPanels = () => {
      for (const tab of ctx.root.querySelectorAll<HTMLElement>("[data-views-tabs] [role=tab]")) {
        const panel = [...ctx.root.querySelectorAll<HTMLElement>("[role=tabpanel]")].find(panel => panel.dataset.view === tab.dataset.tab);
        if (!panel) continue;
        if (!tab.id) tab.id = `catalog-tab-${crypto.randomUUID()}`;
        if (!panel.id) panel.id = `catalog-panel-${crypto.randomUUID()}`;
        tab.setAttribute("aria-controls", panel.id);
        panel.setAttribute("aria-labelledby", tab.id);
      }
    };
    ctx.on<CustomEvent<string>>(ctx.root, "viewchange", event => {
      for (const panel of ctx.root.querySelectorAll<HTMLElement>("[role=tabpanel]")) panel.hidden = panel.dataset.view !== event.detail;
      ctx.dispatch(views.chooseView(event.detail));
    });
    ctx.onUpdate(connectPanels);
    connectPanels();
  </script>
</component>
