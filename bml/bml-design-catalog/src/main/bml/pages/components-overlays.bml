<page route="/components/overlays">
  <catalog-document title="Dialogs and popovers" description="Modal forms, a rejected confirmation and native disclosures." current="/components">
    <nav class="reference-jumps" aria-label="On this page">
      <a href="#ref-dialog">dialog</a>
      <a href="#ref-confirm-dialog">confirm-dialog</a>
      <a href="#ref-popover">popover</a>
    </nav>
    <reference-entry name="dialog"
      :api='"triggerIconOnly: Boolean = false\ntriggerDisabled: Boolean = false\nshowTrigger: Boolean = true\nreturnFocus: String = \"\"\nsubtitle: String = \"\"\nsize: String = \"md\"\ntitle: String (required)\ntriggerLabel: String (required)\ntriggerIcon: String = \"\"\nicon: String = \"\"\nprimary: Boolean = false\ntriggerStyle: String = \"button\"\nforceOpen: Boolean = false\nopenRequest: String = \"\"\ncompleted: Boolean = false"'
      :contract='"Wrapper div receives additional attributes/classes and contains a native modal dialog. Default children supply the body/form/footer. ref=\"cancel\" or data-dialog-close on a projected control closes it. Native panel widths are 400/520/760px, constrained to the viewport."'
      :keyboard='"Trigger activation opens a native modal and focuses its first available field. Tab stays inside; Escape, backdrop, close or a projected cancel control dismisses and returns focus. Sizes sm/md/lg are 400/520/760px. Applications own forms and outcomes."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --backdrop-color, --bg-1, --bg-2, --dialog-backdrop, --dialog-shadow, --fg-1, --fg-3, --font-sans, --line, --line-2, --r-lg, --shadow-color. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"overlay-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"overlay\" scope=\"server-session\">bosca.design.catalog.CatalogOverlay(id)</script>\n  <island name=\"overlay\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-catalog-overlay=\"overlay.id\" :data-draft-refreshes=\"overlay.draftRefreshes\">\n      <if overlay.mounted>\n        <div class=\"example-actions\">\n          <dialog title=\"Edit display name\" triggerLabel=\"Edit name\" triggerIcon=\"edit\" icon=\"edit\" primary\n                  subtitle=\"Use at least three characters.\" :triggerDisabled=\"overlay.triggerDisabled\"\n                  :forceOpen=\"overlay.reopen\" :completed=\"overlay.completed\" :data-catalog-edit=\"overlay.id\">\n            <form @submit=\"overlay.save(form.name)\" class=\"modal-form\" :data-overlay-form=\"overlay.id\">\n              <div class=\"modal-fields\">\n                <field label=\"Display name\">\n                  <input name=\"name\" :value=\"overlay.name\" required :aria-invalid=\"overlay.error.isNotBlank().toString()\"\n                         :aria-describedby=\u0027if (overlay.error.isNotBlank()) \"overlay-error-\" + overlay.id else null\u0027 />\n                </field>\n                <if overlay.error.isNotBlank()><alert :id=\u0027\"overlay-error-\" + overlay.id\u0027 compact>{overlay.error}</alert></if>\n              </div>\n              <footer class=\"modal-footer\"><button ref=\"cancel\">Cancel</button><button type=\"submit\" primary>Save name</button></footer>\n            </form>\n            <toast :id=\u0027\"overlay-rejected-\" + overlay.id\u0027\n                   :message=\u0027if (overlay.reopen && overlay.error.isBlank() && overlay.noticeTone == \"error\") overlay.notice else \"\"\u0027\n                   :sequence=\"overlay.noticeSequence\" tone=\"error\" :data-overlay-rejection=\"overlay.id\" />\n          </dialog>\n          <confirmation-example :id=\u0027\"overlay-\" + overlay.id\u0027 />\n          <button @click=\"overlay.requestDraft\" :data-overlay-open=\"overlay.id\">Open retained draft</button>\n          <dialog title=\"Retained draft\" triggerLabel=\"Retained draft\" :showTrigger=\"false\" size=\"lg\"\n                  :openRequest=\u0027if (overlay.request > 0) overlay.request.toString() else \"\"\u0027 :completed=\"overlay.draftCompleted\"\n                  :returnFocus=\u0027\"[data-overlay-open=\" + overlay.id + \"]\"\u0027 :data-catalog-draft=\"overlay.id\"\n                  :data-bml-preserve=\u0027\"catalog-draft-\" + overlay.id\u0027>\n            <form class=\"modal-form\" @submit=\"overlay.finishDraft(form.draft)\" :data-draft-form=\"overlay.id\">\n              <div class=\"modal-fields\">\n                <field label=\"Draft\" hint=\"Unrelated updates keep this draft in the browser.\"><input name=\"draft\" value=\"An unsaved draft\" required /></field>\n                <popover label=\"Draft options\" icon=\"settings\" :width=\"260\" :data-nested-popover=\"overlay.id\">\n                  <div class=\"catalog-stack\"><p class=\"example-note\">Escape closes these options before the containing dialog.</p><button ref=\"cancel\">Close options</button></div>\n                </popover>\n                <for number in 1..12><p class=\"example-note\">Draft section {number}. This content scrolls while the action footer remains available.</p></for>\n              </div>\n              <footer class=\"modal-footer\">\n                <button data-dialog-close>Cancel draft</button>\n                <button @click=\"overlay.refreshDraft\" :data-draft-refresh=\"overlay.id\">Refresh example</button>\n                <button type=\"submit\" primary>Save draft</button>\n              </footer>\n            </form>\n          </dialog>\n        </div>\n        <div class=\"catalog-overlay-clip\"><popover-example :id=\"overlay.id\" /></div>\n        <popover label=\"Component actions\" icon=\"more\" iconOnly :width=\"260\" :data-catalog-menu=\"overlay.id\">\n          <div role=\"menu\" class=\"catalog-menu\">\n            <a href=\"#overlay-authoring\" role=\"menuitem\">Read the authoring notes</a>\n            <button role=\"menuitem\" disabled>Unavailable action</button>\n            <button role=\"menuitem\" ref=\"cancel\">Close menu</button>\n          </div>\n        </popover>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack overlay-state-options\">\n          <switch label=\"Reject name saves\" :checked=\"overlay.rejectSaves\" @change=\"overlay.toggleRejection\" :data-overlay-reject=\"overlay.id\" />\n          <switch label=\"Disable the edit trigger\" :checked=\"overlay.triggerDisabled\" @change=\"overlay.toggleDisabled\" :data-overlay-disabled=\"overlay.id\" />\n          <switch label=\"Show overlays\" :checked=\"overlay.mounted\" @change=\"overlay.toggleMounted\" :data-overlay-mounted=\"overlay.id\" />\n          <button @click=\"overlay.refresh\" :data-overlay-refresh=\"overlay.id\">Refresh example</button>\n          <p class=\"example-note\">Turn rejection off to retry a name save. The retained dialog keeps local edits through refresh. Each new open request can reopen a dismissed draft.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"overlay-notice-\" + overlay.id\u0027 :message=\u0027if (overlay.noticeTone == \"error\") \"\" else overlay.notice\u0027 :sequence=\"overlay.noticeSequence\"\n             :tone=\"overlay.noticeTone\" :data-overlay-toast=\"overlay.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <div class="example-actions"><dialog title="Example dialog" triggerLabel="Open dialog" subtitle="The application supplies the content."><div class="catalog-modal-form"><field label="Display name"><input name="dialog-name" value="Design library" /></field><button ref="cancel">Close example</button></div></dialog><dialog title="Unavailable dialog" triggerLabel="Unavailable dialog" triggerDisabled /></div>
    </reference-entry>
    <reference-entry name="confirm-dialog"
      :api='"title: String (required)\ndescription: String (required)\ntriggerLabel: String = \"Remove\"\nicon: String = \"trash\"\nforceOpen: Boolean = false\ntriggerIconOnly: Boolean = true\ntriggerStyle: String = \"button\""'
      :contract='"Small dialog with description and default action children. Additional attributes/classes reach the dialog wrapper. The application owns confirmation actions and their outcomes."'
      :keyboard='"The same modal keyboard behavior as dialog. The application owns the confirmation action; a rejected submission must keep its draft and show the error. triggerStyle and triggerIconOnly change the trigger."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --fg-2. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"confirmation-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"confirmation\" scope=\"server-session\">bosca.design.catalog.CatalogConfirmation(id)</script>\n  <island name=\"confirmation\" :key=\"id\">\n    <confirm-dialog title=\"Remove the sample?\" description=\"This local example rejects the request and retains your reason.\"\n                    triggerLabel=\"Remove sample\" :triggerIconOnly=\"false\" :forceOpen=\"confirmation.error.isNotBlank()\"\n                    :data-catalog-confirm=\"confirmation.id\">\n      <form @submit=\"confirmation.remove(form.reason)\" class=\"catalog-modal-form\">\n        <field label=\"Reason\"><input name=\"reason\" :value=\"confirmation.reason\" required /></field>\n        <div class=\"example-actions\"><button ref=\"cancel\">Keep sample</button><button type=\"submit\" class=\"danger\">Remove sample</button></div>\n      </form>\n      <toast :id=\u0027\"removal-rejected-\" + confirmation.id\u0027 :message=\"confirmation.error\" :sequence=\"confirmation.attempts\"\n             tone=\"error\" :data-catalog-confirm-toast=\"confirmation.id\" />\n    </confirm-dialog>\n  </island>\n</component>"'>
      <div class="example-stack"><confirmation-example id="reference" /><a class="catalog-link" href="/overlays">Working modal and popover states</a></div>
    </reference-entry>
    <reference-entry name="popover"
      :api='"label: String (required)\nicon: String = \"\"\niconOnly: Boolean = false\nwidth: Int = 360"'
      :contract='"Native details with a labelled summary and default children in a labelled region. Additional attributes/classes target details. Scripts enhance its content into a viewport-fitted manual popover; without scripts it remains a native disclosure."'
      :keyboard='"Enter or Space opens native details; scripts enhance positioning and focus the first input. Escape or a projected cancel control returns focus; outside pointer dismissal leaves focus alone. Menu items support arrows and Home/End."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --bg-2, --bg-3, --control-bg, --control-border, --control-gap, --control-height-sm, --fg-1, --focus-offset, --focus-width, --font-sans, --line-2, --popover-shadow, --r-sm, --shadow-color. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"popover-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"options\" scope=\"server-session\">bosca.design.catalog.CatalogPopover(id)</script>\n  <div :data-bml-preserve=\u0027\"catalog-popover-\" + id\u0027>\n    <popover label=\"Filter components\" icon=\"settings\" :width=\"420\" :data-catalog-popover=\"id\">\n      <island name=\"options\" :key=\"id\">\n        <form @submit=\"options.apply(form.filter)\" class=\"catalog-stack\" :data-popover-form=\"options.id\">\n          <field label=\"Component filter\" hint=\"This local form keeps its value when applied.\"><input name=\"filter\" :value=\"options.filter\" /></field>\n          <div class=\"example-actions\">\n            <button type=\"submit\" primary>Apply filter</button>\n            <button ref=\"cancel\">Close options</button>\n          </div>\n        </form>\n        <toast :id=\u0027\"popover-applied-\" + options.id\u0027 :message=\u0027if (options.sequence > 0) \"Filter applied.\" else \"\"\u0027\n               :sequence=\"options.sequence\" tone=\"success\" :data-popover-toast=\"options.id\" />\n      </island>\n    </popover>\n  </div>\n</component>\n"'>
      <popover label="Example options" icon="settings"><div class="example-stack"><field label="Filter options"><input name="option-filter" /></field><button ref="cancel">Close options</button></div></popover>
    </reference-entry>
  </catalog-document>
</page>
