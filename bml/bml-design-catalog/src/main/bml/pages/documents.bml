<page route="/documents">
  <catalog-document title="Document editing" description="TipTap rich text with application-owned forms and ProseMirror JSON." current="/documents">
    <p class="page-intro">Use headings, text formatting, lists, tasks, links, images, tables and code blocks. Each example keeps its own draft. Open Example states to try rejected saves, read-only content and controlled replacements.</p>
    <div class="catalog-grid">
      <div class="catalog-palette-dark" data-document-palette="dark"><document-example id="dark" title="Dark palette" /></div>
      <div class="catalog-palette-light" data-document-palette="light"><document-example id="light" title="Light palette" /></div>
    </div>
    <card title="Use in your application"><div class="catalog-stack">
      <p class="catalog-description">The editor submits a ProseMirror JSON document. Your application supplies its form, validation and save action. Image controls accept a URL and description; file storage stays with the application.</p>
      <a class="catalog-link" href="/components/content#ref-document-editor">Document editor API and authoring</a>
    </div></card>
    <card title="Unsupported document content"><div class="catalog-stack">
      <p class="catalog-description">Documents containing application-specific nodes retain their original JSON and report the unsupported type. Studio collaboration, mentions and template blocks need a consuming application's integration.</p>
      <document-editor id="unsupported-document" label="Unsupported document example" name="unsupported"
                       :value='"{\"type\":\"doc\",\"content\":[{\"type\":\"customBlock\",\"attrs\":{\"name\":\"Retain this value\"}}]}"' data-document-unsupported />
    </div></card>
  </catalog-document>
</page>
