<page route="/components/controls">
  <catalog-document title="Controls" description="Native inputs, buttons and local selection." current="/components">
    <nav class="reference-jumps" aria-label="On this page">
      <a href="#ref-button">button</a>
      <a href="#ref-input">input</a>
      <a href="#ref-field">field</a>
      <a href="#ref-checkbox">checkbox</a>
      <a href="#ref-switch">switch</a>
      <a href="#ref-icon-button">icon-button</a>
      <a href="#ref-icon-link">icon-link</a>
      <a href="#ref-search-input">search-input</a>
      <a href="#ref-segmented-control">segmented-control</a>
      <a href="#ref-view-tabs">view-tabs</a>
      <a href="#ref-select">select</a>
    </nav>
    <reference-entry name="button"
      :api='"size: String = \"md\"\nloading: Boolean = false\ntype: String = \"button\"\nref: String = \"\"\nprimary: Boolean = false\nicon: String = \"\"\ndisabled: Boolean = false"'
      :contract='"Native button receives additional attributes, merged class, and declarative click events. Default children supply its accessible name. Loading disables it and overlays an aria-hidden spinner."'
      :keyboard='"Enter or Space activates the native button. Disabled and loading buttons cannot activate. Choose one tone: primary, ghost or danger; block and icon-only are layout modifiers. Icon-only controls need an accessible name."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --bg-3, --control-bg, --control-gap, --control-height-md, --control-height-sm, --control-height-xs, --control-radius, --err, --fg-0, --fg-1, --fg-2, --focus-offset, --focus-width, --line, --line-2, --r-sm. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-actions\"><button primary icon=\"save\">Save</button><button size=\"sm\" class=\"ghost\">Cancel</button><button size=\"xs\">Small</button><button disabled>Disabled</button><button loading>Saving</button></div>"'>
      <div class="example-actions"><button primary icon="save">Save</button><button size="sm" class="ghost">Cancel</button><button size="xs">Small</button><button disabled>Disabled</button><button loading>Saving</button></div>
    </reference-entry>
    <reference-entry name="input"
      :api='"size: String = \"md\"\nmono: Boolean = false\ntype: String = \"text\"\nref: String = \"\"\nvalue: String = \"\"\nrequired: Boolean = false"'
      :contract='"Native input receives additional attributes and events, including name, disabled, readonly, autocomplete, aria-*, and data-*. No child content."'
      :keyboard='"Native Tab entry, text editing and browser validation. md and sm sizes are supported; mono changes typography. Applications connect field errors with aria-describedby and aria-invalid."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --control-bg, --control-height-md, --control-height-sm, --control-radius, --fg-0, --fg-3, --font-mono, --line-2, --r-sm. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><field label=\"Display name\"><input name=\"reference-name\" placeholder=\"Your name\" /></field><field label=\"Readonly key\"><input value=\"sample-key\" mono readonly size=\"sm\" /></field><field label=\"Unavailable input\"><input disabled value=\"Disabled\" /></field></div>"'>
      <div class="example-stack"><field label="Display name"><input name="reference-name" placeholder="Your name" /></field><field label="Readonly key"><input value="sample-key" mono readonly size="sm" /></field><field label="Unavailable input"><input disabled value="Disabled" /></field></div>
    </reference-entry>
    <reference-entry name="field"
      :api='"label: String (required)\nhint: String = \"\"\nhideLabel: Boolean = false"'
      :contract='"A wrapping native label contains default children. The hidden-label option retains an accessible label. Only named props and children are consumed."'
      :keyboard='"The wrapping label names its child control, including when hideLabel is true. Associate a hint or error explicitly with aria-describedby when it must be announced."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --fg-2. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<field label=\"Repository title\" hint=\"One field, named by its wrapping label.\"><input name=\"repository-title\" required /></field>"'>
      <field label="Repository title" hint="One field, named by its wrapping label."><input name="repository-title" required /></field>
    </reference-entry>
    <reference-entry name="checkbox"
      :api='"label: String (required)\ndescription: String = \"\"\nchecked: Boolean = false"'
      :contract='"Wrapping label with a native 14px checkbox. Additional attributes and classes go to the input, including name, value, required and disabled. Change events bubble to the label root. No child content."'
      :keyboard='"Space toggles the native checkbox. A disabled checkbox is excluded from native form submission; an unchecked one has no submitted value."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --fg-3, --focus-offset, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><checkbox label=\"Include a summary with a deliberately long descriptive label for narrow screens\" name=\"summary\" checked /><checkbox label=\"Unavailable summary\" disabled /></div>"'>
      <div class="example-stack"><checkbox label="Include a summary with a deliberately long descriptive label for narrow screens" name="summary" checked /><checkbox label="Unavailable summary" disabled /></div>
    </reference-entry>
    <reference-entry name="switch"
      :api='"label: String (required)\ndescription: String = \"\"\nchecked: Boolean = false\ndisabled: Boolean = false"'
      :contract='"Wrapping label with a native checkbox and role=\"switch\", presented as a 32×18px track. Additional attributes/classes go to the input. Change events bubble to the label root. No child content."'
      :keyboard='"Space toggles the native checkbox with switch semantics. The caller owns checked state when it supplies a change action. Disabled switches cannot toggle."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-3, --fg-2, --fg-3, --focus-offset, --focus-width, --line-2, --on-accent. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><switch label=\"Preview enabled\" checked /><switch label=\"Preview unavailable\" disabled /></div>"'>
      <div class="example-stack"><switch label="Preview enabled" checked /><switch label="Preview unavailable" disabled /></div>
    </reference-entry>
    <reference-entry name="icon-button"
      :api='"icon: String (required)\nlabel: String (required)\nref: String = \"\"\ntype: String = \"button\"\ndisabled: Boolean = false\nsize: String = \"sm\""'
      :contract='"Native button with a decorative icon, required accessible name and tooltip. Additional attributes/classes and actions reach the button. Default dimensions are 30×30px; xs is 24×24px. No child content."'
      :keyboard='"Enter or Space activates. The required label supplies its accessible name; tooltip text also appears on focus. sm and xs sizes are supported."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --control-bg, --control-height-sm, --control-height-xs, --control-radius, --fg-1, --line-2. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-actions\"><icon-button icon=\"settings\" label=\"Settings\" /><icon-button icon=\"edit\" label=\"Edit sample\" size=\"xs\" /><icon-button icon=\"trash\" label=\"Remove unavailable sample\" disabled /></div>"'>
      <div class="example-actions"><icon-button icon="settings" label="Settings" /><icon-button icon="edit" label="Edit sample" size="xs" /><icon-button icon="trash" label="Remove unavailable sample" disabled /></div>
    </reference-entry>
    <reference-entry name="icon-link"
      :api='"icon: String (required)\nlabel: String (required)\nhref: String (required)"'
      :contract='"Native 30×30px anchor with a decorative icon, accessible name and tooltip. Additional attributes/classes target the anchor, including target, rel and download. Supports the primary class modifier. No child content."'
      :keyboard='"Enter follows the native anchor. The required label remains available when the tooltip is hidden. The primary class changes its tone."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --bg-3, --control-bg, --control-height-sm, --control-radius, --fg-0, --fg-1, --focus-offset, --focus-width, --line-2, --r-sm. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<icon-link icon=\"book-open\" label=\"Read the foundation examples\" href=\"/foundation\" />"'>
      <icon-link icon="book-open" label="Read the foundation examples" href="/foundation" />
    </reference-entry>
    <reference-entry name="search-input"
      :api='"value: String = \"\"\nname: String = \"q\"\nplaceholder: String = \"Search…\"\nlabel: String = \"Search\"\npreserveKey: String = \"\"\ndisabled: Boolean = false\nautofocus: Boolean = true"'
      :contract='"Search wrapper with decorative icon, clear action and default trailing action children. Additional attributes/classes/events target the native search input. The clear action emits one bubbling input event and returns focus to the query."'
      :keyboard='"Native search editing, with a labelled clear action that returns focus to the query. Clear emits input. Disable autofocus for repeated or embedded examples."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-0, --fg-0, --fg-3, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<search-input label=\"Search examples\" placeholder=\"Find an example…\" :autofocus=\"false\" />"'>
      <search-input label="Search examples" placeholder="Find an example…" :autofocus="false" />
    </reference-entry>
    <reference-entry name="segmented-control"
      :api='"label: String (required)\nname: String (required)\noptions: List<String> (required)\nvalues: List<String> = emptyList()\nicons: List<String> = emptyList()\nvalue: String (required)\npreserveKey: String = \"\""'
      :contract='"Radiogroup receives additional attributes/classes/events. A hidden native input supplies the selected form value. Buttons use indexed values or fall back to option labels; optional indexed icons are decorative. Emits bubbling segmentchange after updating its native value. No child content."'
      :keyboard='"Tab enters one choice; Left/Right wrap and Home/End move within the group. A selection updates the hidden form value and emits segmentchange. Extra values and icons correspond by index."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-0, --bg-2, --bg-3, --fg-0, --fg-2, --focus-width, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<segmented-control label=\"Example format\" name=\"format\" :options=\u0027listOf(\"Preview\", \"Code\", \"Details\")\u0027 value=\"Preview\" />"'>
      <segmented-control label="Example format" name="format" :options='listOf("Preview", "Code", "Details")' value="Preview" />
    </reference-entry>
    <reference-entry name="view-tabs"
      :api='"label: String (required)\ntabs: List<String> (required)\nselected: String (required)"'
      :contract='"Tablist receives additional attributes/classes/events. Emits bubbling viewchange with the selected label as its string detail. The application owns panels, IDs, accessible relationships and visibility. No child content."'
      :keyboard='"Tab enters one tab; Left/Right wrap and Home/End move and select. The application handles viewchange and supplies labelled panels, IDs and visibility. Without scripts the initial panel remains visible."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --fg-0, --fg-1, --fg-3, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"local-view-example\">\n  <div data-local-views>\n    <view-tabs label=\"Example view\" :tabs=\u0027listOf(\"Preview\", \"Details\", \"Source\")\u0027 selected=\"Preview\" />\n    <div role=\"tabpanel\" data-view=\"Preview\">A local preview, owned by the application.</div>\n    <div role=\"tabpanel\" data-view=\"Details\" hidden>Details for the selected example.</div>\n    <div role=\"tabpanel\" data-view=\"Source\" hidden>Source belongs to this application.</div>\n  </div>\n  <script client scoped>\n    const panels = [...ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")];\n    for (const tab of ctx.root.querySelectorAll<HTMLElement>(\"[role=tab]\")) {\n      const panel = panels.find(panel => panel.dataset.view === tab.dataset.tab);\n      if (!panel) continue;\n      tab.id = `catalog-tab-\${crypto.randomUUID()}`;\n      panel.id = `catalog-panel-\${crypto.randomUUID()}`;\n      tab.setAttribute(\"aria-controls\", panel.id);\n      panel.setAttribute(\"aria-labelledby\", tab.id);\n    }\n    ctx.on<CustomEvent<string>>(ctx.root, \"viewchange\", event => {\n      for (const panel of panels) panel.hidden = panel.dataset.view !== event.detail;\n    });\n  </script>\n</component>"'>
      <local-view-example />
    </reference-entry>
    <reference-entry name="select"
      :api='"name: String = \"\"\nref: String = \"native\"\nplaceholder: String = \"Select…\"\nlabel: String = \"Selection\"\nicon: String = \"\"\nsearchable: Boolean = false\nasync: Boolean = false\nmultiple: Boolean = false\nallowCustom: Boolean = false\ndisabled: Boolean = false\nloading: Boolean = false\nrequired: Boolean = false\nsize: String = \"md\"\nmaxTags: Int = 3\nminQuery: Int = 0\ndebounce: Int = 250\npreserveKey: String = \"\""'
      :contract='"Additional attributes/classes target the native select. Default children are caller-owned options/optgroups. The helper enhances it with a labelled combobox, listbox, optional search/pagination and selected tags; native values remain the form submission contract."'
      :keyboard='"The enhanced combobox supports arrows, Home/End, Enter/Space selection and Escape dismissal. Native options provide the form value and no-script fallback. The application owns async search and offset page responses."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --control-bg, --control-height-md, --control-height-sm, --err, --fg-0, --fg-1, --fg-3, --fg-4, --focus-width, --line, --line-2, --r-sm, --select-active-border, --select-shadow, --shadow-color. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"picker-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <prop name=\"title\" type=\"String\" required />\n  <script server provides=\"picker\" scope=\"server-session\">bosca.design.catalog.CatalogPicker(id)</script>\n  <card :title=\"title\">\n    <island name=\"picker\" :key=\"id\">\n      <div class=\"catalog-stack\" :data-picker-example=\"picker.id\" :data-search-failure=\"picker.failSearch\">\n        <form @submit=\"picker.save(form.example)\" class=\"example-form\" :data-picker-form=\"picker.id\">\n          <div class=\"catalog-field\">\n            <field label=\"Example\" hint=\"Search control, layout or overlay. Use at least two characters.\">\n              <select name=\"example\" label=\"Example\" placeholder=\"Choose an example…\" searchable async required\n                      :minQuery=\"2\" :debounce=\"150\" :disabled=\"picker.disabled\" :loading=\"picker.loading\"\n                      :preserveKey=\u0027\"picker-\" + picker.id\u0027 :data-picker-native=\"picker.id\"\n                      :aria-invalid=\"picker.error.isNotBlank().toString()\" :aria-describedby=\u0027\"picker-error-\" + picker.id\u0027>\n                <option value=\"\" :selected=\"picker.value.isEmpty()\">Choose an example…</option>\n                <for option in bosca.design.catalog.CatalogChoiceSearch.options>\n                  <option :value=\"option.value\" :selected=\"picker.value == option.value\" :disabled=\"option.disabled\">{ option.label }</option>\n                </for>\n              </select>\n            </field>\n            <alert compact :id=\u0027\"picker-error-\" + picker.id\u0027 :hidden=\"picker.error.isEmpty()\">{ picker.error }</alert>\n          </div>\n          <div class=\"example-actions\">\n            <button type=\"submit\" primary :disabled=\"picker.disabled || picker.loading\" :data-picker-save=\"picker.id\">Save choice</button>\n            <button type=\"reset\">Reset choice</button>\n          </div>\n        </form>\n        <details :data-picker-states=\"picker.id\">\n          <disclosure-heading>Example states</disclosure-heading>\n          <div class=\"catalog-stack picker-state-options\">\n            <switch label=\"Reject searches\" description=\"Turn off to retry the same search.\" :checked=\"picker.failSearch\"\n                    @change=\"picker.toggleFailure\" :data-picker-failure=\"picker.id\" />\n            <switch label=\"Disable the picker\" :checked=\"picker.disabled\" @change=\"picker.toggleDisabled\" :data-picker-disable=\"picker.id\" />\n            <switch label=\"Show a loading state\" :checked=\"picker.loading\" @change=\"picker.toggleLoading\" :data-picker-loading=\"picker.id\" />\n          </div>\n        </details>\n        <toast :id=\u0027\"choice-saved-\" + picker.id\u0027 :message=\"picker.message\" :sequence=\"picker.saves\"\n               tone=\"success\" :data-picker-toast=\"picker.id\" />\n      </div>\n    </island>\n  </card>\n  <script client scoped>\n    import { bmlContractCall } from \"@bosca/bml\";\n    import type { SelectPage, SelectSearch } from \"@bosca/bml-design/select\";\n    ctx.on<CustomEvent<SelectSearch>>(ctx.root, \"selectsearch\", event => {\n      const owner = event.target instanceof Element ? event.target.closest(\"[data-picker-example]\") : null;\n      if (!owner) return;\n      event.stopPropagation();\n      const { query, offset, resolve, reject } = event.detail;\n      bmlContractCall<SelectPage>(\"CatalogChoices\", \"search\", [{ query, offset, fail: owner.hasAttribute(\"data-search-failure\") }])\n        .then(resolve, reject);\n    });\n  </script>\n</component>"'>
      <div class="example-stack"><select label="Choose a component" name="component" searchable><option value="">Choose…</option><option value="button">Button</option><optgroup label="Layout"><option value="panel">Panel</option><option value="page-heading">Page heading with a long descriptive label</option></optgroup></select><select label="Unavailable choice" disabled><option>Disabled</option></select><select label="No results" searchable /><a class="catalog-link" href="/selection">Try the paged picker</a></div>
    </reference-entry>
  </catalog-document>
</page>
