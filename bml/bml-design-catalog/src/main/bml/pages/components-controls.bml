<page route="/components/controls">
  <catalog-document title="Controls" description="Native inputs, buttons and local selection." current="/components">
    <nav class="reference-jumps" aria-label="On this page">
      <a href="#ref-button">button</a>
      <a href="#ref-input">input</a>
      <a href="#ref-field">field</a>
      <a href="#ref-checkbox">checkbox</a>
      <a href="#ref-switch">switch</a>
      <a href="#ref-icon-button">icon-button</a>
      <a href="#ref-icon-link">icon-link</a>
      <a href="#ref-search-input">search-input</a>
      <a href="#ref-segmented-control">segmented-control</a>
      <a href="#ref-view-tabs">view-tabs</a>
      <a href="#ref-select">select</a>
    </nav>
    <reference-entry name="button"
      :api='"size: String = \"md\"\nloading: Boolean = false\ntype: String = \"button\"\nref: String = \"\"\nprimary: Boolean = false\nicon: String = \"\"\ndisabled: Boolean = false"'
      :contract='"Native button receives additional attributes, merged class, and declarative click events. Default children supply its accessible name. Loading disables it and overlays an aria-hidden spinner."'
      :keyboard='"Enter or Space activates the native button. Disabled and loading buttons cannot activate. Choose one tone: primary, ghost or danger; block and icon-only are layout modifiers. Icon-only controls need an accessible name."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --bg-3, --control-bg, --control-border, --control-gap, --control-height-md, --control-height-sm, --control-height-xs, --control-radius, --err, --fg-0, --fg-1, --fg-2, --focus-offset, --focus-width, --line, --line-2, --r-sm. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-actions\"><button primary icon=\"save\">Save</button><button size=\"sm\" class=\"ghost\">Cancel</button><button size=\"xs\">Small</button><button disabled>Disabled</button><button loading>Saving</button></div>"'>
      <div class="example-actions"><button primary icon="save">Save</button><button size="sm" class="ghost">Cancel</button><button size="xs">Small</button><button disabled>Disabled</button><button loading>Saving</button></div>
    </reference-entry>
    <reference-entry name="input"
      :api='"size: String = \"md\"\nmono: Boolean = false\ntype: String = \"text\"\nref: String = \"\"\nvalue: String = \"\"\nrequired: Boolean = false"'
      :contract='"Native input receives additional attributes and events, including name, disabled, readonly, autocomplete, aria-*, and data-*. No child content."'
      :keyboard='"Native Tab entry, text editing and browser validation. md and sm sizes are supported; mono changes typography. Applications connect field errors with aria-describedby and aria-invalid."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --control-bg, --control-border, --control-height-md, --control-height-sm, --control-radius, --fg-0, --fg-3, --font-mono, --line-2, --r-sm. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><field label=\"Display name\"><input name=\"reference-name\" placeholder=\"Your name\" /></field><field label=\"Readonly key\"><input value=\"sample-key\" mono readonly size=\"sm\" /></field><field label=\"Unavailable input\"><input disabled value=\"Disabled\" /></field></div>"'>
      <div class="example-stack"><field label="Display name"><input name="reference-name" placeholder="Your name" /></field><field label="Readonly key"><input value="sample-key" mono readonly size="sm" /></field><field label="Unavailable input"><input disabled value="Disabled" /></field></div>
    </reference-entry>
    <reference-entry name="field"
      :api='"label: String (required)\nhint: String = \"\"\nhideLabel: Boolean = false"'
      :contract='"A wrapping native label contains default children. The hidden-label option retains an accessible label. Only named props and children are consumed."'
      :keyboard='"The wrapping label names its child control, including when hideLabel is true. Associate a hint or error explicitly with aria-describedby when it must be announced."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --fg-2. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<field label=\"Repository title\" hint=\"One field, named by its wrapping label.\"><input name=\"repository-title\" required /></field>"'>
      <field label="Repository title" hint="One field, named by its wrapping label."><input name="repository-title" required /></field>
    </reference-entry>
    <reference-entry name="checkbox"
      :api='"label: String (required)\ndescription: String = \"\"\nchecked: Boolean = false"'
      :contract='"Wrapping label with a native 14px checkbox. Additional attributes and classes go to the input, including name, value, required and disabled. Change events bubble to the label root. No child content."'
      :keyboard='"Space toggles the native checkbox. A disabled checkbox is excluded from native form submission; an unchecked one has no submitted value."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --fg-3, --focus-offset, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><checkbox label=\"Include a summary with a deliberately long descriptive label for narrow screens\" name=\"summary\" checked /><checkbox label=\"Unavailable summary\" disabled /></div>"'>
      <div class="example-stack"><checkbox label="Include a summary with a deliberately long descriptive label for narrow screens" name="summary" checked /><checkbox label="Unavailable summary" disabled /></div>
    </reference-entry>
    <reference-entry name="switch"
      :api='"label: String (required)\ndescription: String = \"\"\nchecked: Boolean = false\ndisabled: Boolean = false"'
      :contract='"Wrapping label with a native checkbox and role=\"switch\", presented as a 32×18px track. Additional attributes/classes go to the input. Change events bubble to the label root. No child content."'
      :keyboard='"Space toggles the native checkbox with switch semantics. The caller owns checked state when it supplies a change action. Disabled switches cannot toggle."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-3, --control-border, --fg-2, --fg-3, --focus-offset, --focus-width, --line-2, --on-accent. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><switch label=\"Preview enabled\" checked /><switch label=\"Preview unavailable\" disabled /></div>"'>
      <div class="example-stack"><switch label="Preview enabled" checked /><switch label="Preview unavailable" disabled /></div>
    </reference-entry>
    <reference-entry name="icon-button"
      :api='"icon: String (required)\nlabel: String (required)\nref: String = \"\"\ntype: String = \"button\"\ndisabled: Boolean = false\nsize: String = \"sm\""'
      :contract='"Native button with a decorative icon, required accessible name and tooltip. Additional attributes/classes and actions reach the button. Default dimensions are 30×30px; xs is 24×24px. No child content."'
      :keyboard='"Enter or Space activates. The required label supplies its accessible name; tooltip text also appears on focus. sm and xs sizes are supported."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --control-bg, --control-border, --control-height-sm, --control-height-xs, --control-radius, --fg-1, --line-2. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-actions\"><icon-button icon=\"settings\" label=\"Settings\" /><icon-button icon=\"edit\" label=\"Edit sample\" size=\"xs\" /><icon-button icon=\"trash\" label=\"Remove unavailable sample\" disabled /></div>"'>
      <div class="example-actions"><icon-button icon="settings" label="Settings" /><icon-button icon="edit" label="Edit sample" size="xs" /><icon-button icon="trash" label="Remove unavailable sample" disabled /></div>
    </reference-entry>
    <reference-entry name="icon-link"
      :api='"icon: String (required)\nlabel: String (required)\nhref: String (required)"'
      :contract='"Native 30×30px anchor with a decorative icon, accessible name and tooltip. Additional attributes/classes target the anchor, including target, rel and download. Supports the primary class modifier. No child content."'
      :keyboard='"Enter follows the native anchor. The required label remains available when the tooltip is hidden. The primary class changes its tone."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --bg-3, --control-bg, --control-border, --control-height-sm, --control-radius, --fg-0, --fg-1, --focus-offset, --focus-width, --line-2, --r-sm. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<icon-link icon=\"book-open\" label=\"Read the foundation examples\" href=\"/foundation\" />"'>
      <icon-link icon="book-open" label="Read the foundation examples" href="/foundation" />
    </reference-entry>
    <reference-entry name="search-input"
      :api='"value: String = \"\"\nname: String = \"q\"\nplaceholder: String = \"Search…\"\nlabel: String = \"Search\"\npreserveKey: String = \"\"\ndisabled: Boolean = false\nautofocus: Boolean = true"'
      :contract='"Search wrapper with decorative icon, clear action and default trailing action children. Additional attributes/classes/events target the native search input. The clear action emits one bubbling input event and returns focus to the query."'
      :keyboard='"Native search editing, with a labelled clear action that returns focus to the query. Clear emits input. Disable autofocus for repeated or embedded examples."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-0, --control-border, --fg-0, --fg-3, --line-2. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"search-views-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"views\" scope=\"server-session\">bosca.design.catalog.CatalogViews(id)</script>\n  <island name=\"views\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-search-views=\"views.id\">\n      <if views.visible>\n        <form @submit=\"views.search(form.q, form.category)\" class=\"example-form\" :data-views-form=\"views.id\">\n          <search-input :value=\"views.query\" :disabled=\"views.disabled\" :autofocus=\"false\" label=\"Search catalog examples\"\n                        placeholder=\"Try layout or control\u2026\" maxlength=\"120\" :data-views-query=\"views.id\"\n                        :preserveKey=\u0027\"views-query-\" + views.id\u0027 :aria-describedby=\u0027\"views-hint-\" + views.id\u0027 />\n          <p class=\"example-note\" :id=\u0027\"views-hint-\" + views.id\u0027>Search these local catalog examples. Category choices supply a native form value.</p>\n          <segmented-control label=\"Example category\" name=\"category\"\n                             :options=\u0027listOf(\"All\", \"Controls\", \"Layout\", \"Overlays\")\u0027\n                             :values=\u0027listOf(\"all\", \"control\", \"layout\", \"overlay\")\u0027 :icons=\u0027listOf(\"list\", \"code\", \"folder\", \"boxes\")\u0027\n                             :value=\"views.mode\" :preserveKey=\u0027\"views-category-\" + views.id\u0027 :data-views-category=\"views.id\" />\n          <div class=\"example-actions\"><button type=\"submit\" primary :disabled=\"views.disabled\" :data-views-submit=\"views.id\">Search examples</button></div>\n        </form>\n        <div class=\"catalog-stack\" :data-views-panels=\"views.id\">\n          <view-tabs label=\"Search example view\" :tabs=\"views.tabs()\" :selected=\"views.selected\"\n                     :data-bml-preserve=\u0027\"views-tabs-\" + views.id + \"-\" + views.revision\u0027 :data-views-tabs=\"views.id\" />\n          <for view in views.tabs()>\n            <div role=\"tabpanel\" tabindex=\"0\" class=\"catalog-view-panel\" :data-views-panel=\"views.id\" :data-view=\"view\" :hidden=\"views.selected != view\">\n              <if view == \"Preview\">\n                <if views.results().isEmpty()><empty-state icon=\"search\" title=\"No matching examples\" description=\"Try another query or choose All categories.\" />\n                <else><ul class=\"catalog-result-list\"><for choice in views.results()>\n                  <li><a class=\"catalog-link\" :href=\u0027\"/components/\" + (if (choice.label.endsWith(\"\u00b7 layout\")) \"layout\" else if (choice.label.endsWith(\"\u00b7 overlay\")) \"overlays\" else \"controls\") + \"#ref-\" + choice.value\u0027>{ choice.label }</a></li>\n                </for></ul></if>\n              <else-if view == \"Details\"><p class=\"catalog-description\">The application filters local examples when you submit. Editing a query or category keeps the previous results until the next accepted search.</p>\n              <else-if view == \"Source\"><a class=\"catalog-link\" href=\"/components/controls#ref-search-input\">Read the complete authoring example</a>\n              <else><p class=\"catalog-description\">This alternate view belongs to the application. Changing the tab list changes its preservation key.</p>\n              </if>\n            </div>\n          </for>\n        </div>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack views-state-options\">\n          <switch label=\"Reject searches\" :checked=\"views.rejectSearch\" @change=\"views.toggleRejection\" :data-views-reject=\"views.id\" />\n          <switch label=\"Disable search\" :checked=\"views.disabled\" @change=\"views.toggleDisabled\" :data-views-disabled=\"views.id\" />\n          <switch label=\"Show controls\" :checked=\"views.visible\" @change=\"views.toggleVisible\" :data-views-visible=\"views.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"views.replace\" :disabled=\"!views.visible\" :data-views-replace=\"views.id\">Replace controlled values</button>\n            <button @click=\"views.changeTabs\" :disabled=\"!views.visible\" :data-views-list=\"views.id\">Change tab list</button>\n            <button @click=\"views.refresh\" :data-views-refresh=\"views.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Refresh retains drafts and local choices. Turn rejection off to retry. Replace supplies a different query and view; changing the list remounts the tabs.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"views-notice-\" + views.id\u0027 :message=\"views.notice\" :sequence=\"views.noticeSequence\"\n             :tone=\"views.noticeTone\" :data-views-toast=\"views.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n    const connectPanels = () => {\n      for (const tab of ctx.root.querySelectorAll<HTMLElement>(\"[data-views-tabs] [role=tab]\")) {\n        const panel = [...ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")].find(panel => panel.dataset.view === tab.dataset.tab);\n        if (!panel) continue;\n        if (!tab.id) tab.id = `catalog-tab-\${crypto.randomUUID()}`;\n        if (!panel.id) panel.id = `catalog-panel-\${crypto.randomUUID()}`;\n        tab.setAttribute(\"aria-controls\", panel.id);\n        panel.setAttribute(\"aria-labelledby\", tab.id);\n      }\n    };\n    ctx.on<CustomEvent<string>>(ctx.root, \"viewchange\", event => {\n      for (const panel of ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")) panel.hidden = panel.dataset.view !== event.detail;\n      ctx.dispatch(views.chooseView(event.detail));\n    });\n    ctx.onUpdate(connectPanels);\n    connectPanels();\n  </script>\n</component>\n"'>
      <div class="catalog-stack"><search-input label="Search examples" placeholder="Find an example…" :autofocus="false" /><a class="catalog-link" href="/views">Search and local view states</a></div>
    </reference-entry>
    <reference-entry name="segmented-control"
      :api='"label: String (required)\nname: String (required)\noptions: List<String> (required)\nvalues: List<String> = emptyList()\nicons: List<String> = emptyList()\nvalue: String (required)\npreserveKey: String = \"\""'
      :contract='"Radiogroup receives additional attributes/classes/events. A hidden native input supplies the selected form value. Buttons use indexed values or fall back to option labels; optional indexed icons are decorative. Emits bubbling segmentchange after updating its native value. No child content."'
      :keyboard='"Tab enters one choice; Left/Right wrap and Home/End move within the group. A selection updates the hidden form value and emits segmentchange. Extra values and icons correspond by index."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-0, --bg-2, --bg-3, --control-border, --fg-0, --fg-2, --focus-width, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"search-views-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"views\" scope=\"server-session\">bosca.design.catalog.CatalogViews(id)</script>\n  <island name=\"views\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-search-views=\"views.id\">\n      <if views.visible>\n        <form @submit=\"views.search(form.q, form.category)\" class=\"example-form\" :data-views-form=\"views.id\">\n          <search-input :value=\"views.query\" :disabled=\"views.disabled\" :autofocus=\"false\" label=\"Search catalog examples\"\n                        placeholder=\"Try layout or control\u2026\" maxlength=\"120\" :data-views-query=\"views.id\"\n                        :preserveKey=\u0027\"views-query-\" + views.id\u0027 :aria-describedby=\u0027\"views-hint-\" + views.id\u0027 />\n          <p class=\"example-note\" :id=\u0027\"views-hint-\" + views.id\u0027>Search these local catalog examples. Category choices supply a native form value.</p>\n          <segmented-control label=\"Example category\" name=\"category\"\n                             :options=\u0027listOf(\"All\", \"Controls\", \"Layout\", \"Overlays\")\u0027\n                             :values=\u0027listOf(\"all\", \"control\", \"layout\", \"overlay\")\u0027 :icons=\u0027listOf(\"list\", \"code\", \"folder\", \"boxes\")\u0027\n                             :value=\"views.mode\" :preserveKey=\u0027\"views-category-\" + views.id\u0027 :data-views-category=\"views.id\" />\n          <div class=\"example-actions\"><button type=\"submit\" primary :disabled=\"views.disabled\" :data-views-submit=\"views.id\">Search examples</button></div>\n        </form>\n        <div class=\"catalog-stack\" :data-views-panels=\"views.id\">\n          <view-tabs label=\"Search example view\" :tabs=\"views.tabs()\" :selected=\"views.selected\"\n                     :data-bml-preserve=\u0027\"views-tabs-\" + views.id + \"-\" + views.revision\u0027 :data-views-tabs=\"views.id\" />\n          <for view in views.tabs()>\n            <div role=\"tabpanel\" tabindex=\"0\" class=\"catalog-view-panel\" :data-views-panel=\"views.id\" :data-view=\"view\" :hidden=\"views.selected != view\">\n              <if view == \"Preview\">\n                <if views.results().isEmpty()><empty-state icon=\"search\" title=\"No matching examples\" description=\"Try another query or choose All categories.\" />\n                <else><ul class=\"catalog-result-list\"><for choice in views.results()>\n                  <li><a class=\"catalog-link\" :href=\u0027\"/components/\" + (if (choice.label.endsWith(\"\u00b7 layout\")) \"layout\" else if (choice.label.endsWith(\"\u00b7 overlay\")) \"overlays\" else \"controls\") + \"#ref-\" + choice.value\u0027>{ choice.label }</a></li>\n                </for></ul></if>\n              <else-if view == \"Details\"><p class=\"catalog-description\">The application filters local examples when you submit. Editing a query or category keeps the previous results until the next accepted search.</p>\n              <else-if view == \"Source\"><a class=\"catalog-link\" href=\"/components/controls#ref-search-input\">Read the complete authoring example</a>\n              <else><p class=\"catalog-description\">This alternate view belongs to the application. Changing the tab list changes its preservation key.</p>\n              </if>\n            </div>\n          </for>\n        </div>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack views-state-options\">\n          <switch label=\"Reject searches\" :checked=\"views.rejectSearch\" @change=\"views.toggleRejection\" :data-views-reject=\"views.id\" />\n          <switch label=\"Disable search\" :checked=\"views.disabled\" @change=\"views.toggleDisabled\" :data-views-disabled=\"views.id\" />\n          <switch label=\"Show controls\" :checked=\"views.visible\" @change=\"views.toggleVisible\" :data-views-visible=\"views.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"views.replace\" :disabled=\"!views.visible\" :data-views-replace=\"views.id\">Replace controlled values</button>\n            <button @click=\"views.changeTabs\" :disabled=\"!views.visible\" :data-views-list=\"views.id\">Change tab list</button>\n            <button @click=\"views.refresh\" :data-views-refresh=\"views.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Refresh retains drafts and local choices. Turn rejection off to retry. Replace supplies a different query and view; changing the list remounts the tabs.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"views-notice-\" + views.id\u0027 :message=\"views.notice\" :sequence=\"views.noticeSequence\"\n             :tone=\"views.noticeTone\" :data-views-toast=\"views.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n    const connectPanels = () => {\n      for (const tab of ctx.root.querySelectorAll<HTMLElement>(\"[data-views-tabs] [role=tab]\")) {\n        const panel = [...ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")].find(panel => panel.dataset.view === tab.dataset.tab);\n        if (!panel) continue;\n        if (!tab.id) tab.id = `catalog-tab-\${crypto.randomUUID()}`;\n        if (!panel.id) panel.id = `catalog-panel-\${crypto.randomUUID()}`;\n        tab.setAttribute(\"aria-controls\", panel.id);\n        panel.setAttribute(\"aria-labelledby\", tab.id);\n      }\n    };\n    ctx.on<CustomEvent<string>>(ctx.root, \"viewchange\", event => {\n      for (const panel of ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")) panel.hidden = panel.dataset.view !== event.detail;\n      ctx.dispatch(views.chooseView(event.detail));\n    });\n    ctx.onUpdate(connectPanels);\n    connectPanels();\n  </script>\n</component>\n"'>
      <div class="catalog-stack"><segmented-control label="Example format" name="format" :options='listOf("Preview", "Code", "Details")' value="Preview" /><a class="catalog-link" href="/views">Category form and state examples</a></div>
    </reference-entry>
    <reference-entry name="view-tabs"
      :api='"label: String (required)\ntabs: List<String> (required)\nselected: String (required)"'
      :contract='"Tablist receives additional attributes/classes/events. Emits bubbling viewchange with the selected label as its string detail. The application owns panels, IDs, accessible relationships and visibility. No child content."'
      :keyboard='"Tab enters one tab; Left/Right wrap and Home/End move and select. The application handles viewchange and supplies labelled panels, IDs and visibility. Without scripts the initial panel remains visible."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --fg-0, --fg-1, --fg-3, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"local-view-example\">\n  <div data-local-views>\n    <view-tabs label=\"Example view\" :tabs=\u0027listOf(\"Preview\", \"Details\", \"Source\")\u0027 selected=\"Preview\" />\n    <div role=\"tabpanel\" data-view=\"Preview\">A local preview, owned by the application.</div>\n    <div role=\"tabpanel\" data-view=\"Details\" hidden>Details for the selected example.</div>\n    <div role=\"tabpanel\" data-view=\"Source\" hidden>Source belongs to this application.</div>\n  </div>\n  <script client scoped>\n    const panels = [...ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")];\n    for (const tab of ctx.root.querySelectorAll<HTMLElement>(\"[role=tab]\")) {\n      const panel = panels.find(panel => panel.dataset.view === tab.dataset.tab);\n      if (!panel) continue;\n      tab.id = `catalog-tab-\${crypto.randomUUID()}`;\n      panel.id = `catalog-panel-\${crypto.randomUUID()}`;\n      tab.setAttribute(\"aria-controls\", panel.id);\n      panel.setAttribute(\"aria-labelledby\", tab.id);\n    }\n    ctx.on<CustomEvent<string>>(ctx.root, \"viewchange\", event => {\n      for (const panel of panels) panel.hidden = panel.dataset.view !== event.detail;\n    });\n  </script>\n</component>\n\n<component tag=\"search-views-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"views\" scope=\"server-session\">bosca.design.catalog.CatalogViews(id)</script>\n  <island name=\"views\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-search-views=\"views.id\">\n      <if views.visible>\n        <form @submit=\"views.search(form.q, form.category)\" class=\"example-form\" :data-views-form=\"views.id\">\n          <search-input :value=\"views.query\" :disabled=\"views.disabled\" :autofocus=\"false\" label=\"Search catalog examples\"\n                        placeholder=\"Try layout or control\u2026\" maxlength=\"120\" :data-views-query=\"views.id\"\n                        :preserveKey=\u0027\"views-query-\" + views.id\u0027 :aria-describedby=\u0027\"views-hint-\" + views.id\u0027 />\n          <p class=\"example-note\" :id=\u0027\"views-hint-\" + views.id\u0027>Search these local catalog examples. Category choices supply a native form value.</p>\n          <segmented-control label=\"Example category\" name=\"category\"\n                             :options=\u0027listOf(\"All\", \"Controls\", \"Layout\", \"Overlays\")\u0027\n                             :values=\u0027listOf(\"all\", \"control\", \"layout\", \"overlay\")\u0027 :icons=\u0027listOf(\"list\", \"code\", \"folder\", \"boxes\")\u0027\n                             :value=\"views.mode\" :preserveKey=\u0027\"views-category-\" + views.id\u0027 :data-views-category=\"views.id\" />\n          <div class=\"example-actions\"><button type=\"submit\" primary :disabled=\"views.disabled\" :data-views-submit=\"views.id\">Search examples</button></div>\n        </form>\n        <div class=\"catalog-stack\" :data-views-panels=\"views.id\">\n          <view-tabs label=\"Search example view\" :tabs=\"views.tabs()\" :selected=\"views.selected\"\n                     :data-bml-preserve=\u0027\"views-tabs-\" + views.id + \"-\" + views.revision\u0027 :data-views-tabs=\"views.id\" />\n          <for view in views.tabs()>\n            <div role=\"tabpanel\" tabindex=\"0\" class=\"catalog-view-panel\" :data-views-panel=\"views.id\" :data-view=\"view\" :hidden=\"views.selected != view\">\n              <if view == \"Preview\">\n                <if views.results().isEmpty()><empty-state icon=\"search\" title=\"No matching examples\" description=\"Try another query or choose All categories.\" />\n                <else><ul class=\"catalog-result-list\"><for choice in views.results()>\n                  <li><a class=\"catalog-link\" :href=\u0027\"/components/\" + (if (choice.label.endsWith(\"\u00b7 layout\")) \"layout\" else if (choice.label.endsWith(\"\u00b7 overlay\")) \"overlays\" else \"controls\") + \"#ref-\" + choice.value\u0027>{ choice.label }</a></li>\n                </for></ul></if>\n              <else-if view == \"Details\"><p class=\"catalog-description\">The application filters local examples when you submit. Editing a query or category keeps the previous results until the next accepted search.</p>\n              <else-if view == \"Source\"><a class=\"catalog-link\" href=\"/components/controls#ref-search-input\">Read the complete authoring example</a>\n              <else><p class=\"catalog-description\">This alternate view belongs to the application. Changing the tab list changes its preservation key.</p>\n              </if>\n            </div>\n          </for>\n        </div>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack views-state-options\">\n          <switch label=\"Reject searches\" :checked=\"views.rejectSearch\" @change=\"views.toggleRejection\" :data-views-reject=\"views.id\" />\n          <switch label=\"Disable search\" :checked=\"views.disabled\" @change=\"views.toggleDisabled\" :data-views-disabled=\"views.id\" />\n          <switch label=\"Show controls\" :checked=\"views.visible\" @change=\"views.toggleVisible\" :data-views-visible=\"views.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"views.replace\" :disabled=\"!views.visible\" :data-views-replace=\"views.id\">Replace controlled values</button>\n            <button @click=\"views.changeTabs\" :disabled=\"!views.visible\" :data-views-list=\"views.id\">Change tab list</button>\n            <button @click=\"views.refresh\" :data-views-refresh=\"views.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Refresh retains drafts and local choices. Turn rejection off to retry. Replace supplies a different query and view; changing the list remounts the tabs.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"views-notice-\" + views.id\u0027 :message=\"views.notice\" :sequence=\"views.noticeSequence\"\n             :tone=\"views.noticeTone\" :data-views-toast=\"views.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n    const connectPanels = () => {\n      for (const tab of ctx.root.querySelectorAll<HTMLElement>(\"[data-views-tabs] [role=tab]\")) {\n        const panel = [...ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")].find(panel => panel.dataset.view === tab.dataset.tab);\n        if (!panel) continue;\n        if (!tab.id) tab.id = `catalog-tab-\${crypto.randomUUID()}`;\n        if (!panel.id) panel.id = `catalog-panel-\${crypto.randomUUID()}`;\n        tab.setAttribute(\"aria-controls\", panel.id);\n        panel.setAttribute(\"aria-labelledby\", tab.id);\n      }\n    };\n    ctx.on<CustomEvent<string>>(ctx.root, \"viewchange\", event => {\n      for (const panel of ctx.root.querySelectorAll<HTMLElement>(\"[role=tabpanel]\")) panel.hidden = panel.dataset.view !== event.detail;\n      ctx.dispatch(views.chooseView(event.detail));\n    });\n    ctx.onUpdate(connectPanels);\n    connectPanels();\n  </script>\n</component>\n"'>
      <div class="catalog-stack"><local-view-example /><a class="catalog-link" href="/views">Retained panels and changing tab lists</a></div>
    </reference-entry>
    <reference-entry name="select"
      :api='"name: String = \"\"\nref: String = \"native\"\nplaceholder: String = \"Select…\"\nlabel: String = \"Selection\"\nicon: String = \"\"\nsearchable: Boolean = false\nasync: Boolean = false\nmultiple: Boolean = false\nallowCustom: Boolean = false\ndisabled: Boolean = false\nloading: Boolean = false\nrequired: Boolean = false\nsize: String = \"md\"\nmaxTags: Int = 3\nminQuery: Int = 0\ndebounce: Int = 250\npreserveKey: String = \"\""'
      :contract='"Additional attributes/classes target the native select. Default children are caller-owned options/optgroups. The helper enhances it with a labelled combobox, listbox, optional search/pagination and selected tags; native values remain the form submission contract."'
      :keyboard='"The enhanced combobox supports arrows, Home/End, Enter/Space selection and Escape dismissal. Native options provide the form value and no-script fallback. The application owns async search and offset page responses."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --control-bg, --control-border, --control-height-md, --control-height-sm, --err, --fg-0, --fg-1, --fg-3, --fg-4, --focus-width, --line, --line-2, --r-sm, --select-active-border, --select-shadow, --shadow-color. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"local-choices-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"choices\" scope=\"server-session\">bosca.design.catalog.CatalogLocalChoices(id)</script>\n  <island name=\"choices\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-local-choices=\"choices.id\">\n      <if choices.visible>\n        <form @submit=\"choices.save(form.component, form.label)\" class=\"example-form\" :data-local-choice-form=\"choices.id\">\n          <field label=\"Component\" hint=\"Choose an available component. The empty option is unset.\">\n            <select name=\"component\" label=\"Component\" placeholder=\"Choose a component\u2026\" :required=\"choices.required\"\n                    :disabled=\"choices.disabled\" :loading=\"choices.loading\" :data-local-single=\"choices.id\"\n                    :preserveKey=\u0027\"local-single-\" + choices.id + \"-\" + choices.revision + \"-\" + choices.saves\u0027\n                    :aria-describedby=\u0027\"local-choice-hint-\" + choices.id\u0027>\n              <option value=\"\" :selected=\"choices.component.isEmpty()\">Choose a component\u2026</option>\n              <for option in bosca.design.catalog.CatalogChoiceSearch.options>\n                <option :value=\"option.value\" :selected=\"choices.component == option.value\" :disabled=\"option.disabled\">{option.label}</option>\n              </for>\n            </select>\n          </field>\n          <p class=\"example-note\" :id=\u0027\"local-choice-hint-\" + choices.id\u0027>Native validation focuses the enhanced trigger when a required choice is missing.</p>\n          <field label=\"Custom label\" hint=\"Choose a label or type a new one.\">\n            <select name=\"label\" label=\"Custom label\" placeholder=\"Choose or enter a label\u2026\" searchable :allowCustom=\"choices.allowCustom\"\n                    :disabled=\"choices.disabled\" :loading=\"choices.loading\" :data-local-custom=\"choices.id\"\n                    :preserveKey=\u0027\"local-custom-\" + choices.id + \"-\" + choices.revision + \"-\" + choices.saves\u0027>\n              <option value=\"\" :selected=\"choices.label.isEmpty()\">Choose or enter a label\u2026</option>\n              <option value=\"Preview\" :selected=\u0027choices.label == \"Preview\"\u0027>Preview</option>\n              <option value=\"Published\" :selected=\u0027choices.label == \"Published\"\u0027>Published</option>\n              <if choices.label.isNotEmpty() && choices.label !in listOf(\"Preview\", \"Published\")>\n                <option :value=\"choices.label\" selected>{choices.label}</option>\n              </if>\n            </select>\n          </field>\n          <div class=\"example-actions\">\n            <button type=\"submit\" primary :disabled=\"choices.disabled || choices.loading\" :data-local-save=\"choices.id\">Save component</button>\n            <button type=\"reset\" :disabled=\"choices.disabled || choices.loading\" :data-local-reset=\"choices.id\">Reset component</button>\n          </div>\n        </form>\n        <form class=\"example-form\" :data-local-tags-form=\"choices.id\">\n          <field label=\"Example tags\" hint=\"Each selection contributes a repeated native form value.\">\n            <select name=\"tags\" label=\"Example tags\" multiple searchable :allowCustom=\"choices.allowCustom\" :maxTags=\"choices.maxTags\" size=\"sm\"\n                    :disabled=\"choices.disabled\" :loading=\"choices.loading\" :data-local-multiple=\"choices.id\"\n                    :preserveKey=\u0027\"local-tags-\" + choices.id + \"-\" + choices.revision\u0027>\n              <for option in bosca.design.catalog.CatalogChoiceSearch.options>\n                <option :value=\"option.value\" :selected=\"option.value in choices.tags\" :disabled=\"option.disabled\">{option.label}</option>\n              </for>\n              <optgroup label=\"Unavailable group\" disabled><option value=\"group-unavailable\">A disabled group choice</option></optgroup>\n            </select>\n          </field>\n          <div class=\"example-actions\"><button type=\"reset\" :disabled=\"choices.disabled || choices.loading\" :data-local-tags-reset=\"choices.id\">Reset tags</button></div>\n        </form>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack local-choice-state-options\">\n          <switch label=\"Reject component saves\" :checked=\"choices.rejectSaves\" @change=\"choices.toggleRejection\" :data-local-reject=\"choices.id\" />\n          <switch label=\"Require a component\" :checked=\"choices.required\" @change=\"choices.toggleRequired\" :data-local-required=\"choices.id\" />\n          <switch label=\"Allow custom choices\" :checked=\"choices.allowCustom\" @change=\"choices.toggleCustom\" :data-local-allow-custom=\"choices.id\" />\n          <switch label=\"Disable the controls\" :checked=\"choices.disabled\" @change=\"choices.toggleDisabled\" :data-local-disabled=\"choices.id\" />\n          <switch label=\"Show loading controls\" :checked=\"choices.loading\" @change=\"choices.toggleLoading\" :data-local-loading=\"choices.id\" />\n          <switch label=\"Show controls\" :checked=\"choices.visible\" @change=\"choices.toggleVisible\" :data-local-visible=\"choices.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"choices.changeTagLimit\" :data-local-limit=\"choices.id\">Change tag limit</button>\n            <button @click=\"choices.replace\" :disabled=\"!choices.visible || choices.disabled || choices.loading\" :data-local-replace=\"choices.id\">Replace defaults</button>\n            <button @click=\"choices.refresh\" :data-local-refresh=\"choices.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Saving sets new defaults for the component and custom label. Tags keep their own native values. Replace defaults changes the preservation keys for all three controls. Reset restores their declared defaults.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"local-choices-notice-\" + choices.id\u0027 :message=\"choices.notice\" :sequence=\"choices.noticeSequence\"\n             :tone=\"choices.noticeTone\" :data-local-toast=\"choices.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n\n<component tag=\"picker-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <prop name=\"title\" type=\"String\" required />\n  <script server provides=\"picker\" scope=\"server-session\">bosca.design.catalog.CatalogPicker(id)</script>\n  <card :title=\"title\">\n    <island name=\"picker\" :key=\"id\">\n      <div class=\"catalog-stack\" :data-picker-example=\"picker.id\" :data-search-failure=\"picker.failSearch\">\n        <form @submit=\"picker.save(form.example)\" class=\"example-form\" :data-picker-form=\"picker.id\">\n          <div class=\"catalog-field\">\n            <field label=\"Example\" hint=\"Search control, layout or overlay. Use at least two characters.\">\n              <select name=\"example\" label=\"Example\" placeholder=\"Choose an example\u2026\" searchable async required\n                      :minQuery=\"2\" :debounce=\"150\" :disabled=\"picker.disabled\" :loading=\"picker.loading\"\n                      :preserveKey=\u0027\"picker-\" + picker.id\u0027 :data-picker-native=\"picker.id\"\n                      :aria-invalid=\"picker.error.isNotBlank().toString()\" :aria-describedby=\u0027\"picker-error-\" + picker.id\u0027>\n                <option value=\"\" :selected=\"picker.value.isEmpty()\">Choose an example\u2026</option>\n                <for option in bosca.design.catalog.CatalogChoiceSearch.options>\n                  <option :value=\"option.value\" :selected=\"picker.value == option.value\" :disabled=\"option.disabled\">{ option.label }</option>\n                </for>\n              </select>\n            </field>\n            <alert compact :id=\u0027\"picker-error-\" + picker.id\u0027 :hidden=\"picker.error.isEmpty()\">{ picker.error }</alert>\n          </div>\n          <div class=\"example-actions\">\n            <button type=\"submit\" primary :disabled=\"picker.disabled || picker.loading\" :data-picker-save=\"picker.id\">Save choice</button>\n            <button type=\"reset\">Reset choice</button>\n          </div>\n        </form>\n        <details data-example-states :data-picker-states=\"picker.id\">\n          <disclosure-heading>Example states</disclosure-heading>\n          <div class=\"catalog-stack picker-state-options\">\n            <switch label=\"Reject searches\" description=\"Turn off to retry the same search.\" :checked=\"picker.failSearch\"\n                    @change=\"picker.toggleFailure\" :data-picker-failure=\"picker.id\" />\n            <switch label=\"Disable the picker\" :checked=\"picker.disabled\" @change=\"picker.toggleDisabled\" :data-picker-disable=\"picker.id\" />\n            <switch label=\"Show a loading state\" :checked=\"picker.loading\" @change=\"picker.toggleLoading\" :data-picker-loading=\"picker.id\" />\n          </div>\n        </details>\n        <toast :id=\u0027\"choice-saved-\" + picker.id\u0027 :message=\"picker.message\" :sequence=\"picker.saves\"\n               tone=\"success\" :data-picker-toast=\"picker.id\" />\n      </div>\n    </island>\n  </card>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    import { bmlContractCall } from \"@bosca/bml\";\n    import type { SelectPage, SelectSearch } from \"@bosca/bml-design/select\";\n    retainDisclosure(ctx);\n    ctx.on<CustomEvent<SelectSearch>>(ctx.root, \"selectsearch\", event => {\n      const owner = event.target instanceof Element ? event.target.closest(\"[data-picker-example]\") : null;\n      if (!owner) return;\n      event.stopPropagation();\n      const { query, offset, resolve, reject } = event.detail;\n      bmlContractCall<SelectPage>(\"CatalogChoices\", \"search\", [{ query, offset, fail: owner.hasAttribute(\"data-search-failure\") }])\n        .then(resolve, reject);\n    });\n  </script>\n</component>\n"'>
      <div class="example-stack"><select label="Choose a component" name="component" searchable><option value="">Choose…</option><option value="button">Button</option><optgroup label="Layout"><option value="panel">Panel</option><option value="page-heading">Page heading with a long descriptive label</option></optgroup></select><select label="Unavailable choice" disabled><option>Disabled</option></select><select label="No results" searchable /><a class="catalog-link" href="/choices">Local and multiple choice states</a><a class="catalog-link" href="/selection">Try the paged picker</a></div>
    </reference-entry>
  </catalog-document>
</page>
