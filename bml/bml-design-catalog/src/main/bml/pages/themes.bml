<page route="/themes">
  <catalog-document title="Application-owned themes" description="The same unprefixed components in two CSS palettes." current="/themes">
    <p class="page-intro">Each section below uses the same form component. Only the enclosing class and its CSS variables change.</p>
    <div class="catalog-grid">
      <div class="catalog-palette-dark" data-catalog-palette="dark"><foundation-form id="dark" title="Dark, blue palette" /></div>
      <div class="catalog-palette-light" data-catalog-palette="light"><foundation-form id="light" title="Light, green accent" /></div>
    </div>
    <card title="Set a palette in your CSS">
      <div class="catalog-stack">
        <pre class="code-sample" role="group" tabindex="0" aria-label="Consumer palette CSS"><code>.product-theme &#123;
  --bg-1: #fff;
  --bg-2: #f1f5f9;
  --fg-0: #0f172a;
  --line-2: #738399;
  --accent: #166534;
  color-scheme: light;
&#125;</code></pre>
        <p class="catalog-description">This application’s complete palette also sets text, border, status and brand-mark colors. Controls derive their local background from <code>--bg-2</code>; no component copy or theme service is needed.</p>
      </div>
    </card>
  </catalog-document>
</page>
