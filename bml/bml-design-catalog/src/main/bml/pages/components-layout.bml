<page route="/components/layout">
  <script server provides="paginationPage">ctx.query["page"]?.toLongOrNull()?.coerceIn(1L, 3L) ?: 2L</script>
  <catalog-document title="Layout and navigation" description="Surfaces, headings and caller-owned destinations." current="/components">
    <a class="catalog-link" href="/shell">Open the application shell and profile example</a>
    <a class="catalog-link" href="/surfaces">Working surfaces, disclosures and data states in two palettes</a>
    <nav class="reference-jumps" aria-label="On this page">
      <a href="#ref-card">card</a>
      <a href="#ref-page-shell">page-shell</a>
      <a href="#ref-workspace">workspace</a>
      <a href="#ref-fullscreen-button">fullscreen-button</a>
      <a href="#ref-panel">panel</a>
      <a href="#ref-section">section</a>
      <a href="#ref-page-heading">page-heading</a>
      <a href="#ref-section-heading">section-heading</a>
      <a href="#ref-disclosure-heading">disclosure-heading</a>
      <a href="#ref-app-header">app-header</a>
      <a href="#ref-app-shell">app-shell</a>
      <a href="#ref-profile">profile</a>
      <a href="#ref-profile-menu">profile-menu</a>
      <a href="#ref-tabs">tabs</a>
    </nav>
    <reference-entry name="app-shell"
      :api='""'
      :contract='"A viewport-height application shell with the ambient gradients and responsive sidebar layout used by Git. Project an app-header and a shell-main region. Navigation, profile data, actions and palette belong to the application."'
      :keyboard='"Links and controls retain native semantics. At 700px and below, the sidebar becomes a wrapping header with horizontal navigation."'
      :css='"--shell-background selects the gradient base; --shell-accent tints the neutral layers and falls back to --accent. --brand-accent tints the purple layer. shell-main, shell-subsystem, shell-navigation, shell-group, shell-label, shell-icon, shell-settings, shell-chevron and shell-footer style projected regions."'
      :snippet='"<app-shell><app-header brand=\"Bosca\" product=\"Example\" href=\"/shell\"><nav class=\"shell-navigation\" aria-label=\"Example\"><a href=\"/shell\" aria-current=\"page\">Overview</a></nav></app-header><div class=\"shell-main\"><p>Application content</p></div></app-shell>"'>
      <div class="reference-app-shell" aria-hidden="true" inert><app-shell><app-header brand="Bosca" product="Example" href="/shell"><nav class="shell-navigation" aria-label="Example"><a href="/shell" aria-current="page">Overview</a></nav></app-header><div class="shell-main"><p>Application content</p></div></app-shell></div>
    </reference-entry>
    <reference-entry name="profile"
      :api='"name: String (required)\nsubtitle: String = \"\"\navatar: String = \"\"\ninitials: String = \"\"\nshowAvatar: Boolean = true"'
      :contract='"A reusable identity display with an optional avatar image, initials or decorative user icon. Name and subtitle truncate within the available width. Additional attributes and classes target the root."'
      :keyboard='"Display content adds no interaction. Images and fallback icons are decorative; the profile name remains readable text."'
      :css='"Inherits --bg-3, --fg-0, --fg-1, --fg-2 and --font-sans. data-profile-name and data-profile-subtitle identify text targets for consumer-owned identity loading."'
      :snippet='"<profile name=\"Alex Example\" subtitle=\"@alex\" initials=\"AE\" />"'>
      <profile name="Alex Example" subtitle="@alex" initials="AE" />
    </reference-entry>
    <reference-entry name="profile-menu"
      :api='"label: String = \"Profile\"\nname: String = \"Profile\"\nsubtitle: String = \"\"\nicon: String = \"users\"\nwidth: Int = 260\nerror: String = \"\""'
      :contract='"Profile trigger and identity heading composed from the shared popover and profile. Project role=menuitem links or buttons. The application supplies identity, authentication, appearance actions and persistence. Additional attributes and classes target the root."'
      :keyboard='"Click or Enter opens the native disclosure. Right-click, ContextMenu and Shift+F10 open and focus the first enabled item. Arrow keys and Home/End navigate; Escape restores trigger focus. Native disclosure works without scripts."'
      :css='"The shared popover supplies spacing, opaque consumer surfaces, the quiet --popover-border and focus styling. data-profile-heading and data-profile-error are public targets for consumer-owned identity or error updates."'
      :snippet='"<profile-menu label=\"Account\" name=\"Alex Example\" subtitle=\"@alex\"><a role=\"menuitem\" href=\"/shell\"><span class=\"menu-icon\"><icon name=\"users\" /></span>Profile</a><button role=\"menuitem\" icon=\"moon\" disabled>Dark appearance</button></profile-menu>"'>
      <profile-menu label="Account" name="Alex Example" subtitle="@alex"><a role="menuitem" href="/shell"><span class="menu-icon"><icon name="users" /></span>Profile</a><button role="menuitem" icon="moon" disabled>Dark appearance</button></profile-menu>
    </reference-entry>
    <reference-entry name="card"
      :api='"title: String = \"\"\npadded: Boolean = true"'
      :contract='"Native section with an optional heading and a default child body. Only named props and children are consumed."'
      :keyboard='"A structural surface with an optional title, padded by default. It adds no keyboard interaction; use normal heading order in its child content."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --bg-1, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<card title=\"Preferences\"><div class=\"catalog-stack\"><p class=\"catalog-description\">Content belongs to this application.</p><button size=\"sm\">Save preferences</button></div></card>"'>
      <card title="Preferences"><div class="catalog-stack"><p class="catalog-description">Content belongs to this application.</p><button size="sm">Save preferences</button></div></card>
    </reference-entry>
    <reference-entry name="page-shell"
      :api='"fill: Boolean = false\nnarrow: Boolean = false"'
      :contract='"Native main with default children, merged classes, and additional attributes. fill allocates a flex column; narrow uses a centered 400px form surface."'
      :keyboard='"Native main landmark. A document should contain one main landmark; this embedded illustration uses aria-hidden and inert. fill and narrow are layout variants."'
      :css='"Palette and typography inherit from the consuming application. Child controls use their own documented tokens; icon strokes inherit currentColor. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"reference-shell\" aria-hidden=\"true\" inert><page-shell narrow><p>A narrow page surface.</p></page-shell></div>"'>
      <div class="reference-shell" aria-hidden="true" inert><page-shell narrow><p>A narrow page surface.</p></page-shell></div>
    </reference-entry>
    <reference-entry name="workspace"
      :api='"label: String (required)\nframed: Boolean = false"'
      :contract='"A labelled section fills the remaining height of a bounded flex column. Projected forms, actions and content belong to the application. Add fullscreen-button inside the workspace to enable expansion."'
      :keyboard='"Full screen retains the mounted content and scroll. Escape exits after any projected dialog or popover closes. Background controls are inert while expanded and regain their previous state on exit or unmount."'
      :css='"workspace-content carries flexible nested columns; workspace-fixed reserves headers and footers; workspace-scroll scrolls a preview internally. Colors and borders inherit. Optional --workspace-bg, --workspace-fullscreen-bg, --workspace-radius and --workspace-z-index customize the surface."'
      :snippet='"<page-shell fill>\n  <workspace label=\"Document\" framed>\n    <header class=\"workspace-fixed\"><fullscreen-button /></header>\n    <source-view :content=\"document.source\" path=\"README.md\" bare fill />\n  </workspace>\n</page-shell>"'>
      <div class="reference-workspace"><workspace label="Document example" framed><div class="workspace-fixed catalog-workspace-toolbar"><strong>Document</strong><fullscreen-button /></div><div class="workspace-scroll catalog-workspace-prose" tabindex="0"><p>The workspace keeps room for your document.</p></div></workspace></div>
      <a class="catalog-link" href="/workspaces">Open the full-page workspace example</a>
    </reference-entry>
    <reference-entry name="fullscreen-button"
      :api='"label: String = \"Full screen\"\nexitLabel: String = \"Exit full screen\""'
      :contract='"A compact native icon button controls its nearest workspace. The expand/contract icons have accessible names and tooltips from label and exitLabel. Additional classes and attributes target the button. It remains hidden until the workspace client is mounted."'
      :keyboard='"Enter or Space expands the workspace. Exit full screen or Escape returns focus to the control. A rejected or unsupported browser full-screen request keeps the workspace expanded within the viewport."'
      :css='"Shared button colors and focus tokens apply. --control-height-sm sets both dimensions, 30px by default. Labels remain accessible without changing the footprint."'
      :snippet='"<workspace label=\"Preview\" framed>\n  <div class=\"workspace-fixed\"><fullscreen-button label=\"Expand preview\" exitLabel=\"Return to page\" /></div>\n  <article class=\"workspace-scroll\" tabindex=\"0\">Preview content</article>\n</workspace>"'>
      <div class="reference-workspace"><workspace label="Preview example" framed><div class="workspace-fixed catalog-workspace-toolbar"><fullscreen-button label="Expand preview" exitLabel="Return to page" /></div><div class="workspace-scroll catalog-workspace-prose" tabindex="0"><p>Use the same control for source, preview, charts or other content.</p></div></workspace></div>
    </reference-entry>
    <reference-entry name="panel"
      :api='""'
      :contract='"Native section with a surface, border, 20px padding and default children. Additional attributes/classes target the section."'
      :keyboard='"Structural surface with native section semantics. Supply an accessible label when it represents a distinct landmark."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --bg-1, --line, --r-md. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"surface-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"surface\" scope=\"server-session\">bosca.design.catalog.CatalogSurface(id)</script>\n  <island name=\"surface\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-catalog-surface=\"surface.id\">\n      <panel :aria-label=\u0027if (surface.id == \"dark\") \"Dark surface example\" else \"Light surface example\"\u0027 class=\"catalog-surface-panel\" :data-surface-panel=\"surface.id\">\n        <div class=\"catalog-stack\">\n          <form @submit=\"surface.load\" class=\"example-form catalog-surface-form\" :data-surface-form=\"surface.id\">\n            <section-heading :title=\"surface.title()\" subtitle=\"Data and actions belong to this example\" :data-surface-heading=\"surface.id\">\n              <button type=\"submit\" size=\"sm\" :data-surface-load=\"surface.id\">Load examples</button>\n              <button size=\"sm\" :disabled=\"!surface.loaded\" @click=\"surface.clear\" :data-surface-clear=\"surface.id\">Clear</button>\n            </section-heading>\n            <div class=\"catalog-surface-stage\" :data-surface-stage=\"surface.id\">\n              <loading-state label=\"Loading local examples…\" :compact=\"surface.compact\" class=\"catalog-surface-pending\" :data-surface-loading=\"surface.id\" />\n              <div class=\"catalog-surface-results\" :data-surface-results=\"surface.id\">\n                <if surface.loaded>\n                  <table-scroll label=\"Local component examples\" class=\"catalog-surface-table\"\n                                :data-bml-preserve=\u0027\"surface-table-\" + surface.id + \"-\" + surface.revision\u0027 :data-surface-table=\"surface.id\">\n                    <table>\n                      <caption>Available library examples</caption>\n                      <thead><tr><th scope=\"col\">Component</th><th scope=\"col\">Native value</th><th scope=\"col\">Reference</th></tr></thead>\n                      <tbody><for choice in surface.rows()><tr>\n                        <th scope=\"row\">{ choice.label }</th><td><code>{ choice.value }</code></td>\n                        <td><a class=\"catalog-link\" :href=\u0027\"/components/\" + (if (choice.label.endsWith(\"· layout\")) \"layout\" else if (choice.label.endsWith(\"· overlay\")) \"overlays\" else \"controls\") + \"#ref-\" + choice.value\u0027>View API</a></td>\n                      </tr></for></tbody>\n                    </table>\n                  </table-scroll>\n                <else>\n                  <empty-state title=\"No examples loaded\" message=\"Load the local examples to explore a scrolling table.\" icon=\"folder\" :data-surface-empty=\"surface.id\">\n                    <button type=\"submit\" size=\"sm\" :data-surface-empty-action=\"surface.id\">Load examples</button>\n                  </empty-state>\n                </if>\n              </div>\n            </div>\n          </form>\n          <section :aria-label=\u0027\"Surface details \" + surface.id\u0027 class=\"catalog-surface-section\"\n                   :data-bml-preserve=\u0027\"surface-disclosure-\" + surface.id\u0027 :data-surface-section=\"surface.id\">\n            <details :data-surface-disclosure=\"surface.id\">\n              <disclosure-heading framed>Keep a local note <badge tone=\"info\">Optional</badge></disclosure-heading>\n              <div class=\"catalog-stack catalog-surface-disclosure-body\">\n                <p class=\"example-note\">This native disclosure and its local draft stay in the browser while surrounding content updates.</p>\n                <field label=\"Local note\"><input name=\"note\" placeholder=\"Add a note…\" maxlength=\"160\" :data-surface-note=\"surface.id\" /></field>\n              </div>\n            </details>\n          </section>\n          <details data-example-states>\n            <disclosure-heading>Example states</disclosure-heading>\n            <div class=\"catalog-stack surface-state-options\">\n              <switch label=\"Reject loading\" :checked=\"surface.rejectLoad\" @change=\"surface.toggleRejection\" :data-surface-reject=\"surface.id\" />\n              <switch label=\"Use long labels\" :checked=\"surface.longLabels\" @change=\"surface.toggleLongLabels\" :data-surface-long=\"surface.id\" />\n              <switch label=\"Use compact loading\" :checked=\"surface.compact\" @change=\"surface.toggleCompact\" :data-surface-compact=\"surface.id\" />\n              <div class=\"example-actions\"><button @click=\"surface.refresh\" :data-surface-refresh=\"surface.id\">Refresh example</button></div>\n              <p class=\"example-note\">Loading, empty and table views share the same space. Rejected actions keep the current data and report through a toast.</p>\n            </div>\n          </details>\n        </div>\n      </panel>\n      <div class=\"catalog-grid\" :data-surface-cases=\"surface.id\">\n        <div :data-surface-padded=\"surface.id\"><card title=\"Padded card\"><div class=\"catalog-stack\"><p class=\"catalog-description\">The card provides its body padding. The application supplies content gaps.</p><button size=\"sm\" @click=\"surface.refresh\">Refresh example</button></div></card></div>\n        <div :data-surface-unpadded=\"surface.id\"><card title=\"Unpadded card\" :padded=\"false\"><section-heading title=\"Projected content\" subtitle=\"The body owns its spacing\" /><div class=\"catalog-surface-unpadded-body\"><p class=\"catalog-description\">Use the unpadded variant for a flush heading, table or other content with its own gutters.</p></div></card></div>\n        <div :data-surface-untitled=\"surface.id\"><card><div class=\"catalog-stack\"><h2 class=\"catalog-surface-title\">Caller-owned heading</h2><p class=\"catalog-description\">Omitting title leaves only the padded content body.</p><details><disclosure-heading>Plain disclosure</disclosure-heading><p class=\"example-note\">Native disclosure remains available without scripts.</p></details></div></card></div>\n        <div :data-surface-minimal=\"surface.id\"><card title=\"Minimal empty state\"><empty-state message=\"No matching examples.\" icon=\"search\" /></card></div>\n      </div>\n      <toast :id=\u0027\"surface-notice-\" + surface.id\u0027 :message=\"surface.notice\" :sequence=\"surface.noticeSequence\" :tone=\"surface.noticeTone\" :data-surface-toast=\"surface.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>"'>
      <panel aria-label="Example panel"><p class="catalog-description">A bordered content surface.</p></panel>
    </reference-entry>
    <reference-entry name="section"
      :api='""'
      :contract='"Native section with 16px vertical spacing, a bottom border and default children. Additional attributes/classes target the section."'
      :keyboard='"Structural spacing and divider. Use html:section to author a native section after importing this component."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<section aria-label=\"Example section\"><p class=\"catalog-description\">A section divider around caller content.</p></section>"'>
      <section aria-label="Example section"><p class="catalog-description">A section divider around caller content.</p></section>
    </reference-entry>
    <reference-entry name="page-heading"
      :api='"title: String (required)\nsubtitle: String = \"\"\ntrail: List<bosca.design.model.NavigationItem> = emptyList()\ncrumb: String = \"\"\nicon: String = \"\"\niconColor: String = \"var(--accent)\"\nbadge: String = \"\"\nbadgeTone: String = \"neutral\"\nbadgeColor: String = \"\""'
      :contract='"Header with breadcrumbs, title/icon, optional badge/subtitle and default action children. Additional attributes/classes target the header. The current crumb defaults to the title."'
      :keyboard='"Breadcrumbs remain native links. The application supplies NavigationItem labels, hrefs and selected flags; the final crumb defaults to title. Project action controls in its children. This embedded document-heading illustration is inert; use the displayed source in a page header."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --fg-1, --fg-3, --fg-4, --on-accent. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<page-heading title=\"Component examples\" subtitle=\"Application-owned navigation and actions\" icon=\"code\" badge=\"Preview\" badgeTone=\"info\" :trail=\u0027listOf(bosca.design.model.NavigationItem(\"Components\", \"/components\", false))\u0027><button size=\"sm\">Add example</button></page-heading>"'>
      <div aria-hidden="true" inert><page-heading title="Component examples" subtitle="Application-owned navigation and actions" icon="code" badge="Preview" badgeTone="info" :trail='listOf(bosca.design.model.NavigationItem("Components", "/components", false))'><button size="sm">Add example</button></page-heading></div>
    </reference-entry>
    <reference-entry name="section-heading"
      :api='"title: String (required)\nsubtitle: String = \"\""'
      :contract='"Header with a title, subtitle and default action children. Additional attributes/classes target the header."'
      :keyboard='"A section title and optional subtitle; child action controls keep their native keyboard behavior."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --fg-2, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<section-heading title=\"Recent examples\" subtitle=\"Action content is projected\"><button size=\"sm\">Add example</button></section-heading>"'>
      <section-heading title="Recent examples" subtitle="Action content is projected"><button size="sm">Add example</button></section-heading>
    </reference-entry>
    <reference-entry name="disclosure-heading"
      :api='"framed: Boolean = false"'
      :contract='"Native summary inside caller-owned details, with default label children and a decorative chevron that follows the open state. Additional attributes/classes target the summary."'
      :keyboard='"Place directly inside native details. Enter or Space toggles disclosure, including without scripts. framed adds a surrounding surface."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --fg-0, --fg-2, --focus-width, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<details><disclosure-heading framed>Read more about this example</disclosure-heading><p class=\"catalog-description\">Native disclosure content remains usable without scripts.</p></details>"'>
      <details><disclosure-heading framed>Read more about this example</disclosure-heading><p class="catalog-description">Native disclosure content remains usable without scripts.</p></details>
    </reference-entry>
    <reference-entry name="app-header"
      :api='"brand: String (required)\nproduct: String = \"\"\nhref: String (required)"'
      :contract='"Header with a brand link/mark and default navigation children. Extra attributes/classes target the header. A 224px sidebar becomes a wrapping header at 700px. Scoped client code reveals the active item in overflowing navigation on mount, resize and updates within the header."'
      :keyboard='"Brand and navigation remain native links. The application owns destinations and current-page calculation. The header reveals the current link when its navigation overflows."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --bg-1, --fg-0, --fg-1, --fg-2, --line. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<app-header brand=\"Bosca\" product=\"Example\" href=\"/components\"><nav class=\"reference-header-nav\" aria-label=\"Example application\"><a href=\"/foundation\">Foundation</a><a href=\"/themes\">Themes</a></nav></app-header>"'>
      <app-header brand="Bosca" product="Example" href="/components"><nav class="reference-header-nav" aria-label="Example application"><a href="/foundation">Foundation</a><a href="/themes">Themes</a></nav></app-header>
    </reference-entry>
    <reference-entry name="tabs"
      :api='"label: String (required)\nitems: List<bosca.design.model.NavigationItem> (required)\nheader: Boolean = false"'
      :contract='"Native nav receives additional attributes/classes and default trailing action children. Destinations remain native anchors with aria-current=\"page\" on the current item. The scoped helper fits links around the current destination and a More overflow disclosure."'
      :keyboard='"Native route anchors with aria-current on the selected destination. More exposes overflow destinations; arrows/Home/End navigate the open menu, Escape returns focus. header changes spacing."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --bg-3, --fg-0, --fg-1, --fg-3, --focus-width, --line, --line-2, --shadow-color, --tabs-menu-shadow. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"navigation-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"navigation\" scope=\"server-session\">bosca.design.catalog.CatalogNavigation(id)</script>\n  <island name=\"navigation\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-catalog-navigation=\"navigation.id\">\n      <if navigation.visible>\n        <div class=\"catalog-route-host\" :data-narrow=\"navigation.narrow\" :data-navigation-host=\"navigation.id\">\n          <tabs :label=\u0027\"Catalog destinations · \" + navigation.id\u0027 :items=\"navigation.items()\"\n                :data-bml-preserve=\u0027\"catalog-routes-\" + navigation.id + \"-\" + navigation.revision\u0027\n                :data-navigation-tabs=\"navigation.id\">\n            <button size=\"sm\" @click=\"navigation.refresh\" :data-navigation-action=\"navigation.id\">Refresh</button>\n          </tabs>\n        </div>\n      </if>\n      <p class=\"example-note\">Destinations are native links. More contains links that do not fit beside the current item and the projected action.</p>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack navigation-state-options\">\n          <switch label=\"Narrow the container\" :checked=\"navigation.narrow\" @change=\"navigation.toggleNarrow\" :data-navigation-narrow=\"navigation.id\" />\n          <switch label=\"Use a long current label\" :checked=\"navigation.longLabel\" @change=\"navigation.toggleLong\" :data-navigation-long=\"navigation.id\" />\n          <switch label=\"Show navigation\" :checked=\"navigation.visible\" @change=\"navigation.toggleVisible\" :data-navigation-visible=\"navigation.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"navigation.changeCurrent\" :disabled=\"!navigation.visible\" :data-navigation-current=\"navigation.id\">Change selected destination</button>\n            <button @click=\"navigation.replace\" :disabled=\"!navigation.visible\" :data-navigation-replace=\"navigation.id\">Replace destinations</button>\n            <button @click=\"navigation.refresh\" :data-navigation-refresh=\"navigation.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Refresh keeps the open menu and focused link. Changing items changes the preservation key. The selected flag belongs to this example; following a link navigates normally.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"navigation-notice-\" + navigation.id\u0027 :message=\"navigation.notice\" :sequence=\"navigation.noticeSequence\"\n             tone=\"info\" :data-navigation-toast=\"navigation.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <tabs label="Example routes" :items='listOf(bosca.design.model.NavigationItem("Components", "/components", false), bosca.design.model.NavigationItem("Layout", "/components/layout", true), bosca.design.model.NavigationItem("Foundation", "/foundation", false))' />
      <a class="catalog-link" href="/navigation">Working route navigation and overflow states</a>
    </reference-entry>
    <card title="Forms and actions" description="The library owns form spacing, footer alignment, navigation controls, and pagination.">
      <form action="/components/layout" method="get"><form-body>
        <field label="Example name"><input name="example" value="Library form" /></field>
        <form-actions><button-link href="/components/layout" icon="arrow-left">Cancel</button-link><button type="submit" primary>Save example</button></form-actions>
      </form-body></form>
      <pagination :page="paginationPage" :previousHref='if (paginationPage != 1L) "/components/layout?page=" + (paginationPage - 1) else ""' :nextHref='if (paginationPage != 3L) "/components/layout?page=" + (paginationPage + 1) else ""' label="Example pages" />
    </card>
  </catalog-document>
</page>
