<page route="/components/calendars">
  <catalog-document title="Calendar views" description="Calendar component APIs and authoring." current="/components">
    <reference-entry name="calendar-view"
      :api='"current: String (required)\nevents: List<bosca.design.model.CalendarEvent> = emptyList()\ncalendarColors: Map<String, String> = emptyMap()\nlabel: String = \"Calendar\"\nreadOnly: Boolean = false\npreserveKey: String = \"\"\nview: String = \"month\""'
      contract="Additional attributes reach the calendar root. Supply a stable, unique preserveKey to retain the calendar and its scroll position during application updates. Supply typed occurrences and calendar colors. calendarselectday and calendarnewevent supply day; calendarselectslot supplies day and hour; calendarselectevent supplies event; calendarmoveevent supplies eventId, startsAt and endsAt. The application loads and saves data."
      keyboard="Tab reaches dates, events, overflow and hourly slots. Alt with arrow keys moves editable events; Shift with Alt and Up/Down resizes. Escape cancels dragging. Without scripts the event list remains readable. End timestamps are exclusive."
      css="--calendar-height sets the scroll viewport; shared palette, border, radius, font and focus tokens style the view."
      :snippet='"<calendar-view current=\"2026-11-05\" :events=\"occurrences\" label=\"Team calendar\" />"'>
      <calendar-view current="2026-11-05" :events='bosca.design.catalog.CatalogCalendar("reference").events' label="Reference calendar" readOnly />
      <a class="catalog-link" href="/calendars">Working examples in both palettes</a>
    </reference-entry>
    <reference-entry name="calendar-month-view"
      :api='"current: String (required)\nevents: List<bosca.design.model.CalendarEvent> = emptyList()\ncalendarColors: Map<String, String> = emptyMap()\nlabel: String = \"Calendar\"\nreadOnly: Boolean = false\npreserveKey: String = \"\""'
      contract="Additional attributes reach the calendar root. Supply a stable, unique preserveKey to retain the calendar and its scroll position during application updates. Supply typed occurrences and calendar colors. calendarselectday and calendarnewevent supply day; calendarselectslot supplies day and hour; calendarselectevent supplies event; calendarmoveevent supplies eventId, startsAt and endsAt. The application loads and saves data."
      keyboard="Tab reaches dates, events, overflow and hourly slots. Alt with arrow keys moves editable events; Shift with Alt and Up/Down resizes. Escape cancels dragging. Without scripts the event list remains readable. End timestamps are exclusive."
      css="--calendar-height sets the scroll viewport; shared palette, border, radius, font and focus tokens style the view."
      :snippet='"<calendar-month-view current=\"2026-11-05\" :events=\"occurrences\" label=\"Team calendar\" />"'>
      <calendar-month-view current="2026-11-05" :events='bosca.design.catalog.CatalogCalendar("reference").events' label="Reference calendar" readOnly />
      <a class="catalog-link" href="/calendars">Working examples in both palettes</a>
    </reference-entry>
