<page route="/components/content">
  <catalog-document title="Content and editors" description="Tables, keyboard trees, comments and structured content." current="/components">
    <nav class="reference-jumps" aria-label="On this page">
      <a href="#ref-table-scroll">table-scroll</a>
      <a href="#ref-tree">tree</a>
      <a href="#ref-tree-item">tree-item</a>
      <a href="#ref-comment-editor">comment-editor</a>
      <a href="#ref-json-editor">json-editor</a>
      <a href="#ref-source-view">source-view</a>
    </nav>
    <reference-entry name="table-scroll"
      :api='"label: String = \"Scrollable table\""'
      :contract='"Focusable, labelled region with forwarded attributes/classes and default table children. Horizontal overflow stays inside the region; keyboard focus uses the accent color."'
      :keyboard='"Tab focuses the labelled scrolling region. Horizontal table overflow stays inside it; use native headers and captions for table semantics."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<table-scroll label=\"Component dimensions\"><table><caption>Regular and compact controls</caption><thead><tr><th scope=\"col\">Control</th><th scope=\"col\">Regular</th><th scope=\"col\">Compact</th><th scope=\"col\">Notes</th></tr></thead><tbody><tr><th scope=\"row\">Button</th><td>32px</td><td>30px</td><td>Extra-small buttons are 24px high</td></tr><tr><th scope=\"row\">Input</th><td>32px</td><td>30px</td><td>A deliberately long note that stays inside the labelled scrolling table region</td></tr></tbody></table></table-scroll>"'>
      <table-scroll label="Component dimensions"><table><caption>Regular and compact controls</caption><thead><tr><th scope="col">Control</th><th scope="col">Regular</th><th scope="col">Compact</th><th scope="col">Notes</th></tr></thead><tbody><tr><th scope="row">Button</th><td>32px</td><td>30px</td><td>Extra-small buttons are 24px high</td></tr><tr><th scope="row">Input</th><td>32px</td><td>30px</td><td>A deliberately long note that stays inside the labelled scrolling table region</td></tr></tbody></table></table-scroll>
    </reference-entry>
    <reference-entry name="tree"
      :api='"label: String (required)\nheading: String = \"\"\nlocal: Boolean = false\nembedded: Boolean = false\npreserveKey: String = \"\""'
      :contract='"Section receives additional attributes/classes and contains a labelled tree with default item children. local manages disclosure of already-rendered rows; otherwise caller actions own folder loading."'
      :keyboard='"Tab enters one visible row. Up/Down and Home/End move rows; Right opens or enters a directory, Left closes or moves to its parent. local toggles existing rows; server-loaded trees need caller actions. embedded removes the outer surface."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --fg-3. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"tree-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"files\" scope=\"server-session\">bosca.design.catalog.CatalogTree(id)</script>\n  <island name=\"files\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-tree-example=\"files.id\">\n      <if files.visible>\n        <div class=\"catalog-stack\" data-tree-local-block>\n          <p class=\"example-note\">Local disclosure keeps all file links in the document. Use Right to open a folder and enter its first child.</p>\n          <div class=\"catalog-tree-frame\">\n            <tree label=\"Local example files\" heading=\"Component files\" local\n                  :preserveKey=\u0027\"catalog-local-files-\" + files.id + \"-\" + files.revision\u0027 :data-tree-local=\"files.id\">\n              <tree-item path=\"src\" label=\"Source\" directory expanded />\n              <tree-item path=\"src/components\" :label=\u0027if (files.alternate) \"Revised components\" else \"Components\"\u0027 directory expanded :depth=\"1\" />\n              <for choice in bosca.design.catalog.CatalogChoiceSearch.options.filter { !it.disabled && it.label.endsWith(\"\u00b7 control\") }>\n                <tree-item :path=\u0027\"src/components/\" + choice.value + \".bml\"\u0027 :label=\u0027choice.value + \".bml\"\u0027\n                           :href=\u0027\"/components/controls#ref-\" + choice.value\u0027 :depth=\"2\"\n                           :selected=\u0027choice.value == (if (files.alternate) \"input\" else \"button\")\u0027 />\n              </for>\n              <tree-item path=\"docs\" label=\"Documents\" directory />\n              <tree-item path=\"docs/guide.md\" label=\"Guide\" href=\"/foundation\" :depth=\"1\" />\n              <tree-item path=\"LICENSE\" label=\"License notices\" href=\"/components\" />\n              <tree-item path=\"long-example.bml\" label=\"veryLongComponentIdentifierThatWrapsAcrossNarrowTreesWithoutAnySpaces.bml\" href=\"/components/content#ref-tree-item\" wrap />\n            </tree>\n          </div>\n        </div>\n        <div class=\"catalog-stack\" data-tree-server-block>\n          <p class=\"example-note\">The application loads this folder with a BML action. Rejection keeps it closed; a successful retry adds the file links.</p>\n          <tree label=\"Server-loaded example files\" heading=\"Loaded examples\" embedded :data-tree-server=\"files.id\">\n            <tree-item path=\"remote\" label=\"Examples\" directory :expanded=\"files.expanded\"\n                       @click=\"files.toggleDirectory\" :data-bml-preserve=\u0027\"catalog-remote-directory-\" + files.id\u0027 :data-tree-directory=\"files.id\" />\n            <if files.expanded>\n              <tree-item path=\"remote/button.bml\" label=\"Button example\" href=\"/components/controls#ref-button\" :depth=\"1\"\n                         :data-bml-preserve=\u0027\"catalog-remote-button-\" + files.id\u0027 />\n              <tree-item path=\"remote/input.bml\" label=\"Input example\" href=\"/components/controls#ref-input\" :depth=\"1\"\n                         :data-bml-preserve=\u0027\"catalog-remote-input-\" + files.id\u0027 />\n            </if>\n          </tree>\n        </div>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack tree-state-options\">\n          <switch label=\"Reject directory loading\" :checked=\"files.rejectLoad\" @change=\"files.toggleRejection\" :data-tree-reject=\"files.id\" />\n          <switch label=\"Show trees\" :checked=\"files.visible\" @change=\"files.toggleVisible\" :data-tree-visible=\"files.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"files.replace\" :disabled=\"!files.visible\" :data-tree-replace=\"files.id\">Replace local files</button>\n            <button @click=\"files.refresh\" :data-tree-refresh=\"files.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Refresh retains local disclosure, scroll and focus. Replacing local files changes their key. The server-loaded folder keeps its native directory button while children change.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"tree-notice-\" + files.id\u0027 :message=\"files.notice\" :sequence=\"files.noticeSequence\"\n             :tone=\"files.noticeTone\" :data-tree-toast=\"files.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <div class="example-stack"><tree label="Example files" heading="Files" local embedded><tree-item path="src" label="Source" directory expanded /><tree-item path="src/main.kt" label="main.kt" href="#ref-source-view" :depth="1" selected /><tree-item path="docs" label="Documents" directory /><tree-item path="docs/guide.md" label="A long guide filename that wraps on narrow screens" href="#ref-comment-editor" :depth="1" wrap /></tree><tree label="Empty files" embedded /></div>
      <a class="catalog-link" href="/trees">Working tree states and loaded children</a>
    </reference-entry>
    <reference-entry name="tree-item"
      :api='"path: String (required)\nlabel: String (required)\nhref: String = \"\"\ndirectory: Boolean = false\nexpanded: Boolean = false\nselected: Boolean = false\ndepth: Int = 0\nwrap: Boolean = false"'
      :contract='"Flat ARIA tree item. Additional attributes/classes target its native directory button or native file anchor. Declarative actions bind to the item row, which carries pending and busy state. Paths identify hierarchy, depth controls indentation/ARIA level, and selected file links use aria-current=\"page\". No child content."'
      :keyboard='"Use flat rows inside tree, with consistent path hierarchy and depth. A directory button toggles disclosure; a file anchor follows its native href. wrap supports long labels; selected supplies aria-current on a file link."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --fg-0, --fg-1, --fg-2, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"tree-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"files\" scope=\"server-session\">bosca.design.catalog.CatalogTree(id)</script>\n  <island name=\"files\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-tree-example=\"files.id\">\n      <if files.visible>\n        <div class=\"catalog-stack\" data-tree-local-block>\n          <p class=\"example-note\">Local disclosure keeps all file links in the document. Use Right to open a folder and enter its first child.</p>\n          <div class=\"catalog-tree-frame\">\n            <tree label=\"Local example files\" heading=\"Component files\" local\n                  :preserveKey=\u0027\"catalog-local-files-\" + files.id + \"-\" + files.revision\u0027 :data-tree-local=\"files.id\">\n              <tree-item path=\"src\" label=\"Source\" directory expanded />\n              <tree-item path=\"src/components\" :label=\u0027if (files.alternate) \"Revised components\" else \"Components\"\u0027 directory expanded :depth=\"1\" />\n              <for choice in bosca.design.catalog.CatalogChoiceSearch.options.filter { !it.disabled && it.label.endsWith(\"\u00b7 control\") }>\n                <tree-item :path=\u0027\"src/components/\" + choice.value + \".bml\"\u0027 :label=\u0027choice.value + \".bml\"\u0027\n                           :href=\u0027\"/components/controls#ref-\" + choice.value\u0027 :depth=\"2\"\n                           :selected=\u0027choice.value == (if (files.alternate) \"input\" else \"button\")\u0027 />\n              </for>\n              <tree-item path=\"docs\" label=\"Documents\" directory />\n              <tree-item path=\"docs/guide.md\" label=\"Guide\" href=\"/foundation\" :depth=\"1\" />\n              <tree-item path=\"LICENSE\" label=\"License notices\" href=\"/components\" />\n              <tree-item path=\"long-example.bml\" label=\"veryLongComponentIdentifierThatWrapsAcrossNarrowTreesWithoutAnySpaces.bml\" href=\"/components/content#ref-tree-item\" wrap />\n            </tree>\n          </div>\n        </div>\n        <div class=\"catalog-stack\" data-tree-server-block>\n          <p class=\"example-note\">The application loads this folder with a BML action. Rejection keeps it closed; a successful retry adds the file links.</p>\n          <tree label=\"Server-loaded example files\" heading=\"Loaded examples\" embedded :data-tree-server=\"files.id\">\n            <tree-item path=\"remote\" label=\"Examples\" directory :expanded=\"files.expanded\"\n                       @click=\"files.toggleDirectory\" :data-bml-preserve=\u0027\"catalog-remote-directory-\" + files.id\u0027 :data-tree-directory=\"files.id\" />\n            <if files.expanded>\n              <tree-item path=\"remote/button.bml\" label=\"Button example\" href=\"/components/controls#ref-button\" :depth=\"1\"\n                         :data-bml-preserve=\u0027\"catalog-remote-button-\" + files.id\u0027 />\n              <tree-item path=\"remote/input.bml\" label=\"Input example\" href=\"/components/controls#ref-input\" :depth=\"1\"\n                         :data-bml-preserve=\u0027\"catalog-remote-input-\" + files.id\u0027 />\n            </if>\n          </tree>\n        </div>\n      </if>\n      <details data-example-states>\n        <disclosure-heading>Example states</disclosure-heading>\n        <div class=\"catalog-stack tree-state-options\">\n          <switch label=\"Reject directory loading\" :checked=\"files.rejectLoad\" @change=\"files.toggleRejection\" :data-tree-reject=\"files.id\" />\n          <switch label=\"Show trees\" :checked=\"files.visible\" @change=\"files.toggleVisible\" :data-tree-visible=\"files.id\" />\n          <div class=\"example-actions\">\n            <button @click=\"files.replace\" :disabled=\"!files.visible\" :data-tree-replace=\"files.id\">Replace local files</button>\n            <button @click=\"files.refresh\" :data-tree-refresh=\"files.id\">Refresh example</button>\n          </div>\n          <p class=\"example-note\">Refresh retains local disclosure, scroll and focus. Replacing local files changes their key. The server-loaded folder keeps its native directory button while children change.</p>\n        </div>\n      </details>\n      <toast :id=\u0027\"tree-notice-\" + files.id\u0027 :message=\"files.notice\" :sequence=\"files.noticeSequence\"\n             :tone=\"files.noticeTone\" :data-tree-toast=\"files.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <tree label="Example rows" local embedded><tree-item path="examples" label="Examples" directory expanded /><tree-item path="examples/sample.bml" label="sample.bml" href="#ref-comment-editor" :depth="1" /></tree>
    </reference-entry>
    <reference-entry name="comment-editor"
      :api='"id: String (required)\nlabel: String (required)\nvalue: String = \"\"\nerror: String = \"\"\nsubmitDisabled: Boolean = false\nhint: String = \"\"\nsubmitLabel: String = \"comment\"\nplaceholder: String = \"Write a comment…\"\ndescribedBy: String = \"\"\nname: String = \"body\""'
      :contract='"Native required textarea receives additional attributes/classes, its ID and preservation key. Default children supply action controls. The caller owns its surrounding form, submission and error outcomes."'
      :keyboard='"Native required textarea. Ctrl+Enter or Command+Enter submits its surrounding form when allowed. Error drafts stay editable; the caller owns validation and projected buttons. Hint/error IDs are linked to the textarea."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --fg-0, --fg-2, --fg-3, --font-sans, --line, --r-md. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"comment-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <prop name=\"advanced\" type=\"Boolean\" default=\"false\" />\n  <script server provides=\"comment\" scope=\"server-session\">bosca.design.catalog.CatalogComment(id, advanced)</script>\n  <island name=\"comment\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-catalog-comment-owner=\"comment.id\">\n      <form @submit=\"comment.post(form.body)\" class=\"example-stack\" :data-catalog-comment=\"comment.id\">\n        <p class=\"example-note\" :id=\u0027\"comment-context-\" + comment.id\u0027>Use at least eight characters.</p>\n        <if comment.visible>\n          <comment-editor :id=\u0027\"comment-\" + comment.id + \"-\" + comment.revision\u0027 label=\"Example comment\"\n                          :value=\"comment.draft.value\" :error=\"comment.draft.error\" :describedBy=\u0027\"comment-context-\" + comment.id\u0027\n                          :submitDisabled=\"comment.locked\" :readonly=\"comment.readOnly\" :disabled=\"comment.disabled\"\n                          :hint=\u0027if (comment.locked) \"Posting is paused. You can keep editing your draft.\" else \"\"\u0027 submitLabel=\"post comment\">\n            <button type=\"reset\" size=\"sm\" :disabled=\"comment.readOnly || comment.disabled\" :data-comment-reset=\"comment.id\">Reset draft</button>\n            <button type=\"submit\" primary :disabled=\"comment.readOnly || comment.disabled || comment.locked\" :data-comment-post=\"comment.id\">Post comment</button>\n          </comment-editor>\n        </if>\n      </form>\n      <if comment.advanced>\n        <details data-example-states>\n          <disclosure-heading>Example states</disclosure-heading>\n          <div class=\"catalog-stack comment-state-options\">\n            <switch label=\"Reject posts\" :checked=\"comment.rejectPosts\" @change=\"comment.toggleRejection\" :data-comment-reject=\"comment.id\" />\n            <switch label=\"Pause posting\" :checked=\"comment.locked\" @change=\"comment.toggleLocked\" :data-comment-locked=\"comment.id\" />\n            <switch label=\"Readonly\" :checked=\"comment.readOnly\" @change=\"comment.toggleReadOnly\" :data-comment-readonly=\"comment.id\" />\n            <switch label=\"Disable the editor\" :checked=\"comment.disabled\" @change=\"comment.toggleDisabled\" :data-comment-disabled=\"comment.id\" />\n            <switch label=\"Show editor\" :checked=\"comment.visible\" @change=\"comment.toggleVisible\" :data-comment-visible=\"comment.id\" />\n            <div class=\"example-actions\">\n              <button @click=\"comment.replace\" :disabled=\"!comment.visible || comment.readOnly || comment.disabled\" :data-comment-replace=\"comment.id\">Replace draft</button>\n              <button @click=\"comment.clear\" :disabled=\"!comment.visible || comment.readOnly || comment.disabled\" :data-comment-clear=\"comment.id\">Clear draft</button>\n              <button @click=\"comment.refresh\" :data-comment-refresh=\"comment.id\">Refresh example</button>\n            </div>\n            <p class=\"example-note\">Turn rejection off to retry the same draft. Refresh keeps local edits. Reset restores the latest supplied value. Posting successfully or clearing starts a new draft.</p>\n          </div>\n        </details>\n      </if>\n      <toast :id=\u0027\"comment-posted-\" + comment.id\u0027 :message=\"comment.notice\" :sequence=\"comment.noticeSequence\"\n             :tone=\"comment.noticeTone\" :data-catalog-comment-toast=\"comment.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <div class="example-stack"><comment-example id="reference" /><comment-editor id="readonly-reference" label="Readonly example comment" value="This comment is readonly." readonly /><comment-editor id="disabled-reference" label="Unavailable example comment" disabled /><a class="catalog-link" href="/comments">Working comment variants and state examples</a></div>
    </reference-entry>
    <reference-entry name="json-editor"
      :api='"name: String (required)\nvalue: String = \"{}\"\nlabel: String = \"JSON editor\"\nmode: String = \"tree\"\nreadOnly: Boolean = false\ndisabled: Boolean = false\nerror: String = \"\"\npreserveKey: String = \"\""'
      :contract='"Structured editor with a native textarea form value and escaped no-script fallback. Additional attributes/classes target its labelled group. Syntax and caller feedback appear in a live status. No child content."'
      :keyboard='"The editor supplies keyboard editing and menus, with a native textarea form value. tree/text/table modes, readOnly and disabled are supported. Syntax and caller errors are announced. Without scripts the textarea remains editable."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --err, --fg-1, --font-mono, --font-sans, --json-accent, --json-bg, --json-boolean, --json-fg, --json-height, --json-key, --json-number, --json-panel-bg, --json-scheme, --json-selection, --json-string, --line, --r-md. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"json-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <prop name=\"advanced\" type=\"Boolean\" default=\"false\" />\n  <script server provides=\"settings\" scope=\"server-session\">bosca.design.catalog.CatalogJson(id, advanced)</script>\n  <island name=\"settings\" :key=\"id\">\n    <div class=\"catalog-stack\" :data-catalog-json-owner=\"settings.id\">\n      <form @submit=\"settings.save(form.settings)\" class=\"example-stack\" :data-catalog-json=\"settings.id\">\n        <if settings.visible>\n          <json-editor name=\"settings\" label=\"Example settings\" :value=\"settings.draft.value\" :error=\"settings.draft.error\"\n                       :mode=\"settings.mode\" :readOnly=\"settings.readOnly\" :disabled=\"settings.disabled\"\n                       :preserveKey=\u0027\"settings-\" + settings.id\u0027 :data-catalog-json-editor=\"settings.id\" />\n        </if>\n        <div class=\"example-actions\">\n          <button type=\"submit\" primary :disabled=\"!settings.visible || settings.readOnly || settings.disabled\" :data-json-save=\"settings.id\">Save JSON</button>\n          <button type=\"reset\" :disabled=\"!settings.visible || settings.readOnly || settings.disabled\" :data-json-reset=\"settings.id\">Reset JSON</button>\n        </div>\n      </form>\n      <if settings.advanced>\n        <details data-example-states>\n          <disclosure-heading>Example states</disclosure-heading>\n          <div class=\"catalog-stack json-state-options\">\n            <switch label=\"Readonly\" :checked=\"settings.readOnly\" @change=\"settings.toggleReadOnly\" :data-json-readonly=\"settings.id\" />\n            <switch label=\"Disable the editor\" :checked=\"settings.disabled\" @change=\"settings.toggleDisabled\" :data-json-disabled=\"settings.id\" />\n            <switch label=\"Show editor\" :checked=\"settings.visible\" @change=\"settings.toggleVisible\" :data-json-visible=\"settings.id\" />\n            <div class=\"example-actions\">\n              <button @click=\"settings.nextMode\" :disabled=\"!settings.visible\" :data-json-mode=\"settings.id\">Change view mode</button>\n              <button @click=\"settings.replace\" :disabled=\"!settings.visible || settings.readOnly || settings.disabled\" :data-json-replace=\"settings.id\">Replace JSON</button>\n              <button @click=\"settings.refresh\" :data-json-refresh=\"settings.id\">Refresh example</button>\n            </div>\n            <p class=\"example-note\">Change view mode cycles through tree, text and table. Refresh keeps your draft. Reset restores the latest value supplied by this example.</p>\n          </div>\n        </details>\n      </if>\n      <toast :id=\u0027\"json-saved-\" + settings.id\u0027 :message=\"settings.notice\" :sequence=\"settings.noticeSequence\"\n             :tone=\"settings.noticeTone\" :data-catalog-json-toast=\"settings.id\" />\n    </div>\n  </island>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <div class="example-stack"><json-example id="reference" /><json-editor name="readonly-settings" label="Readonly settings" :value='"{\"enabled\": true}"' readOnly /><json-editor name="disabled-settings" label="Unavailable settings" disabled /><a class="catalog-link" href="/json">Working JSON variants and state examples</a></div>
    </reference-entry>
    <reference-entry name="source-view"
      :api='"content: String (required)\npath: String = \"\"\ncompact: Boolean = false\nbare: Boolean = false\nlanguage: String = \"\"\nlabel: String = \"File source\"\nline: Int = 0\nwrapped: Boolean = false\npreserveKey: String = \"\""'
      :contract='"Section receives additional attributes/classes and default toolbar action children. CodeMirror enhances escaped, focusable source markup into a read-only viewer. The application owns the content, requested line and surrounding layout."'
      :keyboard='"Read-only CodeMirror with escaped, focusable no-script source. Escape then Tab leaves the viewer. compact fixes a snippet height; bare removes the toolbar. The wrap action changes line layout. Source content is never executable markup."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --fg-1, --fg-3, --focus-width, --font-mono, --line, --source-active-line, --source-bg, --source-comment, --source-constant, --source-definition, --source-fg, --source-function, --source-gutter, --source-heading, --source-invalid, --source-keyword, --source-link, --source-name, --source-operator, --source-panel-bg, --source-search-match, --source-selection, --source-string, --source-type. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<source-view content=\u0027val title = \"Design library\"\u0027 path=\"example.kt\" label=\"Example Kotlin source\" compact><badge tone=\"info\">Kotlin</badge></source-view>\n\n<component tag=\"source-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <prop name=\"title\" type=\"String\" required />\n  <script server provides=\"source\" scope=\"server-session\">bosca.design.catalog.CatalogSource(id)</script>\n  <card :title=\"title\">\n    <island name=\"source\" :key=\"id\">\n      <div class=\"catalog-stack\" :data-catalog-source-owner=\"source.id\">\n        <if source.visible>\n          <div class=\"catalog-source-frame\">\n            <source-view :content=\"source.content\" path=\"components.ts\" label=\"Component preview\"\n                         :language=\u0027if (source.plain) \"text\" else \"\"\u0027 :line=\"source.line\" :wrapped=\"source.wrapped\"\n                         :preserveKey=\u0027\"source-\" + source.id + \"-\" + source.revision\u0027\n                         :data-catalog-source=\"source.id\">\n              <a class=\"catalog-link\" href=\"/components/content#ref-source-view\">Source API</a>\n            </source-view>\n          </div>\n        </if>\n        <details data-example-states>\n          <disclosure-heading>Example states</disclosure-heading>\n          <div class=\"catalog-stack source-state-options\">\n            <switch label=\"Wrap lines\" :checked=\"source.wrapped\" @change=\"source.toggleWrap\" :data-source-wrap=\"source.id\" />\n            <switch label=\"Plain text\" :checked=\"source.plain\" @change=\"source.togglePlainText\" :data-source-plain=\"source.id\" />\n            <switch label=\"Show viewer\" :checked=\"source.visible\" @change=\"source.toggleVisible\" :data-source-visible=\"source.id\" />\n            <div class=\"example-actions\">\n              <button @click=\"source.showLine\" :disabled=\"!source.visible || source.revision > 0\" :data-source-line=\"source.id\">Show line 40</button>\n              <button @click=\"source.replace\" :disabled=\"!source.visible\" :data-source-replace=\"source.id\">Replace source</button>\n              <button @click=\"source.refresh\" :data-source-refresh=\"source.id\">Refresh example</button>\n            </div>\n            <p class=\"example-note\">Refresh keeps your selection, scroll and local wrapping. Replacing the content starts a new viewer.</p>\n          </div>\n        </details>\n        <toast :id=\u0027\"source-refreshed-\" + source.id\u0027 :message=\u0027if (source.refreshes > 0) \"Example refreshed.\" else \"\"\u0027\n               :sequence=\"source.refreshes\" tone=\"info\" :data-source-toast=\"source.id\" />\n      </div>\n    </island>\n  </card>\n  <script client scoped>\n    import { retainDisclosure } from \"@client/catalog-disclosure\";\n    retainDisclosure(ctx);\n  </script>\n</component>\n"'>
      <div class="example-stack"><source-view content='val title = "Design library"' path="example.kt" label="Example Kotlin source" compact><badge tone="info">Kotlin</badge></source-view><a class="catalog-link" href="/source">Working source variants and state examples</a></div>
    </reference-entry>
  </catalog-document>
</page>
