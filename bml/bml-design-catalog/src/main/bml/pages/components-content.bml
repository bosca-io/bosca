<page route="/components/content">
  <catalog-document title="Content and editors" description="Tables, keyboard trees, comments and structured content." current="/components">
    <nav class="reference-jumps" aria-label="On this page">
      <a href="#ref-table-scroll">table-scroll</a>
      <a href="#ref-tree">tree</a>
      <a href="#ref-tree-item">tree-item</a>
      <a href="#ref-comment-editor">comment-editor</a>
      <a href="#ref-json-editor">json-editor</a>
      <a href="#ref-source-view">source-view</a>
    </nav>
    <reference-entry name="table-scroll"
      :api='"label: String = \"Scrollable table\""'
      :contract='"Focusable, labelled region with forwarded attributes/classes and default table children. Horizontal overflow stays inside the region; keyboard focus uses the accent color."'
      :keyboard='"Tab focuses the labelled scrolling region. Horizontal table overflow stays inside it; use native headers and captions for table semantics."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<table-scroll label=\"Component dimensions\"><table><caption>Regular and compact controls</caption><thead><tr><th scope=\"col\">Control</th><th scope=\"col\">Regular</th><th scope=\"col\">Compact</th><th scope=\"col\">Notes</th></tr></thead><tbody><tr><th scope=\"row\">Button</th><td>32px</td><td>30px</td><td>Extra-small buttons are 24px high</td></tr><tr><th scope=\"row\">Input</th><td>32px</td><td>30px</td><td>A deliberately long note that stays inside the labelled scrolling table region</td></tr></tbody></table></table-scroll>"'>
      <table-scroll label="Component dimensions"><table><caption>Regular and compact controls</caption><thead><tr><th scope="col">Control</th><th scope="col">Regular</th><th scope="col">Compact</th><th scope="col">Notes</th></tr></thead><tbody><tr><th scope="row">Button</th><td>32px</td><td>30px</td><td>Extra-small buttons are 24px high</td></tr><tr><th scope="row">Input</th><td>32px</td><td>30px</td><td>A deliberately long note that stays inside the labelled scrolling table region</td></tr></tbody></table></table-scroll>
    </reference-entry>
    <reference-entry name="tree"
      :api='"label: String (required)\nheading: String = \"\"\nlocal: Boolean = false\nembedded: Boolean = false\npreserveKey: String = \"\""'
      :contract='"Section receives additional attributes/classes and contains a labelled tree with default item children. local manages disclosure of already-rendered rows; otherwise caller actions own folder loading."'
      :keyboard='"Tab enters one visible row. Up/Down and Home/End move rows; Right opens or enters a directory, Left closes or moves to its parent. local toggles existing rows; server-loaded trees need caller actions. embedded removes the outer surface."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --fg-3. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<div class=\"example-stack\"><tree label=\"Example files\" heading=\"Files\" local embedded><tree-item path=\"src\" label=\"Source\" directory expanded /><tree-item path=\"src/main.kt\" label=\"main.kt\" href=\"#ref-source-view\" :depth=\"1\" selected /><tree-item path=\"docs\" label=\"Documents\" directory /><tree-item path=\"docs/guide.md\" label=\"A long guide filename that wraps on narrow screens\" href=\"#ref-comment-editor\" :depth=\"1\" wrap /></tree><tree label=\"Empty files\" embedded /></div>"'>
      <div class="example-stack"><tree label="Example files" heading="Files" local embedded><tree-item path="src" label="Source" directory expanded /><tree-item path="src/main.kt" label="main.kt" href="#ref-source-view" :depth="1" selected /><tree-item path="docs" label="Documents" directory /><tree-item path="docs/guide.md" label="A long guide filename that wraps on narrow screens" href="#ref-comment-editor" :depth="1" wrap /></tree><tree label="Empty files" embedded /></div>
    </reference-entry>
    <reference-entry name="tree-item"
      :api='"path: String (required)\nlabel: String (required)\nhref: String = \"\"\ndirectory: Boolean = false\nexpanded: Boolean = false\nselected: Boolean = false\ndepth: Int = 0\nwrap: Boolean = false"'
      :contract='"Flat ARIA tree item. Additional attributes/classes/actions target its native directory button or native file anchor. Paths identify hierarchy, depth controls indentation/ARIA level, and selected file links use aria-current=\"page\". No child content."'
      :keyboard='"Use flat rows inside tree, with consistent path hierarchy and depth. A directory button toggles disclosure; a file anchor follows its native href. wrap supports long labels; selected supplies aria-current on a file link."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-2, --fg-0, --fg-1, --fg-2, --focus-width. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<tree label=\"Example rows\" local embedded><tree-item path=\"examples\" label=\"Examples\" directory expanded /><tree-item path=\"examples/sample.bml\" label=\"sample.bml\" href=\"#ref-comment-editor\" :depth=\"1\" /></tree>"'>
      <tree label="Example rows" local embedded><tree-item path="examples" label="Examples" directory expanded /><tree-item path="examples/sample.bml" label="sample.bml" href="#ref-comment-editor" :depth="1" /></tree>
    </reference-entry>
    <reference-entry name="comment-editor"
      :api='"id: String (required)\nlabel: String (required)\nvalue: String = \"\"\nerror: String = \"\"\nsubmitDisabled: Boolean = false\nhint: String = \"\"\nsubmitLabel: String = \"comment\"\nplaceholder: String = \"Write a comment…\"\ndescribedBy: String = \"\"\nname: String = \"body\""'
      :contract='"Native required textarea receives additional attributes/classes, its ID and preservation key. Default children supply action controls. The caller owns its surrounding form, submission and error outcomes."'
      :keyboard='"Native required textarea. Ctrl+Enter or Command+Enter submits its surrounding form when allowed. Error drafts stay editable; the caller owns validation and projected buttons. Hint/error IDs are linked to the textarea."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --fg-0, --fg-2, --fg-3, --font-sans, --line, --r-md. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"comment-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"comment\" scope=\"server-session\">bosca.design.catalog.CatalogContent(id)</script>\n  <island name=\"comment\" :key=\"id\">\n    <form @submit=\"comment.comment(form.body)\" :data-catalog-comment=\"comment.id\">\n      <comment-editor :id=\u0027\"comment-\" + comment.id\u0027 label=\"Example comment\" :value=\"comment.value\" :error=\"comment.error\"\n                      hint=\"Use at least eight characters. Ctrl+Enter submits.\">\n        <button type=\"reset\" size=\"sm\">Reset draft</button><button type=\"submit\" primary>Post comment</button>\n      </comment-editor>\n    </form>\n    <toast :id=\u0027\"comment-posted-\" + comment.id\u0027 :message=\u0027if (comment.saves > 0) \"Comment posted.\" else \"\"\u0027\n           :sequence=\"comment.saves\" tone=\"success\" :data-catalog-comment-toast=\"comment.id\" />\n  </island>\n</component>"'>
      <div class="example-stack"><comment-example id="reference" /><comment-editor id="readonly-reference" label="Readonly example comment" value="This comment is readonly." readonly /><comment-editor id="disabled-reference" label="Unavailable example comment" disabled /></div>
    </reference-entry>
    <reference-entry name="json-editor"
      :api='"name: String (required)\nvalue: String = \"{}\"\nlabel: String = \"JSON editor\"\nmode: String = \"tree\"\nreadOnly: Boolean = false\ndisabled: Boolean = false\nerror: String = \"\"\npreserveKey: String = \"\""'
      :contract='"Structured editor with a native textarea form value and escaped no-script fallback. Additional attributes/classes target its labelled group. Syntax and caller feedback appear in a live status. No child content."'
      :keyboard='"The editor supplies keyboard editing and menus, with a native textarea form value. tree/text/table modes, readOnly and disabled are supported. Syntax and caller errors are announced. Without scripts the textarea remains editable."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --err, --fg-1, --font-mono, --font-sans, --json-accent, --json-bg, --json-boolean, --json-fg, --json-height, --json-key, --json-number, --json-panel-bg, --json-scheme, --json-selection, --json-string, --line, --r-md. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<component tag=\"json-example\">\n  <prop name=\"id\" type=\"String\" required />\n  <script server provides=\"settings\" scope=\"server-session\">bosca.design.catalog.CatalogContent(id, \"{\\\"enabled\\\": true, \\\"count\\\": 3}\")</script>\n  <island name=\"settings\" :key=\"id\">\n    <form @submit=\"settings.settings(form.settings)\" class=\"example-stack\" :data-catalog-json=\"settings.id\">\n      <json-editor name=\"settings\" label=\"Example settings\" :value=\"settings.value\" :error=\"settings.error\"\n                   :preserveKey=\u0027\"settings-\" + settings.id\u0027 />\n      <div class=\"example-actions\"><button type=\"submit\" primary>Save JSON</button><button type=\"reset\">Reset JSON</button></div>\n    </form>\n    <toast :id=\u0027\"json-saved-\" + settings.id\u0027 :message=\u0027if (settings.saves > 0) \"Settings saved.\" else \"\"\u0027\n           :sequence=\"settings.saves\" tone=\"success\" :data-catalog-json-toast=\"settings.id\" />\n  </island>\n</component>"'>
      <div class="example-stack"><json-example id="reference" /><json-editor name="readonly-settings" label="Readonly settings" :value='"{\"enabled\": true}"' readOnly /><json-editor name="disabled-settings" label="Unavailable settings" disabled /></div>
    </reference-entry>
    <reference-entry name="source-view"
      :api='"content: String (required)\npath: String = \"\"\ncompact: Boolean = false\nbare: Boolean = false\nlanguage: String = \"\"\nlabel: String = \"File source\"\nline: Int = 0\nwrapped: Boolean = false\npreserveKey: String = \"\""'
      :contract='"Section receives additional attributes/classes and default toolbar action children. CodeMirror enhances escaped, focusable source markup into a read-only viewer. The application owns the content, requested line and surrounding layout."'
      :keyboard='"Read-only CodeMirror with escaped, focusable no-script source. Escape then Tab leaves the viewer. compact fixes a snippet height; bare removes the toolbar. The wrap action changes line layout. Source content is never executable markup."'
      :css='"Palette and typography inherit from the consuming application. Component hooks: --accent, --bg-1, --fg-1, --fg-3, --focus-width, --font-mono, --line, --source-active-line, --source-bg, --source-comment, --source-constant, --source-definition, --source-fg, --source-function, --source-gutter, --source-heading, --source-invalid, --source-keyword, --source-link, --source-name, --source-operator, --source-panel-bg, --source-search-match, --source-selection, --source-string, --source-type. Forward an application class only through the documented native target; generated scope markers are private."'
      :snippet='"<source-view content=\u0027val title = \"Design library\"\u0027 path=\"example.kt\" label=\"Example Kotlin source\" compact><badge tone=\"info\">Kotlin</badge></source-view>"'>
      <source-view content='val title = "Design library"' path="example.kt" label="Example Kotlin source" compact><badge tone="info">Kotlin</badge></source-view>
    </reference-entry>
  </catalog-document>
</page>
