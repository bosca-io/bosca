  "sharedInfrastructure": {
    "http": "GraphQLClientFactory shares one OkHttp client/pool across per-caller clients and proxies. The default retains up to 50 idle connections for five minutes; active request dispatcher ceilings are unchanged.",
    "database": "ConnectionPool is bounded by factory.maxConnections; ConnectionManager borrows lazily and returns connections. Concurrent work added here is HTTP requests, not sibling JDBC operations on one request handle. Production pool contention has not been traced.",
    "optionalServices": "Localization has a TTL/stale cache and paginated catalogs; feature flags cache per render and expose evaluateAll. Authored production pages do not issue feature-flag calls on load.",
    "statistics": "Bounded process cache (4096 entries, 30-minute idle expiry) atomically coalesces history walks by repository, commit and shallow boundary set. Ref counts and pack size are always fresh; pushes and force pushes select the new key. Cached values contain only two counts."
  },
  "remainingOpportunities": [
    {
      "area": "Dependent page reads",
      "evidence": "Default-owner identity, commit-pinned content, PR snapshot/version checks and mode-specific orchestrator configuration still have result dependencies.",
      "next": "Further round-trip reduction would require snapshot-aware API fields that preserve these checks. The redundant selected-repository listing has been removed."
    }
  ],
  "measurementNotes": "Fixture timings include deliberate 50 ms upstream delay; production read-only baselines and catalog projection measurements are separate. This branch has not been deployed. Public-origin measurements include transport overhead from this workstation and use a fresh urllib connection per request. The catalog comparison executes both projections against the same deployed API. Full-screen geometry validation retains the reported 28 px / 30 px Import-button assertion disagreement.",
