{
  "name": "@bosca/bml",
  "version": "0.0.1",
  "description": "BML client island runtime: hydrate islands, lifecycle, partial replace, typed GraphQL + contract clients. Ships the esbuild bundler (tools/bundle.mjs) the io.bosca.bml Gradle plugin invokes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.8.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
