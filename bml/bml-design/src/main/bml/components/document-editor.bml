<component tag="document-editor">
  <prop name="id" type="String" required />
  <prop name="label" type="String" required />
  <prop name="name" type="String" default="document" />
  <prop name="value" type="kotlinx.serialization.json.JsonObject" :default="bosca.design.model.emptyDocument()" />
  <prop name="document" type="bosca.content.metadata.model.Document?" :default="null" />
  <script server provides="encodedValue">
    (document?.let { bosca.design.model.documentValue(it) } ?: value).toString()
  </script>
  <prop name="readOnly" type="Boolean" default="false" />
  <prop name="disabled" type="Boolean" default="false" />
  <prop name="required" type="Boolean" default="false" />
  <prop name="error" type="String" default="" />
  <prop name="hint" type="String" default="" />
  <prop name="placeholder" type="String" default="Start writing…" />
  <prop name="preserveKey" type="String" default="" />
  <div class="document-editor" data-bml-document-editor role="group" :aria-label="label"
       :data-bml-preserve="preserveKey.takeIf(String::isNotBlank)" :data-value="encodedValue" :data-name="name"
       :data-label="label" :data-readonly="readOnly" :data-disabled="disabled" :data-required="required"
       :data-error="error" :data-placeholder="placeholder" :data-editor-id="id" {...attrs}>
    <div ref="toolbar" class="document-toolbar" role="toolbar" :aria-label='label + " formatting"' hidden>
      <span class="document-select">
        <html:select ref="block" aria-label="Text style">
          <option value="paragraph">Paragraph</option>
          <option value="1">Heading 1</option><option value="2">Heading 2</option><option value="3">Heading 3</option>
          <option value="4">Heading 4</option><option value="5">Heading 5</option><option value="6">Heading 6</option>
        </html:select>
        <span class="document-select-chevron" aria-hidden="true"><icon name="chevron" :size="13" /></span>
      </span>
      <div class="document-command-group" role="group" aria-label="Text formatting">
        <icon-button size="xs" icon="bold" label="Bold" data-document-command="bold" aria-pressed="false" />
        <icon-button size="xs" icon="italic" label="Italic" data-document-command="italic" aria-pressed="false" />
        <icon-button size="xs" icon="underline" label="Underline" data-document-command="underline" aria-pressed="false" />
        <icon-button size="xs" icon="strikethrough" label="Strike" data-document-command="strike" aria-pressed="false" />
        <icon-button size="xs" icon="code" label="Code" data-document-command="code" aria-pressed="false" />
      </div>
      <div class="document-command-group" role="group" aria-label="Lists and blocks">
        <icon-button size="xs" icon="list" label="Bullets" data-document-command="bulletList" aria-pressed="false" />
        <icon-button size="xs" icon="list-ordered" label="Numbers" data-document-command="orderedList" aria-pressed="false" />
        <icon-button size="xs" icon="list-check" label="Tasks" data-document-command="taskList" aria-pressed="false" />
        <icon-button size="xs" icon="quote" label="Quote" data-document-command="blockquote" aria-pressed="false" />
        <icon-button size="xs" icon="code-block" label="Code block" data-document-command="codeBlock" aria-pressed="false" />
      </div>
      <div class="document-command-group" role="group" aria-label="Insert content">
        <icon-button size="xs" icon="link" label="Link" data-document-command="link" aria-pressed="false" />
        <icon-button size="xs" icon="image" label="Image" data-document-command="image" />
        <icon-button size="xs" icon="table" label="Table" data-document-command="table" />
        <icon-button size="xs" icon="minus" label="Divider" data-document-command="horizontalRule" />
      </div>
      <div class="document-command-group" role="group" aria-label="Additional formatting">
        <icon-button size="xs" icon="superscript" label="Superscript" data-document-command="superscript" aria-pressed="false" />
        <icon-button size="xs" icon="subscript" label="Subscript" data-document-command="subscript" aria-pressed="false" />
        <span class="document-select">
          <html:select ref="alignment" aria-label="Text alignment">
            <option value="left">Align left</option><option value="center">Center</option>
            <option value="right">Align right</option><option value="justify">Justify</option>
          </html:select>
          <span class="document-select-chevron" aria-hidden="true"><icon name="chevron" :size="13" /></span>
        </span>
        <icon-button size="xs" icon="undo" label="Undo" data-document-command="undo" />
        <icon-button size="xs" icon="redo" label="Redo" data-document-command="redo" />
      </div>
      <div ref="tableActions" class="document-command-group" role="group" aria-label="Table editing" hidden>
        <icon-button size="xs" icon="row-add" label="Add row" data-document-command="addRowAfter" />
        <icon-button size="xs" icon="column-add" label="Add column" data-document-command="addColumnAfter" />
        <icon-button size="xs" icon="row-delete" label="Delete row" data-document-command="deleteRow" />
        <icon-button size="xs" icon="column-delete" label="Delete column" data-document-command="deleteColumn" />
        <icon-button size="xs" icon="table-header" label="Header row" data-document-command="toggleHeaderRow" />
        <icon-button size="xs" icon="cells-merge" label="Merge cells" data-document-command="mergeCells" />
        <icon-button size="xs" icon="cells-split" label="Split cell" data-document-command="splitCell" />
        <icon-button size="xs" icon="table-delete" label="Delete table" data-document-command="deleteTable" />
      </div>
    </div>
    <div ref="insert" class="document-insert" role="group" aria-label="Insert link or image" hidden>
      <label>URL <input ref="url" inputmode="url" placeholder="https://example.com or /page" /></label>
      <label ref="altLabel" hidden>Image description <input ref="alt" /></label>
      <div class="document-command-group">
        <button size="sm" ref="apply">Apply</button><button size="sm" ref="removeLink">Remove link</button>
        <button size="sm" ref="cancelInsert">Cancel</button>
      </div>
    </div>
    <textarea ref="value" :id="id" :name="name" :aria-label="label" :readonly="readOnly" :disabled="disabled"
              :aria-describedby='id + "-hint " + id + "-error"' spellcheck="false">{ encodedValue }</textarea>
    <div ref="editor" class="document-surface" />
    <small :id='id + "-hint"' :hidden="hint.isBlank()">{ hint }</small>
    <p ref="feedback" :id='id + "-error"' role="status" aria-live="polite" :hidden="error.isBlank()">{ error }</p>
  </div>
  <style scoped>
    .document-editor { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .document-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
    .document-command-group { display: flex; flex-wrap: nowrap; align-items: center; gap: 3px; }
    .document-toolbar[hidden], .document-command-group[hidden], .document-insert[hidden], [hidden] { display: none; }
    .document-select { position: relative; display: inline-flex; min-width: 0; max-width: 100%; }
    .document-toolbar select { box-sizing: border-box; width: 100%; max-width: 100%; height: var(--control-height-xs); padding: 0 32px 0 8px; appearance: none; -webkit-appearance: none; border: 1px solid var(--control-border, var(--line-2)); border-radius: var(--r-sm); background: var(--control-bg, var(--bg-2)); color: var(--fg-0); font: 12px/1.5 var(--font-sans); }
    .document-select-chevron { position: absolute; top: 50%; right: 11px; transform: translateY(-50%); display: flex; color: var(--fg-4); pointer-events: none; }
    select:disabled + .document-select-chevron { opacity: 0.35; }
    .document-toolbar select:focus-visible { outline: var(--focus-width) solid var(--accent); outline-offset: 2px; }
    .document-insert { display: flex; flex-direction: column; gap: 12px; padding: 12px; border: 1px solid var(--line); border-radius: var(--r-sm); background: var(--bg-2); }
    .document-insert label { display: flex; flex-direction: column; gap: 6px; font: 12px/1.5 var(--font-sans); }
    .document-surface:empty { display: none; }
    textarea { box-sizing: border-box; width: 100%; min-height: var(--document-height, 320px); padding: 16px; border: 1px solid var(--control-border, var(--line)); border-radius: var(--r-md); background: var(--bg-1); color: var(--fg-1); font: 13px/1.7 var(--font-mono); resize: vertical; }
    textarea:focus-visible { outline: 1px solid var(--accent); }
    small { color: var(--fg-2); font: 12px/18px var(--font-sans); }
    p { margin: 0; color: var(--err); font: 12px/18px var(--font-sans); }
  </style>
  <script client scoped>
    import { mountDocumentEditor } from "@client/helpers/document-editor";
    mountDocumentEditor(ctx);
  </script>
</component>
