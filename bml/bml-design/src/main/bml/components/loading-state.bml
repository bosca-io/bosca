<component tag="loading-state">
  <prop name="label" type="String" default="Loading…" />
  <prop name="compact" type="Boolean" default="false" />
  <prop name="ref" type="String" default="" />
  <div
    :class='"loading-state" + if (compact) " compact" else ""'
    :ref="ref.takeIf(String::isNotBlank)"
    role="status"
    {...attrs}
  >
    <spinner />
    <span>{ label }</span>
  </div>
  <style scoped>
    .loading-state {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      min-width: 0;
      padding: 28px 20px;
      color: var(--fg-3);
      font-size: 12.5px;
      line-height: normal;
    }
    .compact {
      justify-content: flex-start;
      padding: 8px 0;
    }
  </style>
</component>
