<component tag="dialog">
  <prop name="triggerIconOnly" type="Boolean" default="false" />
  <prop name="triggerDisabled" type="Boolean" default="false" />
  <prop name="showTrigger" type="Boolean" default="true" />
  <prop name="returnFocus" type="String" default="" />
  <prop name="subtitle" type="String" default="" />
  <prop name="size" type="String" default="md" />
  <prop name="title" type="String" required />
  <prop name="triggerLabel" type="String" required />
  <prop name="triggerIcon" type="String" default="" />
  <prop name="icon" type="String" default="" />
  <prop name="primary" type="Boolean" default="false" />
  <prop name="triggerStyle" type="String" default="button" />
  <prop name="forceOpen" type="Boolean" default="false" />
  <prop name="openRequest" type="String" default="" />
  <prop name="completed" type="Boolean" default="false" />
  <div
    :class='"dialog-control" + if (showTrigger) "" else " programmatic-dialog"'
    :data-force-open="forceOpen"
    :data-open-request="openRequest.takeIf(String::isNotBlank)"
    :data-completed="completed"
    :data-return-focus="returnFocus"
    data-bml-design-dialog
    {...attrs}
  >
    <if showTrigger>
      <if triggerIconOnly>
        <icon-button
          ref="trigger"
          :icon="triggerIcon.ifBlank { icon }"
          :label="triggerLabel"
          :disabled="triggerDisabled"
          :size='if (triggerStyle == "ghost") "xs" else "sm"'
          :class='if (triggerStyle == "ghost") "ghost" else ""'
        />
      <else-if triggerStyle == "link">
        <html:button type="button" class="link-trigger" ref="trigger" :disabled="triggerDisabled">
          <span class="link-trigger-icon"><icon :name='triggerIcon.ifBlank { "plus" }' :size="12" /></span>
          { triggerLabel }
        </html:button>
      <else>
        <button
          size="sm"
          ref="trigger"
          :class='if (triggerStyle == "block") "block" else ""'
          :primary="primary"
          :icon='if (triggerStyle == "block" || triggerStyle == "plain") triggerIcon else triggerIcon.ifBlank { icon }'
          :disabled="triggerDisabled"
        >
          { triggerLabel }
        </button>
      </if>
    </if>
    <html:dialog data-bml-design-dialog-panel :class='"dialog size-" + size' ref="dialog" :aria-label="title">
      <div class="dialog-content">
        <header class="dialog-header">
          <div class="dialog-heading">
            <h2>
              <if icon.isNotBlank()>
                <span class="dialog-icon">
                  <icon :name="icon" />
                </span>
              </if>
              { title }
            </h2>
            <if subtitle.isNotBlank()>
              <p class="dialog-subtitle">{ subtitle }</p>
            </if>
          </div>
          <icon-button ref="close" label="Close dialog" icon="close" />
        </header>
        <slot />
      </div>
    </html:dialog>
  </div>
  <style scoped>
    .programmatic-dialog {
      display: contents;
    }
    .link-trigger {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 0 0;
      border: 0;
      background: none;
      color: var(--accent);
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
    }
    .link-trigger:hover {
      text-decoration: underline;
    }
    .link-trigger:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .link-trigger-icon {
      display: inline-flex;
    }
    dialog.size-lg {
      width: 760px;
    }
    dialog.size-sm {
      width: 400px;
    }
    .dialog-subtitle {
      margin: 4px 0 0;
      color: var(--fg-3);
      font-size: 11.5px;
    }
    .dialog-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 9px;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 16%, var(--bg-2));
      border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    }
    dialog {
      box-sizing: border-box;
      font-family: var(--font-sans);
      width: 520px;
      max-width: calc(100vw - 32px);
      max-height: min(90dvh, calc(100dvh - 40px));
      padding: 0;
      color: var(--fg-1);
      background: var(--bg-1);
      border: 1px solid var(--line-2);
      border-radius: var(--r-lg);
      box-shadow: var(--dialog-shadow, 0 30px 100px #0008);
    }
    dialog::backdrop {
      background: var(--dialog-backdrop, #0009);
      backdrop-filter: blur(4px);
    }
    .dialog-content {
      display: flex;
      flex-direction: column;
      min-height: 0;
      max-height: calc(min(90dvh, 100dvh - 40px) - 2px);
    }
    .dialog-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      flex: none;
    }
    h2 {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      font-size: 15px;
      font-weight: 600;
    }
  </style>
  <script client scoped>
    import { modalDialog } from "@client/helpers/dialog";
    modalDialog(ctx);
  </script>
</component>
