<component tag="segmented-control">
  <prop name="label" type="String" required />
  <prop name="name" type="String" required />
  <prop name="options" type="List<String>" required />
  <prop name="values" type="List<String>" default="emptyList()" />
  <prop name="icons" type="List<String>" default="emptyList()" />
  <prop name="value" type="String" required />
  <prop name="preserveKey" type="String" default="" />
  <div
    class="segmented-control"
    :data-value="value"
    :data-name="name"
    {...attrs}
    role="radiogroup"
    :aria-label="label"
    :data-bml-preserve="preserveKey.takeIf(String::isNotBlank)"
  >
    <html:input ref="value" type="hidden" :name="name" :value="value" />
    <for index in options.indices>
      <html:button
        type="button"
        role="radio"
        :data-value="(values.getOrNull(index) ?: options[index])"
        :aria-checked="((values.getOrNull(index) ?: options[index]) == value).toString()"
        :tabindex="if ((values.getOrNull(index) ?: options[index]) == value) 0 else -1"
      >
        <if icons.getOrNull(index).orEmpty().isNotBlank()>
          <icon :name="icons[index]" :size="12" />
        </if>
        { options[index] }
      </html:button>
    </for>
  </div>
  <style scoped>
    .segmented-control {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: auto;
      display: inline-flex;
      gap: 2px;
      min-height: 30px;
      align-items: center;
      padding: 2px;
      border: 1px solid var(--control-border, var(--line));
      border-radius: 7px;
      background: var(--bg-0);
    }
    button {
      box-sizing: border-box;
      flex: none;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 24px;
      padding: 0 10px;
      border: 0;
      border-radius: 4px;
      color: var(--fg-2);
      background: transparent;
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      line-height: normal;
      cursor: pointer;
    }
    button:hover {
      background: var(--bg-2);
    }
    button[aria-checked="true"] {
      background: var(--bg-3);
      color: var(--fg-0);
    }
    button:focus-visible {
      outline: var(--focus-width) solid var(--accent);
      outline-offset: -2px;
    }
  </style>
  <script client scoped>
    import { segmentedControl } from "@client/helpers/segmented-control";
    segmentedControl(ctx);
  </script>
</component>
