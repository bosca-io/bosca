<component tag="segmented-control">
  <prop name="label" type="String" required />
  <prop name="name" type="String" required />
  <prop name="options" type="List<bosca.design.model.SegmentOption>" required />
  <prop name="value" type="String" required />
  <prop name="preserveKey" type="String" default="" />
  <script server provides="optionMetadata">
    kotlinx.serialization.json.Json.encodeToString(kotlinx.serialization.builtins.ListSerializer(bosca.design.model.SegmentOption.serializer()), options)
  </script>
  <div
    class="segmented-control"
    :data-value="value"
    :data-name="name"
    :data-options="optionMetadata"
    {...attrs}
    role="radiogroup"
    :aria-label="label"
    :data-bml-preserve="preserveKey.takeIf(String::isNotBlank)"
  >
    <html:input ref="value" type="hidden" :name="name" :value="value" />
    <for option in options>
      <html:button
        type="button"
        role="radio"
        :data-value="option.value"
        :disabled="option.disabled"
        :aria-checked="(option.value == value).toString()"
        :tabindex="if (!option.disabled && option.value == value) 0 else -1"
      >
        <if option.icon.isNotBlank()>
          <icon :name="option.icon" :size="12" />
        </if>
        <span data-option-label>{ option.label }</span>
      </html:button>
    </for>
  </div>
  <style scoped>
    .segmented-control:not(:has([role="radio"])),
    .segmented-control[hidden] {
      display: none;
    }
    .segmented-control {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: auto;
      display: inline-flex;
      gap: 2px;
      min-height: 30px;
      align-items: center;
      padding: 2px;
      border: 1px solid var(--control-border, var(--line));
      border-radius: 7px;
      background: var(--bg-0);
    }
    button {
      box-sizing: border-box;
      flex: none;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 24px;
      padding: 0 10px;
      border: 0;
      border-radius: 4px;
      color: var(--fg-2);
      background: transparent;
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      line-height: normal;
      cursor: pointer;
    }
    button:hover {
      background: var(--bg-2);
    }
    button:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    button[aria-checked="true"] {
      background: var(--bg-3);
      color: var(--fg-0);
    }
    button:focus-visible {
      outline: var(--focus-width) solid var(--accent);
      outline-offset: -2px;
    }
  </style>
  <script client scoped>
    import { segmentedControl } from "@client/helpers/segmented-control";
    segmentedControl(ctx);
  </script>
</component>
