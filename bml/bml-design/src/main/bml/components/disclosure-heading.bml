<component tag="disclosure-heading">
  <prop name="framed" type="Boolean" default="false" />
  <summary class="disclosure-heading" :data-framed="framed" {...attrs}>
    <span class="disclosure-chevron">
      <icon name="chevron" :size="12" />
    </span>
    <span class="disclosure-label">
      <slot />
    </span>
  </summary>
  <style scoped>
    summary[data-framed] {
      padding: 12px 14px;
      background: var(--bg-1);
      border-bottom: 1px solid var(--line);
    }
    summary {
      display: flex;
      align-items: center;
      gap: 8px;
      list-style: none;
      cursor: pointer;
      color: var(--fg-2);
      font-size: 12.5px;
      font-weight: 500;
      padding: 10px 0;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary:hover {
      color: var(--fg-0);
    }
    summary:focus-visible {
      outline: var(--focus-width) solid var(--accent);
      outline-offset: 2px;
      border-radius: 6px;
    }
    .disclosure-chevron {
      display: flex;
      transform: rotate(-90deg);
    }
    details[open] > .disclosure-heading > .disclosure-chevron {
      transform: rotate(0deg);
    }
    .disclosure-label {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }
  </style>
</component>
