<component tag="empty-state">
  <prop name="message" type="String" default="" />
  <prop name="title" type="String" default="" />
  <prop name="icon" type="String" default="folder" />
  <div class="empty-state" {...attrs}>
    <span class="empty-icon">
      <icon :name="icon" :size="24" />
    </span>
    <if title.isNotBlank()>
      <h3>{ title }</h3>
    </if>
    <if message.isNotBlank()>
      <p>{ message }</p>
    </if>
    <div class="empty-actions">
      <slot />
    </div>
  </div>
  <style scoped>
    .empty-state {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 44px 24px;
      text-align: center;
    }
    .empty-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--fg-3);
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      margin-bottom: 4px;
    }
    h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
    }
    p {
      max-width: 420px;
      margin: 0;
      color: var(--fg-3);
      font-size: 12.5px;
      line-height: 1.6;
    }
    .empty-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 6px;
    }
    .empty-actions:empty {
      display: none;
    }
  </style>
</component>
