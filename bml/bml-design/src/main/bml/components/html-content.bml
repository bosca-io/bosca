<component tag="html-content">
  <prop name="html" type="String" required />
  <prop name="padded" type="Boolean" default="false" />
  <article :class='"html-content" + if (padded) " padded" else ""' data-bml-html-content {...attrs}>{@ html }</article>
  <style scoped>
    .html-content { box-sizing: border-box; width: 100%; min-width: 0; margin: 0; line-height: 1.6; overflow-wrap: anywhere; }
    .html-content.padded { padding: 24px 28px 32px; }
    @media (max-width: 700px) { .html-content.padded { padding: 18px 16px 24px; } }
  </style>
  <script client scoped>
    import "@client/helpers/html-content.css";
    const failed = (image: HTMLImageElement) => {
      if (image.dataset.failed) return;
      image.dataset.failed = "true";
      const fallback = document.createElement("span");
      fallback.className = "image-error";
      fallback.setAttribute("role", "status");
      fallback.textContent = "Image unavailable" + (image.alt ? ": " + image.alt : "");
      image.hidden = true;
      image.after(fallback);
    };
    ctx.on<Event>(ctx.root, "error", event => {
      if (event.target instanceof HTMLImageElement) failed(event.target);
    }, true);
    for (const image of ctx.root.querySelectorAll<HTMLImageElement>("img"))
      if (image.complete && image.naturalWidth === 0) failed(image);
  </script>
</component>
