<component tag="tree-item">
  <prop name="path" type="String" required />
  <prop name="label" type="String" required />
  <prop name="href" type="String" default="" />
  <prop name="directory" type="Boolean" default="false" />
  <prop name="expanded" type="Boolean" default="false" />
  <prop name="selected" type="Boolean" default="false" />
  <prop name="depth" type="Int" default="0" />
  <prop name="wrap" type="Boolean" default="false" />
  <div
    :class='"ui-tree-item depth-" + depth.coerceIn(0, 12) + if (wrap) " wrap" else ""'
    role="treeitem"
    :aria-level="depth.coerceAtLeast(0) + 1"
    :aria-expanded='if (directory) expanded.toString() else null'
    :aria-selected="selected.toString()"
    :data-path="path"
    :data-expanded="expanded"
  >
    <if directory>
      <html:button
        class="ui-tree-row"
        type="button"
        tabindex="-1"
        :aria-label='(if (expanded) "Collapse " else "Expand ") + label'
        :title="path"
        {...attrs}
      >
        <span class="tree-chevron">
          <icon name="chevron" :size="11" />
        </span>
        <span class="folder-closed">
          <icon name="folder" :size="13" />
        </span>
        <span class="folder-open">
          <icon name="folder-open" :size="13" />
        </span>
        <span class="tree-label">{ label }</span>
      </html:button>
    <else>
      <a
        class="ui-tree-row"
        tabindex="-1"
        :href="href"
        :title="path"
        :aria-label="path"
        :aria-current='if (selected) "page" else null'
        {...attrs}
      >
        <span class="tree-spacer" aria-hidden="true"></span>
        <span class="tree-file-icon"><icon name="file" :size="13" /></span>
        <span class="tree-label">{ label }</span>
      </a>
    </if>
  </div>
  <style scoped>
    .ui-tree-item {
      margin: 0;
      padding: 0;
      min-width: 0;
      list-style: none;
    }
    .ui-tree-row {
      box-sizing: border-box;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      min-height: 30px;
      min-width: 0;
      padding: 6px;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: var(--fg-2);
      text-align: left;
      font: inherit;
      font-size: 12px;
      line-height: normal;
      cursor: pointer;
    }
    .ui-tree-row:hover {
      background: var(--bg-2);
      color: var(--fg-1);
    }
    .ui-tree-row:focus-visible {
      outline: var(--focus-width) solid var(--accent);
      outline-offset: -2px;
    }
    .ui-tree-item[aria-selected="true"] .ui-tree-row {
      background: color-mix(in oklch, var(--accent) 10%, transparent);
      color: var(--fg-0);
    }
    .tree-label {
      min-width: 0;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* Wrapped labels keep long names readable instead of truncating them. */
    .wrap .ui-tree-row {
      align-items: flex-start;
    }
    .wrap .tree-label {
      white-space: normal;
      overflow-wrap: anywhere;
      line-height: 16px;
    }
    .wrap .tree-file-icon,
    .wrap .tree-chevron,
    .wrap .folder-open,
    .wrap .folder-closed {
      margin-top: 1.5px;
    }
    .tree-chevron {
      display: flex;
      width: 11px;
      flex: none;
    }
    .tree-spacer {
      width: 11px;
      flex: none;
    }
    .folder-open,
    .folder-closed,
    .tree-file-icon {
      display: flex;
      flex: none;
    }
    .ui-tree-item[aria-expanded="false"] .tree-chevron {
      transform: rotate(-90deg);
    }
    .ui-tree-item[aria-expanded="false"] .folder-open,
    .ui-tree-item[aria-expanded="true"] .folder-closed {
      display: none;
    }
    .depth-1 .ui-tree-row {
      padding-inline-start: 20px;
    }
    .depth-2 .ui-tree-row {
      padding-inline-start: 34px;
    }
    .depth-3 .ui-tree-row {
      padding-inline-start: 48px;
    }
    .depth-4 .ui-tree-row {
      padding-inline-start: 62px;
    }
    .depth-5 .ui-tree-row {
      padding-inline-start: 76px;
    }
    .depth-6 .ui-tree-row {
      padding-inline-start: 90px;
    }
    .depth-7 .ui-tree-row {
      padding-inline-start: 104px;
    }
    .depth-8 .ui-tree-row {
      padding-inline-start: 118px;
    }
    .depth-9 .ui-tree-row {
      padding-inline-start: 132px;
    }
    .depth-10 .ui-tree-row {
      padding-inline-start: 146px;
    }
    .depth-11 .ui-tree-row {
      padding-inline-start: 160px;
    }
    .depth-12 .ui-tree-row {
      padding-inline-start: 174px;
    }
  </style>
</component>
