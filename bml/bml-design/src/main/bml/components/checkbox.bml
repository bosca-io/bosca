<component tag="checkbox">
  <prop name="label" type="String" required />
  <prop name="description" type="String" default="" />
  <prop name="checked" type="Boolean" default="false" />
  <label class="checkbox-row">
    <html:input type="checkbox" :checked="checked" {...attrs} />
    <span>
      <strong>{ label }</strong>
      <if description.isNotBlank()>
        <small>{ description }</small>
      </if>
    </span>
  </label>
  <style scoped>
    .checkbox-row {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      cursor: pointer;
    }
    input {
      accent-color: var(--accent);
      width: 14px;
      height: 14px;
      margin: 3px 0 0;
      flex: none;
    }
    input:focus-visible {
      outline: var(--focus-width) solid var(--accent);
      outline-offset: var(--focus-offset);
    }
    strong {
      display: block;
      font-size: 12.5px;
      font-weight: 500;
      line-height: 20px;
    }
    small {
      display: block;
      color: var(--fg-3);
      font-size: 11.5px;
      line-height: 1.5;
      margin-top: 2px;
    }
  </style>
</component>
