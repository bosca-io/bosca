<component tag="board-column">
  <prop name="columnId" type="String" required />
  <prop name="label" type="String" required />
  <prop name="summary" type="String" default="" />
  <prop name="scrollKey" type="String" required />
  <div class="board-column" :data-board-column="columnId" role="group" :aria-label="label" {...attrs}>
    <header><h2>{ label }</h2><if summary.isNotBlank()><span>{ summary }</span></if></header>
    <div class="board-items" data-board-column-items :data-bml-scroll='"board-column-" + scrollKey'><slot /></div>
  </div>
  <style scoped>
    .board-column { display: flex; flex-direction: column; min-width: 0; min-height: 0; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--board-column-bg, var(--bg-1)); }
    header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; padding: 14px; border-bottom: 1px solid var(--line); }
    h2 { margin: 0; overflow-wrap: anywhere; font: 600 13px/1.5 var(--font-sans); color: var(--fg-1); }
    header span { font: 12px/1.5 var(--font-sans); color: var(--fg-3); }
    .board-items { display: flex; flex-direction: column; flex: 1; min-height: 0; gap: 12px; padding: 12px; overflow: auto; overscroll-behavior: contain; }
    .board-column[data-board-drop=allowed] { outline: 2px solid var(--accent); outline-offset: -2px; }
    .board-column[data-board-drop=blocked] { outline: 2px solid var(--err); outline-offset: -2px; }
  </style>
</component>
