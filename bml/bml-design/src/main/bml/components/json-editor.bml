<component tag="json-editor">
  <prop name="name" type="String" required />
  <prop name="value" type="String" :default='"{}"' />
  <prop name="label" type="String" default="JSON editor" />
  <prop name="mode" type="String" default="tree" />
  <prop name="readOnly" type="Boolean" default="false" />
  <prop name="disabled" type="Boolean" default="false" />
  <prop name="error" type="String" default="" />
  <prop name="preserveKey" type="String" default="" />
  <div class="json-editor" data-bml-json-editor role="group" :aria-label="label"
       :data-bml-preserve="preserveKey" :data-value="value" :data-mode="mode"
       :data-label="label" :data-name="name" :data-readonly="readOnly" :data-disabled="disabled" :data-error="error" {...attrs}>
    <textarea ref="value" :name="name" :aria-label="label" :readonly="readOnly" :disabled="disabled" spellcheck="false">{ value }</textarea>
    <div ref="editor" class="json-surface" />
    <p ref="feedback" role="status" aria-live="polite" :hidden="error.isBlank()">{ error }</p>
  </div>
  <style scoped>
    .json-editor { min-width: 0; }
    .json-surface { min-width: 0; min-height: 240px; height: var(--json-height, 320px); }
    .json-surface:empty { display: none; }
    textarea {
      box-sizing: border-box;
      display: block;
      width: 100%;
      min-height: 240px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--bg-1);
      color: var(--fg-1);
      font: 13px/1.7 var(--font-mono);
      resize: vertical;
    }
    textarea[hidden] { display: none; }
    textarea:focus-visible { outline: 1px solid var(--accent); }
    p { margin: 8px 0 0; color: var(--err); font: 12px/18px var(--font-sans); }
    p[hidden] { display: none; }
  </style>
  <script client scoped>
    import { mountJsonEditor } from "@client/helpers/json-editor";
    mountJsonEditor(ctx);
  </script>
</component>
