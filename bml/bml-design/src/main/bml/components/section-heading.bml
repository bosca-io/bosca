<component tag="section-heading">
  <prop name="title" type="String" required />
  <prop name="subtitle" type="String" default="" />
  <header class="section-heading" {...attrs}>
    <div class="heading-text">
      <h2>{ title }</h2>
      <if subtitle.isNotBlank()>
        <p>{ subtitle }</p>
      </if>
    </div>
    <div class="heading-actions">
      <slot />
    </div>
  </header>
  <style scoped>
    /* Studio SectionCard header: title with an inline subtitle and right-aligned actions. */
    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--line);
    }
    .heading-text {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 2px 12px;
      min-width: 0;
    }
    h2 {
      margin: 0;
      min-width: 0;
      overflow-wrap: anywhere;
      font-size: 13px;
      font-weight: 600;
    }
    p {
      margin: 0;
      min-width: 0;
      overflow-wrap: anywhere;
      color: var(--fg-2);
      font-size: 12px;
    }
    .heading-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      flex-shrink: 0;
    }
    .heading-actions:empty {
      display: none;
    }
    @media (max-width: 600px) {
      .section-heading {
        align-items: flex-start;
        flex-wrap: wrap;
      }
      .heading-actions {
        justify-content: flex-start;
      }
    }
  </style>
</component>
