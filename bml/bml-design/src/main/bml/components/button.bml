<component tag="button">
  <prop name="size" type="String" default="md" />
  <prop name="loading" type="Boolean" default="false" />
  <prop name="type" type="String" default="button" />
  <prop name="ref" type="String" default="" />
  <prop name="primary" type="Boolean" default="false" />
  <prop name="icon" type="String" default="" />
  <prop name="disabled" type="Boolean" default="false" />
  <html:button
    :class='"button size-" + size + (if (primary) " primary" else "")'
    :type="type"
    :ref="ref.takeIf(String::isNotBlank)"
    :disabled="disabled || loading"
    :aria-busy="loading.toString()"
    {...attrs}
  >
    <span class="button-content">
      <if icon.isNotBlank()>
        <span class="button-icon"><icon :name="icon" :size='if (size == "xs") 12 else 14' :strokeWidth="2.0" /></span>
      </if>
      <slot />
    </span>
    <span class="button-progress" aria-hidden="true">
      <spinner :size='if (size == "xs") "xs" else "sm"' />
    </span>
  </html:button>
  <style scoped>
    .button.size-xs {
      padding: 0 8px;
      font-size: 12px;
      height: 24px;
    }
    .button.size-md {
      padding: 0 14px;
      font-size: 13px;
      height: 32px;
    }
    .button.size-sm:not(.icon-only) {
      padding: 0 10px;
      font-size: 12.5px;
      height: 30px;
      line-height: normal;
    }
    .button-content {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-width: 0;
    }
    .button-icon {
      display: inline-flex;
      color: var(--fg-2);
    }
    .button.primary .button-icon {
      color: var(--accent);
    }
    .button-progress {
      display: none;
      position: absolute;
      inset: 0;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }
    .button[aria-busy="true"] .button-content {
      opacity: 0;
    }
    .button[aria-busy="true"] .button-progress {
      display: flex;
    }
    .button[aria-busy="true"],
    .button[aria-busy="true"]:disabled {
      opacity: 1;
      cursor: progress;
    }
    .button {
      box-sizing: border-box;
      position: relative;
      font: inherit;
      color: var(--fg-1);
      background: var(--control-bg);
      border: 1px solid var(--line-2);
      border-radius: var(--control-radius);
      padding: 0 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 12.5px;
      font-weight: 500;
      line-height: normal;
      height: 30px;
      white-space: nowrap;
      cursor: pointer;
    }
    .button:hover:not(:disabled) {
      background: var(--bg-3);
    }
    .button.primary {
      border-color: color-mix(in srgb, var(--accent) 60%, transparent);
      font-weight: 550;
      color: var(--fg-0);
    }
    .button.danger {
      color: var(--err);
      border-color: color-mix(in srgb, var(--err) 40%, var(--line));
    }
    .button.ghost {
      background: transparent;
      border-color: transparent;
    }
    .button.ghost:hover:not(:disabled) {
      background: var(--bg-3);
    }
    .button.icon-only.size-xs.ghost {
      border-radius: 4px;
    }
    .button.block {
      width: 100%;
      justify-content: flex-start;
    }
    .button.icon-only {
      width: 30px;
      height: 30px;
      padding: 0;
      flex: none;
    }
    .button.icon-only.size-xs {
      width: 24px;
      height: 24px;
    }
    .button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    form[data-bml-action-pending] button[type="submit"].button .button-content {
      opacity: 0;
    }
    form[data-bml-action-pending] button[type="submit"].button .button-progress {
      display: flex;
    }
    form[data-bml-action-pending] button[type="submit"].button {
      cursor: progress;
    }
    .button:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
  </style>
</component>
