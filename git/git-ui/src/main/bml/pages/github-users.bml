<page route="/settings/github" requireAuth>
  <script server provides="model">
    bosca.git.ui.gitHubUsersPage()
  </script>
  <git-layout title="GitHub user mappings">
    <page-shell>
      <page-heading
        title="GitHub User Mappings"
        subtitle="Map GitHub users to Bosca principals"
        :trail='listOf(bosca.design.model.NavigationItem("Git", "", false), bosca.design.model.NavigationItem("Settings", "", false))'
      />
      <if model.allowed>
        <git-github-users :initial="model" />
      <else>
        <alert>Administrator access is required.</alert>
      </if>
    </page-shell>
  </git-layout>
</page>
