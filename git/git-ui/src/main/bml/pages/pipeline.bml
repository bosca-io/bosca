<page route="/pipelines/{id}" requireAuth>
  <script server provides="model">
    bosca.git.ui.pipelineRunPage()
  </script>
  <if model != null>
    <git-layout :title="model.title">
      <page-shell>
        <git-pipeline-run :initial="model" />
      </page-shell>
    </git-layout>
  </if>
</page>
