<page route="/repositories/{id}/secrets" requireAuth>
  <script server provides="page">
    bosca.git.ui.repositorySecretsPage()
  </script>
  <if page != null>
    <git-layout :title='page.name + " secrets"'>
      <ui-page>
        <ui-page-heading
          :title='page.name'
          crumb="Secrets"
          icon="folder"
          :trail='listOf(bosca.git.ui.components.NavigationItem("Repositories", "/repositories", false), bosca.git.ui.components.NavigationItem(page.name, "/repositories/" + bosca.git.ui.encode(page.id), false))'
        >
          <if page.allowed>
            <git-secret-create :page="page" />
          </if>
        </ui-page-heading>
        <if page.allowed>
          <git-repository-secrets :page="page" />
        <else>
          <ui-alert>Manage permission is required.</ui-alert>
        </if>
      </ui-page>
    </git-layout>
  </if>
</page>
