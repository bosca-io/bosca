<page route="/repositories/{id}/secrets" requireAuth>
  <script server provides="page">
    bosca.git.ui.repositorySecretsPage()
  </script>
  <if page != null>
    <git-layout :title='page.name + " secrets"'>
      <ui-page>
        <ui-page-heading
          :title='page.name + " secrets"'
          :backHref='"/repositories/" + bosca.git.ui.encode(page.id)'
          backLabel="Repository"
        />
        <if page.allowed>
          <git-repository-secrets :page="page" />
        <else>
          <ui-alert>Manage permission is required.</ui-alert>
        </if>
      </ui-page>
    </git-layout>
  </if>
</page>
