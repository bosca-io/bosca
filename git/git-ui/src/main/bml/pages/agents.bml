<page route="/ci-agents" requireAuth>
  <script server provides="page">
    bosca.git.ui.agentPage()
  </script>
  <git-layout title="CI agents">
    <page-shell>
      <page-heading :trail='listOf(bosca.design.model.NavigationItem("Git", "", false))'
        title="CI Agents"
        :subtitle='page.agents.size.toString() + " agents · " + page.agents.count { it.status.toString() == "ONLINE" } + " online · " + page.agents.count { it.status.toString() == "BUSY" } + " busy"'
      >
        <a class="button-link" :href='"/ci-agents" + if (page.status.isNotBlank()) "?status=" + bosca.git.ui.encode(page.status) else ""'>
          <span class="refresh-icon"><icon name="pulse" :size="14" /></span>
          Refresh
        </a>
        <if page.allowed>
          <git-agent-register :page="page" />
        </if>
      </page-heading>
      <if !page.allowed>
        <alert>Administrator access is required.</alert>
      <else>
        <git-agent-list :page="page" />
      </if>
    </page-shell>
  </git-layout>
  <style scoped>
    .refresh-icon {
      display: inline-flex;
      color: var(--fg-2);
    }
  </style>
</page>
