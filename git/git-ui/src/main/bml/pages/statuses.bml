<page route="/statuses" requireAuth>
  <script server provides="page">
    bosca.git.ui.explorePage("statuses")
  </script>
  <git-layout title="Commit statuses">
    <page-shell>
      <page-heading :trail='listOf(bosca.design.model.NavigationItem("Git", "", false))' title="Commit Statuses" subtitle="CI/CD status checks reported for commits">
        <git-explore-picker :page="page" />
      </page-heading>
      <git-statuses-results :page="page" />
    </page-shell>
  </git-layout>
</page>
