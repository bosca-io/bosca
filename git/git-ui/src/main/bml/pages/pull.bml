<page route="/pulls/{id}" requireAuth>
  <script server provides="page">
    bosca.git.ui.pullPage()
  </script>
  <if page != null>
    <git-layout :title="page.pull.title">
      <ui-page>
        <git-pull-heading :page="page" />
        <ui-tabs label="Pull request" :items="page.tabs" header />
        <if page.view == "overview">
          <div class="pull-workspace">
            <div class="pull-main">
              <card title="Description" :padded="false">
                <div class="pull-description">
                  <if page.descriptionHtml.isNotBlank()>
                    <git-markdown :html="page.descriptionHtml" />
                  <else>
                    <p class="muted">No description provided.</p>
                  </if>
                </div>
              </card>
              <git-pull-review :page="page" />
              <if page.pull.conflictingFiles.isNotEmpty()>
                <git-pull-conflicts :page="page" />
              </if>
              <if page.pull.status.name == "OPEN" || page.pull.status.name == "DRAFT">
                <git-pull-checks :page="page" />
              </if>
            </div>
            <aside class="pull-sidebar" aria-label="Pull request details">
              <git-pull-details :page="page" />
              <git-pull-assignees :page="page" />
              <git-pull-dependencies :page="page" />
              <git-pull-actions :page="page" />
            </aside>
          </div>
        <else-if page.view == "commits">
          <git-pull-commits :page="page" />
        <else>
          <git-pull-review :page="page" />
        </if>
      </ui-page>
    </git-layout>
  </if>
  <style scoped>
    .pull-workspace {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
      gap: 16px;
    }
    .pull-main,
    .pull-sidebar {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .pull-description {
      padding: 14px 16px;
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--fg-1);
    }
    .pull-description > p {
      margin: 0;
    }
    @media (max-width: 720px) {
      .pull-workspace {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</page>
