<component tag="git-pull-actions">
  <prop name="page" type="bosca.git.ui.PullPage" required />
  <script server provides="model">
    bosca.git.ui.PullActionsModel(page)
  </script>
  <island name="git-pull-actions" :key="page.pull.id">
    <section :data-next-href="model.nextHref" class="merge-panel">
      <div class="merge-summary">
        <span
          class="merge-icon"
          :data-status="model.page.pull.status.name"
          :data-blocked="model.page.hasMergeBlockers"
        >
          <ui-icon :name="model.page.mergeIcon" :size="18" />
        </span>
        <div>
          <h2>{ model.page.mergeHeading }</h2>
          <p>{ model.page.mergeDescription }</p>
        </div>
      </div>
      <if model.page.pull.conflictingFiles.isNotEmpty()>
        <ul class="conflict-files">
          <for file in model.page.pull.conflictingFiles>
            <li><ui-icon name="file" :size="13" /><code>{ file }</code></li>
          </for>
        </ul>
      </if>
      <if model.page.canEdit>
        <div class="pull-actions">
          <if model.page.pull.status.name == "OPEN">
            <ui-dialog
              title="Merge pull request"
              triggerLabel="Merge pull request"
              icon="merge"
              primary
              :triggerDisabled="model.page.hasMergeBlockers"
              :forceOpen='model.selectedAction == "merge"'
            >
              <if model.plan.isEmpty()>
                <form class="modal-form" @submit="model.prepare(form.strategy, ctx)">
                  <div class="modal-fields">
                    <if model.message.isNotBlank()><ui-alert>{ model.message }</ui-alert></if>
                    <p class="detail-note">Choose how these changes should be merged into { model.page.pull.targetBranch }.</p>
                    <ui-field label="Merge method">
                      <ui-select name="strategy">
                        <for strategy in listOf("MERGE_COMMIT", "SQUASH", "REBASE", "FAST_FORWARD")>
                          <option :value="strategy" :selected="model.strategy == strategy">
                            { bosca.git.ui.mergeStrategyLabel(strategy) }
                          </option>
                        </for>
                      </ui-select>
                    </ui-field>
                  </div>
                  <footer class="modal-footer">
                    <ui-button ref="cancel">Cancel</ui-button>
                    <ui-button type="submit" primary>Review merge</ui-button>
                  </footer>
                </form>
              <else>
                <form class="modal-form" @submit="model.merge(true, ctx)">
                  <div class="modal-fields">
                    <if model.message.isNotBlank()><ui-alert>{ model.message }</ui-alert></if>
                    <div class="detail-heading">
                      <h3>Merge plan</h3>
                      <ui-badge>{ bosca.git.ui.mergeStrategyLabel(model.strategy) }</ui-badge>
                    </div>
                    <p class="detail-note">
                      { if (model.plan.size == 1) "The following pull request will be merged." else "Dependencies will be merged in this order, followed by this pull request." }
                    </p>
                    <ol class="merge-plan">
                      <for pull in model.plan>
                        <li>
                          <div class="plan-title">
                            <a :href="bosca.git.ui.pullHref(pull.id, pull.repositoryId, pull.number)">
                              { "#" + pull.number + " " + pull.title }
                            </a>
                            <git-pull-status :status="pull.status.name" />
                          </div>
                          <if !pull.mergeable>
                            <p class="plan-blocked">Cannot merge this pull request.</p>
                          </if>
                        </li>
                      </for>
                    </ol>
                    <if model.mergeBlocked>
                      <ui-alert>Resolve the blocked pull requests before merging.</ui-alert>
                    </if>
                    <ui-button size="sm" icon="arrow-left" @click="model.resetMerge()">Change method</ui-button>
                  </div>
                  <footer class="modal-footer">
                    <ui-button ref="cancel">Cancel</ui-button>
                    <ui-button type="submit" primary icon="merge" :disabled="model.mergeBlocked">
                      { if (model.plan.size > 1) "Merge pull requests" else "Merge pull request" }
                    </ui-button>
                  </footer>
                </form>
              </if>
            </ui-dialog>
          </if>
          <if model.page.pull.status.name == "DRAFT">
            <ui-dialog
              title="Ready for review"
              triggerLabel="Ready for review"
              icon="eye"
              primary
              :forceOpen='model.failed && model.selectedAction == "ready"'
            >
              <form class="modal-form" @submit='model.lifecycle("ready", true, ctx)'>
                <div class="modal-fields">
                  <p class="detail-note">Reviewers will be able to approve or request changes.</p>
                  <if model.message.isNotBlank()><ui-alert>{ model.message }</ui-alert></if>
                </div>
                <footer class="modal-footer">
                  <ui-button ref="cancel">Cancel</ui-button>
                  <ui-button type="submit" primary>Ready for review</ui-button>
                </footer>
              </form>
            </ui-dialog>
          </if>
          <if model.page.pull.status.name == "CLOSED">
            <ui-dialog
              title="Reopen pull request"
              triggerLabel="Reopen pull request"
              icon="pull"
              primary
              :forceOpen='model.failed && model.selectedAction == "reopen"'
            >
              <form class="modal-form" @submit='model.lifecycle("reopen", true, ctx)'>
                <div class="modal-fields">
                  <p class="detail-note">Reopen this pull request to continue reviewing its changes.</p>
                  <if model.message.isNotBlank()><ui-alert>{ model.message }</ui-alert></if>
                </div>
                <footer class="modal-footer">
                  <ui-button ref="cancel">Cancel</ui-button>
                  <ui-button type="submit" primary>Reopen pull request</ui-button>
                </footer>
              </form>
            </ui-dialog>
          </if>
          <if model.page.pull.status.name == "OPEN" || model.page.pull.status.name == "DRAFT">
            <ui-dialog
              title="Close pull request"
              triggerLabel="Close pull request"
              icon="close"
              size="sm"
              :forceOpen='model.failed && model.selectedAction == "close"'
            >
              <form class="modal-form" @submit='model.lifecycle("close", true, ctx)'>
                <div class="modal-fields">
                  <p class="detail-note">Close without merging these changes. You can reopen it later.</p>
                  <if model.message.isNotBlank()><ui-alert>{ model.message }</ui-alert></if>
                </div>
                <footer class="modal-footer">
                  <ui-button ref="cancel">Cancel</ui-button>
                  <ui-button type="submit" class="danger">Close pull request</ui-button>
                </footer>
              </form>
            </ui-dialog>
          </if>
        </div>
      </if>
      <if model.page.pull.status.name == "OPEN" || model.page.pull.status.name == "DRAFT">
        <git-pull-checks :page="model.page" />
      </if>
    </section>
  </island>
  <style scoped>
    .merge-summary {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 18px 18px 12px;
    }
    .merge-icon {
      display: flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      color: var(--ok);
      background: color-mix(in srgb, var(--ok) 10%, transparent);
    }
    .merge-icon[data-blocked] {
      color: var(--err);
      background: color-mix(in srgb, var(--err) 10%, transparent);
    }
    .merge-icon[data-status="MERGED"] {
      color: #a78bff;
      background: #a78bff18;
    }
    .merge-icon[data-status="DRAFT"],
    .merge-icon[data-status="CLOSED"] {
      color: var(--fg-3);
      background: var(--bg-3);
    }
    h2 {
      margin: 0;
      font-size: 13px;
      font-weight: 600;
    }
    .merge-summary p {
      margin: 5px 0 0;
      color: var(--fg-3);
      font-size: 12px;
      line-height: 1.6;
    }
    .pull-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 0 18px 18px 62px;
    }
    .conflict-files {
      padding: 0 18px 12px 62px;
      margin: 0;
      list-style: none;
      color: var(--err);
    }
    .conflict-files li {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
      font-size: 12px;
      overflow-wrap: anywhere;
    }
    .merge-plan {
      margin: 0;
      padding-left: 22px;
    }
    .merge-plan li {
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
    }
    .plan-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 13px;
    }
    .plan-blocked {
      margin: 6px 0 0;
      color: var(--err);
      font-size: 12px;
    }
    @media (max-width: 600px) {
      .pull-actions,
      .conflict-files {
        padding-left: 18px;
      }
    }
  </style>
  <script client scoped>
    ctx.onUpdate(() => {
      const next = ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
