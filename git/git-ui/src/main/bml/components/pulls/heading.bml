<component tag="git-pull-heading">
  <prop name="page" type="bosca.git.ui.PullPage" required />
  <ui-page-heading
    :title="page.pull.title"
    icon="pull"
    :iconColor="bosca.git.ui.pullStatusColor(page.pull.status.name)"
    :badge="page.pull.status.name.lowercase()"
    :badgeColor="bosca.git.ui.pullStatusColor(page.pull.status.name)"
    :subtitle='"#" + page.pull.number + " · " + page.pull.sourceBranch + " → " + page.pull.targetBranch'
    :trail='listOf(bosca.git.ui.components.NavigationItem("Pull Requests", "/pulls", false))'
    :crumb='"#" + page.pull.number'
  >
    <if page.canEdit>
      <git-pull-edit :page="page" />
    </if>
    <if page.canReview>
      <a class="button-link" :href='page.href + "&view=reviews&review=true"'>
        <span class="review-icon"><ui-icon name="eye" :size="14" /></span>
        Review
      </a>
    </if>
  </ui-page-heading>
  <style scoped>
    .review-icon {
      display: inline-flex;
      color: var(--fg-2);
    }
  </style>
</component>
