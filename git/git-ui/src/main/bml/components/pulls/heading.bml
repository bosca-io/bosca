<component tag="git-pull-heading">
  <prop name="page" type="bosca.git.ui.PullPage" required />
  <header class="pull-heading">
    <nav class="pull-breadcrumb" aria-label="Breadcrumb">
      <a href="/pulls">Pull requests</a>
      <if page.repositoryName.isNotBlank()>
        <span aria-hidden="true">/</span>
        <a :href='"/repositories/" + bosca.git.ui.encode(page.pull.repositoryId) + "?tab=pulls"'>
          { page.repositoryName }
        </a>
      </if>
      <span aria-hidden="true">/</span>
      <span>#{ page.pull.number }</span>
    </nav>
    <div class="pull-title-row">
      <div class="pull-title">
        <h1>{ page.pull.title } <span class="pull-number">#{ page.pull.number }</span></h1>
        <git-pull-status :status="page.pull.status.name" />
      </div>
      <if page.canReview && page.view == "overview">
        <a class="button-link" :href='page.href + "&view=reviews&review=true"'>
          <ui-icon name="eye" :size="14" />
          Review changes
        </a>
      </if>
    </div>
    <div class="pull-meta">
      <span>{ page.identity(page.pull.authorId) }</span>
      <span class="muted">{ if (page.pull.status.name == "MERGED") "merged" else if (page.pull.status.name == "CLOSED") "proposed" else "wants to merge" }</span>
      <code :title="page.pull.sourceBranch">
        { if (page.sourceRepository != page.pull.repositoryId) page.sourceRepositoryName + ":" else "" }{ page.pull.sourceBranch }
      </code>
      <ui-icon name="arrow-right" :size="12" />
      <code :title="page.pull.targetBranch">{ page.pull.targetBranch }</code>
    </div>
    <div class="pull-dates">
      <span>Opened <ui-time :value="page.pull.created" relative ago /></span>
      <span>Updated <ui-time :value="page.pull.updated" relative ago /></span>
      <if page.pull.mergedAt != null>
        <span>Merged <ui-time :value="page.pull.mergedAt.orEmpty()" relative ago /></span>
        <if page.pull.mergeSha.orEmpty().isNotBlank()>
          <a :href='"/repositories/" + bosca.git.ui.encode(page.pull.repositoryId) + "?ref=" + bosca.git.ui.encode(page.pull.mergeSha.orEmpty()) + "&tab=commits"'>
            <code>{ page.pull.mergeSha.orEmpty().take(12) }</code>
          </a>
        </if>
      </if>
    </div>
  </header>
  <style scoped>
    .pull-heading {
      min-width: 0;
    }
    .pull-breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      color: var(--fg-3);
      font-size: 12px;
      margin-bottom: 8px;
    }
    .pull-breadcrumb a {
      color: var(--fg-3);
      overflow-wrap: anywhere;
    }
    .pull-title-row,
    .pull-title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .pull-title-row {
      justify-content: space-between;
      gap: 12px;
    }
    .pull-title {
      min-width: 0;
      flex: 1;
    }
    h1 {
      margin: 0;
      font-size: 23px;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .pull-number {
      margin-left: 8px;
      font-weight: 400;
      color: var(--fg-3);
    }
    .pull-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin: 10px 0 6px;
      font-size: 12px;
      color: var(--fg-2);
    }
    .pull-meta code {
      max-width: 100%;
      padding: 2px 6px;
      border-radius: 4px;
      background: var(--bg-3);
      color: var(--fg-1);
      font-size: 11px;
      overflow-wrap: anywhere;
    }
    .pull-dates {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 11.5px;
      color: var(--fg-3);
    }
    .pull-dates > span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    @media (max-width: 600px) {
      .pull-title {
        flex-basis: 100%;
      }
      h1 {
        font-size: 21px;
      }
    }
  </style>
</component>
