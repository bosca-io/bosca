<component tag="git-pull-checks">
  <prop name="page" type="bosca.git.ui.PullPage" required />
  <section class="pull-checks" aria-label="Status checks">
    <header class="checks-heading">
      <h3>Status checks</h3>
      <ui-badge :tone="page.checkTone">{ page.checkSummary }</ui-badge>
      <if page.headSha.isNotBlank()>
        <ui-icon-link
          icon="external"
          label="View all status checks"
          :href='"/repositories/" + bosca.git.ui.encode(page.sourceRepository) + "?tab=statuses&sha=" + bosca.git.ui.encode(page.headSha)'
        />
      </if>
    </header>
    <if page.checks.isEmpty()>
      <p class="checks-empty">No checks have been reported for this commit.</p>
    <else>
      <ul class="check-list">
        <for check in page.checks>
          <li class="check-row">
            <span class="check-icon" :data-state="check.state.name">
              <ui-icon :name='when (check.state.name) { "SUCCESS" -> "check"; "PENDING" -> "clock"; else -> "close" }' :size="15" />
            </span>
            <div class="check-copy">
              <strong>{ check.context }</strong>
              <if check.description.orEmpty().isNotBlank()>
                <p>{ check.description.orEmpty() }</p>
              </if>
            </div>
            <ui-badge :tone='when (check.state.name) { "SUCCESS" -> "success"; "PENDING" -> "warning"; else -> "error" }'>
              { when (check.state.name) { "SUCCESS" -> "Passed"; "FAILURE" -> "Failed"; "ERROR" -> "Error"; else -> "Pending" } }
            </ui-badge>
            <if bosca.git.ui.safeWebHref(check.targetUrl).isNotBlank()>
              <ui-icon-link
                icon="external"
                :label='"Open " + check.context + " check"'
                :href="bosca.git.ui.safeWebHref(check.targetUrl)"
                target="_blank"
                rel="noopener noreferrer"
              />
            </if>
          </li>
        </for>
      </ul>
    </if>
  </section>
  <style scoped>
    .pull-checks {
      padding: 16px 18px;
      border-top: 1px solid var(--line);
    }
    .checks-heading,
    .check-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .checks-heading {
      flex-wrap: wrap;
      margin-bottom: 12px;
    }
    h3 {
      margin: 0;
      font-size: 12px;
      font-weight: 600;
      flex: 1;
    }
    .check-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .check-row + .check-row {
      margin-top: 12px;
    }
    .check-icon {
      display: flex;
      flex: none;
      color: var(--err);
    }
    .check-icon[data-state="SUCCESS"] {
      color: var(--ok);
    }
    .check-icon[data-state="PENDING"] {
      color: var(--warn);
    }
    .check-copy {
      min-width: 0;
      flex: 1;
      font-size: 12px;
      overflow-wrap: anywhere;
    }
    .check-copy strong {
      font-weight: 500;
    }
    .check-copy p,
    .checks-empty {
      margin: 4px 0 0;
      color: var(--fg-3);
      font-size: 11.5px;
      line-height: 1.5;
    }
  </style>
</component>
