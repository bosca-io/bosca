<component tag="git-pull-checks">
  <prop name="page" type="bosca.git.ui.PullPage" required />
  <html:section class="ui-card pull-checks" aria-label="Status checks">
    <header class="checks-heading">
      <h3>Status Checks</h3>
      <badge :tone="page.checkTone">{ page.checkSummary }</badge>
      <if page.headSha.isNotBlank()>
        <icon-link
          icon="external"
          label="View all status checks"
          :href='"/repositories/" + bosca.git.ui.encode(page.sourceRepository) + "?tab=statuses&sha=" + bosca.git.ui.encode(page.headSha)'
        />
      </if>
    </header>
    <if page.hasFailingStatusChecks>
      <p class="checks-blocked">Required checks awaiting success: { page.pull.failingStatusChecks.joinToString(", ") }</p>
    </if>
    <if page.checks.isEmpty()>
      <p class="checks-empty">No checks have been reported for this commit.</p>
    <else>
      <ul class="check-list">
        <for check in page.checks>
          <li class="check-row">
            <span class="check-icon" :data-state="check.state.name">
              <icon :name='when (check.state.name) { "SUCCESS" -> "check"; "PENDING" -> "clock"; else -> "close" }' :size="15" />
            </span>
            <div class="check-copy">
              <a :href="page.checkHref(check)">{ check.context }</a>
              <if check.description.orEmpty().isNotBlank()>
                <p>{ check.description.orEmpty() }</p>
              </if>
            </div>
            <badge :tone='when (check.state.name) { "SUCCESS" -> "success"; "PENDING" -> "warning"; else -> "error" }'>
              { when (check.state.name) { "SUCCESS" -> "Passed"; "FAILURE" -> "Failed"; "ERROR" -> "Error"; else -> "Pending" } }
            </badge>
            <if page.checkHref(check).isNotBlank()>
              <icon-link
                icon="external"
                :label='"Open " + check.context + " check"'
                :href="page.checkHref(check)"
              />
            </if>
          </li>
        </for>
      </ul>
    </if>
  </html:section>
  <style scoped>
    .pull-checks {
      min-width: 0;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .checks-heading,
    .check-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .checks-heading {
      flex-wrap: wrap;
      padding: 12px 16px;
      border-bottom: 1px solid var(--line);
    }
    h3 {
      flex: 1;
      margin: 0;
      font-size: 13px;
      font-weight: 600;
    }
    .check-list {
      list-style: none;
      margin: 0;
      padding: 4px 0;
    }
    .check-row {
      padding: 10px 16px;
    }
    .check-row + .check-row {
      border-top: 1px solid var(--line);
    }
    .check-icon {
      display: flex;
      flex: none;
      color: var(--err);
    }
    .check-icon[data-state="SUCCESS"] {
      color: var(--ok);
    }
    .check-icon[data-state="PENDING"] {
      color: var(--warn);
    }
    .check-copy {
      min-width: 0;
      flex: 1;
      overflow-wrap: anywhere;
    }
    .check-copy a {
      color: var(--accent);
      font-size: 12.5px;
      font-weight: 500;
    }
    .check-copy p {
      margin: 4px 0 0;
      color: var(--fg-2);
      font-size: 12.5px;
    }
    .checks-blocked {
      margin: 0;
      padding: 12px 16px;
      color: var(--err);
      font-size: 12.5px;
      overflow-wrap: anywhere;
    }
    .checks-empty {
      margin: 0;
      padding: 48px 0;
      text-align: center;
      color: var(--fg-3);
      font-size: 13.5px;
    }
  </style>
</component>
