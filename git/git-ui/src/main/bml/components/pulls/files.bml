<component tag="git-pull-files">
  <prop name="entries" type="List<bosca.git.ui.DiffTreeEntry>" required />
  <div class="diff-workspace">
    <aside class="diff-sidebar" aria-label="Changed files">
      <header class="sidebar-header">
        <h2>Changed files</h2>
        <span class="file-count">{ entries.count { !it.directory } }</span>
      </header>
      <div class="sidebar-tree"><git-diff-tree :entries="entries" /></div>
    </aside>
    <div class="diff-column"><slot /></div>
  </div>
  <style scoped>
    /* Studio pull request review workspace. */
    .diff-workspace {
      display: grid;
      grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
      align-items: start;
      gap: 14px;
      min-width: 0;
    }
    .diff-sidebar {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      min-width: 0;
      max-height: calc(100dvh - 94px);
      overflow: hidden;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 12px;
      border-bottom: 1px solid var(--line);
    }
    h2 {
      margin: 0;
      color: var(--fg-1);
      font-size: 12.5px;
      font-weight: 600;
    }
    .file-count {
      color: var(--fg-3);
      font-size: 10.5px;
    }
    .sidebar-tree {
      min-height: 0;
      overflow: auto;
      padding: 6px;
    }
    .diff-column {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }
    @media (max-width: 980px) {
      .diff-workspace {
        grid-template-columns: minmax(0, 1fr);
      }
      .diff-sidebar {
        position: static;
        max-height: 280px;
      }
    }
  </style>
</component>
