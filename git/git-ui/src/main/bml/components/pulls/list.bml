<component tag="git-pull-list">
  <prop name="page" type="bosca.git.ui.PullListPage" required />
  <div class="pull-panel">
    <if page.baseHref.isBlank()>
      <ui-tabs label="Pull request state" :items="page.tabs" header />
    <else>
      <div class="pr-toolbar">
        <nav class="pr-filters" aria-label="Pull request state">
          <for tab in listOf(page.tabs.last()) + page.tabs.dropLast(1)>
            <a class="pr-filter" :href="tab.href" :aria-current='if (tab.selected) "page" else "false"'>{ tab.label }</a>
          </for>
        </nav>
        <code class="result-count">{ page.rows.size } results</code>
      </div>
    </if>
    <if page.rows.isEmpty()>
      <ui-empty-state
        icon="pull"
        :title='if (page.status == "ALL") "No pull requests" else "No " + page.status.lowercase() + " pull requests"'
        message="Try another repository or pull request state."
      />
    <else>
      <div class="pull-list">
        <for pull in page.rows>
          <a class="pull-row" :href="pull.href">
            <git-pull-status :status="pull.status" iconOnly />
            <div class="pull-copy">
              <strong>
                <code>#{ pull.number }</code>
                <span>{ pull.title }</span>
              </strong>
              <div class="pull-meta">
                <git-pull-status :status="pull.status" />
                <if page.baseHref.isBlank()>
                  <span class="pull-repository">
                    { page.repositoryNames[pull.repository] ?: "Repository" }
                  </span>
                </if>
                <code class="pull-branches">{ pull.source } → { pull.target }</code>
              </div>
            </div>
            <span class="pull-time"><ui-time :value="pull.updated" relative ago inheritTypography /></span>
          </a>
        </for>
      </div>
    </if>
    <if page.offset != 0L || page.rows.size == 50>
      <nav class="pull-pagination" aria-label="Pull request pages">
        <if page.offset != 0L>
          <ui-icon-link icon="arrow-left" label="Previous page" :href="page.href(offset = (page.offset - 50).coerceAtLeast(0))" />
        </if>
        <if page.rows.size == 50>
          <ui-icon-link icon="arrow-right" label="Next page" :href="page.href(offset = page.offset + 50)" />
        </if>
      </nav>
    </if>
  </div>
  <style scoped>
    .pull-panel {
      display: flex;
      flex-direction: column;
    }
    /* Studio's repository pull-request filter. */
    .pr-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .pr-filters {
      display: flex;
      gap: 2px;
      padding: 2px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--bg-1);
    }
    .pr-filter {
      padding: 5px 12px;
      border-radius: 4px;
      color: var(--fg-2);
      font-size: 12px;
      font-weight: 500;
      text-decoration: none;
    }
    .pr-filter:hover {
      background: var(--bg-2);
      text-decoration: none;
    }
    .pr-filter[aria-current="page"] {
      background: var(--bg-3);
      color: var(--fg-0);
    }
    .result-count {
      flex: none;
      font-size: 11px;
      color: var(--fg-3);
      white-space: nowrap;
    }
    .pull-list {
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      background: var(--bg-1);
    }
    .pull-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--line);
      color: inherit;
      text-decoration: none;
      transition: background 0.1s;
    }
    .pull-row:last-child {
      border-bottom: 0;
    }
    .pull-row:hover {
      background: var(--bg-2);
      text-decoration: none;
    }
    .pull-pagination {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 12px;
    }
    .pull-copy {
      flex: 1;
      min-width: 0;
    }
    .pull-copy strong {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--fg-0);
    }
    .pull-copy strong > code {
      flex: none;
      padding: 1px 5px;
      border-radius: 3px;
      background: var(--bg-3);
      color: var(--fg-3);
      font-size: 10px;
      font-weight: 600;
    }
    .pull-copy strong > span {
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .pull-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 3px;
    }
    .pull-repository {
      font-size: 12px;
      font-weight: 500;
      color: var(--fg-2);
    }
    .pull-branches {
      font-size: 11px;
      color: var(--fg-3);
      overflow-wrap: anywhere;
    }
    .pull-time {
      flex: none;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-3);
      white-space: nowrap;
    }
    @media (max-width: 600px) {
      .pull-row {
        flex-wrap: wrap;
      }
      .pull-copy {
        flex-basis: calc(100% - 48px);
      }
      .pull-time {
        margin-left: 44px;
      }
      .pr-toolbar {
        flex-wrap: wrap;
      }
    }
  </style>
</component>
