<component tag="git-github-pair">
  <prop name="page" type="bosca.git.ui.GitHubPage" required />
  <script server provides="model">
    bosca.git.ui.GitHubPairModel(page)
  </script>
  <island name="git-github-pair" :key="page.id">
    <section class="settings-stack" :data-next-href="model.nextHref">
      <ui-card :padded="false">
        <ui-section-heading
          title="Repository pairing"
          subtitle="Configure the paired repository and synchronization credentials."
        />
        <div class="section-body">
          <if model.message.isNotBlank()>
            <ui-alert :tone='if (model.failed) "error" else "success"'>{ model.message }</ui-alert>
          </if>
          <if model.page.pair != null>
            <p>
              GitHub repository ID
              <code>{ model.page.pair.githubRepositoryId }</code>
              · Pair version
              { model.page.pair.version }
            </p>
            <if model.page.pair.webhookSecretName !in model.page.secrets || model.page.pair.tokenSecretName !in model.page.secrets>
              <ui-alert>
                A referenced shared secret is missing. Restore it or select a replacement.
              </ui-alert>
            </if>
          </if>
          <form
            class="detail-fields"
            @submit="model.save(form.owner, form.name, form.webhook, form.token, form.enabled, form.pushIncludes, form.pushExcludes, form.pullIncludes, form.pullExcludes, ctx)"
          >
            <ui-field label="GitHub owner">
              <ui-input name="owner" :value="model.owner" required />
            </ui-field>
            <ui-field label="GitHub repository name">
              <ui-input name="name" :value="model.name" required />
            </ui-field>
            <ui-field label="Webhook secret name">
              <ui-input name="webhook" :value="model.webhook" list="shared-secret-names" required />
            </ui-field>
            <ui-field label="Token secret name">
              <ui-input name="token" :value="model.token" list="shared-secret-names" required />
            </ui-field>
            <datalist id="shared-secret-names">
              <for name in model.page.secrets>
                <option :value="name" />
              </for>
            </datalist>
            <fieldset class="full-width">
              <legend>Automatic branch synchronization</legend>
              <div class="detail-fields">
                <ui-field label="Push: include branches">
                  <ui-input name="pushIncludes" :value="model.pushIncludes" />
                </ui-field>
                <ui-field label="Push: exclude branches">
                  <ui-input name="pushExcludes" :value="model.pushExcludes" />
                </ui-field>
                <ui-field label="Pull: include branches">
                  <ui-input name="pullIncludes" :value="model.pullIncludes" />
                </ui-field>
                <ui-field label="Pull: exclude branches">
                  <ui-input name="pullExcludes" :value="model.pullExcludes" />
                </ui-field>
              </div>
              <p class="muted">
                Separate patterns with commas. * matches within a segment, ** across segments,
                and ? one character. Empty includes match all; exclusions take priority. Tags
                and manual transfers are unaffected.
              </p>
            </fieldset>
            <div class="full-width">
              <ui-switch name="enabled" :checked="model.enabled" label="Enable synchronization" />
            </div>
            <div class="full-width">
              <ui-button type="submit" primary>Save pairing</ui-button>
            </div>
          </form>
          <p>
            Configure a JSON webhook for push and pull request events using the webhook secret
            and this payload URL:
          </p>
          <code
            ref="webhook"
            :data-path='"/api/webhooks/github/" + bosca.git.ui.encode(model.page.id)'
          >
            { "/api/webhooks/github/" + model.page.id }
          </code>
          <p>
            Map senders in
            <a href="/settings/github">GitHub user mappings</a>
            . Their Bosca groups need repository Edit; builds also need Execute. Enable the
            GitHub package's import, export and reconciliation workflows in Studio's Pipelines
            administration.
          </p>
          <a :href="model.page.href">Reload pairing</a>
        </div>
      </ui-card>
    </section>
  </island>
  <style scoped>
    fieldset {
      border: 1px solid var(--line);
      padding: 16px;
      margin: 0;
      border-radius: 8px;
    }
    code {
      overflow-wrap: anywhere;
    }
  </style>
  <script client scoped>
    const webhook = ctx.ref<HTMLElement>("webhook");
    if (webhook) webhook.textContent = location.origin + webhook.dataset.path;
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
