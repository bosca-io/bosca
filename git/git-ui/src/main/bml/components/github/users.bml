<component tag="git-github-users">
  <prop name="initial" type="bosca.git.ui.GitHubUsersModel" required />
  <script server provides="model">
    bosca.git.ui.GitHubUsersModel(
        initial.allowed,
        initial.offset,
        initial.principalOffset,
        initial.mappings,
        initial.principals,
    )
  </script>
  <island name="git-github-users" :key='"shared"'>
    <html:section class="settings-stack">
      <card title="GitHub user mappings">
        <p class="help">
          Enter a GitHub username and choose the same person's Bosca user. Bosca looks up the account
          automatically. Mappings apply to all paired repositories; repository Edit comes from the user's
          Bosca groups. PR imports also require the original author's primary profile.
        </p>
        <if model.failed && model.message.isNotBlank()>
          <p role="alert" class="error">{ model.message }</p>
        </if>
        <form class="mapping-form" @submit="model.save(form.username, form.principal, ctx)">
          <div class="mapping-field"><field label="GitHub username">
            <input name="username" :value="model.username" placeholder="octocat" mono required />
          </field></div>
          <div class="mapping-field"><field label="Bosca user">
            <ui-select searchable name="principal" required>
              <option value="">Select…</option>
              <if model.principal.isNotBlank() && model.principals.none { it.id == model.principal }>
                <option :value="model.principal" selected>
                  { model.principal }
                  (selected on another page)
                </option>
              </if>
              <for principal in model.principals.take(25)>
                <option :value="principal.id" :selected="principal.id == model.principal">
                  { model.label(principal) }
                </option>
              </for>
            </ui-select>
          </field></div>
          <button primary type="submit">Save mapping</button>
          <div class="pager">
            <button
              :disabled="model.principalOffset == 0L"
              @click="model.move(model.offset, model.principalOffset - 25, form.username, form.principal, ctx)"
            >
              Previous principals
            </button>
            <span>Principals page { model.principalOffset / 25 + 1 }</span>
            <button
              :disabled="model.principals.size != 26"
              @click="model.move(model.offset, model.principalOffset + 25, form.username, form.principal, ctx)"
            >
              Next principals
            </button>
          </div>
          <if !model.failed && model.message.isNotBlank()>
            <p role="status" class="status-message">{ model.message }</p>
          </if>
          <div class="glass-table mapping-table">
            <div class="gt-header mapping-columns" aria-hidden="true">
              <span>GitHub user</span>
              <span>Bosca user</span>
              <span></span>
            </div>
            <if model.mappings.isEmpty()>
              <p class="gt-state empty-state">No user mappings on this page.</p>
            <else>
              <div class="gt-rows">
                <for mapping in model.mappings.take(25)>
                  <div class="gt-row mapping-row">
                    <span class="gt-cell">
                      { mapping.githubUsername?.let { "@$it" } ?: "GitHub user " + mapping.githubUserId }
                    </span>
                    <span class="gt-cell">
                      { model.principals.firstOrNull { it.id == mapping.principalId }?.let { model.label(it) } ?: mapping.principalId }
                    </span>
                    <span class="gt-cell mapping-action">
                      <confirm-dialog
                        title="Remove user mapping?"
                        description="Future synchronized changes will no longer use this identity. Previous deliveries retain their attribution."
                        triggerLabel="Remove mapping"
                        :triggerIconOnly="false"
                        triggerStyle="plain"
                      >
                        <div class="modal-form">
                          <footer class="modal-footer">
                            <button ref="cancel">Cancel</button>
                            <button class="danger" @click="model.remove(mapping.githubUserId, true, ctx)">
                              Remove mapping
                            </button>
                          </footer>
                        </div>
                      </confirm-dialog>
                    </span>
                  </div>
                </for>
              </div>
            </if>
          </div>
          <div class="pager">
            <button
              :disabled="model.offset == 0L"
              @click="model.move(model.offset - 25, model.principalOffset, form.username, form.principal, ctx)"
            >
              Previous mappings
            </button>
            <span>Mappings page { model.offset / 25 + 1 }</span>
            <button
              :disabled="model.mappings.size != 26"
              @click="model.move(model.offset + 25, model.principalOffset, form.username, form.principal, ctx)"
            >
              Next mappings
            </button>
            <button
              @click="model.move(model.offset, model.principalOffset, form.username, form.principal, ctx)"
            >
              Refresh mappings
            </button>
          </div>
        </form>
      </card>
    </html:section>
  </island>
  <style scoped>
    /* Studio's GitHub user mapping card. */
    .help {
      margin: 0 0 13px;
      color: var(--fg-2);
      font-size: 13px;
      line-height: 1.6;
    }
    .error {
      color: var(--err);
    }
    .mapping-form {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 16px;
      margin: 0;
    }
    .mapping-field {
      flex: 1 1 220px;
      min-width: 0;
    }
    .pager {
      display: flex;
      flex: 1 1 100%;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      padding: 0;
      color: var(--fg-2);
      font-size: 12px;
    }
    .status-message {
      flex: 1 1 100%;
      margin: 0;
      font-size: 13px;
    }
    .mapping-table {
      flex: 1 1 100%;
      min-width: 0;
    }
    .mapping-columns,
    .mapping-row {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .mapping-row {
      cursor: default;
    }
    .mapping-action {
      overflow: visible;
    }
  </style>
</component>
