<component tag="git-github-secret">
  <prop name="page" type="bosca.git.ui.GitHubPage" required />
  <script server provides="model">
    bosca.git.ui.GitHubSecretModel(page.id, page.secrets)
  </script>
  <island name="git-github-secret" :key="page.id">
    <card :padded="false">
      <ui-section-heading
        title="Pairing credentials"
        subtitle="Shared pipeline secrets used by repository synchronization."
      >
        <dialog
          title="Add shared pairing credential"
          triggerLabel="Add credential"
          icon="key"
          :forceOpen="model.failed"
        >
          <form class="modal-form" @submit="model.save(form.name, form.value, true, ctx)">
            <div class="modal-fields">
              <p class="form-help">
                Replacing an existing name changes its value everywhere it is used. Values cannot be read back.
              </p>
              <if model.failed>
                <alert>{ model.message }</alert>
              </if>
              <field label="Secret name">
                <input name="name" :value="model.name" list="shared-pairing-secrets" required />
              </field>
              <datalist id="shared-pairing-secrets">
                <for name in model.names>
                  <option :value="name" />
                </for>
              </datalist>
              <field label="Secret value">
                <input type="password" name="value" autocomplete="new-password" required />
              </field>
            </div>
            <footer class="modal-footer">
              <button ref="cancel">Cancel</button>
              <button type="submit" primary>Save shared secret</button>
            </footer>
          </form>
        </dialog>
      </ui-section-heading>
      <if model.message.isNotBlank()>
        <div class="section-body">
          <alert :tone='if (model.failed) "error" else "success"'>{ model.message }</alert>
        </div>
      </if>
      <if model.names.isEmpty()>
        <ui-empty-state
          icon="key"
          title="No shared credentials"
          message="Add the token and webhook secrets referenced by the pairing."
        />
      <else>
        <div class="record-list">
          <for name in model.names>
            <div class="record-row">
              <span class="record-icon">
                <icon name="key" />
              </span>
              <span class="record-copy">
                <strong>{ name }</strong>
              </span>
            </div>
          </for>
        </div>
      </if>
    </card>
  </island>
</component>
