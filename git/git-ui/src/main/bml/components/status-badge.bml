<component tag="git-status-badge">
  <prop name="status" type="String" required />
  <script server provides="tone">
    when (status) {
        "SUCCESS",
        "ONLINE",
        "MERGED" -> "success"
        "FAILURE",
        "FAILED",
        "ERROR",
        "TIMED_OUT" -> "error"
        "PENDING",
        "QUEUED",
        "DRAINING",
        "WAITING_FOR_APPROVAL" -> "warning"
        "RUNNING",
        "BUSY",
        "OPEN" -> "info"
        else -> "neutral"
    }
  </script>
  <ui-badge :tone="tone">
    <span class="status-dot" />
    { status.lowercase().replace('_', ' ').replaceFirstChar(Char::uppercase) }
  </ui-badge>
  <style scoped>
    .status-dot {
      display: inline-block;
      width: 5px;
      height: 5px;
      margin-right: 5px;
      border-radius: 50%;
      background: currentColor;
      vertical-align: 1px;
    }
  </style>
</component>
