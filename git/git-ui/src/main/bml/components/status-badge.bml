<component tag="git-status-badge">
  <prop name="status" type="String" required />
  <prop name="run" type="Boolean" default="false" />
  <script server provides="color">
    bosca.git.ui.statusColor(status)
  </script>
  <span class="status-pill" :data-run="run" :style='"--status-color: " + color'>
    { status.replace('_', ' ') }
  </span>
  <style scoped>
    /* Studio's uppercase run and agent status pill. */
    .status-pill {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 8px;
      background: color-mix(in oklch, var(--status-color) 16%, transparent);
      color: var(--status-color);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-align: center;
      text-transform: uppercase;
      white-space: nowrap;
    }
    /* Studio's fixed-width pipeline run status. */
    .status-pill[data-run] {
      flex: none;
      width: 80px;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 10px;
    }
  </style>
</component>
