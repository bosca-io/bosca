<component tag="git-repository-secrets">
  <prop name="page" type="bosca.git.ui.RepositorySecretsPage" required />
  <script server provides="model">
    bosca.git.ui.RepositorySecretsModel(page)
  </script>
  <island name="git-repository-secrets" :key="page.id">
    <section class="settings-stack" :data-next-href="model.nextHref">
      <if model.message.isNotBlank()>
        <ui-alert :tone='if (model.failed) "error" else "success"'>{ model.message }</ui-alert>
      </if>
      <ui-card :padded="false">
        <ui-section-heading
          title="Pipeline secrets"
          subtitle="Secret values are write-only and available to authorized pipeline jobs."
        >
          <ui-dialog
            title="Add or replace secret"
            triggerLabel="Add secret"
            triggerIcon="plus"
            icon="key"
            primary
            :forceOpen="model.failed && model.saving"
          >
            <form
              class="modal-form"
              @submit="model.save(form.name, form.value, form.environment, true, ctx)"
            >
              <div class="modal-fields">
                <if model.failed && model.saving>
                  <ui-alert :tone='if (model.failed) "error" else "success"'>
                    { model.message }
                  </ui-alert>
                </if>
                <ui-field label="Name" hint="Saving an existing name replaces its value.">
                  <ui-input name="name" :value="model.name" placeholder="API_TOKEN" required />
                </ui-field>
                <ui-field label="Value">
                  <ui-input type="password" name="value" autocomplete="new-password" required />
                </ui-field>
                <ui-field
                  label="Environment key"
                  hint="Leave empty to make this secret available to all environments."
                >
                  <ui-input
                    name="environment"
                    :value="model.environment"
                    placeholder="All environments"
                  />
                </ui-field>
              </div>
              <footer class="modal-footer">
                <ui-button ref="cancel">Cancel</ui-button>
                <ui-button type="submit" primary>Save secret</ui-button>
              </footer>
            </form>
          </ui-dialog>
        </ui-section-heading>
        <if model.page.secrets.isEmpty()>
          <ui-empty-state
            icon="key"
            title="No pipeline secrets"
            message="Store credentials here so authorized pipeline jobs can use them without adding them to your repository."
          />
        <else>
          <ui-table-scroll>
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Environment</th>
                  <th>Updated</th>
                  <th class="actions-column"></th>
                </tr>
              </thead>
              <tbody>
                <for secret in model.page.secrets>
                  <tr>
                    <td>
                      <div class="identity-cell">
                        <ui-icon name="key" />
                        <code>{ secret.name }</code>
                      </div>
                    </td>
                    <td>
                      <ui-badge>{ secret.environmentKey ?: "All environments" }</ui-badge>
                    </td>
                    <td>
                      <ui-time :value="secret.updated" />
                    </td>
                    <td class="actions-column">
                      <ui-confirm-dialog
                        title="Delete secret?"
                        :description='"Pipeline jobs will no longer be able to use " + secret.name + "."'
                        triggerLabel="Delete"
                      >
                        <form class="modal-form" @submit="model.delete(secret.name, true, ctx)">
                          <footer class="modal-footer">
                            <ui-button ref="cancel">Cancel</ui-button>
                            <ui-button type="submit" class="danger">Delete secret</ui-button>
                          </footer>
                        </form>
                      </ui-confirm-dialog>
                    </td>
                  </tr>
                </for>
              </tbody>
            </table>
          </ui-table-scroll>
        </if>
      </ui-card>
    </section>
  </island>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
