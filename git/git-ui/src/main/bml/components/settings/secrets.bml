<component tag="git-repository-secrets">
  <prop name="page" type="bosca.git.ui.RepositorySecretsPage" required />
  <script server provides="model">
    bosca.git.ui.RepositorySecretsModel(page)
  </script>
  <island name="git-repository-secrets" :key="page.id">
    <section class="settings-stack" :data-next-href="model.nextHref">
      <if model.message.isNotBlank()>
        <ui-alert :tone='if (model.failed) "error" else "success"'>{ model.message }</ui-alert>
      </if>
      <if model.page.secrets.isEmpty()>
        <div class="secrets-empty">
          <span class="empty-icon"><ui-icon name="key" :size="32" /></span>
          <p>No pipeline secrets configured.</p>
          <p class="empty-hint">Secrets are available to pipelines as environment variables.</p>
        </div>
      <else>
        <div class="secret-list">
          <for secret in model.page.secrets>
            <div class="secret-row">
              <span class="secret-icon"><ui-icon name="key" :size="14" /></span>
              <code class="secret-name">{ secret.name }</code>
              <if secret.environmentKey != null>
                <ui-badge>{ secret.environmentKey.orEmpty() }</ui-badge>
              </if>
              <span class="secret-date">Updated <ui-time :value="secret.updated" relative ago inheritTypography /></span>
              <span class="secret-delete">
                <ui-confirm-dialog
                  title="Delete secret?"
                  :description='"Pipeline jobs will no longer be able to use " + secret.name + "."'
                  triggerLabel="Delete secret"
                  icon="close"
                  triggerStyle="ghost"
                >
                  <form class="modal-form" @submit="model.delete(secret.name, true, ctx)">
                    <footer class="modal-footer">
                      <ui-button ref="cancel">Cancel</ui-button>
                      <ui-button type="submit" class="danger">Delete secret</ui-button>
                    </footer>
                  </form>
                </ui-confirm-dialog>
              </span>
            </div>
          </for>
        </div>
      </if>
    </section>
  </island>
  <style scoped>
    /* Studio repository secret list. */
    .secret-list {
      overflow: hidden;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .secret-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--line);
    }
    .secret-row:last-child {
      border-bottom: 0;
    }
    .secret-icon {
      display: inline-flex;
      color: var(--accent);
    }
    .secret-name {
      flex: 1;
      min-width: 0;
      font-size: 13px;
      color: var(--fg-0);
      overflow-wrap: anywhere;
    }
    .secret-date {
      font-size: 11px;
      color: var(--fg-3);
    }
    .secret-delete {
      display: flex;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .secret-row:hover .secret-delete,
    .secret-delete:focus-within {
      opacity: 1;
    }
    .secrets-empty {
      padding: 48px 0;
      text-align: center;
      color: var(--fg-3);
      font-size: 13.5px;
    }
    .secrets-empty p {
      margin: 0;
    }
    .empty-icon {
      display: inline-flex;
      margin-bottom: 12px;
      color: var(--fg-4);
    }
    .empty-hint {
      margin-top: 4px;
      font-size: 12px;
      color: var(--fg-4);
    }
    @media (hover: none) {
      .secret-delete {
        opacity: 1;
      }
    }
  </style>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
