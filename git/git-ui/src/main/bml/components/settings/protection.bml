<component tag="git-repository-protection">
  <prop name="page" type="bosca.git.ui.RepositorySettingsPage" required />
  <script server provides="model">
    bosca.git.ui.RepositoryProtectionModel(page)
  </script>
  <island name="git-repository-protection" :key="page.repository.id">
    <html:section class="settings-stack" :data-next-href="model.nextHref">
      <if model.message.isNotBlank()>
        <alert :tone='if (model.failed) "error" else "success"'>{ model.message }</alert>
      </if>
      <card :padded="false">
        <section-heading
          title="Branch protection"
          subtitle="Define review and history requirements for matching branches."
        >
          <button primary size="sm" icon="plus" data-new-rule @click="model.reset()">
            New rule
          </button>
        </section-heading>
        <if model.page.rules.isEmpty()>
          <empty-state
            icon="shield"
            title="No branch protection rules"
            message="Add a rule to require pull requests, reviews or status checks on important branches."
          />
        <else>
          <div class="section-body rule-list">
            <for rule in model.page.rules>
              <article class="rule-card">
                <div class="rule-heading">
                  <div class="rule-pattern">
                    <icon name="shield" />
                    <code>{ rule.pattern }</code>
                  </div>
                  <div class="toolbar">
                    <button size="sm" icon="edit" @click="model.edit(rule.id)">
                      Edit rule
                    </button>
                    <confirm-dialog
                      title="Delete branch protection?"
                      :description='"Protection for branches matching " + rule.pattern + " will be removed."'
                      triggerLabel="Delete"
                    >
                      <form class="modal-form" @submit="model.delete(rule.id, true, ctx)">
                        <footer class="modal-footer">
                          <button ref="cancel">Cancel</button>
                          <button type="submit" class="danger">Delete rule</button>
                        </footer>
                      </form>
                    </confirm-dialog>
                  </div>
                </div>
                <div class="rule-badges">
                  <if rule.requirePullRequest>
                    <badge>Pull request required</badge>
                  </if>
                  <if rule.requiredApprovals != 0>
                    <badge>
                      { rule.requiredApprovals.toString() + if (rule.requiredApprovals == 1) " approval" else " approvals" }
                    </badge>
                  </if>
                  <if rule.dismissStaleReviews>
                    <badge>Dismiss stale reviews</badge>
                  </if>
                  <if rule.requireCodeOwnerReview>
                    <badge>Code owner review</badge>
                  </if>
                  <if rule.requireLinearHistory>
                    <badge>Linear history</badge>
                  </if>
                  <if !rule.allowForcePush>
                    <badge>No force push</badge>
                  </if>
                  <if !rule.allowDeletion>
                    <badge>No deletion</badge>
                  </if>
                  <for check in rule.requireStatusChecks>
                    <badge>{ check }</badge>
                  </for>
                </div>
              </article>
            </for>
          </div>
        </if>
      </card>
      <if model.editing>
        <dialog
          :title='if (model.id.isBlank()) "New branch protection rule" else "Edit branch protection rule"'
          triggerLabel="Continue editing"
          :showTrigger="false"
          icon="shield"
          returnFocus="[data-new-rule]"
          forceOpen
        >
          <form
            class="modal-form"
            @submit="model.save(form.pattern, form.pullRequest, form.approvals, form.stale, form.codeOwner, form.linear, form.force, form.deletion, form.checks, ctx)"
          >
            <div class="modal-fields">
              <if model.failed>
                <alert :tone='if (model.failed) "error" else "success"'>
                  { model.message }
                </alert>
              </if>
              <field
                label="Branch pattern"
                hint="Use a branch name or a pattern, such as release/*."
              >
                <input name="pattern" :value="model.pattern" placeholder="main" required />
              </field>
              <switch
                name="pullRequest"
                :checked="model.pullRequest"
                label="Require pull request"
                description="Changes must be proposed through a pull request."
              />
              <field label="Required approvals">
                <input
                  name="approvals"
                  type="number"
                  min="0"
                  :value="model.approvals.toString()"
                  required
                />
              </field>
              <switch
                name="stale"
                :checked="model.stale"
                label="Dismiss stale approvals"
                description="Request fresh reviews after new commits."
              />
              <switch
                name="codeOwner"
                :checked="model.codeOwner"
                label="Require code owner approval"
              />
              <switch name="linear" :checked="model.linear" label="Require linear history" />
              <switch name="force" :checked="model.force" label="Allow force push" />
              <switch name="deletion" :checked="model.deletion" label="Allow branch deletion" />
              <field label="Required status checks" hint="Separate check names with commas.">
                <input name="checks" :value="model.checks" placeholder="build, test" />
              </field>
            </div>
            <footer class="modal-footer">
              <button ref="cancel">Cancel</button>
              <button type="submit" primary>Save rule</button>
            </footer>
          </form>
        </dialog>
      </if>
    </html:section>
  </island>
  <style scoped>
    .rule-list {
      display: grid;
      gap: 12px;
    }
    .rule-card {
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--bg-2);
    }
    .rule-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .rule-pattern {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .rule-pattern code {
      font-size: 13px;
      font-weight: 600;
    }
    .rule-badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 12px;
    }
  </style>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
