<component tag="git-layout">
  <prop name="title" type="String" required />
  <prop name="signedIn" type="Boolean" default="true" />
  <script server provides="appearance">
    if (ctx.cookies["git_ui_appearance"] == "light") "light" else "dark"
  </script>
  <html lang="en" :data-theme="appearance">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex,nofollow" />
      <title>{ title } — Bosca Git</title>
    </head>
    <body class="git-document" :data-theme="appearance">
      <app-shell>
        <git-header :signedIn="signedIn" />
        <div class="shell-main git-main"><slot /></div>
      </app-shell>
    </body>
  </html>
</component>
