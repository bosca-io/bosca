<component tag="git-file-surface">
  <prop name="page" type="bosca.git.ui.RepositoryPage" required />
  <section class="file-viewer file-surface" :aria-label="page.file">
    <header class="file-header">
      <a class="back-button" :href="page.href(path = page.path)" aria-label="Back to folder" title="Back to folder">
        <ui-icon name="arrow-left" :size="14" />
      </a>
      <span class="file-icon"><ui-icon name="file" :size="14" /></span>
      <span class="file-path">{ page.file }</span>
      <if page.content != null>
        <code class="file-size">{ bosca.git.ui.formatSize(page.content.orEmpty().encodeToByteArray().size.toLong()) }</code>
      </if>
      <span class="file-header-spacer"></span>
      <div class="file-header-actions toolbar file-toolbar" role="group" aria-label="File actions">
        <if page.canWriteRef && page.content != null && page.fileMessage.isBlank()>
          <a class="button-link" :href='page.href(path = page.path, file = page.file) + "&edit=true"'>Rename</a>
          <git-file-actions :page="page" />
          <a class="button-link primary" :href='page.href(path = page.path, file = page.file) + "&edit=true"'>
            <span class="edit-icon"><ui-icon name="edit" :size="14" /></span>
            Edit
          </a>
        </if>
        <if page.rawHref.isNotBlank()>
          <ui-icon-link icon="download" label="Download file" :href="page.rawHref" download />
        </if>
      </div>
    </header>
    <if page.fileMessage.isNotBlank()>
      <p class="file-state">{ page.fileMessage }</p>
    <else-if page.isImage>
      <div class="image-view">
        <img class="repository-image" :src="page.rawHref" :alt="page.file" />
      </div>
    <else-if page.isMarkdown>
      <git-markdown-file :page="page" />
    <else-if page.content != null>
      <ui-source-view :content="page.content" :path="page.file" bare />
    </if>
  </section>
  <style scoped>
    /* Studio repository file viewer card. */
    .file-viewer {
      display: flex;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .file-header {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 10px 16px;
      border-bottom: 1px solid var(--line);
    }
    .back-button {
      display: flex;
      padding: 4px;
      border-radius: 4px;
      color: var(--fg-2);
    }
    .back-button:hover {
      background: var(--bg-3);
    }
    .file-icon {
      display: inline-flex;
      color: var(--accent);
    }
    .file-path {
      min-width: 0;
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--fg-1);
      overflow-wrap: anywhere;
    }
    .file-size {
      font-size: 11px;
      color: var(--fg-3);
    }
    .file-header-spacer {
      flex: 1;
    }
    .file-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      padding: 0;
    }
    .edit-icon {
      display: inline-flex;
      color: var(--accent);
    }
    .file-state {
      margin: 0;
      padding: 48px 0;
      text-align: center;
      color: var(--fg-3);
      font-size: 13px;
    }
    .image-view {
      display: flex;
      justify-content: center;
      padding: 16px;
    }
    .repository-image {
      max-width: 100%;
      max-height: 70vh;
      object-fit: contain;
    }
  </style>
</component>
