<component tag="git-repository-commits">
  <prop name="page" type="bosca.git.ui.RepositoryPage" required />
  <html:section class="commits-panel">
    <div class="commit-list">
      <if page.commits.isEmpty()>
        <p class="commit-empty">No commits found.</p>
      <else>
        <for commit in page.commits>
          <div class="commit-row">
            <span class="commit-icon"><icon name="commit" :size="14" /></span>
            <div class="commit-body">
              <a class="commit-message" :href="page.href(ref = commit.sha)">{ commit.message.lineSequence().first() }</a>
              <div class="commit-meta">
                <span class="commit-author">{ commit.author.substringBefore(" <") }</span>
                <span class="commit-time"><ui-time :value="commit.date" relative ago inheritTypography /></span>
              </div>
            </div>
            <a class="commit-sha" :href="page.href(ref = commit.sha)" :title="commit.sha">
              { commit.sha.take(7) }
            </a>
          </div>
        </for>
      </if>
    </div>
    <if page.offset != 0L || page.commits.size == 25>
      <nav class="load-more" aria-label="Commit pages">
        <if page.offset != 0L>
          <a class="button-link" :href="page.previousHref">Newer commits</a>
        </if>
        <if page.commits.size == 25>
          <a class="button-link" :href="page.nextHref">Load more commits</a>
        </if>
      </nav>
    </if>
  </html:section>
  <style scoped>
    /* Studio repository commit list. */
    .commit-list {
      overflow: hidden;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .commit-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--line);
    }
    .commit-row:last-child {
      border-bottom: 0;
    }
    .commit-icon {
      display: flex;
      flex: 0 0 28px;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      color: var(--accent);
      background: color-mix(in oklch, var(--accent) 10%, transparent);
    }
    .commit-body {
      flex: 1;
      min-width: 0;
    }
    .commit-message {
      display: block;
      overflow: hidden;
      color: var(--fg-0);
      font-size: 13.5px;
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .commit-meta {
      display: flex;
      gap: 10px;
      margin-top: 3px;
    }
    .commit-author {
      font-size: 12px;
      color: var(--fg-2);
    }
    .commit-time {
      font-size: 11px;
      color: var(--fg-3);
    }
    .commit-sha {
      flex: none;
      padding: 2px 6px;
      border-radius: 4px;
      background: var(--bg-2);
      color: var(--fg-3);
      font-family: var(--font-mono);
      font-size: 11px;
    }
    .commit-sha:hover {
      color: var(--fg-1);
      text-decoration: none;
    }
    .commit-empty {
      margin: 0;
      padding: 48px 0;
      text-align: center;
      color: var(--fg-3);
      font-size: 13.5px;
    }
    .load-more {
      display: flex;
      justify-content: center;
      gap: 8px;
      padding: 16px 0;
    }
  </style>
</component>
