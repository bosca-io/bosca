<component tag="git-branch-create">
  <prop name="page" type="bosca.git.ui.RepositoryPage" required />
  <script server provides="model">
    bosca.git.ui.RepositoryRefModel(page, page.id, page.ref, page.listHref)
  </script>
  <island name="git-branch-create" :key="model.page.id + model.page.ref">
    <div class="branch-create" :data-next-href="model.nextHref">
      <ui-dialog
        title="New Branch"
        triggerLabel="New Branch"
        triggerIcon="plus"
        icon="branch"
        primary
        :forceOpen="model.failed"
      >
        <form class="modal-form" @submit="model.create(form.name, form.source, ctx)">
          <div class="modal-fields">
            <if model.failed>
              <ui-alert :tone='if (model.failed) "error" else "success"'>
                { model.message }
              </ui-alert>
            </if>
            <ui-field label="Branch name">
              <ui-input
                name="name"
                :value="model.name"
                placeholder="feature/new-work"
                required
              />
            </ui-field>
            <ui-field label="Source ref">
              <ui-input name="source" :value="model.source" required />
            </ui-field>
          </div>
          <footer class="modal-footer">
            <ui-button ref="cancel">Cancel</ui-button>
            <ui-button type="submit" primary>Create branch</ui-button>
          </footer>
        </form>
      </ui-dialog>
    </div>
  </island>
  <style scoped>
    .branch-create {
      display: contents;
    }
  </style>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
