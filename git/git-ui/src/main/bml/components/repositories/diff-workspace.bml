<component tag="git-diff-workspace">
  <prop name="entries" type="List<bosca.git.ui.DiffTreeEntry>" required />
  <div class="diff-workspace">
    <aside class="diff-sidebar" aria-label="Changed files" data-bml-preserve="diff-sidebar">
      <header class="sidebar-header">
        <h2>Changed files</h2>
        <span class="file-count">{ entries.count { !it.directory } }</span>
        <span class="sidebar-actions">
          <ui-tooltip content="Collapse all files">
            <button class="sidebar-action" type="button" aria-label="Collapse all files" data-diff-collapse-all>
              <ui-icon name="fold" :size="13" />
            </button>
          </ui-tooltip>
          <ui-tooltip content="Expand all files">
            <button class="sidebar-action" type="button" aria-label="Expand all files" data-diff-expand-all>
              <ui-icon name="unfold" :size="13" />
            </button>
          </ui-tooltip>
        </span>
      </header>
      <div class="sidebar-tree"><git-diff-tree :entries="entries" /></div>
      <div
        ref="resize"
        class="sidebar-resize"
        role="separator"
        tabindex="0"
        aria-orientation="vertical"
        aria-label="Resize changed files"
        title="Drag to resize. Double-click to reset."
      ></div>
    </aside>
    <div class="diff-column"><slot /></div>
    <button ref="top" class="back-to-top" type="button" aria-label="Back to top" hidden>
      <ui-icon name="arrow-up" :size="14" />
      <span>Top</span>
    </button>
  </div>
  <style scoped>
    /* Review workspace: resizable sticky file tree beside the diff column. */
    .diff-workspace {
      --diff-number-width: 42px;
      --diff-action-width: 28px;
      display: grid;
      grid-template-columns: var(--diff-sidebar-width, 300px) minmax(0, 1fr);
      align-items: start;
      gap: 14px;
      min-width: 0;
    }
    .diff-sidebar {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      min-width: 0;
      max-height: calc(100dvh - 94px);
      overflow: hidden;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .sidebar-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 8px 8px 12px;
      border-bottom: 1px solid var(--line);
    }
    h2 {
      margin: 0;
      color: var(--fg-1);
      font-size: 12.5px;
      font-weight: 600;
    }
    .file-count {
      flex: 1;
      color: var(--fg-3);
      font-size: 10.5px;
    }
    .sidebar-actions {
      display: flex;
      gap: 2px;
    }
    .sidebar-action {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      padding: 0;
      border: 0;
      border-radius: 6px;
      color: var(--fg-2);
      background: transparent;
      cursor: pointer;
    }
    .sidebar-action:hover {
      color: var(--fg-0);
      background: var(--bg-2);
    }
    .sidebar-action:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .sidebar-tree {
      min-height: 0;
      overflow: auto;
      overscroll-behavior: contain;
      padding: 6px;
    }
    .sidebar-resize {
      position: absolute;
      top: 0;
      right: -1px;
      bottom: 0;
      width: 7px;
      cursor: col-resize;
      touch-action: none;
    }
    .sidebar-resize:hover,
    .sidebar-resize:focus-visible,
    .sidebar-resize[data-dragging] {
      outline: none;
      background: linear-gradient(to right, transparent 3px, var(--accent) 3px, var(--accent) 5px, transparent 5px);
    }
    .diff-column {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 0;
    }
    .back-to-top {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      color: var(--fg-0);
      background: var(--bg-2);
      box-shadow: 0 6px 20px rgb(0 0 0 / 35%);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
    }
    .back-to-top[hidden] {
      display: none;
    }
    .back-to-top:hover {
      background: var(--bg-3);
    }
    .back-to-top:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    @media (max-width: 980px) {
      .diff-workspace {
        grid-template-columns: minmax(0, 1fr);
      }
      .diff-sidebar {
        position: static;
        max-height: 280px;
      }
      .sidebar-resize {
        display: none;
      }
    }
  </style>
  <script client scoped>
    import { diffWorkspace } from "@client/diff-workspace";
    diffWorkspace(ctx);
  </script>
</component>
