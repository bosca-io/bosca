<component tag="git-diff-tree">
  <prop name="entries" type="List<bosca.git.ui.DiffTreeEntry>" required />
  <nav aria-label="Changed file tree">
    <tree label="Changed files" local embedded>
      <for entry in entries>
        <tree-item
          :path="entry.path"
          :label="entry.name"
          :href="entry.href"
          :depth="entry.depth"
          :directory="entry.directory"
          :expanded="entry.directory"
        />
      </for>
    </tree>
  </nav>
  <style scoped>
    nav {
      width: max-content;
      min-width: 100%;
    }
  </style>
</component>
