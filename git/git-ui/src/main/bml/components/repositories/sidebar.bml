<component tag="git-repository-sidebar">
  <prop name="page" type="bosca.git.ui.RepositoryPage" required />
  <island
    name="repository-tree-loader"
    render="deferred"
    :key="page.id + page.resolvedSha"
    :repoId="page.id"
    :refName="page.ref"
    :commit="page.resolvedSha"
    :filePath="page.file"
    :directory="page.path"
    :returnHref="page.listHref"
  >
    <prop name="repoId" type="String" />
    <prop name="refName" type="String" />
    <prop name="commit" type="String" />
    <prop name="filePath" type="String" />
    <prop name="directory" type="String" />
    <prop name="returnHref" type="String" />
    <fallback>
      <div class="tree-loading">
        <strong>Files</strong>
        <div class="tree-loading-message">
          <ui-loading-state label="Loading files…" compact />
        </div>
        <span class="tree-error-message" role="alert">Files could not be loaded.</span>
        <ui-button size="sm" icon="refresh" data-bml-deferred-retry>Retry</ui-button>
      </div>
    </fallback>
    <git-sidebar-tree
      :page="bosca.git.ui.RepositorySidebarContext(repoId, refName, commit, filePath, directory, returnHref)"
    />
  </island>
  <style scoped>
    .tree-loading {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 10px 12px;
      font-size: 12px;
      color: var(--fg-3);
    }
    .tree-loading strong {
      color: var(--fg-1);
    }
    .tree-error-message {
      color: var(--err);
    }
  </style>
</component>
