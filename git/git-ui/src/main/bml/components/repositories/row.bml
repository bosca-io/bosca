<component tag="git-repository-row">
  <prop name="repository" type="bosca.git.ui.RepositorySummary" required />
  <prop name="initial" type="bosca.git.ui.RepositoryListModel" required />
  <script server provides="model">
    bosca.git.ui.RepositoryRowModel(repository, initial.state, initial.owner)
  </script>
  <island name="git-repository-row" :key="model.repository.id">
    <li class="gt-row repository-row" :data-next-href="model.nextHref">
      <span class="gt-cell repository-name">
        <span class="repository-icon"><icon name="folder" :size="14" /></span>
        <a
          class="gt-row-link"
          :href="model.repository.href"
          :title="model.repository.description.takeIf(String::isNotBlank)"
        >
          { model.repository.name }
        </a>
        <if model.repository.archived>
          <badge>Archived</badge>
        </if>
      </span>
      <span class="gt-cell repository-visibility">
        <badge :tone="model.repository.visibilityTone">
          { model.repository.visibility.lowercase() }
        </badge>
      </span>
      <span class="gt-cell repository-type">{ model.repository.contentTypeLabel }</span>
      <code class="gt-cell repository-branch">{ model.repository.defaultBranch }</code>
      <code class="gt-cell gt-muted repository-size">
        { bosca.git.ui.formatSize(model.repository.size) }
      </code>
      <span class="gt-cell gt-muted repository-updated">
        <time :value="model.repository.updated" format="MMM d" inheritTypography />
      </span>
      <span class="gt-actions">
      <if model.repository.canManage>
        <tooltip content="Repository actions">
          <details class="row-actions" ref="panel">
            <summary ref="trigger" aria-label="Repository actions" title="Repository actions" tabindex="0">
              <span class="row-menu-icon"><icon name="list" :size="14" /></span>
            </summary>
            <div class="repository-menu" role="menu" aria-label="Repository actions">
              <a
                role="menuitem"
                :href='"/repositories/" + bosca.git.ui.encode(model.repository.id) + "/settings"'
              >
                <icon name="edit" :size="14" />
                Settings
              </a>
              <if model.repository.archived>
                <button role="menuitem" icon="refresh" @click='model.prepare("restore")'>
                  Restore repository
                </button>
              <else>
                <button role="menuitem" icon="archive" @click='model.prepare("archive")'>
                  Archive repository
                </button>
              </if>
              <button class="danger" role="menuitem" icon="trash" @click='model.prepare("delete")'>
                Delete repository
              </button>
            </div>
          </details>
        </tooltip>
        <if model.pendingAction.isNotBlank()>
          <dialog
            :title='model.pendingAction.replaceFirstChar(Char::uppercase) + " repository?"'
            triggerLabel="Confirm action"
            :showTrigger="false"
            forceOpen
            icon="folder"
            returnFocus="[aria-label='Repository actions']"
          >
            <form class="modal-form" @submit="model.lifecycle(model.pendingAction, true, ctx)">
              <div class="modal-fields">
                <p class="form-help">
                  { if (model.pendingAction == "delete") "This removes " + model.repository.name + " from the repository list and schedules it for deletion." else if (model.pendingAction == "archive") "Archive " + model.repository.name + " to make it read-only. You can restore it later." else "Restore " + model.repository.name + " to make it active again." }
                </p>
                <if model.failed>
                  <alert :tone='if (model.failed) "error" else "success"'>
                    { model.message }
                  </alert>
                </if>
              </div>
              <footer class="modal-footer">
                <button ref="cancel">Cancel</button>
                <button
                  type="submit"
                  :class='if (model.pendingAction == "delete") "danger" else ""'
                  :primary='model.pendingAction != "delete"'
                >
                  { model.pendingAction.replaceFirstChar(Char::uppercase) + " repository" }
                </button>
              </footer>
            </form>
          </dialog>
        </if>
      </if>
      </span>
      <if model.message.isNotBlank()>
        <div class="row-message">
          <alert :tone='if (model.failed) "error" else "success"'>{ model.message }</alert>
        </div>
      </if>
    </li>
  </island>
  <style scoped>
    .repository-row {
      grid-template-columns: 1.5fr 100px 120px 100px 80px 120px 28px;
    }
    .repository-name {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .repository-icon {
      display: inline-flex;
      flex: none;
      color: var(--accent);
    }
    .repository-name > a {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
    }
    .repository-type {
      color: var(--fg-2);
    }
    .repository-branch {
      font-size: 12px;
      color: var(--fg-2);
    }
    .row-message {
      grid-column: 1 / -1;
      position: relative;
      z-index: 1;
    }
    .row-actions summary {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
      border-radius: 4px;
      color: var(--fg-3);
      list-style: none;
      cursor: pointer;
    }
    .row-menu-icon {
      display: inline-flex;
    }
    .row-actions summary:hover,
    .row-actions[open] summary {
      background: var(--bg-3);
    }
    .row-actions summary::-webkit-details-marker {
      display: none;
    }
    .repository-menu {
      position: absolute;
      right: 4px;
      top: calc(100% - 6px);
      z-index: 15;
      background: var(--bg-2);
      border: 1px solid var(--line-2);
      border-radius: var(--r-sm);
      padding: 4px;
      width: 210px;
      box-shadow: 0 12px 30px #0006;
    }
    .repository-menu a {
      display: flex;
      align-items: center;
      gap: 6px;
      height: 32px;
      padding: 0 10px;
      color: var(--fg-1);
      font-size: 12.5px;
      text-decoration: none;
    }
    .repository-menu a:hover {
      background: var(--bg-3);
      border-radius: 5px;
    }
    @media (max-width: 1100px) {
      .repository-row {
        grid-template-columns: minmax(0, 1fr) 90px 28px;
        row-gap: 6px;
      }
      .repository-visibility {
        grid-column: 2;
        grid-row: 1;
      }
      .gt-actions {
        grid-column: 3;
        grid-row: 1;
      }
      .repository-type {
        grid-column: 1;
        grid-row: 2;
      }
      .repository-branch {
        grid-column: 2 / 4;
        grid-row: 2;
      }
      .repository-size {
        grid-column: 1;
        grid-row: 3;
      }
      .repository-updated {
        grid-column: 2 / 4;
        grid-row: 3;
      }
    }
  </style>
  <script client scoped>
    import { dismissibleDisclosure } from "@client/disclosure";
    dismissibleDisclosure(ctx);
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
