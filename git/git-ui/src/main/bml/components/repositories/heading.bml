<component tag="git-repository-heading">
  <prop name="page" type="bosca.git.ui.RepositoryPage" required />
  <div class="repository-heading">
    <ui-page-heading
      icon="folder"
      :badge="page.visibility.lowercase()"
      :badgeTone='when (page.visibility) { "PUBLIC" -> "success"; "INTERNAL" -> "warning"; else -> "neutral" }'
      :subtitle='page.slug + " · " + page.visibility.lowercase() + " · " + page.defaultBranch'
      :title="page.name"
      :trail='listOf(bosca.git.ui.components.NavigationItem("Repositories", page.listHref, false))'
    >
      <div class="repository-controls">
        <if page.tab == "code" || page.tab == "commits" || page.tab == "statuses">
          <git-ref-selector :page="page" />
        </if>
        <if page.tab == "branches" && page.canEdit && !page.archived && page.resolvedSha.isNotBlank()>
          <git-branch-create :page="page" />
        </if>
        <if page.tab == "tags" && page.canEdit && !page.archived && (page.branches.isNotEmpty() || page.tags.isNotEmpty())>
          <git-tag-create :page="page" />
        </if>
        <if page.pulls != null>
          <git-pull-create :page="page.pulls" />
        </if>
        <if page.secrets != null && page.secrets.allowed>
          <git-secret-create :page="page.secrets" />
        </if>
        <if page.tab == "pipelines" || page.tab == "statuses" || page.tab == "secrets">
          <a class="button-link" :href="page.href(tab = page.tab)">
            <span class="refresh-icon"><ui-icon name="pulse" :size="14" /></span>
            Refresh
          </a>
        </if>
        <ui-popover label="Clone repository" icon="download" iconOnly :width="420">
          <ui-copy-field :value="page.cloneUrl" label="Clone URL" copyLabel="Copy clone URL" />
        </ui-popover>
      </div>
    </ui-page-heading>
  </div>
  <style scoped>
    .repository-heading {
      min-width: 0;
    }
    .refresh-icon {
      display: inline-flex;
      color: var(--fg-2);
    }
    .repository-controls {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      min-width: 0;
      max-width: 100%;
    }
  </style>
</component>
