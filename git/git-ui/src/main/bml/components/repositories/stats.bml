<component tag="git-repository-stats">
  <prop name="id" type="String" required />
  <div class="repository-summary">
    <island name="statistics" render="deferred" :id="id">
      <prop name="id" type="String" />
      <fallback>
        <dl class="stat-grid">
          <for label in listOf("Commits", "Branches", "Tags", "Contributors", "Size")>
            <div class="stat-tile">
              <dt class="stat-label">{ label }</dt>
              <dd class="stat-value">
                <span class="stats-loading stat-skeleton" role="status" :aria-label='"Loading " + label.lowercase()'></span>
                <span class="stats-error" aria-label="Unavailable">—</span>
              </dd>
            </div>
          </for>
        </dl>
        <div class="stats-state">
          <span class="stats-error" role="alert">Statistics could not be loaded.</span>
          <button class="stats-retry" type="button" data-bml-deferred-retry>Retry</button>
        </div>
      </fallback>
      <script server provides="stats">bosca.git.ui.repositoryStats(id)</script>
      <dl class="stat-grid">
        <for stat in stats>
          <div class="stat-tile">
            <dt class="stat-label">{ stat.label }</dt>
            <dd class="stat-value" :title="stat.value">{ stat.value }</dd>
          </div>
        </for>
      </dl>
    </island>
  </div>
  <style scoped>
    .repository-summary {
      position: relative;
      min-width: 0;
      margin-bottom: 18px;
    }
    /* Studio StatGrid with five StatTiles. */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin: 0;
    }
    .stat-tile {
      min-width: 0;
      padding: 16px;
      background: var(--bg-1);
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .stat-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--fg-3);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .stat-value {
      margin: 6px 0 0;
      height: 1.5em;
      font-size: 28px;
      line-height: 1.5;
      font-weight: 600;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .stat-skeleton {
      display: inline-block;
      width: 3ch;
      max-width: 100%;
      height: 0.8em;
      vertical-align: middle;
      border-radius: 4px;
      background: var(--fg-3);
      opacity: 0.2;
      animation: stat-pulse 1.5s ease-in-out infinite;
    }
    .stats-state {
      position: absolute;
      top: 100%;
      left: 0;
      display: flex;
      align-items: center;
      color: var(--fg-3);
      font-size: 12.5px;
      line-height: 18px;
    }
    .stats-error,
    .stats-retry {
      display: none;
    }
    [data-bml-deferred-state="error"] .stats-error,
    [data-bml-deferred-state="error"] .stats-retry {
      display: inline;
    }
    [data-bml-deferred-state="error"] .stats-loading {
      display: none;
    }
    .stats-retry {
      margin-left: 8px;
      color: var(--accent);
      background: none;
      border: 0;
      padding: 0;
      font: inherit;
      cursor: pointer;
    }
    @keyframes stat-pulse {
      50% { opacity: 0.4; }
    }
    @media (prefers-reduced-motion: reduce) {
      .stat-skeleton {
        animation: none;
      }
    }
    @media (max-width: 900px) {
      .stat-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    @media (max-width: 600px) {
      .stat-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .stat-value {
        font-size: 22px;
      }
    }
  </style>
</component>
