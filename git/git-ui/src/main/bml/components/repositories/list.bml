<component tag="git-repository-list">
  <prop name="page" type="bosca.git.ui.RepositoryListModel" required />
  <script server provides="model">
    bosca.git.ui.RepositoryListModel(page.state, page.owner, repositories = page.repositories)
  </script>
  <island name="git-repository-list">
    <ui-page :data-next-href="model.nextHref">
      <ui-page-heading
        title="Repositories"
        :description='model.repositories.size.toString() + if (model.repositories.size == 1) " repository" else " repositories"'
      >
        <div class="repository-heading-actions">
          <form method="get" class="toolbar owner-toolbar">
            <input type="hidden" name="state" :value="model.state.queryValue" />
            <git-owner-picker
              compact
              :id="model.owner.id"
              :label='if (model.owner.id == "all") model.owner.name else model.owner.label'
            />
          </form>
          <div class="repository-actions">
            <git-repository-import :initial="model" />
            <git-repository-create :initial="model" />
          </div>
        </div>
      </ui-page-heading>
      <ui-tabs label="Repository state" :items="model.tabs" />
      <if model.message.isNotBlank()>
        <p role="status" :class='if (model.failed) "status error" else "status"'>
          { model.message }
        </p>
      </if>
      <if model.repositories.isEmpty()>
        <ui-empty-state
          :message='"No " + model.state.label.lowercase() + " repositories are available."'
        />
      <else>
        <div class="repository-columns" aria-hidden="true">
          <span>Repository</span>
          <span>Visibility</span>
          <span>Type</span>
          <span>Branch</span>
          <span>Size</span>
          <span>Updated</span>
          <span></span>
        </div>
        <ul class="repository-list">
          <for repository in model.repositories>
            <git-repository-row :repository="repository" :initial="model" />
          </for>
        </ul>
      </if>
    </ui-page>
  </island>
  <style scoped>
    .repository-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .toolbar {
      display: flex;
      align-items: end;
      flex-wrap: wrap;
      gap: 12px;
      margin: 12px 0;
    }
    .repository-heading-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .repository-actions {
      display: flex;
      gap: 8px;
    }
    .owner-toolbar {
      align-items: center;
    }
    .repository-columns {
      display: grid;
      grid-template-columns: minmax(180px, 1.5fr) 90px 120px 90px 70px 100px 36px;
      gap: 12px;
      padding: 10px 14px;
      background: transparent;
      border-bottom: 1px solid color-mix(in oklch, var(--line) 42%, transparent);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 11px;
      color: var(--fg-3);
      font-weight: 600;
    }
    .repository-list {
      background: transparent;
    }
    @media (max-width: 1100px) {
      .repository-columns {
        display: none;
      }
    }
  </style>
  <script client scoped>
    const navigate = () => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    };
    ctx.onUpdate(navigate);
    ctx.on(ctx.root, "ownerselected", (event) => {
      if (event.target instanceof Element)
        event.target.closest<HTMLFormElement>(".owner-toolbar")?.requestSubmit();
    });
    const owner = new URLSearchParams(location.search).get("owner");
    if (owner)
      document.cookie =
        "git_owner=" + encodeURIComponent(owner) + "; Path=/; SameSite=Lax";
  </script>
</component>
