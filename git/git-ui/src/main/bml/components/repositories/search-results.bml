<component tag="git-search-results">
  <prop name="page" type="bosca.git.ui.SearchModel" required />
  <html:section class="search-results" aria-label="Search results">
    <if page.failed>
      <alert>{ page.message }</alert>
    <else-if page.id.isBlank()>
      <empty-state
        icon="folder"
        title="No repositories available"
        message="Choose an accessible repository to search its content and file paths."
      />
    <else-if page.query.isBlank()>
      <empty-state
        icon="search"
        title="Search this repository"
        message="Enter text to find matching content, or choose Paths to find a file by name."
      />
    <else-if page.notice.isNotBlank()>
      <empty-state icon="branch" :message="page.notice" />
    <else-if page.hits.isEmpty()>
      <empty-state
        icon="search"
        :title='"No matches for “" + page.query.trim() + "”"'
        message="Try another query, repository or ref."
      />
    <else>
      <div class="results-summary" role="status">
        <span>
          { page.hits.size.toString() + if (page.hits.size == 1) " result" else " results" }
        </span>
        <span>in { page.repositoryName }</span>
        <code>{ page.ref }</code>
        <if page.mode == "content" && page.hits.size == 100>
          <span class="result-limit">Showing the first 100 matches</span>
        </if>
      </div>
      <ul class="results-list">
        <for hit in page.hits>
          <li>
            <a
              :href="hit.href"
              :class='"result-row" + if (page.mode == "paths") " path-row" else ""'
              :aria-label='"Open " + hit.path + if (hit.line > 0) " at line " + hit.line else ""'
            >
              <if page.mode == "content">
                <div class="result-location">
                  <icon name="file" :size="13" />
                  <code class="result-path">{ hit.path }</code>
                  <span class="result-line">Line { hit.line }</span>
                  <span class="result-open">
                    <icon name="arrow-right" :size="13" />
                  </span>
                </div>
                <pre class="result-snippet"><for part in hit.parts(page.query)><if part.matched><mark>{ part.text }</mark><else>{ part.text }</if></for></pre>
              <else>
                <icon :name="hit.icon" :size="14" />
                <span class="path-copy">
                  <span class="result-name">{ hit.name }</span>
                  <code class="result-full-path">{ hit.path }</code>
                </span>
                <if hit.typeLabel.isNotBlank()>
                  <span class="result-type">{ hit.typeLabel }</span>
                </if>
                <if hit.sizeLabel.isNotBlank()>
                  <span class="result-size">{ hit.sizeLabel }</span>
                </if>
                <span class="result-open">
                  <icon name="arrow-right" :size="13" />
                </span>
              </if>
            </a>
          </li>
        </for>
      </ul>
    </if>
  </html:section>
  <style scoped>
    .search-results {
      margin-top: 16px;
      min-width: 0;
    }
    .results-summary {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      color: var(--fg-3);
      font-size: 12px;
      margin-bottom: 10px;
    }
    .results-summary code {
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 5px;
      background: var(--bg-2);
    }
    .result-limit {
      margin-left: auto;
    }
    .results-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      background: var(--bg-1);
    }
    li + li {
      border-top: 1px solid var(--line);
    }
    .result-row {
      display: block;
      min-width: 0;
      padding: 12px 16px;
      color: var(--fg-1);
    }
    .result-row:hover {
      background: var(--bg-2);
    }
    .result-row:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .result-location {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      color: var(--accent);
    }
    .result-path {
      font-size: 12.5px;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .result-line {
      color: var(--fg-3);
      font: 11px var(--font-mono);
      white-space: nowrap;
    }
    .result-open {
      display: flex;
      color: var(--fg-3);
      margin-left: auto;
      flex: none;
    }
    .result-snippet {
      margin: 0;
      padding: 8px 12px;
      color: var(--fg-1);
      background: var(--bg-0);
      border-radius: 6px;
      font: 12px/1.7 var(--font-mono);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      max-height: 130px;
      overflow: auto;
    }
    mark {
      background: color-mix(in oklch, var(--accent) 16%, transparent);
      color: var(--fg-0);
      padding: 0 1px;
      border-radius: 2px;
    }
    .path-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .path-copy {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
      flex: 1;
    }
    .result-name {
      color: var(--fg-0);
      font-size: 13px;
      overflow-wrap: anywhere;
    }
    .result-full-path {
      color: var(--fg-3);
      font-size: 11px;
      overflow-wrap: anywhere;
    }
    .result-size,
    .result-type {
      color: var(--fg-3);
      font-size: 11px;
      white-space: nowrap;
    }
    @media (max-width: 600px) {
      .result-row {
        padding: 12px;
      }
      .path-copy {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
      }
      .result-location {
        flex-wrap: wrap;
      }
    }
  </style>
</component>
