<component tag="git-repository-tree">
  <prop name="entries" type="List<bosca.git.ui.RepositoryEntry>" required />
  <if entries.isEmpty()>
    <ui-empty-state message="This folder is empty." />
  <else>
    <ul class="tree">
      <for entry in entries>
        <li>
          <a :href="entry.href">
            <ui-icon :name='if (entry.directory) "folder" else "file"' :size="16" />
            { entry.name }
          </a>
        </li>
      </for>
    </ul>
  </if>
  <style scoped>
    .tree {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .tree li {
      border-bottom: 1px solid var(--line);
    }
    .tree a {
      display: flex;
      gap: 10px;
      align-items: center;
      font-size: 12.5px;
      padding: 12px 18px;
      overflow-wrap: anywhere;
    }
    .tree span {
      min-width: 70px;
      color: var(--muted);
      font-size: 12px;
    }
  </style>
</component>
