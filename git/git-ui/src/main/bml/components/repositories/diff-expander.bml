<component tag="git-diff-expander">
  <prop name="icon" type="String" required />
  <prop name="label" type="String" required />
  <script server provides="attrs">
    props.filterKeys { it !in setOf("icon", "label", "__bmlAttrs") }
  </script>
  <tooltip :content="label" placement="right">
    <html:button class="diff-expander" type="button" :aria-label="label" {...attrs}>
      <icon :name="icon" :size="13" />
    </html:button>
  </tooltip>
  <style scoped>
    /* Full-width gutter button that reveals hidden unchanged lines. */
    .diff-expander {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 22px;
      padding: 2px 0;
      border: 0;
      color: var(--fg-2);
      background: transparent;
      cursor: pointer;
    }
    .diff-expander:hover {
      color: var(--fg-0);
      background: color-mix(in oklch, var(--accent) 22%, transparent);
    }
    .diff-expander:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
    .diff-expander[aria-busy="true"] {
      cursor: progress;
      opacity: 0.6;
    }
  </style>
</component>
