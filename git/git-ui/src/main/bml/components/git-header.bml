<component tag="git-header">
  <prop name="signedIn" type="Boolean" default="true" />
  <script server provides="path">
    ctx.requestPath
  </script>
  <app-header brand="Bosca" product="Git" href="/repositories">
    <if signedIn>
      <div class="shell-subsystem git-subsystem">
        <span class="shell-subsystem-icon subsystem-icon">
          <icon name="branch" />
        </span>
        <div class="shell-subsystem-text subsystem-text">
          <strong>Git</strong>
          <p>Browse repositories, review pull requests, and search code</p>
        </div>
      </div>
      <nav class="shell-navigation git-navigation" aria-label="Git">
        <div class="shell-group nav-group">
          <span class="shell-label nav-label">Code</span>
          <git-search-link :active='path == "/search"' />
          <a
            href="/repositories"
            :aria-current='if (path.startsWith("/repositories")) "page" else "false"'
          >
            <span class="shell-icon nav-icon"><icon name="folder" :size="15" /></span>
            Repositories
          </a>
          <a href="/pulls" :aria-current='if (path.startsWith("/pulls")) "page" else "false"'>
            <span class="shell-icon nav-icon"><icon name="merge" :size="15" /></span>
            Pull Requests
          </a>
          <a href="/pipelines" :aria-current='if (path.startsWith("/pipelines")) "page" else "false"'>
            <span class="shell-icon nav-icon"><icon name="workflow" :size="15" /></span>
            Pipelines
          </a>
        </div>
        <div class="shell-group nav-group">
          <span class="shell-label nav-label">Tools</span>
          <a href="/compare" :aria-current='if (path == "/compare") "page" else "false"'>
            <span class="shell-icon nav-icon"><icon name="compare" :size="15" /></span>
            Compare
          </a>
          <a href="/statuses" :aria-current='if (path == "/statuses") "page" else "false"'>
            <span class="shell-icon nav-icon"><icon name="check" :size="15" /></span>
            Statuses
          </a>
        </div>
        <details
          class="shell-group nav-group shell-settings nav-settings"
          :open='path.startsWith("/ci-agents") || path.startsWith("/settings/")'
        >
          <summary class="shell-label nav-label">
            Settings
            <span class="shell-chevron nav-chevron"><icon name="chevron" :size="12" /></span>
          </summary>
          <a
            href="/ci-agents"
            :aria-current='if (path.startsWith("/ci-agents")) "page" else "false"'
          >
            <span class="shell-icon nav-icon"><icon name="wand" :size="15" /></span>
            CI Agents
          </a>
          <a
            href="/settings/github"
            :aria-current='if (path == "/settings/github") "page" else "false"'
          >
            <span class="shell-icon nav-icon"><icon name="users" :size="15" /></span>
            GitHub User Mappings
          </a>
        </details>
      </nav>
      <div class="shell-footer session-control">
        <git-profile-menu />
      </div>
    </if>
  </app-header>
</component>
