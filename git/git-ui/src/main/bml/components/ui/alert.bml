<component tag="ui-alert">
  <prop name="ref" type="String" default="" />
  <prop name="hidden" type="Boolean" default="false" />
  <prop name="tone" type="String" default="error" />
  <prop name="compact" type="Boolean" default="false" />
  <script server provides="attrs">
    props.filterKeys { it !in setOf("ref", "hidden", "tone", "compact", "__bmlAttrs") }
  </script>
  <p
    class="alert"
    role="alert"
    :data-tone="tone"
    :data-compact="compact"
    :ref="ref.takeIf(String::isNotBlank)"
    :hidden="hidden"
    {...attrs}
  >
    <slot />
  </p>
  <style scoped>
    .alert {
      color: var(--error-fg);
    }
    .alert[data-tone="success"] {
      color: var(--ok);
    }
    .alert[data-compact] {
      margin: 0;
      font-size: 12px;
      line-height: 18px;
    }
  </style>
</component>
