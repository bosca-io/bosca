<component tag="ui-tree">
  <prop name="label" type="String" required />
  <prop name="heading" type="String" default="" />
  <prop name="local" type="Boolean" default="false" />
  <section class="ui-tree" :data-local="local">
    <if heading.isNotBlank()>
      <h3>{ heading }</h3>
    </if>
    <div role="tree" :aria-label="label">
      <slot />
    </div>
  </section>
  <style scoped>
    .ui-tree {
      min-width: 0;
      max-height: 100%;
      overflow: auto;
      padding: 8px;
    }
    h3 {
      margin: 2px 6px 8px;
      color: var(--fg-3);
      font-size: 11px;
      font-weight: 600;
    }
    [role="tree"] {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    @media (max-width: 700px) {
      .ui-tree {
        max-height: 220px;
      }
    }
  </style>
  <script client scoped>
    import { keyboardTree } from "@client/tree";
    keyboardTree(ctx);
  </script>
</component>
