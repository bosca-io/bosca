<component tag="ui-input">
  <prop name="size" type="String" default="md" />
  <prop name="mono" type="Boolean" default="false" />
  <prop name="type" type="String" default="text" />
  <prop name="ref" type="String" default="" />
  <prop name="value" type="String" default="" />
  <prop name="required" type="Boolean" default="false" />
  <script server provides="attrs">
    props.filterKeys {
        it !in setOf("size", "mono", "class", "type", "ref", "value", "required", "__bmlAttrs")
    }
  </script>
  <input
    :class='"input size-" + size + " " + (if (mono) "mono " else "") + (props["class"] as? String).orEmpty()'
    :type="type"
    :ref="ref.takeIf(String::isNotBlank)"
    :value="value"
    :required="required"
    {...attrs}
  />
  <style scoped>
    .input.mono {
      font-family: var(--font-mono);
    }
    .input {
      width: 100%;
      min-width: 0;
      font: inherit;
      color: var(--fg-0);
      background: var(--control-bg);
      border: 1px solid var(--line-2);
      border-radius: var(--control-radius);
      height: 32px;
      padding: 0 10px;
      font-size: 13px;
      line-height: normal;
      outline: none;
    }
    .input.size-sm {
      height: 30px;
      font-size: 12.5px;
    }
    .input::placeholder {
      color: var(--fg-3);
    }
    .input:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 15%, transparent);
    }
  </style>
</component>
