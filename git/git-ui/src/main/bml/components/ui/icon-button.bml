<component tag="ui-icon-button">
  <prop name="icon" type="String" required />
  <prop name="label" type="String" required />
  <prop name="ref" type="String" default="" />
  <prop name="type" type="String" default="button" />
  <prop name="disabled" type="Boolean" default="false" />
  <prop name="size" type="String" default="sm" />
  <script server provides="attrs">
    props.filterKeys {
        it !in setOf("icon", "label", "ref", "type", "disabled", "size", "class", "__bmlAttrs")
    }
  </script>
  <ui-tooltip :content="label">
    <ui-button
      :class='"icon-only " + (props["class"] as? String).orEmpty()'
      :size="size"
      :icon="icon"
      :ref="ref"
      :type="type"
      :disabled="disabled"
      :aria-label="label"
      :title="label"
      {...attrs}
    />
  </ui-tooltip>
</component>
