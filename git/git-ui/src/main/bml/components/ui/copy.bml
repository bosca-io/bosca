<component tag="ui-copy">
  <prop name="value" type="String" required />
  <prop name="label" type="String" default="Copy" />
  <prop name="showStatus" type="Boolean" default="true" />
  <div class="copy-control">
    <ui-tooltip :content="label">
      <ui-button ref="copy" size="sm" class="icon-only" :aria-label="label" :data-copy="value">
        <span ref="idleIcon" class="copy-icon">
          <ui-icon name="copy" :size="14" />
        </span>
        <span ref="doneIcon" class="copy-icon" hidden>
          <ui-icon name="check" :size="14" />
        </span>
      </ui-button>
    </ui-tooltip>
    <span ref="message" :class='"copy-message" + if (showStatus) "" else " quiet"' role="status" />
  </div>
  <style scoped>
    .copy-control {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex: none;
    }
    .copy-icon {
      display: flex;
    }
    .copy-message {
      font-size: 12px;
    }
    .copy-message:empty {
      display: none;
    }
    .copy-message.quiet {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
  <script client scoped>
    import { clipboardCopy } from "@client/copy";
    clipboardCopy(ctx);
  </script>
</component>
