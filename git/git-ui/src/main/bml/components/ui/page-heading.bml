<component tag="ui-page-heading">
  <prop name="title" type="String" required />
  <prop name="subtitle" type="String" default="" />
  <prop name="trail" type="List<bosca.design.model.NavigationItem>" default="emptyList()" />
  <prop name="crumb" type="String" default="" />
  <prop name="icon" type="String" default="" />
  <prop name="iconColor" type="String" default="var(--accent)" />
  <prop name="badge" type="String" default="" />
  <prop name="badgeTone" type="String" default="neutral" />
  <prop name="badgeColor" type="String" default="" />
  <header class="page-heading">
    <div class="heading-copy">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <span>Git</span>
        <for item in trail>
          <span class="breadcrumb-separator" aria-hidden="true">/</span>
          <if item.href.isNotBlank()>
            <a :href="item.href">{ item.label }</a>
          <else>
            <span>{ item.label }</span>
          </if>
        </for>
        <span class="breadcrumb-separator" aria-hidden="true">/</span>
        <span class="breadcrumb-current" aria-current="page">{ crumb.ifBlank { title } }</span>
      </nav>
      <div class="heading-title">
        <if icon.isNotBlank()>
          <span class="title-mark" :style='"background: " + iconColor'>
            <ui-icon :name="icon" />
          </span>
        </if>
        <h1>{ title }</h1>
        <if badge.isNotBlank()>
          <ui-badge :tone="badgeTone" :color="badgeColor">{ badge }</ui-badge>
        </if>
        <if subtitle.isNotBlank()>
          <p class="heading-subtitle">{ subtitle }</p>
        </if>
      </div>
    </div>
    <div class="heading-actions"><slot /></div>
  </header>
  <style scoped>
    .page-heading {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 0 -4px 22px;
      padding: 18px 0 12px;
    }
    .heading-copy {
      flex: 1;
      min-width: 0;
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 4px;
      font-size: 12px;
      color: var(--fg-3);
    }
    .breadcrumb a {
      color: var(--fg-3);
      text-decoration: none;
    }
    .breadcrumb a:hover {
      color: var(--fg-1);
    }
    .breadcrumb-separator {
      color: var(--fg-4);
    }
    .breadcrumb-current {
      color: var(--fg-1);
    }
    .heading-title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 4px 10px;
      min-width: 0;
    }
    .title-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 36px;
      width: 36px;
      height: 36px;
      margin-right: 2px;
      border-radius: 10px;
      color: #fff;
    }
    h1 {
      margin: 0;
      min-width: 0;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      overflow-wrap: anywhere;
    }
    .heading-subtitle {
      margin: 0;
      font-size: 13px;
      color: var(--fg-3);
      overflow-wrap: anywhere;
    }
    .heading-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 8px;
      min-width: 0;
    }
    .heading-actions:empty {
      display: none;
    }
    @media (max-width: 600px) {
      .page-heading {
        flex-wrap: wrap;
        gap: 8px;
      }
      .heading-copy {
        flex-basis: 100%;
      }
      .heading-actions {
        justify-content: flex-start;
      }
    }
  </style>
</component>
