<component tag="ui-source-view">
  <prop name="content" type="String" required />
  <prop name="path" type="String" default="" />
  <prop name="compact" type="Boolean" default="false" />
  <prop name="bare" type="Boolean" default="false" />
  <script server provides="widgetClass">
    "code-widget" +
        if (compact) {
            " compact-code " +
                when {
                    content.lines().size <= 3 -> "snippet-short"
                    content.lines().size <= 8 -> "snippet-medium"
                    else -> "snippet-long"
                }
        } else if (bare) " bare-code" else ""
  </script>
  <section :class="widgetClass" :data-path="path">
    <if !bare>
      <div class="toolbar source-toolbar">
        <slot />
        <ui-icon-button ref="wrap" icon="wrap" label="Toggle line wrapping" aria-pressed="false" />
        <span class="muted editor-mode" title="Escape then Tab leaves the editor">Read-only</span>
      </div>
    </if>
    <textarea ref="content" hidden>{ content }</textarea>
    <div ref="editor" class="code-editor">
      <pre ref="fallback" class="source"><code>{ content }</code></pre>
    </div>
  </section>
  <style scoped>
    .code-widget.compact-code {
      flex: none;
      min-height: 0;
      height: 240px;
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
    }
    .code-widget.snippet-short {
      height: 110px;
    }
    .code-widget.snippet-medium {
      height: 180px;
    }
    /* Embedded in a file card, sized like Studio's file viewer. */
    .code-widget.bare-code {
      flex: none;
      min-height: 225px;
      max-height: 800px;
    }
    .source-toolbar {
      padding: 8px 12px;
      gap: 8px;
      border-bottom: 1px solid var(--line);
    }
    .editor-mode {
      margin-left: auto;
      font-size: 11px;
    }
    .source {
      margin: 0;
      padding: 16px;
      font: 13px/1.7 var(--font-mono);
      tab-size: 2;
    }
  </style>
  <script client scoped>
    import { mountCodeEditor } from "@client/editor";
    ctx.ref("fallback")?.remove();
    mountCodeEditor(ctx, true);
  </script>
</component>
