<component tag="ui-search-input">
  <prop name="value" type="String" default="" />
  <prop name="name" type="String" default="q" />
  <prop name="placeholder" type="String" default="Search…" />
  <prop name="label" type="String" default="Search" />
  <prop name="preserveKey" type="String" default="" />
  <prop name="disabled" type="Boolean" default="false" />
  <div
    class="search-input"
    :data-bml-preserve="preserveKey.takeIf(String::isNotBlank)"
    :data-placeholder="placeholder"
  >
    <span class="search-icon">
      <icon name="search" :size="16" />
    </span>
    <html:input
      ref="query"
      type="search"
      :name="name"
      :value="value"
      :placeholder="placeholder"
      :aria-label="label"
      :disabled="disabled"
      autocomplete="off"
      spellcheck="false"
      autofocus
    />
    <div class="search-actions">
      <icon-button
        ref="clear"
        icon="close"
        label="Clear search"
        :hidden="value.isBlank()"
        :disabled="disabled"
      />
      <slot />
    </div>
  </div>
  <style scoped>
    .search-input {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      min-width: 0;
      height: 40px;
      padding: 0 4px 0 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--bg-0);
    }
    .search-input:focus-within {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 10%, transparent);
    }
    .search-icon {
      display: flex;
      color: var(--accent);
      flex: none;
    }
    input {
      flex: 1;
      min-width: 0;
      height: 36px;
      padding: 0;
      border: 0;
      outline: none;
      background: transparent;
      color: var(--fg-0);
      font: inherit;
      font-size: 14px;
    }
    input::placeholder {
      color: var(--fg-3);
    }
    input::-webkit-search-cancel-button {
      display: none;
    }
    .search-actions {
      display: flex;
      align-items: center;
      gap: 4px;
      flex: none;
    }
  </style>
  <script client scoped>
    const input = ctx.ref<HTMLInputElement>("query"),
      clear = ctx.ref<HTMLButtonElement>("clear");
    const sync = () => {
      if (clear && input) clear.hidden = !input.value;
      if (input) input.placeholder = ctx.root.dataset.placeholder ?? "Search…";
    };
    if (input) ctx.on(input, "input", sync);
    if (clear && input)
      ctx.on(clear, "click", () => {
        input.value = "";
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.focus();
      });
    ctx.onUpdate(sync);
    ctx.on<CustomEvent<{ target: Element }>>(document, "bml:update", (event) => {
      if (event.detail?.target.contains(ctx.root)) sync();
    });
    sync();
  </script>
</component>
