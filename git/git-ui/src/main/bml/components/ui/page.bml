<component tag="ui-page">
  <prop name="fill" type="Boolean" default="false" />
  <prop name="narrow" type="Boolean" default="false" />
  <script server provides="attrs">
    props.filterKeys { it !in setOf("fill", "narrow", "__bmlAttrs") }
  </script>
  <main
    :class='"page" + (if (fill) " page-fill" else "") + (if (narrow) " page-narrow" else "")'
    {...attrs}
  >
    <slot />
  </main>
  <style scoped>
    .page {
      padding: 22px;
      width: 100%;
      min-width: 0;
      flex: 1;
      overflow: auto;
    }
    .page-fill {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .page-narrow {
      width: min(100% - 40px, 400px);
      margin: 64px auto;
      padding: 0;
    }
    @media (max-width: 600px) {
      .page:not(.page-narrow) {
        padding: 20px 16px;
      }
    }
  </style>
</component>
