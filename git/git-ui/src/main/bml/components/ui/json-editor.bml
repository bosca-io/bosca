<component tag="ui-json-editor">
  <prop name="name" type="String" required />
  <prop name="value" type="String" default="{}" />
  <div :data-bml-preserve='"json-" + name'>
    <div class="json-editor">
      <html:input type="hidden" :name="name" :value="value" ref="value" />
      <div ref="editor" />
    </div>
  </div>
  <style scoped>
    .json-editor {
      min-height: 240px;
      --jse-theme-color: #7c5cff;
      --jse-theme-color-highlight: #947dff;
      --jse-background-color: #161a25;
      --jse-text-color: #e5e7eb;
      --jse-panel-background: #242938;
      --jse-panel-color: #e5e7eb;
      --jse-main-border: 1px solid #3a4050;
      --jse-font-family-mono: var(--font-mono);
    }
  </style>
  <script client scoped>
    import { mountJsonEditor } from "@client/json-editor";
    mountJsonEditor(ctx);
  </script>
</component>
