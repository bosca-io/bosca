<component tag="ui-segmented-control">
  <prop name="label" type="String" required />
  <prop name="name" type="String" required />
  <prop name="options" type="List<String>" required />
  <prop name="values" type="List<String>" default="emptyList()" />
  <prop name="icons" type="List<String>" default="emptyList()" />
  <prop name="value" type="String" required />
  <prop name="preserveKey" type="String" default="" />
  <div
    class="segmented-control"
    role="radiogroup"
    :aria-label="label"
    :data-bml-preserve="preserveKey.takeIf(String::isNotBlank)"
  >
    <input ref="value" type="hidden" :name="name" :value="value" />
    <for index in options.indices>
      <button
        type="button"
        role="radio"
        :data-value="(values.getOrNull(index) ?: options[index])"
        :aria-checked="((values.getOrNull(index) ?: options[index]) == value).toString()"
        :tabindex="if ((values.getOrNull(index) ?: options[index]) == value) 0 else -1"
      >
        <if icons.getOrNull(index).orEmpty().isNotBlank()>
          <ui-icon :name="icons[index]" :size="12" />
        </if>
        { options[index] }
      </button>
    </for>
  </div>
  <style scoped>
    .segmented-control {
      display: inline-flex;
      gap: 2px;
      height: 30px;
      align-items: center;
      padding: 2px;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: var(--bg-0);
    }
    button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 24px;
      padding: 0 10px;
      border: 0;
      border-radius: 4px;
      color: var(--fg-2);
      background: transparent;
      font: inherit;
      font-size: 12px;
      font-weight: 500;
      line-height: normal;
      cursor: pointer;
    }
    button:hover {
      background: var(--bg-2);
    }
    button[aria-checked="true"] {
      background: var(--bg-3);
      color: var(--fg-0);
    }
    button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
  </style>
  <script client scoped>
    const choose = (button: HTMLButtonElement) => {
      const value = ctx.ref<HTMLInputElement>("value");
      if (value) value.value = button.dataset.value ?? "";
      for (const option of ctx.root.querySelectorAll<HTMLButtonElement>(
        "[role=radio]",
      )) {
        option.setAttribute("aria-checked", String(option === button));
        option.tabIndex = option === button ? 0 : -1;
      }
      ctx.root.dispatchEvent(new CustomEvent("segmentchange", { bubbles: true }));
    };
    ctx.on<MouseEvent>(ctx.root, "click", (event) => {
      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("[role=radio]")
          : null;
      if (button) choose(button);
    });
    ctx.on<KeyboardEvent>(ctx.root, "keydown", (event) => {
      const options = [
        ...ctx.root.querySelectorAll<HTMLButtonElement>("[role=radio]"),
      ];
      const index = options.indexOf(document.activeElement as HTMLButtonElement);
      if (
        index < 0 ||
        !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)
      )
        return;
      event.preventDefault();
      const button =
        options[
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? options.length - 1
              : (index + (event.key === "ArrowRight" ? 1 : options.length - 1)) %
                options.length
        ];
      if (button) {
        choose(button);
        button.focus();
      }
    });
  </script>
</component>
