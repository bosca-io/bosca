<component tag="ui-app-header">
  <prop name="brand" type="String" required />
  <prop name="product" type="String" default="" />
  <prop name="href" type="String" required />
  <header class="app-header">
    <a class="brand" :href="href">
      <ui-bosca-mark />
      <span>
        { brand }
        <if product.isNotBlank()>
          <span class="brand-separator">/</span>
          { product }
        </if>
      </span>
    </a>
    <slot />
  </header>
  <style scoped>
    .app-header {
      width: 224px;
      flex: 0 0 224px;
      display: flex;
      flex-direction: column;
      padding: 0 12px 16px;
      min-height: 0;
      overflow: auto;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 30px 8px 23px;
      font-size: 13px;
      color: var(--fg-0);
      font-weight: 600;
      text-decoration: none;
    }
    .brand-separator {
      color: var(--fg-4);
      margin: 0 6px;
    }
    @media (max-width: 700px) {
      .app-header {
        width: 100%;
        flex: none;
        flex-direction: row;
        align-items: center;
        flex-wrap: wrap;
        gap: 0 12px;
        padding: 0 16px;
        overflow: visible;
        border-bottom: 1px solid var(--line);
        background: var(--bg-1);
      }
      .brand {
        padding: 14px 0;
      }
    }
  </style>
  <script client scoped>
    const revealActive = () => {
      if (!ctx.root.isConnected) return;
      for (const nav of ctx.root.querySelectorAll<HTMLElement>("nav")) {
        if (nav.scrollWidth <= nav.clientWidth) continue;
        const active = nav.querySelector<HTMLElement>('a[aria-current="page"]');
        if (!active) continue;
        const bounds = nav.getBoundingClientRect();
        const item = active.getBoundingClientRect();
        nav.scrollLeft += item.left - bounds.left - (bounds.width - item.width) / 2;
      }
    };
    ctx.on(window, "resize", revealActive);
    ctx.onUpdate(revealActive);
    void document.fonts.ready.then(revealActive);
    revealActive();
  </script>
</component>
