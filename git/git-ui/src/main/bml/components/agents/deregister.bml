<component tag="git-agent-deregister">
  <prop name="page" type="bosca.git.ui.AgentPage" required />
  <script server provides="model">
    bosca.git.ui.AgentRegistrationModel(page)
  </script>
  <island name="git-agent-deregister" :key="page.selected?.id.orEmpty()">
    <div class="agent-deregister" :data-next-href="model.nextHref">
      <ui-confirm-dialog
        title="Deregister CI agent"
        description="The agent's token will be revoked and it will no longer accept jobs."
        triggerLabel="Deregister"
        :triggerIconOnly="false"
        :forceOpen="model.failed"
      >
        <form class="modal-form" @submit="model.deregister(model.page.selected?.id.orEmpty(), true, ctx)">
          <if model.failed>
            <div class="modal-fields"><ui-alert>{ model.message }</ui-alert></div>
          </if>
          <footer class="modal-footer">
            <ui-button ref="cancel">Cancel</ui-button>
            <ui-button type="submit" class="danger">Deregister agent</ui-button>
          </footer>
        </form>
      </ui-confirm-dialog>
    </div>
  </island>
  <style scoped>
    .agent-deregister {
      display: contents;
    }
  </style>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
