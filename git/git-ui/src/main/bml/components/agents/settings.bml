<component tag="git-agent-settings">
  <prop name="page" type="bosca.git.ui.AgentPage" required />
  <script server provides="model">
    bosca.git.ui.AgentSettingsModel(page)
  </script>
  <island name="git-agent-settings" :key='page.selected?.id ?: ""'>
    <section class="settings-stack" :data-next-href="model.nextHref">
      <if model.message.isNotBlank()>
        <ui-alert :tone='if (model.failed) "error" else "success"'>{ model.message }</ui-alert>
      </if>
      <ui-card :padded="false">
        <ui-section-heading title="Agent settings" subtitle="Name and scheduling labels." />
        <form class="settings-form" @submit="model.save(form.name, form.labels, ctx)">
          <div class="section-body detail-fields">
            <ui-field label="Name">
              <ui-input name="name" :value="model.name" required />
            </ui-field>
            <ui-field label="Labels">
              <ui-input name="labels" :value="model.labels" />
            </ui-field>
          </div>
          <footer class="section-footer">
            <ui-button type="submit" primary>Save agent</ui-button>
          </footer>
        </form>
      </ui-card>
      <if model.page.selected?.mode?.name == "ORCHESTRATOR">
        <ui-card :padded="false">
          <ui-section-heading
            title="Orchestrator configuration"
            subtitle="Provider defaults, VM limits and runner configuration."
          />
          <p class="section-body detail-note">
            Provider API credentials are supplied by the CLI's local configuration.
          </p>
          <form
            class="settings-form"
            @submit="model.configure(form.provider, form.scope, form.region, form.size, form.image, form.profiles, form.sinks, form.concurrent, form.jobTimeout, form.lifetime, ctx)"
          >
            <div class="section-body detail-fields">
              <ui-field label="Provider">
                <ui-input name="provider" :value="model.provider" required />
              </ui-field>
              <ui-field label="Self-destruct token scope">
                <ui-input name="scope" :value="model.scope" />
              </ui-field>
              <ui-field label="Default region">
                <ui-input name="region" :value="model.region" required />
              </ui-field>
              <ui-field label="Default VM size">
                <ui-input name="size" :value="model.size" required />
              </ui-field>
              <ui-field label="Default VM image">
                <ui-input name="image" :value="model.image" required />
              </ui-field>
              <div class="full-width">
                <ui-field label="Runner profiles">
                  <ui-json-editor name="profiles" :value="model.profiles" />
                </ui-field>
              </div>
              <div class="full-width">
                <ui-field label="Alert sinks">
                  <ui-json-editor name="sinks" :value="model.sinks" />
                </ui-field>
              </div>
              <ui-field label="Maximum concurrent VMs">
                <ui-input
                  name="concurrent"
                  type="number"
                  min="1"
                  :value="model.concurrent.toString()"
                  required
                />
              </ui-field>
              <ui-field label="Maximum job timeout (minutes)">
                <ui-input
                  name="jobTimeout"
                  type="number"
                  min="1"
                  :value="model.jobTimeout.toString()"
                  required
                />
              </ui-field>
              <ui-field label="Maximum VM lifetime (minutes)">
                <ui-input
                  name="lifetime"
                  type="number"
                  min="1"
                  :value="model.lifetime.toString()"
                  required
                />
              </ui-field>
            </div>
            <footer class="section-footer">
              <ui-button type="submit" primary>Save orchestrator</ui-button>
            </footer>
          </form>
        </ui-card>
      </if>
    </section>
  </island>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
