<component tag="git-agent-status">
  <prop name="agent" type="bosca.git.ui.graphql.GitUiAgentsData.Git.PipelineAgents" required />
  <script server provides="model">
    bosca.git.ui.AgentStatusModel(agent)
  </script>
  <island name="git-agent-status" :key="agent.id">
    <section class="settings-stack" :data-agent-active="model.active">
      <if model.message.isNotBlank()>
        <ui-alert>{ model.message }</ui-alert>
      </if>
      <ui-card :padded="false">
        <ui-section-heading title="Agent status" subtitle="Connection and lifecycle details.">
          <ui-button size="sm" icon="refresh" @click="model.refresh(ctx)">Refresh status</ui-button>
        </ui-section-heading>
        <div class="section-body">
          <span ref="error" role="status" />
          <dl class="info-grid">
            <div>
              <dt>Status</dt>
              <dd>
                <git-status-badge :status="model.agent.status.name" />
              </dd>
            </div>
            <div>
              <dt>Mode</dt>
              <dd>{ model.agent.mode.name.lowercase().replaceFirstChar(Char::uppercase) }</dd>
            </div>
            <div>
              <dt>Last heartbeat</dt>
              <dd>
                <if model.agent.lastHeartbeat != null>
                  <ui-time :value="model.agent.lastHeartbeat.orEmpty()" />
                <else>
                  Never
                </if>
              </dd>
            </div>
            <div>
              <dt>Created</dt>
              <dd>
                <ui-time :value="model.agent.created" />
              </dd>
            </div>
            <div>
              <dt>Expires</dt>
              <dd>
                <if model.agent.expiresAt != null>
                  <ui-time :value="model.agent.expiresAt.orEmpty()" />
                <else>
                  —
                </if>
              </dd>
            </div>
            <div>
              <dt>Ephemeral</dt>
              <dd>{ if (model.agent.ephemeral) "Yes" else "No" }</dd>
            </div>
            <div>
              <dt>Agent ID</dt>
              <dd>
                <code>{ model.agent.id }</code>
              </dd>
            </div>
            <if model.agent.instanceId != null>
              <div>
                <dt>Instance</dt>
                <dd>
                  <code>{ model.agent.instanceId }</code>
                </dd>
              </div>
            </if>
            <if model.agent.parentAgentId != null>
              <div>
                <dt>Parent agent</dt>
                <dd>
                  <a
                    :href='"/ci-agents/" + bosca.git.ui.encode(model.agent.parentAgentId.orEmpty())'
                  >
                    { model.agent.parentAgentId }
                  </a>
                </dd>
              </div>
            </if>
          </dl>
        </div>
      </ui-card>
      <ui-card :padded="false">
        <ui-section-heading title="Current job" subtitle="Commands assigned to this agent." />
        <if model.agent.currentJob == null>
          <ui-empty-state
            icon="workflow"
            title="No current job"
            message="An assigned job and its commands will appear here."
          />
        <else>
          <for current in listOfNotNull(model.agent.currentJob)>
            <div class="section-body current-job">
              <div class="detail-heading">
                <h3>
                  <a :href="bosca.git.ui.runHref(current.pipelineRunId)">{ current.name }</a>
                </h3>
                <git-status-badge :status="current.status.name" />
              </div>
              <p class="detail-note">
                { "Runner " + current.runnerLabel + " · Timeout " + (current.timeoutMinutes?.toString() ?: "—") + " minutes" }
              </p>
              <if current.dependsOn.isNotEmpty()>
                <p class="detail-note">{ "Depends on " + current.dependsOn.joinToString(", ") }</p>
              </if>
              <if current.matrixValues != null>
                <pre>{ current.matrixValues }</pre>
              </if>
              <for step in current.steps>
                <article class="command-step">
                  <div class="detail-heading">
                    <h3>{ step.name }</h3>
                    <git-status-badge :status="step.status.name" />
                  </div>
                  <if step.exitCode != null>
                    <p class="detail-note">{ "Exit code " + step.exitCode }</p>
                  </if>
                  <if step.run != null>
                    <ui-source-view :content="step.run" path="command.sh" compact />
                  </if>
                  <if step.uses != null>
                    <p class="detail-note">Uses <code>{ step.uses }</code></p>
                  </if>
                  <if step.image != null>
                    <p class="detail-note">Image <code>{ step.image }</code></p>
                  </if>
                  <if step.condition != null>
                    <p class="detail-note">Condition <code>{ step.condition }</code></p>
                  </if>
                  <if step.workingDirectory != null>
                    <p class="detail-note">
                      Working directory
                      <code>{ step.workingDirectory }</code>
                    </p>
                  </if>
                </article>
              </for>
            </div>
          </for>
        </if>
      </ui-card>
      <ui-card :padded="false">
        <ui-section-heading title="Recent jobs" subtitle="Previous assignments for this agent." />
        <if model.agent.recentJobs.orEmpty().isEmpty()>
          <ui-empty-state
            icon="workflow"
            title="No recent jobs"
            message="Completed assignments will appear here."
          />
        <else>
          <ui-table-scroll>
            <table>
              <thead>
                <tr>
                  <th>Job</th>
                  <th>Status</th>
                  <th>Started</th>
                  <th>Finished</th>
                </tr>
              </thead>
              <tbody>
                <for job in model.agent.recentJobs.orEmpty()>
                  <tr>
                    <td>
                      <a :href="bosca.git.ui.runHref(job.pipelineRunId)">{ job.name }</a>
                    </td>
                    <td>
                      <git-status-badge :status="job.status.name" />
                    </td>
                    <td>
                      <if job.started != null>
                        <ui-time :value="job.started" />
                      <else>
                        —
                      </if>
                    </td>
                    <td>
                      <if job.finished != null>
                        <ui-time :value="job.finished" />
                      <else>
                        —
                      </if>
                    </td>
                  </tr>
                </for>
              </tbody>
            </table>
          </ui-table-scroll>
        </if>
      </ui-card>
    </section>
  </island>
  <style scoped>
    .command-step {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }
    .command-step .detail-heading {
      margin-bottom: 12px;
    }
    pre {
      overflow: auto;
      font-size: 12px;
    }
  </style>
  <script client scoped>
    let busy = false,
      disposed = false;
    const timer = setInterval(async () => {
      if (disposed || busy || !ctx.root.querySelector("[data-agent-active]"))
        return;
      busy = true;
      try {
        await ctx.dispatch("model", "refresh");
      } catch (error) {
        const target = ctx.ref<HTMLElement>("error");
        if (target)
          target.textContent =
            error instanceof Error ? error.message : "Refresh failed.";
      } finally {
        busy = false;
      }
    }, 5000);
    ctx.onUnmount(() => {
      disposed = true;
      clearInterval(timer);
    });
  </script>
</component>
