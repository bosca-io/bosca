<component tag="git-verify-form">
  <div class="auth-flow">
    <ui-alert ref="error" hidden />
    <p ref="notice" class="auth-notice" role="status" hidden></p>
    <p ref="email" class="auth-copy"></p>
    <ui-button ref="resend" class="auth-primary">Resend verification email</ui-button>
    <p class="auth-footer">
      <a ref="signup" href="/auth/signup">Use a different email</a>
    </p>
    <p class="auth-footer">Already verified? <a ref="login" href="/login">Sign in</a></p>
  </div>
  <script client scoped>
    const error = ctx.ref<HTMLParagraphElement>("error");
    const notice = ctx.ref<HTMLParagraphElement>("notice");
    let mounted = true;
    let busy = false;

    ctx.onUnmount(() => {
      mounted = false;
    });

    function show(element: HTMLElement | null, message: string) {
      if (!mounted || !element) return;
      element.textContent = message;
      element.hidden = false;
    }

    async function run(
      action: () => Promise<void>,
      fallback: string,
      button: HTMLButtonElement | null = null,
    ) {
      if (busy) return false;
      busy = true;
      const label = button?.textContent ?? "";
      if (button) {
        button.disabled = true;
        button.textContent = "Please wait…";
      }
      if (error) error.hidden = true;
      try {
        await action();
        return true;
      } catch (reason) {
        if (!mounted) return false;
        const message = gitAuthFlow.failure(reason, fallback);
        if (message) show(error, message);
        return false;
      } finally {
        busy = false;
        if (mounted) {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
        }
      }
    }

    const signupLink = ctx.ref<HTMLAnchorElement>("signup");
    if (signupLink) signupLink.href = gitAuthFlow.url("/auth/signup");
    const loginLink = ctx.ref<HTMLAnchorElement>("login");
    if (loginLink) loginLink.href = gitAuthFlow.url("/login");

    const identifier = gitAuthFlow.email;
    show(
      ctx.ref<HTMLElement>("email"),
      identifier
        ? `We sent a verification link to ${identifier}.`
        : "Open the verification link from your email, or start again with your email address.",
    );
    const resend = ctx.ref<HTMLButtonElement>("resend");
    let cooldown: ReturnType<typeof setInterval> | undefined;
    ctx.onUnmount(() => {
      if (cooldown) clearInterval(cooldown);
    });

    if (resend) {
      resend.disabled = !identifier;
      ctx.on(resend, "click", async () => {
        const sent = await run(
          async () => {
            await gitAuthFlow.resendVerification();
            show(notice, "A new verification email is on its way.");
          },
          "We couldn't resend the verification email. Please try again.",
          resend,
        );
        if (!sent || !mounted) return;
        let seconds = 30;
        resend.disabled = true;
        resend.textContent = `Resend in ${seconds}s`;
        cooldown = setInterval(() => {
          seconds -= 1;
          resend.textContent = seconds
            ? `Resend in ${seconds}s`
            : "Resend verification email";
          if (!seconds) {
            resend.disabled = false;
            clearInterval(cooldown);
          }
        }, 1000);
      });
    }
    if (gitAuthFlow.params.get("token")) {
      void run(
        () => gitAuthFlow.verifyEmail(),
        "This verification link could not be used. Request a new email and try again.",
        null,
      );
    }
  </script>
</component>
