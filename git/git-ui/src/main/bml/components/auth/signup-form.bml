<component tag="git-signup-form">
  <div class="auth-flow">
    <git-auth-providers />
    <ui-alert ref="error" hidden />
    <form ref="form" class="auth-form">
      <div class="auth-name-grid">
        <ui-field label="First name">
          <ui-input
            ref="firstName"
            name="firstName"
            type="text"
            autocomplete="given-name"
            required
          />
        </ui-field>
        <ui-field label="Last name">
          <ui-input
            ref="lastName"
            name="lastName"
            type="text"
            autocomplete="family-name"
            required
          />
        </ui-field>
      </div>
      <ui-field label="Email">
        <ui-input ref="identifier" name="identifier" type="email" autocomplete="email" required />
      </ui-field>
      <ui-field label="Password">
        <ui-input
          ref="password"
          name="password"
          type="password"
          autocomplete="new-password"
          required
        />
      </ui-field>
      <p ref="strength" class="password-strength" role="status">Use a long, unique password.</p>
      <ui-button ref="submit" type="submit" class="auth-primary">Create account</ui-button>
    </form>
    <p class="auth-footer">Already have an account? <a ref="login" href="/login">Sign in</a></p>
  </div>
  <script client scoped>
    import { passwordStrength } from "@client/auth";

    const form = ctx.ref<HTMLFormElement>("form");
    const submit = ctx.ref<HTMLButtonElement>("submit");
    const error = ctx.ref<HTMLParagraphElement>("error");
    const value = (name: string) => ctx.ref<HTMLInputElement>(name)?.value ?? "";
    let mounted = true;
    let busy = false;

    ctx.onUnmount(() => {
      mounted = false;
    });

    function show(element: HTMLElement | null, message: string) {
      if (!mounted || !element) return;
      element.textContent = message;
      element.hidden = false;
    }

    async function run(
      action: () => Promise<void>,
      fallback: string,
      button = submit,
    ) {
      if (busy) return false;
      busy = true;
      const label = button?.textContent ?? "";
      if (button) {
        button.disabled = true;
        button.textContent = "Please wait…";
      }
      form?.setAttribute("aria-busy", "true");
      if (error) error.hidden = true;
      try {
        await action();
        return true;
      } catch (reason) {
        if (!mounted) return false;
        const message = gitAuthFlow.failure(reason, fallback);
        if (message) show(error, message);
        return false;
      } finally {
        busy = false;
        if (mounted) {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
          form?.removeAttribute("aria-busy");
        }
      }
    }

    const loginLink = ctx.ref<HTMLAnchorElement>("login");
    if (loginLink) loginLink.href = gitAuthFlow.url("/login");

    const password = ctx.ref<HTMLInputElement>("password");
    const strength = ctx.ref<HTMLParagraphElement>("strength");
    if (password && strength) {
      ctx.on(password, "input", () => {
        strength.textContent = passwordStrength(password.value);
      });
    }
    if (form) {
      ctx.on<SubmitEvent>(form, "submit", (event) => {
        event.preventDefault();
        void run(
          () =>
            gitAuthFlow.signUp(
              value("identifier"),
              value("password"),
              value("firstName"),
              value("lastName"),
            ),
          "We couldn't create your account. Please try again.",
        );
      });
    }
    void gitAuthFlow.ready.then((failure) => {
      if (!mounted || gitAuthFlow.redirecting) return;
      if (failure)
        show(
          error,
          gitAuthFlow.failure(
            failure,
            "Sign-in could not be completed. Please try again.",
          ) ?? "",
        );
      else if (gitAuth.isAuthenticated && !gitAuthFlow.params.has("unauthorized"))
        gitAuthFlow.finish();
    });
  </script>
</component>
