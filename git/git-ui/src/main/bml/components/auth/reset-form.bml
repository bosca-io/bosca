<component tag="git-reset-form">
  <div class="auth-flow">
    <alert ref="error" hidden />
    <form ref="form" class="auth-form">
      <field label="New password">
        <input
          ref="password"
          name="password"
          type="password"
          autocomplete="new-password"
          required
        />
      </field>
      <p ref="strength" class="password-strength" role="status">Use a long, unique password.</p>
      <field label="Confirm password">
        <input
          ref="confirmPassword"
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          required
        />
      </field>
      <button ref="submit" type="submit" class="auth-primary">Reset password</button>
    </form>
    <p class="auth-footer">
      <a ref="forgot" href="/auth/forgot">Request a new reset link</a>
    </p>
    <p class="auth-footer">
      <a ref="login" href="/login">Back to sign in</a>
    </p>
  </div>
  <script client scoped>
    import { passwordStrength } from "@client/auth";

    const form = ctx.ref<HTMLFormElement>("form");
    const submit = ctx.ref<HTMLButtonElement>("submit");
    const error = ctx.ref<HTMLParagraphElement>("error");
    const value = (name: string) => ctx.ref<HTMLInputElement>(name)?.value ?? "";
    let mounted = true;
    let busy = false;

    ctx.onUnmount(() => {
      mounted = false;
    });

    function show(element: HTMLElement | null, message: string) {
      if (!mounted || !element) return;
      element.textContent = message;
      element.hidden = false;
    }

    async function run(
      action: () => Promise<void>,
      fallback: string,
      button = submit,
    ) {
      if (busy) return false;
      busy = true;
      const label = button?.textContent ?? "";
      if (button) {
        button.disabled = true;
        button.textContent = "Please wait…";
      }
      form?.setAttribute("aria-busy", "true");
      if (error) error.hidden = true;
      try {
        await action();
        return true;
      } catch (reason) {
        if (!mounted) return false;
        const message = gitAuthFlow.failure(reason, fallback);
        if (message) show(error, message);
        return false;
      } finally {
        busy = false;
        if (mounted) {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
          form?.removeAttribute("aria-busy");
        }
      }
    }

    const forgotLink = ctx.ref<HTMLAnchorElement>("forgot");
    if (forgotLink) forgotLink.href = gitAuthFlow.url("/auth/forgot");
    const loginLink = ctx.ref<HTMLAnchorElement>("login");
    if (loginLink) loginLink.href = gitAuthFlow.url("/login");

    const password = ctx.ref<HTMLInputElement>("password");
    const strength = ctx.ref<HTMLParagraphElement>("strength");
    if (password && strength) {
      ctx.on(password, "input", () => {
        strength.textContent = passwordStrength(password.value);
      });
    }
    if (!gitAuthFlow.params.get("token")) {
      if (form) form.hidden = true;
      show(error, "This reset link is missing its token. Request a new link.");
    }
    if (form) {
      ctx.on<SubmitEvent>(form, "submit", (event) => {
        event.preventDefault();
        if (value("password") !== value("confirmPassword")) {
          show(error, "The passwords don't match.");
          return;
        }
        void run(
          () => gitAuthFlow.resetPassword(value("password")),
          "This reset link could not be used. Request a new link and try again.",
        );
      });
    }
  </script>
</component>
