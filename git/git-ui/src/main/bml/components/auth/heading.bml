    <h1>{ title }</h1>
    <p>{ sub }</p>
  </div>
  <style scoped>
    .auth-heading {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    span {
      color: #a995ff;
      font: 600 11px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }
    h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    p {
      margin: 0;
