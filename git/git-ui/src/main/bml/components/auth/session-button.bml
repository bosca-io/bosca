<component tag="git-session-button">
  <ui-button ref="signout" disabled>Sign out</ui-button>
  <script client scoped>
    const button = ctx.ref<HTMLButtonElement>("signout");
    if (button) button.disabled = false;
    if (button)
      ctx.on(button, "click", async () => {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        try {
          await gitAuth.signOut();
          location.assign("/login");
        } catch (error) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          const label = button.querySelector(".button-content");
          if (label) label.textContent = "Retry sign out";
          console.error("Sign out failed", error);
        }
      });
  </script>
</component>
