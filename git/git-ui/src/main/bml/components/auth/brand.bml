<component tag="git-auth-brand">
  <aside class="brand-panel">
    <div class="orbs" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <svg class="ring-svg" viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="auth-glass-ring" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7c5cff" stop-opacity="0.4" />
            <stop offset="1" stop-color="#5ec5ff" stop-opacity="0" />
          </linearGradient>
        </defs>
        <circle cx="320" cy="420" r="180" fill="none" stroke="url(#auth-glass-ring)" />
        <circle
