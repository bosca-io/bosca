<component tag="git-link-form">
  <div class="auth-flow">
    <ui-alert ref="error" hidden />
    <p ref="notice" class="auth-notice" role="status" hidden></p>
    <form ref="form" class="auth-form" hidden>
      <ui-field label="Existing account password">
        <ui-input
          ref="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </ui-field>
      <ui-button ref="submit" type="submit" class="auth-primary">Confirm and sign in</ui-button>
    </form>
    <ui-button ref="emailProof" hidden>Send an email confirmation link</ui-button>
    <p class="auth-footer">
      <a ref="login" href="/login">Back to sign in</a>
    </p>
  </div>
  <script client scoped>
    const form = ctx.ref<HTMLFormElement>("form");
    const submit = ctx.ref<HTMLButtonElement>("submit");
    const error = ctx.ref<HTMLParagraphElement>("error");
    const notice = ctx.ref<HTMLParagraphElement>("notice");
    const value = (name: string) => ctx.ref<HTMLInputElement>(name)?.value ?? "";
    let mounted = true;
    let busy = false;

    ctx.onUnmount(() => {
      mounted = false;
    });

    function show(element: HTMLElement | null, message: string) {
      if (!mounted || !element) return;
      element.textContent = message;
      element.hidden = false;
    }

    async function run(
      action: () => Promise<void>,
      fallback: string,
      button = submit,
    ) {
      if (busy) return false;
      busy = true;
      const label = button?.textContent ?? "";
      if (button) {
        button.disabled = true;
        button.textContent = "Please wait…";
      }
      form?.setAttribute("aria-busy", "true");
      if (error) error.hidden = true;
      try {
        await action();
        return true;
      } catch (reason) {
        if (!mounted) return false;
        const message = gitAuthFlow.failure(reason, fallback);
        if (message) show(error, message);
        return false;
      } finally {
        busy = false;
        if (mounted) {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
          form?.removeAttribute("aria-busy");
        }
      }
    }

    const loginLink = ctx.ref<HTMLAnchorElement>("login");
    if (loginLink) loginLink.href = gitAuthFlow.url("/login");

    const token = gitAuthFlow.params.get("token");
    const proof = gitAuthFlow.params.get("proof");
    const methods = gitAuthFlow.linkMethods;
    const emailProof = ctx.ref<HTMLButtonElement>("emailProof");

    if (proof) {
      void run(
        () => gitAuthFlow.confirmEmail(),
        "This confirmation link could not be used. Start again from sign in.",
      );
    } else if (!token) {
      show(
        error,
        "This account confirmation link is incomplete. Start again from sign in.",
      );
    } else {
      if (form && methods.includes("PASSWORD")) {
        form.hidden = false;
        ctx.on<SubmitEvent>(form, "submit", (event) => {
          event.preventDefault();
          void run(
            () => gitAuthFlow.confirmPassword(value("password")),
            "We couldn't confirm your account. Check your password and try again.",
          );
        });
      }
      if (emailProof && methods.includes("EMAIL")) {
        emailProof.hidden = false;
        ctx.on(emailProof, "click", () => {
          void run(
            async () => {
              await gitAuthFlow.requestEmailProof();
              if (!mounted) return;
              if (form) form.hidden = true;
              emailProof.hidden = true;
              show(
                notice,
                "Check your email for a link to confirm this sign-in method.",
              );
            },
            "We couldn't send the confirmation email. Please try again.",
            emailProof,
          );
        });
      }
      if (!methods.length)
        show(
          error,
          "No confirmation method is available. Start again from sign in.",
        );
    }
  </script>
</component>
