<component tag="git-pipeline-job-actions">
  <prop name="job" type="bosca.git.ui.graphql.GitUiRunData.Git.PipelineRun.Jobs" required />
  <prop name="initial" type="bosca.git.ui.PipelineRunModel" required />
  <script server provides="model">
    bosca.git.ui.PipelineRunModel(
        initial.run,
        initial.canExecute,
        initial.canEdit,
        initial.canManage,
        job.id,
    )
  </script>
  <island name="git-pipeline-job-actions" :key="job.id">
    <section :data-next-href="model.nextHref">
      <div class="toolbar job-controls">
        <if bosca.git.ui.activeRun(model.job.status) && model.canEdit>
          <ui-confirm-dialog
            title="Cancel job?"
            description="Stop this job and its running steps."
            triggerLabel="Cancel job"
            icon="close"
            :forceOpen='model.failed && model.selectedAction == "cancelJob"'
          >
            <form
              class="modal-form"
              @submit='model.action("cancelJob", model.job.id, "", true, ctx)'
            >
              <footer class="modal-footer">
                <ui-button ref="cancel">Keep running</ui-button>
                <ui-button type="submit" class="danger">Cancel job</ui-button>
              </footer>
            </form>
          </ui-confirm-dialog>
        </if>
        <if model.canExecute && (model.job.status.name == "FAILURE" || model.job.status.name == "CANCELLED")>
          <ui-confirm-dialog
            title="Rerun job?"
            description="Retry this job using the existing run's commit."
            triggerLabel="Rerun job"
            icon="refresh"
            :forceOpen='model.failed && model.selectedAction == "rerunJob"'
          >
            <form
              class="modal-form"
              @submit='model.action("rerunJob", model.job.id, "", true, ctx)'
            >
              <footer class="modal-footer">
                <ui-button ref="cancel">Cancel</ui-button>
                <ui-button type="submit" primary>Rerun job</ui-button>
              </footer>
            </form>
          </ui-confirm-dialog>
        </if>
        <if model.canExecute && model.buildAnyway(model.job)>
          <ui-dialog
            title="Build anyway?"
            triggerLabel="Build anyway"
            icon="workflow"
            :forceOpen='model.failed && model.selectedAction == "buildAnyway"'
          >
            <form
              class="modal-form"
              @submit='model.action("buildAnyway", model.job.id, form.reason, true, ctx)'
            >
              <div class="modal-fields">
                <p class="form-help">
                  Build anyway bypasses external requirements. Dependencies, conditions and approvals still apply.
                </p>
                <if model.failed>
                  <ui-alert>{ model.message }</ui-alert>
                </if>
                <ui-field
                  label="Reason"
                  hint="Record why this job should bypass its external requirements."
                >
                  <ui-input name="reason" :value="model.reason" maxlength="1000" />
                </ui-field>
              </div>
              <footer class="modal-footer">
                <ui-button ref="cancel">Cancel</ui-button>
                <ui-button type="submit" primary>Build anyway</ui-button>
              </footer>
            </form>
          </ui-dialog>
        </if>
      </div>
      <if model.message.isNotBlank()>
        <ui-alert :tone='if (model.failed) "error" else "success"'>{ model.message }</ui-alert>
      </if>
    </section>
  </island>
  <style scoped>
    .job-controls {
      padding: 0;
      gap: 8px;
    }
    .job-controls:empty {
      display: none;
    }
  </style>
  <script client scoped>
    ctx.onUpdate(() => {
      const next =
        ctx.root.querySelector<HTMLElement>("[data-next-href]")?.dataset.nextHref;
      if (next) location.assign(next);
    });
  </script>
</component>
