<component tag="git-pipeline-job">
  <prop name="job" type="bosca.git.ui.graphql.GitUiRunData.Git.PipelineRun.Jobs" required />
  <prop name="model" type="bosca.git.ui.PipelineRunModel" required />
  <details :data-job="job.id" open>
    <ui-disclosure-heading>
      <span class="job-name">{ job.name }</span>
      <git-status-badge :status="job.status.name" />
      <span class="attempt">{ "Attempt " + job.attempt }</span>
    </ui-disclosure-heading>
    <div class="job-content">
      <p class="detail-note">
        Runner
        { job.runnerLabel }
        <if job.agent != null>
          ·
          <a :href='"/ci-agents/" + bosca.git.ui.encode(job.agent.id)'>
            { job.agent.name }
            ·
            <git-status-badge :status="job.agent.status.name" />
          </a>
        </if>
        · Started
        <if job.started != null>
          <ui-time :value="job.started" />
        <else>
          —
        </if>
        · Finished
        <if job.finished != null>
          <ui-time :value="job.finished" />
        <else>
          —
        </if>
      </p>
      <if job.errorMessage != null>
        <ui-alert>{ job.errorMessage }</ui-alert>
      </if>
      <if job.dependsOn.isNotEmpty()>
        <p>Depends on { job.dependsOn.joinToString(", ") }</p>
      </if>
      <if job.matrixValues != null>
        <pre>{ job.matrixValues }</pre>
      </if>
      <if job.awaitingRequirements>
        <div class="requirements-note">
          <strong>Waiting for external requirements</strong>
          <p>
            <if job.requirementsDeadline != null>
              Deadline
              <ui-time :value="job.requirementsDeadline" />
            <else>
              No deadline recorded.
            </if>
          </p>
        </div>
      </if>
      <if job.requirementsBypassedAt != null>
        <p class="detail-note">
          External requirements bypassed at
          <ui-time :value="job.requirementsBypassedAt" />
          ·
          { job.requirementsBypassReason ?: "No reason supplied" }
        </p>
      </if>
      <div :data-bml-preserve='"job-actions-" + job.id + job.status.name + model.run.status.name'>
        <git-pipeline-job-actions :job="job" :initial="model" />
      </div>
      <for step in job.steps>
        <section :data-step-status="step.status.name">
          <div class="detail-heading step-heading">
            <h3>{ step.name }</h3>
            <div class="step-state">
              <git-status-badge :status="step.status.name" />
              <if step.exitCode != null>
                <span class="muted">{ "Exit " + step.exitCode }</span>
              </if>
            </div>
          </div>
          <if step.errorMessage != null>
            <ui-alert>{ step.errorMessage }</ui-alert>
          </if>
          <div :data-bml-preserve='"logs-" + step.id'>
            <git-pipeline-logs :step="step.id" :repository="model.run.repositoryId" />
          </div>
        </section>
      </for>
    </div>
  </details>
  <style scoped>
    details {
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--bg-1);
      overflow: hidden;
    }
    summary {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      cursor: pointer;
      list-style: none;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    .job-name {
      font-size: 13px;
      font-weight: 600;
    }
    .attempt {
      font-size: 11px;
      color: var(--fg-3);
    }
    .job-content {
      padding: 0 18px 18px;
      border-top: 1px solid var(--line);
    }
    .requirements-note {
      background: color-mix(in srgb, var(--warn) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--warn) 24%, transparent);
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 14px;
      color: var(--warn);
      font-size: 12px;
    }
    .requirements-note p {
      margin: 4px 0 0;
      color: var(--fg-2);
    }
    .step-heading {
      margin-bottom: 12px;
    }
    .step-state {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
    }
    section {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }
    pre {
      overflow: auto;
    }
    @media (max-width: 600px) {
      summary {
        flex-wrap: wrap;
      }
    }
  </style>
</component>
