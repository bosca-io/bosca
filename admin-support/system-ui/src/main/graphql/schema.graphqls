"Query operations for introspecting the NATS server's operational state."
type NatsAdmin {
    "Retrieve general server information including version, uptime, and throughput statistics."
    serverInfo: NatsServerInfo!
    "Retrieve active route connections between servers in the NATS cluster."
    clusterRoutes: NatsRoutes!
    "Retrieve active client connections with optional pagination and sorting."
    connections(
        "Maximum number of connections to return."
        limit: Int
        "Zero-based offset for pagination."
        offset: Int
        "Field to sort connections by (e.g. 'cid', 'bytes_to', 'msgs_to')."
        sortBy: String
    ): NatsConnections!
    "Retrieve JetStream overview statistics including stream and consumer counts."
    jetStreamInfo: JetStreamInfo!
    "Retrieve details for all JetStream streams."
    jetStreamStreams: [JetStreamStreamDetail!]!
    "Retrieve all consumers for a specific JetStream stream."
    jetStreamConsumers(
        "The name of the stream to query consumers for."
        streamName: String!
    ): [JetStreamConsumerDetail!]!
    "Retrieve subscription routing statistics."
    subscriptionsInfo: NatsSubscriptionsInfo!
    "List all KeyValue store buckets, optionally filtered by bucket name."
    keyValueStores: [NatsKeyValueStore!]!
    "Browse entries in a KeyValue store bucket with optional key and value filtering."
    keyValueEntries(
        "The name of the KV bucket to browse."
        bucket: String!
        "Optional glob pattern to filter keys (e.g. 'prefix.*')."
        keyFilter: String
        "Optional substring to search for within entry values."
        valueSearch: String
    ): [NatsKeyValueEntry!]!
    "Read messages from a JetStream stream with optional filtering by subject, sequence range, and payload content."
    streamMessages(
        "The name of the stream to read from."
        streamName: String!
        "Maximum number of messages to return (default 50)."
        limit: Int
        "Filter messages by subject (supports NATS wildcards: * for single token, > for remaining)."
        subjectFilter: String
        "Read messages starting from this sequence number (inclusive)."
        fromSeq: Long
        "Read messages up to this sequence number (inclusive)."
        toSeq: Long
        "Search for this substring within message payloads."
        dataSearch: String
    ): [NatsStreamMessage!]!
}



"Mutation operations for modifying NATS KeyValue store entries and JetStream stream messages."
type NatsAdminMutation {
    "Create or update a key-value entry in the specified bucket. Returns the entry with its new revision."
    putKeyValueEntry(
        "The name of the KV bucket."
        bucket: String!
        "The key to create or update."
        key: String!
        "The string value to store."
        value: String!
    ): NatsKeyValueEntry!
    "Delete a key-value entry from the specified bucket."
    deleteKeyValueEntry(
        "The name of the KV bucket."
        bucket: String!
        "The key to delete."
        key: String!
    ): Boolean!
    "Permanently remove all tombstoned (deleted/purged) entries from a KeyValue store bucket, reclaiming storage."
    purgeKeyValueDeletes(
        "The name of the KV bucket to compact."
        bucket: String!
    ): Boolean!
    "Purge all messages from a JetStream stream, preserving configuration and consumers."
    purgeStream(
        "The name of the stream to purge."
        streamName: String!
    ): Boolean!
    "Remove all KeyValue tombstone messages (DEL/PURGE markers) from a stream, reclaiming storage while preserving live entries. Returns the number of tombstones removed."
    purgeStreamDeletes(
        "The name of the stream to purge tombstones from."
        streamName: String!
    ): Int!
    "Delete a single message from a JetStream stream by sequence number."
    deleteStreamMessage(
        "The name of the stream containing the message."
        streamName: String!
        "The sequence number of the message to delete."
        sequence: Long!
    ): Boolean!
}



"Version information from the Meilisearch instance identifying the exact build."
type MeilisearchVersion {
    "The Meilisearch server software version."
    pkgVersion: String!
    "The date the build was committed."
    commitDate: String
    "The short SHA of the commit."
    commitSha: String
}

"Health status of a Meilisearch instance."
type MeilisearchHealth {
    "Whether the instance is healthy and accepting requests."
    healthy: Boolean!
}

"Aggregate statistics across all indexes on a Meilisearch instance."
type MeilisearchGlobalStats {
    "Total number of indexes on this instance."
    numberOfIndexes: Int!
    "Total size of the database on disk in bytes."
    databaseSize: Long!
    "Timestamp of the most recent update across all indexes."
    lastUpdate: String
}

"Metadata and entry point for a Meilisearch index."
type MeilisearchIndex {
    "The unique identifier of the index."
    uid: String!
    "The primary key field used for document deduplication."
    primaryKey: String
    "When this index was created."
    createdAt: String!
    "When this index was last updated."
    updatedAt: String!
    "Per-index statistics including document count and field distribution."
    stats: MeilisearchIndexStats!
    "The complete settings of this index."
    settings: MeilisearchIndexSettings!
    "Browse documents in this index with optional pagination and field selection."
    documents(
        "Zero-based offset for pagination."
        offset: Int
        "Maximum number of documents to return."
        limit: Int
        "Subset of fields to include in each document."
        fields: [String!]
    ): [JSON!]!
}

"Per-index statistics from Meilisearch."
type MeilisearchIndexStats {
    "Total number of documents in this index."
    numberOfDocuments: Long!
    "Whether this index is currently processing updates."
    isIndexing: Boolean!
    "Distribution of fields across documents, showing how many documents contain each field."
    fieldDistribution: [MeilisearchFieldDistribution!]!
}

"Count of documents containing a particular field within an index."
type MeilisearchFieldDistribution {
    "The field name."
    field: String!
    "The number of documents containing this field."
    count: Long!
}

"Complete settings of a Meilisearch index."
type MeilisearchIndexSettings {
    "The ranking rules that determine result ordering."
    rankingRules: [String!]!
    "The attributes that can be used as search query terms."
    searchableAttributes: [String!]!
    "The attributes returned in search results."
    displayedAttributes: [String!]!
    "The attributes that can be used for filtering and faceting."
    filterableAttributes: [String!]!
    "The attributes that can be used for sorting results."
    sortableAttributes: [String!]!
    "Words ignored during search."
    stopWords: [String!]!
    "Groups of words considered equivalent during search."
    synonyms: [MeilisearchSynonym!]!
    "The distinct attribute used for deduplication."
    distinctAttribute: String
    "Typo tolerance configuration."
    typoTolerance: MeilisearchTypoTolerance
    "Pagination limits."
    pagination: MeilisearchPagination
    "Faceting configuration."
    faceting: MeilisearchFaceting
    "Configured embedders for semantic and vector search."
    embedders: [MeilisearchEmbedderEntry!]!
    "Proximity precision setting (byWord or byAttribute)."
    proximityPrecision: String
    "Search cutoff time in milliseconds."
    searchCutoffMs: Int
}

"A synonym mapping between a word and its alternative search terms."
type MeilisearchSynonym {
    "The word that triggers synonym expansion."
    word: String!
    "The synonyms for this word."
    synonyms: [String!]!
}

"Typo tolerance configuration for an index."
type MeilisearchTypoTolerance {
    "Whether typo tolerance is enabled."
    enabled: Boolean!
    "Minimum word size thresholds for typo correction."
    minWordSizeForTypos: MeilisearchMinWordSize
    "Words that should never have typo correction applied."
    disableOnWords: [String!]
    "Attributes where typo correction is disabled."
    disableOnAttributes: [String!]
}

"Minimum word length thresholds for activating typo correction."
type MeilisearchMinWordSize {
    "Minimum word length to allow one typo."
    oneTypo: Int!
    "Minimum word length to allow two typos."
    twoTypos: Int!
}

"Pagination limits for search results."
type MeilisearchPagination {
    "Maximum total number of hits that can be returned."
    maxTotalHits: Int!
}

"Faceting configuration for search results."
type MeilisearchFaceting {
    "Maximum number of facet values returned per facet."
    maxValuesPerFacet: Int!
}

"Configuration for a named embedder enabling semantic and vector search on an index."
type MeilisearchEmbedderEntry {
    "The name of this embedder configuration."
    name: String!
    "The source type (e.g., openAi, huggingFace, userProvided, rest, ollama)."
    source: String
    "The model identifier for this embedder."
    model: String
    "The dimensionality of the embedding vectors."
    dimensions: Int
    "The template used to generate text for embedding from documents."
    documentTemplate: String
    "Maximum bytes for the document template."
    documentTemplateMaxBytes: Int
    "The URL of the embedding provider endpoint. Required for rest embedders."
    url: String
    "The request body template as JSON, defining how Meilisearch sends data to the provider."
    request: JSON
    "The response mapping as JSON, defining where embeddings are located in the provider response."
    response: JSON
    "Custom HTTP headers sent with each request to the embedding provider."
    headers: JSON
}

"An asynchronous operation tracked by Meilisearch."
type MeilisearchTask {
    "The unique identifier of the task."
    uid: Int!
    "The type of operation (e.g., indexCreation, documentAdditionOrUpdate, settingsUpdate)."
    type: String!
    "The current status (enqueued, processing, succeeded, failed, canceled)."
    status: String!
    "The index UID this task operates on, if applicable."
    indexUid: String
    "When the task was enqueued."
    enqueuedAt: String!
    "When the task started processing."
    startedAt: String
    "When the task finished."
    finishedAt: String
    "Duration of the task execution."
    duration: String
    "Error details if the task failed."
    error: MeilisearchTaskError
    "The task UID that canceled this task, if applicable."
    canceledBy: Int
}

"Error details from a failed Meilisearch task."
type MeilisearchTaskError {
    "The error message."
    message: String!
    "The machine-readable error code."
    code: String!
    "The error type classification."
    type: String!
    "A link to the documentation about this error."
    link: String
}

"An API key registered on the Meilisearch instance."
type MeilisearchKey {
    "The name of this API key."
    name: String
    "The description of this API key."
    description: String!
    "The unique identifier of this key."
    uid: String!
    "The key value (may be partially masked)."
    key: String!
    "The actions this key is authorized to perform."
    actions: [String!]!
    "The index UIDs this key has access to (* for all)."
    indexes: [String!]!
    "When this key expires, null if it never expires."
    expiresAt: String
    "When this key was created."
    createdAt: String!
    "When this key was last updated."
    updatedAt: String!
}

"A Meilisearch instance in the multi-node topology, assigned to one or more storage systems."
type MeilisearchNode {
    "The database identifier of this node."
    id: UUID!
    "Human-readable name of this node."
    name: String!
    "Description of this node's role or purpose."
    description: String!
    "The Meilisearch instance URL for this node."
    url: String!
    "Whether this node is currently healthy and reachable."
    healthy: Boolean!
    "The search types this node supports, drawn from the StorageSystemType enum."
    types: [StorageSystemType!]!
    "The index UIDs hosted on this node."
    indexes: [String!]!
    "Server version of this node."
    version: MeilisearchVersion
    "Global stats for this node."
    stats: MeilisearchGlobalStats
    "The IDs of storage systems this node is assigned to."
    storageSystemIds: [UUID!]!
    "Remote instances configured in this node's federation network."
    networkRemotes: [MeilisearchNetworkRemote!]!
}

"A remote Meilisearch instance registered in the federation network."
type MeilisearchNetworkRemote {
    "The name identifying this remote instance."
    name: String!
    "The URL of the remote Meilisearch instance."
    url: String!
}

"Query operations for introspecting Meilisearch instance state, indexes, tasks, keys, and nodes."
type MeilisearchAdmin {
    "Retrieve server version information."
    version: MeilisearchVersion!
    "Check server health status."
    health: MeilisearchHealth!
    "Retrieve global statistics across all indexes."
    stats: MeilisearchGlobalStats!
    "List all indexes with optional pagination."
    indexes(
        "Zero-based offset for pagination."
        offset: Int
        "Maximum number of indexes to return."
        limit: Int
    ): [MeilisearchIndex!]!
    "Get details for a specific index by UID."
    index(
        "The unique identifier of the index."
        uid: String!
    ): MeilisearchIndex
    "List recent tasks with optional filtering by status, type, and index."
    tasks(
        "Maximum number of tasks to return."
        limit: Int
        "Task UID to start from for pagination."
        from: Int
        "Filter by task statuses."
        status: [String!]
        "Filter by task types."
        type: [String!]
        "Filter by index UIDs."
        indexUid: [String!]
    ): [MeilisearchTask!]!
    "Get details for a specific task."
    task(
        "The task UID."
        uid: Int!
    ): MeilisearchTask
    "List all API keys registered on the instance."
    keys: [MeilisearchKey!]!
    "List all Meilisearch nodes in the multi-node topology."
    nodes: [MeilisearchNode!]!
    "Get a specific node by database ID."
    node(
        "The node's database ID."
        id: UUID!
    ): MeilisearchNode
}



"Mutation operations for managing Meilisearch indexes, settings, embedders, documents, tasks, nodes, replication, and federation."
type MeilisearchAdminMutation {
    "Create a new index with the given UID and optional primary key."
    createIndex(
        "The unique identifier for the new index."
        uid: String!
        "The primary key field for document deduplication."
        primaryKey: String
    ): MeilisearchTask!
    "Delete an index by UID."
    deleteIndex(
        "The unique identifier of the index to delete."
        uid: String!
    ): MeilisearchTask!
    "Swap the contents of two indexes atomically."
    swapIndexes(
        "Pairs of index UIDs to swap, each pair as a two-element list."
        indexes: [[String!]!]!
    ): MeilisearchTask!
    "Update settings for an index. Only provided fields are changed."
    updateSettings(
        "The index UID to update."
        uid: String!
        "The settings fields to update."
        settings: MeilisearchSettingsInput!
    ): MeilisearchTask!
    "Reset all settings for an index to their defaults."
    resetSettings(
        "The index UID to reset."
        uid: String!
    ): MeilisearchTask!
    "Update embedder configurations for semantic and vector search on a specific index."
    updateEmbedders(
        "The index UID to update."
        uid: String!
        "The embedder configurations to apply."
        embedders: [MeilisearchEmbedderInput!]!
    ): MeilisearchTask!
    "Remove all embedder configurations from an index, disabling semantic search."
    resetEmbedders(
        "The index UID to reset."
        uid: String!
    ): MeilisearchTask!
    "Remove one named embedder while retaining other configured providers."
    removeEmbedder(uid: String!, name: String!): MeilisearchTask!
    "Delete all documents from an index."
    deleteAllDocuments(
        "The index UID to clear."
        uid: String!
    ): MeilisearchTask!
    "Delete specific documents by their IDs."
    deleteDocuments(
        "The index UID."
        uid: String!
        "The document IDs to delete."
        ids: [String!]!
    ): MeilisearchTask!
    "Delete documents matching a filter expression."
    deleteDocumentsByFilter(
        "The index UID."
        uid: String!
        "The Meilisearch filter expression."
        filter: String!
    ): MeilisearchTask!
    "Cancel tasks matching the given filters."
    cancelTasks(
        "Specific task UIDs to cancel."
        uids: [Int!]
        "Cancel tasks with these statuses."
        statuses: [String!]
        "Cancel tasks of these types."
        types: [String!]
        "Cancel tasks operating on these index UIDs."
        indexUids: [String!]
    ): MeilisearchTask!
    "Create a database dump for backup or migration."
    createDump: MeilisearchTask!
    "Trigger a snapshot of the current database state."
    createSnapshot: MeilisearchTask!
    "Register a new Meilisearch node in the multi-node topology."
    addNode(
        "The node configuration to create."
        input: MeilisearchNodeInput!
    ): MeilisearchNode!
    "Update an existing node's configuration."
    editNode(
        "The node's database ID."
        id: UUID!
        "The fields to update."
        input: MeilisearchEditNodeInput!
    ): MeilisearchNode!
    "Remove a node from the topology."
    deleteNode(
        "The node's database ID."
        id: UUID!
    ): Boolean!
    "Assign a node to a storage system, making it serve that storage system's indexes."
    assignNodeToStorageSystem(
        "The storage system ID."
        storageSystemId: UUID!
        "The node ID to assign."
        nodeId: UUID!
    ): Boolean!
    "Remove a node from a storage system assignment."
    removeNodeFromStorageSystem(
        "The storage system ID."
        storageSystemId: UUID!
        "The node ID to remove."
        nodeId: UUID!
    ): Boolean!
    "Export data from the primary instance to a specific node for replication."
    exportToNode(
        "The target node's database ID."
        nodeId: UUID!
        "Specific index UIDs to export, or all if omitted."
        indexUids: [String!]
        "Whether to override existing settings on the target."
        overrideSettings: Boolean
    ): MeilisearchTask!
    "Configure the federation network on a specific node, registering remote instances for distributed search."
    configureNetwork(
        "The node's database ID."
        nodeId: UUID!
        "The remote instances to register."
        remotes: [MeilisearchNetworkRemoteInput!]!
    ): Boolean!
}



"Input for updating index settings. Only provided fields are changed."
input MeilisearchSettingsInput {
    "The ranking rules that determine result ordering."
    rankingRules: [String!]
    "The attributes that can be used as search query terms."
    searchableAttributes: [String!]
    "The attributes returned in search results."
    displayedAttributes: [String!]
    "The attributes that can be used for filtering."
    filterableAttributes: [String!]
    "The attributes that can be used for sorting."
    sortableAttributes: [String!]
    "Words to ignore during search."
    stopWords: [String!]
    "The distinct attribute for deduplication."
    distinctAttribute: String
    "Proximity precision (byWord or byAttribute)."
    proximityPrecision: String
    "Search cutoff time in milliseconds."
    searchCutoffMs: Int
}

"Input for configuring an embedder on an index for semantic and vector search."
input MeilisearchEmbedderInput {
    "The name for this embedder configuration."
    name: String!
    "The source type (openAi, huggingFace, userProvided, rest, ollama)."
    source: String!
    "The model identifier."
    model: String
    "The API key for the embedding provider."
    key: String
    "The dimensionality of the vectors."
    dimensions: Int
    "The template used to generate text for embedding."
    documentTemplate: String
    "Maximum bytes for the document template."
    documentTemplateMaxBytes: Int
    "The URL of the embedding provider endpoint. Required for rest embedders."
    url: String
    "The request body template as JSON, defining how to send data to the provider."
    request: JSON
    "The response mapping as JSON, defining where embeddings are in the provider response."
    response: JSON
    "Custom HTTP headers as JSON key-value pairs sent with each request."
    headers: JSON
}

"Input for creating a new Meilisearch node in the multi-node topology."
input MeilisearchNodeInput {
    "Human-readable name for the node."
    name: String!
    "Description of the node's role."
    description: String
    "The Meilisearch instance URL."
    url: String!
    "The API key for authenticating with this node."
    key: String!
    "The search types this node supports."
    types: [StorageSystemType!]!
}

"Input for updating an existing Meilisearch node's configuration. Only provided fields are changed."
input MeilisearchEditNodeInput {
    "Updated name."
    name: String
    "Updated description."
    description: String
    "Updated URL."
    url: String
    "Updated API key."
    key: String
    "Updated search types."
    types: [StorageSystemType!]
}

"Input for registering a remote Meilisearch instance in the federation network."
input MeilisearchNetworkRemoteInput {
    "The name identifying the remote instance."
    name: String!
    "The URL of the remote Meilisearch instance."
    url: String!
}

"A long-lived API token credential for programmatic access. The raw token value is only available at creation time."
type ApiToken {
    "Credential ID in the principal_credentials table"
    id: Long!
    "ID of the principal this token authenticates as"
    principalId: UUID!
    "Human-readable name for identifying this token"
    name: String!
    "Optional description of this token's purpose"
    description: String
    "First 12 characters of the raw token, for identification in the UI"
    tokenPrefix: String!
    "List of scopes restricting this token's permissions. Null means unrestricted."
    scopes: [String!]
    "Subset of the principal's groups this token may act under. Null means all groups."
    allowedGroups: [UUID!]
    "When this token expires. Null means it never expires."
    expiresAt: DateTime
    "When this token was last used for authentication"
    lastUsedAt: DateTime
    "IP address of the most recent authentication using this token"
    lastUsedIp: String
    "When this token was revoked. Null means it is still active."
    revokedAt: DateTime
    "Whether this token is currently usable (not revoked and not expired)"
    active: Boolean!
}

"Response returned when creating a new API token. Contains the raw token value which is only shown once."
type ApiTokenCreationResponse {
    "The created token metadata"
    apiToken: ApiToken!
    "The raw token value. Store this securely — it cannot be retrieved again."
    rawToken: String!
}

"Input for creating a new API token"
input ApiTokenInput {
    "Human-readable name for the token (e.g. 'CI Deploy Token')"
    name: String!
    "Optional description of this token's intended use"
    description: String
    "Scopes to restrict this token's permissions. Omit for unrestricted access."
    scopes: [String!]
    "Group IDs to restrict this token to. Must be a subset of the principal's groups. Omit for all groups."
    allowedGroups: [UUID!]
    "When this token should expire. Omit for no expiration."
    expiresAt: DateTime
}

"Describes an available API token scope"
type ApiTokenScopeInfo {
    "The scope identifier (e.g. 'content:view')"
    name: String!
    "Human-readable description of what this scope permits"
    description: String!
}

"Query operations for API tokens"
type ApiTokens {
    "List all API tokens for the current principal"
    my(limit: Int!, offset: Long!): [ApiToken!]!
    "List all API tokens for a specific principal. Allowed for the principal themselves; listing another principal's tokens requires admin."
    forPrincipal(principalId: UUID!, limit: Int!, offset: Long!): [ApiToken!]!
    "Retrieve a specific API token by credential ID"
    token(id: Long!): ApiToken
    "List all available scope values"
    availableScopes: [ApiTokenScopeInfo!]!
}

"Mutation operations for managing API tokens"
type ApiTokensMutation {
    "Create a new API token for the current principal. The raw token is only returned in this response."
    create(input: ApiTokenInput!): ApiTokenCreationResponse!
    "Create a new API token for a specific principal. Allowed for the principal themselves (equivalent to create); minting a token for another principal requires admin."
    createForPrincipal(principalId: UUID!, input: ApiTokenInput!): ApiTokenCreationResponse!
    "Revoke an API token immediately. The token can no longer be used for authentication."
    revoke(id: Long!): Boolean!
    "Revoke all API tokens for the current principal"
    revokeAll: Boolean!
    "Revoke all API tokens for a specific principal. Allowed for the principal themselves (equivalent to revokeAll); revoking another principal's tokens requires admin."
    revokeAllForPrincipal(principalId: UUID!): Boolean!
    "Update a token's name, description, or scopes. Null scopes leave restrictions unchanged; clearScopes explicitly removes restrictions."
    edit(id: Long!, name: String, description: String, scopes: [String!], clearScopes: Boolean! = false): ApiToken!
    "Permanently delete a revoked token record"
    delete(id: Long!): Boolean!
}

"A registered WebAuthn passkey credential for passwordless authentication"
type Passkey {
    "Base64url-encoded credential ID assigned by the authenticator"
    credentialId: String!
    "Human-readable label for identifying this passkey (e.g. 'MacBook Pro Touch ID')"
    name: String!
    "ISO-8601 timestamp when this passkey was registered"
    createdAt: String!
    "ISO-8601 timestamp of the most recent authentication using this passkey, null if never used"
    lastUsedAt: String
    "Transport hints reported by the authenticator (e.g. 'internal', 'usb', 'ble', 'nfc')"
    transports: [String!]!
}

"Query operations for WebAuthn passkeys"
type Passkeys {
    "List all registered passkeys for the current principal"
    current: [Passkey!]!
    "List all registered passkeys for a specific principal (admin only)"
    all(principalId: UUID!): [Passkey!]!
}

"Mutation operations for managing WebAuthn passkeys"
type PasskeysMutation {
    "Remove a registered passkey by its credential ID. Cannot remove the last credential on the account."
    delete(credentialId: String!): Boolean!
}

"A named bundle of Studio subsystem access that can be assigned to user profiles."
type StudioPersona {
    "The unique identifier of this persona."
    id: UUID!
    "The display name of this persona."
    name: String!
    "A description of what this persona grants access to."
    description: String
    "The list of Studio subsystem identifiers this persona grants access to."
    subsystemIds: [String!]!
    "Whether this persona is currently active and can be assigned."
    enabled: Boolean!
    "The timestamp when this persona was created."
    created: DateTime!
    "The timestamp when this persona was last modified."
    modified: DateTime!
}

"Input for creating or updating a Studio persona definition."
input StudioPersonaInput {
    "The UUID of an existing persona to update. Null when creating."
    id: UUID
    "The display name of the persona."
    name: String!
    "A description of what this persona grants access to."
    description: String
    "The list of Studio subsystem identifiers this persona grants access to."
    subsystemIds: [String!]!
    "Whether the persona is active."
    enabled: Boolean
}

"Query operations for Studio persona management."
type StudioPersonas {
    "Retrieve all persona definitions. Requires administrator access."
    all: [StudioPersona!]!
    "Retrieve a single persona by its unique identifier. Requires administrator access."
    persona(
        "The UUID of the persona to retrieve."
        id: UUID!
    ): StudioPersona
    "Retrieve all personas assigned to a profile."
    byProfile(
        "The UUID of the profile to look up personas for."
        profileId: UUID!
    ): [StudioPersona!]!
}

"Mutation operations for Studio persona management and profile assignment."
type StudioPersonasMutation {
    "Create a new persona definition. Requires administrator access."
    create(
        "The persona definition to create."
        input: StudioPersonaInput!
    ): StudioPersona!
    "Update an existing persona definition. Requires administrator access."
    update(
        "The persona definition to update. The id field must be set."
        input: StudioPersonaInput!
    ): StudioPersona!
    "Delete a persona definition and all its profile assignments. Requires administrator access."
    delete(
        "The UUID of the persona to delete."
        id: UUID!
    ): Boolean!
    "Assign a persona to a profile. Requires administrator access."
    assignToProfile(
        "The UUID of the persona to assign."
        personaId: UUID!
        "The UUID of the profile to assign the persona to."
        profileId: UUID!
    ): Boolean!
    "Remove a persona assignment from a profile. Requires administrator access."
    removeFromProfile(
        "The UUID of the persona to remove."
        personaId: UUID!
        "The UUID of the profile to remove the persona from."
        profileId: UUID!
    ): Boolean!
}

extend type Query { artifactsAdmin: ArtifactsAdmin! }
type ArtifactsAdmin { namespaces: [ArtifactNamespaceInfo!]! }
type ArtifactNamespaceInfo { name: String! repositories: [ArtifactRepoInfo!]! }
type ArtifactRepoInfo { name: String! type: ArtifactRegistryType! versions: [ArtifactVersionInfo!]! }
type ArtifactVersionInfo { version: String! }
enum ArtifactRegistryType { docker helm maven npm raw ml }

"A configuration entry in the application's key-value store. Configurations hold platform settings, feature flags, and other runtime parameters with permission-based access control."
type Configuration {
    "A human-readable description of what this configuration controls and how it is used."
    description: String!
    "The unique internal identifier of this configuration entry."
    id: String!
    "The unique key used to look up this configuration (e.g. 'app.feature.enabled', 'theme.primaryColor')."
    key: String!
    "The list of permissions that control which groups can read or modify this configuration."
    permissions: [ConfigurationPermission!]!
    "Whether this configuration value is publicly accessible without authentication. Public configurations are available to unauthenticated clients."
    public: Boolean!
    "The configuration value stored as JSON. Can hold any JSON-serializable data including strings, numbers, objects, or arrays."
    value: JSON
}

"A permission rule that grants a specific action to a security group for accessing a configuration entry."
type ConfigurationPermission {
    "The permission action granted to the group (e.g. read, write)."
    action: PermissionAction!
    "The security group that is granted this permission."
    group: Group!
}

"Query operations for retrieving application configuration entries."
type Configurations {
    "Retrieve all configuration entries that the current user has permission to access."
    all: [Configuration!]!
    "Retrieve a single configuration entry by its unique key. Returns null if the key does not exist or the user lacks permission."
    configuration(
        "The unique key of the configuration to retrieve."
        key: String!
    ): Configuration
}

"Mutation operations for managing application configuration entries."
type ConfigurationsMutation {
    "Delete a configuration entry by its key. Returns the key of the deleted configuration, or null if the key was not found."
    deleteConfiguration(
        "The unique key of the configuration to delete."
        key: String!
    ): String
    "Create or update a configuration entry. If a configuration with the given key already exists, it is updated; otherwise a new entry is created."
    setConfiguration(
        "The configuration data to create or update."
        configuration: ConfigurationInput!
    ): Configuration
}

"Input for creating or updating a configuration entry in the key-value store."
input ConfigurationInput {
    "A human-readable description of what this configuration controls and how it is used."
    description: String!
    "The unique key for this configuration (e.g. 'app.feature.enabled', 'theme.primaryColor'). Must be unique across all configurations."
    key: String!
    "The list of permissions that control which groups can read or modify this configuration."
    permissions: [PermissionInput!]
    "Whether this configuration value should be publicly accessible without authentication."
    public: Boolean!
    "The configuration value stored as JSON. Can hold any JSON-serializable data including strings, numbers, objects, or arrays."
    value: JSON!
}

enum PermissionAction { DELETE EDIT EXECUTE IMPERSONATE LIST MANAGE VIEW }
input PermissionInput { action: PermissionAction! entityId: String! groupId: String! }

"The category of a storage system, indicating its primary purpose for content processing and retrieval."
enum StorageSystemType {
    "A full-text search index (e.g. Meilisearch) used for keyword and faceted search across content."
    SEARCH
    "A supplementary file storage system used for storing additional files associated with content (e.g. thumbnails, attachments)."
    SUPPLEMENTARY
    "A vector embedding store used for semantic search and similarity queries powered by AI models."
    VECTOR
}

"A storage system configuration that defines an external service for indexing, storing, or embedding content. Storage systems integrate with search engines, file stores, and vector databases."
type StorageSystem {
    "The unique identifier of this storage system."
    id: UUID!
    "The type category of this storage system (SEARCH, SUPPLEMENTARY, or VECTOR)."
    type: StorageSystemType!
    "The human-readable name of this storage system."
    name: String!
    "A description of this storage system's purpose and configuration."
    description: String!
    "The connection and behavior configuration for this storage system, stored as JSON. Structure depends on the system type."
    configuration: JSON
    "The list of AI models associated with this storage system, used for tasks such as generating embeddings or processing content."
    models: [StorageSystemModel!]!
}

"An AI model association for a storage system, defining which model is used for content processing and how it is configured."
type StorageSystemModel {
    "The model-specific configuration stored as JSON, such as embedding dimensions, tokenizer settings, or processing parameters."
    configuration: JSON!
    "The resolved AI model entity. Null if the model has been deleted or is not accessible."
    model: Model
    "The UUID of the AI model used by this storage system."
    modelId: UUID!
}

"Query operations for retrieving storage system configurations."
type StorageSystems {
    "Retrieve all registered storage systems."
    all: [StorageSystem!]!
    "Retrieve a single storage system by its unique identifier. Returns null if the system does not exist."
    storageSystem(
        "The UUID of the storage system to retrieve."
        id: UUID!
    ): StorageSystem
}

"Mutation operations for managing storage systems and triggering reindexing operations."
type StorageSystemsMutation {
    "Create a new storage system with the specified configuration."
    add(
        "The storage system configuration to create."
        storageSystem: StorageSystemInput!
    ): StorageSystem
    "Delete a storage system by its unique identifier. Returns true if the deletion was successful."
    delete(
        "The UUID of the storage system to delete."
        id: UUID!
    ): Boolean!
    "Update an existing storage system's configuration."
    edit(
        "The UUID of the storage system to update."
        id: UUID!
        "The updated storage system configuration."
        storageSystem: StorageSystemInput!
    ): StorageSystem
    "Trigger a reindex operation to rebuild search indexes or vector embeddings. Can target specific content types and storage systems."
    reindex(
        "The name of the specific storage system to reindex. If null, reindexes all storage systems."
        storageName: String,
        "Whether to delete existing index data before reindexing. Useful for a clean rebuild."
        deleteFirst: Boolean,
        "Whether to reindex metadata (content items)."
        metadata: Boolean,
        "Whether to reindex collections."
        collections: Boolean,
        "Whether to reindex profiles."
        profiles: Boolean,
        "The number of items to process per batch during reindexing. Controls memory usage and throughput."
        batchSize: Int
    ): Boolean
}

"Input for creating or updating a storage system configuration."
input StorageSystemInput {
    "The connection and behavior configuration stored as JSON. Structure depends on the system type."
    configuration: JSON
    "A description of this storage system's purpose and configuration."
    description: String!
    "The list of AI model associations for this storage system."
    models: [StorageSystemModelInput!]!
    "The human-readable name of this storage system."
    name: String!
    "The type category of this storage system (SEARCH, SUPPLEMENTARY, or VECTOR)."
    type: StorageSystemType!
}

"Input for associating an AI model with a storage system."
input StorageSystemModelInput {
    "The model-specific configuration stored as JSON, such as embedding dimensions or processing parameters."
    configuration: JSON!
    "The UUID of the AI model to associate with the storage system."
    modelId: UUID!
}


type Ai { models: Models! }
type Models { all: [Model!]! }
type Model { id: UUID! name: String! key: String! }
type SearchConfiguration { previewMetadata(id: UUID!): JSON }
extend type Search { configuration: SearchConfiguration }

"Tracks the status, result, and metadata of a backup operation."
type Backup {
    "Unique identifier for this backup operation."
    id: UUID!
    "Current status of the backup: pending, running, completed, or failed."
    status: String!
    "Object storage path of the completed backup archive, null until the backup finishes."
    path: String
    "Error message if the backup failed, null on success."
    error: String
    "Whether binary files from object storage are included in this backup."
    includeFiles: Boolean!
    "Metadata item identifier for downloading the backup archive through the standard content API."
    metadataId: UUID
    "Timestamp when the backup was initiated."
    created: DateTime!
    "Timestamp of the most recent status update."
    modified: DateTime!
}

"Determines how the restore process handles pre-existing records that conflict with data in the backup archive."
enum ConflictStrategy {
    "Skip records that already exist, leaving the current data untouched."
    SKIP
    "Overwrite existing records with data from the backup archive."
    OVERWRITE
    "Abort the entire restore if any conflicts are detected."
    FAIL
}

"Query operations for listing and inspecting backup records."
type Backups {
    "List all backups ordered by creation date descending, with pagination."
    list(offset: Int! = 0, limit: Int! = 20): [Backup!]!
    "Get a specific backup by its identifier."
    backup(id: UUID!): Backup
}

"Mutation operations for creating backups and restoring from them."
type BackupsMutation {
    "Initiate a new backup of all system data. Returns the backup tracking record immediately; the actual backup runs asynchronously."
    create(includeFiles: Boolean! = true): Backup!
    "Register an already-uploaded metadata item as an imported backup archive."
    importBackup(metadataId: UUID!): Backup!
    "Initiate a restore from a previously completed backup archive. The restore runs asynchronously."
    restore(backupId: UUID!, conflictStrategy: ConflictStrategy! = SKIP): Boolean!
    "Delete a backup tracking record and optionally its archive."
    delete(id: UUID!): Boolean!
}

extend type Query {
    "Access backup query operations for listing and inspecting backup records."
    backups: Backups!
}

extend type Mutation {
    "Access backup mutation operations for creating backups and restoring from them."
    backups: BackupsMutation!
}

"Direction in which a federated channel link relays messages between peers"
enum FederationSyncDirection {
    "Messages flow in both directions between the local and remote channel"
    BIDIRECTIONAL
    "Only inbound messages from the peer are accepted into the local channel"
    INBOUND
    "Only outbound messages from the local channel are sent to the peer"
    OUTBOUND
}

"A remote Bosca instance that participates in federated chat. Peers communicate over NATS leaf nodes for transport and a REST API for handshake/control."
type FederationPeer {
    "Unique identifier for this peer"
    id: UUID!
    "Human-readable name for this peer"
    name: String!
    "NATS connection URL used by the leaf-node bridge for message transport"
    natsUrl: String!
    "Base URL of the peer's federation REST API used for control-plane operations"
    apiUrl: String!
    "Whether this peer is currently active"
    active: Boolean!
    "Timestamp when this peer was registered"
    createdAt: DateTime
    "Channel-level federation links to this peer originating from local channels"
    federatedChannels: [FederatedChannel!]!
}

"Links a local chat channel to a remote channel on a federated peer, defining the direction of message relay"
type FederatedChannel {
    "ID of the local Bosca chat channel"
    localChannelId: UUID!
    "ID of the federation peer this link targets"
    peerId: UUID!
    "ID of the remote channel on the peer side"
    remoteChannelId: UUID!
    "Direction of message relay for this link"
    syncDirection: FederationSyncDirection!
    "The peer this link targets"
    peer: FederationPeer
}

"Input for registering a new federation peer"
input RegisterFederationPeerInput {
    "Human-readable name for the peer"
    name: String!
    "NATS connection URL used by the leaf-node bridge"
    natsUrl: String!
    "Base URL of the peer's federation REST API"
    apiUrl: String!
    "Shared secret used to authenticate handshake and control-plane requests. Stored encrypted via the configuration service."
    sharedSecret: String!
}

"Input for federating a local channel with a remote channel on a peer"
input FederateChannelInput {
    "ID of the local Bosca chat channel to federate"
    localChannelId: UUID!
    "ID of the federation peer to link with"
    peerId: UUID!
    "ID of the remote channel on the peer side"
    remoteChannelId: UUID!
    "Sync direction for this link. Defaults to bidirectional when omitted."
    syncDirection: FederationSyncDirection
}

"Root query type for federation administration"
type Federation {
    "All active federation peers known to this instance"
    peers: [FederationPeer!]!
    "A specific peer by id"
    peer(id: UUID!): FederationPeer
    "Federated channel links originating from a local channel"
    channelLinks(localChannelId: UUID!): [FederatedChannel!]!
}

"Mutation operations for managing federation peers and channel links"
type FederationMutation {
    "Register a new federation peer with its connection details and shared secret"
    registerPeer(input: RegisterFederationPeerInput!): FederationPeer!
    "Deactivate a federation peer, halting message synchronization"
    deactivatePeer(id: UUID!): Boolean!
    "Link a local channel with a remote channel on a peer for synchronization"
    federateChannel(input: FederateChannelInput!): Boolean!
    "Remove an existing federation link for a local channel"
    unfederateChannel(localChannelId: UUID!, peerId: UUID!): Boolean!
    "Set or rotate the shared secret used to authenticate handshake requests with a peer"
    setSharedSecret(id: UUID!, secret: String): Boolean!
}

type Collaboration { federation: Federation! }
type CollaborationMutation { federation: FederationMutation! }
extend type Query { collaboration: Collaboration! }
extend type Mutation { collaboration: CollaborationMutation! }

type Content
type ContentMutation
extend type Query { content: Content! }
extend type Mutation { content: ContentMutation! }
type Bible { metadataId: UUID! version: Int! variant: String! name: String! enabled: Boolean! }
type BibleAudio { id: UUID! name: String! nameLocal: String! abbreviation: String! attribution: BibleAttribution! }
type BibleLanguage { iso: String! name: String! nameLocal: String! script: String! scriptCode: String! scriptDirection: String! }
type BibleAttribution { copyright: String! citation: String! informationUrl: String }
"Administrator queries for Bible provider integration"
type BibleProviders {
    providers: [String!]!
    configurations: [BibleProviderConfiguration!]!
    catalog(configurationId: UUID!, kind: BibleSourceKind!, query: String, offset: Int! = 0, limit: Int! = 20): [BibleCatalog!]!
    sources(configurationId: UUID!): [BibleSource!]!
    audioTargets(configurationId: UUID!, providerBibleId: String!): [Bible!]!
}

"Administrator operations for configuring providers and managing their sources"
type BibleProvidersMutation {
    saveConfiguration(input: BibleProviderConfigurationInput!): BibleProviderConfiguration!
    test(configurationId: UUID!): Boolean!
    addBible(input: AddProviderBibleInput!): Bible!
    addAudio(bibleId: UUID!, version: Int!, variant: String!, input: AddProviderAudioInput!): BibleAudio!
    refresh(sourceId: UUID!): Boolean!
    removeSource(sourceId: UUID!, expectedVersion: Long!): Boolean!
    "Active sources prevent removal unless purgeSources is explicitly true"
    removeConfiguration(configurationId: UUID!, purgeSources: Boolean! = false): Boolean!
}

"Saved provider setup without credentials"
type BibleProviderConfiguration {
    id: UUID!
    name: String!
    provider: String!
    enabled: Boolean!
    hasApiKey: Boolean!
}

input BibleProviderConfigurationInput {
    id: UUID
    name: String!
    provider: String!
    enabled: Boolean!
    "Omit or send null to preserve the saved key when updating"
    apiKey: String
}

"A text Bible or recording available upstream; browsing does not download chapter content"
type BibleCatalog {
    id: String!
    systemId: String!
    kind: BibleSourceKind!
    name: String!
    nameLocal: String!
    abbreviation: String!
    abbreviationLocal: String!
    description: String!
    languages: [BibleLanguage!]!
    attribution: BibleAttribution!
    relatedSystemId: String
}

"A provider edition attached to an exact Bosca Bible version and variant"
type BibleSource {
    id: UUID!
    configurationId: UUID!
    provider: String!
    providerBibleId: String!
    metadataId: UUID!
    metadataVersion: Int!
    variant: String!
    kind: BibleSourceKind!
    name: String!
    nameLocal: String!
    abbreviation: String!
    attribution: BibleAttribution!
    allowedUses: [BibleContentUse!]!
    version: Long!
    created: DateTime!
    modified: DateTime!
}

input AddProviderBibleInput {
    configurationId: UUID!
    providerBibleId: String!
    variant: String!
    "Uses reviewed by an administrator; an empty list grants no use"
    allowedUses: [BibleContentUse!]!
}

input AddProviderAudioInput {
    configurationId: UUID!
    providerBibleId: String!
    "Audio sources may permit only PLAYBACK; an empty list grants no use"
    allowedUses: [BibleContentUse!]!
}

enum BibleSourceKind {
    TEXT
    AUDIO
}

enum BibleContentUse {
    DISPLAY
    AI_CONTEXT
    TEXT_TO_SPEECH
    INDEXING
    EXPORT
    PLAYBACK
}

extend type Content {
    bibleProviders: BibleProviders!
}

extend type ContentMutation {
    bibleProviders: BibleProvidersMutation!
}
