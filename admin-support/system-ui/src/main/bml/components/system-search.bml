<component tag="system-search">
  <prop name="initial" type="bosca.system.ui.SystemSearchModel" required />
  <script server provides="model">bosca.system.ui.SystemSearchModel(initial.admin, initial.configuration, initial.exists, initial.previewId, initial.preview, initial.previewed, initial.feedback, initial.reindexMode, initial.reindexRequest)</script>
  <island name="system-search" :key='"search"'><page-shell fill><page-heading :trail="bosca.system.ui.systemTrail(ctx.requestPath)" title="Search" subtitle="Search indexing configuration and reindex controls"><if model.admin>
    <button icon="refresh" @click.coalesce="model.prepareReindex(false)">Reindex</button><button icon="refresh" @click.coalesce="model.prepareReindex(true)">Full reindex</button>
  </if></page-heading><div class="system-content" data-bml-scroll="system-content"><system-feedback :feedback="model.feedback" />
    <dialog @dialogdismiss.coalesce="model.cancelReindex()" :title='if (model.reindexMode == "full") "Rebuild Admin Search Index" else "Reindex Admin Search Index"' triggerLabel="Reindex" :showTrigger="false" :forceOpen="model.reindexMode.isNotBlank()" :openRequest="model.reindexRequest.toString()" :completed="model.reindexMode.isBlank()"><form @submit='model.reindex(model.reindexMode == "full", form.confirmed, ctx)' class="modal-form"><form-body padded class="modal-fields"><if model.reindexMode == "full"><p>Existing index data will be removed before reindexing. Search results remain incomplete until rebuilding finishes.</p></if><checkbox name="confirmed" label="Start reindexing Admin Search Index" required /></form-body><form-actions bordered class="modal-footer"><button data-dialog-close>Cancel</button><button type="submit" primary>{ if (model.reindexMode == "full") "Full reindex" else "Reindex" }</button></form-actions></form></dialog>
    <card :padded="false"><form @submit="model.save(form.configuration, ctx)"><section-heading title="Search configuration" subtitle="JSONata expressions and settings for search indexing."><button type="submit" primary aria-label="Save search configuration" data-search-save>Save</button></section-heading><div class="console-body"><if !model.exists><p class="system-muted">No search configuration found. Save to create one.</p></if><json-editor name="configuration" preserveKey="search-configuration" label="Search configuration" :text="model.configuration" :navigationBar="false" class="search-settings-json" /></div></form></card>
    <if model.admin><card :padded="false"><section-heading title="Preview index" subtitle="Preview how a metadata item will be indexed." /><div class="console-body system-stack"><form class="search-preview-form" @submit="model.preview(form.metadataId, ctx)"><input name="metadataId" :value="model.previewId" aria-label="Metadata ID" placeholder="Metadata ID (UUID)" required /><button type="submit">Preview</button></form><if model.previewed><if model.preview == null><empty-state message="No metadata found for this ID." /><else><json-editor name="preview" label="Metadata indexing context" :value="model.preview ?: kotlinx.serialization.json.JsonNull" :mainMenuBar="false" :navigationBar="false" :statusBar="false" :askToFormat="false" readOnly class="search-preview-json" /></if></if></div></card></if>
  </div></page-shell></island>
</component>
