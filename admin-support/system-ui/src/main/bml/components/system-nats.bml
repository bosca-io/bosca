<component tag="system-nats">
  <prop name="initial" type="bosca.system.ui.NatsConsoleModel" required />
  <script server provides="model">bosca.system.ui.NatsConsoleModel(admin = initial.admin, tab = initial.tab, overview = initial.overview, streamFilter = initial.streamFilter, bucketFilter = initial.bucketFilter, connectionFilter = initial.connectionFilter, detail = initial.detail, streamName = initial.streamName, bucketName = initial.bucketName, streamRequest = initial.streamRequest, bucketRequest = initial.bucketRequest, refreshes = initial.refreshes, consumers = initial.consumers, messages = initial.messages, entries = initial.entries, messageLimit = initial.messageLimit, subjectFilter = initial.subjectFilter, fromSeq = initial.fromSeq, toSeq = initial.toSeq, dataSearch = initial.dataSearch, expandedMessage = initial.expandedMessage, keyFilter = initial.keyFilter, valueSearch = initial.valueSearch, expandedKey = initial.expandedKey, draftKey = initial.draftKey, draftValue = initial.draftValue, valueMode = initial.valueMode, operationKind = initial.operationKind, operationResource = initial.operationResource, operationTarget = initial.operationTarget, operationRequest = initial.operationRequest, operationAttempt = initial.operationAttempt, operationCompleted = initial.operationCompleted, operationNotice = initial.operationNotice, feedback = initial.feedback, consumerFeedback = initial.consumerFeedback, messageFeedback = initial.messageFeedback, entryFeedback = initial.entryFeedback, noticeSequence = initial.noticeSequence)</script>
  <island name="system-nats" :key='"nats"'>
    <page-shell fill><page-heading :trail="bosca.system.ui.systemTrail(ctx.requestPath)" title="NATS" :subtitle='model.overview?.serverInfo?.let { "v" + it.version + " · " + it.serverName }.orEmpty()'><if model.admin><if model.overview?.serverInfo?.jetstream != null><badge tone="success">JetStream</badge></if><button @click="model.refresh(ctx)" icon="refresh">Refresh</button></if></page-heading>
      <if model.admin><view-tabs label="NATS diagnostics" :tabs="model.tabs" :selected="model.tab" data-bml-preserve="nats-tabs" data-nats-tabs /></if>
      <div class="system-content" :data-bml-scroll='"system-content-" + model.tab'><if !model.admin><alert>Administrator access is required.</alert><else>
        <div class="system-stack" data-nats-console :data-refreshes="model.refreshes">
          <system-feedback :feedback="model.feedback" :notify="false" /><toast id="nats-operation" :message="model.operationNotice" :sequence="model.noticeSequence" tone="success" data-nats-notice /><alert tone="error" ref="transportError" hidden />
          <div class="console-panel" role="tabpanel" tabindex="0" id="nats-panel-overview" aria-labelledby="nats-tab-overview" :hidden='model.tab != "overview"'>
            <if model.overview == null><system-console-metric label="Status" value="Unavailable" tone="error" /></if>
            <for data in listOfNotNull(model.overview)><system-nats-overview :data="data" :uptime="model.uptime" /></for>
          </div>
          <div class="console-panel" role="tabpanel" tabindex="0" id="nats-panel-streams" aria-labelledby="nats-tab-streams" :hidden='model.tab != "streams"'>
            <card :padded="false" :title='"JetStream streams (" + model.streams.size + ")"'><div class="console-body system-stack">
              <form class="system-actions" data-bml-preserve="nats-stream-filter" @submit="model.filterStreams(form.filter)"><field label="Filter streams"><input name="filter" :value="model.streamFilter" @input.debounce.250.coalesce="model.filterStreams(form.filter)" /></field><button type="submit">Filter streams</button></form>
              <if model.streams.isEmpty()><empty-state message="No JetStream streams found." /><else><table-scroll label="JetStream streams"><table class="console-table"><thead><tr><th>Name</th><th>Messages</th><th>Size</th><th>Consumers</th><th>Subjects</th><th>Last sequence</th><th>Deleted</th><th>Actions</th></tr></thead><tbody>
                <for stream in model.streams><tr :data-nats-stream="stream.name"><td><span class="resource-name" data-resource-name>{ stream.name }</span></td><td>{ bosca.system.ui.systemCount(stream.state?.messages) }</td><td>{ bosca.system.ui.systemBytes(stream.state?.bytes) }</td><td>{ bosca.system.ui.systemCount(stream.state?.consumerCount) }</td><td>{ bosca.system.ui.systemCount(stream.state?.numSubjects) }</td><td>{ stream.state?.lastSeq ?: "—" }</td><td>{ bosca.system.ui.systemCount(stream.state?.numDeleted) }</td><td><icon-button icon="eye" :label='"View stream " + stream.name' size="xs" class="ghost" :data-nats-stream-trigger="stream.name == model.streamName" @click="model.openStream(stream.name, ctx)" /></td></tr></for>
              </tbody></table></table-scroll></if>
            </div></card>
          </div>
          <div class="console-panel" role="tabpanel" tabindex="0" id="nats-panel-kv" aria-labelledby="nats-tab-kv" :hidden='model.tab != "kv"'>
            <card :padded="false" :title='"Key-value stores (" + model.buckets.size + ")"'><div class="console-body system-stack">
              <form class="system-actions" data-bml-preserve="nats-bucket-filter" @submit="model.filterBuckets(form.filter)"><field label="Filter buckets"><input name="filter" :value="model.bucketFilter" @input.debounce.250.coalesce="model.filterBuckets(form.filter)" /></field><button type="submit">Filter buckets</button></form>
              <if model.buckets.isEmpty()><empty-state message="No key-value stores found." /><else><table-scroll label="NATS key-value stores"><table class="console-table"><thead><tr><th>Bucket</th><th>Entries</th><th>Size</th><th>TTL</th><th>History</th><th>Maximum size</th><th>Actions</th></tr></thead><tbody>
                <for bucket in model.buckets><tr :data-nats-bucket="bucket.bucket"><td><span class="resource-name" data-resource-name>{ bucket.bucket }</span></td><td>{ bosca.system.ui.systemCount(bucket.entryCount) }</td><td>{ bosca.system.ui.systemBytes(bucket.bytes) }</td><td>{ if (bucket.ttl == 0L) "∞" else bosca.system.ui.systemDurationMillis(bucket.ttl) }</td><td>{ bucket.history }</td><td>{ if (bucket.maxBytes > 0) bosca.system.ui.systemBytes(bucket.maxBytes) else "Unlimited" }</td><td><icon-button icon="eye" :label='"View bucket " + bucket.bucket' size="xs" class="ghost" :data-nats-bucket-trigger="bucket.bucket == model.bucketName" @click="model.openBucket(bucket.bucket, ctx)" /></td></tr></for>
              </tbody></table></table-scroll></if>
            </div></card>
          </div>
          <div class="console-panel" role="tabpanel" tabindex="0" id="nats-panel-connections" aria-labelledby="nats-tab-connections" :hidden='model.tab != "connections"'>
            <card :padded="false" :title='"Active connections (" + model.connections.size + ")"' :description='model.overview?.connections?.let { it.total.toString() + " total · showing up to 100" }.orEmpty()'><div class="console-body system-stack">
              <form class="system-actions" data-bml-preserve="nats-connection-filter" @submit="model.filterConnections(form.filter)"><field label="Filter by name, IP, or language"><input name="filter" :value="model.connectionFilter" @input.debounce.250.coalesce="model.filterConnections(form.filter)" /></field><button type="submit">Filter connections</button></form>
              <if model.connections.isEmpty()><empty-state message="No matching connections." /><else><table-scroll label="NATS connections"><table class="console-table"><thead><tr><th>ID</th><th>Name</th><th>IP</th><th>Subscriptions</th><th>Messages in</th><th>Messages out</th><th>Bytes in</th><th>Bytes out</th><th>Uptime</th><th>Idle</th><th>Client</th></tr></thead><tbody>
                <for connection in model.connections><tr :data-nats-connection="connection.cid.toString()"><td><details :data-bml-disclosure='"nats-connection-" + connection.cid'><disclosure-heading>{ connection.cid }</disclosure-heading><dl class="console-facts"><dt>Kind</dt><dd>{ connection.kind ?: "—" }</dd><dt>Type</dt><dd>{ connection.type ?: "—" }</dd><dt>Port</dt><dd>{ connection.port }</dd><dt>Started</dt><dd>{ connection.start ?: "—" }</dd><dt>Last activity</dt><dd>{ connection.lastActivity ?: "—" }</dd><dt>Round trip time</dt><dd>{ connection.rtt ?: "—" }</dd><dt>Pending bytes</dt><dd>{ bosca.system.ui.systemBytes(connection.pendingBytes) }</dd></dl></details></td><td>{ connection.name ?: "—" }</td><td>{ connection.ip }</td><td>{ bosca.system.ui.systemCount(connection.subscriptions) }</td><td>{ bosca.system.ui.systemCount(connection.inMsgs) }</td><td>{ bosca.system.ui.systemCount(connection.outMsgs) }</td><td>{ bosca.system.ui.systemBytes(connection.inBytes) }</td><td>{ bosca.system.ui.systemBytes(connection.outBytes) }</td><td>{ connection.uptime }</td><td>{ connection.idle }</td><td>{ listOfNotNull(connection.lang, connection.version).joinToString(" ").ifBlank { "—" } }</td></tr></for>
              </tbody></table></table-scroll></if>
            </div></card>
          </div>
          <div class="console-panel" role="tabpanel" tabindex="0" id="nats-panel-routes" aria-labelledby="nats-tab-routes" :hidden='model.tab != "routes"'>
            <card :padded="false" :title='"Cluster routes (" + (model.overview?.clusterRoutes?.numRoutes ?: 0) + ")"'><if model.overview?.clusterRoutes?.routes.orEmpty().isEmpty()><empty-state message="No cluster routes reported." /><else><table-scroll label="NATS cluster routes"><table class="console-table"><thead><tr><th>ID</th><th>Remote name</th><th>Remote ID</th><th>IP</th><th>Port</th><th>Solicited</th><th>Configured</th><th>Subscriptions</th><th>Messages in</th><th>Messages out</th><th>Bytes in</th><th>Bytes out</th><th>Pending</th></tr></thead><tbody>
              <for route in model.overview?.clusterRoutes?.routes.orEmpty()><tr><td>{ route.rid }</td><td>{ route.remoteName.ifBlank { "—" } }</td><td>{ route.remoteId }<copy :value="route.remoteId" label="Copy remote server ID" /></td><td>{ route.ip }</td><td>{ route.port }</td><td><badge :tone='if (route.didSolicit) "success" else "neutral"'>{ if (route.didSolicit) "Yes" else "No" }</badge></td><td>{ if (route.isConfigured) "Yes" else "No" }</td><td>{ route.subscriptions }</td><td>{ bosca.system.ui.systemCount(route.inMsgs) }</td><td>{ bosca.system.ui.systemCount(route.outMsgs) }</td><td>{ bosca.system.ui.systemBytes(route.inBytes) }</td><td>{ bosca.system.ui.systemBytes(route.outBytes) }</td><td>{ bosca.system.ui.systemBytes(route.pendingSize) }</td></tr></for>
            </tbody></table></table-scroll></if></card>
          </div>
          <for stream in listOfNotNull(model.selectedStream)>
            <dialog :title="stream.name" subtitle="JetStream" triggerLabel="Stream details" :showTrigger="false" :openRequest="model.streamOpenRequest" :data-bml-preserve='"nats-stream-" + model.streamRequest' returnFocus="[data-nats-stream-trigger]" size="xl" placement="right" icon="pulse" data-nats-stream-panel>
              <form class="modal-form" @submit="model.loadMessages(form.limit, form.subjectFilter, form.fromSeq, form.toSeq, form.dataSearch, ctx)"><form-body padded class="modal-fields">
                <copy-field label="Stream" :value="stream.name" /><system-feedback :feedback="model.feedback" :notify="false" />
                <div class="system-actions"><button @click="model.reloadStream(form.limit, form.subjectFilter, form.fromSeq, form.toSeq, form.dataSearch, ctx)">Refresh stream</button><button @click='model.prepareStreamOperation("purgeStreamDeletes", "", form.limit, form.subjectFilter, form.fromSeq, form.toSeq, form.dataSearch)'>Purge stream tombstones</button><button class="danger" @click='model.prepareStreamOperation("purgeStream", "", form.limit, form.subjectFilter, form.fromSeq, form.toSeq, form.dataSearch)'>Purge stream</button></div>
                <div class="console-stat-grid">
                  <system-console-metric label="Messages" :value="bosca.system.ui.systemCount(stream.state?.messages)" /><system-console-metric label="Size" :value="bosca.system.ui.systemBytes(stream.state?.bytes)" /><system-console-metric label="Consumers" :value="bosca.system.ui.systemCount(stream.state?.consumerCount)" /><system-console-metric label="Subjects" :value="bosca.system.ui.systemCount(stream.state?.numSubjects)" /><system-console-metric label="First sequence" :value='stream.state?.firstSeq?.toString() ?: "—"' /><system-console-metric label="Last sequence" :value='stream.state?.lastSeq?.toString() ?: "—"' /><system-console-metric label="Deleted" :value="bosca.system.ui.systemCount(stream.state?.numDeleted)" />
                </div><dl class="console-facts"><dt>Created</dt><dd>{ stream.created ?: "—" }</dd><dt>Cluster leader</dt><dd>{ stream.cluster?.leader ?: "—" }</dd></dl>
                <h3>{ "Consumers (" + model.consumers.size + ")" }</h3><system-feedback :feedback="model.consumerFeedback" />
                <if model.consumers.isEmpty()><empty-state message="No consumers." /><else><table-scroll label="JetStream consumers"><table class="console-table"><thead><tr><th>Name</th><th>Pending</th><th>Acknowledgment pending</th><th>Redelivered</th><th>Waiting</th><th>Delivered sequence</th><th>Acknowledgment floor</th></tr></thead><tbody>
                  <for consumer in model.consumers><tr :data-nats-consumer="consumer.name"><td><details :data-bml-disclosure='"nats-consumer-" + model.streamName + "-" + consumer.name'><disclosure-heading>{ consumer.name }</disclosure-heading><dl class="console-facts"><dt>Stream</dt><dd>{ consumer.streamName }</dd><dt>Created</dt><dd>{ consumer.created ?: "—" }</dd><dt>Cluster leader</dt><dd>{ consumer.cluster?.leader ?: "—" }</dd><dt>Delivered consumer sequence</dt><dd>{ consumer.delivered?.consumerSeq ?: "—" }</dd><dt>Acknowledgment consumer sequence</dt><dd>{ consumer.ackFloor?.consumerSeq ?: "—" }</dd></dl></details></td><td>{ bosca.system.ui.systemCount(consumer.numPending) }</td><td><badge :tone='if (consumer.numAckPending > 0) "warning" else "neutral"'>{ bosca.system.ui.systemCount(consumer.numAckPending) }</badge></td><td><badge :tone='if (consumer.numRedelivered > 0) "error" else "neutral"'>{ bosca.system.ui.systemCount(consumer.numRedelivered) }</badge></td><td>{ bosca.system.ui.systemCount(consumer.numWaiting) }</td><td>{ consumer.delivered?.streamSeq ?: "—" }</td><td>{ consumer.ackFloor?.streamSeq ?: "—" }</td></tr></for>
                </tbody></table></table-scroll></if>
                <h3>Messages</h3><system-feedback :feedback="model.messageFeedback" />
                <div class="console-grid"><field label="Limit"><input name="limit" type="number" min="1" max="1000" :value="model.messageLimit" /></field><field label="Subject filter"><input name="subjectFilter" :value="model.subjectFilter" placeholder="jobs.>" /></field><field label="From sequence"><input name="fromSeq" inputmode="numeric" :value="model.fromSeq" /></field><field label="To sequence"><input name="toSeq" inputmode="numeric" :value="model.toSeq" /></field><field label="Search payload"><input name="dataSearch" :value="model.dataSearch" /></field></div><div><button type="submit">Apply message filters</button></div>
                <if model.messages.isEmpty()><empty-state message="No messages match these filters." /><else><div class="system-stack"><for message in model.messages><card :padded="false" :title='message.subject + " · #" + message.sequence' :data-nats-message="message.sequence.toString()"><div class="console-body system-stack">
                  <button @click="model.toggleMessage(message.sequence.toString(), form.limit, form.subjectFilter, form.fromSeq, form.toSeq, form.dataSearch)">{ if (model.expandedMessage == message.sequence.toString()) "Hide message" else "Inspect message" }</button><p class="system-muted">{ message.data.orEmpty().take(60).ifEmpty { "(empty)" } }</p><time :value="message.timestamp" />
                  <if model.expandedMessage == message.sequence.toString()><div data-nats-message-detail><dl class="console-facts"><dt>Subject</dt><dd>{ message.subject }</dd><dt>Sequence</dt><dd>{ message.sequence }</dd><dt>Timestamp</dt><dd>{ message.timestamp }</dd></dl><if message.headers.isNotEmpty()><h4>Headers</h4><dl class="console-facts"><for header in message.headers><dt>{ header.key }</dt><dd>{ header.values.joinToString(", ") }</dd></for></dl></if><system-console-payload :name='"message-" + message.sequence' label="Message payload" :value="message.data" /><div class="system-actions"><copy :value="message.data.orEmpty()" label="Copy message payload" /><button class="danger" @click='model.prepareStreamOperation("deleteMessage", message.sequence.toString(), form.limit, form.subjectFilter, form.fromSeq, form.toSeq, form.dataSearch)'>Delete message</button></div></div></if>
                </div></card></for></div></if>
              </form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Close</button></form-actions></form>
            </dialog>
          </for>
          <for bucket in listOfNotNull(model.selectedBucket)>
            <dialog :title="bucket.bucket" subtitle="Key-value store" triggerLabel="Bucket details" :showTrigger="false" :openRequest="model.bucketOpenRequest" :data-bml-preserve='"nats-bucket-" + model.bucketRequest' returnFocus="[data-nats-bucket-trigger]" size="xl" placement="right" icon="database" data-nats-bucket-panel>
              <form class="modal-form" @submit="model.loadEntries(form.keyFilter, form.valueSearch, form.key, form.value, ctx)"><form-body padded class="modal-fields">
                <copy-field label="Bucket" :value="bucket.bucket" /><system-feedback :feedback="model.feedback" :notify="false" />
                <div class="system-actions"><button @click='model.prepareBucketOperation("purgeBucketDeletes", "", form.key, form.value, form.keyFilter, form.valueSearch)'>Purge key-value tombstones</button></div>
                <div class="console-stat-grid"><system-console-metric label="Entries" :value="bosca.system.ui.systemCount(bucket.entryCount)" /><system-console-metric label="Size" :value="bosca.system.ui.systemBytes(bucket.bytes)" /><system-console-metric label="History" :value="bucket.history.toString()" /><system-console-metric label="TTL" :value='if (bucket.ttl == 0L) "∞" else bosca.system.ui.systemDurationMillis(bucket.ttl)' /><system-console-metric label="Maximum size" :value='if (bucket.maxBytes > 0) bosca.system.ui.systemBytes(bucket.maxBytes) else "Unlimited"' /><system-console-metric label="Maximum value" :value='if (bucket.maxValueSize > 0) bosca.system.ui.systemBytes(bucket.maxValueSize) else "Unlimited"' /></div>
                <h3>Put entry</h3><field label="Key"><input name="key" :value="model.draftKey" /></field><field label="Value format"><select name="valueMode" label="Value format" @change="model.setValueMode(form.valueMode, form.key, form.value, form.keyFilter, form.valueSearch)"><option value="text" :selected='model.valueMode == "text"'>Text</option><option value="json" :selected='model.valueMode == "json"'>JSON</option></select></field>
                <field label="Value"><if model.valueMode == "json"><json-editor name="value" label="Entry value" :text="model.draftValue" mode="text" /><else><input name="value" multiline :rows="4" mono :value="model.draftValue" /></if></field>
                <div><button primary @click="model.putEntry(form.key, form.value, form.keyFilter, form.valueSearch, ctx)">Put entry</button></div>
                <h3>Entries</h3><system-feedback :feedback="model.entryFeedback" /><div class="console-grid"><field label="Key filter" hint="NATS wildcards, for example prefix.*"><input name="keyFilter" :value="model.keyFilter" /></field><field label="Search values"><input name="valueSearch" :value="model.valueSearch" /></field></div><div><button type="submit">Apply entry filters</button></div><p class="system-muted">Up to 500 live entries are returned.</p>
                <if model.entries.isEmpty()><empty-state message="No live entries match these filters." /><else><div class="system-stack"><for entry in model.entries><card :padded="false" :title="entry.key" :data-nats-entry="entry.key"><div class="console-body system-stack"><div class="system-actions"><badge>{ "Rev " + entry.revision }</badge><badge :tone='if (entry.operation == "PUT") "success" else "warning"'>{ entry.operation }</badge><button @click="model.toggleEntry(entry.key, form.key, form.value, form.keyFilter, form.valueSearch)">{ if (model.expandedKey == entry.key) "Hide entry" else "Inspect entry" }</button></div><p class="system-muted">{ entry.value.orEmpty().take(80).ifEmpty { "(empty)" } }</p>
                  <if model.expandedKey == entry.key><div data-nats-entry-detail><dl class="console-facts"><dt>Key</dt><dd>{ entry.key }</dd><dt>Revision</dt><dd>{ entry.revision }</dd><dt>Operation</dt><dd>{ entry.operation }</dd><dt>Created</dt><dd>{ entry.created }</dd></dl><system-console-payload :name='"entry-" + entry.revision' label="Entry payload" :value="entry.value" /><div class="system-actions"><copy :value="entry.value.orEmpty()" label="Copy entry value" /><button class="danger" @click='model.prepareBucketOperation("deleteKey", entry.key, form.key, form.value, form.keyFilter, form.valueSearch)'>Delete key</button></div></div></if>
                </div></card></for></div></if>
              </form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Close</button></form-actions></form>
            </dialog>
          </for>
          <if model.operationKind.isNotBlank()>
            <dialog :title="model.operationTitle" :subtitle="model.operationResource" triggerLabel="Confirm NATS operation" :showTrigger="false" :openRequest="model.operationOpenRequest" :completed="model.operationCompleted" :data-bml-preserve='"nats-confirm-" + model.operationOpenRequest' :returnFocus="model.operationReturnFocus" size="sm" data-nats-confirmation>
              <form class="modal-form" @submit="model.confirmOperation(form.confirmed, ctx)"><form-body padded class="modal-fields"><p>{ model.operationDescription }</p><if model.feedback.failed><alert tone="error">{ model.feedback.message }</alert></if><checkbox name="confirmed" label="Confirm this operation" required /></form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Cancel</button><button type="submit" class="danger">Confirm</button></form-actions></form>
            </dialog>
          </if>
        </div>
      </if></div>
    </page-shell>
  </island>
  <script client scoped>
    const relationships = () => {
      for (const tab of ctx.root.querySelectorAll<HTMLElement>("[data-nats-tabs] [data-tab]")) {
        tab.id = "nats-tab-" + (tab.dataset.tab ?? "");
        tab.setAttribute("aria-controls", "nats-panel-" + (tab.dataset.tab ?? ""));
      }
    };
    ctx.on<CustomEvent<string>>(ctx.root, "viewchange", async event => {
      if (!(event.target instanceof Element) || !event.target.hasAttribute("data-nats-tabs")) return;
      for (const panel of ctx.root.querySelectorAll<HTMLElement>(".console-panel")) panel.hidden = panel.id !== "nats-panel-" + event.detail;
      try { await ctx.dispatch(model.chooseTab(event.detail), { coalesce: true }); }
      catch (failure) { const error = ctx.ref<HTMLElement>("transportError"); if (error) { error.textContent = failure instanceof Error ? failure.message : String(failure); error.hidden = false; } }
    });
    let busy = false, disposed = false;
    const timer = setInterval(async () => {
      if (disposed || busy || document.hidden || !ctx.root.querySelector("[data-nats-console]") || ctx.root.querySelector("dialog[open], [data-bml-action-pending]")) return;
      busy = true;
      try { await ctx.dispatch(model.refresh(ctx)); }
      catch (failure) { const error = ctx.ref<HTMLElement>("transportError"); if (error) { error.textContent = failure instanceof Error ? failure.message : String(failure); error.hidden = false; } }
      finally { busy = false; }
    }, 10000);
    ctx.onUpdate(relationships); ctx.onUnmount(() => { disposed = true; clearInterval(timer); }); relationships();
  </script>
</component>
