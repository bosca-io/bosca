<component tag="system-nats-overview">
  <prop name="data" type="bosca.system.ui.graphql.SystemGetNatsAdminOverviewData.NatsAdmin" required />
  <prop name="uptime" type="Pair<String, String>" required />
  <div class="system-stack">
    <card :padded="false" title="Server overview"><div class="console-body system-stack"><div class="console-stat-grid">
      <system-console-metric label="Status" value="Connected" tone="success" /><system-console-metric label="Uptime" :value="uptime.first" :detail="uptime.second" />
      <system-console-metric label="Connections" :value="bosca.system.ui.systemCount(data.serverInfo.connections)" /><system-console-metric label="Total connections" :value="bosca.system.ui.systemCount(data.serverInfo.totalConnections)" />
      <system-console-metric label="Memory" :value="bosca.system.ui.systemBytes(data.serverInfo.mem)" /><system-console-metric label="CPU" :value='bosca.system.ui.systemDecimal(data.serverInfo.cpu) + "%"' />
      <system-console-metric label="Subscriptions" :value="bosca.system.ui.systemCount(data.serverInfo.subscriptions)" /><system-console-metric label="Slow consumers" :value="bosca.system.ui.systemCount(data.serverInfo.slowConsumers)" :tone='if (data.serverInfo.slowConsumers > 0) "error" else ""' />
      <system-console-metric label="Messages in" :value="bosca.system.ui.systemCount(data.serverInfo.inMsgs)" /><system-console-metric label="Messages out" :value="bosca.system.ui.systemCount(data.serverInfo.outMsgs)" />
      <system-console-metric label="Bytes in" :value="bosca.system.ui.systemBytes(data.serverInfo.inBytes)" /><system-console-metric label="Bytes out" :value="bosca.system.ui.systemBytes(data.serverInfo.outBytes)" /><system-console-metric label="Maximum payload" :value="bosca.system.ui.systemBytes(data.serverInfo.maxPayload.toLong())" />
    </div><details><disclosure-heading>Server details</disclosure-heading><dl class="console-facts"><dt>Server ID</dt><dd>{ data.serverInfo.serverId }<copy :value="data.serverInfo.serverId" label="Copy server ID" /></dd><dt>Name</dt><dd>{ data.serverInfo.serverName }</dd><dt>Version</dt><dd>{ data.serverInfo.version }</dd><dt>Host</dt><dd>{ data.serverInfo.host }</dd><dt>Port</dt><dd>{ data.serverInfo.port }</dd><dt>Maximum connections</dt><dd>{ bosca.system.ui.systemCount(data.serverInfo.maxConnections) }</dd></dl></details></div></card>
    <card :padded="false" title="JetStream"><div class="console-body system-stack"><div class="console-stat-grid">
      <system-console-metric label="Streams" :value="bosca.system.ui.systemCount(data.jetStreamInfo.streams)" /><system-console-metric label="Consumers" :value="bosca.system.ui.systemCount(data.jetStreamInfo.consumers)" /><system-console-metric label="Messages" :value="bosca.system.ui.systemCount(data.jetStreamInfo.messages)" />
      <system-console-metric label="Stored message bytes" :value="bosca.system.ui.systemBytes(data.jetStreamInfo.bytes)" /><system-console-metric label="Memory used" :value="bosca.system.ui.systemBytes(data.jetStreamInfo.memory)" /><system-console-metric label="Storage used" :value="bosca.system.ui.systemBytes(data.jetStreamInfo.storage)" />
      <system-console-metric label="API calls" :value="bosca.system.ui.systemCount(data.jetStreamInfo.api?.total)" /><system-console-metric label="API errors" :value="bosca.system.ui.systemCount(data.jetStreamInfo.api?.errors)" :tone='if ((data.jetStreamInfo.api?.errors ?: 0) > 0) "error" else ""' />
    </div><for jetstream in listOfNotNull(data.serverInfo.jetstream)><details><disclosure-heading>JetStream server configuration</disclosure-heading><for config in listOfNotNull(jetstream.config)><dl class="console-facts"><dt>Maximum memory</dt><dd>{ bosca.system.ui.systemBytes(config.maxMemory) }</dd><dt>Maximum storage</dt><dd>{ bosca.system.ui.systemBytes(config.maxStorage) }</dd><dt>Store directory</dt><dd>{ config.storeDir }</dd></dl></for><for stats in listOfNotNull(jetstream.stats)><dl class="console-facts"><dt>Memory</dt><dd>{ bosca.system.ui.systemBytes(stats.memory) }</dd><dt>Storage</dt><dd>{ bosca.system.ui.systemBytes(stats.storage) }</dd><dt>Reserved memory</dt><dd>{ bosca.system.ui.systemBytes(stats.reservedMemory) }</dd><dt>Reserved storage</dt><dd>{ bosca.system.ui.systemBytes(stats.reservedStorage) }</dd><dt>Accounts</dt><dd>{ stats.accounts }</dd><dt>HA assets</dt><dd>{ stats.haAssets }</dd><dt>API calls</dt><dd>{ bosca.system.ui.systemCount(stats.api?.total) }</dd><dt>API errors</dt><dd>{ bosca.system.ui.systemCount(stats.api?.errors) }</dd></dl></for></details></for></div></card>
    <card :padded="false" title="Subscription routing"><div class="console-body console-stat-grid">
      <system-console-metric label="Subscriptions" :value="bosca.system.ui.systemCount(data.subscriptionsInfo.numSubscriptions)" /><system-console-metric label="Cache entries" :value="bosca.system.ui.systemCount(data.subscriptionsInfo.numCache)" />
      <system-console-metric label="Cache hit rate" :value='bosca.system.ui.systemDecimal(data.subscriptionsInfo.cacheHitRate * 100) + "%"' :tone='if (data.subscriptionsInfo.cacheHitRate < 0.9) "warning" else ""' />
      <system-console-metric label="Matches" :value="bosca.system.ui.systemCount(data.subscriptionsInfo.numMatches)" /><system-console-metric label="Maximum fanout" :value="bosca.system.ui.systemCount(data.subscriptionsInfo.maxFanout)" /><system-console-metric label="Average fanout" :value="bosca.system.ui.systemDecimal(data.subscriptionsInfo.avgFanout, 2)" />
      <system-console-metric label="Inserts" :value="bosca.system.ui.systemCount(data.subscriptionsInfo.numInserts)" /><system-console-metric label="Removes" :value="bosca.system.ui.systemCount(data.subscriptionsInfo.numRemoves)" />
    </div></card>
  </div>
</component>
