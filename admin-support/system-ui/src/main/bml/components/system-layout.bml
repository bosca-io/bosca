<component tag="system-layout">
  <prop name="title" type="String" required />
  <prop name="admin" type="Boolean" default="false" />
  <script server provides="path">ctx.requestPath</script>
  <script server provides="appearance">if (ctx.cookies["git_ui_appearance"] == "light") "light" else "dark"</script>
  <html lang="en" :data-theme="appearance">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex,nofollow" />
      <title>{ title } — Bosca Atlas</title>
      <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    </head>
    <body class="system-document" :data-theme="appearance">
      <app-shell>
        <app-header brand="Bosca" product="Atlas" href="/">
          <div data-atlas-system-switcher><subsystem-switcher :items="bosca.atlas.ui.AtlasSubsystems.items" currentId="system" product="Atlas" /></div>
          <nav class="shell-navigation system-navigation" aria-label="System">
            <for group in bosca.system.ui.systemNavigationGroups>
              <div class="system-navigation-group"><p class="system-navigation-label">{ group.label }</p>
                <for item in group.items><a :href="item.href" :aria-current='if (bosca.system.ui.systemNavigationSelected(path, item.href)) "page" else "false"'><span class="shell-icon"><icon :name="bosca.system.ui.systemNavigationIcon(item.href)" :size="14" /></span>{ item.label }</a></for>
              </div>
            </for>
          </nav>
          <div class="shell-footer">
            <profile-menu />
          </div>
        </app-header>
        <div class="shell-main">
          <slot />
        </div>
      </app-shell>
    </body>
  </html>
</component>
