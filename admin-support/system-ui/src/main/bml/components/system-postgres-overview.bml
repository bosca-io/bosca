<component tag="system-postgres-overview">
  <prop name="data" type="bosca.system.ui.graphql.SystemGetPostgresAdminOverviewData.PostgresAdmin" required />
  <div class="system-stack">
    <card :padded="false"><section-heading title="Connection pools" :subtitle='data.connectionPoolStats.size.toString() + " pools"' /><div class="console-body">
      <if data.connectionPoolStats.isEmpty()><empty-state message="No application pools reported." /><else><div class="console-grid">
        <for pool in data.connectionPoolStats><card :padded="false" class="pool-card"><div class="pool-body"><div class="pool-heading"><strong>{ pool.poolName }</strong><badge :tone='if (pool.hasAvailableConnections) "success" else "error"'>{ if (pool.hasAvailableConnections) "Available" else "Saturated" }</badge></div><dl class="console-facts pool-facts"><dt>Active</dt><dd>{ pool.activeConnections.toString() + " / " + pool.maxConnections }</dd><dt>Created</dt><dd>{ bosca.system.ui.systemCount(pool.createdConnections) }</dd></dl><progress-bar class="pool-utilization" :data-tone='if (pool.activeConnections.toDouble() / pool.maxConnections.coerceAtLeast(1) >= 0.9) "error" else if (pool.activeConnections.toDouble() / pool.maxConnections.coerceAtLeast(1) >= 0.7) "warning" else "success"' :label='pool.poolName + " pool utilization"' :value="pool.activeConnections.toDouble()" :max="pool.maxConnections.coerceAtLeast(1).toDouble()" /></div></card></for>
      </div></if>
    </div></card>
    <card :padded="false" title="Database I/O"><div class="console-body"><div class="console-stat-grid">
      <system-console-metric label="Rows inserted" :value="bosca.system.ui.systemCount(data.databaseStats.tupInserted)" /><system-console-metric label="Rows updated" :value="bosca.system.ui.systemCount(data.databaseStats.tupUpdated)" /><system-console-metric label="Rows deleted" :value="bosca.system.ui.systemCount(data.databaseStats.tupDeleted)" /><system-console-metric label="Temporary files" :value="bosca.system.ui.systemCount(data.databaseStats.tempFiles)" :detail="bosca.system.ui.systemBytes(data.databaseStats.tempBytes)" />
    </div><details data-bml-disclosure="pg-database-counters"><disclosure-heading>Database counters</disclosure-heading><dl class="console-facts"><dt>Database</dt><dd>{ data.databaseStats.databaseName }</dd><dt>Blocks read</dt><dd>{ bosca.system.ui.systemCount(data.databaseStats.blksRead) }</dd><dt>Blocks hit</dt><dd>{ bosca.system.ui.systemCount(data.databaseStats.blksHit) }</dd><dt>Rows returned</dt><dd>{ bosca.system.ui.systemCount(data.databaseStats.tupReturned) }</dd><dt>Rows fetched</dt><dd>{ bosca.system.ui.systemCount(data.databaseStats.tupFetched) }</dd><dt>Conflicts</dt><dd>{ bosca.system.ui.systemCount(data.databaseStats.conflicts) }</dd><dt>Statistics reset</dt><dd>{ data.databaseStats.statsReset ?: "—" }</dd></dl></details></div></card>
    <if data.vacuumProgress.isNotEmpty()><card :padded="false" title="Vacuum progress"><div class="console-body console-grid"><for vacuum in data.vacuumProgress><card :padded="false" :title='vacuum.schemaName.orEmpty() + "." + vacuum.tableName.orEmpty()'><div class="console-body"><badge tone="info">{ vacuum.phase }</badge><dl class="console-facts"><dt>PID</dt><dd>{ vacuum.pid }</dd><dt>Database</dt><dd>{ vacuum.databaseName }</dd><dt>Total blocks</dt><dd>{ bosca.system.ui.systemCount(vacuum.heapBlksTotal) }</dd><dt>Blocks scanned</dt><dd>{ bosca.system.ui.systemCount(vacuum.heapBlksScanned) }</dd><dt>Blocks vacuumed</dt><dd>{ bosca.system.ui.systemCount(vacuum.heapBlksVacuumed) }</dd><dt>Dead tuples</dt><dd>{ bosca.system.ui.systemCount(vacuum.numDeadTuples) }</dd></dl><progress-bar label="Vacuum progress" :value="vacuum.heapBlksVacuumed.toDouble()" :max="vacuum.heapBlksTotal.coerceAtLeast(1).toDouble()" /></div></card></for></div></card></if>
  </div>
  <style scoped>
    .pool-body { display: flex; flex-direction: column; gap: 8px; padding: 12px; }
    .pool-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .pool-heading strong { color: var(--fg-0); font-size: 13px; font-weight: 500; }
    .pool-facts { margin: 0; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 12px; }
  </style>
</component>
