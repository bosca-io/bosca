<component tag="system-meilisearch">
  <prop name="initial" type="bosca.system.ui.MeilisearchConsoleModel" required />
  <script server provides="model">bosca.system.ui.MeilisearchConsoleModel(admin = initial.admin, tab = initial.tab, overview = initial.overview, storageSystems = initial.storageSystems, indexUid = initial.indexUid, indexTab = initial.indexTab, indexRequest = initial.indexRequest, settings = initial.settings, embedders = initial.embedders, documents = initial.documents, documentsTotal = initial.documentsTotal, documentsOffset = initial.documentsOffset, editor = initial.editor, editorId = initial.editorId, editorRequest = initial.editorRequest, editorCompleted = initial.editorCompleted, nodeDraft = initial.nodeDraft, embedderDraft = initial.embedderDraft, newIndexUid = initial.newIndexUid, newPrimaryKey = initial.newPrimaryKey, assignStorageId = initial.assignStorageId, operationKind = initial.operationKind, operationResource = initial.operationResource, operationTarget = initial.operationTarget, operationRequest = initial.operationRequest, operationCompleted = initial.operationCompleted, operationNotice = initial.operationNotice, noticeSequence = initial.noticeSequence, feedback = initial.feedback, storageFeedback = initial.storageFeedback, settingsFeedback = initial.settingsFeedback, embedderFeedback = initial.embedderFeedback, documentsFeedback = initial.documentsFeedback, editorFeedback = initial.editorFeedback)</script>
  <island name="system-meilisearch" :key="model.admin.toString()">
    <page-shell fill>
      <page-heading :trail="bosca.system.ui.systemTrail(ctx.requestPath)" title="Meilisearch" :subtitle="model.subtitle"><if model.admin><if model.overview != null><badge :tone='if (model.overview?.health?.healthy == true) "success" else "error"'>{ if (model.overview?.health?.healthy == true) "Healthy" else "Unhealthy" }</badge></if><button @click.coalesce="model.refresh(ctx)" icon="refresh">Refresh</button></if></page-heading>
      <if model.admin><view-tabs label="Meilisearch administration" :tabs="model.tabs" :selected="model.tab" data-meilisearch-tabs data-bml-preserve="meilisearch-tabs" /></if>
      <div class="system-content" :data-bml-scroll='"system-content-" + model.tab'><if !model.admin><alert>Administrator access is required.</alert><else>
        <div class="system-stack" data-meilisearch-console>
          <system-feedback :feedback="model.feedback" /><toast id="meilisearch-operation" :message="model.operationNotice" :sequence="model.noticeSequence" tone="success" data-meili-notice /><alert ref="transportError" tone="error" hidden />
          <for data in listOfNotNull(model.overview)>
            <card title="Server Overview" :padded="false"><div class="console-body meili-metrics"><system-console-metric label="Status" :value='if (data.health.healthy) "Healthy" else "Unhealthy"' :tone='if (data.health.healthy) "success" else "error"' /><system-console-metric label="Version" :value="data.version.pkgVersion" /><system-console-metric label="Indexes" :value="bosca.system.ui.systemCount(data.stats.numberOfIndexes)" /><system-console-metric label="Database Size" :value="bosca.system.ui.systemBytes(data.stats.databaseSize)" /><system-console-metric label="Last Update" :value="bosca.system.ui.systemDateParts(data.stats.lastUpdate).first" :detail="bosca.system.ui.systemDateParts(data.stats.lastUpdate).second" /><system-console-metric compact label="Commit" :value='data.version.commitSha?.take(10) ?: "—"' /></div></card>
            <div id="meili-panel-nodes" class="console-panel" role="tabpanel" aria-labelledby="meili-tab-nodes" :hidden='model.tab != "nodes"'>
              <card :padded="false"><section-heading :title='"Nodes (" + data.nodes.size + ")"'><button @click.coalesce='model.openEditor("node", "")' primary icon="plus">Add Node</button></section-heading>
                <if data.nodes.isEmpty()><empty-state icon="" compact message="No Meilisearch nodes configured." /><else>
                  <table-scroll label="Meilisearch nodes"><table class="meili-table"><thead><tr><th>Name</th><th>URL</th><th>Health</th><th>Types</th><th class="number">Indexes</th><th>Version</th><th>Actions</th></tr></thead><tbody><for node in data.nodes><tr :data-meili-node="node.id"><td><span data-resource-name>{ node.name }</span></td><td class="mono muted">{ node.url }</td><td><badge :tone='if (node.healthy) "success" else "error"'>{ if (node.healthy) "Healthy" else "Unhealthy" }</badge></td><td><div class="badge-row"><for type in node.types><badge :tone='if (type.name == "SEARCH") "info" else if (type.name == "SUPPLEMENTARY") "success" else "neutral"'>{ type.name }</badge></for><if node.types.isEmpty()><span class="muted">—</span></if></div></td><td class="number mono">{ node.stats?.numberOfIndexes?.toString() ?: "—" }</td><td class="mono muted">{ node.version?.pkgVersion ?: "—" }</td><td><icon-button icon="edit" :label='"Edit node " + node.name' size="xs" class="ghost" data-meili-node-edit @click.coalesce='model.openEditor("node", node.id)' /></td></tr></for></tbody></table></table-scroll>
                  <div class="console-body meili-node-cards"><for node in data.nodes><div class="meili-node-card" :data-meili-node-card="node.id"><div class="meili-resource-heading"><strong>{ node.name }</strong><div class="meili-resource-actions"><button size="xs" icon="link" @click.coalesce='model.openEditor("assign", node.id)'>Assign Storage</button><button size="xs" icon="edit" @click.coalesce='model.openEditor("node", node.id)'>Edit</button><button size="xs" icon="trash" @click.coalesce='model.prepareOperation("deleteNode", node.id, "")'>Delete</button></div></div><if node.description.isNotBlank()><p class="muted">{ node.description }</p></if><if node.storageSystemIds.isEmpty()><p class="muted">No storage system assignments.</p><else><div class="badge-row"><span class="muted">Storage Systems</span><for id in node.storageSystemIds><button size="xs" icon="close" :aria-label='"Remove " + model.storageName(id) + " assignment"' @click.coalesce='model.prepareOperation("removeStorage", node.id, id)'>{ model.storageName(id) }</button></for></div></if></div></for></div>
                </if>
              </card>
            </div>
            <div id="meili-panel-indexes" class="console-panel" role="tabpanel" aria-labelledby="meili-tab-indexes" :hidden='model.tab != "indexes"'>
              <card :padded="false"><section-heading :title='"Indexes (" + data.indexes.size + ")"'><button primary icon="plus" @click.coalesce='model.openEditor("index", "")'>Create Index</button></section-heading><if data.indexes.isEmpty()><empty-state icon="" compact message="No indexes found." /><else><table-scroll label="Meilisearch indexes"><table class="meili-table"><thead><tr><th>UID</th><th>Primary Key</th><th class="number">Documents</th><th>Created</th><th>Updated</th><th>Indexing</th><th>Actions</th></tr></thead><tbody><for index in data.indexes><tr :data-meili-index="index.uid"><td><span class="mono" data-resource-name>{ index.uid }</span></td><td class="mono muted">{ index.primaryKey ?: "—" }</td><td class="number mono">{ bosca.system.ui.systemCount(index.stats.numberOfDocuments) }</td><td><time :value="index.createdAt" /></td><td><time :value="index.updatedAt" /></td><td><badge :tone='if (index.stats.isIndexing) "warning" else "success"'>{ if (index.stats.isIndexing) "Indexing" else "Idle" }</badge></td><td><icon-button icon="eye" :label='"View index " + index.uid' size="xs" class="ghost" data-meili-index-trigger @click.coalesce="model.openIndex(index.uid, ctx)" /></td></tr></for></tbody></table></table-scroll></if></card>
            </div>
            <div id="meili-panel-tasks" class="console-panel" role="tabpanel" aria-labelledby="meili-tab-tasks" :hidden='model.tab != "tasks"'>
              <card :title='"Recent Tasks (" + data.tasks.size + ")"' :padded="false"><if data.tasks.isEmpty()><empty-state icon="" compact message="No tasks found." /><else><for task in data.tasks><details :data-meili-task="task.uid" :data-bml-disclosure='"meili-task-" + task.uid'><disclosure-heading><div class="meili-task-summary"><span class="mono muted">{ task.uid }</span><strong class="mono">{ task.type }</strong><badge :tone='bosca.system.ui.systemMeilisearchTaskTone(task.status)'>{ task.status }</badge><span class="muted">{ task.indexUid ?: "—" }</span><time :value="task.enqueuedAt" /></div></disclosure-heading><div class="console-body"><dl class="console-facts"><dt>UID</dt><dd>{ task.uid }</dd><dt>Type</dt><dd>{ task.type }</dd><dt>Index</dt><dd>{ task.indexUid ?: "—" }</dd><dt>Enqueued</dt><dd><time :value="task.enqueuedAt" /></dd><dt>Started</dt><dd><time :value="task.startedAt.orEmpty()" /></dd><dt>Finished</dt><dd><time :value="task.finishedAt.orEmpty()" /></dd><dt>Duration</dt><dd>{ task.duration ?: "—" }</dd></dl><for failure in listOfNotNull(task.error)><alert tone="error"><strong>{ "Error: " + failure.code }</strong><p>{ failure.message }</p></alert></for><if task.status in listOf("enqueued", "processing")><button @click.coalesce='model.prepareOperation("cancelTask", task.uid.toString(), "")'>Cancel task</button></if></div></details></for></if></card>
            </div>
            <div id="meili-panel-keys" class="console-panel" role="tabpanel" aria-labelledby="meili-tab-keys" :hidden='model.tab != "keys"'>
              <card :title='"API Keys (" + data.keys.size + ")"' :padded="false"><if data.keys.isEmpty()><empty-state icon="" compact message="No API keys found." /><else><table-scroll label="Meilisearch API keys"><table class="meili-table"><thead><tr><th>Name</th><th>UID</th><th>Actions</th><th>Indexes</th><th>Expires</th></tr></thead><tbody><for key in data.keys><tr><td>{ key.name ?: "—" }</td><td class="mono muted" :title="key.uid">{ key.uid.take(12) + if (key.uid.length > 12) "…" else "" }</td><td class="mono muted">{ key.actions.joinToString(", ").ifBlank { "—" } }</td><td class="mono muted">{ key.indexes.joinToString(", ").ifBlank { "*" } }</td><td><if key.expiresAt == null>Never<else><time :value="key.expiresAt.orEmpty()" /></if></td></tr></for></tbody></table></table-scroll></if></card>
            </div>
          </for>
          <for index in listOfNotNull(model.selectedIndex)>
            <dialog :title="index.uid" subtitle="Index" icon="search" triggerLabel="Index details" :showTrigger="false" :openRequest="model.indexOpenRequest" :data-bml-preserve='"meili-index-" + model.indexRequest' returnFocus="[data-meili-index-trigger]" placement="right" size="xl" data-meili-index-panel>
              <div class="modal-form"><div class="meili-drawer-actions"><button size="sm" icon="refresh" @click.coalesce="model.refreshIndex(ctx)">Refresh index</button><button size="sm" icon="trash" @click.coalesce='model.prepareOperation("clearDocuments", index.uid, "")'>Delete All Docs</button><button size="sm" icon="trash" @click.coalesce='model.prepareOperation("deleteIndex", index.uid, "")'>Delete Index</button></div><view-tabs label="Index details" :tabs="model.indexTabs" :selected="model.indexTab" data-meilisearch-index-tabs data-bml-preserve="meili-index-tabs" />
                <div class="modal-fields console-body">
                  <div id="meili-index-panel-stats" role="tabpanel" aria-labelledby="meili-index-tab-stats" :hidden='model.indexTab != "stats"'><div class="meili-metrics meili-index-metrics"><system-console-metric label="Documents" :value="bosca.system.ui.systemCount(index.stats.numberOfDocuments)" /><system-console-metric label="Status" :value='if (index.stats.isIndexing) "Indexing" else "Idle"' :tone='if (index.stats.isIndexing) "warning" else "success"' /><system-console-metric label="Primary Key" :value='index.primaryKey ?: "—"' /><system-console-metric label="Created" :value="bosca.system.ui.systemDateParts(index.createdAt).first" :detail="bosca.system.ui.systemDateParts(index.createdAt).second" /><system-console-metric label="Updated" :value="bosca.system.ui.systemDateParts(index.updatedAt).first" :detail="bosca.system.ui.systemDateParts(index.updatedAt).second" /></div></div>
                  <div id="meili-index-panel-settings" role="tabpanel" aria-labelledby="meili-index-tab-settings" :hidden='model.indexTab != "settings"'><system-feedback :feedback="model.settingsFeedback" /><if model.settings != null><div class="system-stack"><for group in model.settingsGroups><div><h3 class="meili-detail-heading">{ group.first }</h3><div class="badge-row"><for value in group.second><badge>{ value }</badge></for><if group.second.isEmpty()><span class="muted">None</span></if></div></div></for><div><h3 class="meili-detail-heading">Synonyms</h3><if model.settings?.synonyms?.isNotEmpty() == true><json-editor :askToFormat="false" :mainMenuBar="false" :navigationBar="false" name="meiliSynonyms" label="Synonyms" :value="model.synonymsJson" readOnly :preserveKey='"meili-synonyms-" + model.indexRequest' /><else><span class="muted">None</span></if></div><div><button primary @click="model.updateSettings(ctx)">Update Settings</button></div></div></if></div>
                  <div id="meili-index-panel-embedders" role="tabpanel" aria-labelledby="meili-index-tab-embedders" :hidden='model.indexTab != "embedders"'><system-feedback :feedback="model.embedderFeedback" /><div class="system-stack"><div class="meili-resource-heading"><h3 class="meili-detail-heading">{ "Embedders (" + model.embedders.size + ")" }</h3><button size="sm" icon="plus" @click.coalesce='model.openEditor("embedder", "")'>Add Embedder</button></div><if model.embedders.isEmpty()><empty-state icon="" compact message="No embedders configured." /><else><for embedder in model.embedders><div class="meili-node-card" :data-meili-embedder="embedder.name"><div class="meili-resource-heading"><strong class="mono">{ embedder.name }</strong><div class="meili-resource-actions"><button size="xs" icon="edit" @click.coalesce='model.openEditor("embedder", embedder.name)'>Edit</button><button size="xs" icon="trash" @click.coalesce='model.prepareOperation("removeEmbedder", index.uid, embedder.name)'>Remove</button></div></div><dl class="console-facts"><dt>Source</dt><dd>{ embedder.source ?: "—" }</dd><dt>Model</dt><dd>{ embedder.model ?: "—" }</dd><dt>Dimensions</dt><dd>{ embedder.dimensions?.toString() ?: "—" }</dd><if embedder.url != null><dt>URL</dt><dd>{ embedder.url }</dd></if><if embedder.documentTemplate != null><dt>Template</dt><dd class="mono">{ embedder.documentTemplate }</dd></if><if embedder.documentTemplateMaxBytes != null><dt>Template max bytes</dt><dd>{ bosca.system.ui.systemCount(embedder.documentTemplateMaxBytes) }</dd></if></dl><for block in listOf("Request" to embedder.request, "Response" to embedder.response, "Headers" to embedder.headers)><if block.second != null><h4 class="meili-detail-heading">{ block.first }</h4><json-editor :askToFormat="false" :mainMenuBar="false" :navigationBar="false" class="meili-embedder-json" mode="text" :name='"embedder-" + embedder.name + "-" + block.first' :label="block.first" :value="block.second ?: kotlinx.serialization.json.JsonNull" readOnly /></if></for></div></for></if></div></div>
                  <div id="meili-index-panel-documents" role="tabpanel" aria-labelledby="meili-index-tab-documents" :hidden='model.indexTab != "documents"'><system-feedback :feedback="model.documentsFeedback" /><div class="system-stack"><h3 class="meili-detail-heading">{ "Documents (" + bosca.system.ui.systemCount(model.documentsTotal) + " total)" }</h3><if model.documents.isEmpty()><empty-state icon="" compact message="No documents." /><else><for document in model.documents><json-editor :askToFormat="false" :mainMenuBar="false" :navigationBar="false" :name='"meili-document-" + model.documents.indexOf(document)' label="Document" :value="bosca.system.ui.systemMeilisearchDocument(document)" readOnly /></for><pagination :hasPrevious="model.documentsOffset > 0" :hasNext="model.documentsOffset.toLong() + 20 < model.documentsTotal" :summary='(model.documentsOffset + 1).toString() + " – " + model.documentsEnd + " of " + bosca.system.ui.systemCount(model.documentsTotal)'><button size="sm" :disabled="model.documentsOffset == 0" @click.coalesce="model.loadDocuments((model.documentsOffset - 20).coerceAtLeast(0), ctx)">Previous</button><button size="sm" :disabled="model.documentsOffset.toLong() + 20 >= model.documentsTotal" @click.coalesce="model.loadDocuments(model.documentsOffset + 20, ctx)">Next</button></pagination></if></div></div>
                </div><form-actions class="modal-footer" bordered><button data-dialog-close>Close</button></form-actions>
              </div>
            </dialog>
          </for>
          <if model.editor == "node"><dialog @dialogdismiss.coalesce="model.cancelEditor()" :title='if (model.editorId.isBlank()) "Add Node" else "Edit Node"' icon="database" triggerLabel="Node editor" :showTrigger="false" :openRequest="model.editorOpenRequest" :completed="model.editorCompleted" :data-bml-preserve='"meili-editor-" + model.editorRequest' data-meili-node-editor><form class="modal-form" @submit="model.saveNode(form.name, form.description, form.url, form.key, form.search, form.vector, form.supplementary, ctx)"><form-body padded class="modal-fields"><field label="Name"><input name="name" :value="model.nodeDraft.name" required /></field><field label="Description"><input name="description" :value="model.nodeDraft.description" /></field><field label="URL"><input name="url" :value="model.nodeDraft.url" placeholder="http://localhost:7700" required mono /></field><field label="API Key" :hint='if (model.editorId.isBlank()) "" else "Leave blank to keep the current key."'><input name="key" type="password" autocomplete="new-password" :value="model.nodeDraft.key" :required="model.editorId.isBlank()" /></field><fieldset class="meili-node-types"><legend>Types</legend><div class="badge-row"><for type in listOf("SEARCH", "VECTOR", "SUPPLEMENTARY")><checkbox :name="type.lowercase()" :label="type" :checked="type in model.nodeDraft.types" /></for></div></fieldset><system-feedback :feedback="model.editorFeedback" /></form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Cancel</button><button type="submit" primary>Save</button></form-actions></form></dialog></if>
          <if model.editor == "index"><dialog @dialogdismiss.coalesce="model.cancelEditor()" title="Create Index" icon="plus" triggerLabel="Index editor" :showTrigger="false" :openRequest="model.editorOpenRequest" :completed="model.editorCompleted" :data-bml-preserve='"meili-editor-" + model.editorRequest' size="sm" data-meili-create-index><form class="modal-form" @submit="model.createIndex(form.uid, form.primaryKey, ctx)"><form-body padded class="modal-fields"><field label="UID"><input name="uid" :value="model.newIndexUid" required mono placeholder="my-index" /></field><field label="Primary Key (optional)"><input name="primaryKey" :value="model.newPrimaryKey" mono placeholder="id" /></field><system-feedback :feedback="model.editorFeedback" /></form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Cancel</button><button type="submit" primary>Create</button></form-actions></form></dialog></if>
          <if model.editor == "assign"><dialog @dialogdismiss.coalesce="model.cancelEditor()" title="Assign to Storage System" icon="link" triggerLabel="Storage assignment" :showTrigger="false" :openRequest="model.editorOpenRequest" :completed="model.editorCompleted" :data-bml-preserve='"meili-editor-" + model.editorRequest' size="sm" data-meili-assign-storage><form class="modal-form" @submit="model.assignStorage(form.storageSystemId, ctx)"><form-body padded class="modal-fields"><system-feedback :feedback="model.storageFeedback" /><field label="Storage System"><select name="storageSystemId" label="Storage System" searchable required><option value="">Select a storage system</option><for storage in model.availableStorage><option :value="storage.id" :selected="storage.id == model.assignStorageId">{ storage.name }</option></for></select></field><if model.availableStorage.isEmpty()><p class="muted">No unassigned storage systems are available.</p></if><system-feedback :feedback="model.editorFeedback" /></form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Cancel</button><button type="submit" primary :disabled="model.availableStorage.isEmpty()">Assign</button></form-actions></form></dialog></if>
          <if model.editor == "embedder"><dialog @dialogdismiss.coalesce="model.cancelEditor()" :title='if (model.editorId.isBlank()) "Add Embedder" else "Edit Embedder"' icon="search" triggerLabel="Embedder editor" :showTrigger="false" :openRequest="model.editorOpenRequest" :completed="model.editorCompleted" :data-bml-preserve='"meili-editor-" + model.editorRequest' size="lg" data-meili-embedder-editor><form class="modal-form" @submit="model.saveEmbedder(form.name, form.source, form.model, form.key, form.dimensions, form.documentTemplate, form.documentTemplateMaxBytes, form.url, form.request, form.response, form.headers, ctx)"><form-body padded class="modal-fields">
            <div class="meili-form-grid"><field label="Name"><input name="name" :value="model.embedderDraft.name" :readonly="model.editorId.isNotBlank()" required /></field><field label="Source"><select name="source" label="Embedder source" required @change="model.changeEmbedderSource(form.name, form.source, form.model, form.key, form.dimensions, form.documentTemplate, form.documentTemplateMaxBytes, form.url, form.request, form.response, form.headers)"><option value="">Select a source</option><for source in listOf("openAi", "huggingFace", "ollama", "rest", "userProvided")><option :value="source" :selected="source == model.embedderDraft.source">{ source }</option></for></select></field></div>
            <div :hidden='model.embedderDraft.source !in listOf("rest", "ollama")'><field label="URL"><input name="url" :value="model.embedderDraft.url" mono /></field></div>
            <div :hidden='model.embedderDraft.source.isBlank() || model.embedderDraft.source == "userProvided"'><div class="meili-form-grid"><field label="Model"><input name="model" :value="model.embedderDraft.model" /></field><div :hidden='model.embedderDraft.source !in listOf("openAi", "rest")'><field label="API Key" hint="Leave blank to keep an existing key."><input name="key" type="password" autocomplete="new-password" :value="model.embedderDraft.key" /></field></div></div></div>
            <div class="meili-form-grid"><field label="Dimensions"><input name="dimensions" type="number" min="1" :value="model.embedderDraft.dimensions" placeholder="1536" /></field><field label="Template Max Bytes"><input name="documentTemplateMaxBytes" type="number" min="1" :value="model.embedderDraft.documentTemplateMaxBytes" placeholder="400" /></field></div><field label="Document Template"><input name="documentTemplate" :value="model.embedderDraft.documentTemplate" multiline :rows="3" mono /></field>
            <div class="meili-rest-fields" :hidden='model.embedderDraft.source != "rest"'><field label="Request Mapping (JSON)"><json-editor :askToFormat="false" :mainMenuBar="false" :navigationBar="false" mode="text" name="request" :disabled='model.embedderDraft.source != "rest"' label="Request Mapping" :text="model.embedderDraft.request" :preserveKey='"meili-request-" + model.editorRequest' /></field><field label="Response Mapping (JSON)"><json-editor :askToFormat="false" :mainMenuBar="false" :navigationBar="false" mode="text" name="response" :disabled='model.embedderDraft.source != "rest"' label="Response Mapping" :text="model.embedderDraft.response" :preserveKey='"meili-response-" + model.editorRequest' /></field><field label="Headers (JSON)"><json-editor :askToFormat="false" :mainMenuBar="false" :navigationBar="false" mode="text" name="headers" :disabled='model.embedderDraft.source != "rest"' label="Headers" :text="model.embedderDraft.headers" :preserveKey='"meili-headers-" + model.editorRequest' /></field></div><system-feedback :feedback="model.editorFeedback" />
          </form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Cancel</button><button type="submit" primary>Save</button></form-actions></form></dialog></if>
          <if model.operationKind.isNotBlank()><dialog @dialogdismiss.coalesce="model.cancelOperation()" :title="model.operationTitle" :subtitle="model.operationResource" triggerLabel="Confirm Meilisearch operation" :showTrigger="false" :openRequest="model.operationOpenRequest" :completed="model.operationCompleted" :data-bml-preserve='"meili-confirm-" + model.operationRequest' size="sm" data-meili-confirmation><form class="modal-form" @submit="model.confirmOperation(form.confirmed, ctx)"><form-body padded class="modal-fields"><p>{ model.operationDescription }</p><if model.feedback.failed><alert tone="error">{ model.feedback.message }</alert></if><checkbox name="confirmed" label="Confirm this operation" required /></form-body><form-actions class="modal-footer" bordered><button data-dialog-close>Cancel</button><button type="submit" class="danger">Confirm</button></form-actions></form></dialog></if>
        </div>
      </if></div>
    </page-shell>
  </island>
  <style scoped>
    .meili-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(160px,100%),1fr)); gap:12px; }
    .meili-index-metrics { grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr)); }
    .meili-node-types { margin:0; padding:0; border:0; min-width:0; }
    .meili-node-types legend { margin-bottom:8px; padding:0; color:var(--fg-2); font-size:12px; }
    .meili-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    .number { text-align:right; }
    @media(max-width:600px) { .meili-form-grid { grid-template-columns:1fr; } }
    .meili-table { width:100%; min-width:850px; }
    .badge-row { display:flex; align-items:center; flex-wrap:wrap; gap:4px; }
    .meili-node-cards { display:flex; flex-direction:column; gap:10px; }
    .meili-node-card { display:flex; flex-direction:column; gap:8px; min-width:0; padding:12px 14px; background:var(--bg-2); border:1px solid var(--line); border-radius:10px; }
    .meili-node-card p { margin:0; font-size:12px; }
    .meili-resource-heading strong { font-size:13px; font-weight:500; }
    .meili-resource-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
    .meili-resource-actions { display:flex; align-items:center; flex-wrap:wrap; gap:6px; }
    .meili-detail-heading { color:var(--fg-3); font-size:11.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; margin:0 0 8px; }
    .meili-task-summary { display:flex; align-items:center; flex-wrap:wrap; gap:10px 16px; min-width:0; }
    .meili-task-summary > :last-child { margin-left:auto; font-size:11px; color:var(--fg-3); }
    .meili-drawer-actions { display:flex; flex-wrap:wrap; gap:8px; padding:14px 16px; border-bottom:1px solid var(--line); }
    .meili-rest-fields { display:flex; flex-direction:column; gap:14px; }
    .meili-rest-fields[hidden] { display:none; }
  </style>
  <script client scoped>
    const relationships = () => {
      for (const [selector, prefix, panel] of [["[data-meilisearch-tabs]", "meili-tab-", "meili-panel-"], ["[data-meilisearch-index-tabs]", "meili-index-tab-", "meili-index-panel-"]]) {
        for (const tab of ctx.root.querySelectorAll<HTMLElement>(selector + " [data-tab]")) {
          tab.id = prefix + tab.dataset.tab; tab.setAttribute("aria-controls", panel + tab.dataset.tab);
        }
      }
    };
    const failed = (failure: unknown) => { const error = ctx.ref<HTMLElement>("transportError"); if (error) { error.textContent = failure instanceof Error ? failure.message : String(failure); error.hidden = false; } };
    ctx.on<CustomEvent<string>>(ctx.root, "viewchange", async event => {
      if (!(event.target instanceof Element)) return;
      try {
        if (event.target.hasAttribute("data-meilisearch-tabs")) await ctx.dispatch(model.chooseTab(event.detail), { coalesce: true });
        else if (event.target.hasAttribute("data-meilisearch-index-tabs")) await ctx.dispatch(model.chooseIndexTab(event.detail), { coalesce: true });
      } catch (failure) { failed(failure); }
    });
    let busy = false, disposed = false;
    const timer = setInterval(async () => {
      if (disposed || busy || document.hidden || !ctx.root.querySelector("[data-meilisearch-console]") || ctx.root.querySelector("[data-bml-action-pending]") || ctx.root.querySelector("dialog[open]")) return;
      busy = true;
      try { await ctx.dispatch(model.refresh(ctx)); } catch (failure) { failed(failure); } finally { busy = false; }
    }, 10000);
    ctx.onUpdate(relationships); ctx.onUnmount(() => { disposed = true; clearInterval(timer); }); relationships();
  </script>
</component>
