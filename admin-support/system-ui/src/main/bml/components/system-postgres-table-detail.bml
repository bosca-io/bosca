<component tag="system-postgres-table-detail">
  <prop name="table" type="bosca.system.ui.graphql.ISystemPostgresTableFields" required />
  <div class="console-detail-grid">
    <section><h3>Size</h3><dl class="console-facts"><dt>Total</dt><dd>{ bosca.system.ui.systemBytes(table.totalSize) }</dd><dt>Table</dt><dd>{ bosca.system.ui.systemBytes(table.tableSize) }</dd><dt>Indexes</dt><dd>{ bosca.system.ui.systemBytes(table.indexSize) }</dd></dl></section>
    <section><h3>Rows</h3><dl class="console-facts"><dt>Live</dt><dd>{ bosca.system.ui.systemCount(table.nLiveTup) }</dd><dt>Dead</dt><dd>{ bosca.system.ui.systemCount(table.nDeadTup) }</dd><dt>Bloat</dt><dd><badge :tone='if (table.bloatRatio > 50) "error" else if (table.bloatRatio > 20) "warning" else "success"'>{ bosca.system.ui.systemDecimal(table.bloatRatio) + "%" }</badge></dd></dl></section>
    <section><h3>Scans</h3><dl class="console-facts"><dt>Sequential scans</dt><dd>{ bosca.system.ui.systemCount(table.seqScan) }</dd><dt>Sequential rows read</dt><dd>{ bosca.system.ui.systemCount(table.seqTupRead) }</dd><dt>Index scans</dt><dd>{ bosca.system.ui.systemCount(table.idxScan) }</dd><dt>Index rows fetched</dt><dd>{ bosca.system.ui.systemCount(table.idxTupFetch) }</dd></dl></section>
    <section><h3>Modifications</h3><dl class="console-facts"><dt>Inserted</dt><dd>{ bosca.system.ui.systemCount(table.nTupIns) }</dd><dt>Updated</dt><dd>{ bosca.system.ui.systemCount(table.nTupUpd) }</dd><dt>Deleted</dt><dd>{ bosca.system.ui.systemCount(table.nTupDel) }</dd><dt>HOT updated</dt><dd>{ bosca.system.ui.systemCount(table.nTupHotUpd) }</dd></dl></section>
    <section><h3>Maintenance</h3><dl class="console-facts"><dt>Last vacuum</dt><dd>{ table.lastVacuum ?: "—" }</dd><dt>Last autovacuum</dt><dd>{ table.lastAutovacuum ?: "—" }</dd><dt>Last analyze</dt><dd>{ table.lastAnalyze ?: "—" }</dd><dt>Last autoanalyze</dt><dd>{ table.lastAutoanalyze ?: "—" }</dd><dt>Vacuum count</dt><dd>{ bosca.system.ui.systemCount(table.vacuumCount) }</dd><dt>Autovacuum count</dt><dd>{ bosca.system.ui.systemCount(table.autovacuumCount) }</dd><dt>Analyze count</dt><dd>{ bosca.system.ui.systemCount(table.analyzeCount) }</dd><dt>Autoanalyze count</dt><dd>{ bosca.system.ui.systemCount(table.autoanalyzeCount) }</dd></dl></section>
  </div>
</component>
