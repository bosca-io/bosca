<component tag="system-postgres-cluster">
  <prop name="data" type="bosca.system.ui.graphql.SystemGetPostgresAdminOverviewData.PostgresAdmin" required />
  <div class="system-stack">
    <card :padded="false" title="Node role"><div class="console-body"><badge :tone='if (data.isInRecovery) "warning" else "success"'>{ if (data.isInRecovery) "Standby" else "Primary" }</badge></div></card>
    <card :padded="false" :title='"PgBouncer " + data.pgBouncerInfo.version.orEmpty()'><div class="console-body system-stack">
      <if !data.pgBouncerInfo.available><p class="system-muted">PgBouncer not detected — direct PostgreSQL connection.</p><else>
        <h3>Pools</h3><if data.pgBouncerInfo.pools.isEmpty()><empty-state message="No pools." /></if>
        <div class="console-grid"><for pool in data.pgBouncerInfo.pools><card :padded="false" :title='pool.database + " · " + pool.user'><div class="console-body"><badge>{ pool.poolMode }</badge><dl class="console-facts"><dt>Clients active</dt><dd>{ pool.clActive }</dd><dt>Clients waiting</dt><dd>{ pool.clWaiting }</dd><dt>Servers active</dt><dd>{ pool.svActive }</dd><dt>Servers idle</dt><dd>{ pool.svIdle }</dd><dt>Servers used</dt><dd>{ pool.svUsed }</dd><dt>Servers logging in</dt><dd>{ pool.svLogin }</dd><dt>Maximum wait</dt><dd>{ pool.maxwait.toString() + " s" }</dd></dl></div></card></for></div>
        <h3>Throughput</h3><div class="console-grid"><for stat in data.pgBouncerInfo.stats.filter { it.database != "pgbouncer" }><card :padded="false" :title="stat.database"><div class="console-body"><dl class="console-facts"><dt>Average transactions/s</dt><dd>{ bosca.system.ui.systemCount(stat.avgXactCount) }</dd><dt>Average queries/s</dt><dd>{ bosca.system.ui.systemCount(stat.avgQueryCount) }</dd><dt>Average transaction</dt><dd>{ stat.avgXactTime.toString() + " µs" }</dd><dt>Average query</dt><dd>{ stat.avgQueryTime.toString() + " µs" }</dd><dt>Average wait</dt><dd>{ stat.avgWaitTime.toString() + " µs" }</dd></dl></div></card></for></div>
        <h3>Databases</h3><div class="console-grid"><for database in data.pgBouncerInfo.databases.filter { it.name != "pgbouncer" }><card :padded="false" :title="database.name"><div class="console-body"><if database.paused><badge tone="warning">Paused</badge></if><if database.disabled><badge tone="error">Disabled</badge></if><dl class="console-facts"><dt>Database</dt><dd>{ database.database }</dd><dt>Host</dt><dd>{ (database.host ?: "local") + ":" + database.port }</dd><dt>Pool size</dt><dd>{ database.poolSize }</dd><dt>Connections</dt><dd>{ database.currentConnections.toString() + " / " + database.maxConnections }</dd><dt>Mode</dt><dd>{ database.poolMode ?: "—" }</dd></dl></div></card></for></div>
      </if>
    </div></card>
    <card :padded="false" title="Streaming replicas"><div class="console-body"><if data.replicationStatus.isEmpty()><empty-state message="No streaming replicas reported." /><else><div class="console-grid"><for replica in data.replicationStatus><card :padded="false" :title='replica.applicationName ?: "PID " + replica.pid'><div class="console-body"><badge :tone='if (replica.state == "streaming") "success" else "warning"'>{ replica.state ?: "Unknown" }</badge><badge>{ replica.syncState ?: "async" }</badge><dl class="console-facts"><dt>PID</dt><dd>{ replica.pid }</dd><dt>Client</dt><dd>{ replica.clientAddr ?: "—" }</dd><dt>User</dt><dd>{ replica.userName ?: "—" }</dd><dt>Replay lag</dt><dd>{ bosca.system.ui.systemDecimal(replica.replayLagSeconds, 3) + " s" }</dd><dt>Write lag</dt><dd>{ bosca.system.ui.systemDecimal(replica.writeLagSeconds, 3) + " s" }</dd><dt>Flush lag</dt><dd>{ bosca.system.ui.systemDecimal(replica.flushLagSeconds, 3) + " s" }</dd><dt>Sent LSN</dt><dd>{ replica.sentLsn ?: "—" }</dd><dt>Write LSN</dt><dd>{ replica.writeLsn ?: "—" }</dd><dt>Flush LSN</dt><dd>{ replica.flushLsn ?: "—" }</dd><dt>Replay LSN</dt><dd>{ replica.replayLsn ?: "—" }</dd><dt>Sync priority</dt><dd>{ replica.syncPriority ?: "—" }</dd></dl></div></card></for></div></if></div></card>
    <card :padded="false" title="Replication slots"><div class="console-body"><if data.replicationSlots.isEmpty()><empty-state message="No replication slots reported." /><else><div class="console-grid"><for slot in data.replicationSlots><card :padded="false" :title="slot.slotName"><div class="console-body"><badge :tone='if (slot.active) "success" else "error"'>{ if (slot.active) "Active" else "Inactive" }</badge><dl class="console-facts"><dt>Type</dt><dd>{ slot.slotType }</dd><dt>Database</dt><dd>{ slot.databaseName ?: "—" }</dd><dt>Confirmed flush LSN</dt><dd>{ slot.confirmedFlushLsn ?: "—" }</dd><dt>WAL retained</dt><dd>{ bosca.system.ui.systemBytes(slot.retainedWalBytes) }</dd></dl></div></card></for></div></if></div></card>
  </div>
</component>
