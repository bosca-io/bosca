<component tag="system-personas">
  <prop name="initial" type="bosca.system.ui.SystemPersonasModel" required />
  <script server provides="model">bosca.system.ui.SystemPersonasModel(initial.id, initial.admin, initial.personas, initial.persona, initial.draft, initial.feedback, initial.editorRequest, initial.assignmentRequest)</script>
  <island name="system-personas" :key="model.id">
    <page-shell fill><page-heading :title="model.title" :trail='bosca.system.ui.systemSecurityTrail(if (model.id.isBlank()) "" else "Personas", "/system/security/personas")'><if model.id.isNotBlank()><button-link href="/system/security/personas" icon="arrow-left">Personas</button-link></if><if model.admin && model.id.isNotBlank()><dialog title="Assign to profile" triggerLabel="Assign to profile" icon="users" :openRequest="model.assignmentOpenRequest" :completed='!model.feedback.failed && model.feedback.message == "Persona assigned to profile."'><form @submit="model.assign(form.profileId, ctx)" class="modal-form"><form-body padded class="modal-fields"><if model.feedback.failed><system-feedback :feedback="model.feedback" :notify="false" /></if><div data-bml-preserve="persona-profile-assignment"><field label="Profile ID"><input name="profileId" placeholder="Enter profile UUID" required autofocus /></field></div></form-body><form-actions bordered class="modal-footer"><button data-dialog-close>Cancel</button><button type="submit" primary>Assign persona</button></form-actions></form></dialog><confirm-dialog title="Delete persona?" description="This also removes all of this persona's profile assignments." triggerLabel="Delete persona" :triggerIconOnly="false"><form @submit="model.delete(model.id, form.confirmed, ctx)" class="modal-form"><form-body padded class="modal-fields"><checkbox name="confirmed" label="Delete this persona and its assignments" required /></form-body><form-actions bordered class="modal-footer"><button data-dialog-close>Cancel</button><button type="submit" class="danger">Delete persona</button></form-actions></form></confirm-dialog></if><if model.admin && model.id.isBlank()><dialog title="New persona" triggerLabel="New persona" primary icon="shield" triggerIcon="plus" :openRequest="model.editorOpenRequest" :data-bml-preserve='"persona-editor-" + model.editorRequest' :completed="model.feedback.nextHref.isNotBlank()"><form @submit="model.save(form.name, form.description, form.subsystemIds, form.enabled, ctx)" class="modal-form"><system-persona-fields class="modal-fields" :draft="model.draft" :options="model.subsystemOptions" :editing="model.id.isNotBlank()"><if model.feedback.failed><system-feedback :feedback="model.feedback" :notify="false" /></if><form-actions align="start"><button @click="model.selectAll(form.name, form.description, form.enabled)">Select all subsystems</button></form-actions></system-persona-fields><form-actions bordered class="modal-footer"><button data-dialog-close>Cancel</button><button type="submit" primary>Create persona</button></form-actions></form></dialog></if></page-heading>
      <div class="system-content" data-bml-scroll="system-content"><system-feedback :feedback="model.feedback" />
        <if !model.admin><alert>Administrator access is required.</alert><else>
          <if model.id.isBlank()>

            <card title="Personas" :padded="false"><if model.personas.isEmpty()><empty-state message="No personas defined yet." /><else><table-scroll label="Personas"><table><thead><tr><th>Name</th><th>Description</th><th>Subsystems</th><th>Status</th><th>Actions</th></tr></thead><tbody>
              <for persona in model.personas><tr><td><a :href='"/system/security/personas/" + bosca.system.ui.systemEncode(persona.id)'>{ persona.name }</a></td><td>{ persona.description ?: "—" }</td><td>{ persona.subsystemIds.joinToString(", ") { bosca.system.ui.systemPersonaSubsystems[it] ?: it } }</td><td><badge :tone='if (persona.enabled) "success" else "neutral"'>{ if (persona.enabled) "Active" else "Disabled" }</badge></td><td><confirm-dialog title="Delete persona?" description="This also removes the persona's profile assignments." triggerLabel="Delete persona"><form @submit="model.delete(persona.id, form.confirmed, ctx)" class="modal-form"><form-body padded class="modal-fields"><checkbox name="confirmed" label="Delete this persona and its assignments" required /></form-body><form-actions bordered class="modal-footer"><button data-dialog-close>Cancel</button><button type="submit" class="danger">Delete persona</button></form-actions></form></confirm-dialog></td></tr></for>
            </tbody></table></table-scroll></if></card>
          <else>
            <div class="persona-detail"><card title="Details"><form :data-bml-preserve='"persona-detail-" + model.editorRequest' @submit="model.save(form.name, form.description, form.subsystemIds, form.enabled, ctx)"><system-persona-fields :draft="model.draft" :options="model.subsystemOptions" :editing="model.id.isNotBlank()"><if model.feedback.failed><system-feedback :feedback="model.feedback" :notify="false" /></if><form-actions align="start"><button @click="model.selectAll(form.name, form.description, form.enabled)">Select all subsystems</button></form-actions></system-persona-fields><form-actions><button type="submit" primary>Save changes</button></form-actions></form></card></div>

          </if>
        </if>
      </div>
    </page-shell>
  </island>
  <style scoped>
    .persona-detail { max-width:1000px; }
  </style>
</component>
