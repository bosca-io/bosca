# =============================================================================
# analytics-collector native image (GraalVM 25)
#
# The native binary is pre-built by CI using Gradle nativeCompile.
#
# Build context is the repository root.
# =============================================================================
FROM debian:bookworm-slim

ARG ARTIFACT_SHA
RUN mkdir /app
WORKDIR /app
COPY artifacts/${ARTIFACT_SHA}/analytics-collector-native/analytics-collector /app/analytics-collector
RUN chmod +x ./analytics-collector

EXPOSE 8081
ENTRYPOINT ["./analytics-collector"]
