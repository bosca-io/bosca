}

"Metadata about a registered job definition that can be referenced by scheduled jobs. Provides the schema for job parameters."
type JobDefinitionInfo {
    "A human-friendly label for admin UIs. Falls back to name when blank."
    displayName: String!
    "The unique string identifier of this job definition."
    id: String!
    "The human-readable name of this job definition."
    name: String!
    "A JSON Schema describing the expected parameters for this job definition. Null if the job accepts no parameters or has no defined schema."
    parameterSchema: JSON
    "The name of the queue this job definition executes on."
    queueName: String!
}

"A record of a single job execution, including timing, status, and error details. Tracks both scheduled and event-triggered runs."
type JobHistory {
    "The timestamp when this execution completed. Null if the job is still running or pending."
    completedAt: DateTime
    "Additional context information about this execution, stored as JSON."
    context: JSON
    "The job definition snapshot at the time of execution, stored as JSON."
    definition: JSON
    "The timestamp until which this execution was delayed before being allowed to run. Null if the job was not delayed."
    delayedUntil: DateTime
    "The error message if the execution failed. Null if the execution succeeded or is still in progress."
    errorMessage: String
    "The unique identifier of this history entry."
    id: UUID!
    "The UUID of the underlying job execution in the job queue system."
    jobId: UUID!
    "The name of the job that was executed."
    name: String
    "The job ID of the enclosing parent execution, if this row represents a child fanned out from a multi-job or other composite executor. Null for top-level jobs."
    parentJobId: UUID
    "The timestamp when this execution was originally scheduled to run."
    scheduledFor: DateTime!
    "The UUID of the scheduled job that produced this execution. Null if the job was triggered outside of a scheduled job context."
    scheduledJobId: UUID
    "The source that triggered this execution (SCHEDULER for cron-based, EVENT for manual or event-triggered)."
    source: JobHistorySource!
    "The current execution status of this run."
    status: ExecutionStatus!
    "The timestamp when this execution was actually triggered."
    triggeredAt: DateTime!
    "Whether this execution was a catch-up run for a missed scheduled execution."
    wasCatchUp: Boolean!
}

"Mutation operations for managing job executions across the system"
type JobsMutation {
    "Cancel a specific active job by its queue job ID. Removes the job from the processing queue and marks it as cancelled in all relevant job history tables."
    cancel(jobId: UUID!): Boolean!
}

"A supported language for content localization, identified by an IETF BCP 47 language tag."
type Language {
    "Optional custom attributes stored as JSON for this language (e.g. direction, script, regional settings)."
    attributes: JSON
    "The name of the language in its own language (e.g. 'English', 'Francais', 'Espanol')."
    localName: String!
    "The English name of the language (e.g. 'English', 'French', 'Spanish')."
    name: String!
    "The IETF BCP 47 language tag (e.g. 'en', 'fr', 'es-MX', 'zh-Hans')."
    tag: String!
}

"Query operations for retrieving the list of supported languages for content localization."
type Languages {
    "Retrieve all supported languages available for content localization."
    all: [Language!]!
}

"Mutation operations for managing the supported languages list."
type LanguagesMutation {
    "Register a new language."
    add(input: LanguageInput!): Language!
    "Remove a language by its tag."
    delete(tag: String!): Boolean!
    "Update an existing language's name, local name, or attributes."
    edit(input: LanguageInput!): Language!
}

"Root namespace for localization queries"
type Localization {
    "Render translations of a project+language in the requested format"
    export(request: ExportRequestInput!): ExportResult!
    "Export a translated document as HTML for external translation tool round-tripping"
    exportDocumentAsHtml(documentId: UUID!, languageTag: String!): String!
    "Look up a single project by ID"
    project(id: UUID!): LocalizationProject
    "Every project visible to the caller"
    projects(limit: Int, offset: Int): [LocalizationProject!]!
    "Look up a single string by its primary key"
    string(id: UUID!): LocalizationString
    "Look up a single string by its (projectId, key) unique pair"
    stringByKey(key: String!, projectId: UUID!): LocalizationString
}

"Translated content of a project document for a specific language"
type LocalizationDocumentTranslation {
    "Translated JSONB content, mirroring the source document schema"
    content: JSON!
    "Created timestamp"
    created: DateTime!
    "Creator principal ID"
    createdBy: UUID
    "The document this translation belongs to"
    documentId: UUID!
    "Unique identifier"
    id: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "Last-modified timestamp"
    modified: DateTime!
    "Provenance of this translation"
    origin: TranslationOrigin!
    "Optional origin detail"
    originDetail: String
    "Most recent review timestamp"
    reviewedAt: DateTime
    "Reviewer principal ID"
    reviewedBy: UUID
    "Current workflow state"
    state: TranslationState!
}

"Root namespace for localization mutations; all operations respect per-project ACLs"
type LocalizationMutation {
    "Create a new project and its three project-scoped groups"
    addProject(input: LocalizationProjectInput!): LocalizationProject!
    "Link an existing metadata item to a project as a translatable document"
    addProjectDocument(input: LocalizationProjectDocumentInput!): LocalizationProjectDocument!
    "Add an export format to a project"
    addProjectFormat(format: ExportFormat!, projectId: UUID!): LocalizationProjectFormat!
    "Add a target language to a project"
    addProjectLanguage(languageTag: String!, projectId: UUID!): LocalizationProjectLanguage!
    "Grant a project-scoped permission to a security group"
    addProjectPermission(action: PermissionAction!, groupId: UUID!, projectId: UUID!): Boolean!
    "Add a new translatable string to a project"
    addString(input: LocalizationStringInput!): LocalizationString!
    "Attach a metadata item to a string for translator context"
    addStringMetadata(metadataId: UUID!, stringId: UUID!): LocalizationStringMetadata!
    "Transition every translation in a project+language from one state to another; returns count of rows updated"
    bulkTransition(fromState: TranslationState!, languageTag: String!, projectId: UUID!, toState: TranslationState!): Int!
    "Configure or update the external sync provider binding for a project"
    configureSync(input: LocalizationSyncConfigInput!): LocalizationSyncState!
    "Delete every plural row for a (stringId, languageTag) pair"
    deletePluralTranslations(languageTag: String!, stringId: UUID!): Boolean!
    "Delete a project (cascades to strings, translations, documents, and permissions)"
    deleteProject(id: UUID!): Boolean!
    "Delete a string (cascades to its translations)"
    deleteString(id: UUID!): Boolean!
    "Delete a translation by string and language"
    deleteTranslation(languageTag: String!, stringId: UUID!): Boolean!
    "Edit an existing project's mutable fields"
    editProject(id: UUID!, input: LocalizationProjectInput!): LocalizationProject!
    "Edit a string's key, context, placeholders, tags, or plural flag"
    editString(id: UUID!, input: LocalizationStringInput!): LocalizationString!
    "Import translated HTML back into a document translation"
    importDocumentFromHtml(documentId: UUID!, html: String!, languageTag: String!, origin: TranslationOrigin, originDetail: String): LocalizationDocumentTranslation!
    "Unlink a metadata item from a project"
    removeProjectDocument(metadataId: UUID!, projectId: UUID!): Boolean!
    "Remove an export format from a project"
    removeProjectFormat(format: ExportFormat!, projectId: UUID!): Boolean!
    "Remove a target language from a project"
    removeProjectLanguage(languageTag: String!, projectId: UUID!): Boolean!
    "Revoke a project-scoped permission grant"
    removeProjectPermission(action: PermissionAction!, groupId: UUID!, projectId: UUID!): Boolean!
    "Detach a metadata item from a string"
    removeStringMetadata(metadataId: UUID!, stringId: UUID!): Boolean!
    "Remove the sync provider binding for a project"
    removeSync(projectId: UUID!): Boolean!
    "Upsert the translated content of a project document for a language"
    setDocumentTranslation(input: LocalizationDocumentTranslationInput!): LocalizationDocumentTranslation!
    "Upsert a plural translation row"
    setPluralTranslation(input: LocalizationPluralTranslationInput!): LocalizationPluralTranslation!
    "Upsert a non-plural translation"
    setTranslation(input: LocalizationTranslationInput!): LocalizationTranslation!
    "Pull translations from the configured sync provider"
    syncFromProvider(projectId: UUID!): SyncResult!
    "Push source strings and translations to the configured sync provider"
    syncToProvider(projectId: UUID!): SyncResult!
    "Transition a document translation to a new workflow state"
    transitionDocumentTranslation(id: UUID!, toState: TranslationState!): LocalizationDocumentTranslation!
    "Transition a plural translation row to a new workflow state"
    transitionPluralTranslation(id: UUID!, toState: TranslationState!): LocalizationPluralTranslation!
    "Transition a translation to a new workflow state"
    transitionTranslation(id: UUID!, toState: TranslationState!): LocalizationTranslation!
}

"A single plural form of a translation (one row per CLDR category per language)"
type LocalizationPluralTranslation {
    "Timestamp when this row was created"
    created: DateTime!
    "Principal ID of the creator"
    createdBy: UUID
    "Unique identifier"
    id: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "Timestamp when this row was last modified"
    modified: DateTime!
    "Provenance"
    origin: TranslationOrigin!
    "Optional detail describing origin"
    originDetail: String
    "The CLDR plural category this row represents"
    pluralCategory: PluralCategory!
    "Timestamp of the most recent review action"
    reviewedAt: DateTime
    "Principal ID of the reviewer, null when unreviewed"
    reviewedBy: UUID
    "Current workflow state"
    state: TranslationState!
    "The source string this plural row belongs to"
    stringId: UUID!
    "Translated text for this plural form"
    text: String!
}

"A logical grouping of translatable strings and documents for a single application or context"
type LocalizationProject {
    "Free-form JSON attributes"
    attributes: JSON
    "Timestamp when this project was created"
    created: DateTime!
    "Optional description surfaced in the admin UI"
    description: String
    "Metadata items linked to this project for document translation"
    documents: [LocalizationProjectDocument!]!
    "Export formats configured for this project"
    formats: [LocalizationProjectFormat!]!
    "Unique identifier for this project"
    id: UUID!
    "Target languages this project translates into"
    languages: [LocalizationProjectLanguage!]!
    "Timestamp when this project was last modified"
    modified: DateTime!
    "Human-readable project name"
    name: String!
    "Per-group permission grants for this project"
    permissions: [LocalizationProjectPermission!]!
    "Translation coverage snapshot for a specific language"
    progress(languageTag: String!): TranslationProgress!
    "BCP-47 language tag of the source language (must exist in public.languages)"
    sourceLanguage: String!
    "Paginated list of translatable strings belonging to this project"
    strings(limit: Int, offset: Int): [LocalizationString!]!
    "External sync binding for this project, or null if none is configured"
    syncState: LocalizationSyncState
    "Every translation in the project attributed to the given origin (for a single language)"
    translationsByOrigin(languageTag: String!, origin: TranslationOrigin!): [LocalizationTranslation!]!
    "Every translation in the project currently in the given workflow state (for a single language)"
    translationsByState(languageTag: String!, state: TranslationState!): [LocalizationTranslation!]!
}

"Links a metadata item to a LocalizationProject as a source document to be translated"
type LocalizationProjectDocument {
    "Free-form JSON attributes"
    attributes: JSON
    "Timestamp when this link was created"
    created: DateTime!
    "Unique identifier"
    id: UUID!
    "The source metadata item containing the authoritative content"
    metadataId: UUID!
    "Timestamp when this link was last modified"
    modified: DateTime!
    "The project this document belongs to"
    projectId: UUID!
    "The translated content for a specific language, or null when missing"
    translation(languageTag: String!): LocalizationDocumentTranslation
    "All per-language translated versions of this document"
    translations: [LocalizationDocumentTranslation!]!
}

"An export format configured for a localization project"
type LocalizationProjectFormat {
    "When this format was added"
    created: DateTime!
    "The export format"
    format: ExportFormat!
    "The project this format belongs to"
    projectId: UUID!
}

"A target language declared for a localization project"
type LocalizationProjectLanguage {
    "When this language was added"
    created: DateTime!
    "BCP-47 language tag"
    languageTag: String!
    "The project this language belongs to"
    projectId: UUID!
}

"A group-to-project permission grant within the localization subsystem"
type LocalizationProjectPermission {
    "The permission action granted (VIEW, EDIT, MANAGE)"
    action: PermissionAction!
    "The security group granted the action; null if the group was deleted"
    group: Group
    "The project this permission applies to"
    projectId: UUID!
}

"A single translatable string key within a LocalizationProject"
type LocalizationString {
    "Translator context (free-form description of intent)"
    context: String
    "Metadata items attached for translator context (screenshots, mockups, reference files)"
    contextMetadata: [LocalizationStringMetadata!]!
    "Timestamp when this string was created"
    created: DateTime!
    "Unique identifier for this string"
    id: UUID!
    "Stable key used by consumers (e.g. 'items_count')"
    key: String!
    "Optional maximum length for translations (enforced in the admin UI)"
    maxLength: Int
    "Optional metadata ID providing visual context (screenshots/mockups as supplementary items)"
    metadataId: UUID
    "Timestamp when this string was last modified"
    modified: DateTime!
    "Declared ICU placeholders, as a JSON array of {name, type, example} objects"
    placeholders: JSON
    "Whether this string has plural forms (translations live in pluralTranslations instead of translations)"
    plural: Boolean!
    "Plural category rows for a specific language (empty when plural is false)"
    pluralTranslations(languageTag: String!): [LocalizationPluralTranslation!]!
    "The project this string belongs to"
    projectId: UUID!
    "Freeform tags for filtering and organization"
    tags: [String!]!
    "Every translation for this string across all languages"
    translations: [LocalizationTranslation!]!
}

"A metadata item attached to a localization string for translator context"
type LocalizationStringMetadata {
    "When this attachment was created"
    created: DateTime!
    "The metadata item ID"
    metadataId: UUID!
    "The string this metadata is attached to"
    stringId: UUID!
}

"External sync binding for a localization project"
type LocalizationSyncState {
    "Free-form JSON attributes"
    attributes: JSON
    "Provider-specific external project identifier"
    externalId: String
    "Unique identifier"
    id: UUID!
    "Timestamp of the most recent sync operation, null if never synced"
    lastSynced: DateTime
    "The project this sync state belongs to"
    projectId: UUID!
    "Sync provider identifier (e.g. 'crowdin')"
    provider: String!
    "Provider-specific configuration (organization slugs, file mappings). Never store secrets here — this field is readable by anyone with VIEW access."
    syncConfig: JSON
}

"A translation of a non-plural string for a specific language"
type LocalizationTranslation {
    "Timestamp when this translation was created"
    created: DateTime!
    "Principal ID of the creator, null for system/AI origins"
    createdBy: UUID
    "Audit trail of every state or text change for this translation"
    history: [TranslationHistory!]!
    "Unique identifier"
    id: UUID!
    "BCP-47 language tag"
    languageTag: String!
    "Timestamp when this translation was last modified"
    modified: DateTime!
    "Provenance of this translation"
    origin: TranslationOrigin!
    "Optional detail describing origin (AI model name, Crowdin user, etc.)"
    originDetail: String
    "Timestamp of the most recent review action"
    reviewedAt: DateTime
    "Principal ID of the reviewer, null when unreviewed"
    reviewedBy: UUID
    "Current workflow state"
    state: TranslationState!
    "The source string this translation belongs to"
    stringId: UUID!
    "Translated text"
    text: String!
}

"Query operations for authenticating with username/password credentials"
type Login {
    "Authenticate using a username or email identifier and password. Returns tokens and principal information."
    password(identifier: String!, password: String!): LoginResponse!
}

"Mutation operations for authentication, password recovery, and token refresh"
type LoginMutation {
    "Exchange a single-use token for a JWT and refresh token. Used for cross-domain OAuth2 authentication when the session cookie cannot transfer between domains."
    exchangeToken(token: String!): LoginResponse!
    "Initiate a forgot-password flow by sending a password reset email to the identifier"
    forgotPassword(identifier: String!): Boolean!
    "Authenticate using a username or email identifier and password. Returns tokens and principal information."
    password(identifier: String!, password: String!): LoginResponse!
    "Obtain a new access token using a valid refresh token"
    refreshToken(refreshToken: String!): LoginResponse!
    "Reset a password using a valid reset token received via email"
    resetPassword(password: String!, token: String!): Boolean!
    "Sign the current principal out: invalidates every outstanding access and refresh token server-side and clears the session cookie. Safe to call when the caller's token is already invalid — in that case only the cookie is cleared."
    signOut: Boolean!
}

"The response returned after a successful authentication, containing the principal, profiles, and access/refresh tokens"
type LoginResponse {
    "The authenticated principal (user account)"
    principal: Principal!
    "List of user profiles associated with the authenticated principal, null if none exist"
    profile: [Profile!]
    "Refresh token for obtaining new access tokens, null if refresh tokens are disabled"
    refreshToken: String
    "The JWT access token for authenticating subsequent API requests"
    token: Token!
}

"A registered MCP (Model Context Protocol) server that provides tools to AI agents"
type McpServerRegistration {
    "Optional JSON configuration for connection details and server-specific settings"
    configuration: JSON
    "Human-readable description of the server's capabilities"
    description: String!
    "Whether this server is currently active and available for agent use"
    enabled: Boolean!
    "Unique identifier for this MCP server registration"
    id: UUID!
    "Unique key used to reference this server programmatically"
    key: String!
    "Display name for the MCP server"
    name: String!
    "Transport protocol used to connect to this server"
    transportType: McpTransportType!
}

"Query operations for listing and retrieving MCP server registrations"
type McpServers {
    "Retrieve all registered MCP servers"
    all: [McpServerRegistration!]!
    "Retrieve only enabled MCP servers"
    enabled: [McpServerRegistration!]!
    "Retrieve a specific MCP server by its unique ID"
    server(
        "The unique identifier of the server to retrieve"
        id: UUID!
    ): McpServerRegistration
    "Retrieve a specific MCP server by its unique key"
    serverByKey(
        "The unique programmatic key of the server to retrieve"
        key: String!
    ): McpServerRegistration
}

"Mutation operations for managing MCP server registrations"
type McpServersMutation {
    "Register a new MCP server"
    add(
        "The server definition to create"
        server: McpServerRegistrationInput!
    ): McpServerRegistration!
    "Delete an MCP server registration by its ID. Returns true if the server was deleted. Warning: cascades to agent tools referencing this server."
    delete(
        "The unique identifier of the server to delete"
        id: UUID!
    ): Boolean!
    "Update an existing MCP server registration"
    edit(
        "The unique identifier of the server to update"
        id: UUID!,
        "The updated server definition"
        server: McpServerRegistrationInput!
    ): McpServerRegistration!
}

"Provider-agnostic processed media data for a metadata item, including adaptive-bitrate streaming, download links, thumbnails, media specifications, and auto-generated transcription tracks"
type Media {
    "Video quality tier the transcoding provider actually used for the current asset (basic, plus, or premium), null while still processing"
    actualVideoQuality: String
    "Short animated preview URL (e.g. animated GIF)"
    animatedPreviewUrl: String
    "Display aspect ratio (e.g. 16:9)"
    aspectRatio: String
    "Direct file download URL (e.g. MP4 static rendition)"
    downloadUrl: String
    "Total duration of the media in seconds"
    durationSeconds: Float
    "HLS adaptive-bitrate streaming endpoints"
    hls: MediaHls
    "Maximum resolution tier (e.g. 1080p, 720p)"
    maxResolution: String
    "Per-item maximum resolution tier override (1080p, 1440p, or 2160p), null when using global default"
    maxResolutionTier: String
    "Processing status of the media: preparing, ready, or errored"
    status: String!
    "Static thumbnail image URL"
    thumbnailUrl: String
    "Subtitle and caption transcription tracks derived from the media audio"
    transcriptions: [Transcription!]!
    "Per-item video quality tier override (basic, plus, or premium), null when using global default"
    videoQuality: String
}

"HLS (HTTP Live Streaming) endpoints for adaptive-bitrate playback of a media item"
type MediaHls {
    "HLS manifest URL filtered to audio-only renditions"
    audioOnlyUrl: String
    "Adaptive-bitrate HLS manifest URL for video playback"
    url: String!
}

"Query operations for introspecting Meilisearch instance state, indexes, tasks, keys, and nodes."
type MeilisearchAdmin {
    "Check server health status."
    health: MeilisearchHealth!
    "Get details for a specific index by UID."
    index(
        "The unique identifier of the index."
        uid: String!
    ): MeilisearchIndex
    "List all indexes with optional pagination."
    indexes(
        "Maximum number of indexes to return."
        limit: Int,
        "Zero-based offset for pagination."
        offset: Int
    ): [MeilisearchIndex!]!
    "List all API keys registered on the instance."
    keys: [MeilisearchKey!]!
    "Get a specific node by database ID."
    node(
        "The node's database ID."
        id: UUID!
    ): MeilisearchNode
    "List all Meilisearch nodes in the multi-node topology."
    nodes: [MeilisearchNode!]!
    "Retrieve global statistics across all indexes."
    stats: MeilisearchGlobalStats!
    "Get details for a specific task."
    task(
        "The task UID."
        uid: Int!
    ): MeilisearchTask
    "List recent tasks with optional filtering by status, type, and index."
    tasks(
        "Task UID to start from for pagination."
        from: Int,
        "Filter by index UIDs."
        indexUid: [String!],
        "Maximum number of tasks to return."
        limit: Int,
        "Filter by task statuses."
        status: [String!],
        "Filter by task types."
        type: [String!]
    ): [MeilisearchTask!]!
    "Retrieve server version information."
    version: MeilisearchVersion!
}

"Mutation operations for managing Meilisearch indexes, settings, embedders, documents, tasks, nodes, replication, and federation."
type MeilisearchAdminMutation {
    "Register a new Meilisearch node in the multi-node topology."
    addNode(
        "The node configuration to create."
        input: MeilisearchNodeInput!
    ): MeilisearchNode!
    "Assign a node to a storage system, making it serve that storage system's indexes."
    assignNodeToStorageSystem(
        "The node ID to assign."
        nodeId: UUID!,
        "The storage system ID."
        storageSystemId: UUID!
    ): Boolean!
    "Cancel tasks matching the given filters."
    cancelTasks(
        "Cancel tasks operating on these index UIDs."
        indexUids: [String!],
        "Cancel tasks with these statuses."
        statuses: [String!],
        "Cancel tasks of these types."
        types: [String!],
        "Specific task UIDs to cancel."
        uids: [Int!]
    ): MeilisearchTask!
    "Configure the federation network on a specific node, registering remote instances for distributed search."
    configureNetwork(
        "The node's database ID."
        nodeId: UUID!,
        "The remote instances to register."
        remotes: [MeilisearchNetworkRemoteInput!]!
    ): Boolean!
    "Create a database dump for backup or migration."
    createDump: MeilisearchTask!
    "Create a new index with the given UID and optional primary key."
    createIndex(
        "The primary key field for document deduplication."
        primaryKey: String,
        "The unique identifier for the new index."
        uid: String!
    ): MeilisearchTask!
    "Trigger a snapshot of the current database state."
    createSnapshot: MeilisearchTask!
    "Delete all documents from an index."
    deleteAllDocuments(
        "The index UID to clear."
        uid: String!
    ): MeilisearchTask!
    "Delete specific documents by their IDs."
    deleteDocuments(
        "The document IDs to delete."
        ids: [String!]!,
        "The index UID."
        uid: String!
    ): MeilisearchTask!
    "Delete documents matching a filter expression."
    deleteDocumentsByFilter(
        "The Meilisearch filter expression."
        filter: String!,
        "The index UID."
        uid: String!
    ): MeilisearchTask!
    "Delete an index by UID."
    deleteIndex(
        "The unique identifier of the index to delete."
        uid: String!
    ): MeilisearchTask!
    "Remove a node from the topology."
    deleteNode(
        "The node's database ID."
        id: UUID!
    ): Boolean!
    "Update an existing node's configuration."
    editNode(
        "The node's database ID."
        id: UUID!,
        "The fields to update."
        input: MeilisearchEditNodeInput!
    ): MeilisearchNode!
    "Export data from the primary instance to a specific node for replication."
    exportToNode(
        "Specific index UIDs to export, or all if omitted."
        indexUids: [String!],
        "The target node's database ID."
        nodeId: UUID!,
        "Whether to override existing settings on the target."
        overrideSettings: Boolean
    ): MeilisearchTask!
    "Remove a node from a storage system assignment."
    removeNodeFromStorageSystem(
        "The node ID to remove."
        nodeId: UUID!,
        "The storage system ID."
        storageSystemId: UUID!
    ): Boolean!
    "Remove all embedder configurations from an index, disabling semantic search."
    resetEmbedders(
        "The index UID to reset."
        uid: String!
    ): MeilisearchTask!
    "Reset all settings for an index to their defaults."
    resetSettings(
        "The index UID to reset."
        uid: String!
    ): MeilisearchTask!
    "Swap the contents of two indexes atomically."
    swapIndexes(
        "Pairs of index UIDs to swap, each pair as a two-element list."
        indexes: [[String!]!]!
    ): MeilisearchTask!
    "Update embedder configurations for semantic and vector search on a specific index."
    updateEmbedders(
        "The embedder configurations to apply."
        embedders: [MeilisearchEmbedderInput!]!,
        "The index UID to update."
        uid: String!
    ): MeilisearchTask!
    "Update settings for an index. Only provided fields are changed."
    updateSettings(
        "The settings fields to update."
        settings: MeilisearchSettingsInput!,
        "The index UID to update."
        uid: String!
    ): MeilisearchTask!
}

"Configuration for a named embedder enabling semantic and vector search on an index."
type MeilisearchEmbedderEntry {
    "The dimensionality of the embedding vectors."
    dimensions: Int
    "The template used to generate text for embedding from documents."
    documentTemplate: String
    "Maximum bytes for the document template."
    documentTemplateMaxBytes: Int
    "Custom HTTP headers sent with each request to the embedding provider."
    headers: JSON
    "The model identifier for this embedder."
    model: String
    "The name of this embedder configuration."
    name: String!
    "The request body template as JSON, defining how Meilisearch sends data to the provider."
    request: JSON
    "The response mapping as JSON, defining where embeddings are located in the provider response."
    response: JSON
    "The source type (e.g., openAi, huggingFace, userProvided, rest, ollama)."
    source: String
    "The URL of the embedding provider endpoint. Required for rest embedders."
    url: String
}

"Faceting configuration for search results."
type MeilisearchFaceting {
    "Maximum number of facet values returned per facet."
    maxValuesPerFacet: Int!
}

"Count of documents containing a particular field within an index."
type MeilisearchFieldDistribution {
    "The number of documents containing this field."
    count: Long!
    "The field name."
    field: String!
}

"Aggregate statistics across all indexes on a Meilisearch instance."
type MeilisearchGlobalStats {
    "Total size of the database on disk in bytes."
    databaseSize: Long!
    "Timestamp of the most recent update across all indexes."
    lastUpdate: String
    "Total number of indexes on this instance."
    numberOfIndexes: Int!
}

"Health status of a Meilisearch instance."
type MeilisearchHealth {
    "Whether the instance is healthy and accepting requests."
    healthy: Boolean!
}

"Metadata and entry point for a Meilisearch index."
type MeilisearchIndex {
    "When this index was created."
    createdAt: String!
    "Browse documents in this index with optional pagination and field selection."
    documents(
        "Subset of fields to include in each document."
        fields: [String!],
        "Maximum number of documents to return."
        limit: Int,
        "Zero-based offset for pagination."
        offset: Int
    ): [JSON!]!
    "The primary key field used for document deduplication."
    primaryKey: String
    "The complete settings of this index."
    settings: MeilisearchIndexSettings!
    "Per-index statistics including document count and field distribution."
    stats: MeilisearchIndexStats!
    "The unique identifier of the index."
    uid: String!
    "When this index was last updated."
    updatedAt: String!
}

"Complete settings of a Meilisearch index."
type MeilisearchIndexSettings {
    "The attributes returned in search results."
    displayedAttributes: [String!]!
    "The distinct attribute used for deduplication."
    distinctAttribute: String
    "Configured embedders for semantic and vector search."
    embedders: [MeilisearchEmbedderEntry!]!
    "Faceting configuration."
    faceting: MeilisearchFaceting
    "The attributes that can be used for filtering and faceting."
    filterableAttributes: [String!]!
    "Pagination limits."
    pagination: MeilisearchPagination
    "Proximity precision setting (byWord or byAttribute)."
    proximityPrecision: String
    "The ranking rules that determine result ordering."
    rankingRules: [String!]!
    "Search cutoff time in milliseconds."
    searchCutoffMs: Int
    "The attributes that can be used as search query terms."
    searchableAttributes: [String!]!
    "The attributes that can be used for sorting results."
    sortableAttributes: [String!]!
    "Words ignored during search."
    stopWords: [String!]!
    "Groups of words considered equivalent during search."
    synonyms: [MeilisearchSynonym!]!
    "Typo tolerance configuration."
    typoTolerance: MeilisearchTypoTolerance
}

"Per-index statistics from Meilisearch."
type MeilisearchIndexStats {
    "Distribution of fields across documents, showing how many documents contain each field."
    fieldDistribution: [MeilisearchFieldDistribution!]!
    "Whether this index is currently processing updates."
    isIndexing: Boolean!
    "Total number of documents in this index."
    numberOfDocuments: Long!
}

"An API key registered on the Meilisearch instance."
type MeilisearchKey {
    "The actions this key is authorized to perform."
    actions: [String!]!
    "When this key was created."
    createdAt: String!
    "The description of this API key."
    description: String!
    "When this key expires, null if it never expires."
    expiresAt: String
    "The index UIDs this key has access to (* for all)."
    indexes: [String!]!
    "The key value (may be partially masked)."
    key: String!
    "The name of this API key."
    name: String
    "The unique identifier of this key."
    uid: String!
    "When this key was last updated."
    updatedAt: String!
}

"Minimum word length thresholds for activating typo correction."
type MeilisearchMinWordSize {
    "Minimum word length to allow one typo."
    oneTypo: Int!
    "Minimum word length to allow two typos."
    twoTypos: Int!
}

"A remote Meilisearch instance registered in the federation network."
type MeilisearchNetworkRemote {
    "The name identifying this remote instance."
    name: String!
    "The URL of the remote Meilisearch instance."
    url: String!
}

"A Meilisearch instance in the multi-node topology, assigned to one or more storage systems."
type MeilisearchNode {
    "Description of this node's role or purpose."
    description: String!
    "Whether this node is currently healthy and reachable."
    healthy: Boolean!
    "The database identifier of this node."
    id: UUID!
    "The index UIDs hosted on this node."
    indexes: [String!]!
    "Human-readable name of this node."
    name: String!
    "Remote instances configured in this node's federation network."
    networkRemotes: [MeilisearchNetworkRemote!]!
    "Global stats for this node."
    stats: MeilisearchGlobalStats
    "The IDs of storage systems this node is assigned to."
    storageSystemIds: [UUID!]!
    "The search types this node supports, drawn from the StorageSystemType enum."
    types: [StorageSystemType!]!
    "The Meilisearch instance URL for this node."
    url: String!
    "Server version of this node."
    version: MeilisearchVersion
}

"Pagination limits for search results."
type MeilisearchPagination {
    "Maximum total number of hits that can be returned."
    maxTotalHits: Int!
}

"A synonym mapping between a word and its alternative search terms."
type MeilisearchSynonym {
    "The synonyms for this word."
    synonyms: [String!]!
    "The word that triggers synonym expansion."
    word: String!
}

"An asynchronous operation tracked by Meilisearch."
type MeilisearchTask {
    "The task UID that canceled this task, if applicable."
    canceledBy: Int
    "Duration of the task execution."
    duration: String
    "When the task was enqueued."
    enqueuedAt: String!
    "Error details if the task failed."
    error: MeilisearchTaskError
    "When the task finished."
    finishedAt: String
    "The index UID this task operates on, if applicable."
    indexUid: String
    "When the task started processing."
    startedAt: String
    "The current status (enqueued, processing, succeeded, failed, canceled)."
    status: String!
    "The type of operation (e.g., indexCreation, documentAdditionOrUpdate, settingsUpdate)."
    type: String!
    "The unique identifier of the task."
    uid: Int!
}

"Error details from a failed Meilisearch task."
type MeilisearchTaskError {
    "The machine-readable error code."
    code: String!
    "A link to the documentation about this error."
    link: String
    "The error message."
    message: String!
    "The error type classification."
    type: String!
}

"Typo tolerance configuration for an index."
type MeilisearchTypoTolerance {
    "Attributes where typo correction is disabled."
    disableOnAttributes: [String!]
    "Words that should never have typo correction applied."
    disableOnWords: [String!]
    "Whether typo tolerance is enabled."
    enabled: Boolean!
    "Minimum word size thresholds for typo correction."
    minWordSizeForTypos: MeilisearchMinWordSize
}

"Version information from the Meilisearch instance identifying the exact build."
type MeilisearchVersion {
    "The date the build was committed."
    commitDate: String
    "The short SHA of the commit."
    commitSha: String
    "The Meilisearch server software version."
    pkgVersion: String!
}

"A single content block within a chat message, representing text, media, or a reference"
type MessageContent {
    "The referenced community activity, populated when type is ACTIVITY"
    activity: CommunityActivity
    "Custom attributes associated with this content block as a JSON object"
    attributes: JSON
    "The content value: text body, media URL, or reference identifier depending on the type"
    content: String!
    "The referenced metadata item, populated when content links to stored media or files"
    metadata: Metadata
    "The referenced prayer request, populated when type is PRAYER"
    prayer: Prayer
    "The type of this content block, indicating how it should be rendered"
    type: MessageContentType!
}

"An emoji reaction left on a chat message by a user"
type MessageReaction {
    "The emoji character or shortcode used for the reaction"
    emoji: String!
    "ID of the user profile that left this reaction"
    profileId: UUID!
}

"A real-time event payload delivered when a reaction is added to or removed from a message"
type MessageReactionEvent {
    "True when the reaction was added, false when removed"
    added: Boolean!
    "ID of the channel containing the message"
    channelId: UUID!
    "Emoji or shortcode that was added or removed"
    emoji: String!
    "ID of the profile whose reaction changed"
    profileId: UUID!
    "Sequence number of the message within its channel"
    sequence: Long!
}

"A metadata item is the fundamental content unit in Bosca, representing a single piece of content such as a document, image, audio file, data record, or guide. It holds all associated attributes, workflow state, permissions, relationships, and content references."
type Metadata {
    "AI-powered operations and analysis for this metadata item"
    ai: MetadataAI
    "Custom attributes associated with this metadata item, optionally filtered by an attributes filter"
    attributes(filter: AttributesFilterInput): JSON
    "Bible content associated with this metadata item, optionally filtered by variant name"
    bible(variant: String): Bible
    """

    The calendar attached to this metadata, if its content type is `bosca/v-calendar`.
    Returns null when no calendar row exists or the caller lacks VIEW permission.
    """
    calendar: Calendar
    "Categories assigned to this metadata item for organizational taxonomy"
    categories: [Category!]!
    "IDs of categories assigned to this metadata item"
    categoryIds: [String!]!
    "Collection template definition if this metadata item serves as a collection template"
    collectionTemplate: CollectionTemplate
    "Paginated comments on this metadata item, optionally filtered to show only pinned comments"
    comments(limit: Int!, offset: Int!, pinned: Boolean): Comments!
    "The binary or file content associated with this metadata item"
    content: MetadataContent
    "Timestamp when this metadata item was created"
    created: DateTime!
    "Structured data content associated with this metadata item"
    data: Data
    "Real-time collaboration state for the data content"
    dataCollaboration: DataCollaboration
    "Data template definition if this metadata item serves as a data template"
    dataTemplate: DataTemplate
    "Whether this metadata item has been soft-deleted"
    deleted: Boolean!
    "Structured document content associated with this metadata item"
    document: Document
    "Real-time collaboration state for the document content"
    documentCollaboration: DocumentCollaboration
    "Document template definition if this metadata item serves as a document template"
    documentTemplate: DocumentTemplate
    "Entity tag for cache validation. Set addHeader to true to include as an HTTP response header."
    etag(addHeader: Boolean!): String
    "Guide content associated with this metadata item (multi-step structured content)"
    guide: Guide
    "Guide template definition if this metadata item serves as a guide template"
    guideTemplate: GuideTemplate
    "Unique identifier for this metadata item"
    id: UUID!
    "Attributes set on this item within the context of its parent collection"
    itemAttributes: JSON
    "Freeform labels for tagging and categorizing this metadata item"
    labels: [String!]!
    "BCP 47 language tag indicating the primary language of this content (e.g. 'en', 'es-MX')"
    languageTag: String!
    "Whether this metadata item is locked from modification"
    locked: Boolean!
    "Processed media data if this content has been transcoded for adaptive-bitrate playback"
    media: Media
    "Timestamp when this metadata item was last modified"
    modified: DateTime!
    "Display name of this metadata item"
    name: String!
    "Paginated list of parent collections that contain this metadata item"
    parentCollections(limit: Int!, offset: Long!): [Collection!]!
    "ID of the parent metadata item if this is a variant"
    parentId: String
    "Access permissions defined on this metadata item"
    permissions: [Permission!]!
    "Profiles associated with this metadata item and their relationship types"
    profiles: [MetadataProfile!]!
    "Whether this metadata item is publicly accessible"
    public: Boolean!
    "Whether the binary/file content of this metadata item is publicly accessible"
    publicContent: Boolean!
    "Whether supplementary files attached to this metadata item are publicly accessible"
    publicSupplementary: Boolean!
    "Timestamp when this metadata item became ready for publishing, null if not yet ready"
    ready: DateTime
    "Relationships to other metadata items, optionally filtered by relationship type and direction"
    relationships(filter: [String!], inverse: Boolean): [MetadataRelationship!]!
    "Whether this metadata item should be indexed for search"
    searchable: Boolean!
    "URL-friendly slug for this metadata item, used in human-readable URLs"
    slug: String
    "External source information if this metadata item was imported from another system"
    source: MetadataSource
    "Supplementary content attached to this metadata item (files, assets, processed outputs), optionally filtered by key or plan ID"
    supplementary(key: String, planId: String): [MetadataSupplementary!]!
    "Whether variant collections should be automatically synchronized when the parent changes"
    syncVariantCollections: Boolean!
    "Whether variant relationships should be automatically synchronized when the parent changes"
    syncVariantRelationships: Boolean!
    "System-managed attributes (not user-editable, used internally by workflows and processing)"
    systemAttributes: JSON
    "Retrieve time events associated with this metadata item, optionally filtered by type and time range"
    timeEvents(filter: TimeEventFilter): [TimeEvent!]!
    "Retrieve time events that are active at a specific millisecond offset, optionally filtered by type IDs"
    timeEventsAtOffset(offsetMs: Long!, types: [String!]): [TimeEvent!]!
    "IDs of traits assigned to this metadata item"
    traitIds: [String!]!
    "Traits assigned to this metadata item, defining behaviors and workflows"
    traits: [Trait!]!
    "The classification type of this metadata item (standard or variant)"
    type: MetadataType!
    "Timestamp when content was uploaded, null if no content has been uploaded yet"
    uploaded: DateTime
    "Language and content variants of this metadata item"
    variants: [Metadata!]!
    "Version number of this metadata item"
    version: Int!
    "Current workflow state information for this metadata item"
    workflow: MetadataWorkflow!
}

"AI-powered operations for a metadata item, providing content analysis, generation, and insights"
type MetadataAI {
    "Generate AI-derived content of the specified type (e.g. summary, outline, keywords)"
    content(document: DocumentInput, type: String!): JSON!
    "Generate an AI-powered description of the content, optionally using the provided document"
    description(document: DocumentInput): String
    "Estimate the reading time in minutes for the content"
    readingTimeInMinutes(document: DocumentInput): Int!
    "Identify relevant topic collections for this content using AI analysis"
    topics(document: DocumentInput): [Collection!]
}

"Mutation operations for AI-powered content generation on metadata items"
type MetadataAIMutation {
    "Generate an image from a document using AI image generation. Returns the created supplementary metadata item."
    generateImageFromDocument(configuration: JSON, id: UUID!, modelKey: String!, promptKey: String!, relationship: String, version: Int!): Metadata
    "Generate an MP3 audio file from a document using AI text-to-speech. Returns the created supplementary metadata item."
    generateMp3FromDocument(configuration: JSON, id: UUID!, modelKey: String!, promptKey: String, relationship: String, version: Int!): Metadata
}

"The binary or file content associated with a metadata item, including its type, size, and access URLs"
type MetadataContent {
    "The content parsed as JSON (if the content type supports JSON parsing)"
    json: JSON
    "Content length in bytes"
    length: Long
    "The content as plain text (if the content type supports text extraction)"
    text: String
    "MIME content type (e.g. 'image/png', 'application/pdf', 'text/html')"
    type: String!
    "Pre-signed URLs for uploading and downloading the content"
    urls: MetadataContentUrls
}

"Pre-signed URLs for accessing metadata content"
type MetadataContentUrls {
    "Pre-signed URL for downloading the content"
    download: SignedUrl
    "Pre-signed URL for uploading new content"
    upload: SignedUrl
}

"A real-time event emitted when a metadata item is created, updated, or deleted."
type MetadataEvent {
    "The UUID of the metadata item that was affected."
    id: UUID!
    "The type of event that occurred (e.g. 'created', 'updated', 'deleted')."
    type: String
    "The version number of the metadata item after the event."
    version: Int!
}

"Mutation operations for managing metadata items, their content, relationships, permissions, templates, and workflow states"
type MetadataMutation {
    "Create a new metadata item, optionally placing it in a collection with attributes and marking it as ready"
    add(collectionItemAttributes: JSON, metadata: MetadataInput!, setReady: Boolean): Metadata!
    "Assign a category to a metadata item"
    addCategory(categoryId: UUID!, metadataId: UUID!): Boolean!
    "Add a comment to a metadata item. Returns the new comment ID."
    addComment(comment: CommentInput!, metadataId: UUID!, metadataVersion: Int!): Long!
    "Like a comment on a metadata item. Returns the updated like count."
    addCommentLike(commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Long!
    "Create a new data metadata item from a template, optionally within a parent collection"
    addData(parentCollectionId: UUID, setReady: Boolean, templateId: UUID!, templateVersion: Int!): Metadata
    "Create a new document metadata item from a template within a parent collection"
    addDocument(parentCollectionId: UUID!, setReady: Boolean, templateId: UUID!, templateVersion: Int!): Metadata
    "Create a new guide metadata item from a template within a parent collection"
    addGuide(parentCollectionId: UUID!, setReady: Boolean, templateId: UUID!, templateVersion: Int!): Metadata
    "Add a step to a guide from a template step definition"
    addGuideStep(metadataId: UUID!, metadataVersion: Int!, sort: Int!, templateStepId: Long!): GuideStep!
    "Add a module to a guide step from a template module definition"
    addGuideStepModule(metadataId: UUID!, metadataVersion: Int!, sort: Int!, stepId: Long!, templateModuleId: Long!): GuideStepModule!
    "Create a language variant of an existing metadata item"
    addLanguageVariant(id: UUID!, languageTag: String!, setReady: Boolean, version: Int!): Metadata!
    "Add an access permission to a metadata item"
    addPermission(permission: PermissionInput!): Permission!
    "Create a relationship between two metadata items"
    addRelationship(relationship: MetadataRelationshipInput!): MetadataRelationship!
    "Add supplementary content to a metadata item (files, assets, processed outputs)"
    addSupplementary(supplementary: MetadataSupplementaryInput!): MetadataSupplementary!
    "Assign a trait to a metadata item, enabling its associated behaviors and workflows"
    addTrait(metadataId: UUID!, traitId: String!): Boolean!
    "Access AI-powered mutation operations for metadata items"
    ai: MetadataAIMutation!
    "Clear the data collaboration state (e.g. Yjs CRDT data) for a metadata item at a specific version"
    clearDataCollaboration(metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Clear the document collaboration state (e.g. Yjs CRDT data) for a metadata item at a specific version"
    clearDocumentCollaboration(metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Access collection template mutation operations for a specific metadata item and version"
    collectionTemplate(metadataId: UUID!, metadataVersion: Int!): CollectionTemplateMutation!
    "Access comment mutations for metadata items"
    comments: CommentsMutation!
    "Access data template mutation operations for a specific metadata item and version"
    dataTemplate(metadataId: UUID!, metadataVersion: Int!): DataTemplateMutation!
    "Soft-delete a metadata item (can be restored or permanently deleted later)"
    delete(metadataId: UUID!): Boolean!
    "Soft-delete multiple metadata items in a single operation"
    deleteAll(metadataIds: [UUID!]!): Int!
    "Remove a category assignment from a metadata item"
    deleteCategory(categoryId: UUID!, metadataId: UUID!): Boolean!
    "Delete a comment from a metadata item"
    deleteComment(commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Remove a like from a comment on a metadata item"
    deleteCommentLike(commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Delete the binary/file content associated with a metadata item"
    deleteContent(metadataId: UUID!): Boolean!
    "Delete the guide content from a metadata item"
    deleteGuide(metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Delete a step from a guide"
    deleteGuideStep(metadataId: UUID!, metadataVersion: Int!, stepId: Long!): Boolean!
    "Delete a module from a guide step"
    deleteGuideStepModule(metadataId: UUID!, metadataVersion: Int!, moduleId: Long!, stepId: Long!): Boolean!
    "Delete processed media for a metadata item, removing it from the external provider"
    deleteMedia(id: UUID!): Boolean!
    "Delete processed media for multiple metadata items in a single operation. Items that do not exist or lack permission are silently skipped. Returns the number of items successfully deleted."
    deleteMediaAll(metadataIds: [UUID!]!): Int!
    "Remove an access permission from a metadata item"
    deletePermission(permission: PermissionInput!): Permission!
    "Delete a relationship between two metadata items"
    deleteRelationship(id1: UUID!, id2: UUID!, relationship: String!): Boolean!
    "Delete a supplementary content item"
    deleteSupplementary(id: UUID!): Boolean!
    "Remove a trait assignment from a metadata item"
    deleteTrait(metadataId: UUID!, traitId: String!): Boolean!
    "Detach a supplementary item from its metadata without deleting the content"
    detachSupplementary(id: UUID!): Boolean!
    "Access document template mutation operations for a specific metadata item and version"
    documentTemplate(metadataId: UUID!, metadataVersion: Int!): DocumentTemplateMutation!
    "Update an existing metadata item with new values"
    edit(id: UUID!, metadata: MetadataInput!): Metadata!
    "Update an existing relationship between metadata items"
    editRelationship(relationship: MetadataRelationshipInput!): Boolean!
    "Access guide mutation operations for a specific metadata item and version"
    guide(metadataId: UUID!, metadataVersion: Int!): GuideMutation!
    "Access guide template mutation operations for a specific metadata item and version"
    guideTemplate(metadataId: UUID!, metadataVersion: Int!): GuideTemplateMutation!
    "Create a metadata item and import its content by downloading from an external URL. The download runs asynchronously as a background job with progress events on the import progress channel."
    importUrl(collectionItemAttributes: JSON, headers: JSON, metadata: MetadataInput!, ready: Boolean, url: String!): Metadata!
    "Merge system attributes into a comment (existing keys are preserved unless overwritten)"
    mergeCommentSystemAttributes(attributes: JSON!, commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Merge attributes into a metadata item's existing attributes (existing keys are preserved unless overwritten)"
    mergeMetadataAttributes(attributes: JSON!, id: UUID!): Boolean!
    "Merge attributes into a metadata relationship (existing keys are preserved unless overwritten)"
    mergeMetadataRelationshipAttributes(attributes: JSON!, metadata1Id: UUID!, metadata2Id: UUID!, relationship: String!): Boolean!
    "Permanently delete a metadata item (cannot be undone)"
    permanentlyDelete(metadataId: UUID!): Boolean!
    "Trigger video processing (e.g. Mux upload) for a metadata item with video content. Optional processing options override global defaults."
    processMedia(id: UUID!, options: MediaProcessingOptionsInput): Boolean!
    "Trigger video processing for multiple metadata items in a single operation. Items that do not exist or lack permission are silently skipped. Returns the number of items successfully submitted for processing."
    processMediaAll(metadataIds: [UUID!]!): Int!
    "Reprocess Bible content for a metadata item, regenerating derived data. If no ID is provided, reprocesses all Bible content."
    reprocessBible(metadataId: UUID, metadataVersion: Int): Boolean!
    "Replace all category assignments on a metadata item"
    setCategories(categoryIds: [UUID!]!, metadataId: UUID!): Boolean!
    "Replace all custom attributes on a comment"
    setCommentAttributes(attributes: JSON!, commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Update the moderation status of a comment"
    setCommentStatus(commentId: Long!, metadataId: UUID!, metadataVersion: Int!, status: CommentStatus!): Boolean!
    "Replace all system-managed attributes on a comment"
    setCommentSystemAttributes(attributes: JSON!, commentId: Long!, metadataId: UUID!, metadataVersion: Int!): Boolean!
    "Set the start date for a calendar-based guide"
    setGuideStartDate(date: DateTime!, metadataId: UUID!, metadataVersion: Int!): Metadata
    "Lock or unlock a metadata item from modifications"
    setLocked(id: UUID!, locked: Boolean!, version: Int!): Metadata!
    "Update the thumbnail time offset for a processed media asset. The thumbnail URL is rebuilt using the new offset without re-processing."
    setMediaThumbnailOffset(id: UUID!, offsetSeconds: Float!): Boolean!
    "Replace all custom attributes on a metadata item"
    setMetadataAttributes(attributes: JSON!, id: UUID!): Boolean!
    "Set or update the Bible content associated with a metadata item"
    setMetadataBible(bible: BibleInput!, id: UUID!, version: Int!): Boolean!
    "Upload file content for a metadata item using a multipart file upload"
    setMetadataContents(contentType: String, file: Upload!, id: UUID!): Boolean!
    "Set or update the structured document content of a metadata item"
    setMetadataDocument(collaborationSync: CollaborationSyncMode, document: DocumentInput!, id: UUID!, version: Int!): Boolean!
    "Set content for a metadata item using a JSON payload"
    setMetadataJsonContents(content: JSON!, contentType: String, id: UUID!): Boolean!
    "Set the document content of a metadata item from a markdown string. The markdown is parsed into a TipTap document server-side."
    setMetadataMarkdown(collaborationSync: CollaborationSyncMode, id: UUID!, markdown: String!, title: String!, version: Int!): Boolean!
    "Update the display name of a metadata item"
    setMetadataName(id: UUID!, name: String!): Metadata!
    "Mark a metadata item as not ready (reverses setMetadataReady)"
    setMetadataNotReady(id: UUID!): Boolean!
    "Replace all parent collection associations for a metadata item"
    setMetadataParentCollections(collections: [MetadataParentCollectionInput!]!, id: UUID!): Boolean!
    "Mark a metadata item as ready for publishing and workflow processing"
    setMetadataReady(id: UUID!): Boolean!
    "Mark multiple metadata items as ready in a single operation, skipping items the caller lacks permission to edit"
    setMetadataReadyAll(metadataIds: [UUID!]!): Int!
    "Replace all relationships for a metadata item with the provided set"
    setMetadataRelationships(id: UUID!, relationships: [MetadataRelationshipInput!]!): Boolean
    "Enable or disable search indexing for a metadata item"
    setMetadataSearchable(id: UUID!, searchable: Boolean!): Boolean!
    "Set or update the URL-friendly slug for a metadata item. Returns the final slug value."
    setMetadataSlug(id: UUID!, slug: String!): String!
    "Enable or disable automatic synchronization of variant collections when the parent changes"
    setMetadataSyncVariantCollections(id: UUID!, syncVariants: Boolean!): Boolean!
    "Enable or disable automatic synchronization of variant relationships when the parent changes"
    setMetadataSyncVariantRelationships(id: UUID!, syncVariants: Boolean!): Boolean!
    "Replace all system-managed attributes on a metadata item"
    setMetadataSystemAttributes(attributes: JSON!, id: UUID!): Boolean!
    "Set content for a metadata item using a plain text payload"
    setMetadataTextContents(content: String!, contentType: String, id: UUID!): Boolean!
    "Mark a metadata item's content as uploaded with its content type and size. Optionally mark it as ready."
    setMetadataUploaded(contentType: String, id: UUID!, len: Int!, ready: Boolean): Boolean!
    "Set or clear the parent metadata item ID (used for variant relationships)"
    setParentId(id: UUID!, parentId: UUID): Metadata!
    "Set whether a metadata item is publicly accessible"
    setPublic(id: UUID!, public: Boolean!): Metadata!
    "Set public, public content, and public supplementary flags for multiple metadata items in a single operation, skipping items the caller lacks permission to edit"
    setPublicAll(metadataIds: [UUID!]!, public: Boolean!, publicContent: Boolean!, publicSupplementary: Boolean!, searchable: Boolean!): Int!
    "Set whether the binary/file content is publicly accessible"
    setPublicContent(id: UUID!, public: Boolean!): Metadata!
    "Set whether supplementary files are publicly accessible"
    setPublicSupplementary(id: UUID!, public: Boolean!): Metadata!
    "Upload file content for a supplementary item using a multipart file upload"
    setSupplementaryContents(contentType: String!, file: Upload!, supplementaryId: UUID!): Boolean!
    "Set text content for a supplementary item"
    setSupplementaryTextContents(content: String!, contentType: String!, supplementaryId: UUID!): Boolean!
    "Mark a supplementary item's content as uploaded with its content type and size"
    setSupplementaryUploaded(contentType: String!, len: Int!, supplementaryId: UUID!): Boolean!
    "Assign a template to a metadata item, defining its structure and behavior"
    setTemplate(id: UUID!, templateId: UUID!, templateVersion: Int!, version: Int!): Metadata!
    "Transition a metadata item to a new workflow state"
    setWorkflowState(state: MetadataWorkflowState!): Boolean!
    "Mark a workflow state transition as complete with a status message"
    setWorkflowStateComplete(state: MetadataWorkflowCompleteState!): Boolean!
    "Update video quality and/or resolution tier settings stored for a processed media asset. The new settings take effect on the next re-upload to the provider."
    updateMediaSettings(id: UUID!, options: MediaProcessingOptionsInput!): Boolean!
}

"An association between a metadata item and a user profile, defining the role or relationship"
type MetadataProfile {
    "The associated user profile"
    profile: Profile
    "The type of relationship between the profile and metadata item (e.g. 'author', 'editor', 'reviewer')"
    relationship: String!
}

"A directional relationship between two metadata items, with an optional set of custom attributes"
type MetadataRelationship {
    "Custom attributes on this relationship"
    attributes: JSON
    "Unique identifier of the related metadata item"
    id: UUID!
    "The related metadata item"
    metadata: Metadata!
    "The type of relationship (e.g. 'thumbnail', 'related', 'translation', 'audio')"
    relationship: String!
}

"External source information for a metadata item that was imported from another system"
type MetadataSource {
    "ID of the source system in Bosca"
    id: UUID
    "Identifier of the item within the external source system"
    identifier: String
    "The source system definition"
    source: Source
    "Current status of the source content lifecycle"
    status: SourceStatus
    "URL of the item in the external source system"
    url: String
}

"A supplementary content item attached to a metadata item, such as a thumbnail, transcript, processed output, or any additional file"
type MetadataSupplementary {
    "Custom attributes associated with this supplementary item"
    attributes: JSON
    "Content details including type, size, and access URLs"
    content: MetadataSupplementaryContent!
    "Timestamp when this supplementary item was created"
    created: DateTime!
    "Unique identifier for this supplementary item"
    id: UUID!
    "Unique key within the metadata item (e.g. 'thumbnail', 'transcript', 'mp3')"
    key: String!
    "ID of the parent metadata item this supplementary belongs to"
    metadataId: UUID!
    "Timestamp when this supplementary item was last modified"
    modified: DateTime!
    "Display name of the supplementary item"
    name: String!
    "Storage plan ID for content storage"
    planId: UUID
    "External source information if this supplementary was imported"
    source: MetadataSupplementarySource
    "Timestamp when content was uploaded, null if not yet uploaded"
    uploaded: DateTime
}

"Content details for a metadata supplementary item, including its type, size, and access URLs"
type MetadataSupplementaryContent {
    "The content parsed as JSON (if the content type supports JSON parsing)"
    json: JSON!
    "Content length in bytes"
    length: Int
    "The content as plain text (if the content type supports text extraction)"
    text: String!
    "MIME content type (e.g. 'image/png', 'audio/mpeg', 'text/plain')"
    type: String!
    "Pre-signed URLs for uploading and downloading the supplementary content"
    urls: MetadataSupplementaryContentUrls!
}

"Pre-signed URLs for accessing metadata supplementary content"
type MetadataSupplementaryContentUrls {
    "Pre-signed URL for downloading the supplementary content"
    download: SignedUrl!
    "Pre-signed URL for uploading new supplementary content"
    upload: SignedUrl!
}

"Source information for an imported supplementary content item"
type MetadataSupplementarySource {
    "ID of the source system in Bosca"
    id: UUID!
    "Identifier of the item within the external source system"
    identifier: String
}

"Current workflow state information for a metadata item, including pending operations and processing status"
type MetadataWorkflow {
    "Currently active (incomplete) jobs for this metadata item, including pending, running, and scheduled jobs"
    activeJobs: [ContentJobHistory!]!
    "ID of the workflow to run when this metadata item is deleted"
    deleteWorkflow: String
    "Description of what is currently pending, if anything (e.g. a workflow step awaiting completion)"
    pending: String
    "Number of currently running workflow steps"
    running: Int!
    "Current workflow state ID (e.g. 'draft', 'processing', 'published')"
    state: String!
    "Timestamp when the current state became valid"
    stateValid: DateTime
}

"An AI/ML model configuration registered in the system for use with prompts and AI workflows"
type Model {
    "Model-specific configuration (API endpoints, parameters, etc.)"
    configuration: JSON!
    "Description of the model and its capabilities"
    description: String!
    "Unique identifier for this model"
    id: UUID!
    "Unique key for referencing this model (e.g. 'gpt-4', 'claude-3')"
    key: String!
    "Display name of the model"
    name: String!
    "The type/provider of the model (e.g. 'openai', 'anthropic', 'ollama')"
    type: String!
}

"Query operations for browsing registered AI models"
type Models {
    "List all registered models"
    all: [Model!]!
    "Get a specific model by ID"
    model(id: UUID!): Model
}

"Mutation operations for managing AI model configurations"
type ModelsMutation {
    "Register a new model"
    add(model: ModelInput!): Model
    "Delete a model by ID"
    delete(id: UUID!): Boolean!
    "Update an existing model configuration"
    edit(id: UUID!, model: ModelInput!): Model
}

"The root mutation type for the Bosca API. All write operations are accessed through the namespaced fields below."
type Mutation {
    "Access mutation operations for managing agent tools"
    agentTools: AgentToolsMutation!
    "Access mutation operations for managing AI agents"
    agents: AgentsMutation!
    "Access analytics mutation operations"
    analytics: AnalyticsMutation!
    "Access artifact registry mutation operations for managing namespaces, versions, and tags."
    artifactsAdmin: ArtifactsAdminMutation!
    "Access backup mutation operations for creating backups and restoring from them."
    backups: BackupsMutation!
    "Access calendar mutation operations."
    calendars: CalendarsMutation!
    "Access campaign mutation operations for creating, scheduling, and sending campaigns."
    campaigns: CampaignsMutation!
    "Access mutation operations for chat channels and messages"
    chat: ChatMutation!
    "Access mutation operations for managing chat sessions"
    chatSessions: ChatSessionsMutation!
    "Clear all server-side caches (local Caffeine cache, Redis/NATS cache). Returns true if the caches were successfully cleared."
    clearCache: Boolean!
    "Clear the CDN edge cache, forcing content to be re-fetched from the origin. Returns true if the CDN cache was successfully invalidated."
    clearCdnCache: Boolean!
    "Force-release all distributed locks held by jobs across all queues, allowing stuck jobs to be re-acquired by workers. Returns true if the operation completed successfully."
    clearJobLocks: Boolean!
    "Bridge and federation administration mutations grouped under a single namespace."
    collaboration: CollaborationMutation!
    "Access mutation operations for community groups, channels, messages, activities, and prayers"
    community: CommunityMutation!
    "Access configuration mutation operations for managing application settings in the key-value store."
    configurations: ConfigurationsMutation!
    "Access content management mutation operations for collections, metadata, workflows, models, and related content entities."
    content: ContentMutation!
    "Access device mutation operations for registration, check-in, push token management, and deletion."
    devices: DevicesMutation!
    exclusionLayers: ExclusionLayersMutation!
    experiments: ExperimentsMutation!
    "Expire all pending jobs in the job queue, marking them for re-processing. Returns true if jobs were successfully expired."
    expireAllJobs: Boolean!
    featureFlags: FeatureFlagsMutation!
    "Access form schema mutation operations for creating, updating, and deleting form definitions"
    formSchemasMutation: FormSchemasMutation!
    "Access form submission mutations for submitting, updating status, and deleting form submissions."
    forms: FormsMutation!
    "Git repository mutations."
    git: GitMutation!
    "Access job management mutations"
    jobs: JobsMutation!
    "Entry point for language mutations."
    languages: LanguagesMutation!
    "Entry point for localization mutations"
    localization: LocalizationMutation!
    "Access mutation operations for managing MCP server registrations"
    mcpServers: McpServersMutation!
    "Access Meilisearch admin mutation operations for managing indexes, settings, embedders, nodes, replication, and federation."
    meilisearchAdmin: MeilisearchAdminMutation!
    "Access AI model mutations"
    models: ModelsMutation!
    "Access NATS admin mutation operations for modifying KeyValue entries and stream messages."
    natsAdmin: NatsAdminMutation!
    "Access organization mutation operations for managing organizations, memberships, domains, and signup configurations."
    organizations: OrganizationsMutation!
    "Access package management mutations"
    packages: PackagesMutation!
    "Access persisted query mutation operations for registering and managing pre-registered GraphQL queries."
    persistedQueries: PersistedQueriesMutation!
    "Access PostgreSQL admin mutation operations for canceling queries, terminating backends, and running maintenance."
    postgresAdmin: PostgresAdminMutation!
    "Access profile mutation operations for managing user profiles, attributes, collections, and relationships."
    profiles: ProfilesMutation!
    "Access prompt template mutations"
    prompts: PromptsMutation!
    "Access the job scheduler mutation operations for creating, editing, deleting, and triggering scheduled jobs."
    scheduler: SchedulerMutation!
    scripts: ScriptsMutation!
    "Access security mutation operations for managing principals, groups, permissions, and authentication."
    security: SecurityMutation!
    "Access audience segmentation mutation operations for managing segments and membership."
    segments: SegmentsMutation!
    "Access workflow state mutations"
    states: WorkflowStatesMutation!
    "Access storage system mutation operations for managing search, supplementary, and vector storage configurations."
    storageSystems: StorageSystemsMutation!
    "Access time event mutation operations"
    timeEvents: TimeEventMutation!
    "Access workflow transition mutations"
    transitions: TransitionsMutation!
    workOps: WorkOpsMutations!
}

"Query operations for introspecting the NATS server's operational state."
type NatsAdmin {
    "Retrieve active route connections between servers in the NATS cluster."
    clusterRoutes: NatsRoutes!
    "Retrieve active client connections with optional pagination and sorting."
    connections(
        "Maximum number of connections to return."
        limit: Int,
        "Zero-based offset for pagination."
        offset: Int,
        "Field to sort connections by (e.g. 'cid', 'bytes_to', 'msgs_to')."
        sortBy: String
    ): NatsConnections!
    "Retrieve all consumers for a specific JetStream stream."
    jetStreamConsumers(
        "The name of the stream to query consumers for."
        streamName: String!
    ): [JetStreamConsumerDetail!]!
    "Retrieve JetStream overview statistics including stream and consumer counts."
    jetStreamInfo: JetStreamInfo!
    "Retrieve details for all JetStream streams."
    jetStreamStreams: [JetStreamStreamDetail!]!
    "Browse entries in a KeyValue store bucket with optional key and value filtering."
    keyValueEntries(
        "The name of the KV bucket to browse."
        bucket: String!,
        "Optional glob pattern to filter keys (e.g. 'prefix.*')."
        keyFilter: String,
        "Optional substring to search for within entry values."
        valueSearch: String
    ): [NatsKeyValueEntry!]!
    "List all KeyValue store buckets, optionally filtered by bucket name."
    keyValueStores: [NatsKeyValueStore!]!
    "Retrieve general server information including version, uptime, and throughput statistics."
    serverInfo: NatsServerInfo!
    "Read messages from a JetStream stream with optional filtering by subject, sequence range, and payload content."
    streamMessages(
        "Search for this substring within message payloads."
        dataSearch: String,
        "Read messages starting from this sequence number (inclusive)."
        fromSeq: Long,
        "Maximum number of messages to return (default 50)."
        limit: Int,
        "The name of the stream to read from."
        streamName: String!,
        "Filter messages by subject (supports NATS wildcards: * for single token, > for remaining)."
        subjectFilter: String,
        "Read messages up to this sequence number (inclusive)."
        toSeq: Long
    ): [NatsStreamMessage!]!
    "Retrieve subscription routing statistics."
    subscriptionsInfo: NatsSubscriptionsInfo!
}

"Mutation operations for modifying NATS KeyValue store entries and JetStream stream messages."
type NatsAdminMutation {
    "Delete a key-value entry from the specified bucket."
    deleteKeyValueEntry(
        "The name of the KV bucket."
        bucket: String!,
        "The key to delete."
        key: String!
    ): Boolean!
    "Delete a single message from a JetStream stream by sequence number."
    deleteStreamMessage(
        "The sequence number of the message to delete."
        sequence: Long!,
        "The name of the stream containing the message."
        streamName: String!
    ): Boolean!
    "Permanently remove all tombstoned (deleted/purged) entries from a KeyValue store bucket, reclaiming storage."
    purgeKeyValueDeletes(
        "The name of the KV bucket to compact."
        bucket: String!
    ): Boolean!
    "Purge all messages from a JetStream stream, preserving configuration and consumers."
    purgeStream(
        "The name of the stream to purge."
        streamName: String!
    ): Boolean!
    "Remove all KeyValue tombstone messages (DEL/PURGE markers) from a stream, reclaiming storage while preserving live entries. Returns the number of tombstones removed."
    purgeStreamDeletes(
        "The name of the stream to purge tombstones from."
        streamName: String!
    ): Int!
    "Create or update a key-value entry in the specified bucket. Returns the entry with its new revision."
    putKeyValueEntry(
        "The name of the KV bucket."
        bucket: String!,
        "The key to create or update."
        key: String!,
        "The string value to store."
        value: String!
    ): NatsKeyValueEntry!
}

"Details about an active client connection to the NATS server."
type NatsConnection {
    "The server-assigned connection identifier."
