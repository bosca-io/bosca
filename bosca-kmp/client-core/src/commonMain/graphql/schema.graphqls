    "Whether this agent was created for a single job and will be destroyed after."
    ephemeral: Boolean!
    expiresAt: DateTime
    id: UUID!
    "Hypervisor instance ID (e.g., DigitalOcean droplet ID)."
    instanceId: String
    "The job this transient agent is scoped to."
    jobId: UUID
    labels: [String!]!
    lastHeartbeat: DateTime
    mode: GitAgentMode!
    name: String!
    "The orchestrator agent that spawned this transient agent."
    parentAgentId: UUID
    "Recent jobs assigned to this agent."
    recentJobs(limit: Int): [GitPipelineJob!]!
    status: GitAgentStatus!
}

"Returned when registering a new agent. Token is only shown once."
type GitPipelineAgentRegistration {
    agent: GitPipelineAgent!
    "The agent token. Only returned at registration time — store it securely."
    token: String!
}

"A build artifact produced by a pipeline run."
type GitPipelineArtifact {
    created: DateTime!
    id: UUID!
    name: String!
    pipelineRunId: UUID!
    repositoryId: UUID!
    runNumber: Int!
    sizeBytes: Long!
}

"A job within a pipeline run."
type GitPipelineJob {
    agentId: UUID
    dependsOn: [String!]!
    finished: DateTime
    id: UUID!
    matrixValues: JSON
    name: String!
    pipelineRunId: UUID!
    runnerLabel: String!
    started: DateTime
    status: GitPipelineRunStatus!
    "Steps within this job."
    steps: [GitPipelineStep!]!
    timeoutMinutes: Int
}

"Log output from a pipeline step."
type GitPipelineLogLine {
    content: String!
    lineNumber: Int!
    stream: String!
    timestamp: DateTime!
}

"A single execution of a pipeline."
type GitPipelineRun {
    "Build artifacts uploaded during this run."
    artifacts: [GitPipelineArtifact!]!
    commitSha: String!
    concurrencyGroup: String
    created: DateTime!
    "Duration in seconds, null if not started."
    durationSeconds: Long
    finished: DateTime
    id: UUID!
    "Jobs within this run."
    jobs: [GitPipelineJob!]!
    "Per-pipeline auto-incrementing number."
    number: Int!
    pipelineId: UUID!
    ref: String!
    repositoryId: UUID!
    started: DateTime
    status: GitPipelineRunStatus!
    triggerType: GitPipelineTriggerType!
    triggeredBy: UUID
}

"A secret available to pipelines (name only, value never exposed via API)."
type GitPipelineSecretInfo {
    created: DateTime!
    name: String!
    updated: DateTime!
}

"An individual step within a pipeline job."
type GitPipelineStep {
    condition: String
    env: JSON!
    exitCode: Int
    finished: DateTime
    id: UUID!
    image: String
    name: String!
    ordinal: Int!
    pipelineJobId: UUID!
    run: String
    started: DateTime
    status: GitPipelineRunStatus!
    uses: String
    with: JSON!
    workingDirectory: String
}

"Provider credential metadata. Actual API tokens are supplied via CLI local config."
type GitProviderCredentials {
    selfDestructTokenScope: String
}

"A pull request within a repository."
type GitPullRequest {
    "Profile IDs of users assigned to this PR."
    assigneeIds: [UUID!]!
    "Resolved assignee profiles."
    assignees: [Profile!]!
    "Profile ID of the PR author."
    authorId: UUID!
    "Files with merge conflicts, if any."
    conflictingFiles: [String!]!
    created: DateTime!
    "Markdown description."
    description: String
    "Structured diff between source and target branches."
    diff: [GitDiffFile!]!
    id: UUID!
    "The SHA of the merge commit."
    mergeSha: String
    "The strategy used when merged."
    mergeStrategy: GitMergeStrategy
    "Whether the PR can be cleanly merged."
    mergeable: Boolean!
    mergedAt: DateTime
    mergedBy: UUID
    "Per-repository auto-incrementing number (e.g. #42)."
    number: Int!
    "The repository this PR belongs to."
    repositoryId: UUID!
    "Reviews submitted on this PR."
    reviews: [GitReview!]!
    sourceBranch: String!
    "Non-null for cross-fork PRs."
    sourceRepositoryId: UUID
    status: GitPullRequestStatus!
    targetBranch: String!
    title: String!
    updated: DateTime!
}

"Links an analytics query to a git file."
type GitQuerySourceRef {
    path: String!
    queryId: UUID!
    ref: String!
    repositoryId: UUID!
    resolvedCommit: String
}

"Repository-level statistics."
type GitRepoStats {
    branchCount: Int!
    commitCount: Long!
    contributorCount: Int!
    diskSizeBytes: Long!
    tagCount: Int!
}

"A Bosca-hosted git repository."
type GitRepository {
    "Whether the repository is archived (read-only)."
    archived: Boolean!
    "The fully-qualified HTTP clone URL for this repository."
    cloneUrl: String!
    "Merge and commit policy configuration."
    configuration: GitRepositoryConfiguration!
    "The intended content classification."
    contentType: GitRepositoryContentType
    "When the repository was created."
    created: DateTime!
    "The branch used as the default for PRs and browsing."
    defaultBranch: String!
    "Whether the repository has been soft-deleted."
    deleted: Boolean!
    "Optional description."
    description: String
    "Total storage consumed in bytes."
    diskSizeBytes: Long!
    "The repository this was forked from, if any."
    forkedFromId: UUID
    "Unique identifier."
    id: UUID!
    "Display name."
    name: String!
    "The owner's profile or organization ID."
    ownerId: UUID!
    "Permission grants on this repository. Only visible to users with MANAGE permission."
    permissions: [GitRepositoryPermission!]!
    "URL-safe identifier used in clone URLs. Immutable after creation."
    slug: String!
    "When the repository was last updated."
    updated: DateTime!
    "Access visibility level."
    visibility: GitVisibility!
}

"Configurable policies for merge behaviour and commit requirements."
type GitRepositoryConfiguration {
    "Whether the source branch is deleted after a successful PR merge."
    deleteBranchOnMerge: Boolean!
    "The merge strategies permitted when completing pull requests."
    mergeStrategies: [GitMergeStrategy!]!
    "Whether pushed commits must carry a valid GPG signature."
    requireSignedCommits: Boolean!
    "Whether squash is pre-selected in the merge dialog."
    squashByDefault: Boolean!
}

"A permission grant on a git repository."
type GitRepositoryPermission {
    "The action the group is permitted to perform."
    action: String!
    "The security group granted the permission."
    groupId: UUID!
    "The repository this permission applies to."
    repositoryId: UUID!
}

"A review submitted on a pull request."
type GitReview {
    body: String
    "Line-level comments anchored to the diff."
    comments: [GitReviewComment!]!
    created: DateTime!
    dismissReason: String
    dismissedAt: DateTime
    id: UUID!
    pullRequestId: UUID!
    reviewerId: UUID!
    status: GitReviewStatus!
}

"A comment anchored to a specific line in a pull request diff."
type GitReviewComment {
    authorId: UUID!
    commitSha: String!
    content: String!
    created: DateTime!
    filePath: String!
    id: UUID!
    newLineNumber: Int
    oldLineNumber: Int
    "Whether the comment's diff context has changed due to a force-push."
    outdated: Boolean!
    pullRequestId: UUID!
    resolved: Boolean!
    reviewId: UUID!
    updated: DateTime!
}

"Links a script to a git file. Git is source of truth; database caches the deployed version."
type GitScriptSourceRef {
    "Path to the script file in the repository (e.g. 'scripts/on-publish.kts')."
    path: String!
    "Branch, tag, or commit SHA to track."
    ref: String!
    repositoryId: UUID!
    "The commit SHA currently deployed to the database."
    resolvedCommit: String
    scriptId: UUID!
}

"A search result from content search across repository files."
type GitSearchResult {
    filePath: String!
    lineNumber: Int!
    snippet: String!
}

"Tag metadata."
type GitTagInfo {
    isAnnotated: Boolean!
    message: String
    name: String!
    sha: String!
    taggerEmail: String
    taggerName: String
    targetSha: String
}

"A task-to-commit reference extracted from commit messages."
type GitTaskCommitReference {
    commitSha: String!
    created: DateTime!
    id: UUID!
    repositoryId: UUID!
    taskKey: String!
}

"A task-to-pull-request reference extracted from PR metadata."
type GitTaskPullRequestReference {
    created: DateTime!
    id: UUID!
    pullRequestId: UUID!
    pullRequestNumber: Int!
    repositoryId: UUID!
    taskKey: String!
}

"A single entry in a directory listing."
type GitTreeEntry {
    mode: Int!
    name: String!
    path: String!
    sha: String!
    size: Long
    type: GitTreeEntryType!
}

"Default VM configuration when no runner profile matches."
type GitVmDefaults {
    image: String!
    region: String!
    size: String!
}

"A webhook endpoint subscribed to repository events."
type GitWebhook {
    active: Boolean!
    created: DateTime!
    events: [GitWebhookEvent!]!
    id: UUID!
    repositoryId: UUID!
    url: String!
}

"A single webhook delivery attempt."
type GitWebhookDelivery {
