    id: UUID!
    projectId: UUID!
    publishedAt: DateTime
    publishedByPrincipalId: UUID
    repositoryUrl: String
    status: String!
    version: Long!
    versionId: UUID!
}

"""

R16 — attachments. Uploads round-trip through a presigned URL +
HMAC confirmation token; the storage object id is opaque to the
client.
"""
type WorkOpsAttachment {
    contentType: String!
    description: String
    filename: String!
    id: UUID!
    sizeBytes: Long!
    storageObjectId: UUID
    taskId: UUID!
    thumbnailStorageObjectId: UUID
    uploadedAt: DateTime!
    uploadedByProfileId: UUID!
}

type WorkOpsAttachmentMutation {
    confirmUpload(description: String, token: String!): WorkOpsAttachment!
    deleteAttachment(id: UUID!): Boolean!
    requestUpload(contentType: String!, filename: String!, sizeBytes: Long!, taskId: UUID!): WorkOpsPresignedUpload!
}

type WorkOpsAttachmentQuery {
    attachment(id: UUID!): WorkOpsAttachment
    forTask(taskId: UUID!): [WorkOpsAttachment!]!
}

type WorkOpsAutomationExecutionLog {
    durationMs: Long
    errorMessage: String
    finishedAt: DateTime
    id: UUID!
    outcome: String!
    ruleId: UUID!
    startedAt: DateTime!
    taskId: UUID
}

type WorkOpsAutomationMutation {
    create(input: WorkOpsAutomationRuleInput!): WorkOpsAutomationRule!
    delete(id: UUID!): Boolean!
    setEnabled(enabled: Boolean!, expectedVersion: Long!, id: UUID!): WorkOpsAutomationRule!
    update(expectedVersion: Long!, id: UUID!, input: WorkOpsAutomationRuleInput!): WorkOpsAutomationRule!
}

type WorkOpsAutomationQuery {
    executionLogs(limit: Int!, offset: Long!, ruleId: UUID!): [WorkOpsAutomationExecutionLog!]!
    rule(id: UUID!): WorkOpsAutomationRule
    rules(scope: String!, scopeId: UUID): [WorkOpsAutomationRule!]!
}

"""

R14 — automation rules. The trigger / conditions / actions ride
as JSON blobs over the wire because the underlying sealed
hierarchies have many variants — admins author them through
templates in the workops admin UI rather than raw GraphQL.
"""
type WorkOpsAutomationRule {
    "List of `Action` discriminated objects."
    actions: JSON!
    "List of `Condition` discriminated objects."
    conditions: JSON!
    description: String
    enabled: Boolean!
    executionLogRetentionDays: Int!
    failureMode: String!
    id: UUID!
    maxFiresPerTaskPerHour: Int!
    name: String!
    runAsProfileId: UUID!
    scope: String!
    scopeId: UUID
    "Discriminated `{ \"type\": \"TaskCreated\", ... }` blob."
    trigger: JSON!
    version: Long!
}

"""

A configurable view onto tasks from one or more projects. Scope
options (at most one parent; all null = multi-project board):
- projectId: single-project board
- programId: program-scoped board (all projects in program)
- portfolioId: portfolio-scoped board
- all null: standalone multi-project board (scope from `projects`)
"""
type WorkOpsBoard {
    columns: [WorkOpsBoardColumn!]!
    createdAt: DateTime!
    "Saved filter id."
    filterId: UUID
    id: UUID!
    modifiedAt: DateTime!
    name: String!
    portfolio: WorkOpsPortfolio
    portfolioId: UUID
    program: WorkOpsProgram
    programId: UUID
    project: WorkOpsProject
    projectId: UUID
    "Explicit project membership (populated for all boards including single-project)."
    projects: [WorkOpsProject!]!
    sprints(limit: Int! = 50, offset: Long! = 0): [WorkOpsSprint!]!
    "Optional sub-filter for kanban swimlanes."
    subFilterId: UUID
    swimlaneStrategy: WorkOpsSwimlaneStrategy!
    type: WorkOpsBoardType!
    version: Long!
}

"""

One column on a WorkOpsBoard. Columns collect tasks whose status is in
[statusIds]; dragging a card across columns issues the workflow
transition that lands the task in one of the target column's
statuses (R8 — boards never bypass the workflow).
"""
type WorkOpsBoardColumn {
    boardId: UUID!
    displayOrder: Int!
    id: UUID!
    name: String!
    statusIds: [UUID!]!
    statuses: [WorkOpsStatus!]!
    wipLimit: Int
}

type WorkOpsBoards {
    board(id: UUID!): WorkOpsBoard
    byPortfolio(portfolioId: UUID!): [WorkOpsBoard!]!
    byProgram(programId: UUID!): [WorkOpsBoard!]!
    byProject(projectId: UUID!): [WorkOpsBoard!]!
    "Find multi-project boards that include any of the given project IDs."
    byProjects(projectIds: [UUID!]!): [WorkOpsBoard!]!
}

type WorkOpsBoardsMutation {
    addColumn(input: CreateWorkOpsBoardColumnInput!): WorkOpsBoardColumn!
    create(input: CreateWorkOpsBoardInput!): WorkOpsBoard!
    delete(boardId: UUID!): Boolean!
    deleteColumn(columnId: UUID!): Boolean!
    update(id: UUID!, input: UpdateWorkOpsBoardInput!): WorkOpsBoard!
    updateColumn(input: UpdateWorkOpsBoardColumnInput!): WorkOpsBoardColumn!
}

"""

A parser / validator failure carrying the byte-offset window of the
offending source span. The Excellence Bar non-negotiable requires
LLM-readable parser errors; the [start] / [end] bounds let an LLM
pick the exact characters to fix on retry.
"""
type WorkOpsBqlError {
    "Byte offset just past the last character of the offending span."
    end: Int!
    "One-line 'did you mean' suggestion when the fix is unambiguous."
    hint: String
    message: String!
    "Byte offset of the first character of the offending span (inclusive)."
    start: Int!
}

"""

Result of `validateBql` — empty `errors` means the query parses and
validates against the field catalog cleanly.
"""
type WorkOpsBqlValidationResult {
    errors: [WorkOpsBqlError!]!
}

type WorkOpsBuildBlocker {
    apiSurfaceReportId: UUID
    blockerType: String!
    compatibilityTestId: UUID
    description: String!
    providerProjectId: UUID!
    providerVersionId: UUID
}

" ── Build Readiness ────────────────────────────────────────────────────"
