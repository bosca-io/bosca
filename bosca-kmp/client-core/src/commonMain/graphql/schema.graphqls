"""

Update input. Required `expectedVersion` is the optimistic-lock token —
mismatch surfaces as `OPTIMISTIC_LOCK_FAILED`.
"""
input UpdateWorkOpsTaskInput {
    assigneeProfileId: UUID
    "Set to true to clear the assignee. Takes precedence over assigneeProfileId."
    clearAssignee: Boolean
    "Set to true to clear the due date. Takes precedence over dueDate."
    clearDueDate: Boolean
    "Set to true to clear the original estimate. Takes precedence over originalEstimateSeconds."
    clearOriginalEstimate: Boolean
    "Set to true to remove the parent task. Takes precedence over parentTaskId."
    clearParentTask: Boolean
    "Set to true to clear the remaining estimate. Takes precedence over remainingEstimateSeconds."
    clearRemainingEstimate: Boolean
    "Set to true to remove the task from its sprint. Takes precedence over sprintId."
    clearSprintId: Boolean
    "Set to true to clear the start date. Takes precedence over startDate."
    clearStartDate: Boolean
    descriptionMarkdown: String
    dueDate: DateTime
    expectedVersion: Long!
    originalEstimateSeconds: Long
    "Parent task UUID for subtask hierarchy."
    parentTaskId: UUID
    priorityId: UUID
    remainingEstimateSeconds: Long
    "Assign the task to a sprint."
    sprintId: UUID
    startDate: DateTime
    summary: String
    taskTypeId: UUID
}

input UpdateWorkOpsTaskLinkTypeInput {
    category: WorkOpsLinkCategory!
    expectedVersion: Long!
    inwardLabel: String!
    name: String!
    outwardLabel: String!
}

input UpdateWorkOpsTaskTypeInput {
    colorHex: String!
    description: String
    expectedVersion: Long!
    hierarchyLevel: WorkOpsTaskHierarchyLevel!
    iconKey: String!
    name: String!
}

"Input marking the end boundary of a verse range within a scripture component"
input VerseEndInput {
    "USFM reference identifying the ending verse"
    reference: ReferenceInput!
}

"Input marking the start boundary of a verse range within a scripture component"
input VerseStartInput {
    "USFM reference identifying the starting verse"
    reference: ReferenceInput!
}

input WorkOpsAutomationRuleInput {
    actions: JSON!
    conditions: JSON!
    description: String
    enabled: Boolean!
    executionLogRetentionDays: Int!
    failureMode: String!
    maxFiresPerTaskPerHour: Int!
    name: String!
    runAsProfileId: UUID!
    scope: String!
    scopeId: UUID
    trigger: JSON!
}

"""

Closing a sprint disposes of every still-open task. The
`destinations` map keys each (committed + added) task id to a
target sprint id (or null to drop to backlog). Missing entries
raise `SPRINT_CLOSE_UNFINISHED` with the missing ids enumerated.
"""
input WorkOpsCloseSprintDestination {
    "Target sprint id; null sends the task back to the project's backlog."
    targetSprintId: UUID
    taskId: UUID!
}

input WorkOpsDeployInput {
    artifactPublicationId: UUID
    environmentId: UUID!
    healthCheckUrl: String
    projectId: UUID!
    releaseId: UUID
    versionId: UUID!
}

input WorkOpsNotificationPreferenceUpdateInput {
    dailyDigest: Boolean!
    dndEndLocal: String
    dndStartLocal: String
    "`Map<NotificationEvent, [NotificationChannel]>` JSON shape."
    eventChannels: JSON!
    mutedProjectIds: [UUID!]!
    mutedTaskIds: [UUID!]!
    watchAuthored: Boolean!
    watchCommented: Boolean!
}

"Input shape for createPortfolio / updatePortfolio."
input WorkOpsPortfolioInput {
    description: String
    key: String!
    name: String!
    ownerProfileId: UUID!
}

input WorkOpsProgramInput {
    description: String
    key: String!
    name: String!
    ownerProfileId: UUID!
    portfolioId: UUID!
    startDate: DateTime
    targetDate: DateTime
}

input WorkOpsProjectInput {
    defaultTaskTypeSchemeId: UUID
    description: String
    key: String!
    name: String!
    ownerProfileId: UUID!
    programId: UUID!
    "Form schema key for task creation. Defaults to 'workops.create-task'."
    taskCreationFormSchemaKey: String
}

input WorkOpsRequirementCommentInput {
    attributes: JSON
    content: String!
    parentId: Long
    systemAttributes: JSON
    visibility: ProfileVisibility! = USER
}

input WorkOpsSavedFilterInput {
    bqlSource: String!
    description: String
    name: String!
}

input WorkOpsSpecCommentInput {
    attributes: JSON
    content: String!
    parentId: Long
    systemAttributes: JSON
    visibility: ProfileVisibility! = USER
}

input WorkOpsTaskCommentInput {
    attributes: JSON
    content: String!
    parentId: Long
    systemAttributes: JSON
    visibility: ProfileVisibility! = USER
}

input WorkOpsTaskLinkInput {
    linkTypeId: UUID!
    sourceTaskId: UUID!
    targetTaskId: UUID!
}

input WorkOpsWorkLogInput {
    comment: String
    estimateAdjustment: String
    startedAt: DateTime!
    timeSpent: String!
    visibility: WorklogVisibility!
}

input WorkOpsWorkingCalendarInput {
    description: String
    holidays: JSON!
    name: String!
    timeZone: String!
    weeklyHours: JSON!
}

"Input for creating or updating a workflow state"
input WorkflowStateInput {
    "State-specific configuration"
    configuration: JSON!
    "Human-readable description of this state"
    description: String!
    "Unique string identifier for this state"
    id: String!
    "Name of the background job to execute in this state"
    jobName: String
    "Display name of this state"
    name: String!
    "The lifecycle phase this state belongs to"
    type: WorkflowStateType!
}
