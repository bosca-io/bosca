"""

R12 — notifications, watchers, preferences, and digest
subscriptions. The dispatcher writes IN_APP rows directly; the
remaining channels (EMAIL / WEBHOOK / SLACK) ride
`workops.notification_outbox`.
"""
type WorkOpsNotification {
    actorProfileId: UUID
    body: String!
    createdAt: DateTime!
    event: String!
    id: UUID!
    link: String
    profileId: UUID!
    projectId: UUID
    readAt: DateTime
    taskId: UUID
}

type WorkOpsNotificationPreference {
    dailyDigest: Boolean!
    dndEndLocal: String
    dndStartLocal: String
    """

    `Map<NotificationEvent, Set<NotificationChannel>>` shape.
    Empty channel set for an event means "deliver nothing". Missing
    entries fall back to the default (IN_APP only).
    """
    eventChannels: JSON!
    mutedProjectIds: [UUID!]!
    mutedTaskIds: [UUID!]!
    profileId: UUID!
    version: Long!
    watchAuthored: Boolean!
    watchCommented: Boolean!
}

type WorkOpsNotificationScheme {
    description: String
    """

    `Map<NotificationEvent, List<NotificationRecipient>>` keyed by
    event-enum name. Recipients carry a discriminator `type`.
    """
    eventRecipients: JSON!
    id: UUID!
    name: String!
    version: Long!
}

type WorkOpsNotificationSubscription {
    cron: String!
    lastRunAt: DateTime
    profileId: UUID!
    savedFilterId: UUID!
    timeZone: String!
}

type WorkOpsNotificationsMutation {
    markAllRead: Boolean!
    markRead(id: UUID!): Boolean!
    subscribe(cron: String!, savedFilterId: UUID!, timeZone: String!): WorkOpsNotificationSubscription!
    unsubscribe(savedFilterId: UUID!): Boolean!
    unwatch(taskId: UUID!): Boolean!
    updatePreferences(input: WorkOpsNotificationPreferenceUpdateInput!): WorkOpsNotificationPreference!
    watch(taskId: UUID!): Boolean!
}

type WorkOpsNotificationsQuery {
    """

    The current principal's in-app inbox, newest first. Limit is
    coerced to [1, 200].
    """
    mine(limit: Int!, offset: Long!): [WorkOpsNotification!]!
    """

    The current principal's preferences. Returns null if the
    profile hasn't customized — in which case the default
    (IN_APP only, watch own) applies.
    """
    myPreferences: WorkOpsNotificationPreference
    "Saved-filter subscriptions the principal has set up."
    mySubscriptions: [WorkOpsNotificationSubscription!]!
    scheme(id: UUID!): WorkOpsNotificationScheme
    "Admin reads. Phase 7 keeps scheme management in the admin group."
    schemes: [WorkOpsNotificationScheme!]!
    unread(limit: Int!, offset: Long!): [WorkOpsNotification!]!
    unreadCount: Long!
    "Watchers on a task — paged by added_at."
    watchers(taskId: UUID!): [WorkOpsTaskWatcher!]!
}

" ── Pipeline Runs ──────────────────────────────────────────────────────"
type WorkOpsPipelineRun {
    completedAt: DateTime
    externalUrl: String
    id: UUID!
    pipelineId: String!
    pipelineName: String!
    projectId: UUID!
    stages: [WorkOpsPipelineStageRun!]!
    startedAt: DateTime!
    status: String!
    triggerRef: String
    triggerType: String!
    version: Long!
    versionId: UUID
}

type WorkOpsPipelineStageRun {
    completedAt: DateTime
    externalUrl: String
    id: UUID!
    pipelineRunId: UUID!
    stageName: String!
    startedAt: DateTime
    status: String!
}

"""

Top of Work Ops's three-level delivery hierarchy. A portfolio bundles
related programs and is the natural rollup boundary for OKRs (R19)
and capacity (R20).
"""
type WorkOpsPortfolio {
    "When set, the portfolio is read-only at the service layer."
    archivedAt: DateTime
    createdAt: DateTime!
    description: String
    "Stable id for API and DataLoader use."
    id: UUID!
    "Short uppercase code (2–10 chars), unique cluster-wide."
    key: String!
    modifiedAt: DateTime!
    name: String!
    "Resolved owner profile."
    owner: Profile
    "Profile id of the delivery leader who owns this portfolio."
    ownerProfileId: UUID!
    "Per-entity permission rows. Requires MANAGE."
    permissions: [EntityPermission!]!
    "Programs belonging to this portfolio."
    programs(limit: Int! = 50, offset: Long! = 0): [WorkOpsProgram!]!
    "Optimistic-locking version. Required on every update."
    version: Long!
}

"Query namespace for WorkOpsPortfolios."
type WorkOpsPortfolios {
    "Paginated list of every portfolio."
    all(limit: Int! = 50, offset: Long! = 0): [WorkOpsPortfolio!]!
    "Fetch a portfolio by id."
    portfolio(id: UUID!): WorkOpsPortfolio
    "Fetch a portfolio by key — useful from CLIs and admin URLs."
    portfolioByKey(key: String!): WorkOpsPortfolio
}

"Mutation namespace for WorkOpsPortfolios."
type WorkOpsPortfoliosMutation {
    addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
    archive(expectedVersion: Long!, id: UUID!): WorkOpsPortfolio!
    create(input: WorkOpsPortfolioInput!): WorkOpsPortfolio!
    removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
    unarchive(expectedVersion: Long!, id: UUID!): WorkOpsPortfolio!
    update(expectedVersion: Long!, id: UUID!, input: WorkOpsPortfolioInput!): WorkOpsPortfolio!
}

type WorkOpsPresignedUpload {
    confirmationToken: String!
    expiresAt: DateTime!
    storageObjectId: UUID!
    uploadUrl: String!
}

"Admin CRUD for priorities (R2 reference data)."
type WorkOpsPrioritiesMutation {
    create(input: CreateWorkOpsPriorityInput!): WorkOpsPriority!
    delete(id: UUID!): Boolean!
    update(id: UUID!, input: UpdateWorkOpsPriorityInput!): WorkOpsPriority!
}

"Urgency / importance label attached to a task (R2)."
type WorkOpsPriority {
    colorHex: String!
    description: String
    "Lower values sort first; the seeded scale runs Lowest (0) → Critical (5)."
    displayOrder: Int!
    iconKey: String!
    id: UUID!
    name: String!
    version: Long!
}

"""

Middle tier of the delivery hierarchy. A program belongs to exactly
one WorkOpsPortfolio and groups related projects under one delivery owner.
"""
type WorkOpsProgram {
    archivedAt: DateTime
    createdAt: DateTime!
    description: String
    id: UUID!
    "WorkOpsPortfolio-scoped uppercase code (2–10 chars)."
    key: String!
    modifiedAt: DateTime!
    name: String!
    "Resolved owner profile."
    owner: Profile
    "Profile id of the program owner."
    ownerProfileId: UUID!
    "Per-entity permission rows. Requires MANAGE."
    permissions: [EntityPermission!]!
    "Resolved WorkOpsPortfolio parent."
    portfolio: WorkOpsPortfolio!
    "Projects belonging to this program."
    projects(limit: Int! = 50, offset: Long! = 0): [WorkOpsProject!]!
    "Optional planned program start. Surfaces on the roadmap (R18)."
    startDate: DateTime
    "Optional planned program end."
    targetDate: DateTime
    version: Long!
}

type WorkOpsPrograms {
    "Every program, ordered by key."
    all: [WorkOpsProgram!]!
    "Paginated list of every program in a portfolio."
    byPortfolio(limit: Int! = 50, offset: Long! = 0, portfolioId: UUID!): [WorkOpsProgram!]!
    "Fetch a program by id."
    program(id: UUID!): WorkOpsProgram
}

type WorkOpsProgramsMutation {
    addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
    archive(expectedVersion: Long!, id: UUID!): WorkOpsProgram!
    create(input: WorkOpsProgramInput!): WorkOpsProgram!
    removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
    unarchive(expectedVersion: Long!, id: UUID!): WorkOpsProgram!
    update(expectedVersion: Long!, id: UUID!, input: WorkOpsProgramInput!): WorkOpsProgram!
}

"""

Bottom tier of the delivery hierarchy. WorkOpsTasks live inside projects;
a project's `key` is the prefix of every task key it mints.
"""
type WorkOpsProject {
    archivedAt: DateTime
    createdAt: DateTime!
    "The active task-type scheme (R3) — null until Phase 2 seeds it."
    defaultTaskTypeSchemeId: UUID
    "The active workflow scheme (R4) — null until Phase 3 lands."
    defaultWorkflowSchemeId: UUID
    description: String
    id: UUID!
    "Globally unique uppercase code (2–10 chars). Prefix of every task key."
    key: String!
    modifiedAt: DateTime!
    name: String!
    "Resolved owner profile."
    owner: Profile
    "Profile id of the project owner."
    ownerProfileId: UUID!
    "Per-entity permission rows. Requires MANAGE."
    permissions: [EntityPermission!]!
    "Resolved WorkOpsProgram parent."
    program: WorkOpsProgram!
    "Form schema key used to render the task creation form for this project."
    taskCreationFormSchemaKey: String!
    version: Long!
}

type WorkOpsProjects {
    "Every project, ordered by key."
    all: [WorkOpsProject!]!
    "Paginated list of every project in a program."
    byProgram(limit: Int! = 50, offset: Long! = 0, programId: UUID!): [WorkOpsProject!]!
    "Fetch a project by id."
    project(id: UUID!): WorkOpsProject
    "Fetch a project by key — the form used in task keys."
    projectByKey(key: String!): WorkOpsProject
}

type WorkOpsProjectsMutation {
    addPermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
    archive(expectedVersion: Long!, id: UUID!): WorkOpsProject!
    create(input: WorkOpsProjectInput!): WorkOpsProject!
    removePermission(action: PermissionAction!, groupId: UUID!, id: UUID!): Boolean!
    unarchive(expectedVersion: Long!, id: UUID!): WorkOpsProject!
    update(expectedVersion: Long!, id: UUID!, input: WorkOpsProjectInput!): WorkOpsProject!
}

