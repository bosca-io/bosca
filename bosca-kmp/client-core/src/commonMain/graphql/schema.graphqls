The mapping between projects and the workflow that runs their tasks.
The `perTaskTypeWorkflowIds` JSON object keys task-type UUIDs to
workflow UUIDs.
"""
type WorkOpsWorkflowScheme {
    defaultWorkflowId: UUID!
    description: String
    id: UUID!
    name: String!
    perTaskTypeWorkflowIds: JSON!
    version: Long!
}

"""

One reachable state in a [WorkOpsWorkflow]. Phase 8 wires the optional
`slaPolicyId` against `core-calendar` working calendars.
"""
type WorkOpsWorkflowState {
    displayOrder: Int!
    id: UUID!
    "Convenience accessor — delegates to the underlying status name."
    name: String!
    slaPolicyId: UUID
    status: WorkOpsStatus!
    statusId: UUID!
    workflowId: UUID!
}

"""

One edge in the workflow's state machine. `fromStateIds` is
`["*"]` for wildcard transitions reachable from every state.
"""
type WorkOpsWorkflowTransition {
    "Opaque JSON list of Conditions; admin tooling decodes."
    conditions: JSON!
    description: String
    "First resolved from-state, or null for wildcard transitions."
    fromState: WorkOpsWorkflowState
    fromStateIds: [String!]!
    "Resolved workflow states this transition can originate from (excludes wildcard entries)."
    fromStates: [WorkOpsWorkflowState!]!
    id: UUID!
    name: String!
    "Opaque JSON list of PostFunctions; admin tooling decodes."
    postFunctions: JSON!
    screenId: UUID
    "Resolved workflow state the transition moves the task into."
    toState: WorkOpsWorkflowState!
    toStateId: UUID!
    "Opaque JSON list of Validators; admin tooling decodes."
    validators: JSON!
    workflowId: UUID!
}

"Read-only namespace over Phase 3 workflow definitions."
type WorkOpsWorkflows {
    all: [WorkOpsWorkflow!]!
    scheme(id: UUID!): WorkOpsWorkflowScheme
    schemes: [WorkOpsWorkflowScheme!]!
    workflow(id: UUID!): WorkOpsWorkflow
}

"""

R13 — SLA policies, goals, working calendars, and the per-task
state the tick job mutates. Calendars hold weekly hours and
holidays as JSON; the evaluator interprets them with the calendar's
time zone.
"""
type WorkOpsWorkingCalendar {
    description: String
    "`[YYYY-MM-DD, ...]` — dates excluded from working hours."
    holidays: JSON!
    id: UUID!
    name: String!
    timeZone: String!
    version: Long!
    """

    `Map<DayOfWeek, [{startLocal, endLocal}]>` — keys are uppercase
    English day names. `endLocal` of `24:00` means end-of-day.
    """
    weeklyHours: JSON!
}

type WorkOpsWorklogMutation {
    deleteWorklog(id: UUID!): Boolean!
    logWork(input: WorkOpsWorkLogInput!, taskId: UUID!): WorkOpsWorkLog!
    updateWorklog(id: UUID!, input: WorkOpsWorkLogInput!): WorkOpsWorkLog!
}

type WorkOpsWorklogQuery {
    forTask(limit: Int!, offset: Long!, taskId: UUID!): [WorkOpsWorkLog!]!
    worklog(id: UUID!): WorkOpsWorkLog
}

"A state in the content workflow lifecycle, defining what happens when content enters or exits this state"
type WorkflowState {
    "State-specific configuration"
    configuration: JSON
    "Human-readable description of this state"
    description: String!
    "Unique string identifier for this state (e.g. 'draft', 'published')"
    id: String!
    "Name of the background job to execute in this state"
    jobName: String
    "Display name of this state"
    name: String!
    "The lifecycle phase this state belongs to"
    type: WorkflowStateType!
}

"Query operations for browsing workflow states"
type WorkflowStates {
    "List all defined workflow states"
    all: [WorkflowState!]!
    "Get a specific workflow state by ID"
    state(id: String!): WorkflowState
}

"Mutation operations for managing workflow states"
type WorkflowStatesMutation {
    "Create a new workflow state"
    add(state: WorkflowStateInput!): WorkflowState
    "Delete a workflow state by ID"
    delete(id: String!): Boolean!
    "Update an existing workflow state"
    edit(state: WorkflowStateInput!): WorkflowState
}

"""

Statistical method used to compute per-variation confidence.

FREQUENTIST (the default) applies chi-squared for UNIQUE_CONVERSION
goals and Welch's t for EVENT_COUNT, with Bonferroni correction
across the goal × (variations - 1) family.

BAYESIAN replaces the per-variation confidence with a posterior
`probabilityBeatsControl` (and an `expectedLoss` regret metric).
No Bonferroni correction is applied — Bayesian posteriors have no
family-wise error rate to control. Bayesian verdicts are
interpretable at any sample size, so peeking at results does not
inflate false-positive rates.
"""
enum AnalysisMethod {
    BAYESIAN
    FREQUENTIST
}

"The chart or display type used to render an analytics visualization"
enum AnalyticsVisualizationType {
    "A bar chart with vertical or horizontal bars"
    BAR
    "A bubble chart plotting data points as circles with variable size"
    BUBBLE
    "A date picker control used as an interactive filter input on dashboards"
    DATEPICKER
    "A doughnut chart — a pie chart with a hollow center"
    DOUGHNUT
    "A text label display for static or dynamic text content"
    LABEL
    "A line chart showing data trends over a continuous axis"
    LINE
    "A single numeric value display (e.g. KPI card, counter)"
    NUMBER
    "A pie chart showing proportional segments of a whole"
    PIE
    "A scatter plot showing individual data points on two axes"
    SCATTER
    "A tabular data grid displaying rows and columns"
    TABLE
    "A geographic map visualization using TopoJSON boundary data"
    TOPO_JSON_MAP
}

"The registry protocol an artifact repository serves"
enum ArtifactRegistryType {
    "Docker / OCI container images"
    docker
    "Maven / Gradle JVM artifacts"
    maven
    "npm JavaScript packages"
    npm
}

"Where an attribute is applied — on the item itself or on a relationship between items"
enum AttributeLocation {
    "Attribute is stored directly on the item (metadata or collection)"
    ITEM
    "Attribute is stored on the relationship between a collection and its child items"
    RELATIONSHIP
}

"The data type of an attribute value, used for validation and serialization"
enum AttributeType {
    "Reference to a collection by ID"
    COLLECTION
    "Date value (no time component)"
    DATE
