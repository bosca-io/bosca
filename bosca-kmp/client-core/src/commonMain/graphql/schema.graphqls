    "Strings whose translation is approved or published"
    approvedStrings: Int!
    "Strings whose current translation originated from a human"
    humanTranslatedStrings: Int!
    "Translated strings as a percentage of total strings (0-100)"
    percentage: Float!
    "Strings whose translation is published"
    publishedStrings: Int!
    "Total translatable strings in the project"
    totalStrings: Int!
    "Strings that have any translation (regardless of state)"
    translatedStrings: Int!
}

type TriggerBinding {
    enabled: Boolean!
    eventName: String!
    filter: JSON
    id: UUID!
    ordinal: Int!
    scriptId: UUID!
}

"Real-time progress event emitted during the server-side storage phase of a file upload."
type UploadProgressEvent {
