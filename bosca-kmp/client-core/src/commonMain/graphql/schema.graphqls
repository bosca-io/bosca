    "Total bytes received from this client."
    inBytes: Long!
    "Total messages received from this client."
    inMsgs: Long!
    "The IP address of the connected client."
    ip: String!
    "The kind of connection (e.g. Client, Leafnode, Route)."
    kind: String
    "The programming language of the client library."
    lang: String
    "When the last message was exchanged on this connection."
    lastActivity: String
    "The optional name provided by the client when connecting."
    name: String
    "Total bytes sent to this client."
    outBytes: Long!
    "Total messages sent to this client."
    outMsgs: Long!
    "Bytes waiting to be sent to the client."
    pendingBytes: Long!
    "The TCP port of the connected client."
    port: Int!
    "The round-trip time to the client."
