# =============================================================================
# artifacts-server native image (GraalVM 25)
#
# The native binary is pre-built by CI using Gradle nativeCompile.
#
# Build context is the repository root.
# =============================================================================
FROM debian:bookworm-slim

ARG ARTIFACT_SHA
RUN mkdir /app
WORKDIR /app
COPY artifacts/${ARTIFACT_SHA}/artifacts-server-native/artifacts-server /app/artifacts-server
RUN chmod +x ./artifacts-server

EXPOSE 8084
ENTRYPOINT ["./artifacts-server"]
